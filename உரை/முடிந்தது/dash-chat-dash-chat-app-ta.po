msgstr ""
"பிழைத்திருத்தப் பதிவுகள் சிக்கல்களைக் கண்டறிய உதவுகின்றன. அவை உங்கள் ஆப்ச் "
"உபயோகத்தைப் பற்றிய மெட்டாடேட்டாவைக் கொண்டிருக்கலாம் ஆனால் செய்தி உள்ளடக்கம் "
"இல்லை."

#, i18next-interpolation
msgctxt "errorReportExplanation"
msgid ""
"This will open your email app with the error details. If you include the "
"debug log, public keys, profiles and message contents are removed before "
"sending."
msgstr ""
"இது பிழை விவரங்களுடன் உங்கள் மின்னஞ்சல் பயன்பாட்டைத் திறக்கும். "
"பிழைத்திருத்தப் பதிவைச் சேர்த்தால், அனுப்பும் முன் பொது விசைகள், "
"சுயவிவரங்கள் மற்றும் செய்தி உள்ளடக்கங்கள் அகற்றப்படும்."

#, i18next-interpolation
msgctxt "haveYouReadOurFaq"
msgid "Have you read our FAQ yet?"
msgstr "எங்களின் அடிக்கடி கேட்கப்படும் கேள்விகளைப் படித்தீர்களா?"

#, i18next-interpolation
msgctxt "sendErrorReport"
msgid "Send Error Report"
msgstr "பிழை அறிக்கையை அனுப்பவும்"

#, i18next-interpolation
msgctxt "updateAvailable"
msgid "Update available"
msgstr "புதுப்பிப்பு கிடைக்கிறது"

#, i18next-interpolation
msgctxt "updateDownloading"
msgid "Downloading update..."
msgstr "புதுப்பிப்பைப் பதிவிறக்குகிறது..."

#, i18next-interpolation
msgctxt "updateReady"
msgid "Update downloaded. Restart to apply."
msgstr "புதுப்பிப்பு பதிவிறக்கப்பட்டது. விண்ணப்பிக்க மீண்டும் தொடங்கவும்."

#, i18next-interpolation
msgctxt "updateError"
msgid "Update failed. Please try again later."
msgstr "புதுப்பிப்பு தோல்வியடைந்தது. பிறகு முயற்சிக்கவும்."

#, i18next-interpolation
msgctxt "updateTapToUpdate"
msgid "Tap to update Dash Chat."
msgstr "Dash Chatடைப் புதுப்பிக்க தட்டவும்."

#, i18next-interpolation
msgctxt "updateTapToRestart"
msgid "Tap to restart and apply update."
msgstr "மறுதொடக்கம் செய்ய தட்டவும் மற்றும் புதுப்பிப்பைப் பயன்படுத்தவும்."

#, i18next-interpolation
msgctxt "updateTapToRetry"
msgid "Tap to retry."
msgstr "மீண்டும் முயற்சிக்க தட்டவும்."

#, i18next-interpolation
msgctxt "testBanner"
msgid "Early access test"
msgstr "ஆரம்ப அணுகல் சோதனை"

#, i18next-interpolation
msgctxt "feedback"
msgid "Feedback"
msgstr "பின்னூட்டம்"
