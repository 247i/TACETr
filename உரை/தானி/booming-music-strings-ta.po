msgstr "ஏற்புப்பட்டியல்"

#, java-printf-format
msgctxt "whitelist_summary"
msgid "Only the content of whitelisted folders is shown in your library."
msgstr ""
"அனுமதிப்பட்டியலில் உள்ள கோப்புறைகளின் உள்ளடக்கம் மட்டுமே உங்கள் நூலகத்தில் "
"காட்டப்படும்."

#, java-printf-format
