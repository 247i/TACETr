msgid "Blacklist"
msgstr "தடுப்புப்பட்டியல்"

#, java-printf-format
msgctxt "blacklist_summary"
msgid "The content of blacklisted folders is hidden from your library."
msgstr ""
"தடுப்புப்பட்டியலில் உள்ள கோப்புறைகளின் உள்ளடக்கம் உங்கள் நூலகத்திலிருந்து "
"மறைக்கப்பட்டுள்ளது."

#, java-printf-format
msgctxt "artist_min_songs_title"
msgid "Artist minimum song count"
