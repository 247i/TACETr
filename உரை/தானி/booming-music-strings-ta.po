msgstr "குப்பைக்கு அனுப்பு"

#, java-printf-format
msgctxt "trash_music_summary"
msgid "Send deleted files to trash."
msgstr "நீக்கப்பட்ட கோப்புகளை குப்பைக்கு அனுப்பவும்."

#, java-printf-format
msgctxt "recursive_folder_actions_title"
