msgctxt "artist_min_songs_summary"
msgid ""
"How many songs (at least) must have an artist to be shown in your library."
msgstr ""
"உங்கள் லைப்ரரியில் எத்தனை பாடல்கள் (குறைந்தது) ஒரு கலைஞரைக் காட்ட வேண்டும்."

#, java-printf-format
msgctxt "album_min_songs_title"
msgid "Album minimum song count"
msgstr "ஆல்பத்தின் குறைந்தபட்ச பாடல் எண்ணிக்கை"

#, java-printf-format
msgctxt "album_min_songs_summary"
msgid ""
"How many songs (at least) must have an album to be shown in your library."
msgstr ""
"உங்கள் லைப்ரரியில் எத்தனை பாடல்கள் (குறைந்தபட்சம்) ஒரு ஆல்பத்தைக் காட்ட "
"வேண்டும்."

#, java-printf-format
msgctxt "min_song_duration_title"
msgid "Minimum song duration"
msgstr "குறைந்தபட்ச பாடலின் காலம்"

#, java-printf-format
msgctxt "min_song_duration_summary"
msgid ""
"How many seconds (at least) must last a song to be shown in your library."
msgstr ""
"உங்கள் லைப்ரரியில் ஒரு பாடலைக் காட்ட எத்தனை வினாடிகள் (குறைந்தது) இருக்க "
"வேண்டும்."

#.  Network preferences
#, java-printf-format
msgctxt "network_features_title"
msgid "Enable network features"
msgstr "பிணைய அம்சங்களை இயக்கவும்"

#, java-printf-format
msgctxt "wifi_only_network_features_title"
msgid "Use network features on Wi-Fi only"
msgstr "வைஃபையில் மட்டும் பிணையம் அம்சங்களைப் பயன்படுத்தவும்"

#, java-printf-format
msgctxt "wifi_only_network_features_summary"
msgid "Allow internet features only when connected to Wi-Fi."
msgstr ""
"Wi-Fi உடன் இணைக்கப்பட்டிருக்கும் போது மட்டுமே இணைய அம்சங்களை அனுமதிக்கவும்."

#, java-printf-format
msgctxt "online_artist_images_title"
