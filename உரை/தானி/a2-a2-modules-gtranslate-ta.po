msgctxt "all_languages"
msgid "All Languages"
msgstr "அனைத்து மொழிகளும்"

msgctxt "ask_whole_page"
msgid ""
"Open translate.google.com with selected URL\n"
"to have the entire page translated\n"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட முகவரி உடன் translate.google.comஐத் திறக்கவும் \n"
"முழு பக்கத்தையும் மொழிபெயர்க்க வேண்டும்\n"

msgctxt "enter_something"
msgid "Enter something to translate"
msgstr "மொழிபெயர்க்க ஏதாவது உள்ளிடவும்"

msgctxt "error_nothing_found"
msgid "No translation found for \"{}\"."
msgstr "\"{}\" க்கு மொழிபெயர்ப்பு எதுவும் கிடைக்கவில்லை."

msgctxt "identical"
msgid "Translation resulted in identical output!"
msgstr "மொழிபெயர்ப்பு ஒரே மாதிரியான வெளியீட்டை விளைவித்தது!"

msgctxt "play_audio"
msgid "Play Audio"
msgstr "ஆடியோவை இயக்கவும்"

msgctxt "translate_whole"
msgid "Translate whole webpage?"
msgstr "முழு வலைப்பக்கத்தையும் மொழிபெயர்க்கவா?"
