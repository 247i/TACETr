#, i18next-interpolation
msgctxt "auth.register.title"
msgid "Register"
msgstr "பதிவு செய்யுங்கள்"

#, i18next-interpolation
msgctxt "auth.register.tabTitle"
msgid "Abrechnung - Register"
msgstr "பட்டியலிடல் - பதிவு"

#, i18next-interpolation
msgctxt "auth.register.header"
msgid "Register a new account"
msgstr "புதிய கணக்கை பதிவு செய்யுங்கள்"

#, i18next-interpolation
msgctxt "auth.register.confirmButton"
msgid "Register"
msgstr "பதிவு செய்யுங்கள்"

#, i18next-interpolation
msgctxt "auth.register.registrationSuccess"
msgid "Registered successfully, please confirm your email before logging in…"
msgstr ""
"வெற்றிகரமாக பதிவுசெய்தது, உள்நுழைவதற்கு முன் உங்கள் மின்னஞ்சலை "
"உறுதிப்படுத்தவும்…"

#, i18next-interpolation
msgctxt "auth.register.alreadyHasAccount"
msgid "Already have an account? Sign in"
msgstr "ஏற்கனவே ஒரு கணக்கு இருக்கிறதா? உள்நுழைக"

#, i18next-interpolation
msgctxt "auth.login.tabTitle"
msgid "Abrechnung - Login"
msgstr "பட்டியலிடல் - உள்நுழைவு"

#, i18next-interpolation
msgctxt "auth.login.header"
msgid "Sign in"
msgstr "உள்நுழை"

#, i18next-interpolation
msgctxt "auth.login.loginSuccess"
msgid "Logged in…"
msgstr "உள்நுழைந்தது…"

#, i18next-interpolation
msgctxt "auth.login.confirmButton"
msgid "Login"
msgstr "புகுபதிவு"

#, i18next-interpolation
msgctxt "auth.login.noAccountRegister"
msgid "No account? register"
msgstr "கணக்கு இல்லையா? பதிவு செய்யுங்கள்"

#, i18next-interpolation
msgctxt "auth.login.forgotPassword"
msgid "Forgot your password?"
msgstr "உங்கள் கடவுச்சொல்லை மறந்துவிட்டீர்களா?"

#, i18next-interpolation
msgctxt "auth.recoverPassword.tabTitle"
msgid "Abrechnung - Recover Password"
msgstr "பட்டியலிடல் - கடவுச்சொல்லை மீட்டெடுக்கவும்"

#, i18next-interpolation
msgctxt "auth.recoverPassword.header"
msgid "Recover Password"
msgstr "கடவுச்சொல்லை மீட்டெடுக்கவும்"

#, i18next-interpolation
msgctxt "auth.recoverPassword.body"
msgid "Please enter your email. A recovery link will be sent shortly after."
msgstr "உங்கள் மின்னஞ்சலை உள்ளிடவும். மீட்பு இணைப்பு விரைவில் அனுப்பப்படும்."

#, i18next-interpolation
msgctxt "auth.recoverPassword.emailSent"
msgid "A recovery link has been sent to you via email."
msgstr "மீட்பு இணைப்பு மின்னஞ்சல் வழியாக உங்களுக்கு அனுப்பப்பட்டுள்ளது."

#, i18next-interpolation
msgctxt "auth.confirmEmailChange.tabTitle"
msgid "Abrechnung - Confirm E-Mail Change"
msgstr "பட்டியலிடல் - மின்னஞ்சல் மாற்றத்தை உறுதிப்படுத்தவும்"

#, i18next-interpolation
msgctxt "auth.confirmEmailChange.header"
msgid "Confirm your new E-Mail"
msgstr "உங்கள் புதிய மின்னஞ்சலை உறுதிப்படுத்தவும்"

#, i18next-interpolation
msgctxt "auth.confirmEmailChange.confirmSuccessful"
msgid "Confirmation successful"
msgstr "உறுதிப்படுத்தல் வெற்றிகரமாக"

#, i18next-interpolation
msgctxt "auth.confirmEmailChange.clickHereToConfirm"
msgid "Click <1>here</1> to confirm your new email."
msgstr ""
"உங்கள் புதிய மின்னஞ்சலை உறுதிப்படுத்த <1> இங்கே </1> என்பதைக் சொடுக்கு "
"செய்க."

#, i18next-interpolation
msgctxt "auth.confirmPasswordRecovery.tabTitle"
msgid "Abrechnung - Confirm Password Recovery"
msgstr "பட்டியலிடல் - கடவுச்சொல் மீட்பை உறுதிப்படுத்தவும்"

#, i18next-interpolation
msgctxt "auth.confirmPasswordRecovery.header"
msgid "Confirm Password Recovery"
msgstr "கடவுச்சொல் மீட்பை உறுதிப்படுத்தவும்"

#, i18next-interpolation
msgctxt "auth.confirmPasswordRecovery.successfulLinkToLogin"
msgid ""
"Password recovery successful, please <1>login</1> using your new password."
msgstr ""
"கடவுச்சொல் மீட்பு வெற்றிகரமாக, தயவுசெய்து <1> உள்நுழைவு </1> உங்கள் புதிய "
"கடவுச்சொல்லைப் பயன்படுத்தி."

#, i18next-interpolation
msgctxt "auth.confirmRegistration.tabTitle"
msgid "Abrechnung - Confirm Registration"
msgstr "பட்டியலிடல் - பதிவை உறுதிப்படுத்தவும்"

#, i18next-interpolation
msgctxt "auth.confirmRegistration.header"
msgid "Confirm Registration"
msgstr "பதிவை உறுதிப்படுத்தவும்"

#, i18next-interpolation
msgctxt "auth.confirmRegistration.confirmSuccessful"
msgid "Confirmation successful"
msgstr "உறுதிப்படுத்தல் வெற்றிகரமாக"

#, i18next-interpolation
msgctxt "auth.confirmRegistration.successfulLinkToLogin"
msgid "Please <1>login</1> using your credentials."
msgstr "தயவுசெய்து <1> உள்நுழைவு </1> உங்கள் சான்றுகளைப் பயன்படுத்தி."

#, i18next-interpolation
msgctxt "auth.confirmRegistration.clickHereToConfirm"
msgid "Click <1>here</1> to confirm your registration."
msgstr "உங்கள் பதிவை உறுதிப்படுத்த <1> இங்கே </1> என்பதைக் சொடுக்கு செய்க."

