msgctxt "services.temperature_configure.name"
msgid "Target temperature configure (precond/auxheat)"
msgstr "இலக்கு வெப்பநிலை உள்ளமைவு (முன்நிபந்தனை/துணை வெப்பமாக்கல்)"

msgctxt "services.temperature_configure.description"
msgid ""
"Configure the target preconditioning/auxheat temperatures for zones in a car"
" defined by a VIN."
msgstr ""
"ஒரு VIN ஆல் வரையறுக்கப்பட்ட காரில் மண்டலங்களுக்கான இலக்கு முன்நிபந்தனை/துணை "
"வெப்பமாக்கல் வெப்பநிலையை உள்ளமைக்கவும்."

msgctxt "services.temperature_configure.fields.vin.name"
