msgctxt "services.preheat_start.name"
msgid "Preconditioning start"
msgstr "முன்நிபந்தனை தொடக்கம்"

msgctxt "services.preheat_start.description"
msgid "Start the preconditioning of a car defined by a vin."
msgstr "ஒரு VIN ஆல் வரையறுக்கப்பட்ட காரின் முன்நிபந்தனையைத் தொடங்குங்கள்."

msgctxt "services.preheat_start.fields.vin.name"
msgid "Vin"
msgstr "வின்"

msgctxt "services.preheat_start.fields.vin.description"
msgid "Vin/Fin of the car"
msgstr "காரின் வின்/ஃபின்"

msgctxt "services.preheat_start.fields.type.name"
msgid "Type"
msgstr "வகை"

msgctxt "services.preheat_start.fields.type.description"
msgid ""
"Method that is used to initiate the start process. 0=Now (Default), "
"1=Immediate - Use Immediate in case your car does not support now."
msgstr ""
"தொடக்க செயல்முறையைத் தொடங்கப் பயன்படும் முறை. 0=இப்போது (இயல்புநிலை), "
"1=உடனடி - உங்கள் கார் 'இப்போது' ஆதரிக்காவிட்டால் 'உடனடி' பயன்படுத்தவும்."

msgctxt "services.preheat_start_departure_time.name"
msgid "Preconditioning start with departure time"
msgstr "புறப்படும் நேரத்துடன் முன்நிபந்தனை தொடக்கம்"

msgctxt "services.preheat_start_departure_time.description"
msgid ""
"Start the preconditioning of a car defined by a vin and a given departure "
"time."
msgstr ""
"ஒரு VIN மற்றும் கொடுக்கப்பட்ட புறப்படும் நேரத்தால் வரையறுக்கப்பட்ட காரின் "
"முன்நிபந்தனையைத் தொடங்குங்கள்."

msgctxt "services.preheat_start_departure_time.fields.vin.name"
msgid "Vin"
msgstr "வின்"

msgctxt "services.preheat_start_departure_time.fields.vin.description"
msgid "Vin/Fin of the car"
msgstr "காரின் வின்/ஃபின்"

msgctxt "services.preheat_start_departure_time.fields.time.name"
msgid "Time"
msgstr "நேரம்"

msgctxt "services.preheat_start_departure_time.fields.time.description"
msgid ""
"Departure time in minutes after midnight. E.g. valid value for 8 am would be"
" 480. Value range is 0 to 1439."
msgstr ""
"நள்ளிரவுக்குப் பிறகு நிமிடங்களில் புறப்படும் நேரம். எ.கா. காலை 8 மணிக்கு "
"செல்லுபடியாகும் மதிப்பு 480 ஆக இருக்கும். மதிப்பு வரம்பு 0 முதல் 1439 வரை."

msgctxt "services.preheat_stop.name"
msgid "Preconditioning stop"
msgstr "முன்நிபந்தனை நிறுத்தம்"

msgctxt "services.preheat_stop.description"
msgid "Stop the preconditioning of a car defined by a vin."
msgstr "ஒரு VIN ஆல் வரையறுக்கப்பட்ட காரின் முன்நிபந்தனையை நிறுத்துங்கள்."

msgctxt "services.preheat_stop.fields.vin.name"
