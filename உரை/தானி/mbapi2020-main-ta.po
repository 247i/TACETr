msgstr "வின்"

msgctxt "services.preheat_stop.fields.vin.description"
msgid "Vin/Fin of the car"
msgstr "காரின் வின்/ஃபின்"

msgctxt "services.preheat_stop_departure_time.name"
msgid "Preconditioning stop mode departuretime"
msgstr "முன்நிபந்தனை நிறுத்த முறை புறப்படும் நேரம்"

msgctxt "services.preheat_stop_departure_time.description"
msgid ""
"Stop the configured departure time preconditioning of a car defined by a "
"vin."
msgstr ""
"ஒரு VIN ஆல் வரையறுக்கப்பட்ட காரின் கட்டமைக்கப்பட்ட புறப்படும் நேர "
"முன்நிபந்தனையை நிறுத்துங்கள்."

msgctxt "services.preheat_stop_departure_time.fields.vin.name"
msgid "Vin"
msgstr "வின்"

msgctxt "services.preheat_stop_departure_time.fields.vin.description"
msgid "Vin/Fin of the car"
msgstr "காரின் வின்/ஃபின்"

