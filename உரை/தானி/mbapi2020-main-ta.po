msgctxt "options.step.init.data.cap_check_disabled"
msgid "Disable capabilities check"
msgstr "திறன்கள் சரிபார்ப்பை முடக்கு"

msgctxt "options.step.init.data.enable_china_gcj_02"
msgid "Enable GCJ-02 translation (China only)"
msgstr "GCJ-02 மொழிபெயர்ப்பை இயக்கவும் (சீனா மட்டும்)"

msgctxt "options.step.init.data.delete_auth_file"
msgid ""
"Delete authentication token now. Requires a restart of Home Assistant after "
"save."
msgstr ""
"அங்கீகார டோக்கனை இப்போது நீக்கு. சேமித்த பிறகு ஹோம் அசிஸ்டன்ட் மறுதொடக்கம் "
"தேவை."

msgctxt "options.step.init.data.excluded_cars"
msgid "VINs excluded (comma-sep)"
msgstr "விலக்கப்பட்ட VIN கள் (கமா-பிரிப்பு)"

msgctxt "options.step.init.data.pin"
msgid "Security PIN (to be created in mobile app)"
msgstr "பாதுகாப்பு PIN (மொபைல் பயன்பாட்டில் உருவாக்கப்பட வேண்டும்)"

msgctxt "options.step.init.data.save_files"
msgid "DEBUG ONLY: Enable save server messages to the messages folder"
msgstr ""
"பிழைத்திருத்தம் மட்டும்: சேவையக செய்திகளை செய்திகள் கோப்புறையில் சேமிக்கவும்"

msgctxt "options.step.init.data.overwrite_cap_precondnow"
msgid "Exp: Overwrite capability precondnow (set to true)"
msgstr "சோதனை: precondnow திறனை மேலெழுதவும் (உண்மை என அமைக்கவும்)"

msgctxt "options.step.init.description"
msgid ""
"Configure your options. Some changes require a restart of Home Assistant."
msgstr ""
"உங்கள் விருப்பங்களை உள்ளமைக்கவும். சில மாற்றங்களுக்கு ஹோம் அசிஸ்டன்ட் "
"மறுதொடக்கம் தேவைப்படுகிறது."

msgctxt "options.step.init.title"
msgid "Mercedes ME 2020 Options"
msgstr "Mercedes ME 2020 விருப்பங்கள்"

