msgctxt "config.abort.already_configured"
msgid "Component is configured already."
msgstr "கூறு ஏற்கனவே கட்டமைக்கப்பட்டுள்ளது."

msgctxt "config.abort.reauth_successful"
msgid "Reauth successful! Component reload in progress."
msgstr "மறுஅங்கீகாரம் வெற்றிகரமாக! கூறு மறுஏற்றம் முன்னேற்றத்தில்."

#, read-only
msgctxt "config.error.cannot_connect"
msgid "cannot_connect"
msgstr "இணைக்க முடியாது"

#, read-only
msgctxt "config.error.invalid_auth"
msgid "invalid_auth"
msgstr "invalid_auth"

msgctxt "config.error.unknown"
msgid ""
"Unknown error. Please check the Home Assistant log for more information."
msgstr "தெரியாத பிழை. மேலும் தகவலுக்கு ஹோம் அசிஸ்டன்ட் பதிவை சரிபார்க்கவும்."

msgctxt "config.error.2fa_required"
msgid "Two-factor authentication (2FA) accounts are not supported."
msgstr "இரு-காரணி அங்கீகாரம் (2FA) கணக்குகள் ஆதரிக்கப்படவில்லை."

msgctxt "config.error.legal_terms"
msgid "You need to accept the legal terms in the Mercedes website first"
msgstr ""
"முதலில் மெர்சிடிஸ் இணையதளத்தில் சட்ட விதிமுறைகளை ஏற்றுக்கொள்ள வேண்டும்"

msgctxt "config.step.user.data.region"
msgid "Region"
msgstr "பகுதி"

msgctxt "config.step.user.description"
msgid "Select your region."
msgstr "உங்கள் பகுதியைத் தேர்ந்தெடுக்கவும்."

msgctxt "config.step.user.title"
msgid "Set up the Mercedes ME 2020 connection"
msgstr "Mercedes ME 2020 இணைப்பை அமைக்கவும்"

msgctxt "config.step.credentials.data.username"
msgid "MB username (email address)"
msgstr "MB பயனர்பெயர் (மின்னஞ்சல் முகவரி)"

msgctxt "config.step.credentials.data.password"
msgid "Password"
msgstr "கடவுச்சொல்"

msgctxt "config.step.credentials.description"
msgid "Enter your account details."
msgstr "உங்கள் கணக்கு விவரங்களை உள்ளிடவும்."

msgctxt "config.step.credentials.title"
msgid "Mercedes ME 2020 - Login"
msgstr "Mercedes ME 2020 - உள்நுழைவு"

msgctxt "config.step.pin.data.password"
msgid "TAN (received via eMail or SMS)"
msgstr "TAN (மின்னஞ்சல் அல்லது SMS மூலம் பெறப்பட்டது)"

msgctxt "config.step.pin.description"
msgid ""
"Enter the TAN you have received via eMail or SMS to complete the "
"authentication. If you have not received a TAN, please check your email "
"inbox (and spam folder) or your SMS messages."
msgstr ""
"அங்கீகாரத்தை முடிக்க மின்னஞ்சல் அல்லது SMS மூலம் பெற்ற TAN ஐ உள்ளிடவும். "
"நீங்கள் TAN பெறவில்லை என்றால், உங்கள் மின்னஞ்சல் இன்பாக்ஸ் (மற்றும் ஸ்பேம் "
"கோப்புறை) அல்லது உங்கள் SMS செய்திகளைச் சரிபார்க்கவும்."

#, ignore-same
msgctxt "config.step.pin.title"
msgid "Mercedes ME 2020 - TAN"
msgstr "Mercedes ME 2020 - டான்"

msgctxt "issues.restart_required.fix_flow.step.confirm_restart.description"
msgid ""
"Restart of Home Assistant is required to finish auth update click submit to "
"restart now."
msgstr ""
"அங்கீகார புதுப்பிப்பை முடிக்க ஹோம் அசிஸ்டன்ட் மறுதொடக்கம் தேவை, இப்போது "
"மறுதொடக்கம் செய்ய சமர்ப்பிக்கவும்."

msgctxt "issues.restart_required.fix_flow.step.confirm_restart.title"
msgid "Restart required"
msgstr "மறுதொடக்கம் தேவை"

msgctxt "issues.restart_required.title"
msgid "Restart required"
msgstr "மறுதொடக்கம் தேவை"

