#. Command feedback
msgid "@1 has never logged in."
msgstr "@1 இதுவரை உள்நுழையவில்லை."

msgid "@1 last logged in on @2 (@3)"
msgstr "@1 கடைசியாக @2 இல் உள்நுழைந்தார் (@3)"

#. Date formats
msgid "@1 @2 @3"
msgstr "@1 @2 @3"

msgid "@1 @2, @3"
msgstr "@1 @2, @3"

#. Time ago strings
msgid "@1 minute ago"
msgstr "@1 நிமிடத்திற்கு முன்பு"

msgid "@1 minutes ago"
msgstr "@1 நிமிடத்திற்கு முன்பு"

msgid "@1 hour ago"
msgstr "@1 மணி நேரத்திற்கு முன்பு"

msgid "@1 hours ago"
msgstr "@1 மணிநேரத்திற்கு முன்பு"

msgid "@1 day ago"
msgstr "@1 நாள் முன்பு"

msgid "@1 days ago"
msgstr "@1 நாட்களுக்கு முன்பு"

msgid "@1 month ago"
msgstr "@1 மாதம் முன்பு"

msgid "@1 months ago"
msgstr "@1 மாதங்களுக்கு முன்பு"

msgid "@1 year ago"
msgstr "@1 வருடம் முன்பு"

msgid "@1 years ago"
msgstr "@1 ஆண்டுகளுக்கு முன்பு"

