#, java-printf-format
msgctxt "app_name"
msgid "Android Auto toggle"
msgstr "ஆண்ட்ராய்டு தானி மாறுதல்"

#, java-printf-format
msgctxt "android_auto_ia_title"
msgid "Enable/disable Android Auto"
msgstr "ஆண்ட்ராய்டு ஆட்டோவை இயக்கு/முடக்கு"

#, java-printf-format
msgctxt "android_auto_ia_summary"
msgid "See all the steps to activate Android Auto support"
msgstr ""
"ஆண்ட்ராய்டு ஆட்டோ ஆதரவை செயல்படுத்துவதற்கான அனைத்து படிகளையும் பார்க்கவும்"

#, java-printf-format
msgctxt "android_auto_activity_title"
msgid "Android Auto setup"
msgstr "ஆண்ட்ராய்டு தானி அமைவு"

#, java-printf-format
msgctxt "android_auto_title"
msgid "Use Android Auto"
msgstr "ஆண்ட்ராய்டு ஆட்டோவைப் பயன்படுத்தவும்"

#, java-printf-format
msgctxt "android_auto_footer"
msgid ""
"Setting up Android Auto requires installing additional apps.\n"
"\n"
"Note: you can read our web page about all the steps to finish setting it up and its privacy implications."
msgstr ""
"ஆண்ட்ராய்டு ஆட்டோவை அமைப்பதற்கு கூடுதல் ஆப்சை நிறுவ வேண்டும். \n"
"\n"
"குறிப்பு: எங்கள் இணையப் பக்கத்தை அமைத்து முடிப்பதற்கான அனைத்து படிகள் மற்றும் அதன் தனியுரிமை தாக்கங்கள் பற்றி நீங்கள் படிக்கலாம்."

#, java-printf-format
msgctxt "android_auto_learn_more"
msgid "Tap to read more"
msgstr "மேலும் படிக்க தட்டவும்"

#, java-printf-format
msgctxt "android_auto_help_url"
msgid "https://calyxos.org/android-auto"
msgstr "https://calyxos.org/android-auto"
