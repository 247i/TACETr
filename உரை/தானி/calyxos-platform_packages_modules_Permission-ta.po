#.  Label for the camera timeout list [CHAR LIMIT=40]
#, java-printf-format
msgctxt "camera_timeout_title"
msgid "Camera timeout"
msgstr "கேமரா நேரம் முடிந்தது"

#.  Describes the camera timeout [CHAR LIMIT=NONE]
#, java-printf-format, xml-text
msgctxt "camera_timeout_description"
msgid ""
"Camera access will turn off after <xliff:g "
"id=\"timeout_description\">%1$s</xliff:g> if not in use"
msgstr ""
"<xliff:g id=\"timeout_description\">%1$s</xliff:g>க்குப் பிறகு கேமரா அணுகல் "
"பயன்பாட்டில் இல்லை என்றால் அணைக்கப்படும்"

#, java-printf-format
msgctxt "camera_timeout_description2"
msgid "Camera access will not turn off automatically"
msgstr "கேமரா அணுகல் தானாகவே அணைக்கப்படாது"

#.  Label for the mic timeout list [CHAR LIMIT=40]
#, java-printf-format
msgctxt "mic_timeout_title"
msgid "Microphone timeout"
msgstr "மைக்ரோஃபோன் நேரம் முடிந்தது"

#.  Describes the mic timeout [CHAR LIMIT=NONE]
#, java-printf-format, xml-text
msgctxt "mic_timeout_description"
msgid ""
"Microphone access will turn off after <xliff:g "
"id=\"timeout_description\">%1$s</xliff:g> if not in use"
msgstr ""
"மைக்ரோஃபோன் அணுகல் <xliff:g id=\"timeout_description\">%1$s</xliff:g>க்குப் "
"பிறகு பயன்பாட்டில் இல்லை என்றால் அணைக்கப்படும்"

#, java-printf-format
msgctxt "mic_timeout_description2"
msgid "Microphone access will not turn off automatically"
msgstr "மைக்ரோஃபோன் அணுகல் தானாகவே அணைக்கப்படாது"
