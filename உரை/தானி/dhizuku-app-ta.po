#, ignore-reused, java-printf-format
msgctxt "app_name"
msgid "Dhizuku"
msgstr "டிசுகு"

#, java-printf-format
msgctxt "agreement_title"
msgid "Policy"
msgstr "கொள்கை"

#, ignore-multiple-failures, java-printf-format, safe-html
msgctxt "agreement_text"
msgid ""
"Here is our user policy, Please read and agree to it. <a "
"href=https://iamr0s.github.io/Dhizuku/TERMS.html>Terms of Use</a>, <a "
"href=https://iamr0s.github.io/Dhizuku/PRIVACY.html>Privacy Policy</a> This "
"message won't show up again after you agree."
msgstr ""
"இது எங்கள் பயனர் கொள்கை. தயவுசெய்து அதைப் படித்து ஒப்புக்கொள்ளவும். <a "
"href=https://iamr0s.github.io/Dhizuku/TERMS.html>பயன்பாட்டு விதிமுறைகள்</a>,"
" <a href=https://iamr0s.github.io/Dhizuku/PRIVACY.html>தனியுரிமைக் "
"கொள்கை</a> நீங்கள் ஒப்புக்கொண்ட பிறகு இந்தச் செய்தி மீண்டும் காட்டப்படாது."

#, java-printf-format
msgctxt "agree_text"
msgid "Agree"
msgstr "ஒப்புக்கொள்கிறேன்"

#, java-printf-format
msgctxt "permission_description"
msgid "Use Dhizuku's API"
msgstr "Dhizku இன் API ஐப் பயன்படுத்தவும்"

