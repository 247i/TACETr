msgstr "பயன்பாட்டைத் தொடங்கும்போது பின்வரும் முகவரியைக் கேட்கவும்:"

#, priority:120
msgctxt "checkBoxCoverArtInFolderConvertToJpg"
msgid "Convert to _JPG"
msgstr "_JPGக்கு மாற்றவும்"

msgctxt "checkBoxCoverArtInFolderConvertToJpg_ToolTip"
msgid ""
"Converts cover art to JPG with a compression of 90 (excellent trade-off "
"between size and quality)."
msgstr ""
"90 (அளவு மற்றும் தகுதி இடையே சிறந்த வர்த்தகம்) சுருக்கத்துடன் JPG க்கு கவர் "
"ஆர்ட்டை மாற்றுகிறது."

#, priority:120
msgctxt "checkBoxCoverArtInFolderResize"
msgid "Constrain _maximum width/height"
msgstr "கட்டுப்பாடு _அதிகபட்ச அகலம்/உயரம்"

msgctxt "checkBoxCoverArtInFolderResize_ToolTip"
msgid "Resizes cover art to specified max width/height."
msgstr "குறிப்பிட்ட அதிகபட்ச அகலம்/உயரத்திற்கு கவர் ஆர்ட் அளவை மாற்றுகிறது."

#, priority:120
msgctxt "checkBoxCoverArtInTagsConvertToJpg"
msgid "Convert to JP_G"
msgstr "JPGக்கு மாற்றவும்"

msgctxt "checkBoxCoverArtInTagsConvertToJpg_ToolTip"
msgid ""
"Converts cover art to JPG with a compression of 90 (excellent trade-off "
"between size and quality)."
msgstr ""
"90 (அளவு மற்றும் தகுதி இடையே சிறந்த வர்த்தகம்) சுருக்கத்துடன் JPG க்கு கவர் "
"ஆர்ட்டை மாற்றுகிறது."

#, priority:120
msgctxt "checkBoxCoverArtInTagsResize"
msgid "Constrain m_aximum width/height"
msgstr "m_aximum அகலம்/உயரத்தைக் கட்டுப்படுத்தவும்"

msgctxt "checkBoxCoverArtInTagsResize_ToolTip"
msgid "Resizes cover art to specified max width/height."
msgstr "குறிப்பிட்ட அதிகபட்ச அகலம்/உயரத்திற்கு கவர் ஆர்ட் அளவை மாற்றுகிறது."

#, priority:120
msgctxt "checkBoxCreatePlaylist"
msgid "Create _playlist for each album"
msgstr "ஒவ்வொரு ஆல்பத்திற்கும் பிளேலிச்ட்டை உருவாக்கவும்"

msgctxt "checkBoxCreatePlaylist_ToolTip"
msgid "Creates an album track file for each downloaded album."
msgstr ""
"பதிவிறக்கம் செய்யப்பட்ட ஒவ்வொரு ஆல்பத்திற்கும் ஆல்பம் டிராக் கோப்பை "
"உருவாக்குகிறது."

#, priority:120
msgctxt "checkBoxDownloadDiscography"
msgid "Download _artist discography"
msgstr "_ஆர்ட்டிச்ட் டிச்கோகிராபியைப் பதிவிறக்கவும்"

msgctxt "checkBoxDownloadDiscography_ToolTip"
msgid "Downloads the whole artist discography."
msgstr "முழு கலைஞர் டிச்கோகிராபியையும் பதிவிறக்குகிறது."

#, priority:120
msgctxt "checkBoxEnableApplicationSounds"
msgid "Play _notifications sounds"
msgstr "_அறிவிப்பு ஒலிகளை இயக்கவும்"

msgctxt "checkBoxEnableApplicationSounds_ToolTip"
msgid "Notification sound for finished downloads."
msgstr "முடிக்கப்பட்ட பதிவிறக்கங்களுக்கான அறிவிப்பு ஒலி."

#, priority:120
msgctxt "checkBoxM3uExtended"
msgid "Use _extended format (only for M3U)"
msgstr "_ நீட்டிக்கப்பட்ட வடிவமைப்பைப் பயன்படுத்தவும் (M3U க்கு மட்டும்)"

msgctxt "checkBoxM3uExtended_ToolTip"
msgid ""
"M3U playlists in extended format (directives prefaced by the # character)."
msgstr ""
"நீட்டிக்கப்பட்ட வடிவத்தில் M3U பிளேலிச்ட்கள் (# எழுத்து மூலம் "
"முன்னுரைக்கப்பட்ட வழிமுறைகள்)."

#, priority:120
msgctxt "checkBoxModifyTags"
msgid "_Modify tracks tags (ID3)"
msgstr "தடங்கள் குறிச்சொற்களை மாற்றவும் (ID3)"

msgctxt "checkBoxModifyTags_ToolTip"
msgid ""
"Modifies each tag as specified below.\n"
"\n"
"If not, all tags are unchanged, equivalent to setting \"Do not modify\" for each tag."
msgstr ""
"கீழே குறிப்பிட்டுள்ளபடி ஒவ்வொரு குறிச்சொல்லையும் மாற்றுகிறது. \n"
"\n"
"இல்லையெனில், எல்லா குறிச்சொற்களும் மாறாமல் இருக்கும், ஒவ்வொரு குறிச்சொல்லுக்கும் \"மாற்ற வேண்டாம்\" என்பதை அமைப்பதற்கு சமம்."

#, priority:120
msgctxt "checkBoxRetrieveFilesSize"
msgid "Retrieve _file size before downloading tracks"
msgstr "டிராக்குகளைப் பதிவிறக்கும் முன் கோப்பு அளவைப் பெறவும்"

msgctxt "checkBoxRetrieveFilesSize_ToolTip"
msgid ""
"Retrieves file size to show precise progress.\n"
"If not, some bandwidth/time is saved."
msgstr ""
"துல்லியமான முன்னேற்றத்தைக் காட்ட கோப்பு அளவை மீட்டெடுக்கிறது. \n"
"இல்லையெனில், சில அலைவரிசை/நேரம் சேமிக்கப்படும்."

#, priority:120
