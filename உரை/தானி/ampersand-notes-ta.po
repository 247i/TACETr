#, i18next-interpolation
msgctxt "header"
msgid "Sticky notes"
msgstr "ஒட்டும் குறிப்புகள்"

#, i18next-interpolation
msgctxt "searchPlaceholder"
msgid "Search for notes..."
msgstr "குறிப்புகளைத் தேடு..."

#, i18next-interpolation
msgctxt "edit.header"
msgid "Edit note"
msgstr "குறிப்பைத் திருத்தவும்"

# Suggested in Weblate: குறிப்பைச் சேர்க்கவும்
#, i18next-interpolation
msgctxt "edit.headerAdd"
msgid "Add note"
msgstr "குறிப்பைச் சேர்க்கவும்"

#, i18next-interpolation
msgctxt "edit.title"
msgid "Note title"
msgstr "குறிப்பு தலைப்பு"

#, i18next-interpolation
msgctxt "edit.content"
msgid "Note content"
msgstr "குறிப்பு உள்ளடக்கம்"

#, i18next-interpolation
msgctxt "edit.isArchived"
msgid "Archive note"
msgstr "காப்பக குறிப்பு"

#, i18next-interpolation
msgctxt "edit.delete.title"
msgid "Delete note"
msgstr "குறிப்பை நீக்கு"

# Suggested in Weblate: இந்த தொடரிழையை நிச்சயமாக நீக்க விரும்புகிறீர்களா?
#, i18next-interpolation
msgctxt "edit.delete.confirm"
msgid "Are you sure you want to delete this note?"
msgstr "இந்தக் குறிப்பை நிச்சயமாக நீக்க விரும்புகிறீர்களா?"
