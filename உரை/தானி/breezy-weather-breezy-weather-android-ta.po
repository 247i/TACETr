msgctxt "temperature_degree_day_heating"
msgid "Heating degree day"
msgstr "வெப்பமூட்டும் டிகிரி நாள்"

#, java-printf-format
msgctxt "temperature_degree_day_heating_explanation"
msgid ""
"Difference between the outside temperature and a reference comfortable "
