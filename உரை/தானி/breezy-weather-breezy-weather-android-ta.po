msgstr "சல்பர் டை ஆக்சைடு"

#.  %s = SO₂
#, java-printf-format
msgctxt "air_quality_so2_full"
msgid "Sulfur dioxide (%s)"
msgstr "சல்பர் டை ஆக்சைடு (%s)"

#.  %s = SO₂
#, java-printf-format
msgctxt "air_quality_so2_about"
msgid "About sulfur dioxide (%s)"
msgstr "சல்பர் டை ஆக்சைடு (%s) பற்றி"

#.  %s = SO₂
#, java-printf-format
