#, java-printf-format
msgctxt "air_quality_o3_voice"
msgid "Ozone"
msgstr "ஓசோன்"

#.  %s = O₃
#, java-printf-format
msgctxt "air_quality_o3_full"
msgid "Ground-level ozone (%s)"
msgstr "தரைமட்ட ஓசோன் (%s)"

#.  %s = O₃
#, java-printf-format
msgctxt "air_quality_o3_about"
msgid "About ground-level ozone (%s)"
msgstr "தரைமட்ட ஓசோன் பற்றி (%s)"

#.  %s = O₃
#, java-printf-format
msgctxt "air_quality_o3_index"
msgid "Air quality index scale for %s"
msgstr "%s க்கான காற்று தர குறியீட்டு அளவுகோல்"

#, java-printf-format
msgctxt "air_quality_o3_sources"
msgid ""
"Ozone is created in a chemical reaction between atmospheric oxygen, nitrogen"
" oxides, carbon monoxide and organic compounds, in the presence of sunlight."
msgstr ""
"சூரிய ஒளியின் முன்னிலையில், வளிமண்டல ஆக்ஸிஜன், நைட்ரஜன் ஆக்சைடுகள், கார்பன் "
"மோனாக்சைடு மற்றும் கரிம சேர்மங்கள் ஆகியவற்றுக்கு இடையேயான வேதியியல் "
"எதிர்வினையில் ஓசோன் உருவாகிறது."

