#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.Anonymize"
msgid "Anonymize"
msgstr "அநாமதேய"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeData"
msgid "Anonymize data"
msgstr "தரவை அநாமதேயப்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpDescription"
msgid ""
"Select \"Yes\" if you want Matomo not to track fully qualified IP-Addresses."
msgstr ""
"மாடோமோ முழு தகுதி வாய்ந்த ஐபி முகவரிகளைக் கண்காணிக்க வேண்டாம் என்று நீங்கள் "
"விரும்பினால் \"ஆம்\" என்பதைத் தேர்ந்தெடுக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpInlineHelp"
msgid ""
"Anonymize the last byte(s) of visitors IP addresses to comply with your "
"local privacy laws/guidelines."
msgstr ""
"உங்கள் உள்ளக தனியுரிமை சட்டங்கள்/வழிகாட்டுதல்களுக்கு இணங்க பார்வையாளர்களின் "
"கடைசி பைட் (கள்) ஐபி முகவரிகளை அநாமதேயமாக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpExtendedHelp"
msgid ""
"When users visit your website, Matomo will not use the full IP address (such"
" as %1$s) but instead Matomo will anonymize it first (to %2$s). IP address "
"anonymisation is one of the requirements set by the privacy laws in some "
"countries such as Germany."
msgstr ""
"பயனர்கள் உங்கள் வலைத்தளத்தைப் பார்வையிடும்போது, மாடோமோ முழு ஐபி முகவரியையும்"
" ( %1$s போன்றவை) பயன்படுத்தாது, மாறாக மாடோமோ அதை முதலில் அநாமதேயமாக்கும் ( "
"%2$s க்கு). செர்மனி போன்ற சில நாடுகளில் தனியுரிமைச் சட்டங்களால் "
"நிர்ணயிக்கப்பட்ட தேவைகளில் ஐபி முகவரி அநாமதேயமயமாக்கல் ஒன்றாகும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpPolicySettingTitle"
msgid "IP Anonymisation Enabled"
msgstr "ஐபி அநாமதேயமாக்கல் இயக்கப்பட்டது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpPolicySettingRequirementNote"
msgid "Anonymisation of Visitor's IP addresses must be enabled."
msgstr "பார்வையாளரின் ஐபி முகவரிகளை அநாமதேயமாக்குதல் இயக்கப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpMaskLengtDescription"
msgid "Select how many bytes of the visitors' IPs should be masked."
msgstr ""
"பார்வையாளர்களின் ஐபிக்களில் எத்தனை பைட்டுகள் மறைக்கப்பட வேண்டும் என்பதைத் "
"தேர்ந்தெடுக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpMaskLength"
msgid "%1$s byte(s) - e.g. %2$s"
msgstr "%1$s பைட் (கள்) - எ.கா. %2$s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpMaskFully"
msgid "Fully mask IP address"
msgstr "ஐபி முகவரியை முழுமையாக மறைக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpMaskLengthSettingTitle"
msgid "IP Address Mask Length"
msgstr "ஐபி முகவரி மாச்க் நீளம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpMaskLengthSettingRequirementNote"
msgid "Must be set to at least %1$s byte(s), currently %2$s byte(s)."
msgstr ""
"குறைந்தபட்சம் %1$s பைட்(கள்), தற்போது %2$s பைட்(கள்) ஆக அமைக்கப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeReferrer"
msgid "Anonymize Referrer"
msgstr "பரிந்துரைப்பாளரை அநாமதேயமாக்குங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeReferrerNote"
msgid ""
"Matomo stores from which URL (referrer) a user comes to your site. In some "
"cases such a URL may contain information that can be considered personal "
"information. If you want to prevent such information to be tracked you can "
"restrict the amount of referrer data that Matomo will store when a visitor "
"enters your website. The more information is removed from the referrer "
"information, the less likely personal information will be recorded. The more"
" information you remove from the referrer, the less clear it will be how a "
"visitor came to your website."
msgstr ""
"ஒரு பயனர் உங்கள் தளத்திற்கு வரும் முகவரி (குறிப்பு) இலிருந்து மாடோமோ கடைகள்."
" சில சந்தர்ப்பங்களில், அத்தகைய முகவரி தனிப்பட்ட தகவல்களாகக் கருதக்கூடிய "
"தகவல்களைக் கொண்டிருக்கலாம். இதுபோன்ற தகவல்களைக் கண்காணிக்க நீங்கள் தடுக்க "
"விரும்பினால், ஒரு பார்வையாளர் உங்கள் வலைத்தளத்திற்குள் நுழையும் போது மாடோமோ "
"சேமிக்கும் பரிந்துரைப்பாளர் தரவின் அளவைக் கட்டுப்படுத்தலாம். "
"பரிந்துரைப்பாளரின் தகவல்களிலிருந்து கூடுதல் தகவல்கள் அகற்றப்படுகின்றன, "
"தனிப்பட்ட தகவல்கள் குறைவாகவே பதிவு செய்யப்படும். பரிந்துரையாளரிடமிருந்து "
"நீங்கள் அகற்றும் கூடுதல் தகவல்கள், உங்கள் வலைத்தளத்திற்கு ஒரு பார்வையாளர் "
"எப்படி வந்தார் என்பது குறைவாகவே இருக்கும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AskingForConsent"
msgid "Asking for consent"
msgstr "ஒப்புதல் கேட்கிறது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentManagementPlatforms"
msgid "Consent Management Platforms"
msgstr "ஒப்புதல் மேலாண்மை தளங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentManagementPlatformsIntro"
msgid ""
"Matomo supports integration with popular Consent Management Platforms "
"(CMPs):"
msgstr ""
"பிரபலமான ஒப்புதல் மேலாண்மை இயங்குதளங்களுடன் (CMPs) ஒருங்கிணைப்பை Matomo "
"ஆதரிக்கிறது:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentManagementPlatformsOutro"
msgid ""
"If you do not use one of the above consent managers, you can implement "
"%1$stracking with consent using the Matomo JavaScript API%2$s."
msgstr ""
"மேலே உள்ள ஒப்புதல் மேலாளர்களில் ஒருவரை நீங்கள் பயன்படுத்தவில்லை எனில், "
"Matomo சாவாகைஉரை API%2$sஐப் பயன்படுத்தி ஒப்புதலுடன் %1$ச்ட்ராக்கிங்கைச் "
"செயல்படுத்தலாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentNotRequiredCondition1"
msgid "Do not require consent for any analytics;"
msgstr "எந்த பகுப்பாய்வுக்கும் ஒப்புதல் தேவையில்லை;"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentNotRequiredCondition2"
msgid ""
"Do not require consent for analytics that do not process personal data;"
msgstr "தனிப்பட்ட தரவைச் செயலாக்காத பகுப்பாய்வுகளுக்கு ஒப்புதல் தேவையில்லை;"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentNotRequiredCondition3"
msgid ""
"Allow consent exemptions for first-party, aggregated analytics with opt-out "
"options;"
msgstr ""
"முதல் தரப்பு, ஒருங்கிணைக்கப்பட்ட பகுப்பாய்வுகளுக்கு, விலகல் விருப்பங்களுடன் "
"ஒப்புதல் விலக்குகளை அனுமதிக்கவும்;"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentNotRequiredCondition4"
msgid ""
"Do not apply to certain tracking methods such as Matomo Log Analytics or "
"Matomo SDK."
msgstr ""
"Matomo Log Analytics அல்லது Matomo SDK போன்ற சில கண்காணிப்பு முறைகளுக்குப் "
"பயன்படுத்த வேண்டாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentNotRequiredIntro"
msgid ""
"You may be able to use Matomo without a consent banner if the applicable "
"laws:"
msgstr ""
"பொருந்தக்கூடிய சட்டங்கள் இருந்தால், நீங்கள் ஒப்புதல் பேனர் இல்லாமல் Matomo "
"ஐப் பயன்படுத்தலாம்:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentRequirements"
msgid "Understanding Consent Requirements"
msgstr "ஒப்புதல் தேவைகளைப் புரிந்துகொள்வது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentRequirementsIntro"
msgid ""
"Some privacy laws require you to obtain your visitors' or users' consent "
"before tracking their activity on your website or app. Depending on the "
"applicable laws, consent may be required for one or both of the following "
"reasons:"
msgstr ""
"சில தனியுரிமைச் சட்டங்களின்படி, உங்கள் இணையதளம் அல்லது பயன்பாட்டில் உங்கள் "
"பார்வையாளர்கள் அல்லது பயனர்களின் செயல்பாட்டைக் கண்காணிப்பதற்கு முன் "
"அவர்களின் ஒப்புதலைப் பெற வேண்டும். பொருந்தக்கூடிய சட்டங்களைப் பொறுத்து, "
"பின்வரும் காரணங்களில் ஒன்று அல்லது இரண்டிற்கும் ஒப்புதல் தேவைப்படலாம்:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentRequirementsReasonPersonalData"
msgid "Processing of personal data (GDPR and similar laws)."
msgstr "தனிப்பட்ட தரவு செயலாக்கம் (GDPR மற்றும் ஒத்த சட்டங்கள்)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentRequirementsReasonStorage"
msgid "Accessing or storing data on a visitor's device (ePrivacy laws)."
msgstr ""
"பார்வையாளரின் சாதனத்தில் தரவை அணுகுதல் அல்லது சேமித்தல் (ePrivacy "
"சட்டங்கள்)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DetermineConsentNeedAction1"
msgid ""
"Identify which privacy laws apply to your website's data collection and "
"tracking."
msgstr ""
"உங்கள் இணையதளத்தின் தரவு சேகரிப்பு மற்றும் கண்காணிப்புக்கு எந்த தனியுரிமைச் "
"சட்டங்கள் பொருந்தும் என்பதைக் கண்டறியவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DetermineConsentNeedAction2"
msgid ""
"Decide how to configure Matomo based on whether you process personal data "
"and/or access or store information on visitors' devices."
msgstr ""
"தனிப்பட்ட தரவைச் செயலாக்குகிறீர்களா மற்றும்/அல்லது பார்வையாளர்களின் "
"சாதனங்களில் தகவலை அணுகுவதா அல்லது சேமிப்பதா என்பதன் அடிப்படையில் Matomo ஐ "
"எவ்வாறு கட்டமைப்பது என்பதைத் தீர்மானிக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DetermineConsentNeedIntro"
msgid "To determine whether you need to ask for consent, you should:"
msgstr ""
"நீங்கள் ஒப்புதல் கேட்க வேண்டுமா என்பதைத் தீர்மானிக்க, நீங்கள் செய்ய "
"வேண்டியது:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.HandlingPreviouslyCollectedData"
msgid "Handling Previously Collected Data"
msgstr "முன்பு சேகரிக்கப்பட்ட தரவைக் கையாளுதல்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.HandlingPreviouslyCollectedDataDetails"
msgid ""
"Anonymisation must be irreversible, meaning the data can no longer be linked"
" to an individual. If anonymisation is not possible, deletion may be "
"required. Anonymisation within Matomo environment only can be managed "
"through the Privacy Manager in Matomo."
msgstr ""
"அநாமதேயமாக்கல் என்பது மீள முடியாததாக இருக்க வேண்டும், அதாவது தரவை இனி ஒரு "
"நபருடன் இணைக்க முடியாது. அநாமதேயமாக்கல் சாத்தியமில்லை என்றால், நீக்குதல் "
"தேவைப்படலாம். Matomo சூழலில் உள்ள அநாமதேயத்தை Matomo இல் உள்ள தனியுரிமை "
"மேலாளர் மூலம் மட்டுமே நிர்வகிக்க முடியும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.HandlingPreviouslyCollectedDataIntro"
msgid ""
"If consent is required under applicable laws and you cannot prove that you "
"previously obtained valid consent, you may need to delete or anonymise the "
"previously tracked users' raw data."
msgstr ""
"பொருந்தக்கூடிய சட்டங்களின் கீழ் ஒப்புதல் தேவைப்பட்டால், நீங்கள் இதற்கு "
"முன்பு சரியான ஒப்புதலைப் பெற்றுள்ளீர்கள் என்பதை நிரூபிக்க முடியாவிட்டால், "
"முன்னர் கண்காணிக்கப்பட்ட பயனர்களின் மூலத் தரவை நீங்கள் நீக்கவோ அல்லது "
"அநாமதேயமாகவோ செய்ய வேண்டியிருக்கும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.HowToObtainValidConsent"
msgid "How to obtain a valid consent?"
msgstr "சரியான ஒப்புதலை எவ்வாறு பெறுவது?"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement1"
msgid "Consent must be freely given."
msgstr "ஒப்புதல் சுதந்திரமாக வழங்கப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement10"
msgid "Consent should be refreshed periodically."
msgstr "ஒப்புதல் அவ்வப்போது புதுப்பிக்கப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement2"
msgid "Consent must be specific and informed."
msgstr "ஒப்புதல் குறிப்பிட்டதாகவும் தகவலறிந்ததாகவும் இருக்க வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement3"
msgid "Consent must be unambiguous and express."
msgstr "ஒப்புதல் தெளிவற்றதாகவும் வெளிப்படையாகவும் இருக்க வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement4"
msgid "Users must be able to refuse consent."
msgstr "பயனர்கள் சம்மதத்தை மறுக்க வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement5"
msgid "Withdrawing consent must be as easy as giving it."
msgstr "ஒப்புதலைத் திரும்பப் பெறுவது, கொடுப்பதைப் போல எளிதாக இருக்க வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement6"
msgid "Consent must not be bundled with other terms."
msgstr "ஒப்புதல் மற்ற விதிமுறைகளுடன் இணைக்கப்படக்கூடாது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement7"
msgid "Granular consent choices should be offered."
msgstr "கிரானுலர் ஒப்புதல் தேர்வுகள் வழங்கப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement8"
msgid "Consent must be recorded as proof of compliance."
msgstr "இணக்கத்திற்கான சான்றாக ஒப்புதல் பதிவு செய்யப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ValidConsentRequirement9"
msgid "No tracking before consent where prior consent is required."
msgstr "முன் இசைவு தேவைப்படும் இடங்களில் ஒப்புதலுக்கு முன் கண்காணிப்பு இல்லை."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.Compliance"
msgid "Compliance"
msgstr "இணக்கம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceTableSettingName"
msgid "Setting Name"
msgstr "பெயரை அமைத்தல்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceTableSettingStatus"
msgid "Status"
msgstr "நிலை"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceTableSettingNotes"
msgid "Notes"
msgstr "குறிப்புகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceSelectSite"
msgid ""
"Select a site below to get an indication if the given site is compliant "
"according to the indicated privacy law"
msgstr ""
"குறிப்பிடப்பட்ட தனியுரிமைச் சட்டத்தின்படி கொடுக்கப்பட்ட தளம் இணக்கமாக "
"இருந்தால், குறிப்பைப் பெற கீழே உள்ள தளத்தைத் தேர்ந்தெடுக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceEnforceCheckboxIntro"
msgid "Enforce compliance where possible"
msgstr "முடிந்தவரை இணக்கத்தை அமல்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceEnforceCheckboxTitle"
msgid ""
"Enforce settings that help support CNIL consent-exemption alignment where "
"possible"
msgstr ""
"சாத்தியமான இடங்களில் CNIL ஒப்புதல்-விலக்கு சீரமைப்பை ஆதரிக்க உதவும் "
"அமைப்புகளைச் செயல்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceEnforceCheckboxHelp"
msgid ""
"Enabling this option will automatically apply supported configuration "
"changes within Matomo. <br/><br/>Note that some conditions require changes "
"to the Customer's implementation outside the Matomo environment.<br/>These "
"elements are not controlled or verified through this UI."
msgstr ""
"இந்த விருப்பத்தை இயக்குவது Matomo இல் தானாகவே ஆதரிக்கப்படும் உள்ளமைவு "
"மாற்றங்களைப் பயன்படுத்தும். <br/><br/>Matomo சூழலுக்கு வெளியே "
"வாடிக்கையாளரின் செயலாக்கத்தில் சில நிபந்தனைகளுக்கு மாற்றங்கள் தேவை என்பதை "
"நினைவில் கொள்ளவும்.<br/>இந்த உறுப்புகள் இந்த இடைமுகம் மூலம் "
"கட்டுப்படுத்தப்படவில்லை அல்லது சரிபார்க்கப்படவில்லை."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceCompliant"
msgid "compliant"
msgstr "இணக்கமான"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceNonCompliant"
msgid "non-compliant"
msgstr "இணக்கமற்ற"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceComplianceUnknown"
msgid "unknown"
msgstr "தெரியவில்லை"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceCNILTitle"
msgid "CNIL website analytics consent exemption conditions"
msgstr "CNIL இணையதள பகுப்பாய்வு ஒப்புதல் விலக்கு நிபந்தனைகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ComplianceCNILDescription"
msgid ""
"This table provides an indication of whether certain settings align with "
"CNIL guidance. It does not guarantee full legal compliance. To qualify for "
"the consent exemption under CNIL rules, all required configurations must be "
"implemented. If any setting is shown as “Non-Compliant,” the exemption "
"conditions are not met, and consent must be obtained from users. If any "
"setting is shown as “Unknown” Matomo cannot determine whether this "
"requirement has been implemented. In such cases, these measures must be "
"manually verified."
msgstr ""
"சில அமைப்புகள் CNIL வழிகாட்டுதலுடன் ஒத்துப்போகின்றனவா என்பதற்கான அறிகுறியை "
"இந்த அட்டவணை வழங்குகிறது. இது முழு சட்ட இணக்கத்திற்கு பொறுப்பு அளிக்காது. "
"CNIL விதிகளின் கீழ் ஒப்புதல் விலக்குக்கு தகுதி பெற, தேவையான அனைத்து "
"உள்ளமைவுகளும் செயல்படுத்தப்பட வேண்டும். ஏதேனும் அமைப்பு \"இணக்கமற்றது\" எனக்"
" காட்டப்பட்டால், விலக்கு நிபந்தனைகள் நிறைவு செய்யப்படவில்லை, மேலும் "
"பயனர்களிடமிருந்து ஒப்புதல் பெறப்பட வேண்டும். ஏதேனும் அமைப்பு \"தெரியாது\" "
"எனக் காட்டப்பட்டால், இந்தத் தேவை செயல்படுத்தப்பட்டதா என்பதை Matomo ஆல் "
"தீர்மானிக்க முடியாது. இதுபோன்ற சந்தர்ப்பங்களில், இந்த நடவடிக்கைகள் கைமுறையாக"
" சரிபார்க்கப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ClickHereSettings"
msgid "Click here to access the %s settings."
msgstr "%s அமைப்புகளை அணுக இங்கே சொடுக்கு செய்க."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.WhenDoINeedConsent"
msgid "When do I need to ask for user consent?"
msgstr "பயனர் சம்மதத்தை நான் எப்போது கேட்க வேண்டும்?"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeSites"
msgid "Anonymize the data of this site(s)"
msgstr "இந்த தளத்தின் (கள்) தரவை அநாமதேயமாக்குங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeRowDataFrom"
msgid "Anonymize all raw data starting from:"
msgstr "இருந்து தொடங்கி அனைத்து மூல தரவுகளையும் அநாமதேயமாக்கவும்:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeRowDataTo"
msgid "Anonymize all raw data up to:"
msgstr "அனைத்து மூல தரவுகளையும் அநாமதேயமாக்குங்கள்:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeReferrerExcludeNone"
msgid "Don't anonymize the referrer"
msgstr "பரிந்துரைப்பாளரை அநாமதேயமாக்க வேண்டாம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeReferrerExcludeQuery"
msgid "Remove query parameters from referrer URL"
msgstr "குறிப்பு முகவரி இலிருந்து வினவல் அளவுருக்களை அகற்று"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeReferrerExcludePath"
msgid "Keep only the domain of a referrer URL"
msgstr "ஒரு குறிப்பு முகவரி இன் களத்தை மட்டுமே வைத்திருங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeReferrerExcludeAll"
msgid "Don't record the referrer URL but still detect the type of referrer"
msgstr ""
"பரிந்துரைப்பாளர் முகவரி ஐ பதிவு செய்யாதீர்கள், ஆனால் பரிந்துரைப்பாளரின் "
"வகையை இன்னும் கண்டறியவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIp"
msgid "Anonymize IP"
msgstr "ஐபி அநாமதேயப்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeIpHelp"
msgid ""
"This action cannot be undone. If enabled, for all visits during this "
"duration the IP will be anonymized by at least 2 bytes, for example "
"'192.168.xxx.xxx'. If you have currently configured to anonymize by 3 bytes,"
" then this setting will be respected and all IPs will be anonymized by 3 "
"bytes."
msgstr ""
"இந்த செயலை செயல்தவிர்க்க முடியாது. இயக்கப்பட்டால், இந்த காலகட்டத்தில் "
"அனைத்து வருகைகளுக்கும் ஐபி குறைந்தது 2 பைட்டுகளால் அநாமதேயமாக இருக்கும், "
"எடுத்துக்காட்டாக '192.168.xxx.xxx'. நீங்கள் தற்போது 3 பைட்டுகளால் "
"அநாமதேயமாக்க கட்டமைக்கப்பட்டிருந்தால், இந்த அமைப்பு மதிக்கப்படும் மற்றும் "
"அனைத்து ஐபிக்களும் 3 பைட்டுகளால் அநாமதேயப்படுத்தப்படும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeLocation"
msgid "Anonymize Location"
msgstr "இருப்பிடம் அநாமதேய"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeLocationHelp"
msgid ""
"This action cannot be undone. Re-evaluates the location based on the "
"anonymized IP (at least 2 bytes of the IP will be anonymized)."
msgstr ""
"இந்த செயலை செயல்தவிர்க்க முடியாது. அநாமதேய ஐபி அடிப்படையில் இருப்பிடத்தை மறு"
" மதிப்பீடு செய்கிறது (ஐபியின் குறைந்தது 2 பைட்டுகள் அநாமதேயமாக்கப்படும்)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeUserId"
msgid "Replace User ID with a pseudonym"
msgstr "பயனர் ஐடியை ஒரு புனைப்பெயருடன் மாற்றவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeUserIdHelp"
msgid ""
"When you enable this option, the User ID will be replaced by a pseudonym to "
"avoid directly storing and displaying personally identifiable information "
"such as an email address. In technical terms: given your User ID, Matomo "
"will process the User ID pseudonym using a salted hash "
"function.<br/><br/><em>Note: replacing with a pseudonym is not the same as "
"anonymisation. In GDPR terms: the User ID pseudonym still counts as personal"
" data. The original User ID could still be identified if certain additional "
"information is available (which only Matomo and your data processor has "
"access to).</em>"
msgstr ""
"இந்த விருப்பத்தை நீங்கள் இயக்கும்போது, மின்னஞ்சல் முகவரி போன்ற தனிப்பட்ட "
"முறையில் அடையாளம் காணக்கூடிய தகவல்களை நேரடியாகச் சேமித்து காண்பிப்பதைத் "
"தவிர்ப்பதற்காகப் பயனர் ஐடி ஒரு புனைப்பெயரால் மாற்றப்படும். தொழில்நுட்ப "
"சொற்களில்: உங்கள் பயனர் ஐடியைப் பொறுத்தவரை, MATOMO ஒரு உப்பு ஆச் "
"செயல்பாட்டைப் பயன்படுத்தி பயனர் ஐடி புனைப்பெயரை செயலாக்கும். "
"<br><br><em>சிடிபிஆர் சொற்களில்: பயனர் ஐடி புனைப்பெயர் இன்னும் தனிப்பட்ட "
"தரவுகளாகக் கருதப்படுகிறது. சில கூடுதல் தகவல்கள் கிடைத்தால் அசல் பயனர் ஐடியை "
"இன்னும் அடையாளம் காண முடியும் (இது மாடோமோ மற்றும் உங்கள் தரவுச் செயலிக்கு "
"மட்டுமே அணுகல்).</em>"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeProcessInfo"
msgid ""
"This action may take a long time and will therefore not be executed right "
"away. You will be able to follow the current state of the process below. The"
" anonymization should typically start within one hour."
msgstr ""
"இந்த நடவடிக்கை நீண்ட நேரம் ஆகலாம், எனவே இப்போதே செயல்படுத்தப்படாது. கீழே "
"உள்ள செயல்முறையின் தற்போதைய நிலையை நீங்கள் பின்பற்ற முடியும். அநாமதேயமாக்கல்"
" பொதுவாக ஒரு மணி நேரத்திற்குள் தொடங்க வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeDataNow"
msgid "Anonymize past data for the selected site and time"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட தளம் மற்றும் நேரத்திற்கான கடந்த கால தரவுகளை "
"அநாமதேயமாக்குங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AnonymizeDataConfirm"
msgid ""
"Are you sure you want to anonymize the data for the selected website(s) and "
"time range? This action cannot be undone, data may be deleted as requested, "
"and this process may take a long time."
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட வலைத்தளம் (கள்) மற்றும் நேர வரம்பிற்கான தரவை "
"அநாமதேயமாக்க விரும்புகிறீர்களா? இந்த செயலை செயல்தவிர்க்க முடியாது, "
"கோரப்பட்டபடி தரவு நீக்கப்படலாம், மேலும் இந்த செயல்முறை நீண்ட நேரம் ஆகலாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UnsetVisitColumns"
msgid "Unset visit columns"
msgstr "நெடுவரிசைகளைச் பார்வையிடாத நெடுவரிசைகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UnsetVisitColumnsHelp"
msgid ""
"This action cannot be undone. A list of database columns in scope visit that"
" you want to unset. Each value for that column will be set to its default "
"value. Please note that if the same column exists in scope 'conversion', "
"then this column will be deleted as well"
msgstr ""
"இந்த செயலை செயல்தவிர்க்க முடியாது. நீங்கள் அமைக்க விரும்பும் அளவிலான "
"தரவுத்தள நெடுவரிசைகளின் பட்டியல் பார்வையிடவும். அந்த நெடுவரிசைக்கான ஒவ்வொரு "
"மதிப்பும் அதன் இயல்புநிலை மதிப்புக்கு அமைக்கப்படும். அதே நெடுவரிசை "
"'மாற்றத்தில்' இருந்தால், இந்த நெடுவரிசை நீக்கப்படும் என்பதை நினைவில் கொள்க"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UnsetActionColumns"
msgid "Unset action columns"
msgstr "அமைக்கப்படாத செயல் நெடுவரிசைகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UnsetActionColumnsHelp"
msgid ""
"This action cannot be undone. A list of database columns in scope action "
"that you want to unset. Each value for that column will be set to its "
"default value."
msgstr ""
"இந்த செயலை செயல்தவிர்க்க முடியாது. நீங்கள் அமைக்க விரும்பும் நோக்கம் "
"செயல்பாட்டில் உள்ள தரவுத்தள நெடுவரிசைகளின் பட்டியல். அந்த நெடுவரிசைக்கான "
"ஒவ்வொரு மதிப்பும் அதன் இயல்புநிலை மதிப்புக்கு அமைக்கப்படும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AwarenessDocumentation"
msgid "Awareness &amp; documentation"
msgstr "விழிப்புணர்வு &amp; ஆவணம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AwarenessDocumentationIntro"
msgid ""
"Inform your users clearly and transparently, and make your colleagues aware "
"of the data being collected and how it is used:"
msgstr ""
"உங்கள் பயனர்களுக்கு தெளிவாகவும் வெளிப்படையாகவும் தெரிவிக்கவும், "
"சேகரிக்கப்பட்ட தரவு மற்றும் அது எவ்வாறு பயன்படுத்தப்படுகிறது என்பதைப் பற்றி "
"உங்கள் சகாக்களுக்கு தெரியப்படுத்துங்கள்:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AwarenessDocumentationDesc1"
msgid ""
"Inform your visitors through a clear privacy notice whenever you’re "
"collecting personal data."
msgstr ""
"நீங்கள் தனிப்பட்ட தரவைச் சேகரிக்கும் போதெல்லாம் தெளிவான தனியுரிமை அறிவிப்பு "
"மூலம் உங்கள் பார்வையாளர்களுக்கு தெரிவிக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AwarenessDocumentationDesc2"
msgid ""
"Inform your users in your privacy policy about what data you collect and how"
" the data is used."
msgstr ""
"நீங்கள் எந்த தரவைச் சேகரிக்கிறீர்கள், தரவு எவ்வாறு பயன்படுத்தப்படுகிறது "
"என்பதைப் பற்றி உங்கள் தனியுரிமைக் கொள்கையில் உங்கள் பயனர்களுக்குத் "
"தெரிவிக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AwarenessDocumentationDesc3"
msgid ""
"Make your team aware that you are using Matomo Analytics and %1$swhat data "
"is being collected by your analytics platform%2$s."
msgstr ""
"நீங்கள் மாடோமோ அனலிட்டிக்ச் மற்றும் %1$sWHAT தரவு உங்கள் பகுப்பாய்வு தளமான "
"%2$s ஆல் சேகரிக்கப்படுகிறது என்பதை உங்கள் குழுவுக்கு தெரியப்படுத்துங்கள்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AwarenessDocumentationDesc4"
msgid ""
"Document your use of Matomo within your %1$sinformation asset register%2$s."
msgstr ""
"உங்கள் %1$sinformation சொத்து பதிவு %2$s க்குள் MATOMO ஐப் பயன்படுத்துவதை "
"ஆவணப்படுத்தவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.CurrentDBSize"
msgid "Current database size"
msgstr "தற்போதைய தரவுத்தள அளவு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DataRetention"
msgid "Data retention"
msgstr "தரவு தக்கவைப்பு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DataRetentionInMatomo"
msgid "Data retention for data stored in Matomo:"
msgstr "MATOMO இல் சேமிக்கப்பட்ட தரவுகளுக்கான தரவு தக்கவைப்பு:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DataRetentionOverall"
msgid ""
"The overall data retention rate for your privacy policy is the raw data "
"retention rate. Please note that aggregated reports may contain personal "
"data as well. If you are using features like User ID, Custom Variables, "
"Custom Dimension, or track personal data in other ways such as events, page "
"URLs or page titles, etc, then the overall data retention rate for your "
"privacy policy is the higher of the two."
msgstr ""
"உங்கள் தனியுரிமைக் கொள்கைக்கான ஒட்டுமொத்த தரவு தக்கவைப்பு விகிதம் மூல தரவு "
"தக்கவைப்பு வீதமாகும். ஒருங்கிணைந்த அறிக்கைகளில் தனிப்பட்ட தரவுகளும் "
"இருக்கலாம் என்பதை நினைவில் கொள்க. நிகழ்வுகள், பக்க முகவரி கள் அல்லது பக்க "
"தலைப்புகள் போன்ற பிற வழிகளில் பயனர் ஐடி, தனிப்பயன் மாறிகள், தனிப்பயன் "
"பரிமாணம் அல்லது தனிப்பட்ட தரவைக் கண்காணிக்கும் அம்சங்களை நீங்கள் "
"பயன்படுத்துகிறீர்கள் என்றால், உங்கள் தனியுரிமைக் கொள்கைக்கான ஒட்டுமொத்த தரவு"
" தக்கவைப்பு விகிதம் இரண்டில் அதிகமாகும் ."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.RawDataRemovedAfter"
msgid "all visits and actions raw data are deleted after %1$s."
msgstr ""
"அனைத்து வருகைகள் மற்றும் செயல்கள் மூல தரவு %1$s க்குப் பிறகு நீக்கப்படும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.RawDataNeverRemoved"
msgid "visits and actions raw data are <strong>never</strong> deleted."
msgstr ""
"வருகைகள் மற்றும் செயல்கள் மூல தரவு <strong> நெவர் </strong> நீக்கப்பட்டது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ReportsRemovedAfter"
msgid "all aggregated reports are deleted after %1$s."
msgstr "அனைத்து ஒருங்கிணைந்த அறிக்கைகளும் %1$s க்குப் பிறகு நீக்கப்படுகின்றன."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ReportsNeverRemoved"
msgid "aggregated reports are <strong>never</strong> deleted."
msgstr "ஒருங்கிணைந்த அறிக்கைகள் <strong> நெவர் </strong> நீக்கப்பட்டன."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DBPurged"
msgid "DB purged."
msgstr "டி.பி."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteBothConfirm"
msgid ""
"You are about to enable both raw data deletion and report data deletion. "
"This will permanently remove your ability to view old analytics data. Are "
"you sure you want to do this?"
msgstr ""
"மூல தரவு நீக்குதல் மற்றும் அறிக்கை தரவு நீக்குதல் ஆகிய இரண்டையும் நீங்கள் "
"இயக்க உள்ளீர்கள். இது பழைய பகுப்பாய்வு தரவைக் காணும் உங்கள் திறனை நிரந்தரமாக"
" அகற்றும். இதை நீங்கள் செய்ய விரும்புகிறீர்களா?"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteDataDescription"
msgid ""
"You can configure Matomo to regularly delete old raw data and/or aggregated "
"reports to keep your database small or to meet privacy regulations such as "
"GDPR."
msgstr ""
"உங்கள் தரவுத்தளத்தை சிறியதாக வைத்திருக்க அல்லது சிடிபிஆர் போன்ற தனியுரிமை "
"விதிமுறைகளை நிறைவு செய்ய பழைய மூல தரவு மற்றும்/அல்லது ஒருங்கிணைந்த "
"அறிக்கைகளை தவறாமல் நீக்க MATOMO ஐ உள்ளமைக்கலாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteDataInterval"
msgid "Delete old data every"
msgstr "ஒவ்வொரு பழைய தரவை நீக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteOldVisitorLogs"
msgid "Delete old visitor logs"
msgstr "பழைய பார்வையாளர் பதிவுகளை நீக்கு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteOldRawData"
msgid "Regularly delete old raw data"
msgstr "பழைய மூல தரவை தவறாமல் நீக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteOldAggregatedReports"
msgid "Delete old aggregated report data"
msgstr "பழைய ஒருங்கிணைந்த அறிக்கை தரவை நீக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteLogDescription2"
msgid ""
"When you enable automatic log deletion, you must ensure that all previous "
"daily reports have been processed, so that no data is lost."
msgstr ""
"தானியங்கி பதிவு நீக்குதலை நீங்கள் இயக்கும்போது, முந்தைய நாள்தோறும் "
"அறிக்கைகள் அனைத்தும் செயலாக்கப்பட்டுள்ளன என்பதை உறுதிப்படுத்த வேண்டும், "
"இதனால் தரவு எதுவும் இழக்கப்படவில்லை."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteRawDataInfo"
msgid ""
"The raw data contains all details about each individual visit and each "
"action your visitors took. When you delete raw data, the deleted information"
" won't be available anymore in the visitor log. Also if you later decide to "
"create a segment, the segmented reports won't become available for the time "
"frame that has been deleted since all aggregated reports are generated from "
"this raw data."
msgstr ""
"மூல தரவுகளில் ஒவ்வொரு தனிப்பட்ட வருகையும், உங்கள் பார்வையாளர்கள் எடுத்த "
"ஒவ்வொரு செயலையும் பற்றிய அனைத்து விவரங்களும் உள்ளன. நீங்கள் மூல தரவை "
"நீக்கும்போது, பார்வையாளர் பதிவில் நீக்கப்பட்ட தகவல்கள் இனி கிடைக்காது. "
"நீங்கள் பின்னர் ஒரு பகுதியை உருவாக்க முடிவு செய்தால், இந்த மூல "
"தரவுகளிலிருந்து அனைத்து ஒருங்கிணைந்த அறிக்கைகளும் உருவாக்கப்படுவதால் "
"நீக்கப்பட்ட கால எல்லைக்கு பிரிக்கப்பட்ட அறிக்கைகள் கிடைக்காது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteLogsConfirm"
msgid ""
"You are about to enable raw data deletion. If old raw data is removed, and "
"reports haven't already been created, you will not be able to see historical"
" past analytics data. Are you sure you want to do this?"
msgstr ""
"நீங்கள் மூல தரவு நீக்குதலை இயக்க உள்ளீர்கள். பழைய மூல தரவு அகற்றப்பட்டு, "
"அறிக்கைகள் ஏற்கனவே உருவாக்கப்படவில்லை என்றால், நீங்கள் வரலாற்று கடந்தகால "
"பகுப்பாய்வு தரவைக் காண முடியாது. இதை நீங்கள் செய்ய விரும்புகிறீர்களா?"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteLogsOlderThan"
msgid "Delete logs older than"
msgstr "பழைய பதிவுகளை நீக்கு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteMaxRows"
msgid "Maximum number of rows to delete in one run:"
msgstr "ஒரு ஓட்டத்தில் நீக்க அதிகபட்ச வரிசைகளின் எண்ணிக்கை:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteMaxRowsNoLimit"
msgid "no limit"
msgstr "வரம்பு இல்லை"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteReportsConfirm"
msgid ""
"You are about to enable report data deletion. If old reports are removed, "
"you will have to re-process them in order view them. Are you sure you want "
"to do this?"
msgstr ""
"அறிக்கை தரவு நீக்குதலை நீங்கள் இயக்க உள்ளீர்கள். பழைய அறிக்கைகள் "
"அகற்றப்பட்டால், அவற்றைக் காண நீங்கள் அவற்றை மீண்டும் செயலாக்க வேண்டும். இதை "
"நீங்கள் செய்ய விரும்புகிறீர்களா?"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteAggregateReportsDetailedInfo"
msgid ""
"When you enable this setting, all aggregated reports will be deleted. "
"Aggregated reports are generated from the raw data and represent aggregated "
"data from several individual visits. For example, the \"Country\" report "
"lists aggregated numbers to see how many visits you have gotten from each "
"country."
msgstr ""
"இந்த அமைப்பை நீங்கள் இயக்கும்போது, ஒருங்கிணைந்த அனைத்து அறிக்கைகளும் "
"நீக்கப்படும். ஒருங்கிணைந்த அறிக்கைகள் மூல தரவுகளிலிருந்து "
"உருவாக்கப்படுகின்றன மற்றும் பல தனிப்பட்ட வருகைகளிலிருந்து ஒருங்கிணைந்த "
"தரவைக் குறிக்கின்றன. எடுத்துக்காட்டாக, ஒவ்வொரு நாட்டிலிருந்தும் நீங்கள் "
"எத்தனை வருகைகளைப் பெற்றுள்ளீர்கள் என்பதைப் பார்க்க \"நாடு\" அறிக்கை "
"ஒருங்கிணைந்த எண்களை பட்டியலிடுகிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.KeepBasicMetricsReportsDetailedInfo"
msgid ""
"When you enable this setting, some numeric key performance indicators won't "
"be deleted."
msgstr ""
"இந்த அமைப்பை நீங்கள் இயக்கும்போது, சில எண் முக்கிய செயல்திறன் குறிகாட்டிகள் "
"நீக்கப்படாது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.InfoSomeReferrerInfoMayBeAnonymized"
msgid ""
"Some referrer information may be missing because referrer anonymisation is "
"enabled as following: %s"
msgstr ""
"சில குறிப்பாளர் தகவல்கள் காணாமல் போகலாம், ஏனெனில் பரிந்துரைப்பாளர் "
"அநாமதேயமாக்கல் பின்வருமாறு இயக்கப்பட்டது: %s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteReportsInfo2"
msgid ""
"If you delete old reports, they may be re-processed again from your RAW data"
" when you request them."
msgstr ""
"நீங்கள் பழைய அறிக்கைகளை நீக்கிவிட்டால், நீங்கள் கோரும்போது உங்கள் மூல "
"தரவுகளிலிருந்து அவை மீண்டும் பதப்படுத்தப்படலாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteReportsInfo3"
msgid ""
"If you have also enabled \"%s\", then the reports data you're deleting will "
"be permanently lost."
msgstr ""
"நீங்கள் \"%s\" ஐ இயக்கியிருந்தால், நீங்கள் நீக்கும் அறிக்கைகள் தரவு "
"நிரந்தரமாக இழக்கப்படும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteReportsOlderThan"
msgid "Delete reports older than"
msgstr "விட பழைய அறிக்கைகளை நீக்கு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteSchedulingSettings"
msgid "Schedule old data deletion"
msgstr "பழைய தரவு நீக்குதலை திட்டமிடுங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteDataSettings"
msgid "Delete old visitor logs and reports"
msgstr "பழைய பார்வையாளர் பதிவுகள் மற்றும் அறிக்கைகளை நீக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_Description"
msgid ""
"Do Not Track is a technology and policy proposal that enables users to opt "
"out of tracking by websites they do visit, including analytics services, "
"advertising networks, and social platforms."
msgstr ""
"டூ ட்ராக் என்பது ஒரு தொழில்நுட்பம் மற்றும் கொள்கை திட்டமாகும், இது பயனர்கள் "
"பார்வையிடும் வலைத்தளங்களைக் கண்காணிப்பதைத் தவிர்க்க உதவுகிறது, இதில் "
"பகுப்பாய்வு சேவைகள், விளம்பர நெட்வொர்க்குகள் மற்றும் சமூக தளங்கள் உட்பட."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_Disable"
msgid "Disable Do Not Track support"
msgstr "முடக்கு ஆதரவைக் கண்காணிக்க வேண்டாம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_Disabled"
msgid ""
"Matomo is currently tracking all visitors, even when they specified \"I do "
"not want to be tracked\" in their web browsers."
msgstr ""
"மாடோமோ தற்போது அனைத்து பார்வையாளர்களையும் கண்காணித்து வருகிறார், அவர்கள் "
"தங்கள் வலை உலாவிகளில் \"நான் கண்காணிக்க விரும்பவில்லை\" என்று "
"குறிப்பிட்டாலும் கூட."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_DisabledMoreInfo"
msgid ""
"We recommend enabling DoNotTrack support to respect your visitors' privacy"
msgstr ""
"உங்கள் பார்வையாளர்களின் தனியுரிமையை மதிக்க டோனோட்ராக் ஆதரவை இயக்க "
"பரிந்துரைக்கிறோம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_Enable"
msgid "Enable Do Not Track support"
msgstr "ஆதரவைக் கண்காணிக்க வேண்டாம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_Enabled"
msgid "You are currently respecting your users Privacy, Bravo!"
msgstr "நீங்கள் தற்போது உங்கள் பயனர்களின் தனியுரிமையை மதிக்கிறீர்கள், பிராவோ!"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_EnabledMoreInfo"
msgid ""
"When users have set their web browser to \"I do not want to be tracked\" "
"(DoNotTrack is enabled) then Matomo will not track these visits."
msgstr ""
"பயனர்கள் தங்கள் வலை உலாவியை \"நான் கண்காணிக்க விரும்பவில்லை\" என்று "
"அமைத்தால் (டோனோட்ராக் இயக்கப்பட்டிருக்கிறது) பின்னர் மாடோமோ இந்த வருகைகளைக் "
"கண்காணிக்க மாட்டார்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_SupportDNTPreference"
msgid "Support Do Not Track preference"
msgstr "உதவி விருப்பத்தை கண்காணிக்காது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DoNotTrack_Deprecated"
msgid ""
"The support for the Do Not Track header has been deprecated. As more "
"browsers have either started automatically sending this header without "
"giving users the option to change it or have completely discontinued support"
" for it, we no longer recommend enabling this option. This feature may be "
"completely removed in one of the upcoming major releases."
msgstr ""
"டோன்ட் ட்ராக் தலைப்புக்கான உதவி நீக்கப்பட்டது. பயனர்களுக்கு அதை "
"மாற்றுவதற்கான விருப்பத்தை வழங்காமல் அல்லது அதற்கான ஆதரவை முற்றிலுமாக "
"நிறுத்தாமல் அதிகமான உலாவிகள் இந்த தலைப்பை தானாக அனுப்பத் தொடங்கியுள்ளதால், "
"இந்த விருப்பத்தை இயக்க நாங்கள் இனி பரிந்துரைக்க மாட்டோம். இந்த நற்பொருத்தம் "
"வரவிருக்கும் முக்கிய வெளியீடுகளில் ஒன்றில் முழுமையாக அகற்றப்படலாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.EstimatedDBSizeAfterPurge"
msgid "Estimated database size after purge"
msgstr "தூய்மைப்படுத்தலுக்குப் பிறகு மதிப்பிடப்பட்ட தரவுத்தள அளவு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.EstimatedSpaceSaved"
msgid "Estimated space saved"
msgstr "மதிப்பிடப்பட்ட இடம் சேமிக்கப்பட்டது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ForceCookielessTracking"
msgid "Force tracking without cookies"
msgstr "குக்கீகள் இல்லாமல் கட்டாய கண்காணிப்பு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ForceCookielessTrackingDescription"
msgid ""
"Enabling this option will automatically update %1$s, so it contains some "
"additional code to ensure all trackers won't use cookies. Additionally "
"Matomo will ignore all tracking cookies on server side."
msgstr ""
"இந்த விருப்பத்தை இயக்குவது தானாகவே %1$s ஐ புதுப்பிக்கும், எனவே அனைத்து "
"கண்காணிப்பாளர்களும் குக்கீகளைப் பயன்படுத்த மாட்டார்கள் என்பதை உறுதிப்படுத்த "
"சில கூடுதல் குறியீட்டைக் கொண்டுள்ளது. கூடுதலாக, சேவையக பக்கத்தில் உள்ள "
"அனைத்து கண்காணிப்பு குக்கீகளையும் மாடோமோ புறக்கணிக்கும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ForceCookielessTrackingDescription2"
msgid ""
"Cookies will be disabled even when using the consent methods in Matomo "
"tracker and calling for example the cookie consent methods won't enable "
"cookies."
msgstr ""
"மாடோமோ டிராக்கரில் ஒப்புதல் முறைகளைப் பயன்படுத்தும் போது கூட குக்கீகள் "
"முடக்கப்படும், மேலும் குக்கீ ஒப்புதல் முறைகள் குக்கீகளை இயக்காது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ForceCookielessTrackingDescriptionNotWritable"
msgid ""
"The JS tracker file \"%1$s\" is not writable which is required for this "
"feature to fully work. When the JS tracker file is not writable, then the "
"cookies will be only ignored on the server side but cookies might be still "
"set in the browser. To solve this issue you or a system administrator need "
"to change the file permissions so your webserver can change this file."
msgstr ""
"JS டிராக்கர் கோப்பு \"%1$s\" எழுதக்கூடியதல்ல, இந்த நற்பொருத்தம் முழுமையாக "
"வேலை செய்ய வேண்டியிருக்கும். JS டிராக்கர் கோப்பு எழுத முடியாததாக இல்லாதபோது,"
" குக்கீகள் சேவையக பக்கத்தில் மட்டுமே புறக்கணிக்கப்படும், ஆனால் குக்கீகள் "
"இன்னும் உலாவியில் அமைக்கப்படலாம். இந்த சிக்கலைத் தீர்க்க நீங்கள் அல்லது "
"கணினி நிர்வாகி கோப்பு அனுமதிகளை மாற்ற வேண்டும், எனவே உங்கள் வெப்சர்வர் இந்த "
"கோப்பை மாற்ற முடியும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GeolocationAnonymizeIpNote"
msgid ""
"Note: Geolocation will have approximately the same results with 1 byte "
"anonymized. With 2 bytes or more, Geolocation will be inaccurate."
msgstr ""
"குறிப்பு: 1 பைட் அநாமதேயமயமாக்கப்பட்ட அதே முடிவுகளை புவிஇருப்பிடம் "
"கொண்டிருக்கும். 2 பைட்டுகள் அல்லது அதற்கு மேற்பட்டவற்றுடன், புவிஇருப்பிடம் "
"துல்லியமாக இருக்கும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GDPR"
msgid "GDPR"
msgstr "சிடிபிஆர்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprManager"
msgid "GDPR Manager"
msgstr "சிடிபிஆர் மேலாளர்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprChecklists"
msgid "GDPR checklists"
msgstr "சிடிபிஆர் சரிபார்ப்பு பட்டியல்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprChecklistDesc1"
msgid ""
"If you are processing personal data of European citizens through Matomo, "
"even if your company is located outside Europe, you need to fulfill GDPR "
"obligations and this guide will help you."
msgstr ""
"நீங்கள் மாடோமோ மூலம் ஐரோப்பிய குடிமக்களின் தனிப்பட்ட தரவை செயலாக்குகிறீர்கள்"
" என்றால், உங்கள் நிறுவனம் ஐரோப்பாவிற்கு வெளியே அமைந்திருந்தாலும், நீங்கள் "
"மொத்த உள்நாட்டு உற்பத்தியில் கடமைகளை நிறைவேற்ற வேண்டும், இந்த வழிகாட்டி "
"உங்களுக்கு உதவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprChecklistDesc2"
msgid ""
"Find below our tools that let you exercise your users’ rights easily, and "
"the list of actions to take in order to make your use of Matomo compliant "
"with the GDPR and safeguard your data. Visit our %1$sGDPR User guide%2$s to "
"learn even more."
msgstr ""
"உங்கள் பயனர்களின் உரிமைகளை எளிதில் பயன்படுத்த அனுமதிக்கும் எங்கள் "
"கருவிகளையும், சிடிபிஆருடன் நீங்கள் மாடோமோவைப் பயன்படுத்துவதற்கும், உங்கள் "
"தரவைப் பாதுகாக்கவும் எடுக்க வேண்டிய செயல்களின் பட்டியலையும் கீழே காணலாம். "
"மேலும் அறிய எங்கள் %1$sGDPR பயனர் கையேடு %2$s ஐப் பார்வையிடவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprOverview"
msgid "GDPR Overview"
msgstr "சிடிபிஆர் கண்ணோட்டம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprOverviewIntro1"
msgid ""
"The General Data Protection Regulation (GDPR) is a regulation which "
"strengthens and unifies data protection for all individuals within the "
"European Union (EU)."
msgstr ""
"பொது தரவு பாதுகாப்பு ஒழுங்குமுறை (சிடிபிஆர்) என்பது ஐரோப்பிய ஒன்றியத்தில் "
"(ஐரோப்பிய ஒன்றியம்) உள்ள அனைத்து நபர்களுக்கும் தரவு பாதுகாப்பை வலுப்படுத்தி "
"ஒன்றிணைக்கும் ஒரு ஒழுங்குமுறை ஆகும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprOverviewIntro2"
msgid ""
"If you take steps to ensure no personal data is collected in Matomo, then "
"you may not be concerned by the GDPR for Matomo (if you track no IP "
"addresses, no user IDs, no geolocation data, etc.)."
msgstr ""
"MATOMO இல் தனிப்பட்ட தரவு எதுவும் சேகரிக்கப்படவில்லை என்பதை உறுதிப்படுத்த "
"நீங்கள் நடவடிக்கை எடுத்தால், நீங்கள் MATOMO க்காக மொத்த உள்நாட்டு "
"உற்பத்தியில் கவலைப்படாமல் இருக்கலாம் (நீங்கள் ஐபி முகவரிகள் இல்லை, பயனர் "
"ஐடிகள் இல்லை, புவிஇருப்பிட தரவு இல்லை போன்றவை)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprTools"
msgid "GDPR Tools"
msgstr "சிடிபிஆர் கருவிகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GetPurgeEstimate"
msgid "Get purge estimate"
msgstr "தூய்மைப்படுத்தும் மதிப்பீட்டைப் பெறுங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRights"
msgid "Individuals' rights"
msgstr "தனிநபர்களின் உரிமைகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRightsIntro"
msgid "Exercise the rights of your users with our GDPR-friendly procedures:"
msgstr ""
"எங்கள் சிடிபிஆர் நட்பு நடைமுறைகளுடன் உங்கள் பயனர்களின் உரிமைகளைப் "
"பயன்படுத்துங்கள்:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRightsInform"
msgid ""
"The right to be informed: inform your users with a clear privacy notice."
msgstr ""
"தெரிவிக்கப்படுவதற்கான உரிமை: தெளிவான தனியுரிமை அறிவிப்புடன் உங்கள் "
"பயனர்களுக்கு தெரிவிக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRightsAccess"
msgid ""
"The right of access: %1$ssearch for a data subject%2$s and export all of "
"their data."
msgstr ""
"அணுகல் உரிமை: %1$s ஒரு தரவு விசயத்தைத் தேடுங்கள் %2$s மற்றும் அவற்றின் எல்லா"
" தரவையும் ஏற்றுமதி செய்யுங்கள்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRightsErasure"
msgid ""
"The right to erasure: %1$ssearch for a data subject%2$s and delete some or "
"all of their data."
msgstr ""
"அழிப்பதற்கான உரிமை: %1$s ஒரு தரவு விசயத்தைத் தேடுங்கள் %2$s மற்றும் அவற்றின்"
" சில அல்லது எல்லா தரவையும் நீக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRightsRectification"
msgid ""
"The right to rectification: you can %1$ssearch for a data subject%2$s and "
"delete some or all of their data."
msgstr ""
"திருத்தம் செய்வதற்கான உரிமை: நீங்கள் %1$s ஒரு தரவு விசயத்தைத் தேடலாம் %2$s "
"மற்றும் அவற்றின் சில அல்லது எல்லா தரவையும் நீக்கலாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRightsPortability"
msgid ""
"The right to data portability: %1$ssearch for a data subject%2$s and export "
"all of their data."
msgstr ""
"தரவு பெயர்வுத்திறனுக்கான உரிமை: %1$s ஒரு தரவு விசயத்தைத் தேடுங்கள் %2$s "
"மற்றும் அவற்றின் எல்லா தரவையும் ஏற்றுமதி செய்க."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRightsObject"
msgid ""
"The right to object: %1$slet your users easily opt-out%2$s on your privacy "
"policy page."
msgstr ""
"பொருளின் உரிமை: %1$s உங்கள் பயனர்கள் உங்கள் தனியுரிமைக் கொள்கை பக்கத்தில் "
"%2$s ஐ எளிதில் விலகுகிறார்கள்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.IndividualsRightsChildren"
msgid ""
"If you offer online services to children and rely on consent to collect "
"information about them, then you may need a parent or guardian’s consent in "
"order to process the children’s personal data lawfully."
msgstr ""
"குழந்தைகளுக்கு நிகழ்நிலை சேவைகளை நீங்கள் வழங்கினால், அவற்றைப் பற்றிய "
"தகவல்களைச் சேகரிக்க ஒப்புதல் அளித்தால், குழந்தைகளின் தனிப்பட்ட தரவை "
"சட்டப்பூர்வமாக செயலாக்க உங்களுக்கு பெற்றோர் அல்லது பாதுகாவலரின் ஒப்புதல் "
"தேவைப்படலாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.KeepBasicMetrics"
msgid ""
"Keep basic metrics (visits, page views, bounce rate, goal conversions, "
"ecommerce conversions, etc.)"
msgstr ""
"அடிப்படை அளவீடுகளை வைத்திருங்கள் (வருகைகள், பக்கக் காட்சிகள், பவுன்ச் வீதம்,"
" இலக்கு மாற்றங்கள், இணையவழி மாற்றங்கள் போன்றவை)"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.KeepDataFor"
msgid "Keep all data for"
msgstr "எல்லா தரவையும் வைத்திருங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.KeepReportSegments"
msgid "For kept data above, also keep segmented reports"
msgstr "மேலே உள்ள தரவுகளுக்கு, பிரிக்கப்பட்ட அறிக்கைகளையும் வைத்திருங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.LastDelete"
msgid "Last deletion was on"
msgstr "கடைசியாக நீக்குதல் இருந்தது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.LeastDaysInput"
msgid "Please specify a number of days greater than %s."
msgstr "%s ஐ விட பல நாட்களைக் குறிப்பிடவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.LeastMonthsInput"
msgid "Please specify a number of months greater than %s."
msgstr "%s ஐ விட பல மாதங்கள் அதிகமாக குறிப்பிடவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.MenuPrivacySettings"
msgid "Privacy"
msgstr "தனியுரிமை"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.NextDelete"
msgid "Next scheduled deletion in"
msgstr "அடுத்த திட்டமிடப்பட்ட நீக்குதல்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PluginDescription"
msgid ""
"Increase Privacy for your users and make your Matomo instance privacy "
"compliant with your local legislation."
msgstr ""
"உங்கள் பயனர்களுக்கான தனியுரிமையை அதிகரிக்கவும், உங்கள் மேட்டோமோ நிகழ்வு "
"தனியுரிமையை உங்கள் உள்ளக சட்டத்திற்கு இணங்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PurgeNow"
msgid "Purge DB Now"
msgstr "டி.பி. தூய்மைப்படுத்துதல் இப்போது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PurgeNowConfirm"
msgid ""
"You are about to permanently delete data from your database. Are you sure "
"you want to continue?"
msgstr ""
"உங்கள் தரவுத்தளத்திலிருந்து தரவை நிரந்தரமாக நீக்க உள்ளீர்கள். நீங்கள் தொடர "
"விரும்புகிறீர்களா?"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PurgingData"
msgid "Purging data…"
msgstr "தரவை தூய்மைப்படுத்துதல்…"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.RecommendedForPrivacy"
msgid "Recommended for privacy"
msgstr "தனியுரிமைக்கு பரிந்துரைக்கப்படுகிறது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ReportsDataSavedEstimate"
msgid "Database size"
msgstr "தரவுத்தள அளவு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SearchForDataSubject"
msgid "Search for a data subject."
msgstr "தரவு விசயத்தைத் தேடுங்கள்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.FindDataSubjectsBy"
msgid "Find data subjects by"
msgstr "மூலம் தரவு பாடங்களைக் கண்டறியவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.NoDataSubjectsFound"
msgid "No data subjects found"
msgstr "தரவு பாடங்கள் எதுவும் கிடைக்கவில்லை"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteVisitsConfirm"
msgid ""
"Are you sure you want to delete the selected visits? This action cannot be "
"undone."
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட வருகைகளை நீக்க விரும்புகிறீர்களா? இந்த செயலை "
"செயல்தவிர்க்க முடியாது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ResultTruncated"
msgid ""
"More than %1$s results were found and the result was truncated to the first "
"%1$s visits."
msgstr ""
"%1$s முடிவுகள் காணப்பட்டன, இதன் விளைவாக முதல் %1$s வருகைகளுக்கு "
"துண்டிக்கப்பட்டது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AddVisitorIdToSearch"
msgid "Click to add this visitorID to the search"
msgstr "தேடலில் இந்த பார்வையாளரைச் சேர்க்க சொடுக்கு செய்க"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AddVisitorIPToSearch"
msgid "Click to add this visitorIP to the search"
msgstr "தேடலில் இந்த விசிட்டோரைப் சேர்க்க சொடுக்கு செய்க"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.AddUserIdToSearch"
msgid "Click to add this userID to the search"
msgstr "தேடலில் இந்த பயனரைச் சேர்க்க சொடுக்கு செய்க"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ExportSelectedVisits"
msgid "Export selected visits"
msgstr "தேர்ந்தெடுக்கப்பட்ட வருகைகளை ஏற்றுமதி செய்யுங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeleteSelectedVisits"
msgid "Delete selected visits"
msgstr "தேர்ந்தெடுக்கப்பட்ட வருகைகளை நீக்கு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SelectWebsite"
msgid "Select a website"
msgstr "ஒரு வலைத்தளத்தைத் தேர்ந்தெடுக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.MatchingDataSubjects"
msgid "Matching data subjects"
msgstr "தரவு பாடங்களுடன் பொருந்துகிறது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.VisitsMatchedCriteria"
msgid "These visits match the selected criteria."
msgstr "இந்த வருகைகள் தேர்ந்தெடுக்கப்பட்ட அளவுகோல்களுடன் பொருந்துகின்றன."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ExportingNote"
msgid ""
"In case you are exporting the data to exercise the right of access, please "
"make sure the selected visits are actually performed by the data subject you"
" want to export the data for."
msgstr ""
"அணுகல் உரிமையைப் பயன்படுத்த நீங்கள் தரவை ஏற்றுமதி செய்கிறீர்கள் என்றால், "
"நீங்கள் தரவை ஏற்றுமதி செய்ய விரும்பும் தரவு விசயத்தால் தேர்ந்தெடுக்கப்பட்ட "
"வருகைகள் உண்மையில் செய்யப்படுவதை உறுதிசெய்க."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.DeletionFromMatomoOnly"
msgid ""
"Please also note that any data will be only deleted from the Matomo database"
" but not from your webserver logs. Also note that if you re-import any "
"historical data, for example from logs, that any previously deleted data may"
" be imported again."
msgstr ""
"எந்தவொரு தரவும் மாடோமோ தரவுத்தளத்திலிருந்து மட்டுமே நீக்கப்படும் என்பதையும் "
"நினைவில் கொள்க, ஆனால் உங்கள் வெப்சர்வர் பதிவுகளிலிருந்து அல்ல. எந்தவொரு "
"வரலாற்றுத் தரவையும், எடுத்துக்காட்டாக பதிவுகளிலிருந்து நீங்கள் மீண்டும் "
"இறக்குமதி செய்தால், முன்னர் நீக்கப்பட்ட எந்த தரவும் மீண்டும் இறக்குமதி "
"செய்யப்படலாம் என்பதையும் நினைவில் கொள்க."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ResultIncludesAllVisits"
msgid ""
"The found results include all visits without any time restriction and "
"include today."
msgstr ""
"கண்டுபிடிக்கப்பட்ட முடிவுகளில் எந்த நேரக் கட்டுப்பாடும் இல்லாமல் அனைத்து "
"வருகைகளும் அடங்கும், மேலும் இன்று சேர்க்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprToolsPageIntro1"
msgid "This page has been designed for you to exercise data subject rights."
msgstr ""
"இந்த பக்கம் நீங்கள் தரவு பொருள் உரிமைகளைப் பயன்படுத்துவதற்காக "
"வடிவமைக்கப்பட்டுள்ளது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprToolsPageIntro2"
msgid "You can exercise:"
msgstr "நீங்கள் உடற்பயிற்சி செய்யலாம்:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprToolsPageIntroAccessRight"
msgid "The right of access to all data (and data portability)."
msgstr "எல்லா தரவையும் அணுகுவதற்கான உரிமை (மற்றும் தரவு பெயர்வுத்திறன்)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprToolsPageIntroEraseRight"
msgid "The right to erase some or all data (and rectification)."
msgstr "சில அல்லது எல்லா தரவையும் அழிக்கும் உரிமை (மற்றும் திருத்தம்)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.GdprToolsOverviewHint"
msgid ""
"In case you do not know what GDPR is, please refer to the %1$sGDPR "
"overview%2$s."
msgstr ""
"சிடிபிஆர் என்றால் என்ன என்று உங்களுக்குத் தெரியாவிட்டால், தயவுசெய்து "
"%1$sgdpr கண்ணோட்டம் %2$s ஐப் பார்க்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SaveSettingsBeforePurge"
msgid ""
"You have changed the data deletion settings. Please save them before "
"starting a purge."
msgstr ""
"தரவு நீக்குதல் அமைப்புகளை மாற்றியுள்ளீர்கள். தூய்மைப்படுத்தலைத் "
"தொடங்குவதற்கு முன் அவற்றைச் சேமிக்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SeeAlsoOurOfficialGuidePrivacy"
msgid "See also our official guide: %1$sWeb Analytics Privacy%2$s"
msgstr ""
"எங்கள் அதிகாரப்பூர்வ வழிகாட்டியையும் காண்க: %1$sWEB பகுப்பாய்வு தனியுரிமை "
"%2$s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SecurityProcedures"
msgid "Security procedures"
msgstr "பாதுகாப்பு நடைமுறைகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SecurityProceduresIntro"
msgid ""
"Inform your users clearly and transparently, and make your colleagues aware "
"of the data being collected and how it is used:"
msgstr ""
"உங்கள் பயனர்களுக்கு தெளிவாகவும் வெளிப்படையாகவும் தெரிவிக்கவும், "
"சேகரிக்கப்பட்ட தரவு மற்றும் அது எவ்வாறு பயன்படுத்தப்படுகிறது என்பதைப் பற்றி "
"உங்கள் சகாக்களுக்கு தெரியப்படுத்துங்கள்:"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SecurityProceduresDesc1"
msgid ""
"Apply our %1$ssecurity recommendations%2$s in order to keep your Matomo data"
" safe."
msgstr ""
"உங்கள் மாடோமோ தரவைப் பாதுகாப்பாக வைத்திருக்க எங்கள் %1$scecurity "
"பரிந்துரைகளை %2$s ஐப் பயன்படுத்துங்கள்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SecurityProceduresDesc2"
msgid ""
"Check that you have a written contract with the company providing you the "
"Matomo server or hosting which ensures %1$sappropriate safeguards are "
"provided%2$s."
msgstr ""
"நீங்கள் மாடோமோ சேவையகம் அல்லது ஓச்டிங்கை வழங்கும் நிறுவனத்துடன் "
"எழுத்துப்பூர்வ ஒப்பந்தம் உள்ளதா என்பதைச் சரிபார்க்கவும், இது %1$sapparate "
"பாதுகாப்புகள் %2$s வழங்கப்படுவதை உறுதி செய்கிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SecurityProceduresDesc3"
msgid "Include Matomo in your %1$sdata breach procedure%2$s."
msgstr "உங்கள் %1$sDATA மீறல் நடைமுறை %2$s இல் MATOMO ஐ சேர்க்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SecurityProceduresDesc4"
msgid ""
"Include Matomo in your %1$sdata privacy impact assessment (DPIA)%2$s, if "
"applicable."
msgstr ""
"பொருந்தினால், உங்கள் %1$sDATA தனியுரிமை தாக்க மதிப்பீடு (DPIA) %2$s இல் "
"MATOMO ஐ சேர்க்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SiteDataNotAvailable"
msgid "Data unavailable"
msgstr "தகவல் கிடைக்கவில்லை"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SiteDataNotAvailableCertainSites"
msgid "Data restricted for some sites"
msgstr "சில தளங்களுக்கு தகவல்கள் கட்டுப்படுத்தப்பட்டுள்ளன"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.VisitorLogsProfilesDisabledMessage"
msgid ""
"Data for this site is not displayed because Visits logs or Visitor Profile "
"are disabled. This ensures compliance with privacy settings and regulations."
msgstr ""
"இந்த தளத்தின் தகவல்கள் பார்வையாளர் பதிவுகள் அல்லது பார்வையாளர் விவரம் "
"முடக்கப்பட்டுள்ளதால் காட்டப்படவில்லை. இது தனியுரிமை அமைப்புகளுக்கும் "
"விதிகளுக்கும் பொருந்தும் வணிகம் உறுதிப்படுத்துகிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.VisitorLogsProfilesSiteNamesDisabledMessage"
msgid ""
"Data for some sites is not displayed because Visits logs or Visitor Profile "
"are disabled for these sites. This ensures compliance with privacy settings "
"and regulations."
msgstr ""
"சில தளங்களுக்கான தகவல்கள் காட்டப்படவில்லை ஏனெனில் அந்த தளங்களுக்கான "
"பார்வையாளர் பதிவுகள் அல்லது பார்வையாளர் விவரங்கள் முடக்கப்பட்டுள்ளன. இது "
"தனியுரிமை அமைப்புகளுக்கும் விதிகளுக்கும் பொருந்தும் வகையில் "
"உறுதிப்படுத்துகிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PleaseEnableVisitorLogsProfiles"
msgid ""
"If you need to access data for this site, please enable Visits logs or "
"Visitor Profile in the %1$ssite settings%2$s."
msgstr ""
"இந்த தளத்தின் தகவல்களை அணுக வேண்டுமானால், தயவுசெய்து %1$sதள அமைப்புகள்%2$s "
"இல் பார்வையாளர் பதிவுகளை அல்லது பார்வையாளர் சுயவிவரத்தை இயக்கு."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PleaseEnableVisitorLogsProfilesSites"
msgid ""
"If you need to access data for these sites, please enable Visits logs or "
"Visitor Profile in the %1$ssite settings%2$s."
msgstr ""
"இந்த தளங்களுக்கான தகவல்களை அணுக வேண்டுமானால், தயவுசெய்து %1$sதள "
"அமைப்புகள்%2$s இல் பார்வையாளர் பதிவுகளை அல்லது பார்வையாளர் சுவாரஸ்யத்தை "
"இயக்கு."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.TeaserHeader"
msgid ""
"On this page, you can customize Matomo to make it privacy compliant with "
"existing legislations, by: %1$s anonymizing the visitor IP%2$s, %3$s "
"automatically remove old visitor logs from the database%4$s, and %5$s "
"anonymize previously tracked raw users' data%6$s."
msgstr ""
"இந்தப் பக்கத்தில், தற்போதுள்ள சட்டங்களுடன் தனியுரிமையை இணங்குவதற்கு நீங்கள் "
"மாடோமோவைத் தனிப்பயனாக்கலாம், இதன் மூலம்: %1$s பார்வையாளரை "
"அநாமதேயப்படுத்துதல் IP %2$s, %3$s தானாகவே பழைய பார்வையாளர் பதிவுகளை %4$s, "
"மற்றும் %5$s அநாமதேயத்தை முன்னர் கண்காணித்த மூல பயனர்களின் தரவு%6$s."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.TeaserHeadline"
msgid "Privacy Settings"
msgstr "தனியுரிமை அமைப்புகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseAnonymizedIpForVisitEnrichment"
msgid "Also use the Anonymized IP addresses when enriching visits."
msgstr "வருகைகளை வளப்படுத்தும்போது அநாமதேய ஐபி முகவரிகளையும் பயன்படுத்தவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseAnonymizedIpForVisitEnrichmentNote"
msgid ""
"Plugins such as Geo Location via IP and Provider improve visitor's metadata."
" By default, these plugins use the anonymized IP addresses. If you select "
"'No', then the non-anonymized full IP address will be used instead, "
"resulting in less privacy but better data accuracy."
msgstr ""
"ஐபி வழியாக சியோ இருப்பிடம் மற்றும் வழங்குநர் போன்ற செருகுநிரல்கள் "
"பார்வையாளரின் மெட்டாடேட்டாவை மேம்படுத்துகின்றன. இயல்பாக, இந்த செருகுநிரல்கள்"
" அநாமதேய ஐபி முகவரிகளைப் பயன்படுத்துகின்றன. நீங்கள் 'இல்லை' என்பதைத் "
"தேர்ந்தெடுத்தால், பெயரிடப்படாத முழு ஐபி முகவரி அதற்கு பதிலாக "
"பயன்படுத்தப்படும், இதன் விளைவாக குறைந்த தனியுரிமை ஆனால் சிறந்த தரவு "
"துல்லியம் கிடைக்கும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PseudonymizeUserIdNote"
msgid ""
"When you enable this option, the User ID will be replaced by a pseudonym to "
"avoid directly storing and displaying personally identifiable information "
"such as an email address. In technical terms: given your User ID, Matomo "
"will process the User ID pseudonym using a salted hash function."
msgstr ""
"இந்த விருப்பத்தை நீங்கள் இயக்கும்போது, மின்னஞ்சல் முகவரி போன்ற தனிப்பட்ட "
"முறையில் அடையாளம் காணக்கூடிய தகவல்களை நேரடியாக சேமித்து காண்பிப்பதைத் "
"தவிர்ப்பதற்காக பயனர் ஐடி ஒரு புனைப்பெயரால் மாற்றப்படும். தொழில்நுட்ப "
"சொற்களில்: உங்கள் பயனர் ஐடியைப் பொறுத்தவரை, MATOMO ஒரு உப்பு ஆச் "
"செயல்பாட்டைப் பயன்படுத்தி பயனர் ஐடி புனைப்பெயரை செயலாக்கும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PseudonymizeUserIdNote2"
msgid ""
"Note: replacing with a pseudonym is not the same as anonymisation. In GDPR "
"terms: the User ID pseudonym still counts as personal data. The original "
"User ID could still be identified if certain additional information is "
"available (which only Matomo and your data processor has access to)."
msgstr ""
"குறிப்பு: ஒரு புனைப்பெயரை மாற்றுவது அநாமதேயமயமாக்கலுக்கு சமமானதல்ல. "
"சிடிபிஆர் சொற்களில்: பயனர் ஐடி புனைப்பெயர் இன்னும் தனிப்பட்ட தரவுகளாகக் "
"கருதப்படுகிறது. சில கூடுதல் தகவல்கள் கிடைத்தால் அசல் பயனர் ஐடியை இன்னும் "
"அடையாளம் காண முடியும் (இது மாடோமோ மற்றும் உங்கள் தரவு செயலிக்கு மட்டுமே "
"அணுகல்)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseAnonymizeIp"
msgid "Anonymize Visitors' IP addresses"
msgstr "பார்வையாளர்களின் ஐபி முகவரிகளை அநாமதேயமாக்குங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseAnonymizeTrackingData"
msgid "Anonymize Tracking Data"
msgstr "கண்காணிப்பு தரவைக் கண்காணிக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.TrackingDataAnonymizationSettings"
msgid "Tracking data anonymization settings"
msgstr "தரவு அநாமதேய அமைப்புகளைக் கண்காணித்தல்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseAnonymizeUserId"
msgid "Anonymize User ID"
msgstr "பயனர் ஐடியை அநாமதேயப்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PseudonymizeUserId"
msgid "Replace User ID with a pseudonym"
msgstr "பயனர் ஐடியை ஒரு புனைப்பெயருடன் மாற்றவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutAppearance"
msgid "Customize the opt-out appearance"
msgstr "விலகல் தோற்றத்தைத் தனிப்பயனாக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutCustomize"
msgid "Customize the opt-out iframe"
msgstr "விலகல் iframe ஐத் தனிப்பயனாக்குங்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutHtmlCode"
msgid "HTML code to embed on your website"
msgstr "உங்கள் வலைத்தளத்தில் உட்பொதிக்க உஉகுமொ குறியீடு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutPreview"
msgid "Preview of the Opt-out as it will appear on your website"
msgstr "விலகல் உங்கள் வலைத்தளத்தில் தோன்றும் என்பதால் முன்னோட்டம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutCodeTypeExplanation"
msgid ""
"The opt-out can either be set by using the Matomo tracker code which means "
"less code to add to your website pages and less likely to need updating in "
"the future, or using standalone code which is more likely to work for "
"visitors with script blockers but will need to be updated on each webpage if"
" you change any settings."
msgstr ""
"மேட்டோமோ டிராக்கர் குறியீட்டைப் பயன்படுத்துவதன் மூலம் விலகல் அமைக்கப்படலாம்,"
" அதாவது உங்கள் வலைத்தள பக்கங்களில் சேர்க்க குறைந்த குறியீடு மற்றும் "
"எதிர்காலத்தில் புதுப்பிக்க வேண்டிய வாய்ப்பு குறைவு, அல்லது ச்கிரிப்ட் "
"தடுப்பான்களுடன் பார்வையாளர்களுக்கு வேலை செய்வதற்கான வாய்ப்புகள் அதிகம். "
"நீங்கள் ஏதேனும் அமைப்புகளை மாற்றினால் ஒவ்வொரு வலைப்பக்கத்திலும் "
"புதுப்பிக்கப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutUseTracker"
msgid "Use the Matomo tracker code to set the opt out"
msgstr "OPT ஐ அமைக்க மாடோமோ டிராக்கர் குறியீட்டைப் பயன்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutUseStandalone"
msgid "Use self-contained code to set the opt out"
msgstr "விலகலை அமைக்க தன்னிறைவான குறியீட்டைப் பயன்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutRememberToTest"
msgid "Remember to test your opt-out!"
msgstr "உங்கள் விலகலை சோதிக்க நினைவில் கொள்ளுங்கள்!"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutRememberToTestBody"
msgid ""
"To ensure that your opt-out is working properly with your website it is "
"recommended to perform the following quick test after adding the opt out "
"code."
msgstr ""
"உங்கள் வலைத்தளத்துடன் உங்கள் விலகல் சரியாக செயல்படுகிறது என்பதை "
"உறுதிப்படுத்த, OPTOUT குறியீட்டைச் சேர்த்த பிறகு பின்வரும் விரைவான சோதனையைச்"
" செய்ய பரிந்துரைக்கப்படுகிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutRememberToTestStep1"
msgid "Browse to your main website page."
msgstr "உங்கள் முக்கிய வலைத்தள பக்கத்திற்கு உலாவுக."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutRememberToTestStep2"
msgid "Once the page has loaded you should see the opt-out box."
msgstr "பக்கம் ஏற்றப்பட்டதும் நீங்கள் விலகல் பெட்டியைக் காண வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutRememberToTestStep3"
msgid "Unchecking the checkbox to opt-out should show the opted-out message."
msgstr "தேர்வுப்பெட்டியைத் தவிர்ப்பது விலகிய செய்தியைக் காட்ட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.OptOutRememberToTestStep4"
msgid "Checking the checkbox to opt-in should show the opted-in message."
msgstr ""
"தேர்வுக்கான தேர்வுப்பெட்டியை சரிபார்ப்பது தேர்ந்தெடுத்த செய்தியைக் காட்ட "
"வேண்டும்."

