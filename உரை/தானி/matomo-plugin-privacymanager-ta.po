msgstr "தரவுத்தளத்திலிருந்து பழைய மூல தரவை தவறாமல் நீக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseDeleteReports"
msgid "Regularly delete old reports from the database"
