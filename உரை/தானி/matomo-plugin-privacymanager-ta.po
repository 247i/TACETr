msgid "Consent Manager"
msgstr "ஒப்புதல் மேலாளர்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentManagerDetected"
msgid ""
"%1$s consent manager was detected on your website. To learn about "
"configuring Matomo to work with %1$s please read %2$sthis guide%3$s"
msgstr ""
"உங்கள் இணையதளத்தில் %1$s ஒப்புதல் மேலாளர் கண்டறியப்பட்டது. %1$s உடன் வேலை "
"செய்ய மாடோமோவை உள்ளமைப்பது பற்றி அறிய தயவுசெய்து %2$sthis வழிகாட்டி %3$s ஐப்"
" படிக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConsentManagerConnected"
msgid "%1$s appears to already be configured to work with Matomo."
msgstr "%1$s ஏற்கனவே மாடோமோவுடன் வேலை செய்ய கட்டமைக்கப்பட்டதாகத் தெரிகிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseRandomizeConfigId"
msgid "Randomize config_ID for enhanced privacy"
msgstr "மேம்படுத்தப்பட்ட தனியுரிமைக்காக config_ID ஐ சீரமைக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.RandomizeConfigIdNote"
msgid ""
"By randomizing the config_ID for every request, this feature ensures that "
"visitor tracking is compliant with the strictest privacy interpretations. "
"This setting disables mechanisms that rely on user-agent data, cookies, or "
"other identifiers that require explicit consent, allowing for anonymized "
"tracking while respecting user privacy."
msgstr ""
"ஒவ்வொரு கோரிக்கைக்கும் config_ID ஐ சீரற்றவாறு மாற்றுவதன் மூலம், இந்த "
"நற்பொருத்தம் கடுமையான தனியுரிமை விளக்கங்களுடன் பொருந்தும் பார்வையாளர் "
"கண்காணிப்பை உறுதிப்படுத்துகிறது. இந்த அமைத்தல் பயனர் முகவர் தகவல்கள், "
"குக்கீகள், அல்லது வேறு அடையாளங்கள் மேல் ஆதாரமாக வைத்து செயல்படும் முறைகளை "
"முடக்கி விடுகிறது, இது பயனர் தனியுரிமையை மதிப்பிடும் முறையில் "
"அனாமைப்படுத்தப்பட்ட கண்காணிப்பை அனுமதிக்கிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.RetentionPeriodPolicySettingTitle"
msgid "Data retention period"
msgstr "தரவு தக்கவைப்பு காலம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.RetentionPeriodPolicySettingRequirementNote"
msgid "Retention period is set to %1$s days."
msgstr "தக்கவைப்பு காலம் %1$s நாட்களாக அமைக்கப்பட்டுள்ளது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.RandomizeConfigIdNoteWarning"
msgid ""
"%1$sPlease note: %2$sWith this setting enabled, every action will be tracked"
" as a new visit."
msgstr ""
"%1$Plus குறிப்பு: %2$இந்த அமைப்பு இயக்கப்பட்டால், ஒவ்வொரு செயலும் புதிய "
"வருகையாகக் கண்காணிக்கப்படும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConfirmConfigRandomisationEnabled"
msgid "Are you sure you want to enable config_ID randomization?"
msgstr "config_ID சீரற்றமயமாக்கலை நிச்சயமாக இயக்க விரும்புகிறீர்களா?"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConfirmConfigRandomisationEnabledPerSite"
msgid ""
"Are you sure you want to save the site's settings and enable config_ID "
"randomization?"
msgstr ""
"தளத்தின் அமைப்புகளைச் சேமித்து, config_ID சீரற்றமயமாக்கலை இயக்க "
"விரும்புகிறீர்களா?"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ConfirmConfigRandomisationExplanation"
msgid ""
"Randomizing the config_ID for every request disables mechanisms that rely on"
" user-agent data, cookies, or other identifiers that require explicit "
"consent, allowing for anonymized tracking while respecting user privacy. "
"Every action will be tracked as a new visit."
msgstr ""
"ஒவ்வொரு கோரிக்கைக்கும் config_ID ஐ ரேண்டம் செய்வது, பயனர் முகவர் தரவு, "
"குக்கீகள் அல்லது வெளிப்படையான ஒப்புதல் தேவைப்படும் பிற அடையாளங்காட்டிகளை "
"நம்பியிருக்கும் பொறிமுறைகளை முடக்குகிறது, பயனர் தனியுரிமையை மதிக்கும் போது "
"அநாமதேய கண்காணிப்பை அனுமதிக்கிறது. ஒவ்வொரு செயலும் புதிய வருகையாகக் "
"கண்காணிக்கப்படும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.SiteAnonymizationConfig"
msgid "Anonymization configuration for this site"
msgstr "இந்த தளத்திற்கான அநாமதேய உள்ளமைவு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseSystemSettings"
msgid "Use system settings"
msgstr "கணினி அமைப்புகளைப் பயன்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseSiteSpecificSettings"
msgid "Use custom settings specific to this site"
msgstr "இந்த தளத்திற்கு குறிப்பிட்ட தனிப்பயன் அமைப்புகளைப் பயன்படுத்தவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.UseSiteSpecificSettingsHelpText"
msgid ""
"By default, each site uses anonymization settings defined for the whole "
"Matomo instance in %1$ssystem settings%2$s. If you select the '%3$s' option,"
" you can override each of the settings for this specific site."
msgstr ""
"இயல்பாக, ஒவ்வொரு தளமும் %1$ssystem அமைப்புகளில்%2$s இல் முழு Matomo "
"நிகழ்விற்கும் வரையறுக்கப்பட்ட அநாமதேய அமைப்புகளைப் பயன்படுத்துகிறது. நீங்கள்"
" '%3$s' விருப்பத்தைத் தேர்ந்தெடுத்தால், இந்தக் குறிப்பிட்ட தளத்திற்கான "
"ஒவ்வொரு அமைப்புகளையும் நீங்கள் மேலெழுதலாம்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ManagePrivacySettings"
msgid "Manage privacy settings"
msgstr "தனியுரிமை அமைப்புகளை நிர்வகிக்கவும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.PolicyControlledSetting"
msgid ""
"A privacy compliance policy overrides this settings, so changing it has no "
"effect right now."
msgstr ""
"தனியுரிமை இணக்கக் கொள்கையானது இந்த அமைப்புகளை மேலெழுதுகிறது, எனவே இதை "
"மாற்றினால் இப்போது எந்தப் பலனும் இல்லை."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ViewPrivacyComplianceOverview"
msgid "View privacy compliance overview"
msgstr "தனியுரிமை இணக்க கண்ணோட்டத்தைக் காண்க"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.CampaignTrackingParametersDisabledSettingTitle"
msgid "Campaign tracking parameters disabled"
msgstr "பிரச்சார கண்காணிப்பு அளவுருக்கள் முடக்கப்பட்டுள்ளன"

#, ignore-optional-plural, php-format, safe-html
msgctxt ""
"PrivacyManager.CampaignTrackingParametersDisabledSettingRequirementNote"
msgid "All campaign tracking parameters must be discarded."
msgstr "அனைத்து பிரச்சார கண்காணிப்பு அளவுருக்கள் நிராகரிக்கப்பட வேண்டும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ReferrerAnonymizationSettingTitle"
msgid "Referrer Anonymisation"
msgstr "பரிந்துரையாளர் அநாமதேயமாக்கல்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "PrivacyManager.ReferrerAnonymizationSettingRequirementNote"
msgid "Only the referrer host or referrer type may be collected."
msgstr "ரெஃபரர் புரவலன் அல்லது ரெஃபரர் வகை மட்டுமே சேகரிக்கப்படலாம்."
