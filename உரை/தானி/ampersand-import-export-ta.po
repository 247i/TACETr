# Suggested in Weblate: இறக்குமதி/ஏற்றுமதி
#, i18next-interpolation, ignore-inconsistent
msgctxt "header"
msgid "Import / Export"
msgstr "இறக்குமதி / ஏற்றுமதி"

# Suggested in Weblate: Import
#, i18next-interpolation
msgctxt "importHeader"
msgid "Import"
msgstr "இறக்குமதி"

#, i18next-interpolation
msgctxt "thirdPartyHeader"
msgid "Third party integrations"
msgstr "மூன்றாம் தரப்பு ஒருங்கிணைப்புகள்"

# Suggested in Weblate: ஏற்றுமதி
#, i18next-interpolation
msgctxt "exportHeader"
msgid "Export"
msgstr "ஏற்றுமதி"

#, i18next-interpolation, ignore-inconsistent
msgctxt "dbExport.title"
msgid "Export your data"
msgstr "உங்கள் தரவை ஏற்றுமதி செய்யவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "dbExport.desc"
msgid "Backup your current data to a file you can store somewhere else"
msgstr ""
"உங்கள் தற்போதைய தரவை வேறு எங்காவது சேமிக்கக்கூடிய கோப்பில் காப்புப் பிரதி "
"எடுக்கவும்"

#, i18next-interpolation
msgctxt "reportExport.title"
msgid "Generate a report"
msgstr "ஒரு அறிக்கையை உருவாக்கவும்"

#, i18next-interpolation
msgctxt "reportExport.desc"
msgid ""
"Save a human-readable report about your data to share with therapists and "
"loved ones"
msgstr ""
"சிகிச்சையாளர்கள் மற்றும் அன்புக்குரியவர்களுடன் பகிர்ந்து கொள்ள, உங்கள் "
"தரவைப் பற்றிய மனிதர்கள் படிக்கக்கூடிய அறிக்கையைச் சேமிக்கவும்"

#, i18next-interpolation
msgctxt "reportExport.includeHeader"
msgid "Select what to include"
msgstr "எதைச் சேர்க்க வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்"

#, i18next-interpolation
msgctxt "reportExport.includeArchived"
msgid "Archived members"
msgstr "காப்பகப்படுத்தப்பட்ட உறுப்பினர்கள்"

#, i18next-interpolation
msgctxt "reportExport.includeCustomFronts"
msgid "Custom fronts"
msgstr "தனிப்பயன் முனைகள்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "dbImportDesc"
msgid "Warning! It will override any existing data"
msgstr "எச்சரிக்கை! இது ஏற்கனவே உள்ள எந்த தரவையும் மேலெழுதும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "dbImport"
msgid "Import your data"
msgstr "உங்கள் தரவை இறக்குமதி செய்யவும்"

#, i18next-interpolation
msgctxt "dbImportOld.title"
msgid "Import your data from an old version of Ampersand"
msgstr "ஆம்பர்சண்டின் பழைய பதிப்பிலிருந்து உங்கள் தரவை இறக்குமதி செய்யவும்"

#, i18next-interpolation
msgctxt "dbImportOld.desc"
msgid "For backup files made with Ampersand < 0.2.0"
msgstr "ஆம்பர்சண்ட் <0.2.0 உடன் செய்யப்பட்ட காப்புப் பிரதி கோப்புகளுக்கு"

#, i18next-interpolation
msgctxt "dbImportOld.note"
msgid ""
"Old versions of Ampersand used a file format (ampdb) that is now outdated. "
"If you're keeping old backups, make sure to import them now and re-export "
"them, as this option will be removed in a few versions' time."
msgstr ""
"ஆம்பர்சண்டின் பழைய பதிப்புகள் இப்போது காலாவதியான கோப்பு வடிவத்தை (ampdb) "
"பயன்படுத்தின. நீங்கள் பழைய காப்புப்பிரதிகளை வைத்திருந்தால், அவற்றை இப்போது "
"இறக்குமதி செய்து மீண்டும் ஏற்றுமதி செய்வதை உறுதிசெய்யவும், ஏனெனில் இந்த "
"விருப்பம் சில பதிப்புகளில் அகற்றப்படும்."

#, i18next-interpolation
msgctxt "jsonExport.title"
msgid "Export your data to a JSON file"
msgstr "உங்கள் தரவை சாதொபொகு கோப்பில் ஏற்றுமதி செய்யவும்"

#, i18next-interpolation
msgctxt "jsonExport.desc"
msgid ""
"Backup your data to a format that can be imported into other applications "
"and tools"
msgstr ""
"பிற பயன்பாடுகள் மற்றும் கருவிகளில் இறக்குமதி செய்யக்கூடிய வடிவமைப்பில் "
"உங்கள் தரவை காப்புப் பிரதி எடுக்கவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "pkImport"
msgid "Import your data from a PluralKit export"
msgstr "PluralKit ஏற்றுமதியிலிருந்து உங்கள் தரவை இறக்குமதி செய்யவும்"

#, i18next-interpolation
msgctxt "ocImport"
msgid "Import your data from an Octocon export"
msgstr "ஆக்டோகான் ஏற்றுமதியிலிருந்து உங்கள் தரவை இறக்குமதி செய்யவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "tuImport"
msgid "Import your data from a Tupperbox export"
msgstr "Tupperbox ஏற்றுமதியிலிருந்து உங்கள் தரவை இறக்குமதி செய்யவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "spImport"
msgid "Import your data from a Simply Plural export"
msgstr "வெறுமனே பன்மை ஏற்றுமதியிலிருந்து உங்கள் தரவை இறக்குமதி செய்யவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.imported"
msgid "The backup has been imported. Please restart the app."
msgstr ""
"காப்புப்பிரதி இறக்குமதி செய்யப்பட்டது. பயன்பாட்டை மறுதொடக்கம் செய்யவும்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.importedSp"
msgid "The Simply Plural export has been imported. Please restart the app."
msgstr ""
"வெறுமனே பன்மை ஏற்றுமதி இறக்குமதி செய்யப்பட்டுள்ளது. பயன்பாட்டை மறுதொடக்கம் "
"செய்யவும்."

#, i18next-interpolation
msgctxt "status.importedOc"
msgid "The Octocon export has been imported. Please restart the app."
msgstr ""
"ஆக்டோகான் ஏற்றுமதி இறக்குமதி செய்யப்பட்டுள்ளது. பயன்பாட்டை மறுதொடக்கம் "
"செய்யவும்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.importedPk"
msgid "The PluralKit export has been imported. Please restart the app."
msgstr ""
"PluralKit ஏற்றுமதி இறக்குமதி செய்யப்பட்டுள்ளது. பயன்பாட்டை மறுதொடக்கம் "
"செய்யவும்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.importedTu"
msgid "The Tupperbox export has been imported. Please restart the app."
msgstr ""
"Tupperbox ஏற்றுமதி இறக்குமதி செய்யப்பட்டுள்ளது. பயன்பாட்டை மறுதொடக்கம் "
"செய்யவும்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.exportedApp"
msgid "The backup has been exported to the location you chose."
msgstr ""
"நீங்கள் தேர்ந்தெடுத்த இடத்திற்கு காப்புப்பிரதி ஏற்றுமதி செய்யப்பட்டது."

#, i18next-interpolation
msgctxt "status.exportedAppIos"
msgid "The backup has been exported to the Ampersand folder on the Files app."
msgstr ""
"கோப்புகள் பயன்பாட்டில் உள்ள ஆம்பர்சண்ட் கோப்புறைக்கு காப்புப்பிரதி ஏற்றுமதி "
"செய்யப்பட்டது."

#, i18next-interpolation
msgctxt "status.exportedReport"
msgid "The report has been saved in the location you chose."
msgstr "நீங்கள் தேர்ந்தெடுத்த இடத்தில் அறிக்கை சேமிக்கப்பட்டுள்ளது."

#, i18next-interpolation
msgctxt "status.exportedReportIos"
msgid "The report has been saved in the Ampersand folder on the Files app."
msgstr ""
"கோப்புகள் பயன்பாட்டில் உள்ள ஆம்பர்சண்ட் கோப்புறையில் அறிக்கை "
"சேமிக்கப்பட்டுள்ளது."

#, i18next-interpolation
msgctxt "status.exportedJson"
msgid "The JSON export has been saved in the location you chose."
msgstr "நீங்கள் தேர்ந்தெடுத்த இடத்தில் சாதொபொகு ஏற்றுமதி சேமிக்கப்பட்டது."

#, i18next-interpolation
msgctxt "status.exportedJsonIos"
msgid ""
"The JSON export has been saved in the Ampersand folder on the Files app."
msgstr ""
"சாதொபொகு ஏற்றுமதி கோப்புகள் பயன்பாட்டில் உள்ள ஆம்பர்சண்ட் கோப்புறையில் "
"சேமிக்கப்பட்டது."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.errorExport"
msgid "Error while exporting the backup."
msgstr "காப்புப்பிரதியை ஏற்றுமதி செய்வதில் பிழை."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.error"
msgid "Error while importing the backup."
msgstr "காப்புப்பிரதியை இறக்குமதி செய்யும் போது பிழை."

#, i18next-interpolation
msgctxt "status.errorOc"
msgid "Error while importing the Octocon export."
msgstr "ஆக்டோகான் ஏற்றுமதியை இறக்குமதி செய்யும் போது பிழை."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.errorSp"
msgid "Error while importing the Simply Plural export."
msgstr "வெறுமனே பன்மை ஏற்றுமதியை இறக்குமதி செய்யும் போது பிழை."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.errorPk"
msgid "Error while importing the PluralKit export."
msgstr "PluralKit ஏற்றுமதியை இறக்குமதி செய்யும் போது பிழை."

#, i18next-interpolation, ignore-inconsistent
msgctxt "status.errorTu"
msgid "Error while importing the Tupperbox export."
msgstr "Tupperbox ஏற்றுமதியை இறக்குமதி செய்யும் போது பிழை."
