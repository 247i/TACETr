msgstr "உரை பின் செய்யப்பட்டுள்ளது"

#, java-printf-format
msgctxt "export_clipboard_items"
msgid "Export clipboard items"
msgstr "இடைநிலைப்பலகை பொருட்களை ஏற்றுமதி செய்யவும்"

#, java-printf-format
msgctxt "import_clipboard_items"
