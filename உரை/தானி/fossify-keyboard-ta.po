#, java-printf-format
msgctxt "app_launcher_name"
msgid "Keyboard"
msgstr "விசைப்பலகை"

#, java-printf-format
msgctxt "redirection_note"
msgid ""
"Please enable Fossify Keyboard on the next screen, to make it an available "
"keyboard. Press 'Back' once enabled."
msgstr ""
"கிடைக்கக்கூடிய விசைப்பலகையாக மாற்ற, அடுத்த திரையில் Fossify விசைப்பலகையை "
"இயக்கவும். இயக்கப்பட்டவுடன் 'Back' என்பதை அழுத்தவும்."

#, java-printf-format
msgctxt "change_keyboard"
msgid "Change Keyboard"
msgstr "விசைப்பலகையை மாற்றவும்"

#.  Clipboard
#, java-printf-format
msgctxt "manage_clipboard_items"
msgid "Manage clipboard items"
msgstr "இடைநிலைப்பலகை உருப்படிகளை நிர்வகிக்கவும்"

#, java-printf-format
msgctxt "manage_clipboard_empty"
msgid "Your clipboard is empty."
msgstr "உங்கள் இடைநிலைப்பலகை காலியாக உள்ளது."

#, java-printf-format
msgctxt "manage_clipboard_label"
msgid ""
"Once you copy some text, it will show up here. You can also pin clips so "
"they won't disappear later."
msgstr ""
"நீங்கள் சில உரையை நகலெடுத்தவுடன், அது இங்கே காண்பிக்கப்படும். நீங்கள் "
"கிளிப்களையும் பின் செய்யலாம், அதனால் அவை பின்னர் மறைந்துவிடாது."

#, java-printf-format
msgctxt "clear_clipboard_data"
msgid "Clear clipboard data"
msgstr "இடைநிலைப்பலகை தரவை அழிக்கவும்"

#, java-printf-format
msgctxt "clear_clipboard_data_confirmation"
msgid "Are you sure you want to clear the clipboard data?"
msgstr "இடைநிலைப்பலகை தரவை நிச்சயமாக அழிக்க விரும்புகிறீர்களா?"

#, java-printf-format
msgctxt "clipboard"
msgid "Clipboard"
msgstr "இடைநிலைப் பலகை"

#, java-printf-format
msgctxt "clipboard_recent"
msgid "Recent"
msgstr "அண்மைக் கால"

#, java-printf-format
msgctxt "clipboard_current"
msgid "Current"
msgstr "மின்னோட்ட்ம், ஓட்டம்"

#, java-printf-format
msgctxt "clipboard_pinned"
msgid "Pinned"
msgstr "பின் செய்யப்பட்டது"

#, java-printf-format
msgctxt "add_new_item"
msgid "Add a new item"
msgstr "புதிய உருப்படியைச் சேர்க்கவும்"

#, java-printf-format
msgctxt "manage_keyboard_languages"
msgid "Manage keyboard languages"
msgstr "விசைப்பலகை மொழிகளை நிர்வகிக்கவும்"

#, java-printf-format
msgctxt "manage_clips"
msgid "You can manage or add clips here for quick access."
msgstr ""
"விரைவான அணுகலுக்காக இங்கே கிளிப்களை நிர்வகிக்கலாம் அல்லது சேர்க்கலாம்."

#, java-printf-format
msgctxt "clip_text"
