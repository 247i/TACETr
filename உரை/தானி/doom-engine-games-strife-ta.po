msgid "Thank you, anything else?"
msgstr "நன்றி, வேறு ஏதாவது?"

msgctxt "TXT_RNO1_SCRIPT02_D16676_YOUCA"
msgid "You can't afford that, good day to you!"
msgstr "உங்களால் அதை வாங்க முடியாது, உங்களுக்கு நல்ல நாள்!"

#. MAP02: Armory.
msgctxt "TXT_DLG_SCRIPT02_D18192_WELCO"
msgid "Welcome. What may I show you?"
msgstr "வரவேற்கிறோம். நான் உங்களுக்கு என்ன காட்ட முடியும்?"

msgctxt "TXT_RPLY0_SCRIPT02_D18192_ENVIR"
msgid "Environmental suit"
msgstr "சுற்றுச்சூழல் வழக்கு"

msgctxt "TXT_RYES0_SCRIPT02_D18192_WELLH"
msgid "Well, here you are."
msgstr "சரி, இங்கே நீங்கள் இருக்கிறீர்கள்."

msgctxt "TXT_RNO0_SCRIPT02_D18192_IMSOR"
msgid "I'm sorry but you don't have enough money for that."
msgstr "மன்னிக்கவும், அதற்கு போதுமான பணம் உங்களிடம் இல்லை."

msgctxt "TXT_RPLY1_SCRIPT02_D18192_LEATH"
msgid "Leather armor"
msgstr "தோல் கவசம்"

msgctxt "TXT_RYES1_SCRIPT02_D18192_HEREY"
msgid "Here you are."
msgstr "இங்கே நீங்கள் இருக்கிறீர்கள்."

msgctxt "TXT_RNO1_SCRIPT02_D18192_PERHA"
msgid "Perhaps some other time?"
msgstr "ஒருவேளை வேறு நேரமா?"

msgctxt "TXT_RPLY2_SCRIPT02_D18192_METAL"
msgid "Metal armor"
msgstr "உலோக கவசம்"

#. (in good health = enjoy)
msgctxt "TXT_RYES2_SCRIPT02_D18192_WEARI"
msgid "Wear it in good health."
msgstr "நல்ல ஆரோக்கியத்துடன் அணியுங்கள்."

msgctxt "TXT_RNO2_SCRIPT02_D18192_COMEB"
msgid "Come back when you can afford to buy something you lout!"
msgstr "நீங்கள் விரும்பி வாங்கும் போது திரும்பி வாருங்கள்!"

