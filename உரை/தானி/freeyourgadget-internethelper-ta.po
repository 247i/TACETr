#, java-printf-format
msgctxt "app_name"
msgid "Internet Helper for Gadgetbridge"
msgstr "Gadgetbridgeக்கான இணைய உதவியாளர்"

#, java-printf-format
msgctxt "permission_label"
msgid "Internet Access"
msgstr "இணைய அணுகல்"

#, java-printf-format
msgctxt "permission_description"
msgid "connect to the internet"
msgstr "இணையத்துடன் இணைக்கவும்"

#, java-printf-format
msgctxt "back_button"
msgid "Back"
msgstr "பின்"

#, java-printf-format
msgctxt "settings"
msgid "Settings"
msgstr "அமைப்புகள்"

#, java-printf-format
msgctxt "home_screen_app_desc"
msgid ""
"This app allows Gadgetbridge to access the internet by providing a basic "
"interface for network calls. Gadgetbridge is in control of what is requested"
" and what is shared."
msgstr ""
"பிணையம் அழைப்புகளுக்கான அடிப்படை இடைமுகத்தை வழங்குவதன் மூலம் இணையத்தை அணுக "
"இந்த ஆப்ச் Gadgetbridge ஐ அனுமதிக்கிறது. கேட்செட்பிரிட்ச் என்ன கோரப்பட்டது "
"மற்றும் பகிரப்பட்டது என்பதைக் கட்டுப்படுத்துகிறது."

#, java-printf-format
msgctxt "home_screen_button_open_settings"
msgid "Open Settings"
msgstr "அமைப்புகளைத் திறக்கவும்"

#, java-printf-format
msgctxt "setting_debug_logging_title"
msgid "Debug logging"
msgstr "பிழைத்திருத்த பதிவு"

#, java-printf-format
msgctxt "setting_debug_logging_desc"
msgid "Enable logging for troubleshooting purposes"
msgstr "பிழைகாணல் நோக்கங்களுக்காக உள்நுழைவை இயக்கவும்"

#, java-printf-format
msgctxt "button_share_log_file"
msgid "Share log file now"
msgstr "பதிவு கோப்பை இப்போது பகிரவும்"

#, java-printf-format
msgctxt "toast_no_log_file_found"
msgid "No log file found!"
msgstr "பதிவு கோப்பு எதுவும் கிடைக்கவில்லை!"
