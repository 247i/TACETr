msgid "{count, plural, =1{Teacher} other{{count} Teachers}}"
msgstr "{count, plural, =1{Teacher} மற்ற{{count} ஆசிரியர்கள்}}"

#, icu-message-format
msgctxt "loadCredentials"
msgid "Loading credentials…"
msgstr "நற்சான்றிதழ்களை ஏற்றுகிறது…"

