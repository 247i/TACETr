#: tools/debian/changes.py
#, python-brace-format
msgid "Changes file {filename} could not be parsed"
msgstr "மாற்றங்கள் கோப்பு {filename} பாகுபடுத்த முடியவில்லை"

#: tools/debian/changes.py
#, python-brace-format
msgid "Changes file invalid. Missing key {key}"
msgstr "மாற்றப்பட்ட கோப்பு தவறானது. விசை {key} இல்லை"

#: tools/debian/changes.py
msgid ""
"dsc is missing from changes\n"
"Make sure you include the full source (if you are using sbuild make sure to use the --source option or the equivalent configuration item; if you are using dpkg-buildpackage directly use the default flags or -S for a source only upload)"
msgstr ""
"மாற்றங்களில் dsc இல்லை \n"
"நீங்கள் முழு மூலத்தையும் சேர்த்துள்ளீர்கள் என்பதை உறுதிப்படுத்திக் கொள்ளுங்கள் (நீங்கள் sbuild ஐப் பயன்படுத்தினால் --source விருப்பத்தை அல்லது அதற்கு சமமான உள்ளமைவு உருப்படியைப் பயன்படுத்துவதை உறுதிசெய்யவும்; நீங்கள் dpkg-buildpackage ஐப் பயன்படுத்தினால், இயல்புநிலைக் கொடிகள் அல்லது -S ஐ ஆதாரத்திற்கு மட்டும் பதிவேற்றம் செய்யவும்)"

#: tools/debian/changes.py
#, python-brace-format
msgid ""
"{source} exists in the official Debian archive with the version "
"{version}/{distribution}. You may not upload a lower or equal version to "
"this one."
msgstr ""
"{source} exists in the official Debian archive with the version "
"{version}/{distribution}. You சி-வைகாசி not upload a lower or equal version "
"பெறுநர் this one."

#: tools/debian/control.py
#, python-brace-format
msgid "Failed to parse debian/control:{message}"
msgstr "டெபியன்/கட்டுப்பாட்டைப் பாகுபடுத்துவதில் தோல்வி:{message}"

#: tools/debian/control.py
msgid "No source definition found"
msgstr "ஆதார வரையறை எதுவும் இல்லை"

#: tools/debian/control.py
msgid "No binary definition found"
msgstr "பைனரி வரையறை இல்லை"

#: tools/debian/control.py
#, python-brace-format
msgid "Missing key {key} in source definition"
msgstr "மூல விளக்கத்தில் விசை {key} இல்லை"

#: tools/debian/copyright.py
#, python-brace-format
msgid "Failed to parse debian/copyright: {message}"
msgstr "டெபியன்/பதிப்புரிமையை அலசுவதில் தோல்வி: {message}"

#: tools/debian/dsc.py
#, python-brace-format
msgid "{dsc} could not be parsed"
msgstr "{dsc} ஐ பாகுபடுத்த முடியவில்லை"

#: tools/debian/dsc.py
#, python-brace-format
msgid "Missing key {key}"
msgstr "விசை {key} இல்லை"

#: tools/debian/origin.py
#, python-brace-format
msgid "Failed to retrive origin info: {e}"
msgstr "மூலத் தகவலைப் பெறுவதில் தோல்வி: {e}"

#: tools/debian/origin.py
#, python-brace-format
msgid ""
"Source package origin file differs from the official archive:\n"
"\n"
"Origin file         : {origin}\n"
"\n"
"sha256sum in upload : {upload}\n"
"sha256sum in archive: {archive}"
msgstr ""
"மூல தொகுப்பு மூலக் கோப்பு அதிகாரப்பூர்வ காப்பகத்திலிருந்து வேறுபடுகிறது: \n"
"\n"
"மூலக் கோப்பு: {origin} \n"
"\n"
"பதிவேற்றத்தில் sha256sum : {upload} \n"
"காப்பகத்தில் sha256sum: {archive}"

#: tools/debian/source.py
#, python-brace-format
msgid "Internal error. Please contact debexpo administrators at {email}"
msgstr "உள் பிழை. debexpo நிர்வாகிகளை {email} இல் தொடர்பு கொள்ளவும்"

#: tools/debian/source.py
#, python-brace-format
msgid "Could not extract source package from {dsc}: {e}"
msgstr "{dsc}: {e} இலிருந்து மூலத் தொகுப்பைப் பிரித்தெடுக்க முடியவில்லை"

#: tools/debian/source.py
#, python-brace-format
msgid "Could not extract source package from {dsc}: extraction took too long"
msgstr ""
"{dsc} இலிருந்து மூலத் தொகுப்பைப் பிரித்தெடுக்க முடியவில்லை: பிரித்தெடுக்க "
"அதிக நேரம் எடுத்தது"

#: tools/files.py
#, python-brace-format
msgid "No checksum method available for file {filename}."
msgstr "கோப்பு {filename} க்கு செக்சம் முறை இல்லை."

#: tools/files.py
#, python-brace-format
msgid ""
"Checksum failed for file {filename}.\n"
"\n"
"Expected: {expected}\n"
"Computed: {computed}"
msgstr ""
"{filename} கோப்புக்கான செக்சம் தோல்வியடைந்தது. \n"
"\n"
"எதிர்பார்க்கப்படுகிறது: {expected} \n"
"கணக்கிடப்பட்டது: {computed}"

#: tools/files.py
#, python-brace-format
msgid "{filename} is missing from upload"
msgstr "{filename} is missing இருந்து upload"

#: tools/gnupg.py
#, python-brace-format
msgid ""
"Unable to verify file {filename}. No public key found for key {fingerprint}"
msgstr ""
"Unable பெறுநர் verify கோப்பு {filename}. இல்லை public key found க்கு key "
"{fingerprint}"

#: tools/gnupg.py
#, python-brace-format
msgid "{filename}: not a GPG signed file"
msgstr "{filename}: not a GPG signed கோப்பு"

#: tools/gnupg.py
#, python-brace-format
msgid "Unknown GPG error. Output was: {output}"
msgstr "தெரியவில்லை GPG error. Output was: {output}"

#: tools/gnupg.py
#, python-brace-format
msgid "Cannot add key: {key}"
msgstr "விசையைச் சேர்க்க முடியாது: {key}"
