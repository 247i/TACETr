#, i18next-interpolation, ignore-inconsistent
msgctxt "header"
msgid "Accessibility"
msgstr "அணுகல்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "highLegibilityFont.title"
msgid "High legibility font"
msgstr "உயர் தெளிவுத்திறன் எழுத்துரு"

#, i18next-interpolation, ignore-inconsistent
msgctxt "highLegibilityFont.desc"
msgid "Use a high legibility font instead of the standard device font"
msgstr ""
"நிலையான சாதன எழுத்துருவுக்குப் பதிலாக உயர் தெளிவுத்திறன் எழுத்துருவைப் "
"பயன்படுத்தவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "highLegibilityFontType.title"
msgid "High legibility font family"
msgstr "உயர் தெளிவுத்திறன் கொண்ட எழுத்துரு குடும்பம்"

#, i18next-interpolation, ignore-inconsistent, ignore-same
msgctxt "highLegibilityFontType.atkinson"
