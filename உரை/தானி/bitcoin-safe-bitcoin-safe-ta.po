msgstr "அதிகபட்சம் ≈ {amount}"

msgctxt "BackupNsecNotificationBar"
msgid "Please backup your sync key."
msgstr "உங்கள் ஒத்திசைவு விசையை காப்புப் பிரதி எடுக்கவும்."

msgctxt "BackupNsecNotificationBar"
