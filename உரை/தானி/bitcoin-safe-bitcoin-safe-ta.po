msgid "Error"
msgstr "பிழை"

msgctxt "bitcoin_usb"
msgid "Executing the script"
msgstr "ச்கிரிப்டை செயல்படுத்துதல்"

msgctxt "bitcoin_usb"
msgid "Install udev files"
msgstr "udev கோப்புகளை நிறுவவும்"

msgctxt "bitcoin_usb"
msgid "No HWI AddressType could be found for {name}"
msgstr "{name} க்கான HWI முகவரி வகை எதுவும் கண்டறியப்படவில்லை"

msgctxt "bitcoin_usb"
msgid "No suitable terminal emulator found."
msgstr "பொருத்தமான டெர்மினல் எமுலேட்டர் இல்லை."

msgctxt "bitcoin_usb"
msgid ""
"The network part {network_str} of the key origin {key_origin} must be "
"hardened with a h"
msgstr ""
"முக்கிய மூலத்தின் {network_str} பிணையம் பகுதி {key_origin} ஒரு h உடன் "
"கடினமாக்கப்பட வேண்டும்"

msgctxt "bitcoin_usb"
msgid ""
"USB errors can appear due to missing udev files. Do you want to install udev"
" files now?"
msgstr ""
"udev கோப்புகள் இல்லாததால் USB பிழைகள் தோன்றலாம். இப்போது udev கோப்புகளை "
"நிறுவ விரும்புகிறீர்களா?"

msgctxt "bitcoin_usb"
msgid "Unknown network/coin type {network_str} in {key_origin}"
msgstr "{key_origin} இல் தெரியாத நெட்வொர்க்/காயின் வகை {network_str}"

msgctxt "bitcoin_usb"
msgid "derivation_path {value} must start with a /"
msgstr "derivation_path {value} ஒரு / உடன் தொடங்க வேண்டும்"

msgctxt "bitcoin_usb"
msgid "{value} is not a valid fingerprint"
msgstr "{value} என்பது சரியான கைரேகை அல்ல"

