#. Clue descriptions
#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-adjacent"
msgid "{ $tiles } are adjacent (in either direction)."
msgstr "{ $tiles } அருகில் உள்ளன (இரு திசையிலும்)."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-two-adjacent"
msgid ""
"{ \"{\" }tile:{ $tile1 }{ \"}\" } is next to { \"{\" }tile:{ $tile2 }{ \"}\""
" } (in either direction)."
msgstr ""
"{ \"{\" }டைல்:{ $tile1 }{ \"}\" } என்பது { \"{\" }டைலுக்கு அடுத்துள்ளது:{ "
"$tile2 }{ \"}\" } (இரு திசையிலும்)."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-two-apart"
msgid ""
"{ \"{\" }tile:{ $tile1 }{ \"}\" } is two away from { \"{\" }tile:{ $tile3 }{"
" \"}\" }, without { \"{\" }tile:{ $tile2 }{ \"}\" } in the middle (in either"
" direction)."
msgstr ""
"{ \"{\" }டைல்:{ $tile 1 }{ \"}\" } என்பது { \"{\" }டைல்:{ $tile }{ \"}\" } "
"இலிருந்து இரண்டு தூரத்தில் உள்ளது, { \"{\" }டைல்:{ $tile2 }{ \"}\" } "
"இல்லாமல் நடுவில் (இரு திசையிலும்)."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-left-of"
msgid ""
"{ \"{\" }tile:{ $left }{ \"}\" } is left of { \"{\" }tile:{ $right }{ \"}\" "
"} (any number of tiles in between)."
msgstr ""
"{ \"{\" }டைல்:{ $left }{ \"}\" } என்பது { \"{\" }டைல்:{ $right }{ \"}\" } "
"(இடையில் உள்ள ஓடுகள்)"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-not-adjacent"
msgid ""
"{ \"{\" }tile:{ $tile1 }{ \"}\" } is not next to { \"{\" }tile:{ $tile2 }{ "
"\"}\" } (in either direction)."
msgstr ""
"{ \"{\" }டைல்:{ $tile1 }{ \"}\" } என்பது { \"{\" }டைலுக்கு அடுத்ததாக இல்லை:{"
" $tile2 }{ \"}\" } (இரு திசையிலும்)."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-same-column"
msgid "{ $tiles } are in the same column."
msgstr "{ $tiles } அதே நெடுவரிசையில் உள்ளன."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-two-in-column-without"
msgid ""
"{ \"{\" }tile:{ $tile1 }{ \"}\" } and { \"{\" }tile:{ $tile2 }{ \"}\" } are "
"in the same column, but { \"{\" }tile:{ $tile3 }{ \"}\" } isn't."
msgstr ""
"{ \"{\" }டைல்:{ $tile1 }{ \"}\" } மற்றும் { \"{\" }டைல்:{ $tile2 }{ \"}\" } "
"ஆகியவை ஒரே நெடுவரிசையில் உள்ளன, ஆனால் { \"{\" }டைல்:{ $tile3 }{ \"}\" } "
"இல்லை."

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-not-same-column"
msgid ""
"{ \"{\" }tile:{ $tile1 }{ \"}\" } is not in the same column as { \"{\" "
"}tile:{ $tile2 }{ \"}\" }"
msgstr ""
"{ \"{\" }டைல்:{ $tile1 }{ \"}\" } அதே நெடுவரிசையில் { \"{\" }டைல்:{ $tile2 "
"}{ \"}\" } இல்லை"

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "clue-desc-one-matches-either"
msgid ""
"{ \"{\" }tile:{ $tile1 }{ \"}\" } is either in the same column as { \"{\" "
"}tile:{ $tile2 }{ \"}\" } or { \"{\" }tile:{ $tile3 }{ \"}\" }, but not "
"both."
msgstr ""
"{ \"{\" }டைல்:{ $tile1 }{ \"}\" } என்பது { \"{\" }டைல்:{ $tile2 }{ \"}\" } "
"அல்லது { \"{\" }டைல்:{ $tile3 }{ \"}\" } போன்ற நெடுவரிசையில் உள்ளது, ஆனால் "
"இரண்டும் இல்லை."

