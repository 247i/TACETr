msgctxt "uri_link_error_invalid_protocol"
msgid ""
"Unable to open.\n"
"Address type not supported.\n"
"%s"
msgstr ""
"திறக்க முடியவில்லை. \n"
"முகவரி வகை ஆதரிக்கப்படவில்லை. \n"
"%s"

