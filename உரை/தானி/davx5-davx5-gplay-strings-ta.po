#.  Navigation drawer
#, java-printf-format
msgctxt "nav_earn_badges"
msgid "Support us with badges"
msgstr "பேட்ச்களுடன் எங்களை ஆதரிக்கவும்"

#, java-printf-format
msgctxt "nav_rate_us"
msgid "Review in Google Play"
msgstr "Google Play இல் மதிப்பாய்வு செய்யவும்"

#, java-printf-format
msgctxt "nav_feedback_inapp_didnt_appear"
msgid "In-app review didn't appear?"
msgstr "பயன்பாட்டு மதிப்பாய்வு தோன்றவில்லையா?"

#, java-printf-format
msgctxt "nav_feedback_google_play"
msgid "Send in Google Play"
msgstr "Google Play இல் அனுப்பவும்"

#, java-printf-format
msgctxt "nav_feedback_scroll_to_reviews"
msgid "Scroll to review section to submit feedback"
msgstr "கருத்தைச் சமர்ப்பிக்க மதிப்பாய்வு பகுதிக்குச் செல்லவும்"

#.  AboutActivity
#, java-printf-format
msgctxt "about_flavor_info"
msgid "This version is only eligible for distribution over Google Play."
msgstr "இந்தப் பதிப்பு Google Play இல் விநியோகிக்க மட்டுமே தகுதியானது."

#.  EarnBadgesActivity
#, java-printf-format
msgctxt "you_earned_badges"
msgid "You've earned a badge, thank you!"
msgid_plural "You have earned %d badges, thank you!"
msgstr[0] "பேட்சைப் பெற்றுள்ளீர்கள், நன்றி!"
msgstr[1] "நீங்கள் %d பேட்ச்களைப் பெற்றுள்ளீர்கள், நன்றி!"

#, java-printf-format
msgctxt "available_badges"
msgid "Available badges"
msgstr "கிடைக்கும் பேட்ச்கள்"

#, java-printf-format
msgctxt "available_badges_empty"
msgid "Sorry, could not load badges. Are you logged in to the Play Store?"
msgstr ""
"மன்னிக்கவும், பேட்ச்களை ஏற்ற முடியவில்லை. நீங்கள் Play Store இல் "
"உள்நுழைந்திருக்கிறீர்களா?"

#, java-printf-format
msgctxt "what_are_badges"
msgid "What are badges?"
msgstr "பேட்ச்கள் என்றால் என்ன?"

#, java-printf-format
msgctxt "what_are_badges_title"
msgid "What are badges?"
msgstr "பேட்ச்கள் என்றால் என்ன?"

#, java-printf-format
msgctxt "what_are_badges_body"
msgid ""
"Badges are simple in-app one-time-payments. You will earn a nice little "
"badge and with it you can support us over time."
msgstr ""
"பேட்ச்கள் பயன்பாட்டில் ஒரு முறை செலுத்தும் எளிமையானவை. நீங்கள் ஒரு நல்ல "
"சிறிய பேட்சைப் பெறுவீர்கள், அதன் மூலம் காலப்போக்கில் எங்களை ஆதரிக்கலாம்."

#, java-printf-format
msgctxt "why_badges_title"
msgid "Why does DAVx5 offer feature-free badges?"
msgstr "DAVx5 நற்பொருத்தம் இல்லாத பேட்ச்களை ஏன் வழங்குகிறது?"

#, java-printf-format
msgctxt "why_badges_body"
msgid ""
"DAVx5 has really grown over the years! We are still actively developing new "
"features, providing support and we always update the app for upcoming "
"Android versions. These badges are one-time payments where you can simply "
"show your support by buying us a coffee, or two… or 10 :-) We want to be as "
"open as possible, so there will never-ever be any new stuff locked to in-app"
" payment."
msgstr ""
"DAVx5 உண்மையில் பல ஆண்டுகளாக வளர்ந்துள்ளது! நாங்கள் இன்னும் புதிய "
"அம்சங்களைத் தீவிரமாக உருவாக்கி வருகிறோம், ஆதரவை வழங்குகிறோம், மேலும் "
"வரவிருக்கும் ஆண்ட்ராய்டு பதிப்புகளுக்கான பயன்பாட்டை எப்போதும் புதுப்பித்து "
"வருகிறோம். இந்த பேட்ச்கள் ஒரு முறை செலுத்தும் பணம் ஆகும், இதில் நீங்கள் "
"எங்களுக்கு ஒரு காபி அல்லது இரண்டு... அல்லது 10 வாங்குவதன் மூலம் உங்கள் "
"ஆதரவைக் காட்டலாம்."

#, java-printf-format
msgctxt "button_buy_badge_free"
msgid "FREE"
msgstr "இலவசம்"

#, java-printf-format
msgctxt "button_buy_badge_bought"
msgid "Thank you!"
msgstr "நன்றி!"

#, java-printf-format
msgctxt "earn_badges"
msgid "Earn badges to support us!"
msgstr "எங்களை ஆதரிக்க பேட்ச்களைப் பெறுங்கள்!"

#, java-printf-format
msgctxt "billing_unavailable"
msgid "Billing API not available"
msgstr "பட்டியலிடல் பநிஇ கிடைக்கவில்லை"

#, java-printf-format
msgctxt "purchase_acknowledgement_failed"
msgid "Failed to acknowledge purchase"
msgstr "வாங்கியதை அங்கீகரிக்க முடியவில்லை"

#, java-printf-format
msgctxt "purchase_acknowledgement_successful"
msgid "Thank you for the support!"
msgstr "ஆதரவுக்கு நன்றி!"

#, java-printf-format
msgctxt "purchase_failed"
msgid "Purchase failed"
msgstr "வாங்க முடியவில்லை"

#, java-printf-format
msgctxt "network_problems"
msgid "Network problems, please try again later."
msgstr "பிணையம் பிரச்சனைகள், பிறகு முயற்சிக்கவும்."

#, java-printf-format
msgctxt "badge_consumption_action"
msgid "Tap to consume"
msgstr "நுகர்வதற்கு தட்டவும்"

#, java-printf-format
msgctxt "badge_consumption_message"
msgid ""
"Consumption will remove this badge from your library and show a cool "
"animation. This will allow you to buy the badge again, and keep supporting "
"us."
msgstr ""
"நுகர்வு உங்கள் லைப்ரரியில் இருந்து இந்த பேட்சை அகற்றி, குளிர்ச்சியான "
"அனிமேசனைக் காண்பிக்கும். இது மீண்டும் பேட்சை வாங்க உங்களை அனுமதிக்கும், "
"மேலும் தொடர்ந்து எங்களை ஆதரிக்கவும்."

#, java-printf-format
msgctxt "badge_consumption_warning"
msgid ""
"Consumption cannot be undone, and will allow you to earn the badge again."
msgstr ""
"நுகர்வைச் செயல்தவிர்க்க முடியாது, மேலும் பேட்சைப் பெற உங்களை அனுமதிக்கும்."

#, java-printf-format
msgctxt "badge_consumption_content_description"
msgid "Earned badge. Tap to consume"
msgstr "பெற்ற ஒட்டு. நுகர்வதற்கு தட்டவும்"

#, java-printf-format
msgctxt "badge_consumption_success_zero"
msgid "You consumed all %1$s."
msgstr "நீங்கள் அனைத்து %1$s ஐயும் உட்கொண்டீர்கள்."

#, java-printf-format
msgctxt "badge_consumption_success_multiple"
msgid "You consumed a %1$s. %2$d badge left."
msgid_plural "You consumed a %1$s. %2$d badges left."
msgstr[0] "நீங்கள் %1$s ஐ உட்கொண்டீர்கள். %2$d ஒட்டு மீதமுள்ளது."
msgstr[1] "நீங்கள் %1$s ஐ உட்கொண்டீர்கள். %2$d badges left."
