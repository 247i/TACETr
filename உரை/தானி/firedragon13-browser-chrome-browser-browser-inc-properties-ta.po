#, auto-java-messageformat
msgctxt "eme.siteprompt2"
msgid "Allow %S to play DRM-controlled content?"
msgstr "DRM-கட்டுப்படுத்தப்பட்ட உள்ளடக்கத்தை இயக்க %S ஐ அனுமதிக்கவா?"

#, auto-java-messageformat
msgctxt "eme.block"
msgid "Block"
msgstr "தடு"

#, auto-java-messageformat
msgctxt "eme.block.accesskey"
msgid "B"
msgstr "பி"

#, auto-java-messageformat
msgctxt "eme.allow2"
msgid "Allow"
msgstr "இசைவு"

#, auto-java-messageformat
msgctxt "eme.allow2.accesskey"
msgid "A"
msgstr "ஏ"

#, auto-java-messageformat
msgctxt "eme.remember2"
msgid "Remember this decision"
msgstr "இந்த முடிவை நினைவில் கொள்ளுங்கள்"

#, auto-java-messageformat
msgctxt "webgl.siteprompt2"
msgid "Allow %S to create a WebGL context?"
msgstr "WebGL சூழலை உருவாக்க %S ஐ அனுமதிக்கவா?"

#, auto-java-messageformat
msgctxt "webgl.siteprompt2.warning"
msgid "This may be used to uniquely identify your computer."
msgstr "உங்கள் கணினியை தனித்துவமாக அடையாளம் காண இது பயன்படுத்தப்படலாம்."

