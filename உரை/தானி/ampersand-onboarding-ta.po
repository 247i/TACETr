#, i18next-interpolation, ignore-inconsistent
msgctxt "welcomeScreen.header"
msgid "Welcome to Ampersand!"
msgstr "ஆம்பர்சண்டிற்கு வரவேற்கிறோம்!"

#, i18next-interpolation, ignore-inconsistent
msgctxt "welcomeScreen.start"
msgid "Start your journey!"
msgstr "உங்கள் பயணத்தைத் தொடங்குங்கள்!"

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.header"
msgid "Would you want to import your data?"
msgstr "உங்கள் தரவை இறக்குமதி செய்ய விரும்புகிறீர்களா?"

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.prevInstall"
msgid "Yes, previous installation"
msgstr "ஆம், முந்தைய நிறுவல்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.simplyPlural"
msgid "Yes, Simply Plural"
msgstr "ஆம், வெறுமனே பன்மை"

#, i18next-interpolation
msgctxt "importScreen.octocon"
msgid "Yes, Octocon"
msgstr "ஆம், ஆக்டோகான்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.pluralKit"
msgid "Yes, PluralKit"
msgstr "ஆம், PluralKit"

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.tupperbox"
msgid "Yes, Tupperbox"
msgstr "ஆம், டப்பர்பாக்ச்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.startFromScratch"
msgid "No, I'll start from scratch"
msgstr "இல்லை, நான் புதிதாக ஆரம்பிக்கிறேன்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.pleaseWait"
msgid "Please wait while we import your data"
msgstr "உங்கள் தரவை நாங்கள் இறக்குமதி செய்யும் வரை காத்திருக்கவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.error"
msgid "Error while importing the backup. Please select another option."
msgstr ""
"காப்புப்பிரதியை இறக்குமதி செய்யும் போது பிழை. தயவுசெய்து மற்றொரு "
"விருப்பத்தைத் தேர்ந்தெடுக்கவும்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.errorSp"
msgid ""
"Error while importing the Simply Plural export. Please select another "
"option."
msgstr ""
"வெறுமனே பன்மை ஏற்றுமதியை இறக்குமதி செய்யும் போது பிழை. தயவுசெய்து மற்றொரு "
"விருப்பத்தைத் தேர்ந்தெடுக்கவும்."

#, i18next-interpolation
msgctxt "importScreen.errorOc"
msgid ""
"Error while importing the Octocon export. Please select another option."
msgstr ""
"ஆக்டோகான் ஏற்றுமதியை இறக்குமதி செய்யும் போது பிழை. தயவுசெய்து மற்றொரு "
"விருப்பத்தைத் தேர்ந்தெடுக்கவும்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.errorPk"
msgid ""
"Error while importing the PluralKit export. Please select another option."
msgstr ""
"PluralKit ஏற்றுமதியை இறக்குமதி செய்யும் போது பிழை. தயவுசெய்து மற்றொரு "
"விருப்பத்தைத் தேர்ந்தெடுக்கவும்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "importScreen.errorTu"
msgid ""
"Error while importing the Tupperbox export. Please select another option."
msgstr ""
"Tupperbox ஏற்றுமதியை இறக்குமதி செய்யும் போது பிழை. தயவுசெய்து மற்றொரு "
"விருப்பத்தைத் தேர்ந்தெடுக்கவும்."

#, i18next-interpolation
msgctxt "importScreen.allowRemoteContent.header"
msgid "Allow Internet connection?"
msgstr "இணைய இணைப்பை அனுமதிக்கவா?"

#, i18next-interpolation
msgctxt "importScreen.allowRemoteContent.desc"
msgid ""
"Ampersand is an offline-first application, and as such it needs your consent"
" to connect to the Internet. It would connect to the internet to download "
"your member's avatars and banners at this stage. You can turn this feature "
"off in Options > Security > Allow remote content when you're done."
msgstr ""
"ஆம்பர்சண்ட் என்பது ஆஃப்லைனில் முதல் பயன்பாடாகும், எனவே இணையத்துடன் இணைக்க "
"உங்கள் ஒப்புதல் தேவை. இந்த கட்டத்தில் உங்கள் உறுப்பினரின் அவதாரங்கள் மற்றும்"
" பேனர்களைப் பதிவிறக்க இது இணையத்துடன் இணைக்கப்படும். நீங்கள் முடித்ததும், "
"விருப்பங்கள் > பாதுகாப்பு > ரிமோட் உள்ளடக்கத்தை இசைவு என்பதில் இந்த அம்சத்தை"
" முடக்கலாம்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "systemInfo.header"
msgid "Tell us about your system!"
msgstr "உங்கள் அமைப்பைப் பற்றி எங்களிடம் கூறுங்கள்!"

#, i18next-interpolation, ignore-inconsistent
msgctxt "systemInfo.name"
msgid "Collective name"
msgstr "கூட்டுப் பெயர்"

#, i18next-interpolation, ignore-ellipsis, ignore-inconsistent
msgctxt "systemInfo.description"
msgid "A little about all of you..."
msgstr "உங்கள் அனைவரையும் பற்றி கொஞ்சம்..."

#, i18next-interpolation, ignore-inconsistent
msgctxt "memberInfo.header"
msgid "Tell us more about you!"
msgstr "உங்களைப் பற்றி மேலும் சொல்லுங்கள்!"

#, i18next-interpolation, ignore-ellipsis, ignore-inconsistent
msgctxt "memberInfo.description"
msgid "A little about yourself..."
msgstr "உங்களை பற்றி கொஞ்சம்..."

#, i18next-interpolation, ignore-inconsistent
msgctxt "memberInfo.invitation"
msgid "Keep editing your profile card after you’re done with the onboarding!"
msgstr ""
"ஆன்போர்டிங்கை முடித்த பிறகு, உங்கள் சுயவிவர அட்டையைத் தொடர்ந்து திருத்தவும்!"

#, i18next-interpolation, ignore-inconsistent
msgctxt "endScreen.header"
msgid "Thanks for choosing Ampersand!"
msgstr "ஆம்பர்சண்டைத் தேர்ந்தெடுத்ததற்கு நன்றி!"

#, i18next-interpolation, ignore-inconsistent
msgctxt "endScreen.startButton"
msgid "Let's start!"
msgstr "ஆரம்பிப்போம்!"
