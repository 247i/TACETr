#: prefs.js:91 prefs.js:2354 prefs.js:2387
msgid "Advanced Media Controller"
msgstr "மேம்பட்ட மீடியா கட்டுப்படுத்தி"

#: prefs.js:97
msgid "General"
msgstr "பொது"

#: prefs.js:103
msgid "Panel Placement"
msgstr "பேனல் இடம்"

#: prefs.js:104
msgid "Where the indicator sits in the top bar"
msgstr "குறிப்பான் மேல் பட்டியில் எங்கு உள்ளது"

#: prefs.js:108
msgid "Panel Position"
msgstr "பேனல் நிலை"

#: prefs.js:110
msgid "Left"
msgstr "இடது"

#: prefs.js:110
msgid "Center"
msgstr "மையம்"

#: prefs.js:110
msgid "Right"
msgstr "வலது"

#: prefs.js:125
msgid "Panel Index"
msgstr "பேனல் குறியீடு"

#: prefs.js:126
msgid "Position within the panel area (-1 = automatic)"
msgstr "பேனல் பகுதியில் நிலை (-1 = தானியக்கம்)"

#: prefs.js:144
msgid "Panel Label"
msgstr "பேனல் லேபிள்"

#: prefs.js:145
msgid "Track name shown in the top bar"
msgstr "மேல் பட்டியில் காட்டப்படும் பாடல் பெயர்"

#: prefs.js:150
msgid "Show Track Name"
msgstr "பாடல் பெயரைக் காட்டு"

#: prefs.js:151
msgid "Display the current track title in the panel"
msgstr "தற்போதைய பாடல் தலைப்பை பேனலில் காட்டு"

#: prefs.js:162
msgid "Show Artist Name"
msgstr "கலைஞர் பெயரைக் காட்டு"

#: prefs.js:163
msgid "Append the artist name to the track title"
msgstr "பாடல் தலைப்பில் கலைஞர் பெயரை இணை"

#: prefs.js:174
msgid "Title / Artist Separator"
msgstr "தலைப்பு / கலைஞர் பிரிப்பான்"

#: prefs.js:184
msgid "Panel Scrolling"
msgstr "பேனல் உருட்டல்"

#: prefs.js:185
msgid "Marquee scroll of the track label in the top bar"
msgstr "மேல் பட்டியில் பாடல் லேபிளின் மார்க்கீ உருட்டல்"

#: prefs.js:190
msgid "Enable Panel Label Scrolling"
msgstr "பேனல் லேபிள் உருட்டலை இயக்கு"

#: prefs.js:192
msgid ""
"Scroll the track/artist text one full loop then pause before repeating. When"
" off, the text is truncated with an ellipsis."
msgstr ""
"பாடல்/கலைஞர் உரையை ஒரு முழு சுற்று உருட்டி இடைநிறுத்தி மீண்டும் தொடங்கும். "
"அணைந்திருக்கும்போது மூன்று புள்ளிகளுடன் வெட்டப்படும்."

#: prefs.js:205
msgid "Panel Scroll Speed"
msgstr "பேனல் உருட்டல் வேகம்"

#: prefs.js:206 prefs.js:314 prefs.js:354
msgid "1 = slowest, 10 = fastest"
msgstr "1 = மிகவும் மெதுவாக, 10 = மிகவும் வேகமாக"

#: prefs.js:224
msgid "System Integration"
msgstr "கணினி ஒருங்கிணைப்பு"

#: prefs.js:226
msgid "Controls how this extension interacts with other parts of GNOME Shell."
msgstr ""
"இந்த நீட்டிப்பு GNOME Shell இன் மற்ற பகுதிகளுடன் எவ்வாறு தொடர்பு கொள்கிறது "
"என்பதை கட்டுப்படுத்துகிறது."

#: prefs.js:237
msgid "Hide Default GNOME Media Player"
msgstr "இயல்பு GNOME மீடியா பிளேயரை மறை"

#: prefs.js:239
msgid "Remove the built-in media controls from the system date/time menu"
msgstr ""
"கணினி தேதி/நேர மெனுவிலிருந்து உள்ளமைக்கப்பட்ட மீடியா கட்டுப்பாடுகளை அகற்று"

#: prefs.js:260
msgid ""
"When ON, the extension hides the stock GNOME media controls that\n"
"normally appear in the calendar / notification panel (the date-time\n"
"menu). This prevents a duplicate 'now playing' widget.\n"
"\n"
"The built-in controls are fully restored the moment you:\n"
"  • Turn this switch off, or\n"
"  • Disable or uninstall this extension."
msgstr ""
"இயக்கத்தில் இருக்கும் போது, நீட்டிப்பு க்னோம் மீடியாவைக் கட்டுப்படுத்தும் பங்குகளை மறைக்கிறது \n"
"பொதுவாக காலண்டர்/அறிவிப்புப் பலகத்தில் (தேதி-நேரம்) தோன்றும் \n"
"மெனு). இது நகல் 'இப்போது இயங்கும்' விட்செட்டைத் தடுக்கிறது. \n"
"\n"
"உள்ளமைக்கப்பட்ட கட்டுப்பாடுகள் நீங்கள் செய்த தருணத்தில் முழுமையாக மீட்டமைக்கப்படும்: \n"
"• இந்த ச்விட்ச் ஆஃப், அல்லது \n"
"• இந்த நீட்டிப்பை முடக்கவும் அல்லது நிறுவல் நீக்கவும்."

#: prefs.js:286
msgid "Popup Player"
msgstr "பாப்அப் பிளேயர்"

#: prefs.js:292
msgid "Title Scrolling"
msgstr "தலைப்பு உருட்டல்"

#: prefs.js:293
msgid "Marquee behaviour for the track title inside the popup"
msgstr "பாப்அப்பில் பாடல் தலைப்பிற்கான மார்க்கீ நடத்தை"

#: prefs.js:298
msgid "Enable Title Scrolling"
msgstr "தலைப்பு உருட்டலை இயக்கு"

#: prefs.js:300
msgid ""
"Scroll long track titles from start to end, pause, then repeat. When off, "
"the text is truncated with an ellipsis."
msgstr ""
"நீண்ட பாடல் தலைப்புகளை தொடக்கத்திலிருந்து முடிவு வரை உருட்டி இடைநிறுத்தி "
"மீண்டும் தொடங்கும்."

#: prefs.js:313
msgid "Title Scroll Speed"
msgstr "தலைப்பு உருட்டல் வேகம்"

#: prefs.js:332
msgid "Artist Scrolling"
msgstr "கலைஞர் உருட்டல்"

#: prefs.js:333
msgid "Marquee behaviour for the artist name inside the popup"
msgstr "பாப்அப்பில் கலைஞர் பெயருக்கான மார்க்கீ நடத்தை"

#: prefs.js:338
msgid "Enable Artist Scrolling"
msgstr "கலைஞர் உருட்டலை இயக்கு"

#: prefs.js:340
msgid ""
"Scroll long artist names from start to end, pause, then repeat. When off, "
"the text is truncated with an ellipsis."
msgstr "நீண்ட கலைஞர் பெயர்களை உருட்டி இடைநிறுத்தி மீண்டும் தொடங்கும்."

#: prefs.js:353
msgid "Artist Scroll Speed"
msgstr "கலைஞர் உருட்டல் வேகம்"

#: prefs.js:373
msgid "Album Art"
msgstr "ஆல்பம் கலை"

#: prefs.js:374
msgid "Vinyl-record rotation animation"
msgstr "வினைல் வட்டு சுழற்சி அனிமேஷன்"

#: prefs.js:379
msgid "Enable Vinyl Record Rotation (Global Default)"
msgstr "வினைல் வட்டு சுழற்சியை இயக்கு (உலகளாவிய இயல்பு)"

#: prefs.js:381
msgid ""
"Global default when no per-app setting exists. Per-app overrides in the "
"‘Vinyl Apps’ section take priority."
msgstr ""
"ஒவ்வொரு ஆப்ச் அமைப்பும் இல்லாதபோது உலகளாவிய இயல்புநிலை. 'வினைல் ஆப்ச்' "
"பிரிவில் ஒவ்வொரு பயன்பாட்டிற்கும் மேலெழுதுவதற்கு முன்னுரிமை "
"அளிக்கப்படுகிறது."

#: prefs.js:395
msgid "Rotation Speed (seconds per revolution)"
msgstr "சுழற்சி வேகம் (ஒரு சுற்றுக்கு செகண்டுகள்)"

#: prefs.js:396
msgid "5 = fastest, 60 = slowest. Recommended: 20–30"
msgstr "5 = மிக வேகம், 60 = மிக மெது. பரிந்துரை: 20–30"

#: prefs.js:414
msgid "Vinyl Effect Details"
msgstr "வினைல் விளைவு விவரங்கள்"

#: prefs.js:415
msgid "How the animated vinyl record works"
msgstr "அனிமேஷன் வினைல் வட்டு எவ்வாறு செயல்படுகிறது"

#: prefs.js:420
msgid ""
"- Album cover appears on a spinning vinyl disc\n"
"- Black vinyl grooves are visible around the edges\n"
"- Animated tonearm moves in and out with playback state\n"
"- Rotation pauses smoothly when music pauses\n"
"  (disc angle is preserved and resumes from the same position)\n"
"- Disc resets to 0° only on a genuine Stop\n"
"- Double-click album art to toggle vinyl for THAT player’s app only\n"
"- Per-app settings override the global default above\n"
"- All seen apps are stored; re-enable any time from Vinyl Apps page"
msgstr ""
"- சுழலும் வினைல் வட்டில் ஆல்பம் கவர் தோன்றும் \n"
"- விளிம்புகளைச் சுற்றி கருப்பு வினைல் பள்ளங்கள் தெரியும் \n"
"- அனிமேசன் டோனியர்ம் பிளேபேக் நிலையுடன் உள்ளேயும் வெளியேயும் நகர்கிறது \n"
"- இசை இடைநிறுத்தப்படும் போது சுழற்சி சீராக இடைநிறுத்தப்படுகிறது \n"
"(வட்டு கோணம் பாதுகாக்கப்பட்டு அதே நிலையில் இருந்து மீண்டும் தொடர்கிறது) \n"
"- உண்மையான நிறுத்தத்தில் மட்டுமே வட்டு 0°க்கு மீட்டமைக்கப்படும் \n"
"- அந்த பிளேயரின் பயன்பாட்டிற்கு மட்டும் வினைலை மாற்ற ஆல்பம் கலையை இருமுறை சொடுக்கு செய்யவும் \n"
"- ஒவ்வொரு பயன்பாட்டிற்கான அமைப்புகள் மேலே உள்ள உலகளாவிய இயல்புநிலையை மீறுகின்றன \n"
"- பார்த்த அனைத்து பயன்பாடுகளும் சேமிக்கப்படும்; வினைல் ஆப்ச் பக்கத்திலிருந்து எந்த நேரத்திலும் மீண்டும் இயக்கவும்"

#: prefs.js:445
msgid "Vinyl Apps"
msgstr "வினைல் பயன்பாடுகள்"

#: prefs.js:453
msgid "Player Filter"
msgstr "பிளேயர் வடிகட்டி"

#: prefs.js:461
msgid "Lyrics"
msgstr "பாடல் வரிகள்"

#: prefs.js:519 prefs.js:546
msgid "Filter Mode"
msgstr "வடிகட்டு முறை"

#: prefs.js:521
msgid ""
"Choose whether the list below acts as a blacklist (block listed apps) or a "
"whitelist (allow only listed apps). Set to Off to disable filtering "
"entirely."
msgstr ""
"கீழேயுள்ள பட்டியல் தடுப்புப்பட்டியலாக (பட்டியலிடப்பட்ட பயன்பாடுகளைத் தடுக்க)"
" அல்லது அனுமதிப்பட்டியலாக (பட்டியலிடப்பட்ட பயன்பாடுகளை மட்டும் "
"அனுமதிக்கவும்) என்பதைத் தேர்வுசெய்யவும். வடிகட்டலை முழுவதுமாக முடக்க, ஆஃப் "
"என அமைக்கவும்."

#: prefs.js:532
msgid "Off"
msgstr "அணைப்பு"

#: prefs.js:533
msgid "Blacklist"
msgstr "கறுப்புப் பட்டியல்"

#: prefs.js:534
msgid "Whitelist"
msgstr "வெள்ளைப் பட்டியல்"

#: prefs.js:540
msgid "Show all media players — filtering is disabled"
msgstr "அனைத்து மீடியா பிளேயர்களையும் காட்டு — வடிகட்டல் முடக்கப்பட்டுள்ளது"

#: prefs.js:541
msgid "Hide only the players you add to the list below"
msgstr "கீழே உள்ள பட்டியலில் சேர்த்த பிளேயர்களை மட்டும் மறை"

#: prefs.js:542
msgid "Show only the players you add to the list below"
msgstr "கீழே உள்ள பட்டியலில் சேர்த்த பிளேயர்களை மட்டும் காட்டு"

#: prefs.js:569
msgid "Saved Players"
msgstr "சேமித்த பிளேயர்கள்"

#: prefs.js:571
msgid ""
"Each saved player can be individually enabled or disabled in the filter "
"without removing it. The toggle controls whether the filter rule is active "
"for that app. Use the trash button to remove it from the list entirely."
msgstr ""
"ஒவ்வொரு சேமித்த பிளேயரையும் அகற்றாமல் தனித்தனியாக இயக்கலாம் அல்லது "
"வடிகட்டியில் முடக்கலாம். அந்த பயன்பாட்டிற்கான வடிகட்டி விதி செயலில் உள்ளதா "
"என்பதை நிலைமாற்றம் கட்டுப்படுத்துகிறது. பட்டியலிலிருந்து முழுவதுமாக அகற்ற "
"குப்பை பொத்தானைப் பயன்படுத்தவும்."

#: prefs.js:597
msgid "No players saved yet"
msgstr "இன்னும் பிளேயர்கள் சேமிக்கப்படவில்லை"

#: prefs.js:599
msgid ""
"Detect running players below and click “Add to Filter” to add them here."
msgstr ""
"கீழே இயங்கும் பிளேயர்களைக் கண்டறிந்து, அவற்றை இங்கே சேர்க்க \"வடிப்பானில் "
"சேர்\" என்பதைக் சொடுக்கு செய்யவும்."

#: prefs.js:653
#, javascript-format
msgid "Filter rule active for “%s” — click to disable"
msgstr ""
"“%s” க்கான வடிகட்டு விதி செயல்படுகிறது — இயக்கங்களை நிர்த்திக்க கிளிக் செய்"

#: prefs.js:654
#, javascript-format
msgid "Filter rule disabled for “%s” — click to enable"
msgstr "“%s” க்கான வடிகட்டு விதி இயக்கப்படவில்லை — இயக்க கிளிக் செய்"

#: prefs.js:676
#, javascript-format
msgid "Remove “%s” from the filter list"
msgstr "வடிகட்டு பட்டியலிலிருந்து “%s” அகற்று"

#: prefs.js:709
msgid "Detected Players"
msgstr "கண்டறிந்த பிளேயர்கள்"

#: prefs.js:711
msgid ""
"Active MPRIS players found on the session D-Bus. Click “Add to Filter” to "
"save a player to the list above."
msgstr ""
"செயலில் உள்ள MPRIS பிளேயர்கள் அமர்வு D-பச்சில் கண்டறியப்பட்டது. மேலே உள்ள "
"பட்டியலில் பிளேயரைச் சேமிக்க, \"வடிப்பானில் சேர்\" என்பதைக் சொடுக்கு "
"செய்யவும்."

#: prefs.js:718
msgid "Scan for running players"
msgstr "இயங்கும் பிளேயர்களைத் தேடு"

#: prefs.js:719
msgid "Detects players currently broadcasting on MPRIS"
