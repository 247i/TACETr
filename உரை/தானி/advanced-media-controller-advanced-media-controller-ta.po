msgstr "ஒரு இசை பயன்பாட்டை திறந்து புதுப்பி என்பதைக் கிளிக் செய்யவும்"

#: prefs.js:842 prefs.js:861 prefs.js:871
msgid "Saved ✓"
msgstr "சேமிக்கப்பட்டது ✓"

#: prefs.js:843 prefs.js:871
