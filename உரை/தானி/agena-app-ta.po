#, java-printf-format
msgctxt "app_name"
msgid "AGENA"
msgstr "முகவர்"

#, java-printf-format
msgctxt "app_description"
msgid "Gemini browser"
msgstr "செமினி உலாவி"

#.  Strings used for fragments for navigation
#, java-printf-format
msgctxt "start_navigating"
msgid "Start Navigating"
msgstr "வழிசெலுத்தலைத் தொடங்குங்கள்"

#, java-printf-format
msgctxt "warning_icon"
msgid ""
"Just a warning icon to make it explicit that something unexpected happened"
msgstr "எதிர்பாராத ஒன்று நடந்தது என்பதை தெளிவுபடுத்த ஒரு முன்னறிவிப்பு படவுரு"

#, java-printf-format
msgctxt "more_information"
msgid "More information"
msgstr "மேலும் செய்தி"

#, java-printf-format
msgctxt "copy_stacktrace"
msgid "Copy"
msgstr "நகலெடு"

#, java-printf-format
msgctxt "stacktrace_copied"
msgid "Stack trace copied to clipboard"
msgstr "ச்டாக் ட்ரேச் இடைநிலைப்பலகைக்கு நகலெடுக்கப்பட்டது"

#.  Errors
#, java-printf-format
msgctxt "error_generic"
msgid "Generic unspecified/unhandled error"
msgstr "பொதுவான குறிப்பிடப்படாத / கையாளப்படாத பிழை"

#, java-printf-format
msgctxt "error_unable_to_resolve_host"
msgid "Unable to resolve host. It wasn't found by DNS."
msgstr "ஓச்டைத் தீர்க்க முடியவில்லை. இது DNS ஆல் கண்டுபிடிக்கப்படவில்லை."

#, java-printf-format
msgctxt "error_connection_timeout"
msgid ""
"Timeout while connecting to the server. Is really there a Gemini server?"
msgstr ""
"சேவையகத்துடன் இணைக்கும் போது நேரம் முடிந்தது. உண்மையில் செமினி சர்வர் "
"உள்ளதா?"

#, java-printf-format
msgctxt "error_gemini_not_found"
msgid "Content not found"
msgstr "உள்ளடக்கம் கிடைக்கவில்லை"

#, java-printf-format
msgctxt "error_gemini_invalid_response"
msgid "Server returned an invalid response"
msgstr "சேவையகம் தவறான பதிலை வழங்கியது"

#, java-printf-format
msgctxt "error_gemini_unimplemented"
msgid "Gemini protocol detail not implemented (yet)"
msgstr "செமினி புரோட்டோகால் விவரம் செயல்படுத்தப்படவில்லை (இன்னும்)"

#, java-printf-format
msgctxt "error_dont_know_how_to_handle_content_type"
msgid "I don't know how to handle this content"
msgstr "இந்த உள்ளடக்கத்தை எவ்வாறு கையாள்வது என்று எனக்குத் தெரியவில்லை"

#, java-printf-format
msgctxt "error_gone"
msgid "Gone"
msgstr "போய்விட்டது"

#.  Temporary failures (40-49)
#, java-printf-format
msgctxt "error_temporary_failure"
msgid "Temporary server failure. Try again later."
msgstr "தற்காலிக சர்வர் தோல்வி. பிறகு முயற்சிக்கவும்."

#, java-printf-format
msgctxt "error_server_unavailable"
msgid "Server unavailable. Try again later."
msgstr "சேவையகம் கிடைக்கவில்லை. பிறகு முயற்சிக்கவும்."

#, java-printf-format
msgctxt "error_proxy_error"
msgid "Proxy error"
msgstr "பதிலாள் பிழை"

#, java-printf-format
msgctxt "error_slow_down"
msgid "Rate limited. Please slow down."
msgstr "வரையறுக்கப்பட்ட விகிதம். தயவுசெய்து வேகத்தை குறைக்கவும்."

#.  Permanent failures (50-59)
#, java-printf-format
msgctxt "error_permanent_failure"
msgid "Permanent failure"
msgstr "நிரந்தர தோல்வி"

#, java-printf-format
msgctxt "error_proxy_request_refused"
msgid "Proxy request refused"
msgstr "பதிலாள் கோரிக்கை நிராகரிக்கப்பட்டது"

#, java-printf-format
msgctxt "error_bad_request"
msgid "Bad request"
msgstr "தவறான கோரிக்கை"

#.  Client certificate errors (60-69)
#, java-printf-format
msgctxt "error_client_certificate_required"
msgid "Client certificate required"
msgstr "வாடிக்கையாளர் சான்றிதழ் தேவை"

#, java-printf-format
msgctxt "error_certificate_not_authorized"
msgid "Certificate not authorized"
msgstr "சான்றிதழ் அங்கீகரிக்கப்படவில்லை"

#, java-printf-format
msgctxt "error_certificate_not_valid"
msgid "Certificate not valid"
msgstr "சான்றிதழ் செல்லாது"

#.  Redirects
#, java-printf-format
msgctxt "error_too_many_redirects"
msgid "Too many redirects (maximum 5)"
msgstr "பல வழிமாற்றுகள் (அதிகபட்சம் 5)"

#.  URI validation
#, java-printf-format
msgctxt "error_invalid_uri"
msgid "Invalid URI"
msgstr "தவறான யூரி"

#.  Input prompts
#, java-printf-format
msgctxt "input_prompt_title"
msgid "Input Required"
msgstr "உள்ளீடு தேவை"

#, java-printf-format
msgctxt "input_prompt_ok"
msgid "OK"
msgstr "சரி"

#, java-printf-format
msgctxt "input_prompt_cancel"
msgid "Cancel"
msgstr "ரத்துசெய்"

#, java-printf-format
msgctxt "explain_permission_storage"
msgid ""
"I need storage permission to store downloaded files from sites, like images."
msgstr ""
"படங்கள் போன்ற தளங்களிலிருந்து பதிவிறக்கம் செய்யப்பட்ட கோப்புகளைச் சேமிக்க "
"எனக்கு சேமிப்பக இசைவு தேவை."

#, java-printf-format
msgctxt "please_repeat_action"
msgid "Permission state has changed. Please retry the operation."
msgstr "இசைவு நிலை மாறிவிட்டது. அறுவை சிகிச்சையை மீண்டும் முயற்சிக்கவும்."

#, java-printf-format
msgctxt "historic"
msgid "Historic"
msgstr "வரலாற்று சிறப்புமிக்கது"

#, java-printf-format
msgctxt "url"
msgid "URL"
msgstr "முகவரி"

#.  File handling
#, java-printf-format
msgctxt "file_too_large"
msgid "File too large"
msgstr "கோப்பு மிகவும் பெரியது"

#, java-printf-format
msgctxt "file_too_large_message"
msgid "File cannot be larger than 10MB"
msgstr "கோப்பு 10MB ஐ விட அதிகமாக இருக்கக்கூடாது"

#, java-printf-format
msgctxt "error_reading_file"
msgid "Error reading file"
msgstr "கோப்பைப் படிப்பதில் பிழை"

#, java-printf-format
msgctxt "error_reading_file_message_size"
msgid "Could not determine file size."
msgstr "கோப்பு அளவை தீர்மானிக்க முடியவில்லை."

#.  Scheme errors
#, java-printf-format
msgctxt "error_unsupported_scheme"
msgid "Unsupported scheme: %1$s"
msgstr "ஆதரிக்கப்படாத திட்டம்: %1$s"

#.  Database errors
#, java-printf-format
msgctxt "error_database_write"
msgid "Failed to write to history"
msgstr "வரலாற்றில் எழுத முடியவில்லை"
