#, auto-safe-html, java-printf-format
msgctxt "about_license_info_html"
msgid "Licensed for up to <i>%1$d users</i> who work for <i>%2$s</i>."
msgstr ""
"<i>%2$s</i> இல் பணிபுரியும் <i>%1$d பயனர்கள்</i> வரை உரிமம் பெற்றுள்ளனர்."

#, java-printf-format
msgctxt "about_license_domains"
msgid "Intended for domain: %s"
msgid_plural "Intended for domains: %s"
msgstr[0] "டொமைனுக்கான நோக்கம்: %s"
msgstr[1] "டொமைன்களுக்கான நோக்கம்: %s"

#, java-printf-format
msgctxt "about_license_invalid_license"
msgid "No valid license could be found. Please contact your IT department."
msgstr ""
"சரியான உரிமம் எதுவும் கிடைக்கவில்லை. உங்கள் செய்தி தொழில்நுட்பத் துறையைத் "
"தொடர்பு கொள்ளவும்."

#, java-printf-format
msgctxt "about_license_valid_through"
msgid "License valid through: %s"
msgstr "உரிமம் செல்லுபடியாகும்: %s"

#, auto-safe-html, java-printf-format
msgctxt "login_managed_config_info_html"
msgid "You're using an automatic configuration provided by <i>%s</i>."
msgstr "நீங்கள் <i>%s</i> வழங்கிய தானியங்கி உள்ளமைவைப் பயன்படுத்துகிறீர்கள்."

#, java-printf-format
msgctxt "login_managed_config_waiting"
msgid "Waiting for managed configuration …"
msgstr "நிர்வகிக்கப்பட்ட உள்ளமைவுக்காகக் காத்திருக்கிறது…"

#, java-printf-format
msgctxt "login_managed_config_it_department"
msgid "Don't know what to do? Contact your IT department."
msgstr ""
"என்ன செய்வது என்று தெரியவில்லையா? உங்கள் செய்தி தொழில்நுட்பத் துறையைத் "
"தொடர்பு கொள்ளவும்."

#, auto-safe-html, java-printf-format
msgctxt "login_managed_config_not_private"
msgid ""
"This app is <a href=\"%1$s\">intended for organizations</a> and not for "
"private users. You can <a href=\"%2$s\">obtain a free test license</a>."
msgstr ""
"இந்த ஆப்ச் <a href=\"%1$s\">நிறுவனங்களுக்கானது</a> மற்றும் தனிப்பட்ட "
"பயனர்களுக்காக அல்ல. நீங்கள் <a href=\"%2$s\">இலவச சோதனை உரிமத்தைப் "
"பெறலாம்</a>."

#, java-printf-format
msgctxt "login_managed_config_please_log_in"
msgid "Please log in"
msgstr "உள்நுழையவும்"

#, java-printf-format
msgctxt "login_managed_config_select_certificate_info"
msgid "Choose a client certificate which will be used for authentication."
msgstr ""
"அங்கீகரிப்புக்கு பயன்படுத்தப்படும் கிளையன்ட் சான்றிதழைத் தேர்வு செய்யவும்."

#, java-printf-format
msgctxt "login_managed_config_certificate_selected"
msgid "The client certificate %s will be used for authentication."
msgstr "கிளையன்ட் சான்றிதழ் %s அங்கீகாரத்திற்காக பயன்படுத்தப்படும்."

#, java-printf-format
msgctxt "login_managed_config_invalid_base_url"
msgid "Invalid base URL in managed configuration"
msgstr "நிர்வகிக்கப்பட்ட உள்ளமைவில் தவறான அடிப்படை முகவரி"

#, java-printf-format
msgctxt "managed_config_title"
msgid "Managed configuration"
msgstr "நிர்வகிக்கப்பட்ட கட்டமைப்பு"

#, java-printf-format
msgctxt "managed_config_reload_configuration"
msgid "Reload"
msgstr "ஏற்றவும்"

#, java-printf-format
msgctxt "managed_config_reloading_configuration"
msgid "Reloading configuration"
msgstr "உள்ளமைவை மீண்டும் ஏற்றுகிறது"

#, java-printf-format
msgctxt "managed_config_emm"
msgid "Android Enterprise"
msgstr "ஆண்ட்ராய்டு எண்டர்பிரைச்"

#, java-printf-format
msgctxt "managed_config_emm_info"
msgid "This app is managed by Android Enterprise."
msgstr "இந்த ஆப்சை ஆண்ட்ராய்டு நிறுவனம் நிர்வகிக்கிறது."

#, java-printf-format
msgctxt "managed_config_emm_console"
msgid "Managed settings can be changed in the EMM console."
msgstr "நிர்வகிக்கப்படும் அமைப்புகளை EMM கன்சோலில் மாற்றலாம்."

#, java-printf-format
msgctxt "managed_config_network"
msgid "Network configuration"
msgstr "பிணைய கட்டமைப்பு"

#, java-printf-format
msgctxt "managed_config_network_no_config"
msgid ""
"This app is managed over the network, but no configuration URL has been set "
"yet."
msgstr ""
"இந்த ஆப்ச் நெட்வொர்க்கில் நிர்வகிக்கப்படுகிறது, ஆனால் இன்னும் உள்ளமைவு "
"முகவரி எதுவும் அமைக்கப்படவில்லை."

#, java-printf-format
msgctxt "managed_config_network_enter_url"
msgid "Enter URL"
msgstr "முகவரி ஐ உள்ளிடவும்"

#, java-printf-format
msgctxt "managed_config_network_scan_qrcode"
msgid "Scan QR code"
msgstr "QR குறியீட்டை வருடு செய்யவும்"

#, java-printf-format
msgctxt "managed_config_network_url"
msgid "This app is managed over the network using this URL:"
msgstr ""
"இந்தப் பயன்பாடு இந்த URLஐப் பயன்படுத்தி நெட்வொர்க்கில் நிர்வகிக்கப்படுகிறது:"

#, java-printf-format
msgctxt "managed_config_network_invalid_url"
msgid "Invalid URL"
msgstr "தவறான முகவரி"

#, java-printf-format
msgctxt "managed_config_network_reset_url"
msgid "Clear URL"
msgstr "முகவரி ஐ அழிக்கவும்"

#, java-printf-format
msgctxt "managed_config_network_empty_configuration"
msgid "Empty configuration"
msgstr "வெற்று கட்டமைப்பு"

#, java-printf-format
msgctxt "managed_config_network_config_url_saved"
msgid "Configuration URL saved"
msgstr "உள்ளமைவு முகவரி சேமிக்கப்பட்டது"

#, java-printf-format
msgctxt "managed_config_network_config_url_cleared"
msgid "Configuration URL cleared"
msgstr "உள்ளமைவு முகவரி அழிக்கப்பட்டது"
