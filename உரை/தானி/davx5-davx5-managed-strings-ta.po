#, java-printf-format
msgctxt "restriction_support_email_address"
msgid "Support email address"
msgstr "உதவி மின்னஞ்சல் முகவரி"

#, java-printf-format
msgctxt "restriction_support_phone_number"
msgid "Support phone number"
msgstr "உதவி தொலைபேசி எண்"

#, java-printf-format
msgctxt "restriction_support_phone_number_description"
msgid "Support phone number (format: +1 234 5678901)"
msgstr "உதவி தொலைபேசி எண் (வடிவம்: +1 234 5678901)"

#, java-printf-format
msgctxt "restriction_login_introduction"
msgid "Login introduction message"
msgstr "உள்நுழைவு அறிமுக செய்தி"

#, java-printf-format
msgctxt "restriction_login_introduction_description"
msgid "Message that will be shown when the user adds an account"
msgstr "பயனர் கணக்கைச் சேர்க்கும்போது காட்டப்படும் செய்தி"

#, java-printf-format
msgctxt "restriction_login_base_url"
msgid "CalDAV/CardDAV base URL"
msgstr "கால்டப்/கட்டவ் அடிப்படை முகவரி"

#, java-printf-format
msgctxt "restriction_login_base_url_description"
msgid "Starting URL for CalDAV/CardDAV service detection"
msgstr "CalDAV/CardDAV பணி கண்டறிதலுக்கான URLஐத் தொடங்குகிறது"

#, java-printf-format
msgctxt "restriction_login_type"
msgid "Login type"
msgstr "உள்நுழைவு வகை"

#, java-printf-format
msgctxt "restriction_login_type_description"
msgid "Login type to be used"
msgstr "பயன்படுத்த வேண்டிய உள்நுழைவு வகை"

#, java-printf-format
msgctxt "restriction_login_user_name"
msgid "User name"
msgstr "பயனர் பெயர்"

#, java-printf-format
msgctxt "restriction_login_user_name_description"
msgid "Pre-filled user name for login"
msgstr "உள்நுழைவுக்கான முன் நிரப்பப்பட்ட பயனர் பெயர்"

#, java-printf-format
msgctxt "restriction_login_password"
msgid "Password"
msgstr "கடவுச்சொல்"

#, java-printf-format
msgctxt "restriction_login_password_description"
msgid "Pre-filled password for login"
msgstr "உள்நுழைவதற்கு முன்பே நிரப்பப்பட்ட கடவுச்சொல்"

#, java-printf-format
msgctxt "restriction_lock_credentials"
msgid "Lock credentials"
msgstr "நற்சான்றிதழ்களைப் பூட்டு"

#, java-printf-format
msgctxt "restriction_lock_credentials_description"
msgid "Whether username/password is locked if set by restriction"
msgstr ""
"கட்டுப்பாட்டின்படி அமைக்கப்பட்டால் பயனர்பெயர்/கடவுச்சொல் பூட்டப்பட்டதா"

#, java-printf-format
msgctxt "restriction_login_certificate_alias"
msgid "Client certificate alias"
msgstr "வாடிக்கையாளர் சான்றிதழ் மாற்றுப்பெயர்"

#, java-printf-format
msgctxt "restriction_login_certificate_alias_description"
msgid "Alias of existing client certificate to be used for login"
msgstr ""
"தற்போதுள்ள கிளையன்ட் சான்றிதழின் மாற்றுப்பெயர் உள்நுழைவதற்குப் "
"பயன்படுத்தப்படும்"

#, java-printf-format
msgctxt "restriction_login_certificate_and_password"
msgid "Use username/password together with client certificate"
msgstr "கிளையன்ட் சான்றிதழுடன் பயனர்பெயர்/கடவுச்சொல்லைப் பயன்படுத்தவும்"

#, java-printf-format
msgctxt "restriction_login_certificate_and_password_description"
msgid ""
"Whether both client certificate and username/password are used for login"
msgstr ""
"உள்நுழைவதற்கு கிளையன்ட் சான்றிதழ் மற்றும் பயனர்பெயர்/கடவுச்சொல் இரண்டும் "
"பயன்படுத்தப்படுகிறதா"

#, java-printf-format
msgctxt "restriction_max_accounts"
msgid "Max. accounts"
msgstr "அதிகபட்சம். கணக்குகள்"

#, java-printf-format
msgctxt "restriction_max_accounts_description"
msgid "Maximum number of DAVx⁵ accounts per user"
msgstr "ஒரு பயனருக்கு அதிகபட்ச DAVx⁵ கணக்குகள்"

#, java-printf-format
msgctxt "restriction_proxy_type"
msgid "Proxy type"
msgstr "பதிலாள் வகை"

#, java-printf-format
msgctxt "restriction_proxy_type_description"
msgid "All HTTP(S) connections are routed accordingly"
msgstr "அனைத்து HTTP(S) இணைப்புகளும் அதற்கேற்ப வழிநடத்தப்படுகின்றன"

#, java-printf-format
msgctxt "restriction_proxy_host"
msgid "Proxy host"
msgstr "பதிலாள் புரவலன்"

#, java-printf-format
msgctxt "restriction_proxy_host_description"
msgid "Proxy host name"
msgstr "பதிலாள் புரவலன் பெயர்"

#, java-printf-format
msgctxt "restriction_proxy_port"
msgid "Proxy port"
msgstr "பதிலாள் துறைமுகம்"

#, java-printf-format
msgctxt "restriction_proxy_port_description"
msgid "Proxy port number"
msgstr "பதிலாள் துறைமுகம் எண்"

#, java-printf-format
msgctxt "restriction_default_sync_interval"
msgid "Default sync interval"
msgstr "இயல்புநிலை ஒத்திசைவு இடைவெளி"

#, java-printf-format
msgctxt "restriction_default_sync_interval_description"
msgid "This sync interval is set when an account is created."
msgstr "கணக்கை உருவாக்கும்போது இந்த ஒத்திசைவு இடைவெளி அமைக்கப்படும்."

#, java-printf-format
msgctxt "restriction_preselect_collections"
msgid "Preselect collections"
msgstr "சேகரிப்புகளைத் தேர்ந்தெடுக்கவும்"

#, java-printf-format
msgctxt "restriction_preselect_collections_description"
msgid "Automatically selects detected collections for synchronization"
msgstr "ஒத்திசைவுக்காக கண்டறியப்பட்ட சேகரிப்புகளைத் தானாகத் தேர்ந்தெடுக்கிறது"

#, java-printf-format
msgctxt "restriction_preselect_collections_blacklist"
msgid "Preselect collections blacklist"
msgstr "சேகரிப்புகளின் தடுப்புப்பட்டியலை முன்கூட்டியே தேர்ந்தெடுக்கவும்"

#, java-printf-format
msgctxt "restriction_preselect_collections_blacklist_description"
msgid "Regexp to exclude collections from preselection"
msgstr "முன் தேர்வில் இருந்து சேகரிப்பை விலக்க வழக்கவெளி"

#, java-printf-format
msgctxt "restriction_force_address_books_read_only"
msgid "Force address books read-only"
msgstr "கட்டாய முகவரி புத்தகங்கள் படிக்க மட்டும்"

#, java-printf-format
msgctxt "restriction_force_address_books_read_only_description"
msgid "Makes all address books locally non-editable"
msgstr ""
"அனைத்து முகவரி புத்தகங்களையும் உள்ளூரில் திருத்த முடியாததாக ஆக்குகிறது"

#, java-printf-format
msgctxt "restriction_wifi_only"
msgid "Sync over WiFi only"
msgstr "வைஃபை மூலம் மட்டும் ஒத்திசைக்கவும்"

#, java-printf-format
msgctxt "restriction_wifi_only_description"
msgid "Whether synchronization is only run when WiFi is connected"
msgstr "வைஃபை இணைக்கப்பட்டிருக்கும் போது மட்டுமே ஒத்திசைவு இயக்கப்படுமா"

#, java-printf-format
msgctxt "restriction_wifi_only_ssids"
msgid "Sync over WiFi only: SSIDs"
msgstr "வைஃபை மூலம் மட்டும் ஒத்திசைக்கவும்: SSIDகள்"

#, java-printf-format
msgctxt "restriction_wifi_only_ssids_description"
msgid "Comma-separated list of allowed WiFi SSIDs (wifi1,wifi2)"
msgstr ""
"அனுமதிக்கப்பட்ட WiFi SSIDயின் கமாவால் பிரிக்கப்பட்ட பட்டியல் (wifi1,wifi 2)"

#, java-printf-format
msgctxt "restriction_contact_group_method"
msgid "Contact group method"
msgstr "தொடர்பு குழு முறை"

#, java-printf-format
msgctxt "restriction_contact_group_method_description"
msgid "How contact groups are stored on the CardDAV server"
msgstr "CardDAV சேவையகத்தில் தொடர்பு குழுக்கள் எவ்வாறு சேமிக்கப்படுகின்றன"

#, java-printf-format
msgctxt "restriction_manage_calendar_colors"
msgid "Manage calendar colors"
msgstr "காலெண்டர் வண்ணங்களை நிர்வகிக்கவும்"

#, java-printf-format
msgctxt "restriction_manage_calendar_colors_description"
msgid "Whether DAVx⁵ shall set the calendar colors sent by the server locally"
msgstr "DAVx⁵ சேவையகம் அனுப்பிய காலண்டர் வண்ணங்களை உள்ளூரில் அமைக்குமா"

#, java-printf-format
msgctxt "restriction_event_colors"
msgid "Event colors"
msgstr "நிகழ்வு வண்ணங்கள்"

#, java-printf-format
msgctxt "restriction_event_colors_description"
msgid ""
"Whether to enable per-event color support (may crash bugged calendar apps)"
msgstr ""
"ஒவ்வொரு நிகழ்வுக்கும் வண்ண ஆதரவை இயக்க வேண்டுமா (பிழைக்கப்பட்ட காலண்டர் "
"பயன்பாடுகள் செயலிழக்கக்கூடும்)"

#, java-printf-format
msgctxt "restriction_default_alarm"
msgid "Default reminder"
msgstr "இயல்புநிலை நினைவூட்டல்"

#, java-printf-format
msgctxt "restriction_default_alarm_description"
msgid ""
"Sets a default reminder this number of minutes before the start of every "
"event without reminder. null or -1 means no default reminder. Users can "
"always override this value."
msgstr ""
"நினைவூட்டல் இல்லாமல் ஒவ்வொரு நிகழ்வின் தொடக்கத்திற்கும் இந்த நிமிடங்களுக்கு "
"முன்னரே இயல்புநிலை நினைவூட்டலை அமைக்கிறது. null அல்லது -1 என்றால் இயல்புநிலை"
" நினைவூட்டல் இல்லை. பயனர்கள் எப்போதும் இந்த மதிப்பை மீறலாம்."

#, java-printf-format
msgctxt "restriction_show_only_personal"
msgid "Show only personal collections"
msgstr "தனிப்பட்ட சேகரிப்புகளை மட்டும் காட்டு"

#, java-printf-format
msgctxt "restriction_show_only_personal_description"
msgid ""
"Whether only collections from the own homeset(s) are shown. -1 or null means"
" users can choose themselves."
msgstr ""
"சொந்த ஓம்செட்(களின்) சேகரிப்புகள் மட்டும் காட்டப்படுமா. -1 அல்லது சுழியம் "
"என்றால் பயனர்கள் தங்களைத் தேர்ந்தெடுக்கலாம்."

