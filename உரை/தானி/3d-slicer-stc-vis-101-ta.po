#: text_dict_default.json:200
msgctxt "TutorialMaker"
msgid "Neuroimage Analysis Center (NIBIB P41 EB015902)"
msgstr "நியூரோஇமேச் பகுப்பாய்வு நடுவண் (NIBIB P41 EB015902)"
