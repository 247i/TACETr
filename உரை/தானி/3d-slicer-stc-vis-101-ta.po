#: text_dict_default.json:52 text_dict_default.json:56
#: text_dict_default.json:62 text_dict_default.json:66
#: text_dict_default.json:70 text_dict_default.json:74
#: text_dict_default.json:78 text_dict_default.json:82
#: text_dict_default.json:86
msgctxt "TutorialMaker"
msgid "Visualizing DICOM images"
msgstr "DICOM படங்களை காட்சிப்படுத்துதல்"

#. 10_TextBox_0
#: text_dict_default.json:54
msgctxt "TutorialMaker"
msgid ""
"Slicer displays the axial, coronal \n"
"and sagittal images of the CT \n"
"Thorax Abdomen dataset "
msgstr ""
"ச்லைசர் அச்சு, கரோனலைக் காட்டுகிறது \n"
"மற்றும் CT இன் சாகிட்டல் படங்கள் \n"
"மார்பு வயிறு தரவுத்தொகுப்பு"

#. 11_ArrowText_1
#: text_dict_default.json:58
msgctxt "TutorialMaker"
msgid ""
"Left click on DICOM to display \n"
"the list of modules of Slicer"
msgstr ""
"காட்ட DICOM மீது இடது சொடுக்கு செய்யவும் \n"
"ச்லைசரின் தொகுதிகளின் பட்டியல்"

#. 11_ArrowText_2
#: text_dict_default.json:60
msgctxt "TutorialMaker"
msgid ""
"Select the module \n"
"Volumes"
msgstr ""
"தொகுதியைத் தேர்ந்தெடுக்கவும் \n"
"தொகுதிகள்"

#. 12_ArrowText_0
#: text_dict_default.json:64
msgctxt "TutorialMaker"
msgid ""
"Click on the CT-abdomen \n"
"preset to automatically adjust \n"
"the window/level display of the \n"
"CT dataset"
msgstr ""
"CT-வயிற்றில் சொடுக்கு செய்யவும் \n"
"தானாக சரிசெய்ய முன்னமைக்கப்பட்ட \n"
"சாளரம்/நிலை காட்சி \n"
"CT தரவுத்தொகுப்பு"

#. 13_TextBox_1
#: text_dict_default.json:68
msgctxt "TutorialMaker"
msgid ""
"Position the mouse cursor \n"
"over the red banner in the \n"
"Red Viewer to display the slice \n"
"menu.\n"
"\n"
"\n"
"Click on the Links icon to link \n"
"the slice controls across all \n"
"Slice Viewers. \n"
"\n"
"\n"
"Click on the Eye icon to\n"
"display the three anatomical \n"
"slices in the 3D Viewer"
msgstr ""
"மவுச் கர்சரை வைக்கவும் \n"
"சிவப்பு பேனருக்கு மேல் \n"
"ச்லைசைக் காட்ட சிவப்பு பார்வையாளர் \n"
"பட்டியல். \n"
"\n"
"\n"
"இணைக்க இணைப்புகள் ஐகானைக் சொடுக்கு செய்யவும் \n"
"ச்லைச் அனைத்தையும் கட்டுப்படுத்துகிறது \n"
"ச்லைச் பார்வையாளர்கள். \n"
"\n"
"\n"
"கண் ஐகானைக் சொடுக்கு செய்யவும் \n"
"மூன்று உடற்கூறியல் காட்சி \n"
"3D வியூவரில் உள்ள துண்டுகள்"

#. 14_TextBox_0
#: text_dict_default.json:72
msgctxt "TutorialMaker"
msgid ""
"The three anatomical slices \n"
"appear in the 3D viewer."
msgstr ""
"மூன்று உடற்கூறியல் துண்டுகள் \n"
"3D வியூவரில் தோன்றும்."

#. 15_ArrowText_0
#: text_dict_default.json:76
msgctxt "TutorialMaker"
msgid ""
"Click on the Slicer layout menu \n"
"icon, and select the \n"
"Conventional Widescreen layout"
msgstr ""
"ச்லைசர் லேஅவுட் மெனுவை சொடுக்கு செய்யவும் \n"
"படவுரு, மற்றும் தேர்ந்தெடுக்கவும் \n"
"வழக்கமான அகலத்திரை அமைப்பு"

#. 16_TextBox_0
#: text_dict_default.json:80
msgctxt "TutorialMaker"
msgid ""
"Slicer switches the layout \n"
"to Conventional \n"
"Widescreen layout"
msgstr ""
"ச்லைசர் தளவமைப்பை மாற்றுகிறது \n"
"மரபுக்கு \n"
"அகலத்திரை அமைப்பு"

#. 17_TextBox_0
#: text_dict_default.json:84
msgctxt "TutorialMaker"
msgid ""
"Use the right mouse button in the \n"
"3D Viewer to zoom in and out"
msgstr ""
"வலது சுட்டி பொத்தானைப் பயன்படுத்தவும் \n"
"பெரிதாக்க மற்றும் வெளியேற 3D பார்வையாளர்"

#. 18_TextBox_0
#: text_dict_default.json:88
msgctxt "TutorialMaker"
msgid ""
"Use the left mouse button in the \n"
"3D Viewer to rotate the images"
msgstr ""
"இடது சுட்டி பொத்தானைப் பயன்படுத்தவும் \n"
"படங்களை சுழற்ற 3D வியூவர்"

#. 19_3DViewerController_title
#. ----------
#. 20_3DViewerController_title
#: text_dict_default.json:90 text_dict_default.json:94
msgctxt "TutorialMaker"
msgid "3D Viewer Controller"
msgstr "3டி வியூவர் கன்ட்ரோலர்"

#. 19_TextBox_1
#: text_dict_default.json:92
msgctxt "TutorialMaker"
msgid ""
"Position the mouse cursor over \n"
"the pin icon in the blue banner \n"
"of the 3D viewer window to \n"
"display the 3DView controller\n"
"\n"
"Click on the second icon on the \n"
"top row of the 3DView \n"
"controller to center the 3D view \n"
"on the scene"
msgstr ""
"மவுச் கர்சரை மேலே வைக்கவும் \n"
"நீல பேனரில் முள் படவுரு \n"
"3D பார்வையாளர் சாளரத்தின் \n"
"3DView கட்டுப்படுத்தியைக் காட்டவும் \n"
"\n"
"இரண்டாவது ஐகானில் சொடுக்கு செய்யவும் \n"
"3DView இன் மேல் வரிசை \n"
"3D காட்சியை மையப்படுத்த கட்டுப்படுத்தி \n"
"காட்சியில்"

#. 20_ArrowText_1
#: text_dict_default.json:96
msgctxt "TutorialMaker"
msgid ""
"Select the Volume Rendering \n"
"module in the list of modules "
msgstr ""
"வால்யூம் ரெண்டரிங்கைத் தேர்ந்தெடுக்கவும் \n"
"தொகுதிகள் பட்டியலில் தொகுதி"

#. 21_TextBox_0
#: text_dict_default.json:98
msgctxt "TutorialMaker"
msgid "Part 2: Volume Rendering"
msgstr "பகுதி 2: வால்யூம் வழங்குதல்"

