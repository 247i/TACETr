msgctxt "callout.builder.tabs.email.body.default"
msgid ""
"<p>Hello {'*|FNAME|*'},</p><p></p><p>This email confirms your response to <a"
" href=\"{'*|CALLOUTLINK|*'}\">\"{'*|CALLOUTTITLE|*'}\"</a> using your email "
"address {'*|EMAIL|*'}.</p><p></p><p>If you have any questions, please "
"contact our support team at <a "
"href=\"mailto:{'*|SUPPORTEMAIL|*'}\">{'*|SUPPORTEMAIL|*'}</a>.</p><p></p><p>Best"
" wishes</p>"
msgstr ""
"<p>வணக்கம் {'*|FNAME|*'},</p><p></p><p>இந்த மின்னஞ்சல் உங்கள் {'*|EMAIL|*'} "
"என்ற மின்னஞ்சல் முகவரியைப் பயன்படுத்தி <a "
"href=\"{'*|CALLOUTLINK|*'}\">\"{'*|CALLOUTTITLE|*'}\"</a>க்கான உங்கள் பதிலை "
"உறுதிப்படுத்துகிறது.</p><p></p><p>உங்கள் ஆதரவுக் குழுவைத் தொடர்பு கொள்ளவும்."
" "
"href=\"mailto:{'*|SUPPORTEMAIL|*'}\">{'*|SUPPORTEMAIL|*'}</a>.</p><p></p><p>நல்வாழ்த்துக்கள்</p>"

msgctxt "callout.builder.tabs.email.collectInfoWarning.description"
msgid ""
"To send an email to all participants you must enable \"Collect contact "
"information\" in the Settings tab"
msgstr ""
"அனைத்து பங்கேற்பாளர்களுக்கும் மின்னஞ்சலை அனுப்ப, நீங்கள் அமைப்புகள் தாவலில் "
"\"தொடர்புத் தகவலைச் சேகரிக்க\" என்பதை இயக்க வேண்டும்"

