msgctxt "filter_edit_title"
msgid "Edit filter"
msgstr "வடிகட்டியைத் திருத்து"

#, java-printf-format
msgctxt "status_filtered_show_anyway"
msgid "Show anyway"
msgstr "எப்படியும் காட்டு"

#, java-printf-format
msgctxt "status_filter_placeholder_label_format"
msgid "Filtered: <b>%1$s</b>"
msgstr "வடிகட்டப்பட்டது: <b>%1$s </b>"

#, java-printf-format
msgctxt "label_quoted_status_hidden"
msgid "Quote of a post hidden by one of your filters"
msgstr "உங்கள் வடிப்பான்களில் ஒன்றால் மறைக்கப்பட்ட இடுகையின் மேற்கோள்"

#, java-printf-format
msgctxt "detach_quote"
msgid "Remove quote"
msgstr "மேற்கோளை அகற்று"

#, java-printf-format
msgctxt "label_quote_state_unknown"
msgid "Quoted post cannot be displayed"
msgstr "மேற்கோள் காட்டப்பட்ட இடுகையைக் காட்ட முடியாது"

#, java-printf-format
msgctxt "label_quote_state_pending"
msgid "Quote is waiting to be approved"
msgstr "மேற்கோள் ஒப்புதல் பெற காத்திருக்கிறது"

#, java-printf-format
msgctxt "label_quote_state_rejected"
msgid "Quoted account blocked this quote from being displayed"
msgstr "மேற்கோள் காட்டப்பட்ட கணக்கு இந்த மேற்கோளைக் காட்டுவதைத் தடுத்தது"

#, java-printf-format
msgctxt "label_quote_state_revoked"
msgid "Quoted account blocked this quote from being displayed"
msgstr "மேற்கோள் காட்டப்பட்ட கணக்கு இந்த மேற்கோளைக் காட்டுவதைத் தடுத்தது"

#, java-printf-format
msgctxt "label_quote_state_deleted"
msgid "Quoted post has been deleted"
msgstr "மேற்கோள் இடுகை நீக்கப்பட்டது"

#, java-printf-format
msgctxt "label_quote_state_unauthorized"
msgid "Quoted post is not visible to you"
msgstr "மேற்கோள் காட்டப்பட்ட இடுகை உங்களுக்குத் தெரியவில்லை"

#, java-printf-format
msgctxt "label_quote_state_blocked_account"
msgid "Quoted post is from an account you blocked"
msgstr "நீங்கள் தடுத்த கணக்கிலிருந்து மேற்கோள் காட்டப்பட்ட இடுகை"

#, java-printf-format
msgctxt "label_quote_state_blocked_domain"
msgid "Quoted post is from a server you blocked"
msgstr "மேற்கோள் இடுகை நீங்கள் தடுத்த சர்வரில் இருந்து வந்தது"

#, java-printf-format
msgctxt "label_quote_state_muted_account"
msgid "Quoted post is from an account you muted"
msgstr "நீங்கள் முடக்கிய கணக்கிலிருந்து மேற்கோள் காட்டப்பட்ட இடுகை"
