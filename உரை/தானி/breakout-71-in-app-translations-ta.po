msgstr "நாணயங்கள் எப்பொழுதும் செங்கலின் நிறத்தையே உருவாக்குகின்றன"

msgctxt "settings.combo_bubbles"
msgid "Floating Combo Text"
msgstr "மிதக்கும் சேர்க்கை உரை"

msgctxt "settings.combo_bubbles_help"
msgid ""
"Announce the current combo / reset in game, on the location of the loss or "
"gain of combo"
msgstr ""
"கேம்போவின் இழப்பு அல்லது ஆதாயத்தின் இருப்பிடத்தில் தற்போதைய சேர்க்கை / "
"மீட்டமைப்பை கேமில் அறிவிக்கவும்"

msgctxt "settings.contrast"
msgid "High Contrast"
msgstr "உயர் மாறுபாடு"

msgctxt "settings.contrast_help"
msgid "More colorful and dark rendering"
msgstr "மேலும் வண்ணமயமான மற்றும் இருண்ட வழங்குதல்"

msgctxt "settings.donation_reminder"
msgid "Remind me to donate"
msgstr "தானம் செய்ய எனக்கு நினைவூட்டு"

msgctxt "settings.donation_reminder_help"
msgid "See time played and donation link in main menu"
msgstr ""
"முதன்மை பட்டியலில் விளையாடிய நேரம் மற்றும் நன்கொடை இணைப்பைப் பார்க்கவும்"

msgctxt "settings.download_save_file"
msgid "Download score and stats"
msgstr "மதிப்பெண் மற்றும் புள்ளிவிவரங்களைப் பதிவிறக்கவும்"

msgctxt "settings.download_save_file_help"
msgid "Get a save file"
msgstr "சேமிக்கும் கோப்பைப் பெறவும்"

msgctxt "settings.enable_autosave"
msgid "Autosave"
msgstr "தானிசேமி"

msgctxt "settings.enable_autosave_help"
msgid ""
"Save the game state at the beginning of each level, resume it once if the "
"app was restarted during the level."
msgstr ""
"ஒவ்வொரு நிலையின் தொடக்கத்திலும் கேம் நிலையைச் சேமிக்கவும், நிலையின் போது "
"ஆப்ச் மறுதொடக்கம் செய்யப்பட்டிருந்தால் அதை ஒருமுறை மீண்டும் தொடங்கவும்."

msgctxt "settings.extra_bright"
msgid "Extra bright"
msgstr "கூடுதல் ஒளி"

msgctxt "settings.extra_bright_help"
msgid "Increases the size of the halo around coins and bricks."
msgstr ""
"நாணயங்கள் மற்றும் செங்கற்களைச் சுற்றியுள்ள ஒளிவட்டத்தின் அளவை அதிகரிக்கிறது."

msgctxt "settings.fullscreen"
msgid "Fullscreen"
msgstr "முழு திரை"

msgctxt "settings.fullscreen_help"
msgid "Game will try to go full screen before starting"
msgstr "கேம் தொடங்கும் முன் முழுத் திரையில் செல்ல முயற்சிக்கும்"

msgctxt "settings.goofy_text"
msgid "Goofy bold text"
msgstr "முட்டாள்தனமான தடித்த உரை"

msgctxt "settings.goofy_text_help"
msgid "Show combo increase/decrease/reset call-outs with extra bold text"
msgstr ""
"கூடுதல் தடிமனான உரையுடன் காம்போ அதிகரிப்பு/குறைப்பு/மீட்டமைவு அழைப்புகளைக் "
"காட்டு"

msgctxt "settings.language"
msgid "Language"
msgstr "மொழி"

msgctxt "settings.language_help"
msgid "Choose the game's language"
msgstr "விளையாட்டின் மொழியைத் தேர்ந்தெடுக்கவும்"

msgctxt "settings.level_unlocks_hints"
msgid "Levels unlock hints"
msgstr "நிலைகள் குறிப்புகளைத் திறக்கும்"

msgctxt "settings.level_unlocks_hints_help"
msgid "Help you pick the right perks to unlock levels"
msgstr "நிலைகளைத் திறக்க சரியான சலுகைகளைத் தேர்ந்தெடுக்க உதவுங்கள்"

msgctxt "settings.load_save_file"
msgid "Load save file"
msgstr "சேமிக்கும் கோப்பை ஏற்றவும்"

msgctxt "settings.load_save_file_help"
msgid "Select a save file on your device"
msgstr "உங்கள் சாதனத்தில் சேமிக்கும் கோப்பைத் தேர்ந்தெடுக்கவும்"

msgctxt "settings.max_coins"
msgid "{{max}} coins on screen maximum"
msgstr "திரையில் அதிகபட்சம் {{max}} நாணயங்கள்"

msgctxt "settings.max_coins_help"
msgid "Cosmetic only, no effect on score"
msgstr "ஒப்பனை மட்டுமே, மதிப்பெண்ணை பாதிக்காது"

msgctxt "settings.menu_sound"
msgid "Menu sounds"
msgstr "பட்டியல் ஒலிகள்"

msgctxt "settings.menu_sound_help"
msgid "Just a bloop to confirm each menu click"
msgstr "ஒவ்வொரு பட்டியல் கிளிக்கையும் உறுதிப்படுத்த ஒரு ப்ளூப்"

msgctxt "settings.missed_shot_trail"
msgid "Missed shot trails"
msgstr "தவறவிட்ட காட்சி பாதைகள்"

msgctxt "settings.missed_shot_trail_help"
msgid "Show a red trace of the ball's trajectory when it missed."
msgstr "பந்து தவறியபோது அதன் பாதையின் சிவப்பு தடயத்தைக் காட்டு."

msgctxt "settings.mobile"
msgid "Mobile mode"
msgstr "மொபைல் பயன்முறை"

msgctxt "settings.mobile_help"
msgid "Leaves space under the paddle."
msgstr "துடுப்புக்கு அடியில் இடத்தை விட்டு விடுகிறது."

msgctxt "settings.notch_space"
msgid "Notch space"
msgstr "நாட்ச் ச்பேச்"

msgctxt "settings.notch_space_help"
msgid "Move everything 40 pixels down."
msgstr "எல்லாவற்றையும் 40 படப்புள்ளிகள் கீழே நகர்த்தவும்."

msgctxt "settings.particles"
msgid "Particles"
msgstr "துகள்கள்"

msgctxt "settings.particles_help"
msgid "Render particles effects"
msgstr "துகள்கள் விளைவுகளை வழங்கவும்"

msgctxt "settings.pointer_lock"
msgid "Mouse pointer lock"
msgstr "மவுச் பாயிண்டர் பூட்டு"

msgctxt "settings.pointer_lock_help"
msgid "Locks and hides the mouse cursor."
msgstr "மவுச் கர்சரைப் பூட்டி மறைக்கிறது."

msgctxt "settings.precise_lighting"
msgid "Precise lighting"
msgstr "துல்லியமான விளக்குகள்"

msgctxt "settings.precise_lighting_help"
msgid "Use a smaller grid for background light effect"
msgstr "பின்னணி ஒளி விளைவுக்கு சிறிய கட்டத்தைப் பயன்படுத்தவும்"

msgctxt "settings.probabilistic_lighting"
msgid "Persistence of vision"
msgstr "பார்வையின் நிலைத்தன்மை"

msgctxt "settings.probabilistic_lighting_help"
msgid ""
"Improve performance when there are more than 150 coins by reusing some of "
"the light of the previous frame"
msgstr ""
"150 நாணயங்களுக்கு மேல் இருக்கும் போது, ​​முந்தைய சட்டகத்தின் சில ஒளியை "
"மீண்டும் பயன்படுத்துவதன் மூலம் செயல்திறனை மேம்படுத்தவும்"

msgctxt "settings.record"
msgid "Record gameplay videos"
msgstr "விளையாட்டு வீடியோக்களை பதிவு செய்யவும்"

msgctxt "settings.record_download"
msgid "Download video ({{size}} MB)"
msgstr "வீடியோவைப் பதிவிறக்கு ({{size}} MB)"

msgctxt "settings.record_help"
msgid "Get a video of each level."
msgstr "ஒவ்வொரு நிலையின் வீடியோவைப் பெறுங்கள்."

msgctxt "settings.reset"
msgid "Reset Game"
msgstr "விளையாட்டை மீட்டமைக்கவும்"

msgctxt "settings.reset_cancel"
msgid "No"
msgstr "இல்லை"

msgctxt "settings.reset_confirm"
msgid "Yes"
msgstr "ஆம்"

msgctxt "settings.reset_help"
msgid "Erase high score, play time and statistics"
msgstr "அதிக மதிப்பெண், விளையாடும் நேரம் மற்றும் புள்ளிவிவரங்களை அழிக்கவும்"

msgctxt "settings.reset_instruction"
msgid "You will lose all progress you made in the game, are you sure?"
msgstr ""
"விளையாட்டில் நீங்கள் செய்த அனைத்து முன்னேற்றங்களையும் இழப்பீர்கள், நீங்கள் "
"உறுதியாக இருக்கிறீர்களா?"

msgctxt "settings.save_file_error"
msgid "Error loading save file"
msgstr "சேமி கோப்பை ஏற்றுவதில் பிழை"

msgctxt "settings.save_file_loaded"
msgid "Save file loaded"
msgstr "ஏற்றப்பட்ட கோப்பை சேமிக்கவும்"

msgctxt "settings.save_file_loaded_help"
msgid "The app will now reload to apply your save"
msgstr "உங்கள் சேமிப்பைப் பயன்படுத்த, பயன்பாடு இப்போது மீண்டும் ஏற்றப்படும்"

msgctxt "settings.save_file_loaded_ok"
msgid "Ok"
msgstr "சரி"

msgctxt "settings.short_numbers"
msgid "Shorten numbers"
msgstr "எண்களை சுருக்கவும்"

msgctxt "settings.short_numbers_help"
msgid "Show 3k, 2M, 1B instead of full numbers when applicable"
msgstr ""
"பொருந்தும் போது முழு எண்களுக்குப் பதிலாக 3k, 2M, 1B ஆகியவற்றைக் காட்டு"

msgctxt "settings.show_fps"
msgid "FPS counter"
msgstr "FPS கவுண்டர்"

msgctxt "settings.show_fps_help"
msgid "Monitor the app's performance"
msgstr "பயன்பாட்டின் செயல்திறனைக் கண்காணிக்கவும்"

msgctxt "settings.show_puck_rails"
msgid "Paddle vertical bars"
msgstr "துடுப்பு செங்குத்து பார்கள்"

msgctxt "settings.show_puck_rails_help"
msgid ""
"Show what's above the paddle when the corresponding upgrades are active."
msgstr ""
"தொடர்புடைய மேம்படுத்தல்கள் செயலில் இருக்கும்போது துடுப்புக்கு மேலே உள்ளதைக் "
"காட்டு."

msgctxt "settings.show_stats"
msgid "Show real time stats"
msgstr "நிகழ் நேர புள்ளிவிவரங்களைக் காட்டு"

msgctxt "settings.show_stats_help"
msgid "Coins, time,  misses"
msgstr "நாணயங்கள், நேரம், தவறிவிட்டது"

msgctxt "settings.smooth_lighting"
msgid "Smooth lighting"
msgstr "மென்மையான விளக்குகள்"

msgctxt "settings.smooth_lighting_help"
msgid ""
"Blur the background light effects to make them look less square. Increases "
"lag."
msgstr ""
"பின்புல ஒளி விளைவுகளை மங்கலாக்கி, அவை நாற்கை குறைவாக இருக்கும். தாமதத்தை "
"அதிகரிக்கிறது."

msgctxt "settings.sounds"
msgid "Game sounds"
msgstr "விளையாட்டு ஒலிகள்"

msgctxt "settings.sounds_help"
msgid "Beeps, bloops and brrrr"
msgstr "பீப்ச், ப்ளூப்ச் மற்றும் ப்ர்ர்ர்ர்"

msgctxt "settings.stress_test"
msgid "Stress test"
msgstr "மன அழுத்த சோதனை"

msgctxt "settings.stress_test_help"
msgid ""
"Start a bot controlled game with a very high number of coins, to test the "
"performance limits of your device."
msgstr ""
"உங்கள் சாதனத்தின் செயல்திறன் வரம்புகளைச் சோதிக்க, அதிக எண்ணிக்கையிலான "
"நாணயங்களுடன் பாட் கட்டுப்பாட்டில் உள்ள விளையாட்டைத் தொடங்கவும்."

msgctxt "settings.suggestions.applied"
msgid "Performance suggestion applied !"
msgstr "செயல்திறன் பரிந்துரை பயன்படுத்தப்பட்டது!"

msgctxt "settings.suggestions.basic_mode"
msgid "Suggestion : turn basic mode on to improve performance."
msgstr "பரிந்துரை: செயல்திறனை மேம்படுத்த அடிப்படை பயன்முறையை இயக்கவும்."

msgctxt "settings.suggestions.record"
msgid "Suggestion : Disable video recording to improve performance."
msgstr "பரிந்துரை: செயல்திறனை மேம்படுத்த வீடியோ பதிவை முடக்கவும்."

msgctxt "settings.touch_delayed_start"
msgid "Delayed start"
msgstr "தாமதமான தொடக்கம்"

msgctxt "settings.touch_delayed_start_help"
msgid "Start the game after a 3 seconds countdown."
msgstr "3 வினாடிகள் கவுண்டவுனுக்குப் பிறகு விளையாட்டைத் தொடங்கவும்."

msgctxt "unlocks.category.advanced"
msgid ""
"## Advanced upgrades\n"
"\n"
"Those are typically not very useful by themselves, but will can become very powerful when combined with the right combo upgrade."
msgstr ""
"## மேம்பட்ட மேம்படுத்தல்கள் \n"
"\n"
"அவை பொதுவாக மிகவும் பயனுள்ளதாக இல்லை, ஆனால் சரியான சேர்க்கை மேம்படுத்தலுடன் இணைந்தால் அவை மிகவும் சக்திவாய்ந்ததாக மாறும்."

msgctxt "unlocks.category.beginner"
msgid ""
"## Beginner friendly upgrades\n"
"\n"
"Those upgrades are very helpful for beginners, they help you play longer and miss the ball less."
msgstr ""
"## தொடக்கநிலை நட்பு மேம்படுத்தல்கள் \n"
"\n"
"அந்த மேம்படுத்தல்கள் ஆரம்பநிலைக்கு மிகவும் உதவியாக இருக்கும், அவை அதிக நேரம் விளையாடவும், பந்தை குறைவாக மிச் செய்யவும் உதவுகின்றன."

msgctxt "unlocks.category.combo"
msgid ""
"## Combo upgrades\n"
"\n"
"Those upgrades help increase your combo progressively, but also add a combo reset condition. You get one at the beginning of each game. You can take more to increase the risk and reward."
msgstr ""
"## சேர்க்கை மேம்படுத்தல்கள் \n"
"\n"
"அந்த மேம்படுத்தல்கள் உங்கள் காம்போவை படிப்படியாக அதிகரிக்க உதவுகின்றன, ஆனால் காம்போ ரீசெட் நிலையையும் சேர்க்கின்றன. ஒவ்வொரு ஆட்டத்தின் தொடக்கத்திலும் ஒன்றைப் பெறுவீர்கள். ஆபத்தையும் வெகுமதியையும் அதிகரிக்க நீங்கள் அதிகமாக எடுத்துக் கொள்ளலாம்."

msgctxt "unlocks.category.combo_boost"
msgid ""
"## Combo booster upgrades\n"
"\n"
"Those upgrades increase the combo or combo multiplier without adding a reset condition."
msgstr ""
"## காம்போ பூச்டர் மேம்படுத்தல்கள் \n"
"\n"
"அந்த மேம்படுத்தல்கள் மீட்டமைப்பு நிலையைச் சேர்க்காமல் சேர்க்கை அல்லது சேர்க்கை பெருக்கியை அதிகரிக்கின்றன."

msgctxt "unlocks.category.pierce"
msgid ""
"## Pierce upgrades\n"
"\n"
"Those upgrades help you break more bricks before the ball bounces back. The pierce capacity refills when hitting the paddle, but some upgrades can refill it on other conditions."
msgstr ""
"## பியர்ச் மேம்படுத்தல்கள் \n"
"\n"
"அந்த மேம்படுத்தல்கள் பந்து மீண்டும் குதிக்கும் முன் அதிக செங்கற்களை உடைக்க உதவும். துடுப்பைத் தாக்கும் போது துளையிடும் திறன் மீண்டும் நிரப்பப்படுகிறது, ஆனால் சில மேம்படுத்தல்கள் மற்ற நிபந்தனைகளில் அதை மீண்டும் நிரப்பலாம்."

msgctxt "unlocks.category.simple"
msgid ""
"## Helper upgrades\n"
"\n"
"Those upgrades are useful in almost any build."
msgstr ""
"## உதவி மேம்படுத்தல்கள் \n"
"\n"
"அந்த மேம்படுத்தல்கள் கிட்டத்தட்ட எந்த கட்டமைப்பிலும் பயனுள்ளதாக இருக்கும்."

msgctxt "unlocks.extra_perks_for_preview"
msgid "Extra upgrades applied for illustrative purpose."
msgstr "விளக்க நோக்கத்திற்காக கூடுதல் மேம்படுத்தல்கள் பயன்படுத்தப்பட்டன."

msgctxt "unlocks.greyed_out_help"
msgid ""
"The grayed out upgrades can be unlocked by increasing your total score. The "
"total score increases every time you score in game."
msgstr ""
"உங்கள் மொத்த மதிப்பெண்ணை அதிகரிப்பதன் மூலம் சாம்பல் நிற மேம்படுத்தல்களைத் "
"திறக்கலாம். விளையாட்டில் ஒவ்வொரு முறையும் நீங்கள் அடித்த மொத்த மதிப்பெண் "
"அதிகரிக்கிறது."

msgctxt "unlocks.include_in_level_pool"
msgid "Include level"
msgstr "நிலை அடங்கும்"

msgctxt "unlocks.include_in_level_pool_help"
msgid "Draw this level sometimes during gameplay"
msgstr "விளையாட்டின் போது சில நேரங்களில் இந்த அளவை வரையவும்"

msgctxt "unlocks.include_in_level_pool_locked"
msgid "You need to keep at least 15 levels."
msgstr "நீங்கள் குறைந்தது 15 நிலைகளை வைத்திருக்க வேண்டும்."

msgctxt "unlocks.include_in_unlock_hints_help"
msgid "Help me to unlock the level"
msgstr "நிலை திறக்க எனக்கு உதவுங்கள்"

msgctxt "unlocks.include_in_unlock_not_during_gameplay"
msgid "You cannot change this setting after a game has started."
msgstr "விளையாட்டு தொடங்கிய பிறகு இந்த அமைப்பை மாற்ற முடியாது."

msgctxt "unlocks.intro"
msgid ""
"Your total score is {{ts}}. Click an upgrade below to start a game with it."
msgstr ""
"உங்கள் மொத்த மதிப்பெண் {{ts}}. அதனுடன் விளையாட்டைத் தொடங்க கீழே உள்ள "
"மேம்படுத்தலைக் சொடுக்கு செய்யவும்."

msgctxt "unlocks.just_unlocked"
msgid "Level unlocked"
msgstr "நிலை திறக்கப்பட்டது"

msgctxt "unlocks.just_unlocked_plural"
msgid "You just unlocked {{count}} levels"
msgstr "நீங்கள் இப்போது {{count}} நிலைகளைத் திறந்துவிட்டீர்கள்"

msgctxt "unlocks.level"
msgid ""
"Here are all the game levels. Click on a level to learn more about it. You "
"unlocked {{unlocked}} levels out of {{out_of}}. Send us your best levels in "
"discord for inclusion in the list."
msgstr ""
"இங்கே அனைத்து விளையாட்டு நிலைகளும் உள்ளன. அதைப் பற்றி மேலும் அறிய, ஒரு "
"நிலையின் மீது சொடுக்கு செய்யவும். {{out_of}} இல் {{unlocked}} நிலைகளைத் "
"திறந்துவிட்டீர்கள். பட்டியலில் சேர்ப்பதற்கு முரண்பாட்டில் உள்ள உங்கள் சிறந்த"
" நிலைகளை எங்களுக்கு அனுப்பவும்."

msgctxt "unlocks.level_description"
msgid ""
"A {{size}}x{{size}} level with {{bricks}} bricks, {{colors}} colors and "
"{{bombs}} bombs."
msgstr ""
"{{colors}} செங்கற்கள், {{bombs}} வண்ணங்கள் மற்றும் {{bricks}} குண்டுகள் "
"கொண்ட {{size}}x{{size}} நிலை."

msgctxt "unlocks.level_locked"
msgid "Still locked"
msgstr "இன்னும் பூட்டப்பட்டுள்ளது"

msgctxt "unlocks.level_unlocked"
msgid "Already unlocked"
msgstr "ஏற்கனவே திறக்கப்பட்டது"

msgctxt "unlocks.levels"
msgid "Levels"
msgstr "நிலைகள்"

msgctxt "unlocks.levels_categories.abstract"
msgid "Abstract"
msgstr "சுருக்கம்"

msgctxt "unlocks.levels_categories.animals"
msgid "Animals"
msgstr "விலங்குகள்"

msgctxt "unlocks.levels_categories.flags"
msgid "Flags"
msgstr "கொடிகள்"

msgctxt "unlocks.levels_categories.games"
msgid "Video games"
msgstr "வீடியோ கேம்கள்"

msgctxt "unlocks.levels_categories.landscapes"
msgid "Landcapes"
msgstr "இயற்கைக்காட்சிகள்"

msgctxt "unlocks.levels_categories.portraits"
msgid "Portraits"
msgstr "உருவப்படங்கள்"

msgctxt "unlocks.levels_categories.stills"
msgid "Still life"
msgstr "இன்னும் வாழ்க்கை"

msgctxt "unlocks.levels_categories.symbols"
msgid "Symbols"
msgstr "குறியிடுகள்"

msgctxt "unlocks.levels_categories_rules.abstract"
msgid ""
"A level that does not represent a real world object or a recognizable "
"symbol. Typically used for repeating geometric patterns and game play "
"focused levels."
msgstr ""
"உண்மையான உலகப் பொருளையோ அல்லது அடையாளம் காணக்கூடிய சின்னத்தையோ "
"பிரதிநிதித்துவப்படுத்தாத நிலை. பொதுவாக சியோமெட்ரிக் பேட்டர்ன்கள் மற்றும் "
"கேம் பிளே ஃபோகச்டு லெவல்களை மீண்டும் செய்யப் பயன்படுகிறது."

msgctxt "unlocks.levels_categories_rules.animals"
msgid ""
"Drawings where the subject is a real world animal. Fictional animals, human "
"beings and sentient beings go to \"portraits\""
msgstr ""
"பொருள் ஒரு உண்மையான உலக விலங்கு எங்கே வரைபடங்கள். கற்பனை விலங்குகள், "
"மனிதர்கள் மற்றும் உணர்வுள்ள உயிரினங்கள் \"உருவப்படங்களுக்கு\" செல்கின்றன"

msgctxt "unlocks.levels_categories_rules.flags"
msgid ""
"Generally recognized flags of countries and causes. Try to use as few bricks"
" as possible while still being recognizable."
msgstr ""
"நாடுகள் மற்றும் காரணங்களின் பொதுவாக அங்கீகரிக்கப்பட்ட கொடிகள். அடையாளம் "
"காணக்கூடியதாக இருக்கும்போது முடிந்தவரை சில செங்கற்களைப் பயன்படுத்த "
"முயற்சிக்கவும்."

msgctxt "unlocks.levels_categories_rules.games"
msgid ""
"Characters, logos and elements of video games. The credits should contain a "
"link to said game. This category supersedes the other ones. For example, if "
"you draw a flag that only exists in a specific video game, categorize it "
"here, not in \"flags\"."
msgstr ""
"வீடியோ கேம்களின் எழுத்துக்கள், லோகோக்கள் மற்றும் கூறுகள். கிரெடிட்களில் "
"சொல்லப்பட்ட கேமிற்கான இணைப்பு இருக்க வேண்டும். இந்த வகை மற்றவற்றை "
"முறியடிக்கிறது. எடுத்துக்காட்டாக, ஒரு குறிப்பிட்ட வீடியோ கேமில் மட்டுமே "
"இருக்கும் கொடியை நீங்கள் வரைந்தால், அதை \"கொடிகளில்\" அல்லாமல் இங்கே "
"வகைப்படுத்தவும்."

msgctxt "unlocks.levels_categories_rules.landscapes"
msgid ""
"Depictions of real or fictional views, monuments, large objects, natural "
"phenomenons."
msgstr ""
"உண்மையான அல்லது கற்பனையான காட்சிகள், நினைவுச்சின்னங்கள், பெரிய பொருள்கள், "
"இயற்கை நிகழ்வுகளின் சித்தரிப்பு."

msgctxt "unlocks.levels_categories_rules.portraits"
msgid ""
"Depictions of humans, face or full body. Drawings of fictional creatures "
"capable of speech also belong here. Drawing of things that are made to look "
"like a human face. Scenes where the focus is a human character."
msgstr ""
"மனிதர்கள், முகம் அல்லது முழு உடலின் சித்தரிப்புகள். பேச்சுத்திறன் கொண்ட "
"கற்பனை உயிரினங்களின் வரைபடங்களும் இங்கு உள்ளன. மனித முகத்தைப் போல "
"தோற்றமளிக்கும் விசயங்களை வரைதல். மனிதப் பாத்திரத்தை மையமாகக் கொண்ட "
"காட்சிகள்."

msgctxt "unlocks.levels_categories_rules.stills"
msgid ""
"This is a bit of an \"other\" category for real world stuff. Representation "
"of real world object, vehicles, plants, foods, musical instruments, physical"
" games"
msgstr ""
"இது நிச உலக விசயங்களுக்கான \"வேறு\" வகையாகும். நிச உலக பொருள், வாகனங்கள், "
"தாவரங்கள், உணவுகள், இசைக்கருவிகள், உடல் விளையாட்டுகள் ஆகியவற்றின் "
"பிரதிநிதித்துவம்"

msgctxt "unlocks.levels_categories_rules.symbols"
msgid ""
"Symbols that have no real world existence, but communicate a meaning through"
" their shape and are recognizable. Letters, logos, typography belong here."
msgstr ""
"உண்மையான உலக இருப்பு இல்லாத சின்னங்கள், ஆனால் அவற்றின் வடிவத்தின் மூலம் ஒரு "
"பொருளைத் தெரிவிக்கின்றன மற்றும் அடையாளம் காணக்கூடியவை. கடிதங்கள், லோகோக்கள்,"
" அச்சுக்கலை ஆகியவை இங்கே சேர்ந்தவை."

msgctxt "unlocks.levels_help"
msgid "Discover all  {{count}} levels of the game."
msgstr "விளையாட்டின் அனைத்து {{count}} நிலைகளையும் கண்டறியவும்."

msgctxt "unlocks.minScore"
msgid "Reach ${{minScore}} in a run to unlock."
msgstr "திறக்க ஒரு ஓட்டத்தில் ${{minScore}} ஐ அடையவும்."

msgctxt "unlocks.minScoreWithPerks"
msgid ""
"Reach ${{minScore}} in a run with {{required}} but without {{forbidden}} to "
"unlock."
msgstr ""
"${{minScore}} ஐ அடைய {{required}} ஆனால் {{forbidden}} இல்லாமல் திறக்கவும்."

msgctxt "unlocks.minScoreWithPerksNoForbidden"
msgid "Reach ${{minScore}} in a run with {{required}}  to unlock."
msgstr "திறக்க {{required}} உடன் ஒரு ஓட்டத்தில் ${{minScore}} ஐ அடையவும்."

msgctxt "unlocks.minTotalScore"
msgid "Accumulate a total of ${{score}}"
msgstr "மொத்தமாக ${{score}} திரட்டவும்"

msgctxt "unlocks.next"
msgid "Next"
msgstr "அடுத்தது"

msgctxt "unlocks.previous"
msgid "Previous"
msgstr "முந்தைய"

msgctxt "unlocks.reached"
msgid "Your best score was {{reached}}."
msgstr "உங்கள் சிறந்த மதிப்பெண் {{reached}}."

msgctxt "unlocks.requires"
msgid "This upgrade requires you to first pick one of those : {{required}}"
msgstr ""
"இந்த மேம்படுத்தலுக்கு நீங்கள் முதலில் அவற்றில் ஒன்றைத் தேர்ந்தெடுக்க "
"வேண்டும்: {{required}}"

msgctxt "unlocks.requires_one"
msgid "This upgrade requires that you to first pick \"{{required}}\""
msgstr ""
"இந்த மேம்படுத்தலுக்கு நீங்கள் முதலில் \"{{required}}\" தேர்வு செய்ய வேண்டும்"

msgctxt "unlocks.sort_author"
msgid "Author"
msgstr "நூலாசிரியர்"

msgctxt "unlocks.sort_bombs"
msgid "Bombs"
msgstr "குண்டுகள்"

msgctxt "unlocks.sort_bombs_label"
msgid "{{count}} bomb bricks"
msgstr "{{count}} வெடிகுண்டு செங்கற்கள்"

msgctxt "unlocks.sort_bombs_label_0"
msgid "No bomb brick"
msgstr "வெடிகுண்டு செங்கல் இல்லை"

msgctxt "unlocks.sort_bombs_label_1"
msgid "One bomb brick"
msgstr "ஒரு வெடிகுண்டு செங்கல்"

msgctxt "unlocks.sort_bricks"
msgid "Bricks"
msgstr "செங்கற்கள்"

msgctxt "unlocks.sort_bricks_label"
msgid "{{count}} bricks"
msgstr "{{count}} செங்கற்கள்"

msgctxt "unlocks.sort_category"
msgid "Category"
msgstr "வகை"

msgctxt "unlocks.sort_colors"
msgid "Colors"
msgstr "நிறங்கள்"

msgctxt "unlocks.sort_colors_label"
msgid "{{count}} distinct colors"
msgstr "{{count}} தனித்துவமான நிறங்கள்"

msgctxt "unlocks.sort_colors_label_1"
msgid "Monochrome"
msgstr "ஒரே வண்ணமுடையது"

msgctxt "unlocks.sort_size"
msgid "Size"
msgstr "அளவு"

msgctxt "unlocks.sort_unlocked"
msgid "Access"
msgstr "அணுகல்"

msgctxt "unlocks.start_new_game_with"
msgid "Start a new game"
msgstr "புதிய விளையாட்டைத் தொடங்குங்கள்"

msgctxt "unlocks.start_new_game_with_help"
msgid "Use this upgrade as starter perk."
msgstr "இந்த மேம்படுத்தலை ச்டார்டர் பெர்க்காக பயன்படுத்தவும்."

msgctxt "unlocks.title_upgrades"
msgid "{{unlocked}} /  {{out_of}} upgrades unlocked"
msgstr "{{unlocked}} / {{out_of}} மேம்படுத்தல்கள் திறக்கப்பட்டன"

msgctxt "unlocks.try"
msgid "Try"
msgstr "முயற்சி வெற்றி"

msgctxt "unlocks.unlock_condition"
msgid "Unlock condition:"
msgstr "திறத்தல் நிலை:"

msgctxt "unlocks.upgrade_choice_perk"
msgid "Offered as upgrade"
msgstr "மேம்படுத்தப்பட்டதாக வழங்கப்படுகிறது"

msgctxt "unlocks.upgrade_choice_perk_help"
msgid "Include this upgrade in the list offered after a level up"
msgstr ""
"ஒரு நிலைக்குப் பிறகு வழங்கப்படும் பட்டியலில் இந்த மேம்படுத்தலைச் சேர்க்கவும்"

msgctxt "unlocks.upgrade_incompatibilities"
msgid "Decreases the probability of getting : {{list}}"
msgstr "பெறுவதற்கான நிகழ்தகவைக் குறைக்கிறது : {{list}}"

msgctxt "unlocks.upgrade_synergies"
msgid "Increases the probability of getting : {{list}}"
msgstr "பெறுவதற்கான நிகழ்தகவை அதிகரிக்கிறது : {{list}}"

msgctxt "unlocks.upgrades"
msgid "Upgrades"
msgstr "மேம்படுத்துகிறது"

msgctxt "unlocks.upgrades_help"
msgid "Discover all {{count}} gameplay upgrades."
msgstr "அனைத்து {{count}} விளையாட்டு மேம்படுத்தல்களையும் கண்டறியவும்."

msgctxt "unlocks.use"
msgid "Use"
msgstr "பயன்படுத்தவும்"

#, ignore-same
msgctxt "upgrades.addiction.name"
msgid "Addiction"
msgstr "மயக்கம்"

msgctxt "upgrades.addiction.tooltip"
msgid "More coins if you break bricks without pause"
msgstr "இடைநிறுத்தப்படாமல் செங்கற்களை உடைத்தால் அதிக நாணயங்கள்"

msgctxt "upgrades.addiction.verbose_description"
msgid ""
"+{{lvl}} combo / brick broken, combo resets {{delay}}s after breaking a "
"brick.  The countdown only starts after breaking the first brick of each "
"level. It stops as soon as all bricks are destroyed."
msgstr ""
"+{{lvl}} சேர்க்கை / செங்கல் உடைந்தது, ஒரு செங்கல் உடைந்த பிறகு சேர்க்கை "
"மீட்டமைக்கப்படும் {{delay}}. ஒவ்வொரு மட்டத்தின் முதல் செங்கலை உடைத்த பின்னரே"
" கவுண்டவுன் தொடங்குகிறது. அனைத்து செங்கற்களும் அழிக்கப்பட்டவுடன் அது "
"நிறுத்தப்படும்."

msgctxt "upgrades.asceticism.name"
msgid "Asceticism"
msgstr "துறவு"

msgctxt "upgrades.asceticism.tooltip"
msgid "+{{combo}} combo per brick broken, -{{loss}} combo  per coin caught."
msgstr ""
"+{{combo}} காம்போ ஒரு செங்கல் உடைந்துவிட்டது, -{{loss}} காம்போ பிடிபட்டது."

msgctxt "upgrades.asceticism.verbose_description"
msgid "You'll need to store the coins somewhere while your combo climbs."
msgstr "உங்கள் காம்போ ஏறும் போது நீங்கள் நாணயங்களை எங்காவது சேமிக்க வேண்டும்."

msgctxt "upgrades.ball_attract_ball.name"
msgid "Group project"
msgstr "குழு திட்டம்"

msgctxt "upgrades.ball_attract_ball.tooltip"
msgid "Balls attract balls"
msgstr "பந்துகள் பந்துகளை ஈர்க்கின்றன"

msgctxt "upgrades.ball_attract_ball.verbose_description"
msgid ""
"Balls that are more than \"3/4 of the game area width\" away will start attracting each other. \n"
"\n"
"The attraction force is stronger when they are furthest away from each other.\n"
"\n"
"Rainbow particles will fly to symbolize the attraction force. This perk is only offered if you have more than one ball already."
msgstr ""
"\"விளையாட்டு பகுதியின் 3/4 அகலத்திற்கு\" அதிகமாக இருக்கும் பந்துகள் ஒன்றையொன்று ஈர்க்கத் தொடங்கும். \n"
"\n"
"அவர்கள் ஒருவருக்கொருவர் வெகு தொலைவில் இருக்கும்போது ஈர்ப்பு ஆற்றல் வலுவாக இருக்கும். \n"
"\n"
"வானவில் துகள்கள் ஈர்ப்பு சக்தியின் அடையாளமாக பறக்கும். உங்களிடம் ஏற்கனவே ஒன்றுக்கு மேற்பட்ட பந்துகள் இருந்தால் மட்டுமே இந்த சலுகை வழங்கப்படும்."

msgctxt "upgrades.ball_attracts_coins.name"
msgid "Balls attract coins"
msgstr "பந்துகள் நாணயங்களை ஈர்க்கின்றன"

msgctxt "upgrades.ball_attracts_coins.tooltip"
msgid "Coins follow the nearest ball"
msgstr "நாணயங்கள் அருகிலுள்ள பந்தைப் பின்தொடர்கின்றன"

msgctxt "upgrades.ball_attracts_coins.verbose_description"
msgid ""
"This could be used to \"paint around\" the balls with coins if you combined "
"it with \"metamorphosis\" and \"ghost coins\". It also works as a substitute"
" for coin magnet."
msgstr ""
"\"உருமாற்றம்\" மற்றும் \"பேய் நாணயங்கள்\" ஆகியவற்றை நீங்கள் இணைத்தால், "
"பந்துகளை நாணயங்களால் \"வரைவதற்கு\" இது பயன்படுத்தப்படலாம். இது நாணய "
"காந்தத்திற்கு மாற்றாகவும் செயல்படுகிறது."

msgctxt "upgrades.ball_repulse_ball.name"
msgid "Personal space"
msgstr "தனிப்பட்ட இடம்"

msgctxt "upgrades.ball_repulse_ball.tooltip"
msgid "Balls repulse balls"
msgstr "பந்துகள் பந்துகளை விரட்டுகின்றன"

msgctxt "upgrades.ball_repulse_ball.verbose_description"
msgid ""
"Balls that are less than a quarter screen width away will start repulsing "
"each other. The repulsion force is stronger if they are close to each other."
" Particles will jet out to symbolize this force being applied. This perk is "
"only offered if you have more than one ball already."
msgstr ""
"கால் திரை அகலத்திற்கு குறைவாக இருக்கும் பந்துகள் ஒன்றையொன்று விரட்டத் "
"தொடங்கும். அவர்கள் ஒருவருக்கொருவர் நெருக்கமாக இருந்தால் விரட்டும் ஆற்றல் "
"வலுவாக இருக்கும். இந்த ஆற்றல் பயன்படுத்தப்படுவதைக் குறிக்கும் வகையில் "
"துகள்கள் வெளியேறும். உங்களிடம் ஏற்கனவே ஒன்றுக்கு மேற்பட்ட பந்துகள் இருந்தால்"
" மட்டுமே இந்த சலுகை வழங்கப்படும்."

msgctxt "upgrades.base_combo.name"
msgid "Strong foundations"
msgstr "வலுவான அடித்தளங்கள்"

msgctxt "upgrades.base_combo.tooltip"
msgid "3 more coins per brick broken"
msgstr "ஒரு செங்கல்லுக்கு மேலும் 3 காசுகள் உடைந்தன"

msgctxt "upgrades.base_combo.verbose_description"
msgid ""
"Your combo normally starts at 1 at the beginning of the level, and resets to"
" 1 when you bounce around without hitting anything. With this perk, the "
"combo starts 3 points higher, so you'll always get at least 4 coins per "
"brick. Whenever your combo reset, it will go back to 4 and not 1. Your ball "
"will glitter a bit to indicate that its combo is higher than one. At level "
"2, it adds 4 coins, then 5,then 6…"
msgstr ""
"உங்கள் காம்போ பொதுவாக நிலையின் தொடக்கத்தில் 1 இல் தொடங்குகிறது, மேலும் "
"நீங்கள் எதையும் தாக்காமல் குதிக்கும்போது 1 க்கு மீட்டமைக்கப்படும். இந்த "
"பெர்க் மூலம், காம்போ 3 புள்ளிகள் அதிகமாகத் தொடங்குகிறது, எனவே நீங்கள் "
"எப்போதும் ஒரு செங்கல்லுக்கு குறைந்தது 4 காசுகளைப் பெறுவீர்கள். உங்கள் காம்போ"
" ரீசெட் செய்யும் போதெல்லாம், அது 4 க்கு திரும்பும், 1 அல்ல. உங்கள் பந்தானது "
"அதன் சேர்க்கை ஒன்றை விட அதிகமாக இருப்பதைக் குறிக்க சிறிது மின்னும். நிலை 2 "
"இல், இது 4 நாணயங்களைச் சேர்க்கிறது, பின்னர் 5, பின்னர் 6…"

msgctxt "upgrades.bigger_balls.name"
msgid "Bigger ball"
msgstr "பெரிய பந்து"

msgctxt "upgrades.bigger_balls.tooltip"
msgid "Increases the ball's diameter"
msgstr "பந்தின் விட்டம் அதிகரிக்கிறது"

msgctxt "upgrades.bigger_balls.verbose_description"
msgid "This makes it a bit easier to catch bricks."
msgstr "இது செங்கற்களைப் பிடிப்பதை சற்று எளிதாக்குகிறது."

msgctxt "upgrades.bigger_explosions.name"
msgid "Kaboom"
msgstr "கபூம்"

msgctxt "upgrades.bigger_explosions.tooltip"
msgid "Bigger explosions"
msgstr "பெரிய வெடிப்புகள்"

msgctxt "upgrades.bigger_explosions.verbose_description"
msgid ""
"The default explosion clears a 3x3 square, with this it becomes a 5x5 "
"square, and the blow on the coins is also significantly stronger. The screen"
" will flash after each explosion (except in basic mode)"
msgstr ""
"இயல்புநிலை வெடிப்பு ஒரு 3x3 சதுரத்தை அழிக்கிறது, இதன் மூலம் அது 5x5 சதுரமாக "
"மாறும், மேலும் நாணயங்களின் அடியும் கணிசமாக வலுவாக இருக்கும். ஒவ்வொரு "
"வெடிப்புக்கும் பிறகு திரை ஒளிரும் (அடிப்படை பயன்முறையைத் தவிர)"

msgctxt "upgrades.bigger_puck.name"
msgid "Bigger paddle"
msgstr "பெரிய துடுப்பு"

msgctxt "upgrades.bigger_puck.tooltip"
msgid "Easily catch more coins"
msgstr "அதிக நாணயங்களை எளிதாகப் பிடிக்கலாம்"

msgctxt "upgrades.bigger_puck.verbose_description"
msgid ""
"A bigger paddle makes it easier to never miss the ball and to catch more "
"coins, and also to precisely angle the bounces (the ball's angle only "
"depends on where it hits the paddle)."
msgstr ""
"ஒரு பெரிய துடுப்பு பந்தைத் தவறவிடாமல் மற்றும் அதிக நாணயங்களைப் பிடிப்பதை "
"எளிதாக்குகிறது, மேலும் துள்ளல்களை துல்லியமாக கோணமாக்குகிறது (பந்தின் கோணம் "
"அது துடுப்பை எங்கு தாக்குகிறது என்பதைப் பொறுத்தது)."

msgctxt "upgrades.bricks_attract_ball.name"
msgid "Bricks attract balls"
msgstr "செங்கற்கள் பந்துகளை ஈர்க்கின்றன"

msgctxt "upgrades.bricks_attract_ball.tooltip"
msgid "Ball goes toward nearby bricks"
msgstr "பந்து அருகில் உள்ள செங்கற்களை நோக்கி செல்கிறது"

msgctxt "upgrades.bricks_attract_ball.verbose_description"
msgid ""
"Ball goes toward the first {{count}} bricks it will hit. The effect is "
"stronger at higher levels. The number of bricks that can hit before the "
"effect stops is also higher. The effect rearms when the ball hits the "
"paddle."
msgstr ""
"பந்து அது அடிக்கும் முதல் {{count}} செங்கற்களை நோக்கி செல்கிறது. விளைவு உயர்"
" மட்டங்களில் வலுவானது. விளைவு நிற்கும் முன் அடிக்கக்கூடிய செங்கற்களின் "
"எண்ணிக்கையும் அதிகம். பந்து துடுப்பைத் தாக்கும் போது விளைவு பின்வாங்குகிறது."

msgctxt "upgrades.bricks_attract_coins.name"
msgid "Bricks attract coins"
msgstr "செங்கற்கள் நாணயங்களை ஈர்க்கின்றன"

msgctxt "upgrades.bricks_attract_coins.tooltip"
msgid "Helps them stay up there"
msgstr "அவர்கள் அங்கேயே இருக்க உதவுகிறது"

msgctxt "upgrades.bricks_attract_coins.verbose_description"
msgid ""
"Coins will be attracted to nearby bricks. At higher levels the attraction is"
" stronger."
msgstr ""
"நாணயங்கள் அருகிலுள்ள செங்கற்களால் ஈர்க்கப்படும். உயர் மட்டங்களில் ஈர்ப்பு "
"வலுவாக இருக்கும்."

msgctxt "upgrades.buoy.name"
msgid "Buoy"
msgstr "மிதவை"

msgctxt "upgrades.buoy.tooltip"
msgid "Coins float for {{duration}} seconds on the bottom line."
msgstr "நாணயங்கள் கீழ் வரியில் {{duration}} வினாடிகள் மிதக்கும்."

msgctxt "upgrades.buoy.verbose_description"
msgid "Effect is most visible in mobile mode"
msgstr "மொபைல் பயன்முறையில் விளைவு அதிகம் தெரியும்"

msgctxt "upgrades.chill.name"
msgid "Chill"
msgstr "குளிர்"

msgctxt "upgrades.chill.tooltip"
msgid "No more upgrades, unlimited levels."
msgstr "மேலும் மேம்படுத்தல்கள் இல்லை, வரம்பற்ற நிலைகள்."

msgctxt "upgrades.chill.verbose_description"
msgid "The ball will also accelerates much slower."
msgstr "பந்தும் மிக மெதுவாக வேகமெடுக்கும்."

msgctxt "upgrades.clairvoyant.name"
msgid "Clairvoyant"
msgstr "தெளிவானவர்"

msgctxt "upgrades.clairvoyant.tooltip"
msgid "See upcoming levels, bricks HP and ball direction"
msgstr ""
"வரவிருக்கும் நிலைகள், செங்கற்கள் எச்பி மற்றும் பந்து திசையைப் பார்க்கவும்"

msgctxt "upgrades.clairvoyant.verbose_description"
msgid ""
"Helps you pick the right upgrades and understand what's going on with sturdy"
" bricks. Level 2 and 3 bring additional knowledge of dubious utility "
"(reachable with limitless)"
msgstr ""
"சரியான மேம்படுத்தல்களைத் தேர்ந்தெடுத்து, உறுதியான செங்கற்களால் என்ன "
"நடக்கிறது என்பதைப் புரிந்துகொள்ள உதவுகிறது. நிலை 2 மற்றும் 3 "
"சந்தேகத்திற்குரிய பயன்பாடு பற்றிய கூடுதல் அறிவைக் கொண்டுவருகிறது (வரம்பற்ற "
"நிலையில் அடையக்கூடியது)"

msgctxt "upgrades.coin_magnet.name"
msgid "Coins magnet"
msgstr "நாணயங்கள் காந்தம்"

msgctxt "upgrades.coin_magnet.tooltip"
msgid "Paddle attracts coins"
msgstr "துடுப்பு நாணயங்களை ஈர்க்கிறது"

msgctxt "upgrades.coin_magnet.verbose_description"
msgid ""
"Directs the coins to the paddle. The effect is stronger if the coin is close"
" to it already."
msgstr ""
"நாணயங்களை துடுப்புக்கு செலுத்துகிறது. நாணயம் ஏற்கனவே அதற்கு அருகில் "
"இருந்தால் விளைவு வலுவாக இருக்கும்."

msgctxt "upgrades.compound_interest.name"
msgid "Compound interest"
msgstr "கூட்டு வட்டி"

msgctxt "upgrades.compound_interest.tooltip"
msgid "More coins if you catch all coins"
msgstr "நீங்கள் அனைத்து நாணயங்களையும் பிடித்தால் அதிக நாணயங்கள்"

msgctxt "upgrades.compound_interest.verbose_description"
msgid ""
"Your combo will grow by one every time you break a brick, spawning more and more coin with every brick you break. \n"
"Be sure however to catch every one of those coins with your paddle, as any lost coin will reset your combo.\n"
"Once your combo is above the minimum, the bottom of the play area will have a red line to remind you that coins should not go there."
msgstr ""
"நீங்கள் ஒரு செங்கலை உடைக்கும் ஒவ்வொரு முறையும் உங்கள் காம்போ ஒன்று வளரும், நீங்கள் உடைக்கும் ஒவ்வொரு செங்கலிலும் மேலும் மேலும் நாணயம் உருவாகும். \n"
"எவ்வாறாயினும், அந்த நாணயங்கள் ஒவ்வொன்றையும் உங்கள் துடுப்புடன் பிடிக்க வேண்டும், ஏனெனில் இழந்த நாணயம் உங்கள் காம்போவை மீட்டமைக்கும். \n"
"உங்கள் காம்போ குறைந்தபட்சத்திற்கு மேல் இருந்தால், நாணயங்கள் அங்கு செல்லக்கூடாது என்பதை உங்களுக்கு நினைவூட்டுவதற்காக விளையாட்டுப் பகுதியின் அடிப்பகுதியில் சிவப்புக் கோடு இருக்கும்."

msgctxt "upgrades.concave_puck.name"
msgid "Concave paddle"
msgstr "குழிவான துடுப்பு"

msgctxt "upgrades.concave_puck.tooltip"
msgid "Improves vertical aiming precision"
msgstr "செங்குத்து இலக்கு துல்லியத்தை மேம்படுத்துகிறது"

msgctxt "upgrades.concave_puck.verbose_description"
msgid "Balls starts the level going straight up, and bounces with less angle."
msgstr ""
"பந்துகள் நிலை நேராக மேலே செல்லத் தொடங்குகிறது, மேலும் குறைந்த கோணத்தில் "
"துள்ளுகிறது."

msgctxt "upgrades.corner_shot.name"
msgid "Corner shot"
msgstr "கார்னர் காட்சி"

msgctxt "upgrades.corner_shot.tooltip"
msgid "Lets your paddle overlap with the borders of the screen"
msgstr "உங்கள் துடுப்பை திரையின் எல்லைகளுடன் ஒன்றுடன் ஒன்று சேர்க்கலாம்"

msgctxt "upgrades.corner_shot.verbose_description"
msgid ""
"Helps with aiming in the corners. Further levels let you go further out."
msgstr ""
"மூலைகளில் குறிவைக்க உதவுகிறது. மேலும் நிலைகள் உங்களை மேலும் வெளியே செல்ல "
"அனுமதிக்கும்."

msgctxt "upgrades.disco_ball.name"
msgid "Disco ball"
msgstr "டிச்கோ பந்து"

msgctxt "upgrades.disco_ball.tooltip"
msgid "Every wall bounce changes the balls color"
msgstr "ஒவ்வொரு சுவர் துள்ளல் பந்துகளின் நிறத்தை மாற்றுகிறது"

msgctxt "upgrades.disco_ball.verbose_description"
msgid "The ball will cycle through the rainbow colors."
msgstr "பந்து வானவில் வண்ணங்களில் சுழற்சி செய்யும்."

msgctxt "upgrades.double_or_nothing.name"
msgid "Double or nothing"
msgstr "இரட்டை அல்லது எதுவும் இல்லை"

msgctxt "upgrades.double_or_nothing.tooltip"
msgid "The combo climbs twice as fast, but any combo reset is a game over."
msgstr ""
"காம்போ இரண்டு மடங்கு வேகமாக ஏறுகிறது, ஆனால் எந்த காம்போ மீட்டமைப்பும் ஒரு "
"விளையாட்டு முடிந்துவிட்டது."

msgctxt "upgrades.double_or_nothing.verbose_description"
msgid ""
"The combo reset only counts when your combo was above the minimum. This also"
" doubles the boost applied by \"smaller paddle\", \"transparency\" and "
"\"sturdy bricks\"."
msgstr ""
"உங்கள் காம்போ குறைந்தபட்சத்தை விட அதிகமாக இருந்தால் மட்டுமே சேர்க்கை "
"மீட்டமைப்பு கணக்கிடப்படும். இது \"சிறிய துடுப்பு\", \"வெளிப்படைத்தன்மை\" "
"மற்றும் \"உறுதியான செங்கற்கள்\" ஆகியவற்றால் பயன்படுத்தப்படும் ஊக்கத்தை "
"இரட்டிப்பாக்குகிறது."

msgctxt "upgrades.etherealcoins.name"
msgid "Coins, in Space"
msgstr "நாணயங்கள், விண்வெளியில்"

msgctxt "upgrades.etherealcoins.tooltip"
msgid "Coins are no  longer affected by gravity"
msgstr "நாணயங்கள் இனி ஈர்ப்பு விசையால் பாதிக்கப்படாது"

msgctxt "upgrades.etherealcoins.verbose_description"
msgid ""
"The coins will maintain their speed even after several bounces, and will no "
"longer be affected by gravity."
msgstr ""
"நாணயங்கள் பல துள்ளல்களுக்குப் பிறகும் அவற்றின் வேகத்தைத் தக்க வைத்துக் "
"கொள்ளும், மேலும் ஈர்ப்பு விசையால் பாதிக்கப்படாது."

msgctxt "upgrades.extra_levels.name"
msgid "5 min more"
msgstr "இன்னும் 5 மணித்துளி"

msgctxt "upgrades.extra_levels.tooltip"
msgid "Play {{count}} levels instead of 7"
msgstr "7க்கு பதிலாக {{count}} நிலைகளை இயக்கவும்"

msgctxt "upgrades.extra_levels.verbose_description"
msgid ""
"The default game can last a max of 7 levels, after which the game is over. \n"
"\n"
"Each level of this perk lets you go one level higher. The last levels are often the ones where you make the most score, so the difference can be dramatic."
msgstr ""
"இயல்புநிலை கேம் அதிகபட்சமாக 7 நிலைகள் நீடிக்கும், அதன் பிறகு கேம் முடிந்தது. \n"
"\n"
"இந்தச் சலுகையின் ஒவ்வொரு நிலையும் உங்களை ஒரு நிலைக்கு மேலே செல்ல அனுமதிக்கிறது. கடைசி நிலைகள் பெரும்பாலும் நீங்கள் அதிக மதிப்பெண்களைப் பெறுகின்றன, எனவே வேறுபாடு வியத்தகு அளவில் இருக்கும்."

msgctxt "upgrades.extra_life.name"
msgid "Extra life"
msgstr "கூடுதல் வாழ்க்கை"

msgctxt "upgrades.extra_life.tooltip"
msgid "Saves your last ball if it's about to be lost"
msgstr "உங்கள் கடைசி பந்தை இழக்க நேரிட்டால் சேமிக்கும்"

msgctxt "upgrades.extra_life.verbose_description"
msgid ""
"The life will be consumed in the process. Extra lives show as while lines "
"behind the paddle."
msgstr ""
"அந்தச் செயலில் உயிர் பறிபோய்விடும். துடுப்புக்குப் பின்னால் இருக்கும் "
"கோடுகள் போல் கூடுதல் உயிர்கள் காட்டப்படுகின்றன."

msgctxt "upgrades.flyswatter.name"
msgid "Flyswatter"
msgstr "ஃப்ளைச்வாட்டர்"

msgctxt "upgrades.flyswatter.tooltip"
msgid "Touch the left side to apply gravity to all balls."
msgstr ""
"அனைத்து பந்துகளுக்கும் ஈர்ப்பு விசையைப் பயன்படுத்த இடது பக்கத்தைத் தொடவும்."

msgctxt "upgrades.flyswatter.verbose_description"
msgid ""
msgstr "upgrades.flyswatter.verbose_description"

msgctxt "upgrades.forgiving.name"
msgid "Forgiving"
msgstr "மன்னிக்கும்"

msgctxt "upgrades.forgiving.tooltip"
msgid "The first time the ball misses all bricks in a level is ignored."
msgstr ""
"முதல் முறையாக பந்து அனைத்து செங்கற்களையும் ஒரு மட்டத்தில் தவறவிட்டால் "
"புறக்கணிக்கப்படுகிறது."

msgctxt "upgrades.forgiving.verbose_description"
msgid ""
"If your missed shot is ignored, you will still be eligible for the golden "
"medal on that criteria."
msgstr ""
"நீங்கள் தவறவிட்ட காட்சி புறக்கணிக்கப்பட்டால், அந்த அளவுகோலில் தங்கப் "
"பதக்கத்திற்கு நீங்கள் தகுதி பெறுவீர்கள்."

msgctxt "upgrades.fountain_toss.name"
msgid "Fountain toss"
msgstr "நீரூற்று டாச்"

msgctxt "upgrades.fountain_toss.tooltip"
msgid "Gain combo when you miss coins."
msgstr "நீங்கள் நாணயங்களைத் தவறவிடும்போது சேர்க்கையைப் பெறுங்கள்."

msgctxt "upgrades.fountain_toss.verbose_description"
msgid ""
"When you miss a coin and your combo was under level*30, your combo has a "
"probability of level/combo to grow by one."
msgstr ""
"நீங்கள் ஒரு நாணயத்தைத் தவறவிட்டு, உங்கள் காம்போ நிலை*30க்கு கீழ் இருந்தபோது,"
" ​​உங்கள் காம்போ நிலை/சேர்ப்பு ஒன்றின் மூலம் வளர நிகழ்தகவு உள்ளது."

msgctxt "upgrades.fumes.name"
msgid "Fumes"
msgstr "புகைகள்"

msgctxt "upgrades.fumes.tooltip"
msgid "When a brick breaks, all bricks above get its color."
msgstr ""
"ஒரு செங்கல் உடைந்தால், மேலே உள்ள அனைத்து செங்கற்களும் அதன் நிறத்தைப் "
"பெறுகின்றன."

msgctxt "upgrades.fumes.verbose_description"
msgid "The coloring goes across gaps too."
msgstr "வண்ணமயமாக்கல் இடைவெளிகளைக் கடந்து செல்கிறது."

msgctxt "upgrades.ghost_coins.name"
msgid "Ghost coins"
msgstr "பேய் நாணயங்கள்"

msgctxt "upgrades.ghost_coins.tooltip"
msgid "Coins slowly pass through bricks"
msgstr "நாணயங்கள் மெதுவாக செங்கற்கள் வழியாக செல்கின்றன"

msgctxt "upgrades.ghost_coins.verbose_description"
msgid ""
"It's not a bug, it's a feature !  Coins fly through bricks slowly. Higher "
"levels let them move faster."
msgstr ""
"இது ஒரு பிழை அல்ல, இது ஒரு அம்சம்! நாணயங்கள் செங்கற்கள் வழியாக மெதுவாக "
"பறக்கின்றன. உயர் நிலைகள் அவற்றை வேகமாக நகர அனுமதிக்கின்றன."

msgctxt "upgrades.golden_goose.name"
msgid "Golden goose"
msgstr "தங்க வாத்து"

msgctxt "upgrades.golden_goose.tooltip"
msgid "Coins teleport to the ball after hitting a brick"
msgstr "செங்கலைத் தாக்கிய பிறகு நாணயங்கள் பந்திற்கு டெலிபோர்ட் செய்கின்றன"

msgctxt "upgrades.golden_goose.verbose_description"
msgid ""
"Whenever a coin hits a brick, teleport that coin to the nearest ball. At "
"level two, coins teleport after hitting a side too."
msgstr ""
"ஒரு நாணயம் ஒரு செங்கலைத் தாக்கும் போதெல்லாம், அந்த நாணயத்தை அருகிலுள்ள "
"பந்திற்கு டெலிபோர்ட் செய்யுங்கள். நிலை இரண்டில், ஒரு பக்கத்தைத் தாக்கிய "
"பிறகு நாணயங்கள் டெலிபோர்ட் செய்கின்றன."

msgctxt "upgrades.gravity_falls.name"
msgid "Gravity Falls"
msgstr "ஈர்ப்பு நீர்வீழ்ச்சி"

msgctxt "upgrades.gravity_falls.tooltip"
msgid "Balls that touch the top get gravity"
msgstr "மேலே தொடும் பந்துகள் ஈர்ப்பு விசையைப் பெறுகின்றன"

msgctxt "upgrades.gravity_falls.verbose_description"
msgid ""
msgstr "upgrades.gravity_falls.verbose_description"

msgctxt "upgrades.happy_family.name"
msgid "Happy family"
msgstr "மகிழ்ச்சியான குடும்பம்"

msgctxt "upgrades.happy_family.tooltip"
msgid "More coins if you keep all balls in game."
msgstr "விளையாட்டில் அனைத்து பந்துகளையும் வைத்திருந்தால் அதிக நாணயங்கள்."

msgctxt "upgrades.happy_family.verbose_description"
msgid ""
"+1 combo per extra ball per paddle bounce. Combo resets when a ball is lost."
"  Only the ball above 1 give combo."
msgstr ""
"ஒரு துடுப்பு பவுன்ச் ஒன்றுக்கு கூடுதல் பந்துக்கு +1 சேர்க்கை. ஒரு பந்து "
"தொலைந்தால் காம்போ மீட்டமைக்கப்படுகிறது. 1 க்கு மேல் உள்ள பந்து மட்டுமே "
"சேர்க்கையைக் கொடுக்கும்."

msgctxt "upgrades.hardhat.name"
msgid "Hard hat"
msgstr "கடினமான தொப்பி"

msgctxt "upgrades.hardhat.tooltip"
msgid "Bricks are harder to break from the top"
msgstr "செங்கற்கள் மேலே இருந்து உடைப்பது கடினம்"

msgctxt "upgrades.hardhat.verbose_description"
msgid "Halves the damage when a ball is hitting the top of a brick"
msgstr ""
"ஒரு செங்கலின் மேல் பந்து அடிக்கும் போது ஏற்படும் சேதத்தை பாதியாக குறைக்கிறது"

msgctxt "upgrades.helium.name"
msgid "Helium"
msgstr "எல்லியம்"

msgctxt "upgrades.helium.tooltip"
msgid "Gravity limited left and right of paddle"
msgstr "புவியீர்ப்பு துடுப்பின் இடது மற்றும் வலதுபுறம் வரையறுக்கப்பட்டுள்ளது"

msgctxt "upgrades.helium.verbose_description"
msgid ""
"At level 1, gravity is reduced. At level 2, coins slowly float up. At level "
"3 they really fly."
msgstr ""
"நிலை 1 இல், ஈர்ப்பு குறைக்கப்படுகிறது. நிலை 2 இல், நாணயங்கள் மெதுவாக மேலே "
"மிதக்கின்றன. நிலை 3 இல் அவர்கள் உண்மையில் பறக்கிறார்கள்."

msgctxt "upgrades.hot_start.name"
msgid "Hot start"
msgstr "சூடான தொடக்கம்"

msgctxt "upgrades.hot_start.tooltip"
msgid "More coins if you clear the level under 30s"
msgstr "30களுக்கு கீழ் உள்ள நிலையை நீக்கினால் அதிக நாணயங்கள்"

msgctxt "upgrades.hot_start.verbose_description"
msgid ""
"At the start of every level, your combo will start at +{{start}} points, but"
" then every second it will be decreased by {{loss}}. The effect stacks with "
"other perks."
msgstr ""
"ஒவ்வொரு நிலையின் தொடக்கத்திலும், உங்கள் சேர்க்கை +{{start}} புள்ளிகளில் "
"தொடங்கும், ஆனால் ஒவ்வொரு நொடியும் அது {{loss}} குறைக்கப்படும். விளைவு மற்ற "
"சலுகைகளுடன் அடுக்கி வைக்கப்படுகிறது."

msgctxt "upgrades.implosions.name"
msgid "Implosions"
msgstr "வெடிப்புகள்"

msgctxt "upgrades.implosions.tooltip"
msgid "Explosions suck coins in instead of blowing them out"
msgstr "வெடிப்புகள் நாணயங்களை உறிஞ்சுவதற்கு பதிலாக அவற்றை உறிஞ்சும்"

msgctxt "upgrades.implosions.verbose_description"
msgid ""
"The explosion force is applied the other way. Further levels act as \"bigger"
" explosion\""
msgstr ""
"வெடிப்பு ஆற்றல் வேறு வழியில் பயன்படுத்தப்படுகிறது. மேலும் நிலைகள் \"பெரிய "
"வெடிப்பாக\" செயல்படுகின்றன"

msgctxt "upgrades.instant_explosion.name"
msgid "Instantaneous explosion"
msgstr "உடனடி வெடிப்பு"

msgctxt "upgrades.instant_explosion.tooltip"
msgid "Explosions instantly break nearby bricks and bombs"
msgstr ""
"வெடிப்புகள் உடனடியாக அருகிலுள்ள செங்கற்கள் மற்றும் குண்டுகளை உடைக்கின்றன"

msgctxt "upgrades.instant_explosion.verbose_description"
msgid ""
"This could be helpful if you rely and explosions breaking bricks before they"
" reset your combo."
msgstr ""
"உங்கள் காம்போவை மீட்டமைக்கும் முன் செங்கற்களை உடைக்கும் வெடிப்புகளை நீங்கள் "
"நம்பினால், இது உதவியாக இருக்கும்."

msgctxt "upgrades.left_is_lava.name"
msgid "Avoid left side"
msgstr "இடது பக்கத்தைத் தவிர்க்கவும்"

msgctxt "upgrades.left_is_lava.tooltip"
msgid "More coins if you don't touch the left side"
msgstr "நீங்கள் இடது பக்கத்தைத் தொடவில்லை என்றால் அதிக நாணயங்கள்"

msgctxt "upgrades.left_is_lava.verbose_description"
msgid ""
"Whenever you break a brick, your combo will increase by one, so you'll get one more coin from all the next bricks you break.\n"
"\n"
"However, your combo will reset as soon as your ball hits the left side . \n"
"\n"
"As soon as your combo rises, the left side becomes red to remind you that you should avoid hitting them. \n"
"\n"
"At level 2, the border is completely removed and your balls and coins might get lost.\n"
"\n"
"This upgrade impacts the starting direction of the ball."
msgstr ""
"நீங்கள் ஒரு செங்கலை உடைக்கும் போதெல்லாம், உங்கள் சேர்க்கை ஒன்று அதிகரிக்கும், எனவே நீங்கள் உடைக்கும் அனைத்து அடுத்த செங்கற்களிலிருந்தும் மேலும் ஒரு நாணயத்தைப் பெறுவீர்கள். \n"
"\n"
"இருப்பினும், உங்கள் பந்து இடது பக்கத்தைத் தாக்கியவுடன் உங்கள் காம்போ மீட்டமைக்கப்படும். \n"
"\n"
"உங்கள் காம்போ உயர்ந்தவுடன், அவற்றைத் தாக்குவதைத் தவிர்க்க வேண்டும் என்பதை உங்களுக்கு நினைவூட்ட இடது பக்கம் சிவப்பு நிறமாக மாறும். \n"
"\n"
"நிலை 2 இல், எல்லை முற்றிலும் அகற்றப்பட்டு, உங்கள் பந்துகளும் நாணயங்களும் தொலைந்து போகக்கூடும். \n"
"\n"
"இந்த மேம்படுத்தல் பந்தின் தொடக்க திசையை பாதிக்கிறது."

msgctxt "upgrades.limitless.name"
msgid "Limitless"
msgstr "எல்லையற்றது"

msgctxt "upgrades.limitless.tooltip"
msgid "Raise all upgrade's maximum level by {{lvl}}"
msgstr "அனைத்து மேம்படுத்தலின் அதிகபட்ச அளவை {{lvl}} ஆல் உயர்த்தவும்"

msgctxt "upgrades.limitless.verbose_description"
msgid ""
"Choosing this perk also raises his own limit by one, letting you pick it "
"again."
msgstr ""
"இந்தச் சலுகையைத் தேர்ந்தெடுப்பது, அதன் சொந்த வரம்பை ஒன்று உயர்த்தி, அதை "
"மீண்டும் தேர்ந்தெடுக்க உங்களை அனுமதிக்கிறது."

msgctxt "upgrades.metamorphosis.name"
msgid "Metamorphosis"
msgstr "உருமாற்றம்"

msgctxt "upgrades.metamorphosis.tooltip"
msgid "Each coin can stain {{lvl}} brick(s) with its color"
msgstr "ஒவ்வொரு நாணயமும் அதன் நிறத்தில் {{lvl}} செங்கல்(களை) கறைபடுத்தும்"

msgctxt "upgrades.metamorphosis.verbose_description"
msgid ""
"With this perk, coins will be of the color of the brick they come from, and "
"will color the first brick they touch in the same color. Coins spawn with "
"the speed of the ball that broke them, which means you can aim a bit in the "
"direction of the bricks you want to \"paint\". At level 1, each coin can "
"color 1 bricks before it is \"spent\" and appears hollow."
msgstr ""
"இந்த பெர்க் மூலம், நாணயங்கள் அவை வரும் செங்கலின் நிறத்தில் இருக்கும், மேலும்"
" அவை தொடும் முதல் செங்கலை அதே நிறத்தில் நிறமாக்கும். அவற்றை உடைத்த பந்தின் "
"வேகத்தில் நாணயங்கள் உருவாகின்றன, அதாவது நீங்கள் \"பெயிண்ட்\" செய்ய "
"விரும்பும் செங்கற்களின் திசையில் சிறிது குறிவைக்கலாம். நிலை 1 இல், ஒவ்வொரு "
"நாணயமும் 1 செங்கற்களை \"செலவு\" செய்து வெற்றுத் தோற்றத்திற்கு முன் வண்ணம் "
"தீட்டலாம்."

msgctxt "upgrades.minefield.name"
msgid "Minefield"
msgstr "கண்ணிவெடி"

msgctxt "upgrades.minefield.tooltip"
msgid "+{{percent}}% coins per bomb brick on screen"
msgstr "திரையில் ஒரு வெடிகுண்டு செங்கல் ஒன்றுக்கு +{{percent}}% நாணயங்கள்"

msgctxt "upgrades.minefield.verbose_description"
msgid "Bombs are counted while they are exploding too."
msgstr "வெடிக்கும் போது வெடிகுண்டுகள் எண்ணப்படுகின்றன."

msgctxt "upgrades.multiball.name"
msgid "Multi ball"
msgstr "பல பந்து"

msgctxt "upgrades.multiball.tooltip"
msgid "Start every levels with {{count}} balls."
msgstr "ஒவ்வொரு நிலைகளையும் {{count}} பந்துகளுடன் தொடங்கவும்."

msgctxt "upgrades.multiball.verbose_description"
msgid ""
"As soon as you drop the ball in Breakout 71, you lose. \n"
"\n"
"With this perk, you get two balls, and so you can afford to lose one. \n"
"\n"
"The lost balls come back on the next level. \n"
"\n"
"Having more than one balls makes some further perks available, and of course clears the level faster."
msgstr ""
"பிரேக்அவுட் 71 இல் நீங்கள் பந்தை வீழ்த்தியவுடன், நீங்கள் இழக்கிறீர்கள். \n"
"\n"
"இந்த பெர்க் மூலம், நீங்கள் இரண்டு பந்துகளைப் பெறுவீர்கள், எனவே நீங்கள் ஒன்றை இழக்கலாம். \n"
"\n"
"இழந்த பந்துகள் அடுத்த நிலைக்குத் திரும்பும். \n"
"\n"
"ஒன்றுக்கு மேற்பட்ட பந்துகளை வைத்திருப்பது மேலும் சில சலுகைகள் கிடைக்கச் செய்யும், மேலும் நிச்சயமாக நிலை வேகமாக அழிக்கப்படும்."

msgctxt "upgrades.nbricks.name"
msgid "Baby steps"
msgstr "குழந்தை படிகள்"

msgctxt "upgrades.nbricks.tooltip"
msgid "More coins if you clear the level slowly."
msgstr "நீங்கள் மெதுவாக நிலை அழித்துவிட்டால் மேலும் நாணயங்கள்."

msgctxt "upgrades.nbricks.verbose_description"
msgid ""
"+{{gain}} combo per brick broken. Combo resets if a ball breaks more than "
"{{max}} bricks between two paddle or wall bounce. Be careful, explosions "
"count."
msgstr ""
"உடைந்த செங்கல் ஒன்றுக்கு +{{gain}} சேர்க்கை. இரண்டு துடுப்பு அல்லது சுவர் "
"துள்ளலுக்கு இடையே ஒரு பந்து {{max}} செங்கற்களை விட அதிகமாக உடைந்தால் காம்போ "
"ரீசெட். கவனமாக இருங்கள், வெடிப்புகள் எண்ணிக்கை."

msgctxt "upgrades.one_more_choice.name"
msgid "Extra choice"
msgstr "கூடுதல் தேர்வு"

msgctxt "upgrades.one_more_choice.tooltip"
msgid "More upgrade choices"
msgstr "மேலும் மேம்படுத்தல் தேர்வுகள்"

msgctxt "upgrades.one_more_choice.verbose_description"
msgid ""
"Every upgrade menu will have one more option.  Doesn't increase the number "
"of upgrades you can pick."
msgstr ""
"ஒவ்வொரு மேம்படுத்தல் மெனுவிற்கும் மேலும் ஒரு விருப்பம் இருக்கும். நீங்கள் "
"தேர்ந்தெடுக்கும் மேம்படுத்தல்களின் எண்ணிக்கையை அதிகரிக்காது."

msgctxt "upgrades.ottawa_treaty.name"
msgid "Ottawa treaty"
msgstr "ஒட்டாவா நடத்துகிறார்"

msgctxt "upgrades.ottawa_treaty.tooltip"
msgid "Breaking a brick near a bomb disarms it"
msgstr "வெடிகுண்டுக்கு அருகில் செங்கலை உடைப்பது அதை நிராயுதபாணியாக்குகிறது"

msgctxt "upgrades.ottawa_treaty.verbose_description"
msgid ""
"The nearby bomb will be replaced by a colored block. If you have sapper, the"
" ball will loose its sapper effect until next bounce. Only one bomb can be "
"replaced at a time."
msgstr ""
"அருகில் உள்ள வெடிகுண்டுக்கு பதிலாக ஒரு வண்ணத் தடுப்பு அமைக்கப்படும். "
"உங்களிடம் சப்பர் இருந்தால், அடுத்த பவுன்ச் வரை பந்து அதன் சப்பர் விளைவை "
"இழக்கும். ஒரு நேரத்தில் ஒரு வெடிகுண்டை மட்டுமே மாற்ற முடியும்."

msgctxt "upgrades.paddle_up_combo.name"
msgid "Aura"
msgstr "ஆரா"

msgctxt "upgrades.paddle_up_combo.tooltip"
msgid "+1 per brick broken above the paddle , reset otherwise"
msgstr ""
"துடுப்புக்கு மேல் உடைந்த செங்கல் ஒன்றுக்கு +1, இல்லையெனில் மீட்டமைக்கவும்"

msgctxt "upgrades.paddle_up_combo.verbose_description"
msgid ""
msgstr "upgrades.paddle_up_combo.verbose_description"

msgctxt "upgrades.palette.name"
msgid "Palette"
msgstr "தட்டு"

msgctxt "upgrades.palette.tooltip"
msgid ""
"+1 combo per other brick color on screen, combo reset if there's just one "
"color"
msgstr ""
"திரையில் மற்ற செங்கல் நிறத்திற்கு +1 சேர்க்கை, ஒரே ஒரு வண்ணம் இருந்தால் "
"காம்போ ரீசெட்"

msgctxt "upgrades.palette.verbose_description"
msgid ""
"Be careful, some levels only have one color. The first and last brick hit "
"don't count."
msgstr ""
"கவனமாக இருங்கள், சில நிலைகளில் ஒரு வண்ணம் மட்டுமே இருக்கும். முதல் மற்றும் "
"கடைசி செங்கல் செய் கணக்கில் இல்லை."

msgctxt "upgrades.passive_income.name"
msgid "Passive income"
msgstr "செயலற்ற வருமானம்"

msgctxt "upgrades.passive_income.tooltip"
msgid "More coins but a moving paddle doesn't catch coins."
msgstr "அதிக நாணயங்கள் ஆனால் நகரும் துடுப்பு நாணயங்களைப் பிடிக்காது."

msgctxt "upgrades.passive_income.verbose_description"
msgid ""
"+{{lvl}} combo / brick broken, paddle is immaterial {{time}}s after moving. Some perks can help the balls do what you want without needing to do anything. \n"
"\n"
"The coins will pass trough the paddle at level 1, and the ball will also pass trough the immaterial paddle at level 2+."
msgstr ""
"+{{lvl}} சேர்க்கை / செங்கல் உடைந்துவிட்டது, துடுப்பு நகர்ந்த பிறகு {{time}} இன் பொருளற்றது. சில சலுகைகள் பந்துகள் எதையும் செய்யாமல் நீங்கள் விரும்பியதைச் செய்ய உதவும். \n"
"\n"
"நாணயங்கள் நிலை 1 இல் துடுப்பைக் கடந்து செல்லும், மேலும் பந்து நிலை 2+ இல் உள்ள பொருளற்ற துடுப்பைக் கடந்து செல்லும்."

msgctxt "upgrades.picky_eater.name"
msgid "Picky eater"
msgstr "விரும்பி உண்பவர்"

msgctxt "upgrades.picky_eater.tooltip"
msgid "More coins if you break bricks color by color"
msgstr "நீங்கள் செங்கற்களை வண்ணத்தால் உடைத்தால் அதிக நாணயங்கள்"

msgctxt "upgrades.picky_eater.verbose_description"
msgid ""
"Whenever you break a brick the same color as your ball, your combo increases by the number of colors on screen minus one. \n"
"If it's a different color, the ball takes that new color, but the combo resets, unless there were no bricks left of the ball's color. \n"
"Once you get a combo higher than your minimum, the bricks of the wrong color will get a red border. \n"
"If you have more than one ball, they all switch color whenever one of them hits a brick."
msgstr ""
"உங்கள் பந்தின் அதே நிறத்தில் ஒரு செங்கலை உடைக்கும்போதெல்லாம், உங்கள் கலவையானது திரையில் உள்ள வண்ணங்களின் எண்ணிக்கையை கழித்து ஒன்று அதிகரிக்கிறது. \n"
"அது வேறு நிறமாக இருந்தால், பந்து அந்தப் புதிய நிறத்தை எடுக்கும், ஆனால் பந்தின் நிறத்தில் செங்கற்கள் எஞ்சியிருக்காவிட்டால், காம்போ மீட்டமைக்கப்படும். \n"
"உங்கள் குறைந்தபட்சத்தை விட அதிகமான காம்போவைப் பெற்றவுடன், தவறான நிறத்தின் செங்கற்கள் சிவப்பு விளிம்பைப் பெறும். \n"
"உங்களிடம் ஒன்றுக்கு மேற்பட்ட பந்துகள் இருந்தால், அவற்றில் ஒன்று செங்கலைத் தாக்கும் போதெல்லாம் அவை அனைத்தும் நிறத்தை மாற்றும்."

msgctxt "upgrades.pierce.name"
msgid "Piercing"
msgstr "துளைத்தல்"

msgctxt "upgrades.pierce.tooltip"
msgid "Ball pierces {{count}} bricks after a paddle bounce"
msgstr ""
"ஒரு துடுப்பு துள்ளலுக்குப் பிறகு பந்து {{count}} செங்கற்களைத் துளைக்கிறது"

msgctxt "upgrades.pierce.verbose_description"
msgid ""
"The ball normally bounces as soon as it touches something. With this perk, it will continue its trajectory for up to 3 bricks broken. \n"
"\n"
"After that, it will bounce on the 4th brick, and you'll need to touch the paddle to reset the counter."
msgstr ""
"பந்து பொதுவாக எதையாவது தொட்டவுடன் குதிக்கும். இந்த பெர்க் மூலம், அது 3 செங்கற்கள் வரை உடைந்து அதன் பாதையைத் தொடரும். \n"
"\n"
"அதன் பிறகு, அது 4 வது செங்கலில் துள்ளும், மேலும் கவுண்டரை மீட்டமைக்க நீங்கள் துடுப்பைத் தொட வேண்டும்."

msgctxt "upgrades.pierce_above_paddle.name"
msgid "Opportunity window"
msgstr "வாய்ப்பு சாளரம்"

msgctxt "upgrades.pierce_above_paddle.tooltip"
msgid "Bricks break more easily when they are above the paddle."
msgstr "செங்கற்கள் துடுப்புக்கு மேலே இருக்கும்போது எளிதில் உடைந்துவிடும்."

msgctxt "upgrades.pierce_above_paddle.verbose_description"
msgid ""
msgstr "upgrades.pierce_above_paddle.verbose_description"

msgctxt "upgrades.pierce_color.name"
msgid "Color pierce"
msgstr "வண்ண துளை"

msgctxt "upgrades.pierce_color.tooltip"
msgid "The ball goes through bricks of the same color"
msgstr "பந்து அதே நிறத்தின் செங்கற்கள் வழியாக செல்கிறது"

msgctxt "upgrades.pierce_color.verbose_description"
msgid ""
"The ball goes through bricks of the same color unimpeded until its "
"\"charge\" is exhausted. It then needs to bounce on the paddle to recharge."
msgstr ""
"பந்து அதன் \"சார்ச்\" தீரும் வரை அதே நிறத்தின் செங்கற்கள் மூலம் தடையின்றி "
"செல்கிறது. அது பின்னர் ரீசார்ச் செய்ய துடுப்பில் குதிக்க வேண்டும்."

msgctxt "upgrades.pierce_left.name"
msgid "Pierce left"
msgstr "பியர்ச் வெளியேறினார்"

msgctxt "upgrades.pierce_left.tooltip"
msgid "Bricks break more easily when hit from the left"
msgstr "செங்கற்கள் இடமிருந்து அடித்தால் எளிதில் உடைந்துவிடும்"

msgctxt "upgrades.pierce_left.verbose_description"
msgid ""
"This upgrade impacts the starting direction of the ball. The ball will "
"accelerate when the effect is triggered."
msgstr ""
"இந்த மேம்படுத்தல் பந்தின் தொடக்க திசையை பாதிக்கிறது. விளைவு தூண்டப்படும்போது"
" பந்து வேகமடையும்."

msgctxt "upgrades.pierce_right.name"
msgid "Pierce right"
msgstr "சரியாக துளைக்கவும்"

msgctxt "upgrades.pierce_right.tooltip"
msgid "Bricks break more easily when hit from the right"
msgstr "செங்கற்கள் வலப்புறம் அடித்தால் எளிதில் உடைந்துவிடும்"

msgctxt "upgrades.pierce_right.verbose_description"
msgid ""
"This upgrade impacts the starting direction of the ball.The ball will "
"accelerate when the effect is triggered."
msgstr ""
"இந்த மேம்படுத்தல் பந்தின் தொடக்க திசையை பாதிக்கிறது. விளைவு தூண்டப்படும் "
"போது பந்து வேகமடையும்."

msgctxt "upgrades.pierce_top.name"
msgid "Pierce top"
msgstr "பியர்ச் மேல்"

msgctxt "upgrades.pierce_top.tooltip"
msgid "Bricks break more easily when hit from the top"
msgstr "மேலிருந்து அடிக்கும்போது செங்கற்கள் எளிதில் உடையும்"

msgctxt "upgrades.pierce_top.verbose_description"
msgid "The ball will accelerate when the effect is triggered."
msgstr "விளைவு தூண்டப்படும்போது பந்து வேகமடையும்."

msgctxt "upgrades.puck_repulse_ball.name"
msgid "Soft landing"
msgstr "மென்மையான தரையிறக்கம்"

msgctxt "upgrades.puck_repulse_ball.tooltip"
msgid "Paddle repulses balls"
msgstr "துடுப்பு பந்துகளை விரட்டுகிறது"

msgctxt "upgrades.puck_repulse_ball.verbose_description"
msgid ""
"When a ball gets close to the paddle, it will start slowing down, and even "
"potentially bouncing without touching the paddle."
msgstr ""
"ஒரு பந்து துடுப்புக்கு அருகில் வரும்போது, ​​அது மெதுவாகத் தொடங்கும், மேலும் "
"துடுப்பைத் தொடாமலேயே துள்ளும்."

msgctxt "upgrades.rainbow.name"
msgid "Rainbow"
msgstr "வானவில்"

msgctxt "upgrades.rainbow.tooltip"
msgid "Coins spawn with rainbow color."
msgstr "வானவில் நிறத்துடன் நாணயங்கள் உருவாகின்றன."

msgctxt "upgrades.rainbow.verbose_description"
msgid ""
"Each level increases the proportion of colored coins. The color depends on "
"level time."
msgstr ""
"ஒவ்வொரு மட்டமும் வண்ண நாணயங்களின் விகிதத்தை அதிகரிக்கிறது. நிறம் நிலை "
"நேரத்தைப் பொறுத்தது."

msgctxt "upgrades.reach.name"
msgid "Top down"
msgstr "மேலிருந்து கீழே"

msgctxt "upgrades.reach.tooltip"
msgid "More coins if you avoid the lowest row of bricks"
msgstr "செங்கற்களின் குறைந்த வரிசையைத் தவிர்த்தால் அதிக நாணயங்கள்"

msgctxt "upgrades.reach.verbose_description"
msgid ""
"Touching the N bricks of the lowest row resets the combo. Otherwise, +N combo.\n"
"\n"
"If there is only one row of bricks, or if the lowest row of bricks cover the whole width of the game,  then this perk does nothing. Otherwise, breaking this lowest row resets the combo, while breaking anything else increases the combo by the number of bricks present on that lowest row. \n"
"\n"
"The lowest row will be highlighted in red."
msgstr ""
"மிகக் குறைந்த வரிசையின் N செங்கற்களைத் தொடுவது காம்போவை மீட்டமைக்கிறது. இல்லையெனில், +N சேர்க்கை. \n"
"\n"
"ஒரே ஒரு வரிசை செங்கற்கள் இருந்தால், அல்லது குறைந்த வரிசை செங்கற்கள் விளையாட்டின் முழு அகலத்தையும் உள்ளடக்கியிருந்தால், இந்த பெர்க் எதுவும் செய்யாது. இல்லையெனில், இந்த மிகக் குறைந்த வரிசையை உடைப்பது காம்போவை மீட்டமைக்கிறது, அதே சமயம் வேறு எதையும் உடைப்பது அந்த குறைந்த வரிசையில் இருக்கும் செங்கற்களின் எண்ணிக்கையால் சேர்க்கையை அதிகரிக்கிறது. \n"
"\n"
"குறைந்த வரிசை சிவப்பு நிறத்தில் முன்னிலைப்படுத்தப்படும்."

msgctxt "upgrades.refill.name"
msgid "Refill"
msgstr "மீண்டும் நிரப்பவும்"

msgctxt "upgrades.refill.tooltip"
msgid ""
"Hitting any side or teleporting the ball resets the pierce counter of the "
"ball"
msgstr ""
"எந்தப் பக்கத்திலும் அடிப்பது அல்லது பந்தை டெலிபோர்ட் செய்வது பந்தின் பியர்ச்"
" கவுண்டரை மீட்டமைக்கிறது"

msgctxt "upgrades.refill.verbose_description"
msgid "Also gives +1 pierce."
msgstr "மேலும் +1 பியர்ச் கொடுக்கிறது."

msgctxt "upgrades.respawn.name"
msgid "Re-spawn"
msgstr "மீண்டும் முட்டையிடும்"

msgctxt "upgrades.respawn.tooltip"
msgid "{{percent}}% of bricks re-spawn after {{delay}}s."
msgstr ""
"{{percent}}% செங்கற்கள் {{delay}} வினாடிகளுக்குப் பிறகு மீண்டும் முளைக்கும்."

msgctxt "upgrades.respawn.verbose_description"
msgid "Some particle effect will let you know where bricks will appear."
msgstr ""
"சில துகள் விளைவு செங்கற்கள் எங்கு தோன்றும் என்பதை உங்களுக்குத் தெரிவிக்கும்."

msgctxt "upgrades.right_is_lava.name"
msgid "Avoid right side"
msgstr "வலது பக்கத்தைத் தவிர்க்கவும்"

msgctxt "upgrades.right_is_lava.tooltip"
msgid "More coins if you don't touch the right side"
msgstr "நீங்கள் வலது பக்கத்தைத் தொடவில்லை என்றால் அதிக நாணயங்கள்"

msgctxt "upgrades.right_is_lava.verbose_description"
msgid ""
"Whenever you break a brick, your combo will increase by one, so you'll get one more coin from all the next bricks you break. \n"
"\n"
"However, your combo will reset as soon as your ball hits the right side. \n"
"\n"
"As soon as your combo rises, the right side becomes red to remind you that you should avoid hitting them.\n"
"\n"
"At level 2, the border is completely removed and your balls and coins might get lost.\n"
"\n"
"This upgrade impacts the starting direction of the ball."
msgstr ""
"நீங்கள் ஒரு செங்கலை உடைக்கும் போதெல்லாம், உங்கள் சேர்க்கை ஒன்று அதிகரிக்கும், எனவே நீங்கள் உடைக்கும் அனைத்து அடுத்த செங்கற்களிலிருந்தும் மேலும் ஒரு நாணயத்தைப் பெறுவீர்கள். \n"
"\n"
"இருப்பினும், உங்கள் பந்து வலது பக்கத்தைத் தாக்கியவுடன் உங்கள் காம்போ மீட்டமைக்கப்படும். \n"
"\n"
"உங்கள் காம்போ உயர்ந்தவுடன், அவற்றைத் தாக்குவதைத் தவிர்க்க வேண்டும் என்பதை உங்களுக்கு நினைவூட்ட வலது பக்கம் சிவப்பு நிறமாக மாறும். \n"
"\n"
"நிலை 2 இல், எல்லை முற்றிலும் அகற்றப்பட்டு, உங்கள் பந்துகளும் நாணயங்களும் தொலைந்து போகக்கூடும். \n"
"\n"
"இந்த மேம்படுத்தல் பந்தின் தொடக்க திசையை பாதிக்கிறது."

msgctxt "upgrades.round_bricks.name"
msgid "Round bricks"
msgstr "வட்ட செங்கற்கள்"

msgctxt "upgrades.round_bricks.tooltip"
msgid "Bricks are round now"
msgstr "செங்கற்கள் இப்போது வட்டமாக உள்ளன"

msgctxt "upgrades.round_bricks.verbose_description"
msgid ""
msgstr "upgrades.round_bricks.verbose_description"

msgctxt "upgrades.sacrifice.name"
msgid "Sacrifice"
msgstr "கொடை"

msgctxt "upgrades.sacrifice.tooltip"
msgid "Loosing a life increases the combo by {{gain}}."
msgstr "ஒரு வாழ்க்கையை இழப்பது {{gain}} மூலம் சேர்க்கையை அதிகரிக்கிறது."

msgctxt "upgrades.sacrifice.verbose_description"
msgid ""
msgstr "upgrades.sacrifice.verbose_description"

msgctxt "upgrades.sapper.name"
msgid "Sapper"
msgstr "சப்பர்"

msgctxt "upgrades.sapper.tooltip"
msgid "The first brick broken becomes a bomb."
msgstr "முதலில் உடைந்த செங்கல் வெடிகுண்டாக மாறுகிறது."

msgctxt "upgrades.sapper.verbose_description"
msgid ""
"Instead of just disappearing, the first brick you break will be replaced by "
"a bomb brick. Bouncing the ball on the paddle re-arms the effect. Leveling-"
"up this perk will allow you to place more bombs."
msgstr ""
"நீங்கள் உடைக்கும் முதல் செங்கல்லுக்குப் பதிலாக வெடிகுண்டு செங்கற்கள் மட்டும்"
" மறைந்துவிடாமல் இருக்கும். துடுப்பில் பந்தைத் துள்ளுவது விளைவை மீண்டும் "
"ஆயுதமாக்குகிறது. இந்தச் சலுகையை லெவலிங்-அப் செய்வது அதிக குண்டுகளை வைக்க "
"உங்களை அனுமதிக்கும்."

msgctxt "upgrades.shocks.name"
msgid "Shocks"
msgstr "அதிர்ச்சிகள்"

msgctxt "upgrades.shocks.tooltip"
msgid "Explosive balls collisions"
msgstr "வெடிக்கும் பந்துகள் மோதல்கள்"

msgctxt "upgrades.shocks.verbose_description"
msgid ""
"Whenever two balls collide, they exchange their speed, spawn an explosion, "
"and gain added speed to separate them."
msgstr ""
"இரண்டு பந்துகள் மோதிக்கொள்ளும் போதெல்லாம், அவை அவற்றின் வேகத்தை மாற்றி, ஒரு "
"வெடிப்பை உருவாக்கி, அவற்றைப் பிரிக்க கூடுதல் வேகத்தைப் பெறுகின்றன."

msgctxt "upgrades.shunt.name"
msgid "Shunt"
msgstr "சண்ட்"

msgctxt "upgrades.shunt.tooltip"
msgid "Keep {{percent}}% of your combo between levels"
msgstr "உங்கள் காம்போவில் {{percent}}% நிலைகளுக்கு இடையில் வைக்கவும்"

msgctxt "upgrades.shunt.verbose_description"
msgid ""
"If you also have hot start, the hot start is just added to the current combo"
msgstr ""
"உங்களிடம் ஆட் ச்டார்ட் இருந்தால், தற்போதைய காம்போவில் ஆட் ச்டார்ட் "
"சேர்க்கப்படும்"

msgctxt "upgrades.side_flip.name"
msgid "Right handed"
msgstr "வலது கை"

msgctxt "upgrades.side_flip.tooltip"
msgid ""
"+1 combo per brick broken. Combo reset if you hit any brick's left side."
msgstr ""
"உடைந்த செங்கல் ஒன்றுக்கு +1 சேர்க்கை. நீங்கள் எந்த செங்கலின் இடது பக்கம் "
"அடித்தாலும் காம்போ ரீசெட்."

msgctxt "upgrades.side_flip.verbose_description"
msgid ""
"Explosions and bounces that didn't break the brick don't count for the combo"
" reset. This upgrade impacts the starting direction of the ball."
msgstr ""
"செங்கலை உடைக்காத வெடிப்புகள் மற்றும் பவுன்ச்கள் காம்போ ரீசெட் கணக்கில் "
"இல்லை. இந்த மேம்படுத்தல் பந்தின் தொடக்க திசையை பாதிக்கிறது."

msgctxt "upgrades.side_kick.name"
msgid "Left handed"
msgstr "இடது கை"

msgctxt "upgrades.side_kick.tooltip"
msgid ""
"+1 combo per brick broken. Combo reset if you break a brick from the right "
"side."
msgstr ""
"உடைந்த செங்கல் ஒன்றுக்கு +1 சேர்க்கை. நீங்கள் வலது பக்கத்திலிருந்து ஒரு "
"செங்கலை உடைத்தால் காம்போ ரீசெட்."

msgctxt "upgrades.side_kick.verbose_description"
msgid ""
"Explosions and bounces that didn't break the brick don't count for the combo"
" reset. This upgrade impacts the starting direction of the ball."
msgstr ""
"செங்கலை உடைக்காத வெடிப்புகள் மற்றும் பவுன்ச்கள் காம்போ ரீசெட் கணக்கில் "
"இல்லை. இந்த மேம்படுத்தல் பந்தின் தொடக்க திசையை பாதிக்கிறது."

msgctxt "upgrades.skip_last.name"
msgid "Easy Cleanup"
msgstr "எளிதான தூய்மை"

msgctxt "upgrades.skip_last.tooltip"
msgid "The last brick will self destruct"
msgstr "கடைசி செங்கல் தன்னைத்தானே அழித்துவிடும்"

msgctxt "upgrades.skip_last.verbose_description"
msgid ""
"You need to break all bricks to go to the next level. However, it can be hard to get the last ones. \n"
"Each level of this perk increases the number of bricks that will self destruct.\n"
"Clearing a level early brings extra choices when upgrading. Never missing the bricks is also very beneficial. \n"
"\n"
"So if you find it difficult to break the last bricks, getting this perk a few time can help."
msgstr ""
"அடுத்த நிலைக்குச் செல்ல நீங்கள் அனைத்து செங்கற்களையும் உடைக்க வேண்டும். இருப்பினும், கடைசியாகப் பெறுவது கடினமாக இருக்கும். \n"
"இந்த பெர்க்கின் ஒவ்வொரு நிலையும் தன்னைத்தானே அழித்துக்கொள்ளும் செங்கற்களின் எண்ணிக்கையை அதிகரிக்கிறது. \n"
"ஒரு நிலையை முன்கூட்டியே அழிப்பது மேம்படுத்தும் போது கூடுதல் தேர்வுகளைக் கொண்டுவருகிறது. செங்கற்களை ஒருபோதும் தவறவிடாமல் இருப்பதும் மிகவும் நன்மை பயக்கும். \n"
"\n"
"எனவே கடைசி செங்கற்களை உடைப்பது உங்களுக்கு கடினமாக இருந்தால், இந்த சலுகையை சிறிது நேரம் பெறுவது உதவியாக இருக்கும்."

msgctxt "upgrades.slow_down.name"
msgid "Slower ball"
msgstr "மெதுவான பந்து"

msgctxt "upgrades.slow_down.tooltip"
msgid "Ball moves more slowly"
msgstr "பந்து மெதுவாக நகர்கிறது"

msgctxt "upgrades.slow_down.verbose_description"
msgid ""
"The ball starts relatively slow, but every level of your game it will start a bit faster. \n"
"\n"
"It will also accelerate if you spend a lot of time in one level. \n"
"\n"
"This perk makes it more manageable. \n"
"\n"
"You can get it at the start every time by enabling kid mode in the menu."
msgstr ""
"பந்து ஒப்பீட்டளவில் மெதுவாகத் தொடங்குகிறது, ஆனால் உங்கள் விளையாட்டின் ஒவ்வொரு நிலையும் சற்று வேகமாகத் தொடங்கும். \n"
"\n"
"நீங்கள் ஒரு மட்டத்தில் அதிக நேரம் செலவிட்டால் அது துரிதப்படுத்தப்படும். \n"
"\n"
"இந்தச் சலுகை அதை மேலும் நிர்வகிக்கக்கூடியதாக ஆக்குகிறது. \n"
"\n"
"மெனுவில் அறிவிலி பயன்முறையை இயக்குவதன் மூலம் ஒவ்வொரு முறையும் தொடக்கத்தில் அதைப் பெறலாம்."

msgctxt "upgrades.smaller_puck.name"
msgid "Smaller paddle"
msgstr "சிறிய துடுப்பு"

msgctxt "upgrades.smaller_puck.tooltip"
msgid "{{percent}}% faster combo rise"
msgstr "{{percent}}% வேகமான சேர்க்கை உயர்வு"

msgctxt "upgrades.smaller_puck.verbose_description"
msgid ""
"This makes the paddle smaller, which in theory makes some corner shots easier, but really just raises the difficulty.\n"
"\n"
"That's why you also get a nice bonus of +50% coins spawn."
msgstr ""
"இது துடுப்பை சிறியதாக ஆக்குகிறது, இது கோட்பாட்டில் சில கார்னர் சாட்களை எளிதாக்குகிறது, ஆனால் உண்மையில் சிரமத்தை எழுப்புகிறது. \n"
"\n"
"அதனால்தான் நீங்கள் +50% நாணயங்களின் நல்ல போனசையும் பெறுவீர்கள்."

msgctxt "upgrades.soft_brush.name"
msgid "Soft brush"
msgstr "மென்மையான தூரிகை"

msgctxt "upgrades.soft_brush.tooltip"
msgid ""
"When hitting a brick of a different color, the ball colors the brick instead"
" of breaking it."
msgstr ""
"வேறு நிறத்தில் உள்ள செங்கலை அடிக்கும் போது, ​​பந்து அதை உடைப்பதற்குப் பதிலாக"
" செங்கலுக்கு வண்ணம் கொடுக்கும்."

msgctxt "upgrades.soft_brush.verbose_description"
msgid ""
"This does nothing if the brick is destroyed by an explosion. The effect only"
" happens once per paddle bounce per level of the perk."
msgstr ""
"ஒரு வெடிப்பால் செங்கல் அழிக்கப்பட்டால் இது எதுவும் செய்யாது. பெர்க்கின் "
"நிலைக்கு ஒரு துடுப்பு துள்ளலுக்கு ஒரு முறை மட்டுமே விளைவு ஏற்படும்."

msgctxt "upgrades.soft_reset.name"
msgid "Soft reset"
msgstr "மென்மையான மீட்டமைப்பு"

msgctxt "upgrades.soft_reset.tooltip"
msgid "Keep {{percent}}% of your combo when it resets"
msgstr "உங்கள் காம்போவை மீட்டமைக்கும்போது அதில் {{percent}}% வைத்திருக்கவும்"

msgctxt "upgrades.soft_reset.verbose_description"
msgid "Limit the impact of a combo reset."
msgstr "காம்போ மீட்டமைப்பின் தாக்கத்தை வரம்பிடவும்."

msgctxt "upgrades.soft_touch.name"
msgid "Soft touch"
msgstr "மென்மையான தொடுதல்"

msgctxt "upgrades.soft_touch.tooltip"
msgid "The ball bounces on bricks harmlessly when not above the paddle."
msgstr ""
"துடுப்புக்கு மேலே இல்லாத போது பந்து செங்கற்களில் பாதிப்பில்லாமல் "
"குதிக்கிறது."

msgctxt "upgrades.soft_touch.verbose_description"
msgid ""
msgstr "upgrades.soft_touch.verbose_description"

msgctxt "upgrades.steering.name"
msgid "Steering"
msgstr "சக்கரத்திருப்பி"

msgctxt "upgrades.steering.tooltip"
msgid "Balls turn when the paddle moves"
msgstr "துடுப்பு நகரும் போது பந்துகள் மாறும்"

msgctxt "upgrades.steering.verbose_description"
msgid ""
"The change of paddle location directly influences the direction of the "
"balls's movement. At level 2+, you get a line showing you ball's directions."
msgstr ""
"துடுப்பு இடத்தின் மாற்றம் பந்துகளின் இயக்கத்தின் திசையை நேரடியாக "
"பாதிக்கிறது. நிலை 2+ இல், பந்தின் திசைகளைக் காட்டும் ஒரு வரியைப் "
"பெறுவீர்கள்."

msgctxt "upgrades.sticky_coins.name"
msgid "Sticky coins"
msgstr "ஒட்டும் நாணயங்கள்"

msgctxt "upgrades.sticky_coins.tooltip"
msgid "Coins stick to bricks of the same color"
msgstr "நாணயங்கள் அதே நிறத்தின் செங்கற்களில் ஒட்டிக்கொள்கின்றன"

msgctxt "upgrades.sticky_coins.verbose_description"
msgid "At level 2, they stick to bricks of any color"
msgstr "நிலை 2 இல், அவை எந்த நிறத்தின் செங்கற்களிலும் ஒட்டிக்கொள்கின்றன"

msgctxt "upgrades.streak_shots.name"
msgid "Hit streak"
msgstr "இட் ச்ட்ரீக்"

msgctxt "upgrades.streak_shots.tooltip"
msgid "More coins if you break many bricks at once"
msgstr "ஒரே நேரத்தில் பல செங்கற்களை உடைத்தால் அதிக நாணயங்கள்"

msgctxt "upgrades.streak_shots.verbose_description"
msgid ""
"Every time you break a brick, your combo increases by one. \n"
"\n"
"However, as soon as the ball touches your paddle, the combo is reset to its default value.\n"
"\n"
"Once your combo rises above the base value, your paddle will have a red border to remind you that it will destroy your combo to touch it with the ball."
msgstr ""
"ஒவ்வொரு முறையும் நீங்கள் ஒரு செங்கலை உடைக்கும்போது, ​​உங்கள் சேர்க்கை ஒன்று அதிகரிக்கிறது. \n"
"\n"
"இருப்பினும், பந்து உங்கள் துடுப்பைத் தொட்டவுடன், காம்போ அதன் இயல்புநிலை மதிப்பிற்கு மீட்டமைக்கப்படும். \n"
"\n"
"உங்கள் காம்போ அடிப்படை மதிப்பை விட உயர்ந்தவுடன், உங்கள் துடுப்பு பந்தைக் கொண்டு தொடுவதற்கு உங்கள் காம்போவை அழித்துவிடும் என்பதை உங்களுக்கு நினைவூட்டும் வகையில் சிவப்பு நிற பார்டர் இருக்கும்."

msgctxt "upgrades.sturdy_bricks.name"
msgid "Sturdy bricks"
msgstr "உறுதியான செங்கற்கள்"

msgctxt "upgrades.sturdy_bricks.tooltip"
msgid "+{{lvl}} bricks HP, {{percent}}% faster combo rise"
msgstr "+{{lvl}} செங்கல்கள் எச்பி, {{percent}}% வேகமான சேர்க்கை உயர்வு"

msgctxt "upgrades.sturdy_bricks.verbose_description"
msgid ""
"Each level of this perk adds one HP to all bricks. You can see the HP number"
" with the \"clairvoyant\" perk. You can increase ball damage by getting the "
"\"piercing\" perk. Each level of the perk makes the combo rise 50% faster."
msgstr ""
"இந்த பெர்க்கின் ஒவ்வொரு நிலையும் அனைத்து செங்கற்களுக்கும் ஒரு எச்பி "
"சேர்க்கிறது. எச்பி எண்ணை \"தெளிவான\" பெர்க் மூலம் பார்க்கலாம். "
"\"துளையிடும்\" பெர்க்கைப் பெறுவதன் மூலம் பந்து சேதத்தை அதிகரிக்கலாம். "
"பெர்க்கின் ஒவ்வொரு நிலையும் காம்போவை 50% வேகமாக உயர்த்துகிறது."

msgctxt "upgrades.superhot.name"
msgid "SUPER HOT"
msgstr "சூப்பர் ஆட்"

msgctxt "upgrades.superhot.tooltip"
msgid "Time moves when the paddle moves."
msgstr "துடுப்பு நகரும் போது நேரம் நகர்கிறது."

msgctxt "upgrades.superhot.verbose_description"
msgid "SUPER HOT SUPER HOT SUPER HOT SUPER HOT"
msgstr "சூப்பர் ஆட் சூப்பர் ஆட் சூப்பர் ஆட் சூப்பர் ஆட்"

msgctxt "upgrades.telekinesis.name"
msgid "Telekinesis"
msgstr "டெலிகினேசிச்"

msgctxt "upgrades.telekinesis.tooltip"
msgid "The paddle position influences the ball"
msgstr "துடுப்பு நிலை பந்தைப் பாதிக்கிறது"

msgctxt "upgrades.telekinesis.verbose_description"
msgid ""
"You control the ball while it's going up. The effect is stronger when the "
"ball is in the bottom half of the screen."
msgstr ""
"பந்து மேலே செல்லும் போது அதை நீங்கள் கட்டுப்படுத்துகிறீர்கள். பந்து திரையின்"
" கீழ் பாதியில் இருக்கும்போது விளைவு வலுவாக இருக்கும்."

msgctxt "upgrades.thomas.name"
msgid "Thomas the Apostle"
msgstr "தாமச் அப்போச்தலன்"

msgctxt "upgrades.thomas.tooltip"
msgid "Half of the bricks resurrect when a ball is lost."
msgstr "ஒரு பந்து தொலைந்தால் பாதி செங்கற்கள் உயிர்த்தெழுகின்றன."

msgctxt "upgrades.thomas.verbose_description"
msgid ""
"The name of the perk is a double reference, as Thomas the Apostle is the "
"patron saint of the architects, and is said to have doubted the Christ's "
"resurrection. Pretty fitting for a ball sacrifice that lays down more "
"bricks."
msgstr ""
"பெர்க்கின் பெயர் இரட்டைக் குறிப்பு, ஏனெனில் தாமச் தி அப்போச்தலன் கட்டிடக் "
"கலைஞர்களின் புரவலர் துறவி, மேலும் கிறிச்துவின் உயிர்த்தெழுதலை "
"சந்தேகித்ததாகக் கூறப்படுகிறது. அதிக செங்கற்களைக் கீழே போடும் பந்து "
"தியாகத்திற்கு மிகவும் பொருத்தமானது."

msgctxt "upgrades.three_cushion.name"
msgid "Three cushion"
msgstr "மூன்று குசன்"

msgctxt "upgrades.three_cushion.tooltip"
msgid "More coins if you hit bricks only indirectly"
msgstr "நீங்கள் செங்கற்களை மறைமுகமாக அடித்தால் அதிக நாணயங்கள்"

msgctxt "upgrades.three_cushion.verbose_description"
msgid ""
"+1 combo per brick per side bounce that the ball did before hitting that "
"brick. Limited to +{{max}} combo per brick. The combo resets if you break a "
"brick without first bouncing on a side."
msgstr ""
"அந்தச் செங்கலைத் தாக்கும் முன் பந்து செய்த பவுன்ச் ஒரு பக்கத்துக்கு ஒரு "
"செங்கல்லுக்கு +1 சேர்க்கை. ஒரு செங்கல்லுக்கு +{{max}} சேர்க்கைக்கு "
"வரம்பிடப்பட்டுள்ளது. முதலில் ஒரு பக்கத்தில் குதிக்காமல் செங்கல்லை உடைத்தால் "
"காம்போ மீட்டமைக்கப்படும்."

msgctxt "upgrades.top_is_lava.name"
msgid "Sky is the limit"
msgstr "வானமே எல்லை"

msgctxt "upgrades.top_is_lava.tooltip"
msgid "More coins if you avoid hitting the top"
msgstr "நீங்கள் மேலே அடிப்பதைத் தவிர்த்தால் அதிக நாணயங்கள்"

msgctxt "upgrades.top_is_lava.verbose_description"
msgid ""
"Whenever you break a brick, your combo will increase by one. However, your combo will reset as soon as your ball hit the top of the screen. \n"
"\n"
"When your combo is above the minimum,  a red bar will appear at the top to remind you that you should avoid hitting it. \n"
"\n"
"At level 2, the border is completely removed and your balls and coins might get lost."
msgstr ""
"நீங்கள் ஒரு செங்கலை உடைக்கும் போதெல்லாம், உங்கள் சேர்க்கை ஒன்று அதிகரிக்கும். இருப்பினும், உங்கள் பந்து திரையின் மேல் பட்டவுடன் உங்கள் காம்போ மீட்டமைக்கப்படும். \n"
"\n"
"உங்கள் காம்போ குறைந்தபட்சத்திற்கு மேல் இருக்கும்போது, ​​​​அதைத் தாக்குவதைத் தவிர்க்க வேண்டும் என்பதை உங்களுக்கு நினைவூட்டுவதற்கு மேலே ஒரு சிவப்பு பட்டி தோன்றும். \n"
"\n"
"நிலை 2 இல், எல்லை முற்றிலும் அகற்றப்பட்டு, உங்கள் பந்துகளும் நாணயங்களும் தொலைந்து போகக்கூடும்."

msgctxt "upgrades.trampoline.name"
msgid "Trampoline"
msgstr "டிராம்போலைன்"

msgctxt "upgrades.trampoline.tooltip"
msgid "More coins if you bounce on bricks and the paddle only"
msgstr ""
"நீங்கள் செங்கற்கள் மற்றும் துடுப்பில் மட்டும் குதித்தால் அதிக நாணயங்கள்"

msgctxt "upgrades.trampoline.verbose_description"
msgid ""
"+{{lvl}} combo per paddle bounce,-{{lvl}} combo per bounce on any border.  "
"One of the rare  combo upgrades that don't add a reset condition"
msgstr ""
"+{{lvl}} ஒரு துடுப்பு துள்ளல்,-{{lvl}} சேர்க்கை எந்த எல்லையிலும். "
"மீட்டமைப்பு நிலையைச் சேர்க்காத அரிய சேர்க்கை மேம்படுத்தல்களில் ஒன்று"

msgctxt "upgrades.transparency.name"
msgid "Transparency"
msgstr "வெளிப்படைத்தன்மை"

msgctxt "upgrades.transparency.tooltip"
msgid ""
"The ball is invisible at the top of the screen. {{percent}}% faster combo "
"rise"
msgstr ""
"பந்து திரையின் மேற்புறத்தில் கண்ணுக்கு தெரியாதது. {{percent}}% வேகமான "
"சேர்க்கை உயர்வு"

msgctxt "upgrades.transparency.verbose_description"
msgid ""
"Ball  becomes transparent at the top of the screen.\n"
" +{{percent}} % coins.  \n"
"Higher levels make the ball transparent sooner and increase the point bonus."
msgstr ""
"திரையின் மேற்புறத்தில் பந்து வெளிப்படையானதாகிறது. \n"
"+{{percent}} % நாணயங்கள். \n"
"உயர் நிலைகள் பந்தை விரைவில் வெளிப்படையாக்கி புள்ளி போனசை அதிகரிக்கும்."

msgctxt "upgrades.trickledown.name"
msgid "Trickle down"
msgstr "கீழே ட்ரிக்கிள்"

msgctxt "upgrades.trickledown.tooltip"
msgid "Coins appear at the top of the screen."
msgstr "திரையின் மேற்புறத்தில் நாணயங்கள் தோன்றும்."

msgctxt "upgrades.trickledown.verbose_description"
msgid ""
"The coins might sit on top of a brick if there are bricks on the top row, in"
" that case they will fall down after you break that brick."
msgstr ""
"மேல் வரிசையில் செங்கற்கள் இருந்தால் நாணயங்கள் செங்கலின் மேல் உட்காரலாம், "
"அப்படியானால் அந்தச் செங்கலை உடைத்த பிறகு அவை கீழே விழும்."

msgctxt "upgrades.unbounded.name"
msgid "Padding"
msgstr "திணிப்பு"

msgctxt "upgrades.unbounded.tooltip"
msgid ""
"Adds space left and right of the level, but your paddle can't go that far."
msgstr ""
"லெவலின் இடப்புறமும் வலதுபுறமும் இடத்தைச் சேர்க்கிறது, ஆனால் உங்கள் "
"துடுப்பால் அவ்வளவு தூரம் செல்ல முடியாது."

msgctxt "upgrades.unbounded.verbose_description"
msgid "Another upgrade might help you extends the reach of your paddle."
msgstr "மற்றொரு மேம்படுத்தல் உங்கள் துடுப்பை நீட்டிக்க உதவும்."

msgctxt "upgrades.varied_diet.name"
msgid "Varied diet"
msgstr "மாறுபட்ட உணவுமுறை"

msgctxt "upgrades.varied_diet.tooltip"
msgid ""
"+ {{plus}} combo per broken brick if the brick is a different color than the"
" ball, - {{minus}} otherwise"
msgstr ""
"உடைந்த செங்கல் ஒன்றுக்கு + {{plus}} சேர்க்கை, பந்தைக் காட்டிலும் செங்கல் "
"வேறு நிறமாக இருந்தால், - {{minus}} இல்லையெனில்"

msgctxt "upgrades.varied_diet.verbose_description"
msgid "This perk does not add a reset condition."
msgstr "இந்தச் சலுகை மீட்டமைப்பு நிலையைச் சேர்க்காது."

msgctxt "upgrades.vibrant_neighborhood.name"
msgid "Vibrant neighborhood"
msgstr "துடிப்பான அக்கம்"

msgctxt "upgrades.vibrant_neighborhood.tooltip"
msgid "More coins when bricks are near bricks of a different color."
msgstr ""
"செங்கற்கள் வேறு நிறத்தின் செங்கற்களுக்கு அருகில் இருக்கும்போது அதிக "
"நாணயங்கள்."

msgctxt "upgrades.vibrant_neighborhood.verbose_description"
msgid ""
"When a brick is broken, the combo climbs by the number of bricks of a color "
"different in the 3x3 box around the destroyed brick. If there are only "
"bricks of the same color nearby, and the level has more than one color, the "
"combo reset. Bricks without neighbors don't affect the combo when broken."
msgstr ""
"ஒரு செங்கல் உடைந்தால், அழிக்கப்பட்ட செங்கலைச் சுற்றியுள்ள 3x3 பெட்டியில் "
"வெவ்வேறு வண்ணங்களின் செங்கற்களின் எண்ணிக்கையால் காம்போ ஏறுகிறது. அருகில் ஒரே"
" நிறத்தின் செங்கற்கள் மட்டுமே இருந்தால், நிலை ஒன்றுக்கு மேற்பட்ட வண்ணங்களைக்"
" கொண்டிருந்தால், காம்போ ரீசெட். அக்கம் பக்கத்தினர் இல்லாத செங்கற்கள் "
"உடைந்தால் கலவையை பாதிக்காது."

msgctxt "upgrades.viscosity.name"
msgid "Viscosity"
msgstr "பாகுத்தன்மை"

msgctxt "upgrades.viscosity.tooltip"
msgid "Slower coin fall"
msgstr "மெதுவான நாணய வீழ்ச்சி"

msgctxt "upgrades.viscosity.verbose_description"
msgid ""
"Coins normally accelerate with gravity and explosions to pretty high speeds. \n"
"\n"
"This perk constantly makes them slow down, as if they were in some sort of viscous liquid. \n"
"\n"
"This makes catching them easier, and combines nicely with perks that influence the coin's movement."
msgstr ""
"நாணயங்கள் பொதுவாக ஈர்ப்பு விசை மற்றும் வெடிப்புகள் மூலம் அதிக வேகத்தில் முடுக்கி விடுகின்றன. \n"
"\n"
"இந்த பெர்க், ஒருவித பிசுபிசுப்பான திரவத்தில் இருப்பதைப் போல, தொடர்ந்து அவற்றை மெதுவாக்குகிறது. \n"
"\n"
"இது அவற்றைப் பிடிப்பதை எளிதாக்குகிறது, மேலும் நாணயத்தின் இயக்கத்தை பாதிக்கும் சலுகைகளுடன் நன்றாக இணைகிறது."

msgctxt "upgrades.wind.name"
msgid "Wind"
msgstr "காற்று"

msgctxt "upgrades.wind.tooltip"
msgid "Paddle position creates wind"
msgstr "துடுப்பு நிலை காற்றை உருவாக்குகிறது"

msgctxt "upgrades.wind.verbose_description"
msgid ""
"Wind depends on paddle position: left blows left, right blows right. Affects"
" both balls and coins."
msgstr ""
"காற்று துடுப்பின் நிலையைப் பொறுத்தது: இடதுபுறம் இடதுபுறம் வீசுகிறது, "
"வலதுபுறம் வீசுகிறது. பந்துகள் மற்றும் நாணயங்கள் இரண்டையும் பாதிக்கிறது."

msgctxt "upgrades.wrap_left.name"
msgid "Wrap left"
msgstr "இடது மடக்கு"

msgctxt "upgrades.wrap_left.tooltip"
msgid "Hitting the left side teleports the ball to the right side"
msgstr "இடது பக்கம் அடிப்பது பந்தை வலது பக்கமாக டெலிபோர்ட் செய்கிறது"

msgctxt "upgrades.wrap_left.verbose_description"
msgid "Higher levels teleport coins too."
msgstr "உயர் நிலைகள் நாணயங்களையும் டெலிபோர்ட் செய்கின்றன."

msgctxt "upgrades.wrap_right.name"
msgid "Wrap right"
msgstr "வலது மடக்கு"

msgctxt "upgrades.wrap_right.tooltip"
msgid "Hitting the right side teleports the ball to the left side"
msgstr "வலது பக்கம் அடிப்பது பந்தை இடது பக்கமாக டெலிபோர்ட் செய்கிறது"

msgctxt "upgrades.wrap_right.verbose_description"
msgid "Higher levels teleport coins too."
msgstr "உயர் நிலைகள் நாணயங்களையும் டெலிபோர்ட் செய்கின்றன."

msgctxt "upgrades.wrap_up.name"
msgid "Wrap up"
msgstr "மடக்கு"

msgctxt "upgrades.wrap_up.tooltip"
msgid ""
"Touching the top of the screen will teleport the ball just above the paddle."
msgstr ""
"திரையின் மேற்புறத்தைத் தொட்டால், துடுப்புக்கு சற்று மேலே பந்தை டெலிபோர்ட் "
"செய்யும்."

msgctxt "upgrades.wrap_up.verbose_description"
msgid "This won't count as a paddle hit. At level 2, coins teleport too."
msgstr ""
"இது ஒரு துடுப்பு வெற்றியாகக் கருதப்படாது. நிலை 2 இல், நாணயங்களும் டெலிபோர்ட்"
" செய்கின்றன."

msgctxt "upgrades.yoyo.name"
msgid "Yo-yo"
msgstr "யோ-யோ"

msgctxt "upgrades.yoyo.tooltip"
msgid "The ball falls toward the paddle"
msgstr "பந்து துடுப்பை நோக்கி விழுகிறது"

msgctxt "upgrades.yoyo.verbose_description"
msgid ""
"It's the opposite of telekinesis, control the ball while it's falling back "
"down. The effect is stronger when the ball is at the top of the screen, and "
"far away on the horizontal axis from the paddle."
msgstr ""
"இது டெலிகினேசிசுக்கு எதிரானது, பந்து கீழே விழும்போது அதைக் "
"கட்டுப்படுத்தவும். பந்து திரையின் மேற்புறத்திலும், துடுப்பிலிருந்து கிடைமட்ட"
" அச்சில் வெகு தொலைவில் இருக்கும்போதும் விளைவு வலுவாக இருக்கும்."

msgctxt "upgrades.zen.name"
msgid "Zen"
msgstr "சென்"

msgctxt "upgrades.zen.tooltip"
msgid "More coins if you don't trigger bombs"
msgstr "நீங்கள் வெடிகுண்டுகளைத் தூண்டவில்லை என்றால் அதிக நாணயங்கள்"

msgctxt "upgrades.zen.verbose_description"
msgid "+{{lvl}} combo every 3s, reset when there's an explosion"
msgstr ""
"ஒவ்வொரு 3 வினாடிகளுக்கும் +{{lvl}} சேர்க்கை, வெடிப்பு ஏற்படும் போது "
"மீட்டமைக்கவும்"
