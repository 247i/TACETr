msgctxt "confirmRestart.no"
msgid "Cancel"
msgstr "ரத்துசெய்"

msgctxt "confirmRestart.text"
msgid "You're about to start a new game. Are you sure you want to continue?"
msgstr ""
"புதிய விளையாட்டைத் தொடங்க உள்ளீர்கள். நீங்கள் நிச்சயமாக தொடர "
"விரும்புகிறீர்களா?"

msgctxt "confirmRestart.title"
msgid "Start a new game?"
msgstr "புதிய விளையாட்டைத் தொடங்கவா?"

msgctxt "confirmRestart.yes"
msgid "Restart game"
msgstr "விளையாட்டை மறுதொடக்கம் செய்யுங்கள்"

msgctxt "editor.editing.author"
msgid "Author"
msgstr "நூலாசிரியர்"

msgctxt "editor.editing.author_prompt"
msgid ""
"Enter your own name. Don't put links here. This field should be the same for"
" all the levels you submit."
msgstr ""
"Enter your own name. Don't put links here. This புலம் should be the same "
"க்கு அனைத்தும் the levels you submit."

msgctxt "editor.editing.author_required"
msgid "Please enter your name in \"Author\" first"
msgstr "முதலில் \"ஆசிரியர்\" என்பதில் உங்கள் பெயரை உள்ளிடவும்"

msgctxt "editor.editing.bigger"
msgid "Increase level size"
msgstr "நிலை அளவை அதிகரிக்கவும்"

msgctxt "editor.editing.category"
msgid "Category"
msgstr "வகை"

msgctxt "editor.editing.category_prompt"
msgid "Select the category best matching your level"
msgstr "உங்கள் நிலைக்கு மிகவும் பொருத்தமான வகையைத் தேர்ந்தெடுக்கவும்"

msgctxt "editor.editing.color"
msgid "Pick a color in the color list (max 5 per level)"
msgstr "Pick a color in the color பட்டியல் (max 5 per level)"

msgctxt "editor.editing.copied"
msgid "Level code copied"
msgstr "நிலை குறியீடு நகலெடுக்கப்பட்டது"

msgctxt "editor.editing.copy"
msgid "Copy level code"
msgstr "நிலைக் குறியீட்டை நகலெடுக்கவும்"

msgctxt "editor.editing.copy_help"
msgid "Share the level code in our discord for inclusion in the game."
msgstr ""
"விளையாட்டில் சேர்ப்பதற்காக எங்கள் முரண்பாட்டில் உள்ள நிலைக் குறியீட்டைப் "
"பகிரவும்."

msgctxt "editor.editing.credit"
msgid "Credits and source"
msgstr "கடன் மற்றும் சான்று"

msgctxt "editor.editing.credit_prompt"
msgid "Enter the source url or explanation of your level."
msgstr "மூல url அல்லது உங்கள் நிலை விளக்கத்தை உள்ளிடவும்."

