msgctxt "tein_fi_dual_dictionary_use"
msgid "Use dual dictionaries"
msgstr "இரட்டை அகராதிகளைப் பயன்படுத்தவும்"

msgctxt "tein_fi_keyboard_layout"
msgid "Hardware keyboard layout"
msgstr "வன்பொருள் விசைப்பலகை தளவமைப்பு"

msgctxt "tein_fi_not_in_use"
msgid "Not in use"
msgstr "பயன்பாட்டில் இல்லை"

msgctxt "tein_fi_primary_language"
msgid "1st language"
msgstr "1 வது மொழி"

msgctxt "tein_fi_secondary_language"
msgid "2nd language"
msgstr "2வது மொழி"

msgctxt "tein_fi_settings_auto_capitalization"
msgid "Auto-capitalisation"
msgstr "தானியங்கு மூலதனம்"

msgctxt "tein_fi_settings_dictionary"
msgid "Dictionary"
msgstr "அகராதி"

msgctxt "tein_fi_settings_space_after_word"
msgid "Insert space after word"
msgstr "வார்த்தைக்குப் பின் இடத்தைச் செருகவும்"

msgctxt "tein_fi_settings_word_completion"
msgid "Word completion"
msgstr "சொல் நிறைவு"

msgctxt "tein_fi_use_virtual_keyboard"
msgid "Use virtual keyboard"
msgstr "மெய்நிகர் விசைப்பலகையைப் பயன்படுத்தவும்"

msgctxt "tein_fi_word_completion_language_empty"
msgid "Custom/Empty"
msgstr "தனிப்பயன்/காலி"

msgctxt "tein_ti_text_input_title"
msgid "Text input"
msgstr "உரை உள்ளீடு"
