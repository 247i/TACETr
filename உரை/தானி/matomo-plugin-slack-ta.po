#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.ChannelId"
msgid "Slack Channel ID"
msgstr "ச்லாக் சேனல் அடையாளம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.NoOauthTokenAdded"
msgid "Please add your Slack OAuth Token %1$shere%2$s."
msgstr "உங்கள் Slack OAuth கிள்ளாக்கை %1$shere%2$s சேர்க்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.OauthTokenRequiredErrorMessage"
msgid ""
"To enable Slack, provide your Slack OAuth Token in General settings > Slack."
msgstr ""
"ச்லாக்கை இயக்க, உங்கள் Slack OAuth கிள்ளாக்கை பொது அமைப்புகள் > ச்லாக் "
"என்பதில் வழங்கவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.OauthTokenSettingTitle"
msgid "Slack OAuth Token"
msgstr "ச்லாக் OAuth கிள்ளாக்கு"

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.OauthTokenSettingDescription"
msgid ""
"Enter your Slack OAuth Token generated from your Slack. %1$sLearn more%2$s."
msgstr ""
"உங்கள் ச்லாக்கிலிருந்து உருவாக்கப்பட்ட ச்லாக் OAuth கிள்ளாக்கை உள்ளிடவும். "
"%1$sமேலும் அறிக%2$s."

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.PleaseFindYourReport"
msgid "Here is your %1$s report for %2$s"
msgstr "%2$sக்கான உங்கள் %1$s அறிக்கை இதோ"

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.SlackChannelIdRequiredErrorMessage"
msgid "Slack Channel ID cannot be empty."
msgstr "ச்லாக் சேனல் அடையாளம் காலியாக இருக்கக்கூடாது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.SlackChannelIdInvalidErrorMessage"
msgid "Invalid Slack Channel ID, only alphanumeric values are allowed."
msgstr ""
"தவறான ச்லாக் சேனல் அடையாளம், எண்ணெழுத்து மதிப்புகள் மட்டுமே "
"அனுமதிக்கப்படும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.SlackChannel"
msgid "Slack Channel"
msgstr "ச்லாக் சேனல்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.SlackEnterYourSlackChannelIdHelpText"
msgid ""
"Enter the Slack Channel ID of the channel that will receive these reports. "
"To find the ID, go to Slack and open the channel details > About tab. "
"%1$sLearn more%2$s"
msgstr ""
"இந்த அறிக்கைகளைப் பெறும் சேனலின் ச்லாக் சேனல் ஐடியை உள்ளிடவும். ஐடியைக் "
"கண்டறிய, ச்லாக்கிற்குச் சென்று சேனல் விவரங்கள் > அறிமுகம் தாவலைத் "
"திறக்கவும். %1$sமேலும் அறிக%2$s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "Slack.SlackAlertContent"
msgid ""
"%1$s has been triggered for website %2$s as the metric %3$s in report %4$s "
"%5$s."
msgstr ""
"%4$s %5$s அறிக்கையில் %3$s மெட்ரிக்காக %2$s இணையதளத்திற்கு %1$s "
"தூண்டப்பட்டது."
