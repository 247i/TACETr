#: ../src/devices/abstractdevice.cpp:165
msgctxt "AbstractDevice"
msgid "Device does not support settings"
msgstr "சாதனம் அமைப்புகளை ஆதரிக்காது"

#: ../src/achievements.cpp:12
msgctxt "Achievements"
msgid ""
"The journey begins, adventurer. Only <b>%1</b> steps — the Shire is still in"
" sight."
msgstr ""
"பயணம் தொடங்குகிறது, சாகசக்காரர். <b>%1</b> படிகள் மட்டுமே — சைர் இன்னும் "
"பார்வையில் உள்ளது."

#: ../src/achievements.cpp:13
msgctxt "Achievements"
msgid "You’ve crossed the Brandywine. <b>%1</b> steps down — trolls ahead!"
msgstr ""
"நீங்கள் பிராண்டிவைனைக் கடந்துவிட்டீர்கள். <b>%1</b> படிகள் கீழே - ட்ரோல்ச்!"

#: ../src/achievements.cpp:14
msgctxt "Achievements"
msgid "Halfway to Mordor. <b>%1</b> steps walked and second breakfast missed."
msgstr ""
"மொர்டோருக்கு பாதி வழி. <b>%1</b> அடிகள் நடந்தன, இரண்டாவது காலை உணவு "
"தவறிவிட்டது."

#: ../src/achievements.cpp:15
msgctxt "Achievements"
msgid ""
"Mount Doom is on the horizon. <b>%1</b> steps behind you — don't drop the "
"ring yet!"
msgstr ""
"மவுண்ட் டூம் அடிவானத்தில் உள்ளது. உங்களுக்குப் பின்னால் <b>%1</b> அடிகள் — "
"இன்னும் மோதிரத்தைக் கைவிட வேண்டாம்!"

#: ../src/achievements.cpp:16
msgctxt "Achievements"
msgid ""
"The ring is cast into the fire. <b>%1</b> steps done — Middle-earth is "
"saved!"
msgstr ""
"மோதிரம் நெருப்பில் போடப்படுகிறது. <b>%1</b> படிகள் முடிந்தது — நடு பூமி "
"சேமிக்கப்பட்டது!"

#: ../src/achievements.cpp:17
msgctxt "Achievements"
msgid ""
"You kept walking after saving the world?! <b>%1</b> steps — you’re a true "
"legend. 🧙"
msgstr ""
"உலகைக் காப்பாற்றிய பிறகும் தொடர்ந்து நடந்தீர்களா?! <b>%1</b> படிகள் — "
"நீங்கள் ஒரு உண்மையான புராணக்கதை. 🧙"

#: ../src/achievements.cpp:18
msgctxt "Achievements"
msgid ""
"The Hobbit, or There and Back Again — <b>%1</b> steps and second breakfast "
"earned!"
msgstr ""
"The Hobbit, or there and பின் Again — <b>%1</b> படிகள் மற்றும் இரண்டாவது "
"காலை உணவு சம்பாதித்தது!"

#: ../src/achievements.cpp:22
msgctxt "Achievements"
msgid "Let's get moving! You've taken only <b>%1</b> steps so far."
msgstr "நகர்வோம்! நீங்கள் இதுவரை <b>%1</b> படிகளை மட்டுமே எடுத்துள்ளீர்கள்."

#: ../src/achievements.cpp:23
msgctxt "Achievements"
msgid "Warming up! <b>%1</b> steps done — keep going!"
msgstr "சூடு! <b>%1</b> படிகள் முடிந்தது — தொடரவும்!"

#: ../src/achievements.cpp:24
msgctxt "Achievements"
msgid "You're halfway there. <b>%1</b> steps so far!"
msgstr "நீங்கள் பாதியிலேயே இருக்கிறீர்கள். இதுவரை <b>%1</b> படிகள்!"

#: ../src/achievements.cpp:25
msgctxt "Achievements"
msgid "Almost there! Just a bit more — <b>%1</b> steps already!"
msgstr "கிட்டத்தட்ட அங்கே! இன்னும் கொஞ்சம் — <b>%1</b> படிகள் ஏற்கனவே!"

#: ../src/achievements.cpp:26
msgctxt "Achievements"
msgid "Goal reached! <b>%1</b> steps — you can have that cake now 🎉"
msgstr ""
"இலக்கை எட்டியது! <b>%1</b> படிகள் — நீங்கள் இப்போது அந்த கேக்கை சாப்பிடலாம் "
"🎉"

#: ../src/achievements.cpp:27
msgctxt "Achievements"
msgid "You smashed it! <b>%1</b> steps — time to rest or go for bonus steps?"
msgstr ""
"நீங்கள் அதை உடைத்தீர்கள்! <b>%1</b> படிகள் — ஓய்வெடுக்க வேண்டுமா அல்லது "
"போனச் படிகளுக்கு செல்ல வேண்டுமா?"

