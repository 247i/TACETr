msgstr "ஏற்றுமதி அமைப்புகள்"

#, java-printf-format
msgctxt "pref_summary_export_settings"
msgid "Tap to save app and account settings to a local file"
msgstr "பயன்பாடு மற்றும் கணக்கு அமைப்புகளை உள்ளக கோப்பில் சேமிக்க தட்டவும்"

#, java-printf-format
msgctxt "pref_title_import_settings"
msgid "Import settings"
msgstr "அமைப்புகளை இறக்குமதி செய்யுங்கள்"

#, java-printf-format
msgctxt "pref_summary_import_settings"
msgid "Tap to restore settings from a file created using \"Export settings\""
msgstr ""
"\"ஏற்றுமதி அமைப்புகள்\" பயன்படுத்தி உருவாக்கப்பட்ட கோப்பிலிருந்து அமைப்புகளை"
" மீட்டெடுக்க தட்டவும்"

