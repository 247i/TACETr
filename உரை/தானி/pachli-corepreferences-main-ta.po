msgctxt "pref_default_audio_playback_option_unmuted"
msgid "Unmuted"
msgstr "ஒலிஇயக்கப்பட்டது"

#, java-printf-format
msgctxt "pref_default_audio_playback_option_muted"
msgid "Muted"
msgstr "முடக்கிய"

#, java-printf-format
msgctxt "pref_title_translation"
msgid "Translation"
msgstr "மொழிபெயர்ப்பு"

#, java-printf-format
msgctxt "pref_translation_backend"
msgid "How to translate"
msgstr "எப்படி மொழிபெயர்க்க வேண்டும்"

#, java-printf-format
msgctxt "pref_translation_backend_option_server_only"
msgid "Server only"
msgstr "சர்வர் மட்டும்"

#, java-printf-format
msgctxt "pref_translation_backend_option_server_only_help"
msgid ""
"Translates posts using your server. Will not work if your server does not "
"support translation, or the post's language is incorrect."
msgstr ""
"உங்கள் சர்வரைப் பயன்படுத்தி இடுகைகளை மொழிபெயர்க்கிறது. உங்கள் சேவையகம் "
"மொழிபெயர்ப்பை ஆதரிக்கவில்லை என்றால் அல்லது இடுகையின் மொழி தவறாக இருந்தால் "
"வேலை செய்யாது."

#, java-printf-format
msgctxt "pref_translation_backend_option_server_first"
msgid "Server first"
msgstr "முதலில் சர்வர்"

#, java-printf-format
msgctxt "pref_translation_backend_option_server_first_help"
msgid ""
"Translates posts using your server. If that fails then translates on your "
"device using Google Translate."
msgstr ""
"உங்கள் சர்வரைப் பயன்படுத்தி இடுகைகளை மொழிபெயர்க்கிறது. அது தோல்வியுற்றால், "
"உங்கள் சாதனத்தில் Google மொழிபெயர்த்திடு ஐப் பயன்படுத்தி மொழிபெயர்க்கும்."

#, java-printf-format
msgctxt "pref_translation_backend_option_local_only"
msgid "On-device only"
msgstr "சாதனத்தில் மட்டும்"

#, java-printf-format
msgctxt "pref_translation_backend_option_local_only_help"
msgid "Translates posts on your device using Google Translate."
msgstr ""
"கூகுள் டிரான்ச்லேட்டைப் பயன்படுத்தி உங்கள் சாதனத்தில் உள்ள இடுகைகளை "
"மொழிபெயர்க்கும்."

#, java-printf-format
msgctxt "pref_translation_backend_requires_play_label"
msgid "Install from Google Play for on-device translation support"
msgstr "சாதனத்தில் மொழிபெயர்ப்பு ஆதரவுக்காக Google Play இலிருந்து நிறுவவும்"

#, java-printf-format
msgctxt "pref_title_pronoun_display"
msgid "Show account pronouns"
msgstr "கணக்கு பிரதிபெயர்களைக் காட்டு"

#, java-printf-format
msgctxt "pref_pronoun_display_everywhere"
msgid "Everywhere"
msgstr "எல்லா இடங்களிலும்"

#, java-printf-format
msgctxt "pref_pronoun_display_when_composing"
msgid "When writing a post"
msgstr "ஒரு இடுகை எழுதும் போது"

#, java-printf-format
msgctxt "pref_pronoun_display_hide"
msgid "Nowhere"
msgstr "எங்கும் இல்லை"

#, java-printf-format
msgctxt "pref_title_quote_policy"
msgid "Who can quote your posts?"
msgstr "உங்கள் இடுகைகளை யார் மேற்கோள் காட்டலாம்?"

#, java-printf-format
msgctxt "pref_quote_policy_public"
msgid "Anyone (except blocked accounts)"
msgstr "எவரும் (தடுக்கப்பட்ட கணக்குகள் தவிர)"

#, java-printf-format
msgctxt "pref_quote_policy_followers"
msgid "Only your followers"
msgstr "உங்களைப் பின்தொடர்பவர்களில் ஒருவர்"

#, java-printf-format
msgctxt "pref_quote_policy_nobody"
msgid "Only you"
msgstr "நீங்கள் மட்டும்"

#, java-printf-format
msgctxt "pref_summary_quote_policy_disabled"
msgid "Your server does not support quote policies"
msgstr "உங்கள் சேவையகம் உள்ளடக்க வடிப்பான்களை ஆதரிக்காது"
