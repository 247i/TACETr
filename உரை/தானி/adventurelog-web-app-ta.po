msgctxt "api_keys.title"
msgid "API Keys"
msgstr "பநிஇ விசைகள்"

msgctxt "api_keys.description"
msgid ""
"Create personal API keys for programmatic access. Keys are shown only once "
"at creation time."
msgstr ""
"நிரல் அணுகலுக்கான தனிப்பட்ட பநிஇ விசைகளை உருவாக்கவும். உருவாக்கும் நேரத்தில்"
" விசைகள் ஒரு முறை மட்டுமே காட்டப்படும்."

msgctxt "api_keys.new_key_title"
msgid "Save your new API key"
msgstr "உங்கள் புதிய பநிஇ விசையைச் சேமிக்கவும்"

msgctxt "api_keys.new_key_warning"
msgid "This key will not be shown again. Copy it and store it somewhere safe."
msgstr ""
"இந்த விசை மீண்டும் காட்டப்படாது. அதை நகலெடுத்து பாதுகாப்பான இடத்தில் "
"சேமிக்கவும்."

msgctxt "api_keys.copy"
msgid "Copy key"
msgstr "நகல் விசை"

msgctxt "api_keys.copied"
msgid "Copied!"
msgstr "நகலெடுக்கப்பட்டது!"

msgctxt "api_keys.dismiss"
msgid "Dismiss"
msgstr "நிராகரி"

msgctxt "api_keys.key_name_placeholder"
msgid "Key name (e.g. Home Assistant)"
msgstr "முக்கிய பெயர் (எ.கா. வீட்டு உதவியாளர்)"

msgctxt "api_keys.create"
msgid "Create key"
msgstr "விசையை உருவாக்கவும்"

msgctxt "api_keys.created"
msgid "Created"
msgstr "உருவாக்கப்பட்டது"

msgctxt "api_keys.never_used"
msgid "Never used"
msgstr "பயன்படுத்தியதில்லை"

msgctxt "api_keys.last_used"
msgid "Last used"
msgstr "கடைசியாக பயன்படுத்தப்பட்டது"

msgctxt "api_keys.revoke"
msgid "Revoke"
msgstr "திரும்பப் பெறு"

msgctxt "api_keys.no_keys"
msgid "No API keys yet."
msgstr "இதுவரை பநிஇ விசைகள் இல்லை."

msgctxt "api_keys.key_created"
msgid "API key created successfully."
msgstr "பநிஇ விசை வெற்றிகரமாக உருவாக்கப்பட்டது."

msgctxt "api_keys.key_revoked"
msgid "API key revoked."
msgstr "பநிஇ விசை திரும்பப் பெறப்பட்டது."

msgctxt "api_keys.create_error"
msgid "Failed to create API key."
msgstr "பநிஇ விசையை உருவாக்குவதில் தோல்வி."

msgctxt "api_keys.revoke_error"
msgid "Failed to revoke API key."
msgstr "பநிஇ விசையை திரும்பப் பெற முடியவில்லை."

msgctxt "api_keys.copy_error"
msgid "Error copying key."
msgstr "விசையை நகலெடுப்பதில் பிழை."

msgctxt "api_keys.usage_prefix"
msgid "Use this key in the"
msgstr "இல் இந்த விசையைப் பயன்படுத்தவும்"

msgctxt "api_keys.usage_middle"
msgid "header or as"
msgstr "தலைப்பு அல்லது"

msgctxt "api_keys.delete_confirm"
msgid "Are you sure you want to delete this mobile API key?"
msgstr "இந்த மொபைல் பநிஇ விசையை நிச்சயமாக நீக்க விரும்புகிறீர்களா?"
