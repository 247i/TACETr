msgstr "மாறியை அகற்று"

msgctxt "actions.variables.deletion.description"
msgid "Removing a variable is permanent and cannot be undone. Continue?"
msgstr "மாறியை அகற்றுவது நிரந்தரமானது மற்றும் செயல்தவிர்க்க முடியாது. தொடரவா?"

msgctxt "actions.variables.deletion.failed"
msgid "Failed to remove variable."
msgstr "மாறியை அகற்ற முடியவில்லை."

msgctxt "actions.variables.deletion.success"
