msgctxt "settings.twofa_reenroll.description"
msgid "Re-enroll your two-factor authentication"
msgstr "உங்கள் இரு காரணி அங்கீகாரத்தை மீண்டும் பதிவு செய்யவும்"

msgctxt "settings.must_enable_2fa"
msgid ""
"This Forgejo instance requires users to enable two-factor authentication "
"before they can access their accounts."
msgstr ""
"இந்த Forgejo நிகழ்விற்கு பயனர்கள் தங்கள் கணக்குகளை அணுகுவதற்கு முன் இரு "
"காரணி அங்கீகாரத்தை இயக்க வேண்டும்."

msgctxt "settings.specific_repo_access"
msgid "Repository access"
msgstr "களஞ்சிய அணுகல்"

msgctxt "settings.new_access_token"
msgid "New access token"
msgstr "புதிய அணுகல் கிள்ளாக்கு"

msgctxt "settings.permissions_access_specific_repositories"
msgid "Specific repositories"
msgstr "குறிப்பிட்ட களஞ்சியங்கள்"

msgctxt "settings.access_token.selected_repositories"
msgid "Selected repository (%d)"
msgid_plural "Selected repositories (%d)"
msgstr[0] "தேர்ந்தெடுக்கப்பட்ட களஞ்சியம் (%d)"
msgstr[1] "தேர்ந்தெடுக்கப்பட்ட களஞ்சியங்கள் (%d)"

msgctxt "settings.access_token.available_repositories"
msgid "Available repositories"
msgstr "கிடைக்கும் களஞ்சியங்கள்"

msgctxt "settings.access_token.no_repositories_selected"
msgid "No repositories selected."
msgstr "களஞ்சியங்கள் எதுவும் தேர்ந்தெடுக்கப்படவில்லை."

msgctxt "settings.access_token.no_repositories_found"
msgid "No repositories found."
msgstr "களஞ்சியங்கள் எதுவும் இல்லை."

#. This string is only used in `aria-label` of the `Remove` button
msgctxt "settings.access_token.remove"
msgid "Remove %s"
msgstr "%sஐ அகற்று"

msgctxt "settings.access_token.resource_all_help"
msgid "Allow access to all resources."
msgstr "அனைத்து ஆதாரங்களுக்கும் அணுகலை அனுமதிக்கவும்."

msgctxt "settings.access_token.resource_public_only_help"
msgid "Limit access to repositories and organizations that are public."
msgstr ""
"பொதுவில் உள்ள களஞ்சியங்கள் மற்றும் நிறுவனங்களுக்கான அணுகலை வரம்பிடவும்."

msgctxt "settings.access_token.resource_specific_repo_help"
msgid ""
"Limit access to a specific list of repositories. Read-only access is "
"permitted to all public repositories. Only permissions that allow access to "
"repositories and issues can be enabled."
msgstr ""
"களஞ்சியங்களின் குறிப்பிட்ட பட்டியலுக்கான அணுகலை வரம்பிடவும். அனைத்து பொது "
"களஞ்சியங்களுக்கும் படிக்க மட்டுமே அணுகல் அனுமதிக்கப்படுகிறது. களஞ்சியங்கள் "
"மற்றும் சிக்கல்களுக்கான அணுகலை அனுமதிக்கும் அனுமதிகள் மட்டுமே இயக்கப்படும்."

msgctxt "settings.access_token.admin_disabled"
msgid "Administrative permissions are disabled."
msgstr "நிர்வாக அனுமதிகள் முடக்கப்பட்டுள்ளன."

msgctxt "settings.authorized_integrations"
msgid "Authorized Integrations"
msgstr "அங்கீகரிக்கப்பட்ட ஒருங்கிணைப்புகள்"

msgctxt "settings.manage_authorized_integrations"
msgid "Authorized integrations"
msgstr "அங்கீகரிக்கப்பட்ட ஒருங்கிணைப்புகள்"

msgctxt "settings.authorized_integration.desc"
msgid ""
"Authorized integrations allow Forgejo to receive signed JWTs, validate their"
" claims against configured rules, and permit them to access Forgejo's APIs."
msgstr ""
"அங்கீகரிக்கப்பட்ட ஒருங்கிணைப்புகள் Forgejo கையொப்பமிடப்பட்ட JWTகளைப் பெற "
"அனுமதிக்கின்றன, உள்ளமைக்கப்பட்ட விதிகளுக்கு எதிராக அவர்களின் உரிமைகோரல்களை "
"சரிபார்க்கின்றன, மேலும் Forgejo இன் APIகளை அணுக அவர்களை அனுமதிக்கின்றன."

msgctxt "settings.authorized_integration.ui.generic"
msgid "Generic JWT"
msgstr "பொதுவான JWT"

msgctxt "settings.authorized_integration.ui.forgejo_actions_local"
msgid "Forgejo Actions (Local)"
msgstr "Forgejo செயல்கள் (உள்ளூர்)"

msgctxt "settings.authorized_integration.none"
msgid "No authorized integrations currently configured."
msgstr ""
"அங்கீகரிக்கப்பட்ட ஒருங்கிணைப்புகள் எதுவும் தற்போது கட்டமைக்கப்படவில்லை."

msgctxt "settings.authorized_integration.view"
msgid "View"
msgstr "பார்வை"

msgctxt "settings.authorized_integration.view_page_title"
msgid "Authorized Integration <b>%s</b>"
msgstr "அங்கீகரிக்கப்பட்ட ஒருங்கிணைப்பு <b>%s</b>"

msgctxt "settings.authorized_integration.field.name"
msgid "Name"
msgstr "பெயர்"

msgctxt "settings.authorized_integration.field.description"
msgid "Description"
msgstr "விவரம்"

msgctxt "settings.authorized_integration.field.description.placeholder"
msgid "Used to publish packages when ..."
msgstr "தொகுப்புகளை வெளியிடப் பயன்படும் போது..."

msgctxt "settings.authorized_integration.field.audience"
msgid "Audience (<code>aud</code> Claim)"
msgstr "பார்வையாளர்கள் (<code>aud</code> உரிமைகோரல்)"

msgctxt "settings.authorized_integration.field.issuer"
msgid "Issuer (<code>iss</code> Claim)"
msgstr "வழங்குபவர் (<code>iss</code> உரிமைகோரல்)"

msgctxt "settings.authorized_integration.field.claim_rules"
msgid "Claim Rules JSON"
msgstr "உரிமைகோரல் விதிகள் சாதொபொகு"

msgctxt "settings.authorized_integration.claims.generic"
msgid "Generic JWT Rules"
msgstr "பொதுவான JWT விதிகள்"

msgctxt "settings.authorized_integration.perms.title"
msgid "Capabilities Permitted"
msgstr "அனுமதிக்கப்பட்ட திறன்கள்"

msgctxt "settings.authorized_integration.copy_audience"
msgid "Copy audience to clipboard"
msgstr "பார்வையாளர்களை இடைநிலைப்பலகைக்கு நகலெடுக்கவும்"

msgctxt "webauthn.insert_key"
msgid "Insert your security key"
msgstr "உங்கள் பாதுகாப்பு விசையைச் செருகவும்"

msgctxt "webauthn.sign_in"
msgid ""
"Press the button on your security key. If your security key has no button, "
"re-insert it."
msgstr ""
"உங்கள் பாதுகாப்பு விசையில் உள்ள பொத்தானை அழுத்தவும். உங்கள் பாதுகாப்பு "
"விசையில் பொத்தான் இல்லை என்றால், அதை மீண்டும் செருகவும்."

msgctxt "webauthn.press_button"
msgid "Please press the button on your security key…"
msgstr "உங்கள் பாதுகாப்பு விசையில் உள்ள பொத்தானை அழுத்தவும்…"

msgctxt "webauthn.use_twofa"
msgid "Use a two-factor code from your phone"
msgstr "உங்கள் ஃபோனில் இருந்து இரண்டு காரணி குறியீட்டைப் பயன்படுத்தவும்"

msgctxt "webauthn.error"
msgid "Could not read your security key."
msgstr "உங்கள் பாதுகாப்பு விசையைப் படிக்க முடியவில்லை."

msgctxt "webauthn.error.unknown"
msgid "An unknown error occurred. Please retry."
msgstr "அறியப்படாத பிழை ஏற்பட்டது. மீண்டும் முயற்சிக்கவும்."

msgctxt "webauthn.error.insecure"
msgid ""
"WebAuthn only supports secure connections. For testing over HTTP, you can "
"use the origin \"localhost\" or \"127.0.0.1\""
msgstr ""
"WebAuthn பாதுகாப்பான இணைப்புகளை மட்டுமே ஆதரிக்கிறது. HTTP மூலம் சோதனை செய்ய,"
" நீங்கள் \"localhost\" அல்லது \"127.0.0.1\" மூலத்தைப் பயன்படுத்தலாம்"

msgctxt "webauthn.error.unable_to_process"
msgid "The server could not process your request."
msgstr "சேவையகத்தால் உங்கள் கோரிக்கையைச் செயல்படுத்த முடியவில்லை."

msgctxt "webauthn.error.duplicated"
msgid ""
"The security key is not permitted for this request. Please make sure that "
"the key is not already registered."
msgstr ""
"இந்தக் கோரிக்கைக்கு பாதுகாப்பு விசை அனுமதிக்கப்படவில்லை. விசை ஏற்கனவே பதிவு "
"செய்யப்படவில்லை என்பதை உறுதிப்படுத்தவும்."

msgctxt "webauthn.error.empty"
msgid "You must set a name for this key."
msgstr "இந்த விசைக்கு நீங்கள் ஒரு பெயரை அமைக்க வேண்டும்."

msgctxt "webauthn.error.timeout"
msgid ""
"Timeout reached before your key could be read. Please reload this page and "
"retry."
msgstr ""
"உங்கள் விசையைப் படிக்கும் முன் காலாவதியானது. இந்தப் பக்கத்தை மீண்டும் ஏற்றி "
"மீண்டும் முயற்சிக்கவும்."

msgctxt "webauthn.unsupported_browser"
msgid "Your browser does not currently support WebAuthn."
msgstr "உங்கள் உலாவி தற்போது WebAuthn ஐ ஆதரிக்கவில்லை."

msgctxt "error.must_enable_2fa"
msgid ""
"This Forgejo instance requires users to enable two-factor authentication "
"before they can access their accounts. Enable it at: %s"
msgstr ""
"இந்த Forgejo நிகழ்விற்கு பயனர்கள் தங்கள் கணக்குகளை அணுகுவதற்கு முன் இரு "
"காரணி அங்கீகாரத்தை இயக்க வேண்டும். இதை இயக்கவும்: %s"

msgctxt "avatar.constraints_hint"
msgid ""
"Custom avatar may not exceed %[1]s in size or be larger than %[2]dx%[3]d "
"pixels"
msgstr ""
"தனிப்பயன் அவதார் அளவு %[1]s ஐ விட அதிகமாக இருக்கக்கூடாது அல்லது %[2]dx%[3]d "
"பிக்சல்களை விட பெரியதாக இருக்கலாம்"

msgctxt "user.activitypub_feed.feed"
msgid "Fediverse Feed"
msgstr "Fediverse ஊட்டம்"

msgctxt "user.activitypub_feed.no_activity"
msgid "No fediverse activity"
msgstr "ஃபெடிவர் செயல்பாடு இல்லை"

msgctxt "user.activitypub_feed.is_empty"
msgid "Your fediverse feed is empty."
msgstr "உங்கள் ஃபீடிவர்ச் ஃபீட் காலியாக உள்ளது."

msgctxt "user.activitypub_feed.hint"
msgid ""
"This feed shows activities from fediverse accounts that you follow, as well "
"as federated posts that mentioned you."
msgstr ""
"இந்த ஊட்டம் நீங்கள் பின்தொடரும் fediverse கணக்குகளின் செயல்பாடுகளையும், "
"உங்களைக் குறிப்பிட்டுள்ள கூட்டமைப்பு இடுகைகளையும் காட்டுகிறது."

msgctxt "user.activitypub_feed.posted_on"
msgid "Posted on %[1]s"
msgstr "%[1]s இல் இடுகையிடப்பட்டது"

msgctxt "user.activitypub_feed.original_source"
msgid "Original source"
msgstr "அசல் சான்று"

msgctxt "user.ghost.tooltip"
msgid "This user has been deleted, or cannot be matched."
msgstr "இந்த பயனர் நீக்கப்பட்டுள்ளார் அல்லது பொருத்த முடியாது."

#. An extended version of this string from Legacy locales:
#. https://translate.codeberg.org/translate/forgejo/forgejo/en/?checksum=d38d638bbc7f9065
msgctxt "og.repo.summary_card.alt_description"
msgid "Summary card of repository %[1]s, described as: %[2]s"
msgstr ""
"%[1]s களஞ்சியத்தின் சுருக்க அட்டை, இவ்வாறு விவரிக்கப்பட்டுள்ளது: %[2]s"

msgctxt "repo.commit.load_tags_failed"
msgid "Load tags failed because of internal error"
msgstr "உள் பிழை காரணமாக குறிச்சொற்களை ஏற்ற முடியவில்லை"

msgctxt "compare.branches.title"
msgid "Compare branches"
msgstr "கிளைகளை ஒப்பிடுக"

msgctxt "migrate.pagure.description"
msgid "Migrate data from pagure.io or other Pagure instances."
msgstr "pagure.io அல்லது பிற Pagure நிகழ்வுகளிலிருந்து தரவை நகர்த்தவும்."

msgctxt "migrate.pagure.incorrect_url"
msgid "Incorrect source repository URL has been provided"
msgstr "தவறான மூல களஞ்சிய முகவரி வழங்கப்பட்டுள்ளது"

msgctxt "migrate.pagure.project_url"
msgid "Pagure project URL"
msgstr "திட்ட முகவரி பாகுர்"

msgctxt "migrate.pagure.project_example"
msgid "The Pagure project URL, e.g. https://pagure.io/pagure"
msgstr "Pagure திட்ட URL, எ.கா. https://pagure.io/pagure"

msgctxt "migrate.pagure.token_label"
msgid "Pagure API Token"
msgstr "Pagure பநிஇ கிள்ளாக்கு"

msgctxt "migrate.pagure.private_issues.summary"
msgid "Private Issues (Optional)"
msgstr "தனிப்பட்ட சிக்கல்கள் (விரும்பினால்)"

msgctxt "migrate.pagure.private_issues.description"
msgid ""
"This feature is designed to create a second repository containing only "
"private issues from your Pagure project for archive purposes. First, perform"
" a normal migration (without a token) to import all public content. Then, if"
" you have private issues to preserve, create a separate repository using "
"this token option to archive those private issues."
msgstr ""
"காப்பக நோக்கங்களுக்காக உங்கள் Pagure திட்டத்தில் இருந்து தனிப்பட்ட "
"சிக்கல்களை மட்டுமே கொண்ட இரண்டாவது களஞ்சியத்தை உருவாக்க இந்த நற்பொருத்தம் "
"வடிவமைக்கப்பட்டுள்ளது. முதலில், அனைத்து பொது உள்ளடக்கத்தையும் இறக்குமதி "
"செய்ய ஒரு சாதாரண இடம்பெயர்வை (டோக்கன் இல்லாமல்) செய்யவும். பின்னர், "
"உங்களிடம் தனிப்பட்ட சிக்கல்கள் இருந்தால், அந்தத் தனிப்பட்ட சிக்கல்களைக் "
"காப்பகப்படுத்த இந்த கிள்ளாக்கு விருப்பத்தைப் பயன்படுத்தி ஒரு தனி களஞ்சியத்தை"
" உருவாக்கவும்."

msgctxt "migrate.pagure.private_issues.warning"
msgid ""
"Be sure to set the repository visibility above to Private if you are using "
"the API key to import private issues. This prevents accidentally exposing "
"private content in a public repository."
msgstr ""
"தனிப்பட்ட சிக்கல்களை இறக்குமதி செய்ய பநிஇ விசையைப் பயன்படுத்தினால், மேலே "
"உள்ள களஞ்சியத் தெரிவுநிலையை தனிப்பட்டதாக அமைக்க மறக்காதீர்கள். இது பொது "
"களஞ்சியத்தில் தனிப்பட்ட உள்ளடக்கத்தை தற்செயலாக வெளிப்படுத்துவதைத் "
"தடுக்கிறது."

msgctxt "migrate.pagure.token.placeholder"
msgid "Only for creating private issues archive"
msgstr "தனிப்பட்ட சிக்கல்கள் காப்பகத்தை உருவாக்குவதற்கு மட்டுமே"

msgctxt "release.n_downloads"
msgid "%s download"
msgid_plural "%s downloads"
msgstr[0] "%s பதிவிறக்கம்"
msgstr[1] "%s பதிவிறக்கங்கள்"

msgctxt "gpg.default_key"
msgid "Signed with default key"
msgstr "இயல்புநிலை விசையுடன் கையொப்பமிடப்பட்டது"

msgctxt "gpg.error.extract_sign"
msgid "Failed to extract signature"
msgstr "கையொப்பத்தைப் பிரித்தெடுக்க முடியவில்லை"

msgctxt "gpg.error.generate_hash"
msgid "Failed to generate hash of commit"
msgstr "உறுதியின் ஆச் உருவாக்க முடியவில்லை"

msgctxt "gpg.error.no_committer_account"
msgid "No account linked to committer's email address"
msgstr "பொறுப்பாளரின் மின்னஞ்சல் முகவரியுடன் எந்தக் கணக்கும் இணைக்கப்படவில்லை"

msgctxt "gpg.error.no_gpg_keys_found"
msgid "No known key found for this signature in database"
msgstr "தரவுத்தளத்தில் இந்த கையொப்பத்திற்கான அறியப்பட்ட விசை எதுவும் இல்லை"

msgctxt "gpg.error.not_signed_commit"
msgid "Not a signed commit"
msgstr "கையெழுத்திட்ட உறுதிமொழி அல்ல"

msgctxt "gpg.error.failed_retrieval_gpg_keys"
msgid "Failed to retrieve any key attached to the committer's account"
msgstr ""
"பொறுப்பாளரின் கணக்கில் இணைக்கப்பட்ட எந்த விசையையும் மீட்டெடுப்பதில் தோல்வி"

msgctxt "gpg.error.probable_bad_signature"
msgid ""
"WARNING! Although there is a key with this ID in the database it does not "
"verify this commit! This commit is SUSPICIOUS."
msgstr ""
"எச்சரிக்கை! தரவுத்தளத்தில் இந்த ஐடியுடன் ஒரு விசை இருந்தாலும், இந்த "
"உறுதிமொழியை அது சரிபார்க்கவில்லை! இந்த உறுதிப்பாடு சந்தேகத்திற்குரியது."

msgctxt "gpg.error.probable_bad_default_signature"
msgid ""
"WARNING! Although the default key has this ID it does not verify this "
"commit! This commit is SUSPICIOUS."
msgstr ""
"எச்சரிக்கை! இயல்புநிலை விசையில் இந்த அடையாளம் இருந்தாலும், இந்த உறுதிமொழியை "
"அது சரிபார்க்கவில்லை! இந்த உறுதிப்பாடு சந்தேகத்திற்குரியது."

