msgctxt "actions.variables.edit"
msgid "Edit Variable"
msgstr "திருத்து மாறி"

msgctxt "actions.variables.not_found"
msgid "Failed to find the variable."
msgstr "மாறியைக் கண்டறிய முடியவில்லை."

msgctxt "actions.variables.update.failed"
msgid "Failed to edit variable."
msgstr "மாறியை திருத்த முடியவில்லை."

msgctxt "actions.variables.update.success"
