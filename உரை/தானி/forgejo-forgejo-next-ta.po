msgctxt "members.no_team_selected"
msgid "Organization members must belong to at least one team."
msgstr ""
"அமைப்பின் உறுப்பினர்கள் குறைந்தபட்சம் ஒரு குழுவைச் சேர்ந்தவர்களாக இருக்க "
"வேண்டும்."

msgctxt "pulls.manual_merge.helper"
msgid "Manual merge helper"
msgstr "கைமுறையாக ஒன்றிணைக்கும் உதவியாளர்"

msgctxt "pulls.manual_merge.helpder.description"
msgid "Use this merge commit message when completing the merge manually."
msgstr ""
"ஒன்றிணைப்பை கைமுறையாக முடிக்கும்போது இந்த ஒன்றிணைப்பு உறுதி செய்தியைப் "
"பயன்படுத்தவும்."

msgctxt "pulls.manual_merge.commit.title"
msgid "Merge commit title"
msgstr "உறுதி தலைப்பை இணைக்கவும்"

msgctxt "pulls.manual_merge.commit.body"
msgid "Merge commit body"
msgstr "உறுதி உடலை இணைக்கவும்"

msgctxt "pulls.manual_merge.copy.button"
msgid "Copy merge commit message"
msgstr "ஒன்றிணைக்கும் உறுதி செய்தியை நகலெடுக்கவும்"

msgctxt "admin.auths.oauth2_quota_group_claim_name"
msgid ""
"Claim name providing group names for this source to be used for quota "
"management. (Optional)"
msgstr ""
"இந்த மூலத்திற்கான குழுப் பெயர்களை வழங்குவதற்கான உரிமைகோரல் பெயர் ஒதுக்கீடு "
"மேலாண்மைக்கு பயன்படுத்தப்படும். (விரும்பினால்)"

msgctxt "admin.auths.oauth2_quota_group_map"
msgid ""
"Map claimed groups to quota groups. (Optional - requires claim name above)"
msgstr ""
"மேப் உரிமைகோரப்பட்ட குழுக்களுக்கு ஒதுக்கப்பட்ட குழுக்களுக்கு. (விரும்பினால் "
"- மேலே உள்ள உரிமைகோரல் பெயர் தேவை)"

msgctxt "admin.auths.oauth2_quota_group_map_removal"
msgid ""
"Remove users from synchronized quota groups if user does not belong to "
"corresponding group."
msgstr ""
"பயனர் தொடர்புடைய குழுவில் இல்லை என்றால், ஒத்திசைக்கப்பட்ட கோட்டா குழுக்களில்"
" இருந்து பயனர்களை அகற்றவும்."

msgctxt "editor.search"
msgid "Search"
msgstr "தேடல்"

msgctxt "editor.find_previous"
msgid "Previous find"
msgstr "முந்தைய கண்டுபிடிப்பு"

msgctxt "editor.find_next"
msgid "Next find"
msgstr "அடுத்த கண்டுபிடிப்பு"

msgctxt "editor.replace"
msgid "Replace"
msgstr "மாற்றவும்"

msgctxt "editor.replace_all"
msgid "Replace all"
msgstr "அனைத்தையும் மாற்றவும்"

msgctxt "editor.toggle_case"
msgid "Toggle case sensitivity"
msgstr "கேச் உணர்திறனை நிலைமாற்று"

msgctxt "editor.toggle_regex"
msgid "Toggle using regular expressions"
msgstr "வழக்கமான வெளிப்பாடுகளைப் பயன்படுத்தி மாறவும்"

msgctxt "editor.toggle_whole_word"
msgid "Toggle matching whole words"
msgstr "முழு வார்த்தைகளையும் பொருத்த நிலைமாற்று"

msgctxt "markup.filepreview.line"
msgid "Line %[1]d in %[2]s"
msgstr "%[2]s இல் வரி %[1]d"

msgctxt "markup.filepreview.lines"
msgid "Lines %[1]d to %[2]d in %[3]s"
msgstr "%[3]s இல் %[1]d முதல் %[2]d வரையிலான கோடுகள்"

msgctxt "markup.filepreview.truncated"
msgid "Preview has been truncated"
msgstr "முன்னோட்டம் துண்டிக்கப்பட்டது"

msgctxt "form.RunnerName"
msgid "Name"
msgstr "பெயர்"

msgctxt "graphs.recent_commits.title"
msgid "Number of commits in the past year"
msgstr "கடந்த ஆண்டில் செய்த கமிட்களின் எண்ணிக்கை"

msgctxt "graphs.code_frequency.title"
msgid "Code frequency over the history of {0}"
msgstr "{0} வரலாற்றில் குறியீடு அதிர்வெண்"

#, ignore-multiple-failures
msgctxt "meta.last_line"
msgid ""
"Thank you for translating Forgejo! This line isn't seen by the users but it "
"serves other purposes in the translation management. You can place a fun "
"fact in the translation instead of translating it."
msgstr ""
"Forgejo ஐ மொழிபெயர்த்ததற்கு நன்றி! இந்த வரியானது பயனர்களால் "
"பார்க்கப்படவில்லை, ஆனால் இது மொழிபெயர்ப்பு நிர்வாகத்தில் பிற நோக்கங்களுக்காக"
" உதவுகிறது. மொழிபெயர்ப்பிற்குப் பதிலாக ஒரு வேடிக்கையான உண்மையை "
"மொழிபெயர்ப்பில் வைக்கலாம்."
