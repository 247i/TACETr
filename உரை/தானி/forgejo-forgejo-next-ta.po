msgid "Choose $distribution and $component from the list below."
msgstr ""
"கீழே உள்ள பட்டியலில் இருந்து $distribution மற்றும் $component என்பதைத் "
"தேர்ந்தெடுக்கவும்."

msgctxt "packages.debian.repository.distributions"
msgid "Distributions"
msgstr "விநியோகங்கள்"

msgctxt "packages.debian.repository.components"
msgid "Components"
msgstr "கூறுகள்"

msgctxt "packages.debian.repository.architectures"
msgid "Architectures"
msgstr "கட்டமைப்புகள்"

msgctxt "packages.generic.download"
msgid "Download package from the command line:"
msgstr "கட்டளை வரியிலிருந்து தொகுப்பைப் பதிவிறக்கவும்:"

msgctxt "packages.go.install"
msgid "Install the package from the command line:"
msgstr "கட்டளை வரியிலிருந்து தொகுப்பை நிறுவவும்:"

msgctxt "packages.maven.registry"
msgid "Setup this registry in your project <code>pom.xml</code> file:"
msgstr ""
"இந்தப் பதிவேட்டை உங்கள் திட்டப்பணி <code>pom.xml</code> கோப்பில் அமைக்கவும்:"

msgctxt "packages.maven.install"
msgid ""
"To use the package include the following in the <code>dependencies</code> "
"block in the <code>pom.xml</code> file:"
msgstr ""
"தொகுப்பைப் பயன்படுத்த, <code>pom.xml</code> கோப்பில் உள்ள "
"<code>சார்புகள்</code> தொகுதியில் பின்வருவனவற்றைச் சேர்க்கவும்:"

msgctxt "packages.maven.install2"
msgid "Run via command line:"
msgstr "கட்டளை வரி வழியாக இயக்கவும்:"

msgctxt "packages.maven.download"
msgid "To download the dependency, run via command line:"
msgstr "சார்புநிலையைப் பதிவிறக்க, கட்டளை வரி வழியாக இயக்கவும்:"

msgctxt "packages.nuget.install"
msgid "To install the package using NuGet, run the following command:"
msgstr "NuGet ஐப் பயன்படுத்தி தொகுப்பை நிறுவ, பின்வரும் கட்டளையை இயக்கவும்:"

msgctxt "packages.nuget.dependency.framework"
msgid "Target Framework"
msgstr "இலக்கு கட்டமைப்பு"

msgctxt "packages.npm.registry"
msgid "Setup this registry in your project <code>.npmrc</code> file:"
msgstr ""
"இந்தப் பதிவேட்டை உங்கள் திட்டப்பணி <code>.npmrc</code> கோப்பில் அமைக்கவும்:"

msgctxt "packages.npm.install"
msgid "To install the package using npm, run the following command:"
msgstr "npm ஐப் பயன்படுத்தி தொகுப்பை நிறுவ, பின்வரும் கட்டளையை இயக்கவும்:"

msgctxt "packages.npm.install2"
msgid "or add it to the package.json file:"
msgstr "அல்லது pack.json கோப்பில் சேர்க்கவும்:"

msgctxt "packages.npm.dependencies.development"
msgid "Development dependencies"
msgstr "வளர்ச்சி சார்புகள்"

msgctxt "packages.npm.dependencies.bundle"
msgid "Bundled dependencies"
msgstr "தொகுக்கப்பட்ட சார்புகள்"

msgctxt "packages.npm.dependencies.peer"
msgid "Peer dependencies"
msgstr "தம சார்புகள்"

msgctxt "packages.npm.dependencies.optional"
msgid "Optional dependencies"
msgstr "விருப்ப சார்புகள்"

msgctxt "packages.npm.details.tag"
msgid "Tag"
msgstr "குறிச்சொல்"

msgctxt "packages.pypi.requires"
msgid "Requires Python"
msgstr "பைதான் தேவை"

msgctxt "packages.pypi.install"
msgid "To install the package using pip, run the following command:"
msgstr "பிப்பைப் பயன்படுத்தி தொகுப்பை நிறுவ, பின்வரும் கட்டளையை இயக்கவும்:"

msgctxt "packages.rpm.distros.redhat"
msgid "on RedHat based distributions"
msgstr "RedHat அடிப்படையிலான விநியோகங்களில்"

msgctxt "packages.rpm.distros.suse"
msgid "on SUSE based distributions"
msgstr "SUSE அடிப்படையிலான விநியோகங்களில்"

msgctxt "packages.rpm.repository.architectures"
msgid "Architectures"
msgstr "கட்டமைப்புகள்"

msgctxt "packages.rpm.repository.multiple_groups"
msgid "This package is available in multiple groups."
msgstr "இந்த தொகுப்பு பல குழுக்களில் கிடைக்கிறது."

msgctxt "packages.alt.install"
msgid "Install package"
msgstr "தொகுப்பை நிறுவவும்"

msgctxt "packages.alt.setup"
msgid ""
"Add a repository to the list of connected repositories (choose the necessary"
" architecture instead of \"_arch_\"):"
msgstr ""
"இணைக்கப்பட்ட களஞ்சியங்களின் பட்டியலில் ஒரு களஞ்சியத்தைச் சேர்க்கவும் "
"(\"_arch_\"க்குப் பதிலாக தேவையான கட்டமைப்பைத் தேர்வு செய்யவும்):"

msgctxt "packages.alt.repository.architectures"
msgid "Architectures"
msgstr "கட்டமைப்புகள்"

msgctxt "packages.alt.repository.multiple_groups"
msgid "This package is available in multiple groups."
msgstr "இந்த தொகுப்பு பல குழுக்களில் கிடைக்கிறது."

msgctxt "packages.rubygems.install"
msgid "To install the package using gem, run the following command:"
msgstr "செம் பயன்படுத்தி தொகுப்பை நிறுவ, பின்வரும் கட்டளையை இயக்கவும்:"

msgctxt "packages.rubygems.install2"
msgid "or add it to the Gemfile:"
msgstr "அல்லது செம்ஃபைலில் சேர்க்கவும்:"

msgctxt "packages.rubygems.dependencies.runtime"
msgid "Runtime dependencies"
msgstr "இயக்க நேர சார்புகள்"

msgctxt "packages.rubygems.dependencies.development"
msgid "Development dependencies"
msgstr "வளர்ச்சி சார்புகள்"

msgctxt "packages.rubygems.required.ruby"
msgid "Requires Ruby version"
msgstr "ரூபி பதிப்பு தேவை"

msgctxt "packages.rubygems.required.rubygems"
msgid "Requires RubyGem version"
msgstr "ரூபிசெம் பதிப்பு தேவை"

msgctxt "packages.swift.install"
msgid "Add the package in your <code>Package.swift</code> file:"
msgstr "உங்கள் <code>Package.swift</code> கோப்பில் தொகுப்பைச் சேர்க்கவும்:"

msgctxt "packages.swift.install2"
msgid "and run the following command:"
msgstr "மற்றும் பின்வரும் கட்டளையை இயக்கவும்:"

msgctxt "packages.vagrant.install"
msgid "To add a Vagrant box, run the following command:"
msgstr "அலைபாயும் பெட்டியைச் சேர்க்க, பின்வரும் கட்டளையை இயக்கவும்:"

msgctxt "packages.settings.link"
msgid "Link this package to a repository"
msgstr "இந்த தொகுப்பை ஒரு களஞ்சியத்துடன் இணைக்கவும்"

msgctxt "packages.settings.link.description"
msgid ""
"If you link a package with a repository, the package is listed in the "
"repository's package list."
msgstr ""
"நீங்கள் ஒரு தொகுப்பை ஒரு களஞ்சியத்துடன் இணைத்தால், தொகுப்பு களஞ்சியத்தின் "
"தொகுப்பு பட்டியலில் பட்டியலிடப்படும்."

msgctxt "packages.settings.link.select"
msgid "Select repository"
msgstr "களஞ்சியத்தைத் தேர்ந்தெடுக்கவும்"

msgctxt "packages.settings.link.button"
msgid "Update repository link"
msgstr "களஞ்சிய இணைப்பைப் புதுப்பிக்கவும்"

msgctxt "packages.settings.link.success"
msgid "Repository link was successfully updated."
msgstr "களஞ்சிய இணைப்பு வெற்றிகரமாக புதுப்பிக்கப்பட்டது."

msgctxt "packages.settings.link.error"
msgid "Failed to update repository link."
msgstr "களஞ்சிய இணைப்பைப் புதுப்பிக்க முடியவில்லை."

msgctxt "packages.settings.delete"
msgid "Delete package"
msgstr "தொகுப்பை நீக்கு"

msgctxt "packages.settings.delete.description"
msgid "Deleting a package is permanent and cannot be undone."
msgstr "தொகுப்பை நீக்குவது நிரந்தரமானது மற்றும் செயல்தவிர்க்க முடியாது."

msgctxt "packages.settings.delete.notice"
msgid ""
"You are about to delete %s (%s). This operation is irreversible, are you "
"sure?"
msgstr ""
"நீங்கள் %s (%s) ஐ நீக்க உள்ளீர்கள். இந்த செயல்பாடு மீள முடியாதது, நீங்கள் "
"உறுதியாக இருக்கிறீர்களா?"

msgctxt "packages.settings.delete.success"
msgid "The package has been deleted."
msgstr "தொகுப்பு நீக்கப்பட்டது."

msgctxt "packages.settings.delete.error"
msgid "Failed to delete the package."
msgstr "தொகுப்பை நீக்க முடியவில்லை."

msgctxt "packages.owner.settings.cargo.title"
msgid "Cargo registry index"
msgstr "சரக்கு பதிவு அட்டவணை"

msgctxt "packages.owner.settings.cargo.initialize"
msgid "Initialize index"
msgstr "குறியீட்டை துவக்கவும்"

msgctxt "packages.owner.settings.cargo.initialize.description"
msgid ""
"A special index Git repository is needed to use the Cargo registry. Using "
"this option will (re-)create the repository and configure it automatically."
msgstr ""
"சரக்கு பதிவேட்டைப் பயன்படுத்த ஒரு சிறப்பு குறியீட்டு Git களஞ்சியம் தேவை. "
"இந்த விருப்பத்தை பயன்படுத்தி (மீண்டும்) களஞ்சியத்தை உருவாக்கி, தானாகவே "
"கட்டமைக்கும்."

msgctxt "packages.owner.settings.cargo.initialize.error"
msgid "Failed to initialize Cargo index: %v"
msgstr "சரக்கு குறியீட்டை துவக்குவதில் தோல்வி: %v"

msgctxt "packages.owner.settings.cargo.initialize.success"
msgid "The Cargo index was successfully created."
msgstr "சரக்கு குறியீடு வெற்றிகரமாக உருவாக்கப்பட்டது."

msgctxt "packages.owner.settings.cargo.rebuild"
msgid "Rebuild index"
msgstr "குறியீட்டை மீண்டும் உருவாக்கவும்"

msgctxt "packages.owner.settings.cargo.rebuild.description"
msgid ""
"Rebuilding can be useful if the index is not synchronized with the stored "
"Cargo packages."
msgstr ""
"சேமிக்கப்பட்ட சரக்கு தொகுப்புகளுடன் குறியீட்டு ஒத்திசைக்கப்படாவிட்டால், "
"மறுகட்டமைப்பு பயனுள்ளதாக இருக்கும்."

msgctxt "packages.owner.settings.cargo.rebuild.error"
msgid "Failed to rebuild Cargo index: %v"
msgstr "சரக்கு குறியீட்டை மீண்டும் உருவாக்க முடியவில்லை: %v"

msgctxt "packages.owner.settings.cargo.rebuild.success"
msgid "The Cargo index was successfully rebuilt."
msgstr "சரக்கு குறியீடு வெற்றிகரமாக மறுகட்டமைக்கப்பட்டது."

msgctxt "packages.owner.settings.cargo.rebuild.no_index"
msgid "Cannot rebuild, no index is initialized."
msgstr "மறுகட்டமைக்க முடியாது, எந்த குறியீடும் துவக்கப்படவில்லை."

msgctxt "packages.owner.settings.cleanuprules.title"
msgid "Cleanup rules"
msgstr "துப்புரவு விதிகள்"

msgctxt "packages.owner.settings.cleanuprules.add"
msgid "Add cleanup rule"
msgstr "தூய்மைப்படுத்தும் விதியைச் சேர்க்கவும்"

msgctxt "packages.owner.settings.cleanuprules.edit"
msgid "Edit cleanup rule"
msgstr "தூய்மைப்படுத்தும் விதியைத் திருத்தவும்"

msgctxt "packages.owner.settings.cleanuprules.none"
msgid "There are no cleanup rules yet."
msgstr "துப்புரவு விதிகள் எதுவும் இல்லை."

msgctxt "packages.owner.settings.cleanuprules.preview"
msgid "Cleanup rule preview"
msgstr "துப்புரவு விதி மாதிரிக்காட்சி"

msgctxt "packages.owner.settings.cleanuprules.preview.overview"
msgid "%d packages are scheduled to be removed."
msgstr "%d தொகுப்புகள் அகற்றப்பட திட்டமிடப்பட்டுள்ளன."

msgctxt "packages.owner.settings.cleanuprules.preview.none"
msgid "Cleanup rule does not match any packages."
msgstr "துப்புரவு விதி எந்த தொகுப்புகளுடனும் பொருந்தவில்லை."

#. UI: label for a checkbox
msgctxt "packages.owner.settings.cleanuprules.pattern_full_match"
msgid "Apply pattern to full package name"
msgstr "முழு பேக்கேச் பெயருக்கு பேட்டர்னைப் பயன்படுத்தவும்"

msgctxt "packages.owner.settings.cleanuprules.keep.title"
msgid ""
"Versions that match these rules are kept, even if they match a removal rule "
"below."
msgstr ""
"கீழே உள்ள அகற்றுதல் விதியுடன் பொருந்தினாலும், இந்த விதிகளுடன் பொருந்தக்கூடிய"
" பதிப்புகள் வைக்கப்படும்."

msgctxt "packages.owner.settings.cleanuprules.keep.count"
msgid "Keep the most recent"
msgstr "மிகச் சமீபத்தியதை வைத்திருங்கள்"

msgctxt "packages.owner.settings.cleanuprules.keep.pattern"
msgid "Keep versions matching"
msgstr "பதிப்புகள் பொருத்தமாக இருக்கவும்"

msgctxt "packages.owner.settings.cleanuprules.keep.pattern.container"
msgid "The <code>latest</code> version is always kept for Container packages."
msgstr ""
"<code>சமீபத்திய</code> பதிப்பு எப்போதும் கொள்கலன் தொகுப்புகளுக்காக "
"வைக்கப்படும்."

msgctxt "packages.owner.settings.cleanuprules.remove.title"
msgid ""
"Versions that match these rules are removed, unless a rule above says to "
"keep them."
msgstr ""
"இந்த விதிகளுடன் பொருந்தக்கூடிய பதிப்புகள் அகற்றப்படும், மேலே உள்ள விதி "
"அவற்றை வைத்திருக்கும் வரை."

msgctxt "packages.owner.settings.cleanuprules.remove.days"
msgid "Remove versions older than"
msgstr "பழைய பதிப்புகளை அகற்று"

msgctxt "packages.owner.settings.cleanuprules.remove.pattern"
msgid "Remove versions matching"
msgstr "பொருந்தக்கூடிய பதிப்புகளை அகற்று"

msgctxt "packages.owner.settings.cleanuprules.success.update"
msgid "Cleanup rule has been updated."
msgstr "துப்புரவு விதி புதுப்பிக்கப்பட்டது."

msgctxt "packages.owner.settings.cleanuprules.success.delete"
msgid "Cleanup rule has been deleted."
msgstr "துப்புரவு விதி நீக்கப்பட்டது."

msgctxt "packages.owner.settings.chef.title"
msgid "Chef registry"
msgstr "சமையல்காரர் பதிவு"

msgctxt "packages.owner.settings.chef.keypair"
msgid "Generate key pair"
msgstr "முக்கிய சோடியை உருவாக்கவும்"

msgctxt "packages.owner.settings.chef.keypair.description"
msgid ""
"Requests sent to the Chef registry must be cryptographically signed as a "
"means of authentication. When generating a keypair, only the public key is "
"stored on Forgejo. The private key is provided to you to be used with knife."
" Generating a new keypair will overwrite the previous one."
msgstr ""
"செஃப் ரெசிச்ட்ரிக்கு அனுப்பப்படும் கோரிக்கைகள் கிரிப்டோகிராஃபிக் முறையில் "
"கையொப்பமிடப்பட வேண்டும். விசைப்பலகையை உருவாக்கும் போது, பொது விசை மட்டுமே "
"Forgejo இல் சேமிக்கப்படும். கத்தியுடன் பயன்படுத்த தனிப்பட்ட விசை உங்களுக்கு "
"வழங்கப்படுகிறது. புதிய விசை இணையை உருவாக்குவது முந்தையதை மேலெழுதும்."

msgctxt "access_token.error.specified_repos_none"
msgid ""
"Access tokens with specified repositories must have at least one repository."
msgstr ""
"குறிப்பிட்ட களஞ்சியங்களைக் கொண்ட அணுகல் டோக்கன்கள் குறைந்தபட்சம் ஒரு "
"களஞ்சியத்தையாவது கொண்டிருக்க வேண்டும்."

