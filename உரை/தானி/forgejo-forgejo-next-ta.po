msgctxt "home.welcome.no_activity"
msgid "No activity"
msgstr "செயல்பாடு இல்லை"

msgctxt "home.welcome.activity_hint"
msgid ""
"There is nothing in your feed yet. Your actions and activity from "
"repositories that you watch will show up here."
msgstr ""
"உங்கள் ஊட்டத்தில் இன்னும் எதுவும் இல்லை. நீங்கள் பார்க்கும் "
"களஞ்சியங்களிலிருந்து உங்கள் செயல்களும் செயல்பாடுகளும் இங்கே "
"காண்பிக்கப்படும்."

msgctxt "home.explore_repos"
msgid "Explore repositories"
msgstr "களஞ்சியங்களை ஆராயுங்கள்"

msgctxt "home.explore_users"
msgid "Explore users"
msgstr "பயனர்களை ஆராயுங்கள்"

msgctxt "home.explore_orgs"
msgid "Explore organizations"
msgstr "நிறுவனங்களை ஆராயுங்கள்"

#. Always used in aria labels. Used in tooltips if n>1000.
msgctxt "fork.n_forks"
msgid "%s fork"
msgid_plural "%s forks"
msgstr[0] "%s முட்கரண்டி"
msgstr[1] "%s ஃபோர்க்ச்"

msgctxt "stars.list.none"
msgid "No one starred this repo."
msgstr "இந்த ரெப்போவை யாரும் நட்சத்திரமிடவில்லை."

#. Always used in aria labels. Used in tooltips in n>1000.
msgctxt "stars.n_stars"
msgid "%s star"
msgid_plural "%s stars"
msgstr[0] "%s விண்மீன்"
msgstr[1] "%s நட்சத்திரங்கள்"

msgctxt "watch.list.none"
msgid "No one is watching this repo."
msgstr "இந்த ரெப்போவை யாரும் பார்ப்பதில்லை."

#. Only used in aria labels.
msgctxt "watch.n_watchers"
msgid "%s watcher"
msgid_plural "%s watchers"
msgstr[0] "%s பார்ப்பவர்"
msgstr[1] "%s பார்வையாளர்கள்"

msgctxt "followers.incoming.list.self.none"
msgid "No one is following your profile."
msgstr "உங்கள் சுயவிவரத்தை யாரும் பின்தொடரவில்லை."

msgctxt "followers.incoming.list.none"
msgid "No one is following this user."
msgstr "இந்தப் பயனரை யாரும் பின்தொடர்வதில்லை."

msgctxt "followers.outgoing.list.self.none"
msgid "You are not following anyone."
msgstr "நீங்கள் யாரையும் பின்தொடரவில்லை."

msgctxt "followers.outgoing.list.none"
msgid "%s isn't following anyone."
msgstr "%s யாரையும் பின்தொடரவில்லை."

msgctxt "relativetime.now"
msgid "now"
msgstr "இப்போது"

msgctxt "relativetime.future"
msgid "in future"
msgstr "எதிர்காலத்தில்"

msgctxt "relativetime.mins"
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "%d நிமிடத்திற்கு முன்பு"
msgstr[1] "%d நிமிடங்களுக்கு முன்பு"

msgctxt "relativetime.hours"
msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "%d மணிநேரத்திற்கு முன்பு"
msgstr[1] "%d மணிநேரத்திற்கு முன்பு"

msgctxt "relativetime.days"
msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "%d நாளுக்கு முன்பு"
msgstr[1] "%d நாட்களுக்கு முன்பு"

msgctxt "relativetime.weeks"
msgid "%d week ago"
msgid_plural "%d weeks ago"
msgstr[0] "%d வாரத்திற்கு முன்பு"
msgstr[1] "%d வாரங்களுக்கு முன்பு"

msgctxt "relativetime.months"
msgid "%d month ago"
msgid_plural "%d months ago"
msgstr[0] "%d மாதம் முன்பு"
msgstr[1] "%d மாதங்களுக்கு முன்பு"

msgctxt "relativetime.years"
msgid "%d year ago"
msgid_plural "%d years ago"
msgstr[0] "%d வருடம் முன்பு"
msgstr[1] "%d ஆண்டுகளுக்கு முன்பு"

msgctxt "relativetime.1day"
msgid "yesterday"
msgstr "நேற்று"

msgctxt "relativetime.1week"
msgid "last week"
msgstr "கடந்த வாரம்"

msgctxt "relativetime.1month"
msgid "last month"
msgstr "கடந்த மாதம்"

msgctxt "relativetime.1year"
msgid "last year"
msgstr "கடந்த ஆண்டு"

#. This is for screen readers only. Latest commit means the row in the table
#. before the actual files.
msgctxt "repo.files.caption"
msgid "Repository files (latest commit first)"
msgstr "களஞ்சிய கோப்புகள் (சமீபத்திய பொறுப்பு முதலில்)"

#. This is for screen readers only.
msgctxt "repo.files.filename"
msgid "Filename"
msgstr "கோப்புப்பெயர்"

#. This is for screen readers only. Last commit here does not refer to the
#. first row in the table, but to the latest change made to a file.
msgctxt "repo.files.last_commit_message"
msgid "Latest commit message"
msgstr "அண்மைக் கால உறுதி செய்தி"

#. This is for screen readers only.
msgctxt "repo.files.last_commit_date"
msgid "Latest commit date"
msgstr "அண்மைக் கால ஒப்பந்த தேதி"

msgctxt "repo.issues.filter_poster.hint"
msgid "Filter by the author"
msgstr "ஆசிரியரால் வடிகட்டவும்"

msgctxt "repo.issues.filter_assignee.hint"
msgid "Filter by assigned user"
msgstr "ஒதுக்கப்பட்ட பயனரின்படி வடிகட்டவும்"

msgctxt "repo.issues.filter_reviewers.hint"
msgid "Filter by user who reviewed"
msgstr "மதிப்பாய்வு செய்த பயனரின்படி வடிகட்டவும்"

msgctxt "repo.issues.filter_mention.hint"
msgid "Filter by mentioned user"
msgstr "குறிப்பிடப்பட்ட பயனரின்படி வடிகட்டவும்"

msgctxt "repo.issues.filter_modified.hint"
msgid "Filter by last modified date"
msgstr "கடைசியாக மாற்றியமைக்கப்பட்ட தேதியின்படி வடிகட்டவும்"

msgctxt "repo.issues.filter_sort.hint_with_placeholder"
msgid "Sort by: %s"
msgstr "இதன்படி வரிசைப்படுத்து: %s"

msgctxt "issues.updated"
msgid "updated %s"
msgstr "புதுப்பிக்கப்பட்டது %s"

msgctxt "issues.filters.labels.exclude"
msgid "Exclude label"
msgstr "சிட்டையை விலக்கு"

msgctxt "issues.filters.labels.unexclude"
msgid "Clear exclusion"
msgstr "விலக்கு துடை"

msgctxt "repo.pulls.auto_merge.no_permission"
msgid "You do not have permission to cancel this pull request's auto merge."
msgstr ""
"இந்த இழுத்தல் கோரிக்கையின் தானாக ஒன்றிணைவதை ரத்துசெய்ய உங்களுக்கு இசைவு "
"இல்லை."

msgctxt "repo.pulls.poster_manage_approval"
msgid "Manage approval"
msgstr "ஒப்புதலை நிர்வகிக்கவும்"

msgctxt "repo.pulls.poster_requires_approval"
msgid "Some workflows are <a href=\"%[1]s\">waiting to be reviewed</a>."
msgstr ""
"சில பணிப்பாய்வுகள் <a href=\"%[1]s\">மதிப்பாய்வுக்காகக் "
"காத்திருக்கின்றன</a>."

msgctxt "repo.pulls.poster_requires_approval.tooltip"
msgid ""
"The author of this pull request is not trusted to run workflows triggered by"
" a pull request created from a forked repository or with AGit. The workflows"
" triggered by a `pull_request` event will not run until they are approved."
msgstr ""
"இந்த இழுத்தல் கோரிக்கையின் ஆசிரியர், ஃபோர்க் செய்யப்பட்ட களஞ்சியத்திலிருந்து"
" அல்லது AGit மூலம் உருவாக்கப்பட்ட இழுத்தல் கோரிக்கையால் தூண்டப்பட்ட "
"பணிப்பாய்வுகளை இயக்க நம்பவில்லை. `புல்_ரிக்வெச்ட்` நிகழ்வால் தூண்டப்படும் "
"பணிப்பாய்வுகள் அங்கீகரிக்கப்படும் வரை இயங்காது."

msgctxt "repo.pulls.poster_is_trusted"
msgid ""
"The author of this pull request is <a href=\"%[1]s\">always trusted to run "
"workflows</a>."
msgstr ""
"இந்த இழுத்தல் கோரிக்கையின் ஆசிரியர் <a href=\"%[1]s\">எப்பொழுதும் "
"பணிப்பாய்வுகளை இயக்க நம்பகமானவர்</a>."

msgctxt "repo.pulls.poster_is_trusted.tooltip"
msgid ""
"The author of this pull request is explicitly trusted to run workflows "
"triggered by `pull_request` events."
msgstr ""
"இந்த இழுத்தல் கோரிக்கையின் ஆசிரியர், `புல்_ரிக்வெச்ட்` நிகழ்வுகளால் "
"தூண்டப்பட்ட பணிப்பாய்வுகளை இயக்க வெளிப்படையாக நம்புகிறார்."

msgctxt "repo.pulls.poster_trust_deny"
msgid "Deny"
msgstr "மறுக்கவும்"

msgctxt "repo.pulls.poster_trust_deny.tooltip"
msgid "The workflows waiting approval will be canceled."
msgstr "காத்திருப்பு பணிப்பாய்வு இசைவு ரத்து செய்யப்படும்."

msgctxt "repo.pulls.poster_trust_once"
msgid "Approve once"
msgstr "ஒரு முறை அங்கீகரிக்கவும்"

msgctxt "repo.pulls.poster_trust_once.tooltip"
msgid ""
"The workflows triggered by a `pull_request` event will run on this commit "
"but will need to be approved for all future commits pushed to this pull "
"request."
msgstr ""
"`புல்_ரிக்வெச்ட்` நிகழ்வால் தூண்டப்படும் பணிப்பாய்வுகள் இந்தக் கமிட்டில் "
"இயங்கும், ஆனால் இந்த இழுக்கக் கோரிக்கைக்கு தள்ளப்படும் அனைத்து எதிர்கால "
"கமிட்களுக்கும் அங்கீகரிக்கப்பட வேண்டும்."

msgctxt "repo.pulls.poster_trust_always"
msgid "Approve always"
msgstr "எப்போதும் அங்கீகரிக்கவும்"

msgctxt "repo.pulls.poster_trust_always.tooltip"
msgid ""
"The workflows triggered by a `pull_request` event will run on this commit "
"and there will be no need to approve runs from this pull request or future "
"pull requests authored by the same user."
msgstr ""
"`புல்_ரிக்வெச்ட்` நிகழ்வால் தூண்டப்படும் பணிப்பாய்வுகள் இந்த உறுதிப்பாட்டில்"
" இயங்கும், மேலும் இந்த இழுத்தல் கோரிக்கை அல்லது அதே பயனரால் எழுதப்பட்ட "
"எதிர்கால இழுப்புக் கோரிக்கைகளிலிருந்து ரன்களை அங்கீகரிக்க வேண்டிய "
"அவசியமில்லை."

msgctxt "repo.pulls.poster_trust_revoke"
msgid "Revoke"
msgstr "திரும்பப் பெறு"

msgctxt "repo.pulls.poster_trust_revoke.tooltip"
msgid ""
"The author of this pull request will no longer be trusted to run workflows "
"triggered by a `pull_request` event, each run will have to be manually "
"approved."
msgstr ""
"`புல்_ரிக்வெச்ட்` நிகழ்வால் தூண்டப்படும் பணிப்பாய்வுகளை இயக்க இந்த இழுத்தல் "
"கோரிக்கையின் ஆசிரியர் இனி நம்பப்படமாட்டார், ஒவ்வொரு ஓட்டமும் கைமுறையாக "
"அங்கீகரிக்கப்பட வேண்டும்."

msgctxt "repo.pulls.already_merged"
msgid "Merge failed: This pull request has already been merged."
msgstr ""
"ஒன்றிணைக்க முடியவில்லை: இந்த இழுத்தல் கோரிக்கை ஏற்கனவே "
"ஒன்றிணைக்கப்பட்டுள்ளது."

msgctxt "repo.pulls.merged_title_desc"
msgid ""
"merged %[1]d commit from <code>%[2]s</code> into <code>%[3]s</code> %[4]s"
msgid_plural ""
"merged %[1]d commits from <code>%[2]s</code> into <code>%[3]s</code> %[4]s"
msgstr[0] ""
"%[1]d கமிட் <code>%[2]s</code> இலிருந்து <code>%[3]s</code> %[4]s இல் "
"இணைக்கப்பட்டது"
msgstr[1] ""
"%[1]d ஆனது <code>%[2]s</code> இலிருந்து <code>%[3]s</code> %[4]s ஆக "
"இணைக்கப்பட்டது"

msgctxt "repo.pulls.title_desc"
msgid ""
"wants to merge %[1]d commit from <code>%[2]s</code> into <code "
"id=\"%[4]s\">%[3]s</code>"
msgid_plural ""
"wants to merge %[1]d commits from <code>%[2]s</code> into <code "
"id=\"%[4]s\">%[3]s</code>"
msgstr[0] ""
"<code>%[2]s</code> இலிருந்து %[1]d கமிட்ஐ <code id=\"%[4]s\">%[3]s</code> "
"இல் இணைக்க விரும்புகிறது"
msgstr[1] ""
"%[1]d கமிட்களை <code>%[2]s</code> இலிருந்து <code id=\"%[4]s\">%[3]s</code> "
"இல் இணைக்க விரும்புகிறது"

msgctxt "repo.pulls.maintainers_can_edit"
msgid "Maintainers can edit this pull request."
msgstr "இந்த இழுத்தல் கோரிக்கையை பராமரிப்பாளர்கள் திருத்தலாம்."

msgctxt "repo.pulls.maintainers_cannot_edit"
msgid "Maintainers cannot edit this pull request."
msgstr "இந்த இழுத்தல் கோரிக்கையை பராமரிப்பாளர்களால் திருத்த முடியாது."

msgctxt "repo.form.cannot_create"
msgid ""
"All spaces in which you can create repositories have reached the limit of "
"repositories."
msgstr ""
"நீங்கள் களஞ்சியங்களை உருவாக்கக்கூடிய அனைத்து இடங்களும் களஞ்சியங்களின் வரம்பை"
" எட்டியுள்ளன."

msgctxt "repo.view.gitmodules_too_large"
msgid ""
"The .gitmodules file is too large and will be ignored (on API calls for "
"instance)"
msgstr ""
".gitmodules கோப்பு மிகவும் பெரியது மற்றும் புறக்கணிக்கப்படும் (உதாரணமாக பநிஇ"
" அழைப்புகளில்)"

msgctxt "migrate.select.title"
msgid "Migrate repository"
msgstr "களஞ்சியத்தை நகர்த்தவும்"

msgctxt "migrate.form.error.url_credentials"
msgid ""
"The URL contains credentials, put them in the username and password fields "
"respectively"
msgstr ""
"முகவரி இல் நற்சான்றிதழ்கள் உள்ளன, அவற்றை முறையே பயனர்பெயர் மற்றும் "
"கடவுச்சொல் புலங்களில் வைக்கவும்"

msgctxt "migrate.github.description"
msgid "Migrate data from github.com or GitHub Enterprise server."
msgstr ""
"github.com அல்லது GitHub நிறுவனம் சேவையகத்திலிருந்து தரவை நகர்த்தவும்."

msgctxt "migrate.git.description"
msgid "Migrate a repository only from any Git service."
msgstr "எந்த Git சேவையிலிருந்தும் ஒரு களஞ்சியத்தை மட்டும் நகர்த்தவும்."

msgctxt "migrate.gitea.description"
msgid "Migrate data from gitea.com or other Gitea instances."
msgstr ""
"gitea.com அல்லது பிற அறிவிலிதேநீர் நிகழ்வுகளிலிருந்து தரவை நகர்த்தவும்."

msgctxt "migrate.gitlab.description"
msgid "Migrate data from gitlab.com or other GitLab instances."
msgstr "gitlab.com அல்லது பிற GitLab நிகழ்வுகளிலிருந்து தரவை நகர்த்தவும்."

msgctxt "migrate.gogs.description"
msgid "Migrate data from notabug.org or other Gogs instances."
