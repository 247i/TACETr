#: src/enum.gd:281
msgid "Unable to read file."
msgstr "கோப்பைப் படிக்க முடியவில்லை."

#: src/enum.gd:283
msgid "Invalid csv format."
msgstr "தவறான காபிம வடிவம்."

#: src/enum.gd:285
msgid "File too big. Max file size is {file_size}"
msgstr "கோப்பு மிகவும் பெரியது. அதிகபட்ச கோப்பு அளவு {file_size}"

#: src/enum.gd:287
msgid "File has non valid characters."
msgstr "கோப்பில் தவறான எழுத்துகள் உள்ளன."

#: src/enum.gd:289
msgid "Wrong amount of headers in first line, expected {header_size}"
msgstr ""
"முதல் வரியில் தவறான அளவு தலைப்புகள், எதிர்பார்க்கப்படும் {header_size}"

#: src/enum.gd:291
msgid "Wrong format of headers in first line, expected {headers}"
msgstr ""
"முதல் வரியில் தலைப்புகளின் தவறான வடிவம், எதிர்பார்க்கப்படும் {headers}"

#: src/enum.gd:293
msgid "No valid league was found in file."
msgstr "கோப்பில் சரியான லீக் எதுவும் இல்லை."

#: src/enum.gd:295
msgid "League {league_name} has less than 8 teams."
msgstr "லீக் {league_name} இல் 8 அணிகளுக்கும் குறைவான அணிகள் உள்ளன."

#: src/enum.gd:297
msgid "Nation {nation_name} has wrong format"
msgstr "நாடு {nation_name} தவறான வடிவமைப்பைக் கொண்டுள்ளது"

#: src/enum.gd:299
msgid "Nation {nation_name} not found"
msgstr "நாடு {nation_name} இல்லை"

#: src/enum.gd:301
msgid "League {league_name} has more than 20 teams."
msgstr "லீக் {league_name} இல் 20க்கும் மேற்பட்ட அணிகள் உள்ளன."

#: src/enum.gd:303
msgid "League with no name defined in line {line_number}"
msgstr "{line_number} என்ற வரியில் பெயர் இல்லாத லீக்"

#: src/enum.gd:305
msgid "Team with no name defined in line {line_number}"
msgstr "{line_number} என்ற வரியில் பெயர் இல்லாத அணி வரையறுக்கப்பட்டுள்ளது"

#: src/enum.gd:307
msgid "Undefined error occurred."
msgstr "வரையறுக்கப்படாத பிழை ஏற்பட்டது."

