#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.AiChatbotsRequests"
msgid "AI Chatbots Requests"
msgstr "AI Chatbots கோரிக்கைகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.AiChatbotsSegmentationTooltip"
msgid ""
"Segmentation isn't available for this metric because AI chatbot requests "
"(like those from ChatGPT) aren't linked to regular visits or visitors."
msgstr ""
"AI சாட்பாட் கோரிக்கைகள் (ChatGPT இன் கோரிக்கைகள் போன்றவை) வழக்கமான வருகைகள் "
"அல்லது பார்வையாளர்களுடன் இணைக்கப்படாததால், இந்த மெட்ரிக்கிற்குப் பிரிவு "
"கிடைக்கவில்லை."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.AllWebsitesDashboardDocumentation"
msgid ""
"This report gives you an informational overview for each of your websites, "
"containing the most general metrics about your visitors."
msgstr ""
"உங்கள் ஒவ்வொரு வலைத்தளங்களுக்கும் ஒரு செய்தி கண்ணோட்டத்தை இந்த அறிக்கை "
"உங்களுக்கு வழங்குகிறது, இதில் உங்கள் பார்வையாளர்களைப் பற்றிய பொதுவான "
"அளவீடுகள் உள்ளன."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.AllWebsitesDashboardErrorMessage"
msgid ""
"Data is currently unavailable. This could be due to a temporary server issue"
" or the report containing too much data. Please try again later. If the "
"problem continues, please contact your Matomo administrator for assistance."
msgstr ""
"தரவு தற்போது கிடைக்கவில்லை. இது ஒரு தற்காலிக சேவையக சிக்கல் அல்லது அதிக "
"தரவைக் கொண்ட அறிக்கை காரணமாக இருக்கலாம். தயவுசெய்து பின்னர் மீண்டும் "
"முயற்சிக்கவும். சிக்கல் தொடர்ந்தால், உதவிக்கு உங்கள் மாடோமோ நிர்வாகியை "
"தொடர்பு கொள்ளவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.AllWebsitesDashboardTitle"
msgid "All Websites"
msgstr "அனைத்து வலைத்தளங்களும்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.Evolution"
msgid "Evolution"
msgstr "பரிணாமம்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionComparisonDay"
msgid ""
"%1$s %2$s this day compared to %3$s %2$s in the previous partial period "
"(%4$s) Evolution: %5$s"
msgstr ""
"முந்தைய பகுதி காலத்தில் (%4$s) படிமலர்ச்சி வளர்ச்சியில் %3$s %2$s உடன் "
"ஒப்பிடும்போது இந்த நாளில் %1$s %2$s: %5$s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionComparisonIncomplete"
msgid "The currently selected time period is %1$s complete."
msgstr "தற்போது தேர்ந்தெடுக்கப்பட்ட கால அளவு %1$s முழுமையானது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionComparisonMonth"
msgid ""
"%1$s %2$s this month compared to %3$s %2$s in the previous partial period "
"(%4$s) Evolution: %5$s"
msgstr ""
"முந்தைய பகுதி காலத்தில் (%4$s) படிமலர்ச்சி வளர்ச்சியில் %3$s %2$s உடன் "
"ஒப்பிடும்போது இந்த மாதம் %1$s %2$s: %5$s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionComparisonProportional"
msgid ""
"When the previous period was also %1$s complete, there would have been an estimated %2$s %3$s\n"
"(out of a total of %4$s %3$s in the previous period)."
msgstr ""
"முந்தைய காலமும் %1$s முடிந்ததும், %2$s %3$s மதிப்பிடப்பட்டிருக்கும்\n"
"(முந்தைய காலகட்டத்தில் மொத்தம் %4$s %3$s இல்)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionComparisonWeek"
msgid ""
"%1$s %2$s this week compared to %3$s %2$s in the previous partial period "
"(%4$s) Evolution: %5$s"
msgstr ""
"முந்தைய பகுதி காலத்தில் (%4$s) படிமலர்ச்சி வளர்ச்சியில் %3$s %2$s உடன் "
"ஒப்பிடும்போது இந்த வாரம் %1$s %2$s: %5$s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionComparisonYear"
msgid ""
"%1$s %2$s this year compared to %3$s %2$s in the previous partial period "
"(%4$s) Evolution: %5$s"
msgstr ""
"முந்தைய பகுதி காலத்தில் (%4$s) படிமலர்ச்சி வளர்ச்சியில் %3$s %2$s உடன் "
"ஒப்பிடும்போது இந்த ஆண்டு %1$s %2$s: %5$s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionFromPreviousDay"
msgid "From previous day"
msgstr "முந்தைய நாளிலிருந்து"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionFromPreviousMonth"
msgid "From previous month"
msgstr "முந்தைய மாதத்திலிருந்து"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionFromPreviousPeriod"
msgid "From previous period"
msgstr "முந்தைய காலத்திலிருந்து"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionFromPreviousWeek"
msgid "From previous week"
msgstr "முந்தைய வாரத்திலிருந்து"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.EvolutionFromPreviousYear"
msgid "From previous year"
msgstr "முந்தைய ஆண்டிலிருந்து"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.LoadingWebsites"
msgid "Loading websites"
msgstr "வலைத்தளங்களை ஏற்றுகிறது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.MetricDocumentationAiChatbotsRequests"
msgid "Total number of AI chatbot requests recorded for this website."
msgstr ""
"இந்த இணையதளத்திற்காக பதிவுசெய்யப்பட்ட AI சாட்பாட் கோரிக்கைகளின் மொத்த "
"எண்ணிக்கை."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.MetricDocumentationEvolution"
msgid ""
"The percentage change for this metric compared to the previous period for "
"this website. A positive value indicates growth, while a negative value "
"signals a decrease."
msgstr ""
"இந்த வலைத்தளத்திற்கான முந்தைய காலசுழற்சிக்கு இந்த மெட்ரிக்குக்கான சதவீத "
"மாற்றத்தை ஒப்பிடுக. நேர்மாறான மதிப்பு வளர்ச்சியை குறிக்கும், மேலும் "
"எதிர்மாறான மதிப்பு குறைவை சுட்டுகிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.MetricDocumentationHits"
msgid ""
"The total number of recorded actions for this website, including pageviews, "
"downloads, and outlinks."
msgstr ""
"இந்த வலைத்தளத்திற்கான பதிவு செய்யப்பட்ட செயல்களின் மொத்த எண்ணிக்கை, பக்கக் "
"காட்சிகள், பதிவிறக்கங்கள், மற்றும் அவுட்லின்களையும் உள்ளடக்கியது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.MetricDocumentationHitsIncludingAi"
msgid ""
"The total number of recorded actions for this website, including pageviews, "
"downloads, outlinks and requests by AI chatbots."
msgstr ""
"பக்கப்பார்வைகள், பதிவிறக்கங்கள், இணைப்புகள் மற்றும் AI சாட்போட்களின் "
"கோரிக்கைகள் உட்பட, இந்த இணையதளத்திற்கான பதிவுசெய்யப்பட்ட செயல்களின் மொத்த "
"எண்ணிக்கை."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.MetricDocumentationPageviews"
msgid ""
"The total number of pages viewed on this website. This includes multiple "
"views of the same page by a single visitor."
msgstr ""
"இந்த வலைத்தளத்தில் பார்க்கப்பட்ட மொத்த பக்கங்களின் எண்ணிக்கை. இது ஒரே "
"பார்வையாளரால் ஒரே பக்கத்தை பல முறை பார்க்கும் வழக்கங்களையும் "
"உள்ளடக்கியுள்ளது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.MetricDocumentationRevenue"
msgid ""
"The total revenue tracked for this website. This metric is available if "
"Ecommerce tracking is enabled and reflects purchases or goal-based revenue."
msgstr ""
"இந்த வலைத்தளத்திற்கான மொத்த வருவாயை கண்காணிக்கப்பட்டது. இந்த மெட்ரிக் "
"கொள்முதல் அல்லது இலக்கு-அடிப்படையான வருவாயை பின்னோக்கி காட்டுகிறது, அது "
"மிகவும் வணிகத் கண்காணிப்பு இயக்கப்பட்டிருந்தால் கிடைக்கும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.MetricDocumentationVisits"
msgid ""
"The total number of visits recorded for this website. A visit starts when a "
"user accesses the site and ends after a period of inactivity or when the "
"session expires."
msgstr ""
"இந்த வலைத்தளத்திற்கு பதிவு செய்யப்பட்ட மொத்த வருகைகளின் எண்ணிக்கை. ஒரு பயனர்"
" தளத்தை அணுகும் போது ஒரு வருகை தொடங்குகிறது மற்றும் ஒரு காலசுழற்சி "
"முடிவடைந்ததும் அல்லது அமர்வு காலாவதியாகும் வரை முடிகிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.MetricDocumentationWebsite"
msgid ""
"The list of tracked websites displayed in the dashboard. Each row represents"
" a separate website with its corresponding analytics data."
msgstr ""
"டாஷ்போர்டில் காட்டப்படும் கண்காணிக்கப்பட்ட வலைத்தளங்களின் பட்டியல். ஒவ்வொரு "
"வரிசையும் அதனுடன் தொடர்புடைய பகுப்பாய்வு தரவுகளுடன் ஒரு தனி வலைத்தளத்தைக் "
"குறிக்கிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.PluginDescription"
msgid ""
"View and compare all your websites and apps in this useful 'All Websites' "
"dashboard."
msgstr ""
"இந்த பயனுள்ள 'அனைத்து வலைத்தளங்களும்' டாச்போர்டில் உங்கள் எல்லா "
"வலைத்தளங்களையும் பயன்பாடுகளையும் பார்த்து ஒப்பிட்டுப் பாருங்கள்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.SegmentationNotSupported"
msgid "Segmentation is not supported"
msgstr "பிரிவு ஆதரிக்கப்படவில்லை"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.SingleWebsitesDashboardDocumentation"
msgid ""
"This report gives you an informational overview for a specific website, "
"containing the most general metrics about your visitors."
msgstr ""
"இந்த அறிக்கை ஒரு குறிப்பிட்ட வலைத்தளத்திற்கான செய்தி கண்ணோட்டத்தை உங்களுக்கு"
" வழங்குகிறது, இதில் உங்கள் பார்வையாளர்களைப் பற்றிய பொதுவான அளவீடுகள் உள்ளன."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.TopLinkTooltip"
msgid "Compare Web Analytics stats for all of your Websites."
msgstr ""
"உங்கள் எல்லா வலைத்தளங்களுக்கும் வலை பகுப்பாய்வு புள்ளிவிவரங்களை ஒப்பிடுக."

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.TotalAiChatbotsRequests"
msgid "Total AI Chatbots Requests"
msgstr "மொத்த AI Chatbots கோரிக்கைகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.TotalHits"
msgid "Total Hits"
msgstr "மொத்த வெற்றிகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.TotalHitsIncludingAiTooltip"
msgid "Total Hits: Including all Human hits and AI Chatbots requests"
msgstr ""
"மொத்த வெற்றிகள்: அனைத்து மனித வெற்றிகள் மற்றும் AI Chatbots கோரிக்கைகள் "
"உட்பட"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.TotalPageviews"
msgid "Total Pageviews"
msgstr "மொத்த பக்கக் காட்சிகள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "MultiSites.TotalVisits"
msgid "Total Visits"
msgstr "மொத்த வருகைகள்"
