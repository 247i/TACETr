#: ../../src/utils/cas/docs/cas.1.in:39
msgid "~/.aMule/casrc"
msgstr "~/.aMule/casrc"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in:41
msgid ""
"aMule-online-sign.png (or .jpg, when B<-o> / B<--picture> is used and GD is "
"available)"
msgstr ""
"aMule-online-sign.png (அல்லது .jpg, B<-o> / B<--picture> பயன்படுத்தப்பட்டு "
"GD கிடைக்கும் போது)"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in:43
msgid "aMule-online-sign.html (when B<-p> / B<--html> is used)"
msgstr "aMule-online-sign.html (B<-p> / B<--html> பயன்படுத்தப்படும் போது)"

