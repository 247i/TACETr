#, no-wrap
msgid "aMule utilities"
msgstr "aMule பயன்பாடுகள்"

#. type: Plain text
#: amulecmd.1.in:7
msgid "amulecmd - Console-based program to control aMule"
msgstr "amulecmd - aMule ஐக் கட்டுப்படுத்த கன்சோல் அடிப்படையிலான நிரல்"

#. type: Plain text
#: amulecmd.1.in:13 amuleweb.1.in:12
msgid ""
"[B<-h> I<E<lt>hostE<gt>>] [B<-p> I<E<lt>portE<gt>>] [B<-P> "
"I<E<lt>passwordE<gt>>] [B<-f> I<E<lt>pathE<gt>>]"
msgstr ""
"[B<-h> I<E<lt>hostE<gt>>] [B<-p> I<E<lt>portE<gt>>] [B<-P> "
"I<E<lt>passwordE<gt>>] [B<-f> I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amulecmd.1.in:17
msgid ""
"[B<-l> I<E<lt>langE<gt>>] {B< >[B<-w>]B< >|B< >[B<-c> "
"I<E<lt>commandE<gt>>]B< >}"
msgstr ""
"[B<-l> I<E<lt>langE<gt>>] {B< >[B<-w>]B< >|B< >[B<-c> "
"I<E<lt>commandE<gt>>]B< >}"

#. type: Plain text
#: amulecmd.1.in:20 amuleweb.1.in:31
msgid "[B<--create-config-from>=I<E<lt>pathE<gt>>]"
msgstr "[B<--create-config-from>=I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amulecmd.1.in:29
msgid "B<amulecmd> is a console-based client to control aMule."
msgstr ""
"B<amulecmd> என்பது aMule ஐக் கட்டுப்படுத்த கன்சோல் அடிப்படையிலான கிளையன்ட் "
"ஆகும்."

#. type: TP
#: amulecmd.1.in:29 amuleweb.1.in:46
#, no-wrap
msgid "B<[ -h> I<E<lt>hostE<gt>>, B<--host>=I<E<lt>hostE<gt>> B<]>"
msgstr "B<[ -h> I<E<l>hostEL<gtB<--host>=I<E<l>hostE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in:33 amuleweb.1.in:50
msgid ""
"Host where aMule is running (default: I<127.0.0.1>).  I<E<lt>hostE<gt>> "
"might be an IP address or a DNS name"
msgstr ""
"aMule இயங்கும் புரவலன் (இயல்புநிலை: I<127.0.0.1>). I<E<lt>hostE<gt>> என்பது "
"IP முகவரி அல்லது DNS பெயராக இருக்கலாம்"

#. type: TP
#: amulecmd.1.in:33 amuleweb.1.in:50
#, no-wrap
msgid "B<[ -p> I<E<lt>portE<gt>>, B<--port>=I<E<lt>portE<gt>> B<]>"
msgstr "B<[ -p> I<E<lt>portE<gt>>, B<--port>=I<E<lt>portE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in:36 amuleweb.1.in:53
msgid ""
"aMule's port for External Connections, as set in Preferences-E<gt>Remote "
"Controls (default: I<4712>)"
msgstr ""
"வெளிப்புற இணைப்புகளுக்கான aMule இன் துறைமுகம், முன்னுரிமைகள்-E<gt>ரிமோட் "
"கண்ட்ரோல்களில் அமைக்கப்பட்டுள்ளது (இயல்புநிலை: I<4712>)"

#. type: TP
#: amulecmd.1.in:36 amuleweb.1.in:53
#, no-wrap
msgid ""
"B<[ -P> I<E<lt>passwordE<gt>>, B<--password>=I<E<lt>passwordE<gt>> B<]>"
msgstr "B<[ -P> I<E<l>கடவுச்சொல்<dB<--password>=IN<lt>passwordE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in:39 amuleweb.1.in:56
msgid "External Connections password."
msgstr "வெளிப்புற இணைப்புகளின் கடவுச்சொல்."

#. type: TP
#: amulecmd.1.in:39 amuleweb.1.in:56
#, no-wrap
msgid "B<[ -f> I<E<lt>pathE<gt>>, B<--config-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -f> I<E<lt>pathE<gt>>, B<--config-file>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in:43 amuleweb.1.in:60
msgid ""
"Use the given configuration file.  Default configuration file is "
"I<~/.aMule/remote.conf>"
msgstr ""
"கொடுக்கப்பட்ட உள்ளமைவு கோப்பைப் பயன்படுத்தவும். இயல்புநிலை உள்ளமைவு கோப்பு "
"I<~/.aMule/remote.conf> ஆகும்"

#. type: Plain text
#: amulecmd.1.in:46 amuleweb.1.in:63
msgid "Do not print any output to stdout."
msgstr "stdout க்கு எந்த வெளியீட்டையும் அச்சிட வேண்டாம்."

#. type: Plain text
#: amulecmd.1.in:50 amuleweb.1.in:67
msgid "Be verbose - show also debug messages."
msgstr "வாய்மொழியாக இருங்கள் - பிழைத்திருத்த செய்திகளையும் காட்டுங்கள்."

#. type: TP
#: amulecmd.1.in:50 amuleweb.1.in:67
#, no-wrap
msgid "B<[ -l> I<E<lt>langE<gt>>, B<--locale>=I<E<lt>langE<gt>> B<]>"
msgstr "B<[ -l> I<E<lt>langE<gt>>, B<--locale>=I<E<lt>langE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in:54 amuleweb.1.in:71
msgid ""
"Sets program locale (language).  See the B<NOTES> section for the "
"description of the I<E<lt>langE<gt>> parameter."
msgstr ""
"நிரல் மொழியை (மொழி) அமைக்கிறது. I<E<lt>langE<gt>> அளவுருவின் விளக்கத்திற்கு "
"B<NOTES> பகுதியைப் பார்க்கவும்."

#. type: Plain text
#: amulecmd.1.in:57 amuleweb.1.in:74
msgid "Write command line options to config file and exit"
msgstr "கோப்பை கட்டமைப்பு செய்து வெளியேற கட்டளை வரி விருப்பங்களை எழுதவும்"

#. type: TP
#: amulecmd.1.in:57
#, no-wrap
msgid "B<[ -c> I<E<lt>commandE<gt>>, B<--command>=I<E<lt>commandE<gt>> B<]>"
msgstr "B<[ -c> I<E<lt>commandE<gdB<--command>=IN<lte>commandE<gat>> B<]>"

#. type: Plain text
#: amulecmd.1.in:60
msgid ""
"Execute I<E<lt>commandE<gt>> as if it was entered at amulecmd's prompt and "
"exit."
msgstr ""
"I<E<lt>commandE<gt>> ஐ இயக்கவும், அது amulecmd இன் வரியில் உள்ளிட்டு "
"வெளியேறவும்."

#. type: TP
#: amulecmd.1.in:60 amuleweb.1.in:117
#, no-wrap
msgid "B<[ --create-config-from>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ --create-config-from>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in:63 amuleweb.1.in:120
msgid ""
"Create config file based upon I<E<lt>pathE<gt>>, which must point to a valid"
" aMule config file, and then exit."
msgstr ""
"I<E<lt>pathE<gt>> அடிப்படையிலான கட்டமைப்பு கோப்பை உருவாக்கவும், இது சரியான "
"aMule கட்டமைப்பு கோப்பைக் குறிக்க வேண்டும், பின்னர் வெளியேறவும்."

#. type: Plain text
#: amulecmd.1.in:67 amuleweb.1.in:124
msgid ""
"Force ZLIB compression on the External Connection link regardless of the "
"dialed-IP locality.  Useful when the server side is reachable over a VPN "
"tunnel that resolves to a LAN IP and the heuristic would otherwise skip "
"compression."
msgstr ""
"டயல் செய்யப்பட்ட-ஐபி இருப்பிடத்தைப் பொருட்படுத்தாமல் வெளிப்புற இணைப்பு "
"இணைப்பில் ZLIB சுருக்கத்தை கட்டாயப்படுத்தவும். லேன் ஐபிக்கு தீர்வு காணும் "
"VPN சுரங்கப்பாதையில் சர்வர் பக்கத்தை அடையும் போது பயனுள்ளதாக இருக்கும், "
"இல்லையெனில் ஊரிச்டிக் சுருக்கத்தைத் தவிர்க்கும்."

#. type: SH
#: amulecmd.1.in:73
#, no-wrap
msgid "COMMANDS"
msgstr "கட்டளைகள்"

#. type: Plain text
#: amulecmd.1.in:75
msgid "All commands are case insensitive."
msgstr "அனைத்து கட்டளைகளும் கேச் சென்சிட்டிவ்."

#. type: Plain text
#: amulecmd.1.in:77
msgid "Adds an eD2k-link or a magnet-link to the core."
msgstr "மையத்தில் eD2k-இணைப்பு அல்லது காந்த-இணைப்பைச் சேர்க்கிறது."

#. type: Plain text
#: amulecmd.1.in:86
msgid ""
"a serverlist link, in which case all servers in the list will be added to "
"the server list."
msgstr ""
"சர்வர்லிச்ட் இணைப்பு, இதில் பட்டியலில் உள்ள அனைத்து சர்வர்களும் சர்வர் "
"பட்டியலில் சேர்க்கப்படும்."

#. type: Plain text
#: amulecmd.1.in:89
msgid "The magnet link must contain the eD2k hash and file length."
msgstr "காந்த இணைப்பில் eD2k ஆச் மற்றும் கோப்பு நீளம் இருக்க வேண்டும்."

#. type: Plain text
#: amulecmd.1.in:91
msgid ""
"Cancels the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. "
"To get the value use B<show>."
msgstr ""
"I<E<l>have<got>> அல்லது I<E<s t>number<get>> மூலம் குறிப்பிடப்பட்ட "
"பதிவிறக்கத்தை ரத்துசெய்கிறது. மதிப்பைப் பெற B<show> ஐப் பயன்படுத்தவும்."

#. type: Plain text
#: amulecmd.1.in:93
msgid "Connect to the network."
msgstr "பிணையத்துடன் இணைக்கவும்."

#. type: Plain text
#: amulecmd.1.in:95
msgid "This will connect to all networks that are enabled in Preferences."
msgstr ""
"இது விருப்பத்தேர்வுகளில் இயக்கப்பட்ட அனைத்து நெட்வொர்க்குகளுடனும் "
"இணைக்கப்படும்."

#. type: Plain text
#: amulecmd.1.in:99
msgid ""
"With the optional parameter you can specify which network to connect to. "
"Giving a server address in the form of IP:Port (where IP is either a dotted "
"decimal IPv4 address or a resolvable DNS name) aMule will connect to that "
"server only."
msgstr ""
"விருப்ப அளவுருவுடன் எந்த நெட்வொர்க்குடன் இணைக்க வேண்டும் என்பதை நீங்கள் "
"குறிப்பிடலாம். IP:Port (ஐபி என்பது புள்ளியிடப்பட்ட தசம IPv4 முகவரி அல்லது "
"தீர்க்கக்கூடிய DNS பெயர்) வடிவத்தில் சேவையக முகவரியை வழங்கினால், aMule அந்த "
"சேவையகத்துடன் மட்டுமே இணைக்கப்படும்."

#. type: Plain text
#: amulecmd.1.in:102
msgid ""
"Disconnect from all networks you are connected to, or just disconnect from "
"the specified network."
msgstr ""
"நீங்கள் இணைக்கப்பட்டுள்ள அனைத்து நெட்வொர்க்குகளிலிருந்தும் துண்டிக்கவும் "
"அல்லது குறிப்பிட்ட நெட்வொர்க்கிலிருந்து துண்டிக்கவும்."

#. type: Plain text
#: amulecmd.1.in:104
msgid "Start downloading a file."
msgstr "கோப்பைப் பதிவிறக்கத் தொடங்குங்கள்."

#. type: Plain text
#: amulecmd.1.in:108
msgid ""
"The I<E<lt>numberE<gt>> of a file from the last search has to be given.  "
"Example: `download 12' will start to download the file with the number 12 of"
" the previous search."
msgstr ""
"கடைசி தேடலில் இருந்து ஒரு கோப்பின் I<E<lt>numberE<gt>> கொடுக்கப்பட வேண்டும்."
" எடுத்துக்காட்டு: `பதிவிறக்கம் 12' முந்தைய தேடலின் எண் 12 உடன் கோப்பைப் "
"பதிவிறக்கத் தொடங்கும்."

#. type: Plain text
#: amulecmd.1.in:110
msgid "Disconnect from amule/amuled and quit amulecmd."
msgstr ""
"amule/amuled இலிருந்து துண்டிக்கவும் மற்றும் amulecmd ஐ விட்டு வெளியேறவும்."

#. type: Plain text
#: amulecmd.1.in:112
msgid "Get and display a preference value."
msgstr "விருப்ப மதிப்பைப் பெற்றுக் காட்டவும்."

#. type: Plain text
#: amulecmd.1.in:114 amulecmd.1.in:148 amulecmd.1.in:197 amulecmd.1.in:207
msgid "Available values for I<E<lt>whatE<gt>>:"
msgstr "I<E<lt>whatE<gt>>க்கான கிடைக்கும் மதிப்புகள்:"

#. type: Plain text
#: amulecmd.1.in:117
msgid "Get bandwidth limits."
msgstr "அலைவரிசை வரம்புகளைப் பெறுங்கள்."

#. type: Plain text
#: amulecmd.1.in:119
msgid "Get IPFilter preferences."
msgstr "IPFilter விருப்பங்களைப் பெறுங்கள்."

#. type: Plain text
#: amulecmd.1.in:124
msgid ""
"Prints a short usage description.  If called without parameter, it shows a "
"list of available commands.  If called with I<E<lt>commandE<gt>>, it shows a"
" short description of the given command."
msgstr ""
"ஒரு சிறிய பயன்பாட்டு விளக்கத்தை அச்சிடுகிறது. அளவுரு இல்லாமல் "
"அழைக்கப்பட்டால், அது கிடைக்கக்கூடிய கட்டளைகளின் பட்டியலைக் காட்டுகிறது. "
"I<E<lt>commandE<gt>> என்று அழைக்கப்பட்டால், கொடுக்கப்பட்ட கட்டளையின் "
"சுருக்கமான விளக்கத்தைக் காட்டுகிறது."

#. type: Plain text
#: amulecmd.1.in:126
msgid ""
"Pauses the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. "
"To get the value use B<show>."
msgstr ""
"I<E<l>have<got>> அல்லது I<E<s t>number<get>> மூலம் குறிப்பிடப்பட்ட "
"பதிவிறக்கத்தை இடைநிறுத்துகிறது. மதிப்பைப் பெற B<show> ஐப் பயன்படுத்தவும்."

#. type: Plain text
#: amulecmd.1.in:128
msgid ""
"Set priority of a download specified by I<E<lt>hashE<gt>> or "
"I<E<lt>numberE<gt>>."
msgstr ""
"I<E<lt>hashE<gt>> அல்லது I<E<lt>numberE<gt>> மூலம் குறிப்பிடப்பட்ட "
"பதிவிறக்கத்தின் முன்னுரிமையை அமைக்கவும்."

#. type: Plain text
#: amulecmd.1.in:130
msgid "Available values for I<E<lt>priorityE<gt>>:"
msgstr "I<E<lt>priorityE<gt>>க்கான கிடைக்கும் மதிப்புகள்:"

#. type: Plain text
#: amulecmd.1.in:133
msgid "Automatic priority."
msgstr "தானியங்கி முன்னுரிமை."

#. type: Plain text
#: amulecmd.1.in:135
msgid "High priority."
msgstr "அதிக முன்னுரிமை."

#. type: Plain text
#: amulecmd.1.in:137
msgid "Low priority."
msgstr "குறைந்த முன்னுரிமை."

#. type: Plain text
#: amulecmd.1.in:139
msgid "Normal priority."
msgstr "சாதாரண முன்னுரிமை."

#. type: Plain text
#: amulecmd.1.in:142
msgid "Shows the progress of an on-going search."
msgstr "நடந்துகொண்டிருக்கும் தேடலின் முன்னேற்றத்தைக் காட்டுகிறது."

#. type: Plain text
#: amulecmd.1.in:144
msgid "A synonym of the B<exit> command."
msgstr "B<exit> கட்டளையின் இணைச்சொல்."

#. type: Plain text
#: amulecmd.1.in:146
msgid "Reloads a given object."
msgstr "கொடுக்கப்பட்ட பொருளை மீண்டும் ஏற்றுகிறது."

#. type: Plain text
#: amulecmd.1.in:151
msgid "Reload shared files list."
msgstr "பகிரப்பட்ட கோப்புகளின் பட்டியலை மீண்டும் ஏற்றவும்."

#. type: Plain text
#: amulecmd.1.in:153
msgid "Reload IP filter tables."
msgstr "ஐபி வடிகட்டி அட்டவணைகளை மீண்டும் ஏற்றவும்."

#. type: Plain text
#: amulecmd.1.in:156
msgid "Reset the log."
msgstr "பதிவை மீட்டமைக்கவும்."

#. type: Plain text
#: amulecmd.1.in:158
msgid "Shows you the results of the last search."
msgstr "கடைசி தேடலின் முடிவுகளை உங்களுக்குக் காட்டுகிறது."

#. type: Plain text
#: amulecmd.1.in:160
msgid ""
"Resumes the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. "
"To get the value use B<show>."
msgstr ""
"I<E<l>have<got>> அல்லது I<E<s t>number<get>> மூலம் குறிப்பிடப்பட்ட "
"பதிவிறக்கத்தை மீண்டும் தொடங்கும். மதிப்பைப் பெற B<show> ஐப் பயன்படுத்தவும்."

#. type: Plain text
#: amulecmd.1.in:164
msgid ""
"Makes a search for the given I<E<lt>keywordE<gt>>. A search type and a "
"keyword to search is mandatory to do this.  Example: `search kad amule' "
"performs a kad search for `amule'."
msgstr ""
"கொடுக்கப்பட்ட I<E<lt>keywordE<gt>>ஐத் தேடுகிறது. இதைச் செய்ய, ஒரு தேடல் வகை "
"மற்றும் தேடுவதற்கு ஒரு முக்கிய சொல் தேவை. உதாரணம்: `search kad amule' என்பது"
" `amule' க்கான கேட் தேடலைச் செய்கிறது."

#. type: Plain text
#: amulecmd.1.in:166
msgid "Available search types:"
msgstr "கிடைக்கும் தேடல் வகைகள்:"

#. type: Plain text
#: amulecmd.1.in:169
msgid "Performs a global search."
msgstr "உலகளாவிய தேடலைச் செய்கிறது."

#. type: Plain text
#: amulecmd.1.in:171
msgid "Performs a search on the Kademlia network."
msgstr "Kademlia நெட்வொர்க்கில் ஒரு தேடலைச் செய்கிறது."

#. type: Plain text
#: amulecmd.1.in:173
msgid "Performs a local search."
msgstr "உள்ளக தேடலைச் செய்கிறது."

#. type: Plain text
#: amulecmd.1.in:177
msgid ""
"Optional filters can be placed before, after, or interleaved with the search"
" keyword(s):"
msgstr ""
"விருப்ப வடிப்பான்கள் தேடல் திறவுச்சொல்(கள்)க்கு முன், பின் அல்லது "
"ஒன்றோடொன்று இணைக்கப்படலாம்:"

#. type: Plain text
#: amulecmd.1.in:180
msgid "Restrict results to the given file type."
msgstr "கொடுக்கப்பட்ட கோப்பு வகைக்கு முடிவுகளை வரம்பிடவும்."

#. type: Plain text
#: amulecmd.1.in:182
msgid "Restrict results to a specific file extension (e.g.\\ I<iso>, I<mp3>)."
msgstr ""
"ஒரு குறிப்பிட்ட கோப்பு நீட்டிப்புக்கு முடிவுகளை வரம்பிடவும் (எ.கா.\\ I<iso>,"
" I<mp3>)."

#. type: Plain text
#: amulecmd.1.in:184
msgid "Minimum number of sources a result must report."
msgstr "ஒரு முடிவைப் புகாரளிக்க வேண்டிய குறைந்தபட்ச ஆதாரங்களின் எண்ணிக்கை."

#. type: Plain text
#: amulecmd.1.in:187
msgid ""
"Smallest file size to return. Suffixes use binary multipliers (K = 1024, M ="
" K\\(mu1024, G = M\\(mu1024); no suffix means bytes."
msgstr ""
"திரும்பப் பெற வேண்டிய சிறிய கோப்பு அளவு. பின்னொட்டுகள் பைனரி பெருக்கிகளைப் "
"பயன்படுத்துகின்றன (K = 1024, M = K\\(mu1024, G = M\\(mu1024); பின்னொட்டு "
"இல்லை என்றால் பைட்டுகள்."

#. type: Plain text
#: amulecmd.1.in:189
msgid "Largest file size to return. Same suffixes as B<--min-size>."
msgstr ""
"திரும்பப் பெற வேண்டிய மிகப்பெரிய கோப்பு அளவு. B<--min-size> போன்ற அதே "
"பின்னொட்டுகள்."

#. type: Plain text
#: amulecmd.1.in:193
msgid ""
"Example: `search global linux iso --type Iso --min-size 100M' returns "
"results for \\(lqlinux iso\\(rq of file-type Iso at least 100 MiB."
msgstr ""
"எடுத்துக்காட்டு: `சர்ச் க்ளோபல் லினக்ச் ஐசோ --டைப் ஐசோ --மைன்-சைச் 100 எம்' "
"\\(lqlinux iso\\(rq கோப்பு வகை Iso இன் குறைந்தது 100 MiB)க்கான முடிவுகளை "
"வழங்குகிறது."

#. type: Plain text
#: amulecmd.1.in:195
msgid "Sets a given preferences value."
msgstr "கொடுக்கப்பட்ட முன்னுரிமை மதிப்பை அமைக்கிறது."

#. type: Plain text
#: amulecmd.1.in:200
msgid "Set bandwidth limits."
msgstr "Set பட்டை அகலம் limits."

#. type: Plain text
#: amulecmd.1.in:202
msgid "Set IPFilter preferences."
msgstr "IPFilter விருப்பங்களை அமைக்கவும்."

#. type: Plain text
#: amulecmd.1.in:205
msgid "Shows upload/download queue, servers list or shared files list."
msgstr ""
"பதிவேற்ற/பதிவிறக்க வரிசை, சர்வர்கள் பட்டியல் அல்லது பகிரப்பட்ட கோப்புகள் "
"பட்டியலைக் காட்டுகிறது."

#. type: Plain text
#: amulecmd.1.in:210
msgid "Show download queue."
msgstr "பதிவிறக்க வரிசையைக் காட்டு."

#. type: Plain text
#: amulecmd.1.in:212
msgid "Show log."
msgstr "பதிவைக் காட்டு."

#. type: Plain text
#: amulecmd.1.in:214
msgid "Show servers list."
msgstr "சேவையகங்களின் பட்டியலைக் காட்டு."

#. type: Plain text
#: amulecmd.1.in:216
msgid "Show shared files list."
msgstr "பகிரப்பட்ட கோப்புகளின் பட்டியலைக் காட்டு."

#. type: Plain text
#: amulecmd.1.in:218
msgid "Show upload queue."
msgstr "பதிவேற்ற வரிசையைக் காட்டு."

#. type: Plain text
#: amulecmd.1.in:222
msgid ""
"Shutdown the remote running core (amule/amuled).  This will also shut down "
"the text client, since it is unusable without a running core."
msgstr ""
"ரிமோட் இயங்கும் மையத்தை (அமுல்/அமுல்ட்) நிறுத்தவும். இது இயங்கும் கோர் "
"இல்லாமல் பயன்படுத்த முடியாததால், உரை கிளையண்ட்டையும் மூடும்."

#. type: Plain text
#: amulecmd.1.in:224
msgid "Show statistics tree."
msgstr "புள்ளிவிவர மரத்தைக் காட்டு."

#. type: Plain text
#: amulecmd.1.in:228
msgid ""
"The optional I<E<lt>numberE<gt>> in the range of 0-255 can be passed as "
"argument to this command, which tells how many entries of the client version"
" subtree should be shown. Passing 0, or omitting it means `unlimited'."
msgstr ""
"0-255 வரம்பில் உள்ள விருப்பமான I<E<lt>numberE<gt>> இந்த கட்டளைக்கு வாதமாக "
"அனுப்பப்படலாம், இது கிளையன்ட் பதிப்பு சப்ட்ரீயின் எத்தனை உள்ளீடுகள் "
"காட்டப்பட வேண்டும் என்பதைக் கூறுகிறது. 0 ஐக் கடப்பது அல்லது அதைத் தவிர்ப்பது"
" `வரம்பற்றது' என்று பொருள்."

#. type: Plain text
#: amulecmd.1.in:231
msgid ""
"Example: `statistics 5' will show only the top 5 versions for each client "
"type."
msgstr ""
"எடுத்துக்காட்டு: `புள்ளிவிவரங்கள் 5' ஒவ்வொரு கிளையன்ட் வகைக்கும் முதல் 5 "
"பதிப்புகளை மட்டுமே காண்பிக்கும்."

#. type: Plain text
#: amulecmd.1.in:233
msgid "Show connection status, current up/download speeds, etc."
msgstr "இணைப்பு நிலை, தற்போதைய உயர்/பதிவிறக்க விரைவு போன்றவற்றைக் காட்டு."

#. type: SS
#: amulecmd.1.in:238 amuleweb.1.in:141
#, no-wrap
msgid "Languages"
msgstr "மொழிகள்"

#. type: Plain text
#: amulecmd.1.in:244 amuleweb.1.in:147
msgid ""
"The I<E<lt>langE<gt>> parameter for the B<-l> option has the following form:"
" I<lang>[B<_>I<LANG>][B<.>I<encoding>][B<@>I<modifier>] where I<lang> is the"
" primary language, I<LANG> is a sublanguage/territory, I<encoding> is the "
"character set to use and I<modifier> allows the user to select a specific "
"instance of localization data within a single category."
msgstr ""
"B<-l> விருப்பத்துக்கான I<E<lt>langE<gt>> அளவுரு பின்வரும் படிவத்தைக் "
"கொண்டுள்ளது: I<lang>[B<_>I<LANG>][B<.>I<encoding>][B<@>I<modifier>] இங்கு "
"I<lang> முதன்மை மொழி, I<LANG> என்பது ஒரு துணைமொழி/பிரதேசத்தைப் பயன்படுத்த "
"அனுமதிக்கிறது> மேலும், I< ஒரு வகைக்குள் உள்ளூர்மயமாக்கல் தரவின் குறிப்பிட்ட "
"நிகழ்வைத் தேர்ந்தெடுக்க."

#. type: Plain text
#: amulecmd.1.in:246 amuleweb.1.in:149
msgid "For example, the following strings are valid:"
msgstr "எடுத்துக்காட்டாக, பின்வரும் வரிகள் செல்லுபடியாகும்:"

#. type: Plain text
#: amulecmd.1.in:260 amuleweb.1.in:163
msgid ""
"Though all the above strings are accepted as valid language definitions, "
"I<encoding> and I<modifier> are yet unused."
msgstr ""
"மேலே உள்ள அனைத்து சரங்களும் சரியான மொழி வரையறையாக ஏற்றுக்கொள்ளப்பட்டாலும், "
"IS<குறியீடு> மற்றும் I<மாற்றிகள்> இன்னும் பயன்படுத்தப்படவில்லை."

#. type: Plain text
#: amulecmd.1.in:263 amuleweb.1.in:166
msgid ""
"In addition to the format above, you can also specify full language names in"
" English - so B<-l german> is also valid and is equal to B<-l de_DE>."
msgstr ""
"மேலே உள்ள வடிவமைப்பிற்கு கூடுதலாக, நீங்கள் முழு மொழி பெயர்களையும் "
"ஆங்கிலத்தில் குறிப்பிடலாம் - எனவே B<-l German> என்பதும் செல்லுபடியாகும் "
"மற்றும் B<-l de_DE>க்கு சமம்."

#. type: Plain text
#: amulecmd.1.in:266 amuleweb.1.in:169
msgid ""
"When no locale is defined, either on command-line or in config file, system "
"default language will be used."
msgstr ""
"எந்த மொழியும் வரையறுக்கப்படாத போது, ​​கட்டளை வரியில் அல்லது கட்டமைப்பு "
"கோப்பில், கணினி இயல்பு மொழி பயன்படுத்தப்படும்."

#. type: Plain text
#: amulecmd.1.in:268 amuleweb.1.in:177
msgid "~/.aMule/remote.conf"
msgstr "~/.aMule/remote.conf"

#. type: SH
#: amulecmd.1.in:268 amuleweb.1.in:181
#, no-wrap
msgid "EXAMPLE"
msgstr "சான்று"

#. type: Plain text
#: amulecmd.1.in:270
msgid "Typically amulecmd will be first run as:"
msgstr "பொதுவாக amulecmd முதலில் இயக்கப்படும்:"

#. type: Plain text
#: amulecmd.1.in:272
msgid ""
"B<amulecmd> B<-h> I<hostname> B<-p> I<ECport> B<-P> I<ECpassword> B<-w>"
msgstr ""
"B<amulecmd> B<-h> I<hostname> B<-p> I<ECport> B<-P> I<ECpassword> B<-w>"

#. type: Plain text
#: amulecmd.1.in:274 amuleweb.1.in:187
msgid "or"
msgstr "அல்லது"

#. type: Plain text
#: amulecmd.1.in:276
msgid ""
"B<amulecmd> B<--create-config-from>=I</home/username/.aMule/amule.conf>"
msgstr ""
"B<amulecmd> B<--create-config-from>=நான்</home/username/.aMule/amule.conf>"

#. type: Plain text
#: amulecmd.1.in:278 amuleweb.1.in:191
msgid ""
"These will save settings to I<$HOME/.aMule/remote.conf>, and later you only "
"need to type:"
msgstr ""
"These will சேமி அமைப்புகள் பெறுநர் I<$HOME/.aMule/remote.conf>, and later "
"you only need பெறுநர் தட்டச்சு:"

#. type: Plain text
#: amulecmd.1.in:282
msgid "Of course, you don't have to follow this example."
msgstr "நிச்சயமாக, இந்த உதாரணத்தை நீங்கள் பின்பற்ற வேண்டியதில்லை."

#. type: TH
#: amuled.1.in:1
#, no-wrap
msgid "AMULED"
msgstr "அமுலேட்"

#. type: TH
#: amuled.1.in:1
#, no-wrap
msgid "aMule Daemon v@PACKAGE_VERSION@"
msgstr "aMule Daemon v@PACKAGE_VERSION@"

#. type: TH
#: amuled.1.in:1
#, no-wrap
msgid "aMule Daemon"
msgstr "அமுல் டீமான்"

#. type: Plain text
#: amuled.1.in:6
msgid "amuled - the all-platform eMule p2p client - daemonized version"
msgstr ""
"amuled - அனைத்து இயங்குதளம் eMule p2p கிளையன்ட் - டெமோனைச் செய்யப்பட்ட "
"பதிப்பு"

#. type: Plain text
#: amuled.1.in:9 ../../src/utils/cas/docs/cas.1.in:11
msgid "[B<-c> I<E<lt>pathE<gt>>]"
msgstr "[B<-c> I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amuled.1.in:11
msgid "[B<-p> I<E<lt>pathE<gt>>]"
msgstr "[B<-p> I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amuled.1.in:33
msgid "Forks to background."
msgstr "பின்னணிக்கு முட்கரண்டி."

#. type: TP
#: amuled.1.in:33
#, no-wrap
msgid "B<[ -p> I<E<lt>pathE<gt>>, B<--pid-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -p> I<E<lt>pathE<gt>>, B<--pid-file>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amuled.1.in:37
msgid ""
"After fork, create a pid-file in the I<E<lt>pathE<gt>>.  I<E<lt>pathE<gt>> "
"has to contain the filename."
msgstr ""
"போர்க்கிற்குப் பிறகு, I<E<lt>pathE<gt>> இல் pid-கோப்பை உருவாக்கவும். "
"I<E<lt>pathE<gt>> கோப்புப் பெயரைக் கொண்டிருக்க வேண்டும்."

#. type: Plain text
#: amuled.1.in:40
msgid "Configure EC (External Connections)."
msgstr "EC (வெளிப்புற இணைப்புகள்) கட்டமைக்கவும்."

#. type: Plain text
#: amuled.1.in:50
msgid ""
"Enable or disable starting amuled on user login, then exit.  The OS-specific"
" store is selected automatically: Windows registry Run key, macOS "
"LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr ""
"பயனர் உள்நுழைவில் அமுல்டு தொடங்குவதை இயக்கவும் அல்லது முடக்கவும், பின்னர் "
"வெளியேறவும். OS-குறிப்பிட்ட கடை தானாகவே தேர்ந்தெடுக்கப்பட்டது: சாளரங்கள் "
"ரெசிச்ட்ரி ரன் கீ, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."

#. type: TP
#: amuled.1.in:61
#, no-wrap
msgid "B<[ -t> I<E<lt>numE<gt>>, B<--category>=I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t> I<E<lt>numE<gt>>, B<--category>=I<E<lt>numE<gt>> B<]>"

#. type: TH
#: amulegui.1.in:1
#, no-wrap
msgid "AMULEGUI"
msgstr "AMULEGUI"

#. type: TH
#: amulegui.1.in:1
#, no-wrap
msgid "aMuleGUI v@PACKAGE_VERSION@"
msgstr "aMuleGUI v@PACKAGE_VERSION@"

#. type: TH
#: amulegui.1.in:1
#, no-wrap
msgid "aMuleGUI"
msgstr "aMuleGUI"

#. type: Plain text
#: amulegui.1.in:6
msgid "amulegui - aMule control program with GUI"
msgstr "amulegui - GUI உடன் aMule கட்டுப்பாட்டு நிரல்"

#. type: Plain text
#: amulegui.1.in:17
msgid "[B<-t> I<E<lt>numE<gt>>]"
msgstr "[B<-t> I<E<lt>numE<gt>>]"

#. type: Plain text
#: amulegui.1.in:27
msgid ""
"B<amulegui> is a client program, and can be connected to amule or amuled via"
" EC. You can manage your amule program with it. It provides almost the same "
"functionalities as amule, even if the core works on another computer."
msgstr ""
"B<amulegui> என்பது ஒரு கிளையன்ட் நிரலாகும், மேலும் EC வழியாக அமுலுடன் "
"இணைக்கப்படலாம் அல்லது அமுல் செய்யலாம். உங்கள் அமுல் திட்டத்தை நீங்கள் "
"நிர்வகிக்கலாம். கோர் வேறொரு கணினியில் வேலை செய்தாலும், அமுல் போன்ற "
"செயல்பாடுகளை இது வழங்குகிறது."

#. type: Plain text
#: amulegui.1.in:42
msgid "Skip connection dialog."
msgstr "இணைப்பு உரையாடலைத் தவிர்."

#. type: Plain text
#: amulegui.1.in:46
msgid ""
"Enable or disable starting amulegui on user login, then exit.  The OS-"
"specific store is selected automatically: Windows registry Run key, macOS "
"LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr ""
"பயனர் உள்நுழைவில் அமுலேகுஐ தொடங்குவதை இயக்கவும் அல்லது முடக்கவும், பின்னர் "
"வெளியேறவும். OS-குறிப்பிட்ட கடை தானாகவே தேர்ந்தெடுக்கப்பட்டது: சாளரங்கள் "
"ரெசிச்ட்ரி ரன் கீ, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."

#. type: Plain text
#: amulegui.1.in:72
msgid ""
"This manpage was written by Julien Delange for Debian E<lt>julien AT gunnm "
"DOT orgE<gt>"
msgstr ""
"இந்த மேன்பேச் Debian E<lt>julien AT gunnm DOT orgE<gt> க்காக Julien Delange "
"என்பவரால் எழுதப்பட்டது"

#. type: Plain text
#: amulegui.1.in:73
msgid ""
"This manpage was rewritten by Vollstrecker "
"E<lt>amule@vollstreckernet.deE<gt>"
msgstr ""
"இந்த மேன்பக்கம் Vollstrecker E<lt>amule@vollstreckernet.deE<gt> ஆல் மீண்டும்"
" எழுதப்பட்டது"

#. type: TH
#: amuleweb.1.in:1
#, no-wrap
msgid "AMULEWEB"
msgstr "அமுலேவெப்"

#. type: TH
#: amuleweb.1.in:1
#, no-wrap
msgid "aMule webserver v@PACKAGE_VERSION@"
msgstr "aMul இணைய சேவையகம் vs@PACKAGE_VERSION@"

#. type: Plain text
#: amuleweb.1.in:6
msgid "amuleweb - aMule web server"
msgstr "amuleweb - aMule இணைய சேவையகம்"

#. type: Plain text
#: amuleweb.1.in:15
msgid "[B<-l> I<E<lt>langE<gt>>]"
msgstr "[B<-l> I<E<lt>langE<gt>>]"

#. type: Plain text
#: amuleweb.1.in:18
msgid "[B<-t> I<E<lt>nameE<gt>>] [B<-s> I<E<lt>portE<gt>>]"
msgstr "[B<-t> I<E<lt>nameE<gt>>] [B<-s> I<E<lt>portE<gt>>]"

#. type: Plain text
#: amuleweb.1.in:20
msgid "[B<-U> I<E<lt>portE<gt>>]"
msgstr "[B<-U> I<E<lt>portE<gt>>]"

#. type: Plain text
#: amuleweb.1.in:24
msgid "[B<-A> I<E<lt>passwordE<gt>>] [B<-G> I<E<lt>passwordE<gt>>]"
msgstr "[B<-A> I<E<lt>passwordE<gt>>] [B<-G> I<E<lt>passwordE<gt>>]"

#. type: Plain text
#: amuleweb.1.in:40
msgid "[B<--amule-config-file>=I<E<lt>pathE<gt>>]"
msgstr "[B<--amule-config-file>=I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amuleweb.1.in:46
msgid ""
"B<amuleweb> manages your access to amule through a web browser.  You can "
"start amuleweb together with B<amule>(1), or separately, any time later.  "
"Options can be specified via command-line or via config-file.  Command-line "
"options take precedence over config-file options."
msgstr ""
"B<amuleweb> இணைய உலாவி மூலம் அமுலுக்கான உங்கள் அணுகலை நிர்வகிக்கிறது. "
"நீங்கள் B<amule>(1) உடன் அமுலேவெப் ஒன்றைத் தொடங்கலாம் அல்லது தனித்தனியாக, "
"பிறகு எப்போது வேண்டுமானாலும் தொடங்கலாம். கட்டளை வரி அல்லது config-file "
"வழியாக விருப்பங்களை குறிப்பிடலாம். config-file விருப்பங்களை விட கட்டளை வரி "
"விருப்பங்கள் முன்னுரிமை பெறுகின்றன."

#. type: TP
#: amuleweb.1.in:74
#, no-wrap
msgid "B<[ -t> I<E<lt>nameE<gt>>, B<--template>=I<E<lt>nameE<gt>> B<]>"
msgstr "B<[ -t> I<E<l>பெயர்<gtB<--template>=IN<lt>பெயர்<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in:77
msgid ""
"Loads the template named I<E<lt>nameE<gt>>. See the B<SKIN SUPPORT> section "
"for details."
msgstr ""
"I<E<lt>nameE<gt>> என்ற டெம்ப்ளேட்டை ஏற்றுகிறது. விவரங்களுக்கு B<SKIN "
"SUPPORT> பகுதியைப் பார்க்கவும்."

#. type: TP
#: amuleweb.1.in:77
#, no-wrap
msgid "B<[ -s> I<E<lt>portE<gt>>, B<--server-port>=I<E<lt>portE<gt>> B<]>"
msgstr "B<[ -s> I<E<lt>portE<gt>>, B<--server-port>=I<E<lt>portE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in:80
msgid ""
"Webserver's HTTP port. This is the port you must point your browser to "
"(default: I<4711>)."
msgstr ""
"வெப்சர்வரின் HTTP துறைமுகம். உங்கள் உலாவியை நீங்கள் சுட்டிக்காட்ட வேண்டிய "
"துறைமுகம் இதுவாகும் (இயல்புநிலை: I<4711>)."

#. type: Plain text
#: amuleweb.1.in:84
msgid "Enable UPnP."
msgstr "UPnP ஐ இயக்கு."

#. type: TP
#: amuleweb.1.in:84
#, no-wrap
msgid "B<[ -U> I<E<lt>portE<gt>>, B<--upnp-port>=I<E<lt>portE<gt>> B<]>"
msgstr "B<[ -U> I<E<lt>portE<gt>>, B<--upnp-port>=I<E<lt>portE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in:87
msgid "UPnP port."
msgstr "UPnP துறைமுகம்."

#. type: Plain text
#: amuleweb.1.in:90
msgid "Enables using gzip compression in HTTP traffic to save bandwidth."
msgstr ""
"அலைவரிசையைச் சேமிக்க HTTP போக்குவரத்தில் gzip சுருக்கத்தைப் பயன்படுத்துவதை "
"இயக்குகிறது."

#. type: Plain text
#: amuleweb.1.in:93
msgid "Disables using gzip compression (this is the default)."
msgstr "gzip சுருக்கத்தைப் பயன்படுத்தி முடக்குகிறது (இது இயல்புநிலை)."

#. type: TP
#: amuleweb.1.in:93
#, no-wrap
msgid "B<[ -A> I<E<lt>passwdE<gt>>, B<--admin-pass>=I<E<lt>passwdE<gt>> B<]>"
msgstr "B<[ -A> I<E<lt>passwdE<gt>>, B<--admin-pass>=I<E<lt>passwdE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in:96
msgid "Full access password for webserver."
msgstr "இணைய சேவையகத்திற்கான முழு அணுகல் கடவுச்சொல்."

#. type: TP
#: amuleweb.1.in:96
#, no-wrap
msgid "B<[ -G> I<E<lt>passwdE<gt>>, B<--guest-pass>=I<E<lt>passwdE<gt>> B<]>"
msgstr "B<[ -G> I<E<lt>passwdE<gt>>, B<--guest-pass>=I<E<lt>passwdE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in:99
msgid "Guest password for webserver."
msgstr "வெப்சர்வருக்கான விருந்தினர் கடவுச்சொல்."

#. type: Plain text
#: amuleweb.1.in:102
msgid "Allows guest access."
msgstr "விருந்தினர் அணுகலை அனுமதிக்கிறது."

#. type: Plain text
#: amuleweb.1.in:105
msgid "Denies guest access (default)."
msgstr "விருந்தினர் அணுகலை மறுக்கிறது (இயல்புநிலை)."

#. type: Plain text
#: amuleweb.1.in:111
msgid ""
"Load/save webserver settings from/to remote aMule.  This causes amuleweb to "
"ignore command-line and config-file settings, and load them from aMule.  "
"When saving preferences none will be written to the config file, but to "
"aMule.  (Of course, this works only for those settings that can be set in "
"aMule's Preferences-E<gt>Remote Controls.)"
msgstr ""
"வெப்சர்வர் அமைப்புகளை ரிமோட் aMule இலிருந்து ஏற்றவும்/சேமிக்கவும். இது "
"amuleweb கட்டளை வரி மற்றும் config-file அமைப்புகளை புறக்கணித்து, aMule "
"இலிருந்து ஏற்றுகிறது. விருப்பத்தேர்வுகளைச் சேமிக்கும் போது எதுவும் "
"கட்டமைப்பு கோப்பில் எழுதப்படாது, ஆனால் aMule க்கு எழுதப்படும். (நிச்சயமாக, "
"இது aMule இன் முன்னுரிமைகள்-E<gt>ரிமோட் கண்ட்ரோல்களில் அமைக்கக்கூடிய "
"அமைப்புகளுக்கு மட்டுமே வேலை செய்யும்.)"

#. type: Plain text
#: amuleweb.1.in:114
msgid "Disable PHP interpreter (deprecated)"
msgstr "PHP மொழிபெயர்ப்பாளரை முடக்கு (நிறுத்தப்பட்டது)"

#. type: Plain text
#: amuleweb.1.in:117
msgid "Recompiles PHP pages on each request."
msgstr "ஒவ்வொரு கோரிக்கையிலும் பிஎச்பி பக்கங்களை மீண்டும் தொகுக்கிறது."

#. type: TP
#: amuleweb.1.in:130
#, no-wrap
msgid "B<[ --amule-config-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ --amule-config-file>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in:136
msgid ""
"aMule config file path.  B<DO NOT USE DIRECTLY!> aMule uses this option when"
" starting amuleweb at aMule startup.  This option causes all other command-"
"line and config-file settings to be ignored, preferences to be read from the"
" given config file, and also implies the B<-q -L> options."
msgstr ""
"aMule கட்டமைப்பு கோப்பு பாதை. B<நேரடியாகப் பயன்படுத்த வேண்டாம்!> aMule "
"தொடக்கத்தில் amuleweb ஐத் தொடங்கும் போது aMule இந்த விருப்பத்தைப் "
"பயன்படுத்துகிறது. இந்த விருப்பம் மற்ற அனைத்து கட்டளை வரி மற்றும் கட்டமைப்பு "
"கோப்பு அமைப்புகளை புறக்கணிக்க காரணமாகிறது, கொடுக்கப்பட்ட கட்டமைப்பு கோப்பில்"
" இருந்து விருப்பத்தேர்வுகள் படிக்கப்பட வேண்டும், மேலும் B<-q -L> "
"விருப்பங்களையும் குறிக்கிறது."

#. type: SH
#: amuleweb.1.in:169
#, no-wrap
msgid "SKIN SUPPORT"
msgstr "தோல் உதவி"

#. type: Plain text
#: amuleweb.1.in:173
msgid ""
"B<amuleweb> is capable of displaying information in different skins.  These "
"skins are called templates, and you can make amuleweb load a specific "
"template via the B<-t> command line option.  Templates are searched in two "
"places: first in I<~/.aMule/webserver/> and then in "
"I</usr/share/amule/webserver/> if you installed with --prefix=/usr."
msgstr ""
"B<amuleweb> வெவ்வேறு தோல்களில் தகவலைக் காண்பிக்கும் திறன் கொண்டது. இந்த "
"தோல்கள் டெம்ப்ளேட்கள் என்று அழைக்கப்படுகின்றன, மேலும் நீங்கள் B<-t> கட்டளை "
"வரி விருப்பத்தின் மூலம் ஒரு குறிப்பிட்ட டெம்ப்ளேட்டை அமுல்வெப் ஏற்றலாம். "
"டெம்ப்ளேட்கள் இரண்டு இடங்களில் தேடப்படும்: முதலில் I<~/.aMule/webserver/> "
"இல், பிறகு I</usr/share/amule/webserver/> இல் --prefix=/usr உடன் "
"நிறுவியிருந்தால்."

#. type: Plain text
#: amuleweb.1.in:175
msgid ""
"Each template must be in a subdirectory of the template name, and this "
"directory must contain all files the template needs."
msgstr ""
"ஒவ்வொரு டெம்ப்ளேட்டும் டெம்ப்ளேட் பெயரின் துணை அடைவில் இருக்க வேண்டும், "
"மேலும் இந்த கோப்பகத்தில் டெம்ப்ளேட்டுக்குத் தேவையான அனைத்து கோப்புகளும் "
"இருக்க வேண்டும்."

#. type: Plain text
#: amuleweb.1.in:179
msgid "~/.aMule/webserver/"
msgstr "~/.aMule/webserver/"

#. type: Plain text
#: amuleweb.1.in:181
msgid "I<$(pkgdatadir)>/webserver/"
msgstr "I<$(pkgdatadir)>/webserver/"

#. type: Plain text
#: amuleweb.1.in:183
msgid "Typically amuleweb will be first run as:"
msgstr "பொதுவாக அமுலேவெப் முதலில் இயக்கப்படும்:"

#. type: Plain text
#: amuleweb.1.in:185
msgid ""
"B<amuleweb> B<-h> I<hostname> B<-p> I<ECport> B<-P> I<ECpassword> B<-s> "
"I<HTTPport> B<-A> I<AdminPassword> B<-w>"
msgstr ""
"B<amuleweb> B<-h> I<hostname> B<-p> I<ECport> B<-P> I<ECpassword> B<-s> "
"I<HTTPport> B<-A> I<AdminPassword> B<-w>"

#. type: Plain text
#: amuleweb.1.in:189
msgid ""
"B<amuleweb> B<--create-config-from>=I</home/username/.aMule/amule.conf>"
msgstr ""
"B<amuleweb> B<--create-config-from>=நான்</home/username/.aMule/amule.conf>"

#. type: Plain text
#: amuleweb.1.in:195
msgid ""
"Of course, you may specify any more or less options on the first example "
"line, and you may also totally omit it."
msgstr ""
"நிச்சயமாக, நீங்கள் முதல் எடுத்துக்காட்டு வரியில் அதிகமாகவோ அல்லது குறைவாகவோ "
"விருப்பங்களைக் குறிப்பிடலாம், மேலும் நீங்கள் அதை முற்றிலும் தவிர்க்கலாம்."

#. type: TH
#: ed2k.1.in:1
#, no-wrap
msgid "ED2K"
msgstr "ED2K"

#. type: TH
#: ed2k.1.in:1
#, no-wrap
msgid "aMule eD2k link parser v1.5.1"
msgstr "aMule eD2k இணைப்பு பாகுபடுத்தி v1.5.1"

#. type: Plain text
#: ed2k.1.in:6
msgid "ed2k - aMule eD2k link parser"
msgstr "ed2k - aMule eD2k இணைப்பு பாகுபடுத்தி"

#. type: Plain text
#: ed2k.1.in:10
msgid "[B<-c> I<E<lt>pathE<gt>>] [B<-t> I<E<lt>numE<gt>>]"
msgstr "[B<-c> I<E<l>path<gat>>] [B<-t> I<E<s t>namE<gt>>]"

#. type: Plain text
#: ed2k.1.in:13
msgid "I<E<lt>eD2k-linkE<gt>>"
msgstr "I<E<lt>eD2k-linkE<gt>>"

#. type: Plain text
#: ed2k.1.in:21
msgid ""
"Sends the given I<E<lt>eD2k-linkE<gt>> to aMule, i.e. writes it to the file "
"~/.aMule/ED2KLinks, which will be checked by aMule every second for links."
msgstr ""
"கொடுக்கப்பட்ட I<E<lt>eD2k-linkE<gt>> ஐ aMule க்கு அனுப்புகிறது, அதாவது "
"~/.aMule/ED2KLinks கோப்பில் எழுதுகிறது, இது ஒவ்வொரு நொடியும் இணைப்புகளுக்காக"
" aMule ஆல் சரிபார்க்கப்படும்."

#. type: TP
#: ed2k.1.in:24
#, no-wrap
msgid "B<[ -t> I<E<lt>numE<gt>>, B<--category> I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t> I<E<lt>numE<gt>>, B<--category> I<E<lt>numE<gt>> B<]>"

#. type: Plain text
#: ed2k.1.in:28
msgid ""
"Set category for passed eD2k links to I<E<lt>numE<gt>>.  Unlike B<--config-"
"dir>, the parser reads the value as the next argument and does not accept "
"B<--category>=I<E<lt>numE<gt>> syntax."
msgstr ""
"I<E<lt>numE<gt>>க்கு அனுப்பப்பட்ட eD2k இணைப்புகளுக்கான வகையை அமைக்கவும். "
"B<--config-dir> போலல்லாமல், பாகுபடுத்தி மதிப்பை அடுத்த வாதமாகப் படிக்கிறது "
"மற்றும் B<--category>=I<E<lt>numE<gt>> தொடரியல் ஏற்காது."

#. type: Plain text
#: ed2k.1.in:31
msgid ""
"Loads all links found in the emulecollection given as I<E<lt>ed2k-linkE<gt>>"
msgstr ""
"I<E<lt>ed2k-linkE<gt>> என கொடுக்கப்பட்ட எமுல் சேகரிப்பில் காணப்படும் அனைத்து"
" இணைப்புகளையும் ஏற்றுகிறது"

#. type: Plain text
#: ed2k.1.in:34
msgid ""
"Lists all links found in the emulecollection given as I<E<lt>ed2k-linkE<gt>>"
msgstr ""
"I<E<lt>ed2k-linkE<gt>> என கொடுக்கப்பட்ட எமுல் சேகரிப்பில் காணப்படும் அனைத்து"
" இணைப்புகளையும் பட்டியலிடுகிறது"

#. type: Plain text
#: ed2k.1.in:54
msgid "a magnet link;"
msgstr "ஒரு காந்த இணைப்பு;"

#. type: Plain text
#: ed2k.1.in:56
msgid "an emulecollection file."
msgstr "ஒரு எமுல் சேகரிப்பு கோப்பு."

#. type: Plain text
#: ed2k.1.in:61
msgid ""
"B<The order in which you give the parameters is important.> You can give "
"more than one link, and every link can have it's own params.  For example "
"B<ed2k E<lt>link1E<gt> -t2 E<lt>link2E<gt>> will download I<E<lt>link1E<gt>>"
" in standard category and I<E<lt>link2E<gt>> in category 2."
msgstr ""
"B<நீங்கள் அளவுருக்களை வழங்கும் வரிசை முக்கியமானது.> நீங்கள் ஒன்றுக்கு "
"மேற்பட்ட இணைப்புகளை கொடுக்கலாம், மேலும் ஒவ்வொரு இணைப்புக்கும் அதன் சொந்த "
"அளவுருக்கள் இருக்கலாம். எடுத்துக்காட்டாக, B<ed2k E<lt>link1E<gt> -t2 "
"E<lt>link2E<gt>> ஐ<E<lt>link1E<gt>> தரநிலை வகையிலும், I<E<lt>link2E<gt>> வகை"
" 2யிலும் பதிவிறக்கும்."

#. type: Plain text
#: ed2k.1.in:63
msgid "~/.aMule/ED2KLinks"
msgstr "~/.aMul/ED2K இணைப்புகள்"

