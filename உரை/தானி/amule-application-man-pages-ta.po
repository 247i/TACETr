#. type: Plain text
#: amule.1.in:6
msgid "amule - the all-platform eMule p2p client"
msgstr "amule - அனைத்து இயங்குதளம் eMule p2p கிளையன்ட்"

#. type: SH
#: amule.1.in:6 amulecmd.1.in:7 amuled.1.in:6 amulegui.1.in:6 amuleweb.1.in:6
#: ed2k.1.in:6 ../../src/utils/aLinkCreator/docs/alc.1.in:5
#: ../../src/utils/aLinkCreator/docs/alcc.1.in:6
#: ../../src/utils/cas/docs/cas.1.in:6 ../../src/utils/wxCas/docs/wxcas.1.in:5
#, no-wrap
msgid "SYNOPSIS"
msgstr "சுருக்கம்"

#. type: Plain text
#: amule.1.in:10 amulegui.1.in:10
msgid "[B<-c> I<E<lt>pathE<gt>>] [B<-geometry> I<E<lt>geomE<gt>>]"
msgstr "[B<-c> I<E<l>patti<gtB<-geometry> IN<lt>geomE<gt>>]"

#. type: Plain text
#: amule.1.in:14 amuled.1.in:16
msgid "[B<-w> I<E<lt>pathE<gt>>]"
msgstr "[B<-w> I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amule.1.in:18 amuled.1.in:20
msgid "[B<-t> I<E<lt>numE<gt>>] [I<eD2k-link>]"
msgstr "[B<-t> I<E<lt>numE<gt>>] [I<eD2k-link>]"

#. type: SH
#: amule.1.in:25 amulecmd.1.in:26 amuled.1.in:26 amulegui.1.in:23
#: amuleweb.1.in:41 ed2k.1.in:19 ../../src/utils/aLinkCreator/docs/alc.1.in:7
#: ../../src/utils/aLinkCreator/docs/alcc.1.in:14
#: ../../src/utils/cas/docs/cas.1.in:14
#: ../../src/utils/wxCas/docs/wxcas.1.in:7
#, no-wrap
msgid "DESCRIPTION"
msgstr "விவரம்"

#. type: TP
#: amule.1.in:26 amuled.1.in:27 amulegui.1.in:27 ed2k.1.in:21
#: ../../src/utils/cas/docs/cas.1.in:27
#, no-wrap
msgid "B<[ -c> I<E<lt>pathE<gt>>, B<--config-dir>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -c> I<E<lt>pathE<gt>>, B<--config-dir>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amule.1.in:29 amuled.1.in:30 amulegui.1.in:30 ed2k.1.in:24
#: ../../src/utils/cas/docs/cas.1.in:30
msgid "Read config from I<E<lt>pathE<gt>> instead of home"
msgstr "Read கட்டமைப்பு இருந்து I<E<lt>pathE<gt>> instead of வீடு"

#. type: TP
#: amule.1.in:29 amulegui.1.in:30
#, no-wrap
msgid "B<[ -geometry >I<E<lt>geomE<gt>> B<]>"
msgstr "B<[ -geometry >I<E<lt>geomE<gt>> B<]>"

#. type: Plain text
#: amule.1.in:32 amulegui.1.in:33
msgid ""
"Sets the geometry of the app. I<E<lt>geomE<gt>> uses the same format as "
"standard X11 "
"apps:\t[B<=>][I<E<lt>widthE<gt>>{B<xX>}I<E<lt>heightE<gt>>][{B<+->}I<E<lt>xoffsetE<gt>>{B<+->}I<E<lt>yoffsetE<gt>>]"
msgstr ""
"பயன்பாட்டின் வடிவவியலை அமைக்கிறது. I<E<lt>geomE<gt>> நிலையான X11 "
"பயன்பாடுகளின் அதே வடிவமைப்பைப் பயன்படுத்துகிறது: "
"[B<=>][I<E<lt>widthE<gt>>{B<xX>}I<E<lt>heightE<gt>>][{B<+->}I<E<lt>xoffsetE<gt>}<I<E<Lt>xoffsetE<gt>}<I<+-gt><I<E<Elt><I<Elt><E<Elt><Elt><"

#. type: Plain text
#: amule.1.in:35 amuled.1.in:43 amulegui.1.in:36
msgid "Prints log messages to stdout."
msgstr "பதிவு செய்திகளை stdout க்கு அச்சிடுகிறது."

#. type: Plain text
#: amule.1.in:38 amuled.1.in:46 amulegui.1.in:39
msgid "Resets config to default values."
msgstr "கட்டமைப்புகளை இயல்புநிலை மதிப்புகளுக்கு மீட்டமைக்கிறது."

#. type: Plain text
#: amule.1.in:42
msgid ""
"Enable or disable starting aMule on user login, then exit.  The OS-specific "
"store is selected automatically: Windows registry Run key, macOS "
"LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr ""
"பயனர் உள்நுழைவில் aMule ஐ இயக்கவும் அல்லது முடக்கவும், பின்னர் வெளியேறவும். "
"OS-குறிப்பிட்ட கடை தானாகவே தேர்ந்தெடுக்கப்பட்டது: சாளரங்கள் ரெசிச்ட்ரி ரன் "
"கீ, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."

#. type: TP
#: amule.1.in:42 amuled.1.in:50
#, no-wrap
msgid "B<[ -w> I<E<lt>pathE<gt>>, B<--use-amuleweb>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -w> I<E<lt>pathE<gt>>, B<--use-amuleweb>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amule.1.in:45 amuled.1.in:53
msgid "Specify location of amuleweb binary to I<E<lt>pathE<gt>>."
msgstr ""
"I<E<lt>pathE<gt>>க்கு அமுலேவெப் பைனரியின் இருப்பிடத்தைக் குறிப்பிடவும்."

#. type: Plain text
#: amule.1.in:50 amuled.1.in:58 amulegui.1.in:51
msgid ""
"Don't catch fatal exceptions and don't block exit on assertions.  Useful for"
" headless / supervised setups (systemd, watchdog scripts)  where the "
"otherwise-modal assertion dialog prevents auto-restart."
msgstr ""
"அபாயகரமான விதிவிலக்குகளைப் பிடிக்காதீர்கள் மற்றும் உறுதிமொழிகளில் "
"வெளியேறுவதைத் தடுக்காதீர்கள். எட்லெச் / மேற்பார்வையிடப்பட்ட அமைப்புகளுக்கு "
"(சிச்டம், வாட்ச்டாக் ச்கிரிப்டுகள்) பயனுள்ளதாக இருக்கும், இல்லையெனில் மாதிரி"
" வலியுறுத்தல் உரையாடல் தானாக மறுதொடக்கம் செய்வதைத் தடுக்கிறது."

#. type: Plain text
#: amule.1.in:53 amuled.1.in:61 amulegui.1.in:54
msgid "Does not disable stdin."
msgstr "stdin ஐ முடக்காது."

#. type: TP
#: amule.1.in:53 amulegui.1.in:54
#, no-wrap
msgid "B<[ -t>, B<--category>=I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t>, B<--category>=I<E<lt>numE<gt>> B<]>"

#. type: Plain text
#: amule.1.in:56 amuled.1.in:64 amulegui.1.in:57
msgid "Set category for passed eD2k links to I<E<lt>numE<gt>>"
msgstr ""
"I<E<lt>numE<gt>>க்கு அனுப்பப்பட்ட eD2k இணைப்புகளுக்கான வகையை அமைக்கவும்"

#. type: Plain text
#: amule.1.in:59 amulecmd.1.in:70 amuled.1.in:67 amulegui.1.in:63
#: amuleweb.1.in:130 ed2k.1.in:40
msgid "Displays the current version number."
msgstr "தற்போதைய பதிப்பு எண்ணைக் காட்டுகிறது."

#. type: Plain text
#: amule.1.in:62 amulecmd.1.in:73 amuled.1.in:70 amulegui.1.in:60
#: amuleweb.1.in:127 ed2k.1.in:37
#: ../../src/utils/aLinkCreator/docs/alcc.1.in:22
#: ../../src/utils/cas/docs/cas.1.in:33
msgid "Prints a short usage description."
msgstr "ஒரு சிறிய பயன்பாட்டு விளக்கத்தை அச்சிடுகிறது."

#. type: TP
#: amule.1.in:62 amuled.1.in:70 ed2k.1.in:40
#, no-wrap
msgid "B<[ eD2k-link ]>"
msgstr "B<[ eD2k-link ]>"

#. type: Plain text
#: amule.1.in:65 amuled.1.in:73 ed2k.1.in:43
msgid "Adds an eD2k-link to the core."
msgstr "மையத்தில் eD2k-இணைப்பைச் சேர்க்கிறது."

#. type: Plain text
#: amule.1.in:67 amulecmd.1.in:79 amuled.1.in:75 ed2k.1.in:45
msgid "The eD2k link to be added can be:"
msgstr "சேர்க்கப்பட வேண்டிய eD2k இணைப்பு:"

#. type: Plain text
#: amule.1.in:70 amulecmd.1.in:82 amuled.1.in:78 ed2k.1.in:48
msgid ""
"a file link (ed2k://|file|...), it will be added to the download queue;"
msgstr ""
"ஒரு கோப்பு இணைப்பு (ed2k://|file|...), இது பதிவிறக்க வரிசையில் "
"சேர்க்கப்படும்;"

#. type: Plain text
#: amule.1.in:72 amulecmd.1.in:84 amuled.1.in:80 ed2k.1.in:50
msgid ""
"a server link (ed2k://|server|...), it will be added to the server list;"
msgstr ""
"ஒரு சர்வர் இணைப்பு (ed2k://|server|...), இது சர்வர் பட்டியலில் "
"சேர்க்கப்படும்;"

#. type: Plain text
#: amule.1.in:74 amuled.1.in:82 ed2k.1.in:52
msgid ""
"a serverlist link, in which case all servers in the list will be added to "
"the server list;"
msgstr ""
"ஒரு சர்வர்லிச்ட் இணைப்பு, இதில் பட்டியலில் உள்ள அனைத்து சர்வர்களும் சர்வர் "
"பட்டியலில் சேர்க்கப்படும்;"

#. type: Plain text
#: amule.1.in:76 amuled.1.in:84
msgid "a magnet link."
msgstr "ஒரு காந்த இணைப்பு."

#. type: SH
#: amule.1.in:77 amulecmd.1.in:233 amuleweb.1.in:136
#, no-wrap
msgid "NOTES"
msgstr "குறிப்புகள்"

#. type: SS
#: amule.1.in:78 amulecmd.1.in:234 amuleweb.1.in:137
#, no-wrap
msgid "Paths"
msgstr "பாதைகள்"

#. type: Plain text
#: amule.1.in:82 amulecmd.1.in:238 amuleweb.1.in:141
msgid ""
"For all options which take a I<E<lt>pathE<gt>> value, if the I<path> "
"contains no directory part (i.e. just a plain filename), then it is "
"considered to be under the aMule configuration directory, I<~/.aMule>."
msgstr ""
"I<E<lt>pathE<gt>> மதிப்பை எடுக்கும் அனைத்து விருப்பங்களுக்கும், I<path> "
"கோப்பகப் பகுதியைக் கொண்டிருக்கவில்லை என்றால் (அதாவது ஒரு சாதாரண "
"கோப்புப்பெயர் மட்டுமே), அது aMule உள்ளமைவு கோப்பகத்தின் கீழ், I<~/.aMule> "
"எனக் கருதப்படுகிறது."

#. type: SH
#: amule.1.in:82 amulecmd.1.in:266 amuled.1.in:85 amuleweb.1.in:175
#: ed2k.1.in:61 ../../src/utils/cas/docs/cas.1.in:37
#, no-wrap
msgid "FILES"
msgstr "கோப்புகள்"

#. type: Plain text
#: amule.1.in:84 amuled.1.in:87
msgid "~/.aMule/*"
msgstr "~/.aMule/*"

#. type: SH
#: amule.1.in:84 amulecmd.1.in:282 amuled.1.in:87 amulegui.1.in:63
#: amuleweb.1.in:195 ed2k.1.in:63
#: ../../src/utils/aLinkCreator/docs/alc.1.in:11
#: ../../src/utils/aLinkCreator/docs/alcc.1.in:26
#: ../../src/utils/cas/docs/cas.1.in:43
#: ../../src/utils/wxCas/docs/wxcas.1.in:16
#, no-wrap
msgid "REPORTING BUGS"
msgstr "பிழைகளைப் புகாரளித்தல்"

#. type: Plain text
#: amule.1.in:87 amulecmd.1.in:285 amuled.1.in:90 amulegui.1.in:66
#: amuleweb.1.in:198 ed2k.1.in:66
#: ../../src/utils/aLinkCreator/docs/alc.1.in:14
#: ../../src/utils/aLinkCreator/docs/alcc.1.in:29
#: ../../src/utils/cas/docs/cas.1.in:46
#: ../../src/utils/wxCas/docs/wxcas.1.in:19
msgid ""
"Please report bugs either on our forum (I<https://github.com/amule-"
"org/amule/discussions>), or in our bugtracker (I<https://github.com/amule-"
"org/amule/issues>).  Please do not report bugs in e-mail, neither to our "
"mailing list nor directly to any team member."
msgstr ""
"பிழைகளை எங்கள் மன்றத்திலோ (I<https://github.com/amule-"
"org/amule/discussions>) அல்லது எங்கள் பக்ட்ராக்கரில் "
"(I<https://github.com/amule-org/amule/issues>) புகாரளிக்கவும். தயவுசெய்து "
"மின்னஞ்சலில் பிழைகளைப் புகாரளிக்காதீர்கள், எங்கள் அஞ்சல் பட்டியலிலோ அல்லது "
"எந்த குழு உறுப்பினருக்கோ நேரடியாகவோ புகாரளிக்க வேண்டாம்."

