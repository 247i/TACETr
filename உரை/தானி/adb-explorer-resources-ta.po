msgid "New File"
msgstr "புதிய கோப்பு"

msgctxt "S_NEW_FOLDER"
msgid "New Folder"
msgstr "புதிய கோப்புறை"

#, ignore-same
msgctxt "S_CC_NAME"
msgid "Creative Commons"
msgstr "கிரியேட்டிவ் காமன்ச்"

msgctxt "S_LS_ERROR"
msgid ""
"An error occurred while trying to list the contents of this folder.\n"
"Visible content may be incomplete."
msgstr ""
"இந்தக் கோப்புறையின் உள்ளடக்கங்களை பட்டியலிட முயற்சிக்கும்போது பிழை ஏற்பட்டது. \n"
"காணக்கூடிய உள்ளடக்கம் முழுமையடையாமல் இருக்கலாம்."

msgctxt "S_PASTE_ANCESTOR"
msgid "{0} is an ancestor of the destination folder."
msgstr "{0} இலக்கு கோப்புறையின் மூதாதையர்."

msgctxt "S_KILL_EMULATOR"
msgid "Are you sure you want to kill this emulator?"
msgstr "இந்த எமுலேட்டரை நிச்சயமாகக் கொல்ல விரும்புகிறீர்களா?"

msgctxt "S_REM_DEVICE"
msgid "Are you sure you want to remove this device?"
msgstr "இந்தச் சாதனத்தை நிச்சயமாக அகற்ற விரும்புகிறீர்களா?"

#. 0 = Device name to remove
