msgid "More Info"
msgstr "மேலும் செய்தி"

msgctxt "S_ENABLED"
msgid "Enabled"
msgstr "இயக்கப்பட்டது"

msgctxt "S_DISABLED"
msgid "Disabled"
msgstr "முடக்கப்பட்டது"

