#, ignore-optional-plural
msgctxt "S_ANDROID_ICONS_TITLE"
msgid "The Android Robot Icon(s)"
msgstr "ஆண்ட்ராய்டு ரோபோ ஐகான்(கள்)"

msgctxt "S_ANDROID_ROBOT_LIC"
msgid ""
"The Android robot is reproduced or modified from work created and shared by "
"Google and used according to terms described in the Creative Commons 3.0 "
"Attribution License."
msgstr ""
"ஆண்ட்ராய்டு ரோபோ, Google ஆல் உருவாக்கப்பட்ட மற்றும் பகிர்ந்த பணியிலிருந்து "
"மீண்டும் உருவாக்கப்படுகிறது அல்லது மாற்றியமைக்கப்படுகிறது மற்றும் "
"கிரியேட்டிவ் காமன்ச் 3.0 பண்புக்கூறு உரிமத்தில் விவரிக்கப்பட்டுள்ள "
"விதிமுறைகளின்படி பயன்படுத்தப்படுகிறது."

msgctxt "S_APK_ICON_LIC"
msgid "The APK icon is licensed under the Apache License, Version 2.0."
msgstr "APK படவுரு Apache உரிமம், பதிப்பு 2.0 இன் கீழ் உரிமம் பெற்றது."

msgctxt "S_MISSING_ADB_OVERRIDE"
msgid "Could not get ADB version from provided path."
msgstr "வழங்கப்பட்ட பாதையிலிருந்து ADB பதிப்பைப் பெற முடியவில்லை."

msgctxt "S_ADB_VERSION_LOW_OVERRIDE"
msgid "ADB version from provided path is too low."
msgstr "வழங்கப்பட்ட பாதையிலிருந்து ADB பதிப்பு மிகவும் குறைவாக உள்ளது."

msgctxt "S_OVERRIDE_ADB_BROWSE"
msgid "Select ADB Executable"
msgstr "ADB இயங்கக்கூடியதைத் தேர்ந்தெடுக்கவும்"

msgctxt "S_RESET_SETTINGS_TITLE"
msgid "Reset App Settings"
msgstr "பயன்பாட்டு அமைப்புகளை மீட்டமைக்கவும்"

msgctxt "S_NEW_VERSION_TITLE"
msgid "New App Version"
msgstr "புதிய ஆப் பதிப்பு"

msgctxt "S_NAV_ERR_TITLE"
msgid "Navigation Error"
msgstr "வழிசெலுத்தல் பிழை"

msgctxt "S_COPY_APK_NAME"
msgid "Copy Package Name"
msgstr "தொகுப்பின் பெயரை நகலெடுக்கவும்"

msgctxt "S_COPY_PATH"
msgid "Copy Item Path"
msgstr "பொருள் பாதையை நகலெடு"

msgctxt "S_RESTORE_ALL"
msgid "Restore All Items"
msgstr "அனைத்து பொருட்களையும் மீட்டெடுக்கவும்"

#. The action to empty the recycle bin
msgctxt "S_EMPTY_TRASH"
msgid "Empty Recycle Bin"
msgstr "வெறுமை மறுசுழற்சி தொட்டி"

#, ignore-reused
msgctxt "S_DELETE_ACTION"
msgid "Delete"
msgstr "நீக்கு"

msgctxt "S_DEST_ERR"
