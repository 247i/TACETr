#. The drag tooltip when dragging multiple APK files over the installed apps
#. view. 0 - number of APKs being dragged
msgctxt "S_DRAG_INSTALL_MULTIPLE"
msgid "Install {0} APKs"
msgstr "{0} APKகளை நிறுவவும்"

#. The label of the switch toggle on a setting when it is on / active /
#. enabled
msgctxt "S_SETTINGS_ACTIVE"
msgid "On"
msgstr "அன்று"

#. The label of the switch toggle on a setting when it is off / inactive /
#. disabled
msgctxt "S_SETTINGS_INACTIVE"
msgid "Off"
msgstr "அணை"

#. The notification displayed when waiting for a status response from the
#. server
msgctxt "S_MDNS_IN_PROGRESS"
msgid "Checking mDNS server status…"
msgstr "mDNS சேவையக நிலையைச் சரிபார்க்கிறது…"

#. The title of the group for settings related to icons
msgctxt "S_SETTINGS_GROUP_ICONS"
msgid "Icons"
msgstr "சின்னங்கள்"

#. The title of the setting that controls thumbnail behavior
msgctxt "S_SETTINGS_THUMBNAIL_MODE"
msgid "Pull & Display Thumbnails"
msgstr "சிறுபடங்களை இழுத்து காட்சிப்படுத்தவும்"

#. Thumbnails mode setting: icon view mode
msgctxt "S_SETTINGS_THUMBS_ICON_VIEW"
msgid "Only in Icon View"
msgstr "படவுரு காட்சியில் மட்டும்"

#. Thumbnails mode setting: photo directories mode
msgctxt "S_SETTINGS_THUMBS_PHOTO_DIR"
msgid "Only in Photo Directories"
msgstr "புகைப்பட கோப்பகங்களில் மட்டும்"

#. Thumbnails mode setting: on connection mode
msgctxt "S_SETTINGS_THUMBS_CONNECT"
msgid "Upon Connection"
msgstr "இணைப்பில்"

#. The setting used allow saving thumbnails locally from one app session to
#. another
msgctxt "S_SETTINGS_PERSIST_THUMBS"
msgid "Persist Thumbnails Between Sessions"
msgstr "அமர்வுகளுக்கு இடையில் சிறுபடங்களைத் தொடரவும்"

#. The setting used to limit the speed at which thumbnails are pulled in bulk
#. from the device
msgctxt "S_SETTINGS_THUMBS_THROTTLE"
msgid "Limit Thumbnails Pull Speed"
msgstr "சிறு உருவங்களை இழுக்கும் வேகத்தை வரம்பிடவும்"

#. The setting used to allow displaying Windows icons for Windows special
#. folders (Downloads, Documents, etc.)
msgctxt "S_SETTINGS_SPECIAL_DIR_ICONS"
msgid "Show Icons For Special Folders"
msgstr "சிறப்பு கோப்புறைகளுக்கான ஐகான்களைக் காட்டு"

#. The setting to enable video thumbnails (pull & display)
msgctxt "S_SETTINGS_VIDEO_THUMBNAILS"
msgid "Include Video Thumbnails"
msgstr "வீடியோ சிறுபடங்களைச் சேர்க்கவும்"

#. Part of the tooltip of a video file (Length = duration)
msgctxt "S_VIDEO_DURATION"
msgid "Length"
msgstr "நீளம்"

#. Part of the tooltip of a picture file (dimensions = resolution)
msgctxt "S_PICTURE_DIMENSIONS"
msgid "Dimensions"
msgstr "பரிமாணங்கள்"

msgctxt "S_ONE_MONTH"
msgid "One Month"
msgstr "ஒரு மாதம்"

msgctxt "S_ONE_WEEK"
msgid "One Week"
msgstr "ஒரு வாரம்"

msgctxt "S_ONE_DAY"
msgid "One Day"
msgstr "ஒரு நாள்"

msgctxt "S_ONE_HOUR"
msgid "One Hour"
msgstr "ஒரு மணி நேரம்"

#. The setting used to control how long local persistent thumbnails should be
#. used before updating them
msgctxt "S_SETTINGS_THUMBS_AGE"
msgid "Local Thumbnails Refresh Time"
msgstr "உள்ளக சிறுபடங்கள் புதுப்பிக்கும் நேரம்"

#. The setting used to enable checking connected devices for busybox and which
#. shell commands it supports
msgctxt "S_SETTINGS_BUSYBOX"
msgid "Use BusyBox If Available"
msgstr "BusyBox இருந்தால் பயன்படுத்தவும்"

#. The setting used to enable checking for installed WSA, launching it, and
#. connecting to it automatically
msgctxt "S_SETTINGS_WSA"
msgid "Auto Connect WSA If Available"
msgstr "WSA இருந்தால் தானாக இணைக்கவும்"

#. The setting used to enable listing installed AVDs and launching them from
#. the device list
msgctxt "S_SETTINGS_EMULATOR_DISCOVERY"
msgid "Discover Android Emulators"
msgstr "ஆண்ட்ராய்டு எமுலேட்டர்களைக் கண்டறியவும்"

#. Tooltip for an emulator package device tile
msgctxt "S_EMULATOR_PKG_TIP"
msgid "Launch this emulator"
msgstr "இந்த முன்மாதிரியை இயக்கவும்"

#. The title of the dialog message to launch an emulator
msgctxt "S_EMULATOR_DIALOG_TITLE"
msgid "Emulator Launch"
msgstr "எமுலேட்டர் துவக்கம்"

#. Error message when the SDK emulator executable cannot be located
msgctxt "S_EMULATOR_SDK_NOT_FOUND"
msgid ""
"Android SDK emulator was not found. Install the Android SDK emulator package"
" or set ANDROID_SDK_ROOT."
msgstr ""
"ஆண்ட்ராய்டு SDK எமுலேட்டர் கிடைக்கவில்லை. ஆண்ட்ராய்டு SDK முன்மாதிரி "
"தொகுப்பை நிறுவவும் அல்லது ANDROID_SDK_ROOT ஐ அமைக்கவும்."

#. As in "Paste the copied string"
msgctxt "S_STRING_PASTE"
msgid "Paste"
msgstr "ஒட்டு"

#. A hint displayed for a short time in the snackbar
msgctxt "S_THUMB_SNACKBAR_CHECKING"
msgid "Checking for thumbnail updates"
msgstr "சிறுபட புதுப்பிப்புகளைச் சரிபார்க்கிறது"

#. A hint displayed for a short time in the snackbar
msgctxt "S_THUMB_SNACKBAR_PULLING"
msgid "Pulling thumbnails"
msgstr "சிறுபடங்களை இழுத்தல்"

#. A hint displayed for a short time in the snackbar
msgctxt "S_THUMB_SNACKBAR_READING"
msgid "Reading thumbnail locations and media database"
msgstr "சிறுபட இருப்பிடங்கள் மற்றும் மீடியா தரவுத்தளத்தைப் படித்தல்"

#. Thumbnail size selector - disabled (details view)
msgctxt "S_THUMBSIZE_DETAILS"
msgid "Details"
msgstr "விவரங்கள்"

#. The title of the thumbnail size selector menu
msgctxt "S_THUMBSIZE_TITLE"
msgid "View"
msgstr "பார்வை"

#. Thumbnail size selector - medium icons
msgctxt "S_THUMBSIZE_MEDIUM"
msgid "Medium Icons"
msgstr "நடுத்தர சின்னங்கள்"

#. Thumbnail size selector - large icons
msgctxt "S_THUMBSIZE_LARGE"
msgid "Large Icons"
msgstr "பெரிய சின்னங்கள்"

#. Thumbnail size selector - extra large icons
msgctxt "S_THUMBSIZE_XL"
msgid "Extra Large Icons"
msgstr "கூடுதல் பெரிய சின்னங்கள்"

#. The tooltip of the thumbnail size selector. view = icon view / details view
msgctxt "S_THUMBSIZE_TOOLTIP"
msgid "Layout and view options"
msgstr "தளவமைப்பு மற்றும் பார்வை விருப்பங்கள்"

#. The setting that enables keeping track of the last thumbnail size selected
#. for each location / folder
msgctxt "S_SETTINGS_THUMB_SIZE_PER_LOCATION"
msgid "Thumbnail Size Saved For Each Location"
msgstr "ஒவ்வொரு இடத்திற்கும் சிறுபட அளவு சேமிக்கப்பட்டது"

#. The button to sort files
msgctxt "S_SORT"
msgid "Sort"
msgstr "வரிசைப்படுத்து"

#. File list sorting direction - ascending
msgctxt "S_SORT_ASCENDING"
msgid "Ascending"
msgstr "ஏறுதல்"

#. File list sort direction - descending
msgctxt "S_SORT_DESCENDING"
msgid "Descending"
msgstr "இறங்கு"

#. The setting that enables keeping track of the last sorted column and
#. direction selected for each location / folder
msgctxt "S_SETTINGS_SORTING_PER_LOCATION"
msgid "Sorting column & order saved for each location"
msgstr ""
"ஒவ்வொரு இடத்திற்கும் வரிசைப்படுத்தல் நெடுவரிசை & வரிசை சேமிக்கப்பட்டது"

#. The name of the setting that enables using images for their own thumbnail
#. display, and the maximum size for such images
msgctxt "S_SETTINGS_MAX_CUSTOM_THUMB_WEIGHT"
msgid "Max Image Size To Use As Its Own Thumbnail (0 - Disabled)"
msgstr "அதன் சொந்த சிறுபடமாக பயன்படுத்த அதிகபட்ச பட அளவு (0 - முடக்கப்பட்டது)"

#. 0 - the number of file operations currently not displayed
msgctxt "S_FILEOP_HIDDEN_ITEMS"
msgid "and {0} more…"
msgstr "மேலும் {0}…"

#. The tooltip of the button that controls the details pane visibility
msgctxt "S_DETAILS_PANE_TOOLTIP"
msgid "Show or hide the details and preview pane."
msgstr "விவரங்கள் மற்றும் முன்னோட்டப் பலகத்தைக் காட்டவும் அல்லது மறைக்கவும்."

#. Side pane in file preview mode
msgctxt "S_SIDE_PANE_PREVIEW"
msgid "Preview"
msgstr "முன்னோட்டம்"

#. The maximum size of a file for preview
msgctxt "S_SETTINGS_PREVIEW_MAX_SIZE"
msgid "Max File Size For Preview"
msgstr "முன்னோட்டத்திற்கான அதிகபட்ச கோப்பு அளவு"

#. The setting that enables pulling a file to the default folder on double
#. click
msgctxt "S_SETTINGS_PULL_ON_DOUBLE_CLICK"
msgid "Pull To Default Folder On File Double Click"
msgstr ""
"கோப்பில் உள்ள இயல்புநிலை கோப்புறைக்கு இழுக்கவும் இருமுறை சொடுக்கு செய்யவும்"

#. The tip displayed in the details pane when multiple (or none) files are
#. selected
msgctxt "S_DETAILS_MULTI_FILE_SELECTED"
msgid "Select a single item to get more information."
msgstr "கூடுதல் தகவலைப் பெற, ஒரு பொருளைத் தேர்ந்தெடுக்கவும்."

#. Location as in parent path of a file
msgctxt "S_ITEM_LOCATION"
msgid "Location"
msgstr "இடம்"

#. The f-stop of an image metadata
msgctxt "S_IMAGE_F_STOP"
msgid "F-stop"
msgstr "எஃப்-ச்டாப்"

#. The ISO number of the image metadata
msgctxt "S_IMAGE_ISO"
msgid "ISO speed"
msgstr "ISO விரைவு"

#. The exposure time in parts of a second of the image metadata
msgctxt "S_IMAGE_EXPOSURE"
msgid "Exposure time"
msgstr "நேரிடுதல் காலம்"

#. The bitrate from the video file metadata
msgctxt "S_VIDEO_BITRATE"
msgid "Bitrate"
msgstr "பிட்ரேட்"

#. The hint displayed in the preview pane when no file is selected
msgctxt "S_PREVIEW_EMPTY_SELECTION"
msgid "Select a file to preview."
msgstr "மாதிரிக்காட்சிக்கு ஒரு கோப்பைத் தேர்ந்தெடுக்கவும்."

#. The hint displayed in the preview pane when the selected file(s) cannot be
#. previewed
msgctxt "S_PREVIEW_INVALID"
msgid "No preview available."
msgstr "முன்னோட்டம் இல்லை."

#. The hint displayed in the preview pane when the selected PDF is password
#. protected
msgctxt "S_PDF_PASSWORD_PROTECTED"
msgid "This PDF is password protected."
msgstr "இந்த PDF கடவுச்சொல் பாதுகாக்கப்பட்டுள்ளது."

#. Error shown in the PDF password prompt when the entered password is wrong
msgctxt "S_PDF_PASSWORD_WRONG"
msgid "Incorrect password."
msgstr "தவறான கடவுச்சொல்."

#. Button label to submit the PDF password
msgctxt "S_PDF_PASSWORD_UNLOCK"
msgid "Unlock"
msgstr "திறக்கவும்"

#. The title of the permissions section of a file in the details pane
msgctxt "S_FILE_PERMISSIONS"
msgid "Permissions"
msgstr "அனுமதிகள்"

#. Unix file permissions for the selected user
msgctxt "S_FILE_PERM_USER"
msgid "User"
msgstr "பயனர்"

#. Unix file permissions for the group the user is in
msgctxt "S_FILE_PERM_GROUP"
msgid "Group"
msgstr "குழு"

#. Unix file permissions for users outside the group
msgctxt "S_FILE_PERM_OTHER"
msgid "Others"
msgstr "மற்றவை"

#. File info - last access date
msgctxt "S_DATE_ACCESSED"
msgid "Accessed"
msgstr "அணுகப்பட்டது"

#. File info - creation time
msgctxt "S_CREATION_TIME"
msgid "Created"
msgstr "உருவாக்கப்பட்டது"

#. File info - date modified (but without "date")
msgctxt "S_FILE_INFO_MODIFIED"
msgid "Modified"
msgstr "மாற்றியமைக்கப்பட்ட"

#. The file system type of a drive
msgctxt "S_FILE_SYSTEM"
msgid "File system"
msgstr "கோப்பு முறைமை"

#. The Unix mount point of a drive
msgctxt "S_MOUNT_POINT"
msgid "Mount point"
msgstr "மவுண்ட் பாயிண்ட்"

#. The Unix mount options of a drive
msgctxt "S_MOUNT_OPTIONS"
msgid "Mount options"
msgstr "ஏற்ற விருப்பங்கள்"

#. The label of the red channel in the color picker
msgctxt "S_COLOR_RED"
msgid "Red"
msgstr "சிவப்பு"

#. The label of the green channel in the color picker
msgctxt "S_COLOR_GREEN"
msgid "Green"
msgstr "பச்சை"

#. The label of the blue channel in the color picker
msgctxt "S_COLOR_BLUE"
msgid "Blue"
msgstr "நீலம்"

#. 0 - the name of the Override ADB Path setting
msgctxt "S_ADB_NOT_FOUND"
msgid "Unable to locate ADB from system PATH. Please use \"{0}\" to locate it."
msgstr ""
"அமைப்பு பாதை இலிருந்து ADB ஐக் கண்டறிய முடியவில்லை. அதைக் கண்டுபிடிக்க "
"\"{0}\" ஐப் பயன்படுத்தவும்."

#. 0 - either "ADB" or nothing
msgctxt "S_ADB_PATH_INVALID"
msgid ""
"Provided {0} path is either a Windows shortcut or a UNC (remote) path, which"
" is not allowed."
msgstr ""
"வழங்கப்பட்ட {0} பாதையானது சாளரங்கள் சார்ட்கட் அல்லது UNC (ரிமோட்) "
"பாதையாகும், இது அனுமதிக்கப்படாது."

msgctxt "S_ADB_COMPROMISED"
msgid ""
"The provided executable cannot be verified as ADB. Make sure you download "
"only official Android Platform Tools from Google."
msgstr ""
"வழங்கப்பட்ட செயல்படுத்தக்கூடியவை ADB என சரிபார்க்க முடியாது. Google "
"இலிருந்து அதிகாரப்பூர்வ ஆண்ட்ராய்டு இயங்குதளக் கருவிகளை மட்டும் "
"பதிவிறக்குவதை உறுதிசெய்யவும்."

#. The button for pairing a device
msgctxt "S_BUTTON_PAIR"
msgid "Pair"
msgstr "பேரிக்காய்"
