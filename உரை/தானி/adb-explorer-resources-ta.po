msgctxt "S_NEW_VERSION"
msgid "A new {0}, version {1}, is available"
msgstr "புதிய {0}, பதிப்பு {1} கிடைக்கிறது"

msgctxt "S_GO_TO_VERSION_PAGE"
msgid "Go To Version Page"
msgstr "பதிப்புப் பக்கத்திற்குச் செல்லவும்"

#. The content of a button to dismiss a message dialog
msgctxt "S_BUTTON_CLOSE"
msgid "Close"
msgstr "மூடு"

msgctxt "S_GO_TO_RELEASE_NOTES"
msgid "Go To Release Notes"
msgstr "வெளியீட்டுக் குறிப்புகளுக்குச் செல்லவும்"

msgctxt "S_ADB_EXECUTABLE"
msgid "ADB Executable"
msgstr "ADB செயல்படுத்தக்கூடியது"

#, ignore-duplicate
msgctxt "S_HELP_ON_ADB"
msgid ""
"This app is a UI for ADB - Android Debug Bridge.\n"
"To use the app, you need to have ADB on your PC.\n"
"ADB is available as part of the Android SDK Platform Tools.\n"
"You can use the provided link to download the SDK Platform Tools.\n"
"Unfortunately, we cannot provide ADB with the app due to licensing restrictions."
msgstr ""
"இந்த ஆப்ச் ADBக்கான இடைமுகம் - ஆண்ட்ராய்டு Debug Bridge. \n"
"பயன்பாட்டைப் பயன்படுத்த, உங்கள் கணினியில் ADB இருக்க வேண்டும். \n"
"ADB ஆனது ஆண்ட்ராய்டு SDK இயங்குதளக் கருவிகளின் ஒரு பகுதியாகக் கிடைக்கிறது. \n"
"SDK இயங்குதளக் கருவிகளைப் பதிவிறக்க, வழங்கப்பட்ட இணைப்பைப் பயன்படுத்தலாம். \n"
"எதிர்பாராதவிதமாக, உரிமக் கட்டுப்பாடுகள் காரணமாக எங்களால் ADB க்கு பயன்பாட்டை வழங்க முடியாது."

msgctxt "S_HELP_ON_ADB_TITLE"
msgid "Help On ADB"
msgstr "ADB இல் உதவி"

msgctxt "S_RESTART_ADB_NOW"
msgid "Restart ADB Now"
msgstr "இப்போது ADB ஐ மீண்டும் தொடங்கவும்"

msgctxt "S_RESTART_LATER"
msgid "Restart Later"
msgstr "பின்னர் மறுதொடக்கம் செய்யுங்கள்"

