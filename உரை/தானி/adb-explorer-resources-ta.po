msgstr "இலக்கு பாதை பிழை"

msgctxt "S_FAILED_CONN"
msgid "failed to connect to"
msgstr "இணைக்க முடியவில்லை"

msgctxt "S_FAILED_CONN_TITLE"
msgid "Connection Error"
msgstr "இணைப்புப் பிழை"

msgctxt "S_DISCONN_FAILED_TITLE"
msgid "Disconnection Error"
msgstr "துண்டிப்பு பிழை"

msgctxt "S_PAIR_ERR_TITLE"
msgid "Pairing Error"
msgstr "இணைத்தல் பிழை"

msgctxt "S_ROOT_FORBID"
msgid "Root access cannot be enabled on selected device."
msgstr "தேர்ந்தெடுக்கப்பட்ட சாதனத்தில் ரூட் அணுகலை இயக்க முடியாது."

msgctxt "S_ROOT_FORBID_TITLE"
msgid "Root Access"
msgstr "ரூட் அணுகல்"

msgctxt "S_DEL_CONF_TITLE"
msgid "Confirm Delete"
msgstr "நீக்குவதை உறுதிப்படுத்தவும்"

msgctxt "S_PERM_DEL"
msgid "Permanently Delete"
msgstr "நிரந்தரமாக நீக்கு"

#. The title of the dialog shown when an error occurs during create new file /
#. folder
msgctxt "S_CREATE_ERR_TITLE"
msgid "Create Error"
msgstr "பிழையை உருவாக்கு"

#. The title of the dialog shown when file merge conflicts are detected while
#. trying to restore them from the recycle bin
msgctxt "S_RESTORE_CONF_TITLE"
msgid "Restore Conflicts"
msgstr "மோதல்களை மீட்டெடுக்கவும்"

msgctxt "S_CONF_UNI_TITLE"
msgid "Confirm Uninstall"
msgstr "நிறுவல் நீக்குவதை உறுதிப்படுத்தவும்"

msgctxt "S_INSTALL_APK"
msgid "Select packages to install"
msgstr "நிறுவுவதற்கு தொகுப்புகளைத் தேர்ந்தெடுக்கவும்"

msgctxt "S_REM_EMU"
msgid "Kill Emulator"
msgstr "கில் எமுலேட்டர்"

msgctxt "S_REM_HIST_DEV"
msgid "Remove Device"
msgstr "சாதனத்தை அகற்று"

msgctxt "S_REM_DEV"
msgid "Disconnect Device"
msgstr "சாதனத்தைத் துண்டிக்கவும்"

msgctxt "S_FILE_OP_TOOLTIP"
msgid "File Operations"
msgstr "கோப்பு செயல்பாடுகள்"

msgctxt "S_PUSH_PKG"
msgid "Install Packages"
msgstr "தொகுப்புகளை நிறுவவும்"

msgctxt "S_NEW_DEVICE_TIP"
msgid "Pair and/or connect a WiFi device (without using mDNS)"
msgstr ""
"வைஃபை சாதனத்தை இணைக்கவும் மற்றும்/அல்லது இணைக்கவும் (mDNS ஐப் "
"பயன்படுத்தாமல்)"

msgctxt "S_RESTART_APP"
msgid "Restart app for changes to take effect"
msgstr "மாற்றங்கள் நடைமுறைக்கு வர, பயன்பாட்டை மறுதொடக்கம் செய்யவும்"

msgctxt "S_READ_FILE_ERROR_TITLE"
msgid "Error Reading File"
msgstr "கோப்பைப் படிப்பதில் பிழை"

msgctxt "S_READ_FILE_ERROR"
msgid "Could not pull file in order to read it."
msgstr "அதைப் படிக்க கோப்பை இழுக்க முடியவில்லை."

msgctxt "S_WRITE_FILE_ERROR_TITLE"
msgid "Error Writing File"
msgstr "கோப்பு எழுதுவதில் பிழை"

msgctxt "S_WRITE_FILE_ERROR"
msgid "Could not push file back to device."
msgstr "கோப்பை மீண்டும் சாதனத்திற்குத் தள்ள முடியவில்லை."

msgctxt "S_DISABLE_MDNS"
msgid "ADB server needs to be restarted in order to disable mDNS."
msgstr "mDNS ஐ முடக்க, ADB சேவையகத்தை மறுதொடக்கம் செய்ய வேண்டும்."

msgctxt "S_DISABLE_MDNS_TITLE"
msgid "Disable mDNS"
msgstr "mDNS ஐ முடக்கு"

msgctxt "S_WSA_PKG_TIP"
msgid "Launch WSA in background"
msgstr "பின்னணியில் WSA ஐ இயக்கவும்"

msgctxt "S_PULL_ACTION"
msgid "Pull"
msgstr "இழு"

msgctxt "S_PULL_ACTION_LINK"
msgid "Pull (Link Target)"
msgstr "இழு (இணைப்பு இலக்கு)"

msgctxt "S_RESTORE_ACTION"
msgid "Restore"
msgstr "மீட்டமை"

msgctxt "S_LS_ERROR_TITLE"
msgid "List Directory Error"
msgstr "பட்டியல் கோப்பகப் பிழை"

msgctxt "S_WIN_ROOT_ILLEGAL_TITLE"
msgid "Pull To Windows Drive Root"
msgstr "சாளரங்கள் இயக்கி ரூட்டிற்கு இழுக்கவும்"

msgctxt "S_NEW_VERSION_MSG"
msgid ""
"Welcome to a new ADB Explorer version!\n"
"The release notes are available on GitHub."
msgstr ""
"புதிய ADB Explorer பதிப்பிற்கு வரவேற்கிறோம்! \n"
"வெளியீட்டு குறிப்புகள் GitHub இல் கிடைக்கின்றன."

#. Header for the drive restrictions tooltip in the navigation bar
msgctxt "S_DRIVE_RESTRICTIONS_HEADER"
msgid "Drive restrictions:"
msgstr "இயக்கி கட்டுப்பாடுகள்:"

msgctxt "S_RESTRICTION_READ_ONLY"
msgid "• Read-only filesystem"
msgstr "• படிக்க-மட்டும் கோப்பு முறைமை"

#. Restrictions bundled under the noexec mount option
msgctxt "S_RESTRICTION_NOEXEC"
msgid ""
"• Symbolic links are not supported\n"
"• File names cannot contain \" * / : < > ? \\ |\n"
"• File names are case insensitive\n"
"• Installation of APKs is not supported"
msgstr ""
"• குறியீட்டு இணைப்புகள் ஆதரிக்கப்படவில்லை \n"
"• கோப்பு பெயர்களில் \" * / : < > ? \\ | இருக்கக்கூடாது \n"
"• கோப்புப் பெயர்கள் உணர்ச்சியற்றவை \n"
"• APKகளை நிறுவுவது ஆதரிக்கப்படவில்லை"

msgctxt "S_RESET_SETTINGS"
msgid ""
"All app settings will be reset upon closing the app.\n"
"This cannot be undone. Are you sure?"
msgstr ""
"பயன்பாட்டை மூடியதும் அனைத்து ஆப்ச் அமைப்புகளும் மீட்டமைக்கப்படும். \n"
"இதை செயல்தவிர்க்க முடியாது. நீங்கள் உறுதியாக இருக்கிறீர்களா?"

msgctxt "S_WSA_LAUNCH"
msgid ""
"Select Launch if ADB is already authorized in WSA.\n"
"To approve ADB, open WSA advanced settings."
msgstr ""
"ADB ஏற்கனவே WSA இல் அங்கீகரிக்கப்பட்டிருந்தால், தொடங்கு என்பதைத் தேர்ந்தெடுக்கவும். \n"
"ADBஐ அங்கீகரிக்க, WSA மேம்பட்ட அமைப்புகளைத் திறக்கவும்."

msgctxt "S_WIN_ROOT_ILLEGAL"
msgid ""
"{0} of the selected files cannot be created under a Windows drive root."
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கோப்புகளில் {0}ஐ சாளரங்கள் இயக்கி ரூட்டின் கீழ் உருவாக்க"
" முடியாது."

msgctxt "S_ADB_LEARN_MORE"
msgid "Learn More About ADB"
msgstr "ADB பற்றி மேலும் அறிக"

msgctxt "S_ADB_DOWNLOAD"
msgid "Download ADB"
msgstr "ADB ஐப் பதிவிறக்கவும்"

msgctxt "S_LOCATE_ADB_TITLE"
msgid "Locate ADB (v{0} at least):"
msgstr "ADB ஐக் கண்டறிக (v{0} குறைந்தது):"

#. The content of a button used to change a path
msgctxt "S_BUTTON_CHANGE"
msgid "Change"
msgstr "மாற்றம்"

msgctxt "S_SELECT_ADB_PATH"
msgid "Select ADB Path"
msgstr "ADB பாதையைத் தேர்ந்தெடுக்கவும்"

#. The tooltip of a button used to continue to the next step
#, ignore-translated
msgctxt "S_BUTTON_CONTINUE_TOOLTIP"
msgid "Continue"
msgstr "தொடரவும்"

