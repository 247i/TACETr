#, read-only
msgctxt "extName"
msgid "EQ Toolkit - Audio equalizer"
msgstr "EQ கருவித்தொகுப்பு - ஆடியோ சமநிலைப்படுத்தி"

msgctxt "extDescription"
msgid ""
"EQ Toolkit is a free and open-source extension that provides audio control."
msgstr ""
"EQ கருவித்தொகுப்பு என்பது ஆடியோ கட்டுப்பாட்டை வழங்கும் இலவச மற்றும் திறந்த "
"மூல நீட்டிப்பாகும்."

msgctxt "gain_slider_label"
msgid "Gain:"
msgstr "ஆதாயம்:"

msgctxt "reset_button_label"
msgid "Reset"
msgstr "மீட்டமை"

msgctxt "enable_eq_button_label"
msgid "Enable EQ on this tab"
msgstr "இந்த தாவலில் EQ ஐ இயக்கவும்"

msgctxt "stop_eq_button_label"
msgid "Stop EQ on this tab"
msgstr "இந்த தாவலில் EQ ஐ நிறுத்தவும்"

msgctxt "empty_preset_name"
msgid "None"
msgstr "எதுவுமில்லை"

msgctxt "save_preset_button_label"
msgid "Save preset"
msgstr "முன்னமைவைச் சேமிக்கவும்"

msgctxt "enter_preset_name"
msgid "Enter name"
msgstr "பெயரை உள்ளிடவும்"

msgctxt "settings_title"
msgid "Settings"
msgstr "அமைப்புகள்"

msgctxt "presets_settings_title"
msgid "Presets"
msgstr "முன்னமைவுகள்"

msgctxt "community_settings_title"
msgid "Community"
msgstr "சமூகம்"

msgctxt "help_with_translation_label"
msgid "Help with translation:"
msgstr "மொழிபெயர்ப்பு உதவி:"

msgctxt "source_code_label"
msgid "Source code:"
msgstr "மூல குறியீடு:"

msgctxt "import_presets_button_label"
msgid "Import"
msgstr "இறக்குமதி"

msgctxt "export_presets_button_label"
msgid "Export"
msgstr "ஏற்றுமதி"

msgctxt "enable_spectrum_setting_option"
msgid "Enable spectrum visualisation, need to restart page (high CPU load)"
msgstr ""
"ச்பெக்ட்ரம் காட்சிப்படுத்தலை இயக்கு, பக்கத்தை மறுதொடக்கம் செய்ய வேண்டும் "
"(அதிக சிபியு சுமை)"

msgctxt "points_count_setting_option"
msgid "Number of EQ points"
msgstr "ஈக்யூ புள்ளிகளின் எண்ணிக்கை"

msgctxt "points_reset_title"
msgid "Change points count?"
msgstr "புள்ளிகளின் எண்ணிக்கையை மாற்றவா?"

msgctxt "points_reset_message"
msgid "Changing the number of points will reset the current EQ settings."
msgstr ""
"புள்ளிகளின் எண்ணிக்கையை மாற்றுவது தற்போதைய EQ அமைப்புகளை மீட்டமைக்கும்."

msgctxt "points_reset_skip"
msgid "Don't show again"
msgstr "மீண்டும் காட்டாதே"

msgctxt "ok"
msgid "Ok"
msgstr "சரி"

msgctxt "cancel"
msgid "Cancel"
msgstr "ரத்துசெய்"

msgctxt "theme_setting_option"
msgid "Theme"
msgstr "கருப்பொருள்"

msgctxt "capture_error_prefix"
msgid "Failed to capture the audio stream. Try using \"Window mode\"."
msgstr ""
"ஆடியோ ச்ட்ரீமைப் பிடிக்க முடியவில்லை. \"சாளர பயன்முறையை\" பயன்படுத்தி "
"முயற்சிக்கவும்."

msgctxt "toolkit_window_already_open"
msgid "Equalizer is already open in a window"
msgstr "Equalizer ஏற்கனவே ஒரு சாளரத்தில் திறக்கப்பட்டுள்ளது"

msgctxt "support_me"
msgid "Support me"
msgstr "என்னை ஆதரிக்கவும்"

msgctxt "settings_button_tooltip"
msgid "Settings"
msgstr "அமைப்புகள்"

#, ignore-reused
msgctxt "volume_mute_button_tooltip"
msgid "Mute/unmute volume"
msgstr "ஒலியளவை முடக்கு/அன்மியூட்"

msgctxt "window_mode_button_tooltip"
msgid "Open window mode"
msgstr "சாளர பயன்முறையைத் திறக்கவும்"

msgctxt "add_to_autostart_tooltip"
msgid "Add current site to autostart whitelist"
msgstr "ஆட்டோச்டார்ட் அனுமதிப்பட்டியலுக்கு தற்போதைய தளத்தைச் சேர்க்கவும்"

msgctxt "autostart_modal_title"
msgid "Add to auto start"
msgstr "தானியங்கு தொடக்கத்தில் சேர்க்கவும்"

msgctxt "autostart_settings_title"
msgid "Auto start"
msgstr "ஆட்டோ ச்டார்ட்"

msgctxt "autostart_rule_type_domain_label"
msgid "Domain"
msgstr "டொமைன்"

msgctxt "autostart_rule_type_url_label"
msgid "URL"
msgstr "முகவரி"

msgctxt "autostart_modal_preset_label"
msgid "Preset"
msgstr "முன்னமைவு"

msgctxt "autostart_settings_select_preset_placeholder"
msgid "Select preset"
msgstr "முன்னமைவைத் தேர்ந்தெடுக்கவும்"

msgctxt "autostart_whitelist_empty"
msgid "Whitelist is empty"
msgstr "ஏற்புப் பட்டியல் காலியாக உள்ளது"

msgctxt "autostart_validation_error"
msgid "Enter a valid domain or URL and select a preset."
msgstr ""
"சரியான டொமைன் அல்லது முகவரி ஐ உள்ளிட்டு முன்னமைவைத் தேர்ந்தெடுக்கவும்."

msgctxt "preset_delete_error"
msgid ""
"This preset is used in auto start rules. Remove the related rules first."
msgstr ""
"இந்த முன்னமைவு தானியங்கு தொடக்க விதிகளில் பயன்படுத்தப்படுகிறது. முதலில் "
"தொடர்புடைய விதிகளை நீக்கவும்."

msgctxt "add"
msgid "Add"
msgstr "கூட்டு"

msgctxt "delete"
msgid "Delete"
msgstr "நீக்கு"

msgctxt "language_setting_option"
msgid "Language"
msgstr "மொழி"

msgctxt "shortcuts_settings_title"
msgid "Shortcuts"
msgstr "குறுக்குவழிகள்"

#, ignore-multiple-failures
msgctxt "shortcut_mute_label"
msgid "Mute/unmute"
msgstr "முடக்கு/அன்முட்"

msgctxt "shortcut_toggle_eq_label"
msgid "Enable/disable"
msgstr "இயக்கு/முடக்கு"

msgctxt "shortcut_validation_error"
msgid ""
"Use at least one modifier (Ctrl, Alt, Shift, or Meta) and one letter or "
"number."
msgstr ""
"குறைந்தபட்சம் ஒரு மாற்றியை (Ctrl, Alt, உயர்த்து அல்லது Meta) மற்றும் ஒரு "
"எழுத்து அல்லது எண்ணைப் பயன்படுத்தவும்."

msgctxt "shortcut_duplicate_error"
msgid "This shortcut is already used by another command."
msgstr "இந்த குறுக்குவழி ஏற்கனவே மற்றொரு கட்டளையால் பயன்படுத்தப்பட்டது."
