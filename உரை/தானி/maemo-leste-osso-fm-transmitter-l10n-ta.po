msgctxt "fmtx_fi_fmtx_on_off"
msgid "FM transmitter on"
msgstr "FM டிரான்ச்மிட்டர் இயக்கப்பட்டது"

msgctxt "fmtx_fi_frequency"
msgid "Frequency"
msgstr "மீடிறன், மீள்திறன், நிகழ்வெண், நிகழ்வு"

msgctxt "fmtx_ib_general_error"
msgid "Unable to use FM transmitter"
msgstr "FM டிரான்ச்மிட்டரைப் பயன்படுத்த முடியவில்லை"

msgctxt "fmtx_ni_cable_error"
msgid ""
"Unable to use FM transmitter while headset or TV out cable is connected.\n"
"Unplug cable to continue using FM transmitter."
msgstr ""
"எட்செட் அல்லது டிவி அவுட் கேபிள் இணைக்கப்பட்டிருக்கும் போது எஃப்எம் டிரான்ச்மிட்டரைப் பயன்படுத்த முடியாது. \n"
"FM டிரான்ச்மிட்டரைத் தொடர்ந்து பயன்படுத்த கேபிளைத் துண்டிக்கவும்."

msgctxt "fmtx_ni_disabled"
msgid "FM transmitter disabled"
msgstr "FM டிரான்ச்மிட்டர் முடக்கப்பட்டது"

msgctxt "fmtx_ni_usb_error"
msgid ""
"Unable to use FM transmitter while USB is connected.\n"
"Unplug USB to continue using FM transmitter."
msgstr ""
"USB இணைக்கப்பட்டிருக்கும் போது FM டிரான்ச்மிட்டரைப் பயன்படுத்த முடியவில்லை. \n"
"எஃப்எம் டிரான்ச்மிட்டரைத் தொடர்ந்து பயன்படுத்த USB ஐ அவிழ்த்து விடுங்கள்."

msgctxt "fmtx_ti_fm_transmitter"
msgid "FM transmitter"
msgstr "எஃப்எம் டிரான்ச்மிட்டர்"

msgctxt "fmtx_ti_select_frequency"
msgid "Select frequency"
msgstr "அதிர்வெண்ணைத் தேர்ந்தெடுக்கவும்"

msgctxt "fmtx_va_frequency"
msgid "%s MHz"
msgstr "%s மெகா எர்ட்ச்"

msgctxt "fmxt_ap_fm_transmitter"
msgid "FM transmitter"
msgstr "எஃப்எம் டிரான்ச்மிட்டர்"
