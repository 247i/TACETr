#, java-printf-format
msgctxt "app_name"
msgid "Bimba"
msgstr "பெண்"

#, java-printf-format
msgctxt "title_home"
msgid "Home"
msgstr "வீடு"

#, java-printf-format
msgctxt "title_map"
msgid "Map"
msgstr "வரைபடம்"

#, java-printf-format
msgctxt "title_journey"
msgid "Journey"
msgstr "பயணம்"

#. Accessibility/screen reader text that describes button with GPS icon
#, java-printf-format
msgctxt "home_fab_description"
msgid "GPS icon"
msgstr "சி.பி.எச் படவுரு"

#. Plus Codes or Open Location Codes
#. (https://en.wikipedia.org/wiki/Open_Location_Code)
#, java-printf-format
msgctxt "search_placeholder"
msgid "stops, lines, or plus codes"
msgstr "நிறுத்தங்கள், கோடுகள் அல்லது பிளச் குறியீடுகள்"

#, java-printf-format
msgctxt "title_activity_results"
msgid "Results"
msgstr "முடிவுகள்"

#. Error message when request to API is not correct. Possibly, inconsistent
#. versions of API are used by the app and the server. Might need to update
#. the app (or wait for an update to the server)
#, java-printf-format
msgctxt "error_400"
msgid "The application made a malformed request"
msgstr "விண்ணப்பம் ஒரு தவறான கோரிக்கையை ஏற்படுத்தியது"

#, java-printf-format
msgctxt "error_401"
msgid "A token is needed to use this server"
msgstr "இந்த சேவையகத்தைப் பயன்படுத்த ஒரு கிள்ளாக்கு தேவை"

#, java-printf-format
msgctxt "error_403"
msgid "The token you provided is incorrect"
msgstr "நீங்கள் வழங்கிய கிள்ளாக்கு தவறானது"

#. A line, stop, URL was not found on the server
#, java-printf-format
msgctxt "error_404"
msgid "Not found"
msgstr "கண்டுபிடிக்கப்படவில்லை"

#, java-printf-format
msgctxt "error_429"
msgid "Rate limit exceeded. Try again later"
msgstr "விகித வரம்பு மீறியது. பின்னர் மீண்டும் முயற்சிக்கவும்"

#, java-printf-format
msgctxt "error_50x"
msgid "There was an error on the sever. Try again later"
msgstr "சேவையகத்தில் பிழை ஏற்பட்டது. பின்னர் மீண்டும் முயற்சிக்கவும்"

#, java-printf-format
msgctxt "error_unknown"
msgid "Unknown error happened"
msgstr "தெரியாத பிழை நடந்தது"

#, java-printf-format
msgctxt "error_offline"
msgid "You are offline. Connect to the Internet"
msgstr "நீங்கள் ஆஃப்லைனில் இருக்கிறீர்கள். இணையத்துடன் இணைக்கவும்"

#. Locating the phone using GPS/GALILEO/Wi-Fi/other satnav was not possible
#. withing some timeframe and user's position is unknown
#, java-printf-format
msgctxt "error_gps"
msgid "Cannot obtain current location"
msgstr "தற்போதைய இருப்பிடத்தைப் பெற முடியாது"

#. No departures for specific stop at the given time were found. For the time
#. being, no vehicle will depart
#, java-printf-format
msgctxt "no_departures"
msgid "No departures"
msgstr "புறப்படுவதில்லை"

#. The phone is being located using GPS/GALILEO/Wi-Fi/other satnav and the
#. application waits for a meaningful position information
#, java-printf-format
msgctxt "waiting_position"
msgid "waiting for position"
msgstr "பதவிக்காக காத்திருக்கிறது"

#. » is converted into an arrow;
#. 13 » Junikowo on the screenshot
#, java-printf-format, xml-text
msgctxt "vehicle_headsign"
msgid ""
"<annotation decoration=\"apply\"><annotation "
"arg=\"0\">%1$s</annotation></annotation> » <annotation "
"arg=\"1\">%2$s</annotation>"
msgstr ""
"<annotation decoration=\"apply\"><annotation arg=\"0\">%1$s "
"</annotation></annotation>» <annotation arg=\"1\">%2$s</annotation>"

#, java-printf-format, xml-text
msgctxt "vehicle_headsign_no_headsign"
msgid ""
"line <annotation decoration=\"apply\"><annotation "
"arg=\"0\">%1$s</annotation></annotation>"
msgstr ""
"வரி <annotation அலங்காரம்=\"apply\"><annotation "
"arg=\"0\">%1$s</annotation></annotation>"

