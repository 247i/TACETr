msgctxt "distance_in_gf"
msgid "%1$s %2$sGf"
msgstr "%1$s %2$s சிஃப்"

#.  grafut is a unit of distance in TGM
#. content description/text-to-speech text for distance in grafut;
#. consult http://www.dozenalsociety.org.uk/pdfs/TGMbooklet.pdf,
#. https://dozenal.org/drupal/sites_bck/default/files/tgm_0.pdf, or Your local
#. dozenal society
