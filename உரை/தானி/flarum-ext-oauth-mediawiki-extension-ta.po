msgctxt "fof-oauth->admin->settings->providers->mediawiki->description"
msgid ""
"Configure your MediaWiki OAuth2 application. See the documentation at {link}"
msgstr ""
"உங்கள் MediaWiki OAuth2 பயன்பாட்டை உள்ளமைக்கவும். ஆவணத்தை {link} இல் "
"பார்க்கவும்"

msgctxt "fof-oauth->admin->settings->providers->mediawiki->base_url_label"
msgid "MediaWiki Base URL"
msgstr "மீடியாவிக்கி அடிப்படை முகவரி"

msgctxt "fof-oauth->admin->settings->providers->mediawiki->client_id_label"
msgid "Client Key"
msgstr "வாங்கி திறவுகோல்"

msgctxt ""
"fof-oauth->admin->settings->providers->mediawiki->client_secret_label"
msgid "=> fof-oauth.ref.settings.client_secret"
msgstr "=> fof-oauth.ref.settings.client_secret"

msgctxt "fof-oauth->admin->settings->providers->mediawiki->user_agent_label"
msgid "User Agent"
msgstr "பயனர் முகவர்"

msgctxt "fof-oauth->admin->settings->providers->mediawiki->icon_label"
msgid "Provider Icon (FontAwesome class)"
msgstr "வழங்குநர் படவுரு (FontAwesome வகுப்பு)"

msgctxt "fof-oauth->forum->log_in->with_mediawiki_button"
msgid "=> fof-oauth.forum.log_in.with_button"
msgstr "=> fof-oauth.forum.log_in.with_button"

msgctxt "fof-oauth->forum->error->wiki_user_blocked"
msgid ""
"Your MediaWiki account has been blocked and you cannot log in to this forum."
msgstr ""
"உங்கள் மீடியாவிக்கி கணக்கு தடுக்கப்பட்டுள்ளது, மேலும் நீங்கள் இந்த "
"மன்றத்தில் உள்நுழைய முடியாது."

msgctxt "fof-oauth->forum->error->invalid_email"
msgid ""
"Unable to retrieve an email address from your MediaWiki account. Please use "
"another login method."
msgstr ""
"உங்கள் மீடியாவிக்கி கணக்கிலிருந்து மின்னஞ்சல் முகவரியை மீட்டெடுக்க "
"முடியவில்லை. மற்றொரு உள்நுழைவு முறையைப் பயன்படுத்தவும்."

msgctxt "fof-oauth->forum->providers->mediawiki"
msgid "=> fof-oauth.lib.providers.mediawiki"
msgstr "=> fof-oauth.lib.providers.mediawiki"

msgctxt "fof-oauth->lib->providers->mediawiki"
msgid "MediaWiki"
msgstr "மீடியாவிக்கி"
