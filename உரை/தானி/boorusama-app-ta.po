msgstr "பநிஇ விசை"

msgctxt "booru.password_label"
msgid "Password"
msgstr "கடவுச்சொல்"

msgctxt "booru.content_filtering_label"
msgid "Content filtering"
msgstr "உள்ளடக்க வடிகட்டுதல்"

msgctxt "booru.content_filtering.none"
msgid "None"
msgstr "எதுவுமில்லை"

msgctxt "booru.content_filtering.moderate"
msgid "Moderate"
msgstr "மிதமான"

msgctxt "booru.content_filtering.aggressive"
msgid "Aggressive"
msgstr "வன்கவர்வு"

msgctxt "booru.content_filtering.custom"
msgid "Custom"
msgstr "தனிப்பயன்"

msgctxt "booru.choose_a_custom_filtering.one"
msgid "Choose a rating that you want to exclude from the search."
msgstr ""
"தேடலில் இருந்து நீங்கள் விலக்க விரும்பும் மதிப்பீட்டைத் தேர்வு செய்யவும்."

msgctxt "booru.choose_a_custom_filtering.other"
msgid "Choose ratings that you want to exclude from the search."
msgstr ""
"தேடலில் இருந்து நீங்கள் விலக்க விரும்பும் மதிப்பீடுகளைத் தேர்ந்தெடுக்கவும்."

msgctxt "booru.hide_deleted_label"
msgid "Hide deleted posts"
msgstr "நீக்கப்பட்ட இடுகைகளை மறைக்கவும்"

msgctxt "booru.hide_deleted_description"
msgid "Hide low-quality images, some decent ones might also be hidden."
msgstr "தகுதி குறைந்த படங்களை மறை, சில கண்ணியமான படங்கள் மறைக்கப்படலாம்."

msgctxt "booru.hide_banned_label"
msgid "Hide banned posts"
msgstr "தடை செய்யப்பட்ட இடுகைகளை மறை"

msgctxt "booru.hide_banned_description"
msgid "Completely hide images that have been banned by the site."
msgstr "தளத்தால் தடைசெய்யப்பட்ட படங்களை முழுமையாக மறைக்கவும்."

msgctxt "booru.config_booru_confirm"
msgid "OK"
msgstr "சரி"

msgctxt "booru.add_a_booru_site"
msgid "Create a new profile"
msgstr "புதிய சுயவிவரத்தை உருவாக்கவும்"

msgctxt "booru.next_step"
msgid "Next"
msgstr "அடுத்தது"

msgctxt "booru.site_url"
msgid "Site URL"
msgstr "தள முகவரி"

msgctxt "booru.validation_empty_url"
msgid "URL is empty"
msgstr "முகவரி காலியாக உள்ளது"

msgctxt "booru.validation_invalid_url"
msgid "\"{0}\" is not a valid URL"
msgstr "\"{0}\" என்பது சரியான முகவரி அல்ல"

msgctxt "booru.validation_invalid_http_url"
msgid "\"{0}\" is not an HTTP or HTTPS URL"
msgstr "\"{0}\" என்பது ஒரு http அல்லது https முகவரி அல்ல"

msgctxt "booru.validation_redundant_www"
msgid "\"{0}\" contains redundant \"www\""
msgstr "\"{0}\" தேவையற்ற \"www\""

msgctxt "booru.validation_contains_spaces"
msgid "\"{0}\" contains in-between spaces"
msgstr "\"{0}\" இடையே இடைவெளிகளைக் கொண்டுள்ளது"

msgctxt "booru.validation_missing_scheme"
msgid "\"{0}\" is missing a scheme (e.g. https://)"
msgstr "\"{0}\" ஒரு திட்டத்தைக் காணவில்லை (எ.கா. https: //)"

msgctxt "booru.api_key.auth_error.edit_api_key"
msgid "Edit API key"
msgstr "பநிஇ விசையைத் திருத்து"

msgctxt "booru.api_key.auth_error.empty_key_warning"
msgid ""
"This site may require you to enter your API key or password to access its "
"content."
msgstr ""
"இந்தத் தளத்தின் உள்ளடக்கத்தை அணுக உங்கள் பநிஇ விசை அல்லது கடவுச்சொல்லை "
"உள்ளிட வேண்டும்."

msgctxt "booru.api_key.auth_error.invalid_key_warning"
msgid "Check your API key or credentials, as they may be invalid or expired."
msgstr ""
"உங்கள் பநிஇ விசை அல்லது நற்சான்றிதழ்களைச் சரிபார்க்கவும், ஏனெனில் அவை "
"தவறானதாகவோ அல்லது காலாவதியாகவோ இருக்கலாம்."

msgctxt "booru.misc"
msgid "Misc"
msgstr "இதர"

msgctxt "booru.authentication.title"
msgid "Authentication"
msgstr "ஏற்பு"

msgctxt "booru.authentication.gelbooru.basic_auth"
msgid "Basic Auth (required)"
msgstr "அடிப்படை ஏற்பு (தேவை)"

msgctxt "booru.authentication.gelbooru.basic_auth_description"
msgid ""
"Providing this information gives the app read access to your account. This "
"is required by Gelbooru as of 06/2025."
msgstr ""
"இந்தத் தகவலை வழங்குவதன் மூலம், உங்கள் கணக்கிற்கான வாசிப்பு அணுகலை "
"பயன்பாட்டிற்கு வழங்குகிறது. 06/2025 இன் படி Gelbooru க்கு இது "
"தேவைப்படுகிறது."

msgctxt "booru.authentication.gelbooru.advanced_auth"
msgid "Advanced Auth (optional)"
msgstr "மேம்பட்ட ஏற்பு (விரும்பினால்)"

msgctxt "booru.authentication.gelbooru.advanced_auth_description"
msgid ""
"Providing this information allows you to edit your favorites and provides "
"write access to your account. Note that if you change your password, you "
"will need to log in again."
msgstr ""
"இந்தத் தகவலை வழங்குவதன் மூலம், உங்களுக்குப் பிடித்தவற்றைத் திருத்தலாம் "
"மற்றும் உங்கள் கணக்கிற்கு எழுதும் அணுகலை வழங்குகிறது. உங்கள் கடவுச்சொல்லை "
"மாற்றினால், நீங்கள் மீண்டும் உள்நுழைய வேண்டும் என்பதை நினைவில் கொள்ளவும்."

msgctxt "booru.authentication.gelbooru.fav_button_tooltip_title"
msgid "About the favorite button"
msgstr "பிடித்த பொத்தான் பற்றி"

msgctxt "booru.authentication.gelbooru.fav_button_tooltip_description"
msgid ""
"There is no way to check if an image has already been favorited. Although "
"you can see the visual indicator after favoriting an image, it will reset "
"when you restart the app. Don't worry, your favorites are still saved on the"
" website."
msgstr ""
"ஒரு படம் ஏற்கனவே பிடித்ததா என்பதைச் சரிபார்க்க வழி இல்லை. ஒரு படத்தை பிடித்த"
" பிறகு, காட்சி குறிகாட்டியைப் பார்க்க முடியும் என்றாலும், நீங்கள் பயன்பாட்டை"
" மறுதொடக்கம் செய்யும் போது அது மீட்டமைக்கப்படும். கவலைப்பட வேண்டாம், "
"உங்களுக்குப் பிடித்தவை இன்னும் இணையதளத்தில் சேமிக்கப்பட்டுள்ளன."

msgctxt "booru.listing.title"
msgid "Listing"
msgstr "பட்டியல்"

msgctxt "booru.listing.thumbnail_button"
msgid "Thumbnail's button"
msgstr "சிறுபடத்தின் பொத்தான்"

msgctxt "booru.listing.thumbnail_button_description"
msgid "Change the default button at the right bottom of the thumbnail."
msgstr "சிறுபடத்தின் வலது கீழே உள்ள இயல்புநிலை பொத்தானை மாற்றவும்."

msgctxt "booru.listing.tooltip_on_hover_title"
msgid "Show tooltip on hover"
msgstr "வட்டமிடுவதில் உதவிக்குறிப்பைக் காட்டு"

msgctxt "booru.listing.tooltip_on_hover_description"
msgid "Show preview information when hovering over the thumbnail."
msgstr "சிறுபடத்தில் வட்டமிடும்போது முன்னோட்டத் தகவலைக் காட்டு."

msgctxt "booru.listing.enable_profile_specific_settings"
msgid "Enable profile's specific settings"
msgstr "சுயவிவரத்தின் குறிப்பிட்ட அமைப்புகளை இயக்கவும்"

msgctxt "booru.listing.enable_profile_specific_settings_description"
msgid ""
"Override the global settings for this the profile. If enabled, global "
"settings will be ignored until this is disabled."
msgstr ""
"இந்த சுயவிவரத்திற்கான உலகளாவிய அமைப்புகளை மேலெழுதவும். இயக்கப்பட்டால், இது "
"முடக்கப்படும் வரை உலகளாவிய அமைப்புகள் புறக்கணிக்கப்படும்."

msgctxt "booru.listing.overridden_notice"
msgid ""
"These settings are overridden by custom listing. Go to <b><a href=\"booru-"
"profiles\">Profile's Listing</a></b> page instead."
msgstr ""
"இந்த அமைப்புகள் தனிப்பயன் பட்டியல் மூலம் மேலெழுதப்படுகின்றன. அதற்குப் பதிலாக"
" <b><a href=\"booru-profiles\">சுயவிவரப் பட்டியல்</a></b> பக்கத்திற்குச் "
"செல்லவும்."

msgctxt "booru.search.title"
msgid "Search"
msgstr "தேடல்"

msgctxt "booru.search.include_in_search"
msgid "Include these tags in every search"
msgstr "ஒவ்வொரு தேடலிலும் இந்தக் குறிச்சொற்களைச் சேர்க்கவும்"

msgctxt "booru.search.exclude_from_search"
msgid "Exclude these tags from every search"
msgstr "ஒவ்வொரு தேடலிலிருந்தும் இந்தக் குறிச்சொற்களை விலக்கவும்"

msgctxt "booru.search.include_exclude_tooltip"
msgid ""
"These tags will be appended to every search that the app makes, not just the"
" ones you make manually."
msgstr ""
"இந்தக் குறிச்சொற்கள், நீங்கள் கைமுறையாகச் செய்தவை மட்டுமின்றி, ஆப்ச் "
"செய்யும் ஒவ்வொரு தேடலிலும் சேர்க்கப்படும்."

msgctxt "booru.search.preview_tags"
msgid "Preview"
msgstr "முன்னோட்டம்"

msgctxt "booru.search.any_search_query"
msgid "<any search query>"
msgstr "<ஏதேனும் தேடல் வினவல்>"

msgctxt "booru.search.enable_profile_specific_settings"
msgid "Enable profile-specific blacklist"
msgstr "சுயவிவரம் சார்ந்த தடுப்புப்பட்டியலை இயக்கு"

msgctxt "booru.search.blacklist"
msgid "Blacklist"
msgstr "தடுப்புப்பட்டியல்"

msgctxt "booru.search.empty_blacklist"
msgid "No tags"
msgstr "குறிச்சொற்கள் இல்லை"

msgctxt "booru.search.empty_blacklist_with_replace_notice"
msgid ""
"Empty blacklist with replace mode will effectively disable blacklist "
"entirely."
msgstr ""
"மாற்று பயன்முறையுடன் காலியான தடுப்புப்பட்டியலை திறம்பட தடுக்கும் பட்டியலை "
"முழுவதுமாக முடக்கும்."

msgctxt "booru.search.blacklist_overridden.replace_notice"
msgid ""
"Replaced by <b><a href=\"booru-profiles\">Profile's Blacklist</a></b> "
"settings."
msgstr ""
"<b><a href=\"booru-profiles\">சுயவிவரத்தின் தடுப்புப்பட்டியல்</a></b> "
"அமைப்புகளால் மாற்றப்பட்டது."

msgctxt "booru.search.blacklist_overridden.merge_notice"
msgid ""
"Merged with <b><a href=\"booru-profiles\">Profile's Blacklist</a></b> "
"settings."
msgstr ""
"<b><a href=\"booru-profiles\">சுயவிவரத்தின் தடுப்புப்பட்டியல்</a></b> "
"அமைப்புகளுடன் இணைக்கப்பட்டது."

msgctxt "booru.search.blacklist_combine_mode.title"
msgid "Combination mode"
msgstr "சேர்க்கை முறை"

msgctxt "booru.search.blacklist_combine_mode.merge"
msgid "Merge"
msgstr "ஒன்றிணைக்கவும்"

msgctxt "booru.search.blacklist_combine_mode.merge_description"
msgid "Merge this blacklist together with the other blacklists."
msgstr "இந்த தடுப்புப்பட்டியலை மற்ற தடுப்புப்பட்டியலுடன் இணைக்கவும்."

msgctxt "booru.search.blacklist_combine_mode.replace"
msgid "Replace"
msgstr "மாற்றவும்"

msgctxt "booru.search.blacklist_combine_mode.replace_description"
msgid ""
"Override global blacklist with this blacklist. Useful when you want to have "
"a blacklist that is only used for this profile without affecting the global "
"blacklist."
msgstr ""
"இந்த தடுப்புப்பட்டியலின் மூலம் உலகளாவிய தடுப்புப்பட்டியலை மேலெழுதவும். "
"உலகளாவிய தடுப்புப்பட்டியலை பாதிக்காமல் இந்த சுயவிவரத்திற்கு மட்டுமே "
"பயன்படுத்தப்படும் தடுப்புப்பட்டியலை நீங்கள் வைத்திருக்க விரும்பினால் "
"பயனுள்ளதாக இருக்கும்."

msgctxt "booru.network.title"
msgid "Network"
msgstr "பிணையம்"

msgctxt "booru.network.proxy.title"
msgid "Proxy"
msgstr "பதிலாள்"

msgctxt "booru.network.proxy.select_type"
msgid "<Select>"
msgstr "<தேர்ந்தெடு>"

msgctxt "booru.network.proxy.type"
msgid "Proxy Type"
msgstr "பதிலாள் வகை"

msgctxt "booru.network.proxy.host_or_ip"
msgid "Host or IP (*)"
msgstr "புரவலன் அல்லது ஐபி (*)"

msgctxt "booru.network.proxy.host_or_ip_hint"
msgid "e.g. proxy.host.com or 123.456.789.0"
msgstr "எ.கா. proxy.host.com அல்லது 123.456.789.0"

msgctxt "booru.network.proxy.port"
msgid "Port (*)"
msgstr "துறைமுகம் (*)"

msgctxt "booru.network.proxy.port_hint"
msgid "e.g. 8080"
msgstr "எ.கா. 8080"

msgctxt "booru.network.proxy.username"
msgid "Username"
msgstr "பயனர் பெயர்"

msgctxt "booru.network.proxy.username_hint"
msgid "username (optional)"
msgstr "பயனர்பெயர் (விரும்பினால்)"

msgctxt "booru.network.proxy.password"
msgid "Password"
msgstr "கடவுச்சொல்"

msgctxt "booru.network.proxy.password_hint"
msgid "password (optional)"
msgstr "கடவுச்சொல் (விரும்பினால்)"

msgctxt "booru.network.proxy.test.state.idle"
msgid "Test proxy"
msgstr "சோதனை பதிலாள்"

msgctxt "booru.network.proxy.test.state.testing"
msgid "Checking..."
msgstr "சரிபார்க்கிறது..."

msgctxt "booru.network.proxy.test.state.slow"
msgid "Slow response?"
msgstr "மெதுவான பதிலா?"

msgctxt "booru.network.proxy.test.success"
msgid "Valid proxy settings"
msgstr "சரியான பதிலாள் அமைப்புகள்"

msgctxt "booru.network.proxy.test.failure"
msgid "Failed to connect to proxy, please check your settings and try again"
msgstr ""
"ப்ராக்சியுடன் இணைக்க முடியவில்லை, உங்கள் அமைப்புகளைச் சரிபார்த்து மீண்டும் "
"முயற்சிக்கவும்"

msgctxt "booru.network.http.protocol"
msgid "HTTP Protocol"
msgstr "HTTP நெறிமுறை"

msgctxt "booru.network.http.protocol_description"
msgid ""
"Changing the HTTP protocol may help with compatibility or performance on "
"certain sites or platforms."
msgstr ""
"HTTP நெறிமுறையை மாற்றுவது, சில தளங்கள் அல்லது தளங்களில் இணக்கத்தன்மை அல்லது "
"செயல்திறனுடன் உதவலாம்."

msgctxt "booru.network.http.skip_cert_verification"
msgid "Skip certificate verification"
msgstr "சான்றிதழ் சரிபார்ப்பைத் தவிர்க்கவும்"

msgctxt "booru.network.http.skip_cert_verification_description"
msgid "Enable for self-signed certificates (e.g., local servers)"
msgstr "தன்வய கையொப்பமிட்ட சான்றிதழ்களை இயக்கு (எ.கா., உள்ளக சர்வர்கள்)"

msgctxt "booru.network.http.skip_cert_verification_warning_title"
msgid "Security Warning"
msgstr "பாதுகாப்பு முன்னறிவிப்பு"

msgctxt "booru.network.http.skip_cert_verification_warning"
msgid ""
"Certificate verification is disabled. Your connection may not be secure. "
"Only use this for trusted local servers."
msgstr ""
"சான்றிதழ் சரிபார்ப்பு முடக்கப்பட்டுள்ளது. உங்கள் இணைப்பு பாதுகாப்பாக "
"இல்லாமல் இருக்கலாம். நம்பகமான உள்ளக சேவையகங்களுக்கு மட்டுமே இதைப் "
"பயன்படுத்தவும்."

msgctxt "booru.viewer.auto_fetch_notes"
msgid "Auto-fetch notes"
msgstr "குறிப்புகளைத் தானாகப் பெறுதல்"

msgctxt "booru.viewer.auto_fetch_notes_description"
msgid "Automatically fetch and display notes whenever possible."
msgstr "முடிந்தவரை தானாகவே குறிப்புகளைப் பெற்றுக் காண்பிக்கவும்."

msgctxt "booru.viewer.overridden_notice"
msgid ""
"These settings are overridden by custom viewer. Go to <b><a href=\"booru-"
"profiles\">Profile's Viewer</a></b> page instead."
msgstr ""
"இந்த அமைப்புகள் தனிப்பயன் பார்வையாளரால் மேலெழுதப்படுகின்றன. அதற்குப் பதிலாக "
"<b><a href=\"booru-profiles\">சுயவிவரத்தின் பார்வையாளர்</a></b> "
"பக்கத்திற்குச் செல்லவும்."

msgctxt "booru.gestures.title"
msgid "Gestures"
msgstr "சைகைகள்"

msgctxt "booru.gestures.override_notice"
msgid ""
"Override the default gestures for this profile, select \"None\" to keep the "
"original behavior."
msgstr ""
"இந்த சுயவிவரத்திற்கான இயல்புநிலை சைகைகளை மேலெழுதவும், அசல் நடத்தையை "
"வைத்திருக்க \"எதுவுமில்லை\" என்பதைத் தேர்ந்தெடுக்கவும்."

msgctxt "booru.downloads.title"
msgid "Download"
msgstr "பதிவிறக்கம்"

msgctxt "booru.downloads.leave_empty_to_use_global"
msgid "Leave empty to use the download location in settings."
msgstr "அமைப்புகளில் பதிவிறக்க இருப்பிடத்தைப் பயன்படுத்த காலியாக விடவும்."

msgctxt "booru.downloads.custom_filename_format"
msgid "Custom filename format"
msgstr "தனிப்பயன் கோப்பு பெயர் வடிவம்"

msgctxt "booru.downloads.custom_filename_format_invidual"
msgid "Individual download"
msgstr "தனிப்பட்ட பதிவிறக்கம்"

msgctxt "booru.downloads.custom_filename_format_bulk"
msgid "Bulk download"
msgstr "மொத்தமாக பதிவிறக்கம்"

msgctxt "booru.downloads.bulk_slow_token_warning"
msgid ""
"Using slow tokens in bulk download will take a VERY long time to warm up "
"before starting the actual download, consider not using them if possible."
msgstr ""
"மொத்தப் பதிவிறக்கத்தில் மெதுவான டோக்கன்களைப் பயன்படுத்துவது உண்மையான "
"பதிவிறக்கத்தைத் தொடங்குவதற்கு முன் வெப்பமடைய நீண்ட நேரம் எடுக்கும், "
"முடிந்தால் அவற்றைப் பயன்படுத்த வேண்டாம்."

msgctxt "booru.downloads.filename.available_tokens"
msgid "Available tokens: "
msgstr "கிடைக்கும் டோக்கன்கள்:"

msgctxt "booru.downloads.filename.no_token_error"
msgid "Token $token is not available"
msgstr "$token கிள்ளாக்கு கிடைக்கவில்லை"

msgctxt "booru.downloads.filename.available_token_options"
msgid "Available options"
msgstr "கிடைக்கும் விருப்பங்கள்"

msgctxt "booru.downloads.filename.no_options_available"
msgid "No options available"
msgstr "விருப்பத்தேர்வுகள் இல்லை"

msgctxt "booru.downloads.filename.slow_token_warning"
msgid ""
"This token will slow down your downloads as it requires additional data "
"fetching for each file."
msgstr ""
"இந்த கிள்ளாக்கு உங்கள் பதிவிறக்கங்களை மெதுவாக்கும், ஏனெனில் ஒவ்வொரு "
"கோப்பிற்கும் கூடுதல் தரவு பெறுதல் தேவைப்படுகிறது."

msgctxt "booru.appearance.title"
msgid "Appearance"
msgstr "தோற்றம்"

msgctxt "booru.appearance.image_viewer_layout.title"
msgid "Image viewer layout"
msgstr "பட பார்வையாளர் தளவமைப்பு"

msgctxt "booru.appearance.image_viewer_layout.preview_widgets"
msgid "Preview widgets"
msgstr "முன்னோட்ட விட்செட்கள்"

msgctxt "booru.appearance.image_viewer_layout.full_info_widgets"
msgid "Full information widgets"
msgstr "முழு செய்தி விட்செட்டுகள்"

msgctxt "booru.appearance.image_viewer_layout.widget_title"
msgid "Widgets"
msgstr "நிரல்பலகை"

msgctxt "booru.appearance.image_viewer_layout.storage_tooltip"
msgid "All changes are saved to your current profile."
msgstr "அனைத்து மாற்றங்களும் உங்கள் தற்போதைய சுயவிவரத்தில் சேமிக்கப்படும்."

msgctxt "booru.appearance.image_viewer_layout.rearrange_tip"
msgid "Rearrange items or hide content"
msgstr "உருப்படிகளை மறுசீரமைக்கவும் அல்லது உள்ளடக்கத்தை மறைக்கவும்"

msgctxt "booru.appearance.image_viewer_layout.preview.title"
msgid "Layout Preview"
msgstr "தளவமைப்பு முன்னோட்டம்"

msgctxt "booru.appearance.image_viewer_layout.preview.description"
msgid ""
"Preview your custom layout for $previewMinutes minutes. After that, you can "
"either upgrade to $brand to keep using it or retry as many times as you "
"want."
msgstr ""
"$previewMinutes நிமிடங்களுக்கு உங்கள் தனிப்பயன் தளவமைப்பை "
"முன்னோட்டமிடுங்கள். அதன் பிறகு, $brandஐப் பயன்படுத்துவதைத் தொடர்ந்து "
"மேம்படுத்தலாம் அல்லது எத்தனை முறை வேண்டுமானாலும் மீண்டும் முயற்சிக்கலாம்."

msgctxt "booru.appearance.image_viewer_layout.preview.start_limited_preview"
msgid "Start $previewMinutes-minute Preview"
msgstr "$previewMinutes-minute முன்னோட்டத்தைத் தொடங்கவும்"

msgctxt ""
"booru.appearance.image_viewer_layout.preview.continue_preview_and_apply"
msgid "Continue Preview & Apply"
msgstr "முன்னோட்டத்தைத் தொடரவும் & விண்ணப்பிக்கவும்"

msgctxt "booru.appearance.image_viewer_layout.preview.currently_in_preview"
msgid "You are currently previewing a custom layout."
msgstr "நீங்கள் தற்போது தனிப்பயன் தளவமைப்பை முன்னோட்டமிடுகிறீர்கள்."

msgctxt "booru.appearance.image_viewer_layout.preview.time_left"
msgid "Time left:"
msgstr "மீதமுள்ள நேரம்:"

msgctxt "booru.appearance.image_viewer_layout.preview.preview_expired"
msgid ""
"Your layout preview has ended. Upgrade to continue using premium layouts or "
"start a new preview."
msgstr ""
"உங்கள் தளவமைப்பு முன்னோட்டம் முடிந்தது. காப்பீடு தளவமைப்புகளைத் தொடர்ந்து "
"பயன்படுத்த மேம்படுத்தவும் அல்லது புதிய மாதிரிக்காட்சியைத் தொடங்கவும்."

