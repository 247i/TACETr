msgctxt "booru.api_key_instructions.variants_1"
msgid ""
"*Log in to your account on the browser, visit <b><a href=\"api-"
"credentials\">My Account > Options > API Access Credentials</a></b> to get "
"your API key. If you see empty API key like "
"<b>&api_key=&user_id=<your_id></b>, tick <b>Generate New Key?</b> and click "
"the <b>Save</b> button at the very bottom to generate a new API key. "
"Otherwise, copy the key and paste it into the field above. You can also copy"
" the whole string from the <b>API Access Credentials</b> section and tap the"
" button below."
msgstr ""
"*உலாவியில் உங்கள் கணக்கில் உள்நுழைந்து, உங்கள் பநிஇ விசையைப் பெற <b><a "
"href=\"api-credentials\">எனது கணக்கு > விருப்பங்கள் > பநிஇ அணுகல் "
"சான்றுகள்</a></b> ஐப் பார்வையிடவும். <b>&api_key=&user_id=<your_id></b> "
"போன்ற வெற்று பநிஇ விசையை நீங்கள் கண்டால், <b>புதிய விசையை உருவாக்கவா?</b> "
"என்பதைத் தேர்வுசெய்து, புதிய பநிஇ விசையை உருவாக்க, கீழே உள்ள <b>சேமி</b> "
"பொத்தானைக் சொடுக்கு செய்யவும். இல்லையெனில், விசையை நகலெடுத்து மேலே உள்ள "
"புலத்தில் ஒட்டவும். <b>API அணுகல் நற்சான்றிதழ்கள்</b> பிரிவில் இருந்து முழு "
"சரத்தையும் நகலெடுத்து கீழே உள்ள பொத்தானைத் தட்டவும்."

msgctxt "booru.api_key_instructions.variants_2"
msgid ""
"*Log in to your account on the browser, visit <b>My Account > Options > API "
"Access Credentials</b>. Check if it is there. If not, the site does not "
"support credentials, and you can ignore this."
msgstr ""
"*உலாவியில் உங்கள் கணக்கில் உள்நுழைந்து, <b>எனது கணக்கு > விருப்பங்கள் > பநிஇ"
" அணுகல் சான்றுகள்</b> என்பதற்குச் செல்லவும். அது இருக்கிறதா என்று பாருங்கள்."
" இல்லையெனில், தளம் நற்சான்றிதழ்களை ஆதரிக்காது, இதை நீங்கள் புறக்கணிக்கலாம்."

msgctxt "booru.api_key_instructions.variants_3"
msgid ""
"*Log in to your account on the browser, visit <b><a href=\"api-"
"credentials\">My Account > API Key</a></b>. Copy your key or create a new "
"one if needed, ensuring all permissions are enabled for proper app "
"functionality."
msgstr ""
"*உலாவியில் உங்கள் கணக்கில் உள்நுழைந்து, <b><a href=\"api-credentials\">எனது "
"கணக்கு > பநிஇ விசை</a></b> ஐப் பார்வையிடவும். உங்கள் விசையை நகலெடுக்கவும் "
"அல்லது தேவைப்பட்டால் புதிய ஒன்றை உருவாக்கவும், சரியான பயன்பாட்டின் "
"செயல்பாட்டிற்கு அனைத்து அனுமதிகளும் இயக்கப்பட்டிருப்பதை உறுதிசெய்யவும்."

msgctxt "booru.api_key_instructions.variants_4"
msgid ""
"*Log in to your account on the browser, visit <b>Account > Login tokens</b>."
" Copy your <b>Web Login Token</b> or create a new one if needed and paste it"
" here. If you use the <b>Web Login Token</b>, logout from the browser will "
"make the token invalid."
msgstr ""
"*உலாவியில் உங்கள் கணக்கில் உள்நுழைந்து, <b>கணக்கு > உள்நுழைவு "
"டோக்கன்களைப்</b> பார்வையிடவும். உங்கள் <b>இணைய உள்நுழைவு டோக்கனை</b> "
"நகலெடுக்கவும் அல்லது தேவைப்பட்டால் புதிய ஒன்றை உருவாக்கி இங்கே ஒட்டவும். "
"நீங்கள் <b>இணைய உள்நுழைவு டோக்கனை</b> பயன்படுத்தினால், உலாவியில் இருந்து "
"வெளியேறுவது கிள்ளாக்கை செல்லாததாக்கும்."

msgctxt "booru.api_key_instructions.variants_5"
msgid ""
"*Log in to your account on the browser, visit <b><a href=\"api-"
"credentials\">My Account > Options > API Access Credentials</a></b> to get "
"your API key. Copy the key and paste it into the field above. You can also "
"copy the whole string from the <b>API Access Credentials</b> section and tap"
" the button below."
msgstr ""
"*உலாவியில் உங்கள் கணக்கில் உள்நுழைந்து, உங்கள் பநிஇ விசையைப் பெற <b><a "
"href=\"api-credentials\">எனது கணக்கு > விருப்பங்கள் > பநிஇ அணுகல் "
"சான்றுகள்</a></b> ஐப் பார்வையிடவும். விசையை நகலெடுத்து மேலே உள்ள புலத்தில் "
"ஒட்டவும். <b>API அணுகல் நற்சான்றிதழ்கள்</b> பிரிவில் இருந்து முழு சரத்தையும்"
" நகலெடுத்து கீழே உள்ள பொத்தானைத் தட்டவும்."

msgctxt "booru.api_key_instructions.shimmie2.danbooru_api_extension_notice"
msgid ""
"The app requires the <b>Danbooru Client API</b> extension to be installed on"
" the site to function."
msgstr ""
"பயன்பாட்டிற்குச் செயல்பட, தளத்தில் <b>Danbooru Client API</b> நீட்டிப்பு "
"நிறுவப்பட்டிருக்க வேண்டும்."

msgctxt "booru.api_key_instructions.shimmie2.user_api_key_notice"
msgid ""
"The app requires the <b>User API Key</b> extension to be installed on the "
"site on the site for login and private content access."
msgstr ""
"உள்நுழைவு மற்றும் தனிப்பட்ட உள்ளடக்க அணுகலுக்காக, தளத்தில் உள்ள தளத்தில் "
"<b>User பநிஇ Key</b> நீட்டிப்பு நிறுவப்பட்டிருக்க பயன்பாட்டிற்கு "
"தேவைப்படுகிறது."

msgctxt "booru.api_key_instructions.shimmie2.view_extension_docs"
msgid "View extension documentation"
msgstr "நீட்டிப்பு ஆவணங்களைக் காண்க"

msgctxt "booru.deletion.title"
msgid "Delete '${profileName}'"
msgstr "'${profileName}' ஐ நீக்கு"

msgctxt "booru.deletion.confirmation"
msgid ""
"Are you sure you want to delete this profile? This action cannot be undone."
msgstr ""
"இந்தச் சுயவிவரத்தை நிச்சயமாக நீக்க விரும்புகிறீர்களா? இந்தச் செயலைச் "
"செயல்தவிர்க்க முடியாது."

msgctxt "booru.invalid_booru_warning"
msgid ""
"It seems like the site is not running on the selected engine. Please try "
"with another one."
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட எஞ்சினில் தளம் இயங்கவில்லை போல் தெரிகிறது. தயவு செய்து "
"மற்றொன்றுடன் முயற்சிக்கவும்."

msgctxt "booru.invalid_selected_profile"
msgid "Current selected profile is invalid"
msgstr "தற்போது தேர்ந்தெடுக்கப்பட்ட சுயவிவரம் தவறானது"

msgctxt "booru.invalid_selected_profile_selection_request"
msgid "Select a profile from the list below to continue"
msgstr "தொடர, கீழே உள்ள பட்டியலில் இருந்து சுயவிவரத்தைத் தேர்ந்தெடுக்கவும்"

msgctxt "booru.unknown_engine_selection_request"
msgid "Select a booru engine to continue"
msgstr "தொடர ஒரு பூரு இயந்திரத்தைத் தேர்ந்தெடுக்கவும்"

msgctxt "booru.new_profile_leave_as_empty_tips"
msgid "Not sure? Leave it as it is, you can change it later."
msgstr "உறுதியாக தெரியவில்லையா? அப்படியே விடுங்கள், பிறகு மாற்றிக்கொள்ளலாம்."

msgctxt "booru.using_status"
msgid "using ${booru}"
msgstr "${booru} ஐப் பயன்படுத்துகிறது"

msgctxt "booru.paste_from_clipboard"
msgid "Paste from clipboard"
msgstr "கிளிப்போர்டிலிருந்து ஒட்டவும்"

msgctxt "booru.booru_engine_input_label"
msgid "Booru engine (*)"
msgstr "பூரூ எஞ்சின் (*)"

msgctxt "booru.config_name_label"
msgid "Profile name (*)"
msgstr "சுயவிவர பெயர் (*)"

msgctxt "booru.no_profiles_available"
msgid "No profiles available"
msgstr "சுயவிவரங்கள் எதுவும் இல்லை"

msgctxt "booru.add_profile_to_continue"
msgid "Add a profile to continue"
msgstr "தொடர சுயவிவரத்தைச் சேர்க்கவும்"

msgctxt "booru.add_profile"
msgid "Add Profile"
msgstr "சுயவிவரத்தைச் சேர்க்கவும்"

msgctxt "booru.unsaved_changes"
msgid "You have unsaved changes"
msgstr "உங்களிடம் சேமிக்கப்படாத மாற்றங்கள் உள்ளன"

msgctxt "booru.unsaved_changes_discard"
msgid "Don't save"
msgstr "சேமிக்க வேண்டாம்"

msgctxt "booru.unsaved_changes_reconfirm_question"
msgid ""
"Do you want to save your changes? Your changes will be lost if you don't "
"save them."
msgstr ""
"உங்கள் மாற்றங்களைச் சேமிக்க விரும்புகிறீர்களா? உங்கள் மாற்றங்களைச் "
"சேமிக்கவில்லை என்றால், அவை இழக்கப்படும்."

msgctxt "booru.site_url_label"
msgid "Site URL"
msgstr "தள முகவரி"

msgctxt "booru.login_name_label"
msgid "Login"
msgstr "புகுபதிவு"

msgctxt "booru.password_api_key_label"
