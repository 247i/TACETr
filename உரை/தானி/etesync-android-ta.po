#, java-printf-format
msgctxt "notification_channel_sync_errors_desc"
msgid ""
"Important errors which stop synchronization like unexpected server replies"
msgstr ""
"எதிர்பாராத சர்வர் பதில்கள் போன்ற ஒத்திசைவை நிறுத்தும் முக்கியமான பிழைகள்"

#, java-printf-format
msgctxt "notification_channel_sync_warnings"
msgid "Synchronization warnings"
msgstr "ஒத்திசைவு எச்சரிக்கைகள்"

#, java-printf-format
msgctxt "notification_channel_sync_warnings_desc"
msgid ""
"Non-fatal synchronization problems like dismissed changes of read-only "
"collections"
msgstr ""
"படிக்க மட்டுமேயான தொகுப்புகளின் நிராகரிக்கப்பட்ட மாற்றங்கள் போன்ற அபாயகரமான "
"ஒத்திசைவுச் சிக்கல்கள்"

#, java-printf-format
msgctxt "notification_channel_sync_status"
msgid "Status messages"
msgstr "நிலை செய்திகள்"

#, java-printf-format
msgctxt "notification_channel_sync_status_desc"
msgid "Informational status messages like the sync change summary"
msgstr "ஒத்திசைவு மாற்றம் சுருக்கம் போன்ற செய்தி நிலை செய்திகள்"

#.  Crash
#, java-printf-format
msgctxt "crash_title"
msgid "EteSync has crashed!"
msgstr "EteSync செயலிழந்தது!"

#, java-printf-format
msgctxt "crash_message"
msgid "Please send stack trace to developers."
msgstr "டெவலப்பர்களுக்கு அடுக்கு ட்ரேசை அனுப்பவும்."

#, java-printf-format
msgctxt "crash_email_body"
msgid ""
"If possible, please include any other relevant information such as what you "
"did to trigger this error."
msgstr ""
"முடிந்தால், இந்தப் பிழையைத் தூண்டுவதற்கு நீங்கள் என்ன செய்தீர்கள் என்பது "
"போன்ற பிற தொடர்புடைய தகவலைச் சேர்க்கவும்."

#.  tourguide
#, java-printf-format
msgctxt "tourguide_title"
msgid "Did you know?"
msgstr "உங்களுக்கு தெரியுமா?"

#.  startup dialogs
#, java-printf-format
msgctxt "startup_battery_optimization"
msgid "Battery Optimization"
msgstr "பேட்டரி உகப்பாக்கம்"

#, java-printf-format
msgctxt "startup_battery_optimization_message"
msgid ""
"Android may disable/reduce EteSync synchronization after a few days. To "
"prevent this, turn off battery optimization."
msgstr ""
"சில நாட்களுக்குப் பிறகு EteSync ஒத்திசைவை ஆண்ட்ராய்டு "
"முடக்கலாம்/குறைக்கலாம். இதைத் தடுக்க, பேட்டரி தேர்வுமுறையை முடக்கவும்."

#, java-printf-format
msgctxt "startup_battery_optimization_disable"
msgid "Turn off for EteSync"
msgstr "EteSync க்கு அணைக்கவும்"

#, java-printf-format
msgctxt "startup_dont_show_again"
msgid "Don't show again"
msgstr "மீண்டும் காட்டாதே"

#, java-printf-format
msgctxt "startup_development_version"
msgid "EteSync Preview Release"
msgstr "EteSync முன்னோட்ட வெளியீடு"

#, java-printf-format
msgctxt "startup_development_version_message"
msgid ""
"This is a development version of EteSync. Be aware that things may not work "
"as expected. Please give us constructive feedback to improve EteSync."
msgstr ""
"இது EteSync இன் வளர்ச்சிப் பதிப்பாகும். எதிர்பார்த்தபடி காரியங்கள் நடக்காமல்"
" போகலாம் என்பதை கவனத்தில் கொள்ளவும். EteSync ஐ மேம்படுத்த, எங்களுக்கு "
"ஆக்கபூர்வமான கருத்தை வழங்கவும்."

#, java-printf-format
msgctxt "startup_development_version_give_feedback"
msgid "Give feedback"
msgstr "கருத்து தெரிவிக்கவும்"

#, java-printf-format
msgctxt "startup_vendor_specific_bugs"
msgid "Potential Vendor Bugs"
msgstr "சாத்தியமான விற்பனையாளர் பிழைகள்"

#, java-printf-format
msgctxt "startup_vendor_specific_bugs_message"
msgid ""
"EteSync has detected you are using an Android version that may contain vendor specific bugs.\n"
"Please take a look at the FAQ for more information."
msgstr ""
"விற்பனையாளர் குறிப்பிட்ட பிழைகளைக் கொண்ட ஆண்ட்ராய்டு பதிப்பைப் பயன்படுத்துகிறீர்கள் என்பதை EteSync கண்டறிந்துள்ளது. \n"
"மேலும் தகவலுக்கு அடிக்கடி கேட்கப்படும் கேள்விகளைப் பார்க்கவும்."

#, java-printf-format
msgctxt "startup_vendor_specific_bugs_open_faq"
msgid "Open FAQ"
msgstr "அடிக்கடி கேட்கப்படும் கேள்விகளைத் திறக்கவும்"

#.  AboutActivity
#, java-printf-format
msgctxt "about_license_terms"
msgid "License terms"
msgstr "உரிம விதிமுறைகள்"

#, java-printf-format
msgctxt "about_license_info_no_warranty"
msgid ""
"This program comes with ABSOLUTELY NO WARRANTY. It is free software, and you"
" are welcome to redistribute it under certain conditions."
msgstr ""
"இந்த திட்டம் முற்றிலும் எந்த உத்தரவாதமும் இல்லை. இது ஒரு இலவச "
"மென்பொருளாகும், மேலும் சில நிபந்தனைகளின் கீழ் நீங்கள் அதை மறுவிநியோகம் "
"செய்யலாம்."

