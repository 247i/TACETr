msgstr "ஊடலை இணைப்புகளை நிறுவ பயன்பாட்டை அனுமதிக்கவும்"

#, java-printf-format
msgctxt "permission_notifications"
msgid "Allow the app to post notifications"
msgstr "அறிவிப்புகளை இடுகையிட பயன்பாட்டை அனுமதிக்கவும்"

#, java-printf-format
msgctxt "step1_title"
msgid "Step 1: Location & Bluetooth Access"
msgstr "படி 1: இருப்பிடம் & ஊடலை அணுகல்"

#, java-printf-format
msgctxt "step1_desc"
msgid ""
"Required for connecting to your Sony camera and accessing location data."
msgstr ""
"உங்கள் Sony கேமராவுடன் இணைப்பதற்கும் இருப்பிடத் தரவை அணுகுவதற்கும் தேவை."

#, java-printf-format
msgctxt "step1_missing"
msgid "Missing permissions:"
msgstr "விடுபட்ட அனுமதிகள்:"

#, java-printf-format
msgctxt "step1_grant"
msgid "Grant Location & Bluetooth Access"
msgstr "இடம் & ஊடலை அணுகலை வழங்கவும்"

#, java-printf-format
msgctxt "step1_granted"
msgid "✓ Granted"
msgstr "✓ வழங்கப்பட்டது"

#, java-printf-format
msgctxt "step2_title"
msgid "Step 2: Background Location Access"
msgstr "படி 2: பின்னணி இருப்பிட அணுகல்"

#, java-printf-format
msgctxt "step2_desc"
msgid ""
"Allows continuous GPS sync to your camera even when the app is in the "
"background or screen is off."
msgstr ""
"ஆப்ச் பின்னணியில் இருந்தாலும் அல்லது திரை முடக்கத்தில் இருந்தாலும் உங்கள் "
"கேமராவுடன் தொடர்ச்சியான உலக இடம் காட்டும் அமைப்பு (இடம் காட்டி) ஒத்திசைவை "
"அனுமதிக்கிறது."

#, java-printf-format
msgctxt "step2_android10_warning"
msgid "You\\'ll need to select Allow all the time in the next dialog"
msgstr ""
"அடுத்த உரையாடலில் எல்லா நேரத்தையும் இசைவு என்பதைத் தேர்ந்தெடுக்க வேண்டும்"

#, java-printf-format
msgctxt "step2_grant"
msgid "Grant Background Location"
msgstr "கிராண்ட் பின்னணி இடம்"

#, java-printf-format
msgctxt "step2_granted"
msgid "✓ Granted"
msgstr "✓ வழங்கப்பட்டது"

#, java-printf-format
msgctxt "view_logs"
msgid "View logs"
msgstr "பதிவுகளைப் பார்க்கவும்"

#, java-printf-format
msgctxt "logs_title"
msgid "Logs"
msgstr "பதிவுகள்"

#, java-printf-format
msgctxt "logs_clear_all"
msgid "Clear all logs"
msgstr "அனைத்து பதிவுகளையும் அழிக்கவும்"

#, java-printf-format
msgctxt "logs_empty"
msgid "No logs available yet. Logs will appear here as the app runs."
msgstr ""
"இதுவரை பதிவுகள் எதுவும் கிடைக்கவில்லை. பயன்பாடு இயங்கும்போது பதிவுகள் இங்கே "
"தோன்றும்."

#, java-printf-format
msgctxt "camera_gps_permissions"
msgid "Alpha GPS Permissions"
msgstr "ஆல்பா சிபிஎச் அனுமதிகள்"

#.  Permission request strings
#, java-printf-format
msgctxt "grant_permissions"
msgid "Grant permissions"
msgstr "அனுமதிகளை வழங்கவும்"

#, java-printf-format
msgctxt "permissions_missing_title"
msgid "Permissions missing"
msgstr "அனுமதிகள் இல்லை"

#, java-printf-format
msgctxt "permissions_missing_description"
msgid ""
"Some features may not work until these permissions are granted:\n"
"%1$s"
msgstr ""
"இந்த அனுமதிகள் வழங்கப்படும் வரை சில நற்பொருத்தங்கள் வேலை செய்யாமல் போகலாம்: \n"
"%1$s"

