#, java-printf-format
msgctxt "log_settings"
msgid "Log Settings"
msgstr "பதிவு அமைப்புகள்"

#, java-printf-format
msgctxt "log_level"
msgid "Log Level"
msgstr "பதிவு நிலை"

#, java-printf-format
msgctxt "log_level_description"
msgid "Minimum log level to record"
msgstr "பதிவு செய்வதற்கான குறைந்தபட்ச பதிவு நிலை"

#, java-printf-format
msgctxt "location_provider_title"
msgid "Location Provider"
