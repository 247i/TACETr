msgstr "அடுத்த வெளியீட்டில் வரவேற்பு திரை காண்பிக்கப்படும்!"

#, java-printf-format
msgctxt "is_there_documenation"
msgid "Is there any documentation?"
msgstr "ஏதேனும் ஆவணங்கள் உள்ளதா?"

#, java-printf-format
msgctxt "is_there_documenation_answer"
msgid ""
