msgstr "%1$d கேமராக்களுக்கு இருப்பிடத் தரவை அனுப்புகிறது"

#, java-printf-format
msgctxt "scan_for_devices"
msgid "Click to find & associate your camera"
msgstr "உங்கள் கேமராவைக் கண்டுபிடித்து இணைக்க சொடுக்கு செய்யவும்"

#, java-printf-format
msgctxt "permission_gps"
