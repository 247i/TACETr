msgctxt "dismiss_button"
msgid "Dismiss"
msgstr "நிராகரி"

#, java-printf-format
msgctxt "cancel_button"
msgid "Cancel"
msgstr "ரத்துசெய்"

#, java-printf-format
msgctxt "app_settings"
msgid "App settings"
msgstr "பயன்பாட்டு அமைப்புகள்"

#.  Permission rationale strings
#, java-printf-format
msgctxt "location_bluetooth_access_title"
msgid "Location & Bluetooth Access Required"
msgstr "இருப்பிடம் & ஊடலை அணுகல் தேவை"

#, java-printf-format
msgctxt "location_bluetooth_access_message"
msgid "This app needs location and Bluetooth permissions to:"
msgstr "இந்த பயன்பாட்டிற்கு இருப்பிடம் மற்றும் ஊடலை அனுமதிகள் தேவை:"

#, java-printf-format
msgctxt "location_bluetooth_benefit_1"
msgid "• Connect to your Sony camera via Bluetooth"
msgstr "• ஊடலை வழியாக உங்கள் சோனி கேமராவுடன் இணைக்கவும்"

#, java-printf-format
msgctxt "location_bluetooth_benefit_2"
msgid "• Access GPS coordinates to sync with your camera"
msgstr ""
"• உங்கள் கேமராவுடன் ஒத்திசைக்க உலக இடம் காட்டும் அமைப்பு (இடம் காட்டி) "
"ஒருங்கிணைப்புகளை அணுகவும்"

#, java-printf-format
msgctxt "location_bluetooth_benefit_3"
msgid "• Provide accurate location data for your photos"
msgstr "• உங்கள் படங்களுக்கான துல்லியமான இருப்பிடத் தரவை வழங்கவும்"

#, java-printf-format
msgctxt "grant_permissions_button"
msgid "Grant Permissions"
msgstr "அனுமதிகளை வழங்கவும்"

#, java-printf-format
msgctxt "background_location_access_title"
msgid "Background Location Access"
msgstr "பின்னணி இருப்பிட அணுகல்"

#, java-printf-format
msgctxt "background_location_access_message"
msgid "Background location access enables:"
msgstr "பின்னணி இருப்பிட அணுகல் செயல்படுத்துகிறது:"

#, java-printf-format
msgctxt "background_location_benefit_1"
msgid "• Continuous GPS sync when the app is minimized"
msgstr ""
"• பயன்பாடு குறைக்கப்படும் போது தொடர்ச்சியான உலக இடம் காட்டும் அமைப்பு (இடம் "
"காட்டி) ஒத்திசைவு"

#, java-printf-format
msgctxt "background_location_benefit_2"
msgid "• Location tracking even when the screen is off"
msgstr "• திரை முடக்கத்தில் இருந்தாலும் இருப்பிடத்தைக் கண்காணித்தல்"

#, java-printf-format
msgctxt "background_location_benefit_3"
msgid "• Seamless photo geotagging during long shooting sessions"
msgstr "• நீண்ட படப்பிடிப்பு அமர்வுகளின் போது தடையற்ற புகைப்பட சியோடேக்கிங்"

#, java-printf-format
msgctxt "background_location_instruction"
msgid "Please select Allow all the time in the next dialog."
msgstr "அடுத்த உரையாடலில் எல்லா நேரத்தையும் இசைவு என்பதைத் தேர்ந்தெடுக்கவும்."

#.  Error messages
#, java-printf-format
msgctxt "permissions_required_app_error"
msgid "%1$s is required for the app to function"
msgstr "பயன்பாடு செயல்பட %1$s தேவை"

#, java-printf-format
msgctxt "background_location_required_error"
msgid ""
"Background location access required for continuous GPS sync when app is not "
"in foreground"
msgstr ""
"பயன்பாடு முன்புறத்தில் இல்லாதபோது தொடர்ச்சியான சிபிஎச் ஒத்திசைவுக்கு பின்னணி"
" இருப்பிட அணுகல் தேவை"

#, java-printf-format
msgctxt "remove"
msgid "Remove"
msgstr "அகற்று"

#.  System state warnings
#, java-printf-format
msgctxt "bluetooth_disabled_title"
msgid "Bluetooth is disabled"
msgstr "ஊடலை முடக்கப்பட்டுள்ளது"

#, java-printf-format
msgctxt "bluetooth_disabled_message"
msgid "Please enable Bluetooth to scan for devices."
msgstr "சாதனங்களை வருடு செய்ய புளூடூத்தை இயக்கவும்."

#, java-printf-format
msgctxt "open_bluetooth_settings"
msgid "Open Bluetooth Settings"
msgstr "ஊடலை அமைப்புகளைத் திறக்கவும்"

#, java-printf-format
msgctxt "location_services_disabled_title"
msgid "Location services are disabled"
msgstr "இருப்பிடச் சேவைகள் முடக்கப்பட்டுள்ளன"

#, java-printf-format
msgctxt "location_services_disabled_message"
msgid "Please enable location services for GPS functionality."
msgstr ""
"உலக இடம் காட்டும் அமைப்பு (இடம் காட்டி) செயல்பாட்டிற்கு இருப்பிடச் சேவைகளை "
"இயக்கவும்."

#, java-printf-format
msgctxt "open_location_settings"
msgid "Open Location Settings"
msgstr "இருப்பிட அமைப்புகளைத் திறக்கவும்"

#, java-printf-format
msgctxt "app_disabled_title"
msgid "App is disabled"
msgstr "பயன்பாடு முடக்கப்பட்டுள்ளது"

#, java-printf-format
msgctxt "app_disabled_message"
msgid "Enable the app in Settings to scan for nearby cameras."
msgstr "அருகிலுள்ள கேமராக்களை வருடு செய்ய, அமைப்புகளில் பயன்பாட்டை இயக்கவும்."

#, java-printf-format
msgctxt "scanning_paused_title"
msgid "Scanning is paused"
msgstr "ச்கேனிங் இடைநிறுத்தப்பட்டது"

#, java-printf-format
msgctxt "scanning_paused_message"
msgid "Turn on automatic scanning in Settings to look for nearby cameras."
msgstr ""
"அருகிலுள்ள கேமராக்களைத் தேட, அமைப்புகளில் தானியங்கி ச்கேனிங்கை இயக்கவும்."

#, java-printf-format
msgctxt "scanning_for_cameras"
msgid "Scanning for cameras..."
msgstr "கேமராக்களை வருடு செய்கிறது..."

#.  Welcome screen strings
#, java-printf-format
msgctxt "welcome_title"
msgid "Welcome to Alpha GPS Geotagging"
msgstr "ஆல்பா சிபிஎச் சியோடேகிங்கிற்கு வரவேற்கிறோம்"

#, java-printf-format
msgctxt "welcome_subtitle"
msgid "Real-time GPS coordinates for your camera via Bluetooth"
msgstr "ஊடலை வழியாக உங்கள் கேமராவிற்கான நிகழ்நேர சிபிஎச் ஒருங்கிணைப்புகள்"

#, java-printf-format
msgctxt "welcome_feature_connect_title"
msgid "Connect Your Camera"
msgstr "உங்கள் கேமராவை இணைக்கவும்"

#, java-printf-format
msgctxt "welcome_feature_connect_description"
msgid ""
"Pair your Sony camera with your phone via Bluetooth for seamless GPS data "
"transfer"
msgstr ""
"தடையற்ற சி.பி.எச் தரவு பரிமாற்றத்திற்கு ஊடலை வழியாக உங்கள் சோனி கேமராவை "
"உங்கள் ஃபோனுடன் இணைக்கவும்"

#, java-printf-format
msgctxt "welcome_feature_gps_sync_title"
msgid "Real-time GPS Sync"
msgstr "நிகழ்நேர சிபிஎச் ஒத்திசைவு"

#, java-printf-format
msgctxt "welcome_feature_gps_sync_description"
msgid ""
"Automatically sync your phone's GPS coordinates to your camera for accurate "
"geotagging"
msgstr ""
"துல்லியமான சியோடேக்கிங்கிற்காக உங்கள் ஃபோனின் சிபிஎச் ஒருங்கிணைப்புகளை "
"உங்கள் கேமராவுடன் தானாக ஒத்திசைக்கவும்"

#, java-printf-format
msgctxt "welcome_feature_device_management_title"
msgid "Device Management"
msgstr "சாதன மேலாண்மை"

#, java-printf-format
msgctxt "welcome_get_started_button"
msgid "Get Started"
msgstr "தொடங்குங்கள்"

#, java-printf-format
msgctxt "welcome_settings_note"
msgid "You can access these settings later from the main menu"
msgstr "முதன்மையான மெனுவிலிருந்து இந்த அமைப்புகளை நீங்கள் பின்னர் அணுகலாம்"

#, java-printf-format
msgctxt "welcome_app_icon_description"
msgid "Alpha GPS App Icon"
msgstr "ஆல்பா சிபிஎச் ஆப் படவுரு"

#.  Settings screen strings
#, java-printf-format
msgctxt "settings"
msgid "Settings"
msgstr "அமைப்புகள்"

#, java-printf-format
msgctxt "app_controls"
msgid "App Controls"
msgstr "பயன்பாட்டுக் கட்டுப்பாடுகள்"

#, java-printf-format
msgctxt "enable_app"
msgid "Enable App"
msgstr "பயன்பாட்டை இயக்கு"

#, java-printf-format
msgctxt "enable_auto_start"
msgid "Start App on Device boot"
msgstr "சாதன துவக்கத்தில் பயன்பாட்டைத் தொடங்கவும்"

#, java-printf-format
msgctxt "enable_app_description"
msgid "Allow the app to run and sync GPS data with connected cameras"
msgstr ""
"இணைக்கப்பட்ட கேமராக்களுடன் உலக இடம் காட்டும் அமைப்பு (இடம் காட்டி) தரவை "
"இயக்க மற்றும் ஒத்திசைக்க பயன்பாட்டை அனுமதிக்கவும்"

#, java-printf-format
msgctxt "auto_scan"
msgid "Scan on screen open"
msgstr "திறந்த திரையில் வருடு செய்யவும்"

#, java-printf-format
msgctxt "auto_scan_description"
msgid ""
"Automatically look for nearby cameras when the devices screen is visible"
msgstr ""
"சாதனங்களின் திரை தெரியும் போது தானாகவே அருகிலுள்ள கேமராக்களைத் தேடுங்கள்"

#, java-printf-format
msgctxt "show_welcome_again_description"
msgid "Reopen the onboarding flow the next time the app starts"
msgstr ""
