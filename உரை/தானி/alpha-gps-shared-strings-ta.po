#, java-printf-format
msgctxt "permission_background_gps"
msgid "Allow location access when the app is in the background"
msgstr "ஆப்ச் பின்னணியில் இருக்கும்போது இருப்பிட அணுகலை அனுமதிக்கவும்"

#, java-printf-format
msgctxt "permission_bluetooth"
