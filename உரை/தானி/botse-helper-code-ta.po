msgstr "\"{tagName}\" உடன் {nDocsTagged}"

msgctxt "theme.docs.versionBadge.label"
msgid "Version: {versionLabel}"
msgstr "பதிப்பு: {versionLabel}"

#. The label used to tell the user that he's browsing an unreleased doc
#. version
msgctxt "theme.docs.versions.unreleasedVersionLabel"
msgid ""
"This is unreleased documentation for {siteTitle} {versionLabel} version."
msgstr "இது {siteTitle} {versionLabel} பதிப்பிற்கான வெளியிடப்படாத ஆவணமாகும்."

#. The label used to tell the user that he's browsing an unmaintained doc
#. version
msgctxt "theme.docs.versions.unmaintainedVersionLabel"
msgid ""
"This is documentation for {siteTitle} {versionLabel}, which is no longer "
"actively maintained."
msgstr ""
"இது {siteTitle} {versionLabel} க்கான ஆவணமாகும், இது இனி செயலில் "
"பராமரிக்கப்படாது."

#. The label used to tell the user to check the latest version
msgctxt "theme.docs.versions.latestVersionSuggestionLabel"
msgid ""
"For up-to-date documentation, see the {latestVersionLink} ({versionLabel})."
msgstr ""
"புதுப்பித்த ஆவணங்களுக்கு, {latestVersionLink} ({versionLabel}) ஐப் "
"பார்க்கவும்."

#. The label used for the latest version suggestion link label
msgctxt "theme.docs.versions.latestVersionLinkLabel"
msgid "latest version"
msgstr "அண்மைக் கால பதிப்பு"

