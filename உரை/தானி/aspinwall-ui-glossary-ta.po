#. Generic dialog box item; used for buttons that select an item in a dialog
#. box.
#, priority:50, terminology
msgid "Select"
msgstr "தேர்ந்தெடு"

#. Generic dialog box item; used for buttons that cancel the current action.
#, priority:50, terminology
msgid "Cancel"
msgstr "ரத்துசெய்"

#. Used for the box that contains the clock in the launcher.
#, terminology
msgid "Clock"
msgstr "கடிகை"

#. For a point of comparison, see Android's widgets.
#, terminology
msgid "Widget"
msgstr "விட்செட்"

#. Desktop wallpaper.
#, terminology
msgid "Wallpaper"
msgstr "வால்பேப்பர்"

#. When the launcher is not in use, it enters the idle mode after a few
#. seconds (60 seconds by default). In this mode, the menu buttons disappear,
#. and the widgets become slightly more transparent.
#, terminology
msgid "Idle mode"
msgstr "செயலற்ற பயன்முறை"

#. For a point of comparison, see Android launchers. In most cases, just
#. translating this as "Launcher" is fine. If the word does not fit in the
#. language, it can be replaced by an approximation, like "home screen".
#, terminology
msgid "Launcher"
msgstr "துவக்கி"
