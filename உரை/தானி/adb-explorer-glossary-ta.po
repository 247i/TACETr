#, read-only, terminology
msgctxt "mDNS is a protocol used by ADB to discover Android devices"
msgid "mDNS"
msgstr "mDNS"

#, read-only, terminology
msgctxt "Filesystem in User SpacE - a virtual Android file system (/sdcard)"
msgid "FUSE"
msgstr "உருகி"

#, forbidden, read-only, terminology
msgctxt "Windows Subsystem for Windows. Should not be translated"
msgid "WSA"
msgstr "WSA"

#, terminology
msgctxt "Progress is always used in the context of file operations"
msgid "Progress"
msgstr "முன்னேற்றம்"

#, terminology
msgctxt "Destination always refers to a file operations' destination"
msgid "Destination"
msgstr "இலக்கு"

#, terminology
msgctxt ""
"In most cases, 'item' is a collective term used to refer to files, folders, "
"and sometimes app packages / APKs"
msgid "Item"
msgstr "பொருள்"

#, terminology
msgctxt "Pull is the operation of copying a file from Android to PC"
msgid "Pull"
msgstr "இழு"

#, terminology
msgctxt ""
"Unless otherwise specified, and especially when written as \"root access\", "
"the term refers to an elevated access connection to an Android device"
msgid "Root Access"
msgstr "ரூட் அணுகல்"

#, terminology
msgctxt ""
"APK installer is a file that can be used to install an app on the Android "
"device"
msgid "APK file / installer"
msgstr "APK கோப்பு / நிறுவி"

#. Android Debug Bridge
#, forbidden, read-only, terminology
msgctxt "When abbreviated, ADB should not be translated"
msgid "ADB"
msgstr "ஏடிபி"

#, terminology
msgctxt "Usually the content of a button used to change a path"
msgid "Change"
msgstr "மாற்றம்"

#, terminology
msgctxt "Package refers to an app installed on the Android device"
msgid "Package"
msgstr "தொகுப்பு"

#, terminology
msgctxt "Device always refers to an Android device"
msgid "Device"
msgstr "சாதனம்"

#, terminology
msgctxt "Create usually refers to creating a new file or folder"
msgid "Create"
msgstr "உருவாக்கு"

#, terminology
msgctxt ""
"Restore is the operation of moving files from the recycle bin back to their "
"original location"
msgid "Restore"
msgstr "மீட்டமை"

#, terminology
msgctxt "Push is the operation of copying a file from PC to Android"
msgid "Push"
msgstr "தள்ளு"

#, forbidden, read-only, terminology
msgctxt "The name of the application should not be translated"
msgid "ADB Explorer"
msgstr "ADB எக்ச்ப்ளோரர்"

#, terminology
msgctxt "Usually refers to an Android emulator (other than WSA)"
msgid "Kill"
msgstr "கொல்லுங்கள்"

#, terminology
msgctxt "The built-in text editor in ADB Explorer"
msgid "Editor"
msgstr "திருத்தி"

#, terminology
msgctxt ""
"This refers to the topmost location of a drive - the drive itself (C:\\ on "
"PC, / on Android)"
msgid "Drive Root"
msgstr "இயக்கி ரூட்"

#, read-only, terminology
msgctxt "Refers to the design style introduced by Microsoft in Windows 11"
msgid "Fluent"
msgstr "சரளமாக"

#, terminology
msgid "español"
msgstr "español"
