#. Translators: App description
#: data/io.frama.editide.editide.desktop.in:3 src/editide/exts/ext_help.py:61
msgid "Source code editor"
msgstr "மூல குறியீடு திருத்தி"

#. Translators: App keywords
#: data/io.frama.editide.editide.desktop.in:12
msgid "code;development;editor;programming;"
