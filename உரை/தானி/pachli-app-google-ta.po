#, java-printf-format
msgctxt "action_delete_remote_model_fmt"
msgid "Delete %1$s"
msgstr "%1$sஐ நீக்கு"

#, java-printf-format
msgctxt "action_download_remote_model_fmt"
msgid "Download %1$s"
msgstr "%1$sஐப் பதிவிறக்கவும்"

#, java-printf-format
msgctxt "content_description_loading_fmt"
msgid "%1$s, downloading"
msgstr "%1$s, பதிவிறக்குகிறது"

#, java-printf-format
msgctxt "content_description_loaded_fmt"
msgid "%1$s, downloaded"
msgstr "%1$s, பதிவிறக்கப்பட்டது"

#, java-printf-format
msgctxt "content_description_available_fmt"
msgid "%1$s, available to download"
msgstr "%1$s, பதிவிறக்கம் செய்யக் கிடைக்கிறது"

#, java-printf-format
msgctxt "update_dialog_message"
msgid "Open Google Play to see the details?"
msgstr "விவரங்களைக் காண கூகிள் விளையாட்டைத் திறக்கவா?"

#, java-printf-format
msgctxt "update_dialog_positive"
msgid "Open Google Play"
msgstr "கூகிள் விளையாட்டைத் திற"

#, java-printf-format
msgctxt "pref_translation_require_wifi"
msgid "Require Wi-Fi to download language packs"
msgstr "மொழிப் பொதிகளைப் பதிவிறக்க வைஃபை தேவை"

#, java-printf-format
msgctxt "pref_translation_manage_languages"
msgid "Manage language packs"
msgstr "மொழி தொகுப்புகளை நிர்வகிக்கவும்"

#, java-printf-format
msgctxt "translation_model_manager_fragment_title"
msgid "Language packs"
msgstr "மொழி தொகுப்புகள்"

#, java-printf-format
msgctxt "translation_model_manager_fragment_info"
msgid ""
"Languages Pachli can translate between using Google Translate. Downloading "
"language packs ahead of time will make translation faster."
msgstr ""
"கூகுள் டிரான்ச்லேட்டைப் பயன்படுத்தி பச்லி மொழிகள் மொழிபெயர்க்கலாம். மொழிப் "
"பொதிகளை நேரத்திற்கு முன்பே பதிவிறக்கம் செய்வதன் மூலம் மொழிபெயர்ப்பை "
"வேகமாக்கும்."

#, java-printf-format
msgctxt "translation_model_manager_fragment_downloaded_heading"
msgid "Downloaded"
msgstr "பதிவிறக்கம் செய்யப்பட்டது"

#, java-printf-format
msgctxt "translation_model_manager_fragment_remote_heading"
msgid "Tap to download"
msgstr "பதிவிறக்க, தட்டவும்"

#, java-printf-format
msgctxt "fragment_confirm_download_language_dialog_title_fmt"
msgid "Download %1$s with mobile data?"
msgstr "மொபைல் டேட்டா மூலம் %1$s ஐப் பதிவிறக்கவா?"

#, java-printf-format
msgctxt "fragment_confirm_download_language_dialog_msg"
msgid "This will typically use 30–60MB of mobile data."
msgstr "இது பொதுவாக 30-60MB மொபைல் டேட்டாவைப் பயன்படுத்தும்."

#, java-printf-format
msgctxt "fragment_confirm_delete_language_dialog_title_fmt"
msgid "Delete %1$s?"
msgstr "%1$sஐ நீக்கவா?"

#, java-printf-format
msgctxt "fragment_confirm_delete_language_dialog_msg"
msgid ""
"If you delete this language it will be downloaded the next time it is "
"needed."
msgstr ""
"நீங்கள் இந்த மொழியை நீக்கினால், அடுத்த முறை தேவைப்படும்போது பதிவிறக்கம் "
"செய்யப்படும்."

#, java-printf-format
msgctxt "fragment_google_disclaimer_dialog_title"
msgid "Translation disclaimer"
msgstr "மொழிபெயர்ப்பு மறுப்பு"

#, java-printf-format
msgctxt "action_translate_mlkit"
msgid "Translate with Google"
msgstr "Google மூலம் மொழிபெயர்க்கவும்"

#, java-printf-format
msgctxt "label_translated_mlkit"
msgid "Translated by Google"
msgstr "கூகுளால் மொழிபெயர்க்கப்பட்டது"
