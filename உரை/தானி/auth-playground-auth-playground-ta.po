#: src/auth_playground/endpoints.py:46
msgid "Cannot connect to the server. Please check the URL."
msgstr "சேவையகத்துடன் இணைக்க முடியவில்லை. முகவரி ஐ சரிபார்க்கவும்."

#: src/auth_playground/endpoints.py:49
msgid "Connection timeout. The server is not responding."
msgstr "இணைப்பு நேரம் முடிந்தது. சேவையகம் பதிலளிக்கவில்லை."

#: src/auth_playground/endpoints.py:55
msgid ""
"This server does not support OIDC Discovery or OAuth 2.0 Authorization "
"Server Metadata"
msgstr ""
"இந்த சேவையகம் OIDC கண்டுபிடிப்பு அல்லது OAuth 2.0 அங்கீகார சேவையக "
"மெட்டாடேட்டாவை ஆதரிக்காது"

#: src/auth_playground/endpoints.py:61
#, python-brace-format
msgid "Server returned an error: HTTP {status_code}"
msgstr "சேவையகம் ஒரு பிழையை வழங்கியது: HTTP {status_code}"

#: src/auth_playground/endpoints.py:68
msgid "Failed to connect to the server. Please check the URL."
msgstr "சேவையகத்துடன் இணைக்க முடியவில்லை. முகவரி ஐ சரிபார்க்கவும்."

#: src/auth_playground/endpoints.py:71
msgid "Invalid response from server"
msgstr "சேவையகத்திலிருந்து தவறான பதில்"

#: src/auth_playground/endpoints.py:110
msgid ""
"OAuth configuration is set via environment variables and cannot be changed"
msgstr ""
"OAuth உள்ளமைவு சூழல் மாறிகள் மூலம் அமைக்கப்பட்டுள்ளது மற்றும் மாற்ற முடியாது"

#: src/auth_playground/endpoints.py:125
msgid "You can now configure a different identity provider"
msgstr "நீங்கள் இப்போது வேறு அடையாள வழங்குநரைக் கட்டமைக்க முடியும்"

#: src/auth_playground/endpoints.py:147
msgid "Server metadata successfully loaded"
msgstr "சர்வர் மேனிலை தரவு வெற்றிகரமாக ஏற்றப்பட்டது"

#: src/auth_playground/endpoints.py:157
msgid "OAuth client is set via environment variables and cannot be changed"
msgstr ""
"OAuth கிளையன்ட் சூழல் மாறிகள் மூலம் அமைக்கப்பட்டுள்ளது மற்றும் மாற்ற "
"முடியாது"

#: src/auth_playground/endpoints.py:164
msgid "Please configure a server"
msgstr "சர்வரை உள்ளமைக்கவும்"

#: src/auth_playground/endpoints.py:195
msgid "OAuth configuration completed successfully"
msgstr "OAuth உள்ளமைவு வெற்றிகரமாக முடிந்தது"

#: src/auth_playground/endpoints.py:238
