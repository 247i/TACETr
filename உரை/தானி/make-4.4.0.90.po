#: src/main.c:319
msgid "Options:\n"
msgstr "விருப்பங்கள்:\n"

#: src/main.c:320
msgid "  -b, -m                      Ignored for compatibility.\n"
msgstr "-b, -m இணக்கத்தன்மைக்காக புறக்கணிக்கப்பட்டது.\n"

#: src/main.c:322
msgid "  -B, --always-make           Unconditionally make all targets.\n"
msgstr "-B, --எப்போதும்-நிபந்தனையின்றி அனைத்து இலக்குகளையும் உருவாக்கவும்.\n"

#: src/main.c:324
msgid ""
"  -C DIRECTORY, --directory=DIRECTORY\n"
"                              Change to DIRECTORY before doing anything.\n"
msgstr ""
"-சி டைரக்டரி, --டைரக்டரி = டைரக்டரி \n"
"எதையும் செய்வதற்கு முன் DIRECTORY க்கு மாற்றவும்.\n"

#: src/main.c:327
msgid "  -d                          Print lots of debugging information.\n"
msgstr "-d நிறைய பிழைத்திருத்தத் தகவல்களை அச்சிடுங்கள்.\n"

#: src/main.c:329
msgid ""
"  --debug[=FLAGS]             Print various types of debugging "
"information.\n"
msgstr "--debug[=FLAGS] பல்வேறு வகையான பிழைத்திருத்தத் தகவலை அச்சிடுக.\n"

#: src/main.c:331
msgid ""
"  -e, --environment-overrides\n"
"                              Environment variables override makefiles.\n"
msgstr ""
"-இ, --சுற்றுச்சூழல்-மேற்பார்வை \n"
"சுற்றுச்சூழல் மாறிகள் மேக்ஃபைல்களை மீறுகின்றன.\n"

#: src/main.c:334
msgid "  -E STRING, --eval=STRING    Evaluate STRING as a makefile statement.\n"
msgstr "-E STRING, --eval=STRING சரம் ஐ மேக்ஃபைல் அறிக்கையாக மதிப்பிடவும்.\n"

#: src/main.c:336
msgid ""
"  -f FILE, --file=FILE, --makefile=FILE\n"
"                              Read FILE as a makefile.\n"
msgstr ""
"-f FILE, --file=FILE, --makefile=FILE \n"
"FILE ஐ மேக்ஃபைலாக படிக்கவும்.\n"

#: src/main.c:339
msgid "  -h, --help                  Print this message and exit.\n"
msgstr "-h, --உதவி இந்த செய்தியை அச்சிட்டு வெளியேறவும்.\n"

#: src/main.c:341
msgid "  -i, --ignore-errors         Ignore errors from recipes.\n"
msgstr ""
"-i, --ignore-errors சமையல் குறிப்புகளிலிருந்து பிழைகளைப் புறக்கணிக்கவும்.\n"

#: src/main.c:343
msgid ""
"  -I DIRECTORY, --include-dir=DIRECTORY\n"
"                              Search DIRECTORY for included makefiles.\n"
msgstr ""
"-I டைரக்டரி, --include-dir=DIRECTORY \n"
"சேர்க்கப்பட்ட மேக்ஃபைல்களுக்கு டைரக்டரியைத் தேடுங்கள்.\n"

#: src/main.c:346
msgid ""
"  -j [N], --jobs[=N]          Allow N jobs at once; infinite jobs with no "
"arg.\n"
msgstr "-j [N], --jobs[=N] N வேலைகளை ஒரே நேரத்தில் அனுமதி; எல்லையற்ற வேலைகள்.\n"

#: src/main.c:348
msgid "  --jobserver-style=STYLE     Select the style of jobserver to use.\n"
msgstr ""
"--jobserver-style=STYLE பயன்படுத்த சாப் சர்வரின் பாணியைத் "
"தேர்ந்தெடுக்கவும்.\n"

#: src/main.c:350
msgid ""
"  -k, --keep-going            Keep going when some targets can't be made.\n"
msgstr "-k, --keep-going சில இலக்குகளை அடைய முடியாத போது தொடரவும்.\n"

#: src/main.c:352
msgid ""
"  -l [N], --load-average[=N], --max-load[=N]\n"
"                              Don't start multiple jobs unless load is below N.\n"
msgstr ""
"-l [N], --load-average[=N], --max-load[=N] \n"
"சுமை N க்குக் கீழே இல்லாவிட்டால் பல வேலைகளைத் தொடங்க வேண்டாம்.\n"

#: src/main.c:355
msgid ""
"  -L, --check-symlink-times   Use the latest mtime between symlinks and "
"target.\n"
msgstr ""
"-L, --check-symlink-times symlinks மற்றும் இலக்கு இடையே அண்மைக் கால mtime "
"ஐப் பயன்படுத்தவும்.\n"

#: src/main.c:357
msgid ""
"  -n, --just-print, --dry-run, --recon\n"
"                              Don't actually run any recipe; just print them.\n"
msgstr ""
"-n, --just-print, --dry-run, --recon \n"
"உண்மையில் எந்த செய்முறையையும் இயக்க வேண்டாம்; அவற்றை அச்சிடுங்கள்.\n"

#: src/main.c:360
msgid ""
"  -o FILE, --old-file=FILE, --assume-old=FILE\n"
"                              Consider FILE to be very old and don't remake it.\n"
msgstr ""
"-o கோப்பு, --old-file=FILE, --assume-old=FILE \n"
"FILE மிகவும் பழையதாக கருதி அதை ரீமேக் செய்ய வேண்டாம்.\n"

#: src/main.c:363
msgid ""
"  -O[TYPE], --output-sync[=TYPE]\n"
"                              Synchronize output of parallel jobs by TYPE.\n"
msgstr ""
"-O[TYPE], --output-sync[=TYPE] \n"
"TYPE மூலம் இணையான வேலைகளின் வெளியீட்டை ஒத்திசைக்கவும்.\n"

#: src/main.c:366
msgid "  -p, --print-data-base       Print make's internal database.\n"
msgstr "-p, --print-data-base அச்சு தயாரிப்பின் உள் தரவுத்தளம்.\n"

#: src/main.c:368
msgid ""
"  -q, --question              Run no recipe; exit status says if up to "
"date.\n"
msgstr ""
"-q, --கேள்வி எந்த செய்முறையையும் இயக்கவும்; புதுப்பித்த நிலையில் இருந்தால் "
"வெளியேறும் நிலை கூறுகிறது.\n"

#: src/main.c:370
msgid "  -r, --no-builtin-rules      Disable the built-in implicit rules.\n"
msgstr "-r, --no-builtin-rules உள்ளமைக்கப்பட்ட மறைமுக விதிகளை முடக்கவும்.\n"

#: src/main.c:372
msgid "  -R, --no-builtin-variables  Disable the built-in variable settings.\n"
msgstr ""
"-R, --no-builtin-variables உள்ளமைக்கப்பட்ட மாறி அமைப்புகளை முடக்கவும்.\n"

#: src/main.c:374
msgid ""
"  --shuffle[={SEED|random|reverse|none}]\n"
"                              Perform shuffle of prerequisites and goals.\n"
msgstr ""
"--குலைப்பு[={SEED|ரேண்டம்|தலைகீழ்|இல்லை}] \n"
"முன்நிபந்தனைகள் மற்றும் இலக்குகளை மாற்றியமைக்கவும்.\n"

#: src/main.c:377
msgid "  -s, --silent, --quiet       Don't echo recipes.\n"
msgstr "-s, --silent, --quiet ரெசிபிகளை எதிரொலிக்க வேண்டாம்.\n"

#: src/main.c:379
msgid "  --no-silent                 Echo recipes (disable --silent mode).\n"
msgstr "--no-silent எக்கோ ரெசிபிகள் (முடக்கு --silent mode).\n"

#: src/main.c:381
msgid ""
"  -S, --no-keep-going, --stop\n"
"                              Turns off -k.\n"
msgstr ""
"-எச், --இல்லை-போகாமல், --நிறுத்து \n"
"அணைக்க -k.\n"

#: src/main.c:384
msgid "  -t, --touch                 Touch targets instead of remaking them.\n"
msgstr "-t, --டச் இலக்குகளை ரீமேக் செய்வதற்குப் பதிலாக தொடவும்.\n"

#: src/main.c:386
msgid "  --trace                     Print tracing information.\n"
msgstr "--trace அச்சிடுக Tracing information.\n"

#: src/main.c:388
msgid ""
"  -v, --version               Print the version number of make and exit.\n"
msgstr "-v, --version தயாரிப்பின் பதிப்பு எண்ணை அச்சிட்டு வெளியேறவும்.\n"

#: src/main.c:390
msgid "  -w, --print-directory       Print the current directory.\n"
msgstr "-w, --print-directory தற்போதைய கோப்பகத்தை அச்சிடவும்.\n"

#: src/main.c:392
msgid ""
"  --no-print-directory        Turn off -w, even if it was turned on "
"implicitly.\n"
msgstr ""
"--no-print-directory மறைமுகமாக இயக்கப்பட்டிருந்தாலும் -w ஐ அணைக்கவும்.\n"

#: src/main.c:394
msgid ""
"  -W FILE, --what-if=FILE, --new-file=FILE, --assume-new=FILE\n"
"                              Consider FILE to be infinitely new.\n"
msgstr ""
"-W FILE, --what-if=FILE, --new-file=FILE, --assume-new=FILE \n"
"FILE ஐ எண்ணற்ற புதியதாகக் கருதுங்கள்.\n"

#: src/main.c:397
msgid ""
"  --warn-undefined-variables  Warn when an undefined variable is "
"referenced.\n"
msgstr ""
"--warn-undefined-variables வரையறுக்கப்படாத மாறி குறிப்பிடப்படும் போது "
"எச்சரிக்கவும்.\n"

#: src/main.c:735 src/main.c:737
#, c-format
msgid "write error: stdout"
msgstr "எழுத்து பிழை: stdout"

#: src/main.c:749
#, c-format
msgid "empty string invalid as file name"
msgstr "வெற்று சரம் கோப்பு பெயராக செல்லாது"

#: src/main.c:841
#, c-format
msgid "unknown debug level specification '%s'"
msgstr "அறியப்படாத பிழைத்திருத்த நிலை விவரக்குறிப்பு '%s'"

#: src/main.c:881
#, c-format
msgid "unknown output-sync type '%s'"
msgstr "அறியப்படாத வெளியீடு-ஒத்திசைவு வகை '%s'"

#: src/main.c:905
#, c-format
msgid "Usage: %s [options] [target] ...\n"
msgstr "பயன்பாடு: %s [விருப்பங்கள்] [இலக்கு] ...\n"

