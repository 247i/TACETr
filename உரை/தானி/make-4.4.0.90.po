"This program built for %s\n"
msgstr ""
"\n"
"இந்த நிரல் %sக்காக உருவாக்கப்பட்டது\n"

#: src/main.c:913
#, c-format
msgid ""
"\n"
"This program built for %s (%s)\n"
msgstr ""
"\n"
"இந்த நிரல் %s (%s)க்காக உருவாக்கப்பட்டது\n"

#: src/main.c:916
#, c-format
msgid "Report bugs to <bug-make@gnu.org>\n"
msgstr "பிழைகளை <bug-make@gnu.org> க்கு புகாரளிக்கவும்\n"

#: src/main.c:947
#, c-format
msgid "%s: Interrupt/Exception caught (code = 0x%lx, addr = 0x%p)\n"
msgstr ""
"%s: குறுக்கீடு/விதிவிலக்கு பிடிக்கப்பட்டது (குறியீடு = 0x%lx, addr = 0x%p)\n"

#: src/main.c:954
#, c-format
msgid ""
"\n"
"Unhandled exception filter called from program %s\n"
"ExceptionCode = %lx\n"
"ExceptionFlags = %lx\n"
"ExceptionAddress = 0x%p\n"
msgstr ""
"\n"
"%s நிரலிலிருந்து அழைக்கப்படும் கையாளப்படாத விதிவிலக்கு வடிகட்டி \n"
"விதிவிலக்கு குறியீடு = %lx \n"
"விதிவிலக்கு கொடிகள் = %lx \n"
"விதிவிலக்கு முகவரி = 0x%p\n"

#: src/main.c:962
#, c-format
msgid "Access violation: write operation at address 0x%p\n"
msgstr "அணுகல் மீறல்: 0x%p முகவரியில் எழுதும் செயல்பாடு\n"

#: src/main.c:963
#, c-format
msgid "Access violation: read operation at address 0x%p\n"
msgstr "அணுகல் மீறல்: 0x%p முகவரியில் செயல்பாட்டைப் படிக்கவும்\n"

#: src/main.c:1035 src/main.c:1049
#, c-format
msgid "find_and_set_shell() setting default_shell = %s\n"
msgstr "find_and_set_shell() அமைப்பு default_shell = %s\n"

#: src/main.c:1105
#, c-format
msgid "find_and_set_shell() path search set default_shell = %s\n"
msgstr "find_and_set_shell() பாதை தேடல் செட் default_shell = %s\n"

#: src/main.c:1158
msgid "unlink (temporary file): "
msgstr "இணைப்பை நீக்கு (தற்காலிக கோப்பு):"

#: src/main.c:1848
#, c-format
msgid ""
"warning: jobserver unavailable: using -j1.  Add '+' to parent make rule."
msgstr ""
"எச்சரிக்கை: சாப்சர்வர் கிடைக்கவில்லை: -j1 ஐப் பயன்படுத்துகிறது. பெற்றோர் "
"உருவாக்க விதியில் '+' சேர்க்கவும்."

#: src/main.c:1856
#, c-format
msgid "warning: -j%d forced in submake: resetting jobserver mode."
msgstr ""
"எச்சரிக்கை: -jd துணை தயாரிப்பில் கட்டாயப்படுத்தப்பட்டது: வேலை சர்வர் "
"பயன்முறையை மீட்டமைத்தல்."

#: src/main.c:1945
#, c-format
msgid "Makefile from standard input specified twice"
msgstr "இரண்டு முறை குறிப்பிடப்பட்ட நிலையான உள்ளீட்டிலிருந்து மேக்ஃபைல்"

#: src/main.c:1950
#, c-format
msgid "cannot store makefile from stdin to a temporary file"
msgstr "மேக்ஃபைலை stdin இலிருந்து தற்காலிக கோப்பில் சேமிக்க முடியாது"

#: src/main.c:1958
#, c-format
msgid "fwrite: temporary file %s: %s"
msgstr "fwrite: தற்காலிக கோப்பு %s: %s"

#: src/main.c:2113
#, c-format
msgid "warning: -j%d forced in makefile: resetting jobserver mode."
msgstr ""
"எச்சரிக்கை: -j%d மேக்ஃபைலில் கட்டாயப்படுத்தப்பட்டது: சாப்சர்வர் பயன்முறையை "
"மீட்டமைத்தல்."

#: src/main.c:2209
#, c-format
msgid "Parallel jobs (-j) are not supported on this platform."
msgstr "இணையான வேலைகள் (-j) இந்த தளத்தில் ஆதரிக்கப்படவில்லை."

#: src/main.c:2210
#, c-format
msgid "Resetting to single job (-j1) mode."
msgstr "ஒற்றை வேலை (-j1) பயன்முறைக்கு மீட்டமைக்கிறது."

#: src/main.c:2266
#, c-format
msgid "Using jobserver controller %s\n"
msgstr "சாப்சர்வர் கன்ட்ரோலர் %s ஐப் பயன்படுத்துகிறது\n"

#: src/main.c:2268
#, c-format
msgid "Using output-sync mutex %s\n"
msgstr "வெளியீடு-ஒத்திசைவு மியூடெக்ச் %s ஐப் பயன்படுத்துகிறது\n"

#: src/main.c:2273
#, c-format
msgid "Symbolic links not supported: disabling -L."
msgstr "குறியீட்டு இணைப்புகள் ஆதரிக்கப்படவில்லை: முடக்குதல் -L."

#: src/main.c:2345
#, c-format
msgid "Enabled shuffle mode: %s\n"
msgstr "இயக்கப்பட்ட சஃபிள் பயன்முறை: %s\n"

