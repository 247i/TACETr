msgid "Audio signals"
msgstr "ஆடியோ சிக்னல்கள்"

#, icu-message-format
msgctxt "selectAudioScheme"
msgid "Change audio signal scheme"
msgstr "ஆடியோ சிக்னல் திட்டத்தை மாற்றவும்"

#, icu-message-format
msgctxt "runSettings"
msgid "Run Settings"
msgstr "அமைப்புகளை இயக்கவும்"

#, icu-message-format
msgctxt "notifyUponReachedBreaks"
msgid "Notifies you when breaks are reached"
msgstr "இடைவெளிகளை அடையும் போது உங்களுக்குத் தெரிவிக்கும்"

#, icu-message-format
msgctxt "notifyUponReachedBreaksDescription"
msgid "Notifies you when a break is reached and a run has started or ended."
msgstr ""
"ஒரு இடைவேளையை அடைந்து, ஒரு ஓட்டம் தொடங்கியது அல்லது முடிந்ததும் உங்களுக்குத்"
" தெரிவிக்கும்."

#, icu-message-format
msgctxt "vibrateUponReachedBreaks"
msgid "Vibrates when breaks are reached"
msgstr "இடைவெளிகளை அடையும் போது அதிர்கிறது"

#, icu-message-format
msgctxt "vibrateUponReachedBreaksDescription"
msgid ""
"Vibrates with a pattern when a break is reached and a run has started or "
"ended."
msgstr ""
"இடைவேளையை அடைந்து ரன் தொடங்கும் போது அல்லது முடிவடையும் போது ஒரு வடிவத்துடன்"
" அதிர்கிறது."

#, icu-message-format
msgctxt "signalTwiceUponReachedBreaks"
msgid "Two signals when breaks are reached"
msgstr "இடைவெளிகளை அடையும் போது இரண்டு சமிக்ஞைகள்"

#, icu-message-format
msgctxt "signalTwiceUponReachedBreaksDescription"
msgid "To ensure no break is missed, each break is signaled twice."
msgstr ""
"இடைவெளி தவறவிடாமல் இருக்க, ஒவ்வொரு இடைவெளியும் இரண்டு முறை சமிக்ஞை "
"செய்யப்படுகிறது."

#, icu-message-format
msgctxt "signalWithoutCounter"
msgid "Signal without counter information"
msgstr "எதிர் செய்தி இல்லாத சிக்னல்"

#, icu-message-format
msgctxt "signalWithoutCounterDescription"
msgid "Don't encode the counter in the audio and vibration signal."
msgstr ""
"ஆடியோ மற்றும் அதிர்வு சமிக்ஞையில் கவுண்டரை குறியாக்கம் செய்ய வேண்டாம்."

#, icu-message-format
msgctxt "defaultBreakOrder"
msgid "The break order descending by default"
msgstr "இடைவேளை வரிசை இயல்பாக இறங்குகிறது"

#, icu-message-format
msgctxt "defaultBreakOrderDescription"
msgid "Instead of 1, 2, 3… the order …, 3, 2, 1 is used."
msgstr "1, 2, 3… வரிசைக்கு பதிலாக …, 3, 2, 1 பயன்படுத்தப்படுகிறது."

#, icu-message-format
msgctxt "showRunSpinner"
msgid "Show run indicator"
msgstr "ரன் காட்டி காட்டு"

#, icu-message-format
msgctxt "showRunSpinnerDescription"
msgid ""
"Displays a spinning indicator in the timer wheel while the timer is running."
msgstr ""
"நேரங்குறிகருவி இயங்கும் போது நேரங்குறிகருவி வீலில் சுழலும் குறிகாட்டியைக் "
"காட்டுகிறது."

#, icu-message-format
msgctxt "showArrowsOnTimeValues"
msgid "Displays arrows at time values"
msgstr "நேர மதிப்புகளில் அம்புகளைக் காட்டுகிறது"

#, icu-message-format
msgctxt "showArrowsOnTimeValuesDescription"
msgid ""
"Displays arrows at values during a timer run to indicate their direction of "
"travel."
msgstr ""
"ஒரு நேரங்குறிகருவி ஓட்டத்தின் போது மதிப்புகளில் அம்புக்குறிகளை அவற்றின் "
"பயணத்தின் திசையைக் குறிக்கும்."

#, icu-message-format
msgctxt "presetSettings"
msgid "Preset Settings"
msgstr "முன்னமைக்கப்பட்ட அமைப்புகள்"

#, icu-message-format
msgctxt "hidePredefinedPresets"
msgid "Hide predefined presets"
msgstr "முன் வரையறுக்கப்பட்ட முன்னமைவுகளை மறை"

#, icu-message-format
msgctxt "hidePredefinedPresetsDescription"
msgid ""
"If you don't need the predefined presets, you can hide them. Only your own "
"custom presets will then be displayed."
msgstr ""
"முன் வரையறுக்கப்பட்ட முன்னமைவுகள் உங்களுக்குத் தேவையில்லை என்றால், நீங்கள் "
"அவற்றை மறைக்கலாம். உங்கள் சொந்த தனிப்பயன் முன்னமைவுகள் மட்டுமே பின்னர் "
"காட்டப்படும்."

#, icu-message-format
msgctxt "customizedPresetsOnTop"
msgid "Show custom presets at the top"
msgstr "மேலே தனிப்பயன் முன்னமைவுகளைக் காட்டு"

#, icu-message-format
msgctxt "customizedPresetsOnTopDescription"
msgid ""
"Custom presets are displayed at the top of the preset list for faster "
"access."
msgstr ""
"வேகமான அணுகலுக்காக, தனிப்பயன் முன்னமைவுகள் முன்னமைக்கப்பட்ட பட்டியலின் மேலே "
"காட்டப்படும்."

#, icu-message-format
msgctxt "appBehaviourSettings"
msgid "App Behaviour Settings"
msgstr "பயன்பாட்டு நடத்தை அமைப்புகள்"

#, icu-message-format
msgctxt "activateWakeLock"
msgid "Activate Wake Lock"
msgstr "வேக் லாக்கை இயக்கவும்"

#, icu-message-format
msgctxt "activateWakeLockDescription"
msgid "A wake lock prevents the screen from turning off automatically."
msgstr "வேக் லாக், திரை தானாகவே அணைக்கப்படுவதைத் தடுக்கிறது."

#, icu-message-format
msgctxt "startAppFromScratch"
msgid "Launch the app with an empty timer wheel"
msgstr "வெற்று நேரங்குறிகருவி வீலுடன் பயன்பாட்டைத் தொடங்கவும்"

#, icu-message-format
msgctxt "startAppFromScratchDescription"
msgid ""
"When the app starts, it will launch with an empty timer wheel or your "
"preferred preset. If this option is disabled, the last used state will be "
"restored when the app starts."
msgstr ""
"பயன்பாடு தொடங்கும் போது, ​​அது வெற்று நேரங்குறிகருவி வீல் அல்லது உங்களுக்கு "
"விருப்பமான முன்னமைவுடன் தொடங்கும். இந்த விருப்பம் முடக்கப்பட்டிருந்தால், "
"ஆப்ச் தொடங்கும் போது கடைசியாகப் பயன்படுத்தப்பட்ட நிலை மீட்டமைக்கப்படும்."

#, icu-message-format
msgctxt "clockModeAsDefault"
msgid "Use clock mode as default"
msgstr "கடிகார பயன்முறையை இயல்புநிலையாகப் பயன்படுத்தவும்"

#, icu-message-format
msgctxt "clockModeAsDefaultDescription"
msgid "Set clock mode instead of timer mode as default"
msgstr ""
"நேரங்குறிகருவி பயன்முறைக்கு பதிலாக கடிகார பயன்முறையை இயல்புநிலையாக "
"அமைக்கவும்"

#, icu-message-format
msgctxt "info"
msgid "Information"
msgstr "தகவல்"

#, icu-message-format
msgctxt "batteryOptimizations"
msgid "Battery optimizations"
msgstr "பேட்டரி மேம்படுத்தல்கள்"

#, icu-message-format
msgctxt "aboutTheApp"
msgid "About the app"
msgstr "பயன்பாட்டைப் பற்றி"

#, icu-message-format
msgctxt "appShortDescription"
msgid "A timer with intermediate notifications"
msgstr "இடைநிலை அறிவிப்புகளுடன் கூடிய நேரங்குறிகருவி"

#, icu-message-format
msgctxt "visitAppGithubPage"
msgid "Visit {url} to view the code, report bugs, and rate!"
msgstr ""
"குறியீட்டைப் பார்க்கவும், பிழைகளைப் புகாரளிக்கவும், மதிப்பிடவும் {url} ஐப் "
"பார்வையிடவும்!"

#, icu-message-format
msgctxt "visitAppHomePage"
msgid "Visit {url} for more information."
msgstr "மேலும் தகவலுக்கு {url} ஐப் பார்வையிடவும்."

#, icu-message-format
msgctxt "help"
msgid "Help"
msgstr "உதவி"

#, icu-message-format
msgctxt "appSummary"
msgid ""
"This timer lets you set any number of intermediate notifications ('breaks') "
"to keep you informed about the progress of the elapsed time."
msgstr ""
"கடந்த காலத்தின் முன்னேற்றம் குறித்து உங்களுக்குத் தெரிவிக்க, இடைநிலை "
"அறிவிப்புகளை ('பிரேக்குகள்') அமைக்க இந்த நேரங்குறிகருவி உங்களை "
"அனுமதிக்கிறது."

#, icu-message-format
msgctxt "appExplanation"
msgid ""
"Select a duration or time for the timer by clicking the center of the wheel."
" Select any number of breaks on the timer wheel by clicking a segment. Each "
"break generates a signal (audible and/or vibration) with the following "
"unique patterns (click to play):"
msgstr ""
"சக்கரத்தின் மையத்தில் சொடுக்கு செய்வதன் மூலம் டைமருக்கான கால அளவு அல்லது "
"நேரத்தைத் தேர்ந்தெடுக்கவும். ஒரு பிரிவைக் சொடுக்கு செய்வதன் மூலம், "
"நேரங்குறிகருவி வீலில் உள்ள இடைவெளிகளைத் தேர்ந்தெடுக்கவும். ஒவ்வொரு "
"இடைவெளியும் பின்வரும் தனித்துவமான வடிவங்களுடன் (விளையாட சொடுக்கு செய்யவும்) "
"ஒரு சமிக்ஞையை (கேட்கும் மற்றும்/அல்லது அதிர்வு) உருவாக்குகிறது:"

#, icu-message-format
msgctxt "breakReached"
msgid "Break {breakNumber} of {breakCount} reached"
msgstr "{breakCount} இல் {breakNumber}ஐ எட்டியது"

#, icu-message-format
msgctxt "timerStarted"
msgid "Timer started"
msgstr "நேரங்குறிகருவி தொடங்கியது"

#, icu-message-format
msgctxt "timerFinished"
msgid "Timer finished"
msgstr "நேரங்குறிகருவி முடிந்தது"

#, icu-message-format
msgctxt "timerFinishedButRepeating"
msgid "Timer finished, but will repeat"
msgstr "நேரங்குறிகருவி முடிந்தது, ஆனால் மீண்டும் வரும்"

#, icu-message-format
msgctxt "afterDuration"
msgid "after {duration}"
msgstr "{duration}க்குப் பிறகு"

#, icu-message-format
msgctxt "afterXRuns"
msgid "after {runCount} runs"
msgstr "{runCount} ரன்களுக்குப் பிறகு"

#, icu-message-format
msgctxt "withBreaks"
msgid "with {breakCount} breaks"
msgstr "{breakCount} இடைவெளிகளுடன்"

#, icu-message-format
msgctxt "breakPresets"
msgid "Break presets"
msgstr "முன்னமைவுகளை உடைக்கவும்"

#, icu-message-format
msgctxt "breakPresetPinned"
msgid "Preset '{preset}' pinned"
msgstr "முன்னமைக்கப்பட்ட '{preset}' பின் செய்யப்பட்டது"

#, icu-message-format
msgctxt "breakPresetUnpinned"
msgid "Preset '{preset}' unpinned"
msgstr "முன்னமைக்கப்பட்ட '{preset}' அகற்றப்பட்டது"

#, icu-message-format
msgctxt "every3rdSlice"
msgid "every 3rd slice"
msgstr "ஒவ்வொரு 3 வது துண்டு"

#, icu-message-format
msgctxt "every5thSlice"
msgid "every 5th slice"
msgstr "ஒவ்வொரு 5 வது துண்டு"

#, icu-message-format
msgctxt "everyXMinutes"
msgid "every {count} minutes"
msgstr "ஒவ்வொரு {count} நிமிடங்களுக்கும்"

#, icu-message-format
msgctxt "savePresetTitle"
msgid "Save preset"
msgstr "முன்னமைவைச் சேமிக்கவும்"

#, icu-message-format
msgctxt "savePresetMessage"
msgid "Enter a name for your preset to save."
msgstr "சேமிக்க உங்கள் முன்னமைவுக்கு ஒரு பெயரை உள்ளிடவும்."

#, icu-message-format
msgctxt "savePresetHint"
msgid "choose a name"
msgstr "ஒரு பெயரை தேர்வு செய்யவும்"

#, icu-message-format
msgctxt "savePresetIncludeDuration"
msgid "Include duration"
msgstr "கால அளவைச் சேர்க்கவும்"

#, icu-message-format
msgctxt "savePresetIncludeTime"
msgid "Include time"
msgstr "நேரத்தைச் சேர்க்கவும்"

#, icu-message-format
msgctxt "errorSavePresetNameMissing"
msgid "Preset name missing"
msgstr "முன்னமைக்கப்பட்ட பெயர் இல்லை"

#, icu-message-format
msgctxt "errorSavePresetNameInUse"
msgid "Preset name still used. Choose another one"
msgstr ""
"முன்னமைக்கப்பட்ட பெயர் இன்னும் பயன்படுத்தப்படுகிறது. இன்னொன்றைத் "
"தேர்ந்தெடுங்கள்"

#, icu-message-format
msgctxt "savePresetDone"
msgid "'{preset}' saved"
msgstr "'{preset}' சேமிக்கப்பட்டது"

#, icu-message-format
msgctxt "removePresetTitle"
msgid "Remove saved preset"
msgstr "சேமித்த முன்னமைவை அகற்று"

#, icu-message-format
msgctxt "removePresetMessage"
msgid "Are you sure to delete '{preset}' permanently?"
msgstr "'{preset}' ஐ நிரந்தரமாக நீக்குவது உறுதியா?"

#, icu-message-format
msgctxt "removePresetDone"
msgid "'{preset}' removed"
msgstr "'{preset}' அகற்றப்பட்டது"

#, icu-message-format
msgctxt "breakOrderSwitchedToAscending"
msgid "Break order changed to ascending"
msgstr "பிரேக் ஆர்டர் ஏறுவரிசைக்கு மாற்றப்பட்டது"

#, icu-message-format
msgctxt "breakOrderSwitchedToDescending"
msgid "Break order changed to descending"
msgstr "பிரேக் ஆர்டர் இறங்குமுறைக்கு மாற்றப்பட்டது"

#, icu-message-format
msgctxt "startTimer"
msgid "Start"
msgstr "தொடங்கு"

#, icu-message-format
msgctxt "stopTimer"
msgid "Stop"
msgstr "நிறுத்து"

#, icu-message-format
msgctxt "swipeToStop"
msgid "Swipe to Stop"
msgstr "நிறுத்த ச்வைப் செய்யவும்"

#, icu-message-format
msgctxt "repeatOnce"
msgid "Repeat once"
msgstr "ஒரு முறை செய்யவும்"

#, icu-message-format
msgctxt "repeatForever"
msgid "Repeat forever"
msgstr "என்றென்றும் மீண்டும் செய்யவும்"

#, icu-message-format
msgctxt "noRepeat"
msgid "No repeat"
msgstr "மீண்டும் இல்லை"

#, icu-message-format
msgctxt "xBreaksPlaced"
msgid "{breakCount} breaks placed"
msgstr "{breakCount} இடைவெளிகள் வைக்கப்பட்டுள்ளன"

#, icu-message-format
msgctxt "xBreaksPlacedRepeatOnce"
msgid "{breakCount} breaks placed, repeat once"
msgstr "{breakCount} இடைவெளிகள் வைக்கப்பட்டுள்ளன, ஒருமுறை மீண்டும் செய்யவும்"

#, icu-message-format
msgctxt "xBreaksPlacedRepeatForever"
msgid "{breakCount} breaks placed, repeat forever"
msgstr ""
"{breakCount} இடைவெளிகள் வைக்கப்பட்டுள்ளன, எப்போதும் மீண்டும் செய்யவும்"

#, icu-message-format
msgctxt "xBreaksLeft"
msgid "{remainingBreaks} of {breakCount} breaks left"
msgstr "{breakCount} இல் {remainingBreaks} இடைவெளிகள் மீதமுள்ளன"

#, icu-message-format
msgctxt "xBreaksLeftRepeatOnce"
msgid ""
"{remainingBreaks} of {breakCount} breaks left, repeating once (run "
"{runCount} of 2)"
msgstr ""
"{breakCount} இல் {remainingBreaks} இடைவெளிகள் மீதமுள்ளன, மீண்டும் ஒரு முறை "
"(ரன் {runCount} இல் 2)"

#, icu-message-format
msgctxt "xBreaksLeftRepeatForever"
msgid ""
"{remainingBreaks} of {breakCount} breaks left, repeating forever (run "
"{runCount})"
msgstr ""
"{breakCount} இல் {remainingBreaks} இடைவெளிகள் எஞ்சியிருக்கின்றன, நிரந்தரமாக "
"மீண்டும் நிகழும் (ரன் {runCount})"

#, icu-message-format
msgctxt "splitBreaks"
msgid "Split breaks"
msgstr "பிளவு முறிவுகள்"

#, icu-message-format
msgctxt "splitBreaksDescription"
msgid "Select the number of breaks needed for {duration}."
msgstr "{duration}க்கு தேவையான இடைவெளிகளின் எண்ணிக்கையைத் தேர்ந்தெடுக்கவும்."

#, icu-message-format
msgctxt "durationBetweenBreaks"
msgid "Duration between {breakCount} breaks: {duration}"
msgstr "{breakCount} இடைவெளிகளுக்கு இடையேயான கால அளவு: {duration}"

#, icu-message-format
msgctxt "errorNoPermissionForNotifications"
msgid "Notifications won't work as long as this permission is not granted."
msgstr "இந்த இசைவு வழங்கப்படாத வரை அறிவிப்புகள் இயங்காது."

#, icu-message-format
msgctxt "errorDeviceMuted"
msgid "Device is muted. Unmute first to set volume."
msgstr "சாதனம் முடக்கப்பட்டுள்ளது. ஒலியளவை அமைக்க முதலில் ஒலியை இயக்கவும்."

#, icu-message-format
msgctxt "errorMaxBreaksReached"
msgid "Maximum {maxBreakCount} breaks allowed"
msgstr "அதிகபட்ச {maxBreakCount} இடைவெளிகள் அனுமதிக்கப்படுகின்றன"

#, icu-message-format
msgctxt "errorNoBreaksToReset"
msgid "No breaks to reset"
msgstr "மீட்டமைக்க இடைவெளிகள் இல்லை"

#, icu-message-format
msgctxt "errorClockTimeToClose"
msgid "The timer-time must be more than one minute in the future."
msgstr ""
"எதிர்காலத்தில் நேரங்குறிகருவி நேரம் ஒரு நிமிடத்திற்கு மேல் இருக்க வேண்டும்."

#, icu-message-format
msgctxt "errorDurationIsZero"
msgid "The duration cannot be zero."
msgstr "கால அளவு பூச்சியமாக இருக்க முடியாது."

#, icu-message-format
msgctxt "errorTimeAlreadyElapsed"
msgid "The timer-time has already expired; set a new timer."
msgstr ""
"நேரங்குறிகருவி நேரம் ஏற்கனவே காலாவதியாகிவிட்டது; புதிய டைமரை அமைக்கவும்."
