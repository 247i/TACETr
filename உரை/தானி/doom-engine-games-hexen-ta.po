msgctxt "TXT_ACS_MAP35_0_THEPO"
msgid "The portal has been sealed"
msgstr "போர்டல் சீல் வைக்கப்பட்டுள்ளது"

#. script texts
msgctxt "TXT_ACS_MAP35_1_CHOOS"
msgid "Choose your fate"
msgstr "உங்கள் விதியைத் தேர்ந்தெடுங்கள்"

#. script texts
msgctxt "TXT_ACS_MAP35_3_THEDO"
msgid "The door is barred from the inside"
msgstr "கதவு உள்பக்கமாகத் தடுக்கப்பட்டுள்ளது"

#. script texts
msgctxt "TXT_ACS_MAP35_12_AREYO"
msgid "Are you strong enough"
msgstr "நீங்கள் போதுமான வலிமையானவரா"

#. script texts
msgctxt "TXT_ACS_MAP35_14_TOFAC"
msgid "To face your own masters?"
msgstr "உங்கள் சொந்த எசமானர்களை எதிர்கொள்ளவா?"
