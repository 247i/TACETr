msgid "Stairs have risen on the Seven Portals"
msgstr ""

#. script texts
msgctxt "TXT_ACS_MAP05_9_YOUHA"
msgid "You have to find another switch…"
msgstr "நீங்கள் மற்றொரு சுவிட்சைக் கண்டுபிடிக்க வேண்டும்…"

#. script texts
msgctxt "TXT_ACS_MAP05_10_STONE"
msgid "Stones grind on the Seven Portals"
msgstr "ஏழு வாசல்களில் கற்கள் அரைக்கப்படுகின்றன"

#. script texts
msgctxt "TXT_ACS_MAP08_6_ONESI"
msgid "One sixth of the puzzle has been solved"
msgstr "புதிரின் ஆறில் ஒரு பங்கு தீர்க்கப்பட்டது"

#. script texts
msgctxt "TXT_ACS_MAP08_7_ONTHE"
msgid "on the Shadow Wood"
msgstr "நிழல் மரத்தின் மீது"

#. script texts
msgctxt "TXT_ACS_MAP08_10_THEDO"
msgid "The door is barred from the inside"
msgstr "கதவு உள்பக்கமாகத் தடுக்கப்பட்டுள்ளது"

#. script texts
msgctxt "TXT_ACS_MAP08_11_YOUHE"
msgid "You hear a door open in the distance"
msgstr "தூரத்தில் கதவு திறக்கும் ஒலி கேட்கிறது"

#. script texts
msgctxt "TXT_ACS_MAP09_6_ONESI"
msgid "One sixth of the puzzle has been solved"
msgstr "புதிரின் ஆறில் ஒரு பங்கு தீர்க்கப்பட்டது"

