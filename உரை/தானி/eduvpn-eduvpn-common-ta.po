#. Copied from source.
#, placeholders:{Identifier}
msgctxt "Failed to add an institute access server with URL: '{Identifier}'"
msgid "Failed to add an institute access server with URL: '{Identifier}'"
msgstr ""
"முகவரி உடன் இன்ச்டிட்யூட் அணுகல் சேவையகத்தைச் சேர்ப்பதில் தோல்வி: "
"'{Identifier}'"

#. Copied from source.
#, placeholders:{Identifier}
msgctxt ""
"Failed to add a secure internet server with organisation ID: '{Identifier}'"
msgid ""
"Failed to add a secure internet server with organisation ID: '{Identifier}'"
msgstr ""
"நிறுவன ஐடியுடன் பாதுகாப்பான இணைய சேவையகத்தைச் சேர்ப்பதில் தோல்வி: "
"'{Identifier}'"

#. Copied from source.
#, placeholders:{Identifier}
msgctxt "Failed to add a server with URL: '{Identifier}'"
msgid "Failed to add a server with URL: '{Identifier}'"
msgstr "முகவரி உடன் சேவையகத்தைச் சேர்ப்பதில் தோல்வி: '{Identifier}'"

#. Copied from source.
#, placeholders:{Identifier}
msgctxt "The input: '{Identifier}' is not a valid URL"
msgid "The input: '{Identifier}' is not a valid URL"
msgstr "உள்ளீடு: '{Identifier}' சரியான முகவரி அல்ல"

#. Copied from source.
#, placeholders:{Identifier}
msgctxt ""
"The client tried to autoconnect to the VPN server: '{Identifier}', but you "
"need to authorize again. Please manually connect again."
msgid ""
"The client tried to autoconnect to the VPN server: '{Identifier}', but you "
"need to authorize again. Please manually connect again."
msgstr ""
"கிளையன்ட் VPN சேவையகத்துடன் தானாக இணைக்க முயன்றார்: '{Identifier}', ஆனால் "
"நீங்கள் மீண்டும் அங்கீகரிக்க வேண்டும். மீண்டும் கைமுறையாக இணைக்கவும்."

#. Copied from source.
#, placeholders:{Identifier}
msgctxt ""
"The client tried to autoconnect to the VPN server: '{Identifier}', but the "
"operation failed to complete"
msgid ""
"The client tried to autoconnect to the VPN server: '{Identifier}', but the "
"operation failed to complete"
msgstr ""
"கிளையன்ட் VPN சேவையகத்துடன் தானாக இணைக்க முயன்றார்: '{Identifier}', ஆனால் "
"செயல்பாட்டை முடிக்க முடியவில்லை"

#. Copied from source.
#, placeholders:{Identifier}
msgctxt "Failed to connect to server: '{Identifier}'"
msgid "Failed to connect to server: '{Identifier}'"
msgstr "சேவையகத்துடன் இணைக்க முடியவில்லை: '{Identifier}'"

#. Copied from source.
#, placeholders:{Identifier}
msgctxt "Failed to obtain a VPN configuration for server: '{Identifier}'"
msgid "Failed to obtain a VPN configuration for server: '{Identifier}'"
msgstr "சேவையகத்திற்கான VPN உள்ளமைவைப் பெறுவதில் தோல்வி: '{Identifier}'"

#. Copied from source.
msgctxt "Failed to obtain the list of organizations"
msgid "Failed to obtain the list of organizations"
msgstr "நிறுவனங்களின் பட்டியலைப் பெற முடியவில்லை"

#. Copied from source.
msgctxt "Failed to obtain the list of servers"
msgid "Failed to obtain the list of servers"
msgstr "சேவையகங்களின் பட்டியலைப் பெறுவதில் தோல்வி"

#. Copied from source.
#, placeholders:{URL}
msgctxt "Timeout reached contacting URL: '{URL}'"
msgid "Timeout reached contacting URL: '{URL}'"
msgstr "முகவரி ஐத் தொடர்புகொள்வதற்கான நேரம் முடிந்தது: '{URL}'"

#. Copied from source.
#, placeholders:{Msg}:{Error}
msgctxt "{Msg}. The cause of the error is: {Error}."
msgid "{Msg}. The cause of the error is: {Error}."
msgstr "{Msg}. பிழைக்கான காரணம்: {Error}."

#. Copied from source.
msgctxt "An internal error occurred"
msgid "An internal error occurred"
msgstr "உள் பிழை ஏற்பட்டது"
