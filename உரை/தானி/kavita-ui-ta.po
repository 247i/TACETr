msgstr "{{other}} அமைக்கப்படும் போது {{name}} தேவை"

msgctxt "validation.other-field-invalid"
msgid "Cannot check validity, {{other}} is invalid"
msgstr "செல்லுபடியை சரிபார்க்க முடியவில்லை, {{other}} தவறானது"

msgctxt "validation.valid-email"
msgid "This must be a valid email"
msgstr "இது சரியான மின்னஞ்சலாக இருக்க வேண்டும்"

msgctxt "validation.password-validation"
msgid "Password must be between 6 and 256 characters in length"
msgstr "கடவுச்சொல் 6 முதல் 256 எழுத்துக்கள் வரை இருக்க வேண்டும்"

msgctxt "validation.year-validation"
msgid "This must be a valid year greater than 1000 and 4 characters long"
msgstr ""
"இது 1000 மற்றும் 4 எழுத்துக்களை விட அதிகமான செல்லுபடியாகும் ஆண்டாக இருக்க "
"வேண்டும்"

msgctxt "validation.invalid-uri"
msgid "The provided uri is invalid"
msgstr "வழங்கப்பட்ட யூரி தவறானது"

