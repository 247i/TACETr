msgctxt "toasts.nothing-to-remove"
msgid "Nothing to remove"
msgstr "அகற்ற எதுவும் இல்லை"

msgctxt "toasts.series-added-to-reading-list"
msgid "Series added to reading list"
msgstr "வாசிப்பு பட்டியலில் தொடர் சேர்க்கப்பட்டது"

msgctxt "toasts.volumes-added-to-reading-list"
msgid "Volume added to reading list"
msgstr "வாசிப்பு பட்டியலில் தொகுதி சேர்க்கப்பட்டது"

msgctxt "toasts.chapter-added-to-reading-list"
msgid "Chapter added to reading list"
msgstr "அத்தியாயம் வாசிப்பு பட்டியலில் சேர்க்கப்பட்டது"

msgctxt "toasts.multiple-added-to-reading-list"
msgid "Chapters and Volumes added to reading list"
msgstr "வாசிப்பு பட்டியலில் அத்தியாயங்கள் மற்றும் தொகுதிகள் சேர்க்கப்பட்டன"

msgctxt "toasts.select-files-warning"
msgid "You need to select files to move forward"
msgstr "முன்னேற நீங்கள் கோப்புகளைத் தேர்ந்தெடுக்க வேண்டும்"

msgctxt "toasts.reading-list-imported"
msgid "Reading List imported"
msgstr "படித்தல் பட்டியல் இறக்குமதி செய்யப்பட்டது"

msgctxt "toasts.incognito-off"
msgid "Incognito mode is off. Progress will now start being tracked."
msgstr ""
"மறைநிலை பயன்முறை முடக்கப்பட்டுள்ளது. முன்னேற்றம் இப்போது கண்காணிக்கப்படத் "
"தொடங்கும்."

msgctxt "toasts.refresh-covers-queued"
msgid "Refresh covers queued for {{name}}"
msgstr "{{name} க்கு க்கு வரிசையில் நிற்கும் கவர்கள் புதுப்பிக்கவும்"

msgctxt "toasts.generate-colorscape-queued"
msgid "Generate colorscape queued for {{name}}"
msgstr "{{name} க்கு க்கு வரிசையில் நிற்கும் வண்ணங்களை உருவாக்குங்கள்"

msgctxt "toasts.entity-read"
msgid "{{name}} is now read"
msgstr "{{name}} இப்போது படிக்கப்படுகிறது"

msgctxt "toasts.entity-unread"
msgid "{{name}} is now unread"
msgstr "{{name}} இப்போது படிக்கவில்லை"

msgctxt "toasts.mark-read"
msgid "Marked as Read"
msgstr "வாசிப்பு என குறிக்கப்பட்டுள்ளது"

msgctxt "toasts.mark-unread"
msgid "Marked as Unread"
msgstr "படிக்காததாக குறிக்கப்பட்டுள்ளது"

msgctxt "toasts.series-added-want-to-read"
msgid "Series added from Want to Read list"
msgstr "படிக்க விரும்பும் பட்டியலில் இருந்து தொடர் சேர்க்கப்பட்டது"

msgctxt "toasts.series-removed-want-to-read"
msgid "Series removed from Want to Read list"
msgstr "பட்டியலில் இருந்து அகற்றப்பட்ட தொடர் பட்டியலைப் படிக்க வேண்டும்"

msgctxt "toasts.series-deleted"
msgid "Series deleted"
msgstr "தொடர் நீக்கப்பட்டது"

msgctxt "toasts.delete-review"
msgid "Are you sure you want to delete your review?"
msgstr "உங்கள் மதிப்பாய்வை நீக்க விரும்புகிறீர்களா?"

msgctxt "toasts.review-deleted"
msgid "Review deleted"
msgstr "மதிப்பாய்வு நீக்கப்பட்டது"

msgctxt "toasts.file-send-to"
msgid "File(s) emailed to {{name}}"
msgstr "கோப்பு (கள்) {{name}} க்கு மின்னஞ்சல் செய்யப்பட்டது"

msgctxt "toasts.theme-missing"
msgid "The active theme no longer exists. Please refresh the page."
msgstr "செயலில் உள்ள கருப்பொருள் இனி இல்லை. பக்கத்தைப் புதுப்பிக்கவும்."

msgctxt "toasts.email-sent"
msgid "Email sent to {{email}}"
msgstr "மின்னஞ்சல் {{email}} க்கு அனுப்பப்பட்டது"

msgctxt "toasts.email-not-sent"
msgid ""
"Email on file is not a valid email and can not be sent. A link has been "
"dumped in logs. The admin can provide this link to complete flow."
msgstr ""
"கோப்பில் உள்ள மின்னஞ்சல் சரியான மின்னஞ்சல் அல்ல, அனுப்ப முடியாது. பதிவுகளில்"
" ஒரு இணைப்பு கொட்டப்பட்டுள்ளது. நிர்வாகி இந்த இணைப்பை முழுமையான ஓட்டத்திற்கு"
" வழங்க முடியும்."

msgctxt "toasts.k+-license-saved"
msgid ""
"License Key saved, but it is not valid. Click check to revalidate the "
"subscription. First time registration may take a min to propagate."
msgstr ""
"உரிமம் சேமிக்கப்பட்டது, ஆனால் அது செல்லுபடியாகாது. சந்தாவை புதுப்பிக்க "
"சரிபார்க்கவும் என்பதைக் சொடுக்கு செய்க. முதல் முறையாக பதிவு பிரச்சாரம் செய்ய"
" ஒரு மணித்துளி ஆகலாம்."

msgctxt "toasts.k+-error"
msgid "There was an error when activating your license. Please try again."
msgstr ""
"உங்கள் உரிமத்தை செயல்படுத்தும்போது பிழை ஏற்பட்டது. மீண்டும் முயற்சிக்கவும்."

msgctxt "toasts.k+-delete-key"
msgid ""
"This will only delete Kavita's license key and allow a buy link to show. "
"<b>This will not cancel your subscription!</b> Use Manage to cancel your "
"subscription first."
msgstr ""
"இது கவிதாவின் உரிமச் சாவியை மட்டும் நீக்கி வாங்கும் இணைப்பைக் காட்ட "
"அனுமதிக்கும். <b>இது உங்கள் சந்தாவை ரத்து செய்யாது!</b> முதலில் உங்கள் "
"சந்தாவை ரத்து செய்ய நிர்வகி என்பதைப் பயன்படுத்தவும்."

msgctxt "toasts.k+-reset-key"
msgid ""
"This will invalidate a previous registration using your license and allow "
"you to re-register a Kavita instance."
msgstr ""
"இது உங்கள் உரிமத்தைப் பயன்படுத்தி முந்தைய பதிவை செல்லாது மற்றும் கவிதா "
"நிகழ்வை மீண்டும் பதிவு செய்ய உங்களை அனுமதிக்கும்."

msgctxt "toasts.k+-reset-key-success"
msgid ""
"Your license has been un-registered. Use Edit button to re-register your "
"instance and re-activate Kavita+"
msgstr ""
"உங்கள் உரிமம் பதிவு செய்யப்படவில்லை. உங்கள் நிகழ்வை மீண்டும் பதிவு செய்ய "
"திருத்து பொத்தானைப் பயன்படுத்தவும் மற்றும் கவிதாவை மீண்டும் செயல்படுத்தவும்+"

msgctxt "toasts.library-deleted"
msgid "Library {{name}} has been removed"
msgstr "நூலகம் {{name}} அகற்றப்பட்டது"

msgctxt "toasts.copied-to-clipboard"
msgid "Copied to clipboard"
msgstr "இடைநிலைப்பலகைக்கு நகலெடுக்கப்பட்டது"

msgctxt "toasts.no-next-chapter"
msgid "Could not find next {{entity}}"
msgstr "அடுத்து {{entity}} கண்டுபிடிக்க முடியவில்லை"

msgctxt "toasts.no-prev-chapter"
msgid "Could not find previous {{entity}}"
msgstr "முந்தைய {{entity}} ஐக் கண்டுபிடிக்க முடியவில்லை"

msgctxt "toasts.load-next-chapter"
msgid "Next {{entity}} loaded"
msgstr "அடுத்து {{entity}} ஏற்றப்பட்டது"

msgctxt "toasts.load-prev-chapter"
msgid "Previous {{entity}} loaded"
msgstr "முந்தைய {{entity}} ஏற்றப்பட்டது"

msgctxt "toasts.account-registration-complete"
msgid "Account registration complete"
msgstr "கணக்கு பதிவு முடிந்தது"

msgctxt "toasts.account-migration-complete"
msgid "Account migration complete"
msgstr "கணக்கு இடம்பெயர்வு முடிந்தது"

msgctxt "toasts.password-reset"
msgid "Password reset"
msgstr "கடவுச்சொல் மீட்டமைப்பு"

msgctxt "toasts.password-updated"
msgid "Password has been updated"
msgstr "கடவுச்சொல் புதுப்பிக்கப்பட்டுள்ளது"

msgctxt "toasts.forced-scan-queued"
msgid "A forced scan has been started for {{name}}"
msgstr "{{name} க்கு க்கு கட்டாய ச்கேன் தொடங்கப்பட்டுள்ளது"

msgctxt "toasts.library-created"
msgid "Library created successfully. A scan has been started."
msgstr "நூலகம் வெற்றிகரமாக உருவாக்கப்பட்டது. ஒரு ச்கேன் தொடங்கப்பட்டுள்ளது."

msgctxt "toasts.anilist-token-updated"
msgid "AniList Token has been updated"
msgstr "அனிலிச்ட் கிள்ளாக்கு புதுப்பிக்கப்பட்டுள்ளது"

msgctxt "toasts.age-restriction-updated"
msgid "Age Restriction has been updated"
msgstr "அகவை கட்டுப்பாடு புதுப்பிக்கப்பட்டுள்ளது"

msgctxt "toasts.email-sent-to-no-existing"
msgid ""
"Existing email is not valid. A link has been dumped to logs. Ask admin for "
"link to complete email change."
msgstr ""
"இருக்கும் மின்னஞ்சல் செல்லுபடியாகாது. பதிவுகளுக்கு ஒரு இணைப்பு "
"கொட்டப்பட்டுள்ளது. மின்னஞ்சல் மாற்றத்தை முழுமையான இணைப்பைக் கேளுங்கள்."

msgctxt "toasts.email-sent-to"
msgid "An email has been sent to your old email address for confirmation."
msgstr ""
"உறுதிப்படுத்த உங்கள் பழைய மின்னஞ்சல் முகவரிக்கு மின்னஞ்சல் "
"அனுப்பப்பட்டுள்ளது."

msgctxt "toasts.change-email-no-email"
msgid "Email has been updated"
msgstr "மின்னஞ்சல் புதுப்பிக்கப்பட்டுள்ளது"

msgctxt "toasts.device-updated"
msgid "Device updated"
msgstr "சாதனம் புதுப்பிக்கப்பட்டது"

msgctxt "toasts.device-created"
msgid "Device created"
msgstr "சாதனம் உருவாக்கப்பட்டது"

msgctxt "toasts.delete-device"
msgid "Are you sure you want to delete this device?"
msgstr "இந்த சாதனத்தை நீக்க விரும்புகிறீர்களா?"

msgctxt "toasts.confirm-regen-covers"
msgid ""
"Refresh covers will force all cover images to be recalculated. This is a "
"heavy operation. Are you sure you don't want to perform a Scan instead?"
msgstr ""
"புதுப்பிப்பு கவர்கள் அனைத்து கவர் படங்களையும் மீண்டும் கணக்கிட "
"கட்டாயப்படுத்தும். இது ஒரு கனமான அறுவை மருத்தீடு. அதற்கு பதிலாக நீங்கள் "
"ச்கேன் செய்ய விரும்பவில்லை என்பதில் உறுதியாக இருக்கிறீர்களா?"

msgctxt "toasts.confirm-delete-multiple-series"
msgid ""
"Are you sure you want to delete {{count}} series? It will not modify files "
"on disk."
msgstr ""
"{{count}} தொடரை நீக்க விரும்புகிறீர்களா? இது வட்டில் கோப்புகளை மாற்றாது."

msgctxt "toasts.confirm-delete-multiple-chapters"
msgid ""
"Are you sure you want to delete {{count}} chapter/volumes? It will not "
"modify files on disk."
msgstr ""
"நீங்கள் {{count}} அத்தியாயம்/தொகுதிகளை நீக்க விரும்புகிறீர்களா? இது வட்டில் "
"கோப்புகளை மாற்றாது."

msgctxt "toasts.confirm-delete-multiple-volumes"
msgid ""
"Are you sure you want to delete {{count}} volumes? It will not modify files "
"on disk."
msgstr ""
"{{count}} தொகுதிகளை நிச்சயமாக நீக்க விரும்புகிறீர்களா? இது வட்டில் உள்ள "
"கோப்புகளை மாற்றாது."

msgctxt "toasts.confirm-delete-series"
msgid ""
"Are you sure you want to delete this series? It will not modify files on "
"disk."
msgstr "இந்தத் தொடரை நீக்க விரும்புகிறீர்களா? இது வட்டில் கோப்புகளை மாற்றாது."

msgctxt "toasts.confirm-delete-chapter"
msgid ""
"Are you sure you want to delete this chapter? It will not modify files on "
"disk."
msgstr ""
"இந்த அத்தியாயத்தை நீக்க விரும்புகிறீர்களா? இது வட்டில் கோப்புகளை மாற்றாது."

msgctxt "toasts.confirm-delete-volume"
msgid ""
"Are you sure you want to delete this volume? It will not modify files on "
"disk."
msgstr ""
"இந்த தொகுதியை நீக்க விரும்புகிறீர்களா? இது வட்டில் கோப்புகளை மாற்றாது."

msgctxt "toasts.confirm-delete-auth-key"
msgid "Are you sure you want to delete this Auth Key?"
msgstr "இந்த அங்கீகார விசையை நிச்சயமாக நீக்க விரும்புகிறீர்களா?"

msgctxt "toasts.alert-bad-theme"
msgid ""
"There is invalid or unsafe css in the theme. Please reach out to your admin "
"to have this corrected. Defaulting to dark theme."
msgstr ""
"கருப்பொருளில் தவறான அல்லது பாதுகாப்பற்ற சிஎச்எச் உள்ளது. இதை சரிசெய்ய உங்கள்"
" நிர்வாகியை அணுகவும். இருண்ட கருப்பொருளுக்கு இயல்புநிலை."

msgctxt "toasts.confirm-library-delete"
msgid ""
"Are you sure you want to delete the {{name}} library? You cannot undo this "
"action."
msgstr ""
"{{name}} நூலகத்தை நீக்க விரும்புகிறீர்களா? இந்த செயலை நீங்கள் செயல்தவிர்க்க "
"முடியாது."

msgctxt "toasts.confirm-library-type-change"
msgid ""
"Changing library type will trigger a new scan with different parsing rules "
"and may lead to series being re-created and hence you may lose progress and "
"bookmarks. You should backup before you do this. Are you sure you want to "
"continue?"
msgstr ""
"நூலக வகையை மாற்றுவது வெவ்வேறு பாகுபடுத்தல் விதிகளுடன் ஒரு புதிய ச்கேன் "
"தூண்டும் மற்றும் தொடர் மீண்டும் உருவாக்கப்படுவதற்கு வழிவகுக்கும், எனவே "
"நீங்கள் முன்னேற்றம் மற்றும் புக்மார்க்குகளை இழக்க நேரிடும். இதைச் செய்வதற்கு"
" முன் காப்புப்பிரதி எடுக்க வேண்டும். நீங்கள் தொடர விரும்புகிறீர்களா?"

msgctxt "toasts.confirm-download-size"
msgid "The {{entityType}} is {{size}}. Are you sure you want to continue?"
msgstr "{{entityType}} என்பது {{size}}. நீங்கள் தொடர விரும்புகிறீர்களா?"

msgctxt "toasts.confirm-download-size-ios"
msgid ""
"iOS has issues downloading files that are larger than 200MB, this download "
"might not complete."
msgstr ""
"ஐஇமு க்கு 200MB ஐ விட பெரிய கோப்புகளைப் பதிவிறக்குவதில் சிக்கல்கள் உள்ளன, "
"இந்த பதிவிறக்கம் முடிவடையாது."

msgctxt "toasts.redownload-confirm"
msgid ""
"You've previously downloaded {{title}} on {{date}}. Do you want to "
"redownload?"
msgstr ""
