msgid "OIDC Callback"
msgstr "OIDC திரும்ப அழைக்கவும்"

msgctxt "oidc.login"
msgid "Back to login screen"
msgstr "உள்நுழைவுத் திரைக்குத் திரும்பு"

msgctxt "oidc.error-loading-info"
msgid "An error occurred loading OIDC info, contact your administrator"
msgstr ""
"OIDC தகவலை ஏற்றுவதில் பிழை ஏற்பட்டது, உங்கள் நிர்வாகியைத் தொடர்புகொள்ளவும்"

msgctxt "oidc.timeout"
msgid "OIDC resolution has timed out or an error has occurred"
msgstr "OIDC தீர்மானம் காலாவதியானது அல்லது பிழை ஏற்பட்டது"

msgctxt "manage-oidc-connect.save"
msgid "{{common.save}}"
msgstr "{{common.save}}"

msgctxt "manage-oidc-connect.reset-label"
msgid "Reset ids"
msgstr "ஐடிகளை மீட்டமைக்கவும்"

msgctxt "manage-oidc-connect.reset-tooltip"
msgid ""
"Reset external ids from all users, use this to reset links between users in "
"Kavita and your identity provider"
msgstr ""
"எல்லா பயனர்களிடமிருந்தும் வெளிப்புற ஐடிகளை மீட்டமைக்கவும், கவிதாவில் உள்ள "
"பயனர்களுக்கும் உங்கள் அடையாள வழங்குநருக்கும் இடையிலான இணைப்புகளை மீட்டமைக்க "
"இதைப் பயன்படுத்தவும்"

msgctxt "manage-oidc-connect.reset-confirm"
msgid "Are you certain you want to reset external ids from all users?"
msgstr ""
"எல்லா பயனர்களிடமிருந்தும் வெளிப்புற ஐடிகளை மீட்டமைக்க விரும்புகிறீர்களா?"

msgctxt "manage-oidc-connect.reset-success"
msgid "External ids reset for all users, re-authenticate to link"
msgstr ""
"அனைத்து பயனர்களுக்கும் வெளிப்புற ஐடிகள் மீட்டமைக்கப்பட்டு, இணைப்பிற்கு "
"மீண்டும் அங்கீகரிக்கவும்"

msgctxt "manage-oidc-connect.save-success"
msgid "Successfully updated your OIDC settings"
msgstr "உங்கள் OIDC அமைப்புகள் வெற்றிகரமாக புதுப்பிக்கப்பட்டன"

msgctxt "manage-oidc-connect.notice"
msgid "Notice"
msgstr "கவனிக்கவும்"

msgctxt "manage-oidc-connect.restart-required"
msgid ""
"Changing Provider or advanced settings requires a manual restart of Kavita "
"to take effect."
msgstr ""
"வழங்குநர் அல்லது மேம்பட்ட அமைப்புகளை மாற்றுவதற்கு கவிதாவை கைமுறையாக "
"மறுதொடக்கம் செய்ய வேண்டும்."

msgctxt "manage-oidc-connect.auto-save-required"
msgid "You've changed critical settings, auto save to persist them"
msgstr ""
"முக்கியமான அமைப்புகளை மாற்றியுள்ளீர்கள், அவற்றைத் தொடர தானாகச் சேமிக்கவும்"

msgctxt "manage-oidc-connect.provider-title"
msgid "Provider"
msgstr "வழங்குநர்"

msgctxt "manage-oidc-connect.provider-tooltip"
msgid ""
"Provider settings require you to manually click Save. Kavita must be "
"configured as a confidential client and needs a redirect URL. See the <a "
"href='https://wiki.kavitareader.com/guides/admin-settings/open-id-connect/' "
"target='_blank' rel='noreferrer noopener'>wiki</a> for more details."
msgstr ""
"வழங்குநர் அமைப்புகளுக்கு நீங்கள் சேமி என்பதைக் சொடுக்கு செய்ய வேண்டும். "
"கவிதா ஒரு ரகசிய கிளையண்டாக உள்ளமைக்கப்பட வேண்டும் மேலும் ஒரு வழிமாற்று "
"முகவரி தேவை. மேலும் விவரங்களுக்கு <a "
"href='https://wiki.kavitareader.com/guides/admin-settings/open-id-connect/' "
"target='_blank' rel='noreferrer noopener'>விக்கியைப்</a> பார்க்கவும்."

msgctxt "manage-oidc-connect.behavior-title"
msgid "Behavior"
msgstr "நடத்தை"

msgctxt "manage-oidc-connect.other-field-required"
msgid "{{validation.other-field-required}}"
msgstr "{{validation.other-field-required}}"

msgctxt "manage-oidc-connect.other-field-invalid"
msgid "{{validation.other-field-invalid}}"
msgstr "{{validation.other-field-invalid}}"

msgctxt "manage-oidc-connect.invalid-uri"
msgid "{{validation.invalid-uri}}"
msgstr "{{validation.invalid-uri}}"

msgctxt "manage-oidc-connect.tls-required"
msgid "The OIDC provider must use tls (https)"
msgstr "OIDC வழங்குநர் tls (https) பயன்படுத்த வேண்டும்"

msgctxt "manage-oidc-connect.manual-save-label"
msgid "Changing provider settings requires a manual save"
msgstr "வழங்குநரின் அமைப்புகளை மாற்ற, கைமுறையாகச் சேமிக்க வேண்டும்"

msgctxt "manage-oidc-connect.authority-label"
msgid "Authority"
msgstr "அதிகாரம்"

msgctxt "manage-oidc-connect.authority-tooltip"
msgid ""
"The URL to your OIDC provider, do not include the .well-known/openid-"
"configuration path"
msgstr ""
"உங்கள் OIDC வழங்குநருக்கான URL, .well-known/openid-configuration பாதையை "
"சேர்க்க வேண்டாம்"

msgctxt "manage-oidc-connect.client-id-label"
msgid "Client ID"
msgstr "வாடிக்கையாளர் அடையாளம்"

msgctxt "manage-oidc-connect.client-id-tooltip"
msgid "The ClientID set in your OIDC provider, can be anything"
msgstr ""
"உங்கள் OIDC வழங்குநரில் ClientID அமைக்கப்பட்டுள்ளது, எதுவாகவும் இருக்கலாம்"

msgctxt "manage-oidc-connect.secret-label"
msgid "Client secret"
msgstr "வாடிக்கையாளர் மறைபொருள்"

msgctxt "manage-oidc-connect.secret-tooltip"
msgid ""
"The secret as generated by your OIDC provider, will not be shown after being"
" set"
msgstr ""
"உங்கள் OIDC வழங்குநரால் உருவாக்கப்பட்ட மறைபொருள், அமைக்கப்பட்ட பிறகு "
"காட்டப்படாது"

msgctxt "manage-oidc-connect.provision-accounts-label"
msgid "Provision accounts"
msgstr "ஒதுக்கீடு கணக்குகள்"

msgctxt "manage-oidc-connect.provision-accounts-tooltip"
msgid ""
"Auto-create a new account when logging in via OIDC if it can't be matched to"
" an existing one"
msgstr ""
"OIDC மூலம் உள்நுழையும்போது, ​​ஏற்கனவே உள்ள கணக்குடன் பொருத்த முடியாவிட்டால்,"
" புதிய கணக்கைத் தானாக உருவாக்கவும்"

msgctxt "manage-oidc-connect.require-verified-email-label"
msgid "Require verified emails"
msgstr "சரிபார்க்கப்பட்ட மின்னஞ்சல்கள் தேவை"

msgctxt "manage-oidc-connect.require-verified-email-tooltip"
msgid ""
"Requires email verification when creating a new account or matching with an "
"existing one. If a newly created account has a verified email, it will be "
"automatically verified on Kavita's side."
msgstr ""
"புதிய கணக்கை உருவாக்கும் போது அல்லது ஏற்கனவே உள்ள கணக்குடன் பொருந்தும்போது "
"மின்னஞ்சல் சரிபார்ப்பு தேவைப்படுகிறது. புதிதாக உருவாக்கப்பட்ட கணக்கில் "
"சரிபார்க்கப்பட்ட மின்னஞ்சல் இருந்தால், அது கவிதாவின் பக்கத்தில் தானாகவே "
"சரிபார்க்கப்படும்."

msgctxt "manage-oidc-connect.sync-user-settings-label"
msgid "Sync user settings with OIDC roles"
msgstr "OIDC பாத்திரங்களுடன் பயனர் அமைப்புகளை ஒத்திசைக்கவும்"

msgctxt "manage-oidc-connect.sync-user-settings-tooltip"
msgid ""
"Users created via OIDC will be fully managed by the identity provider, "
"including roles, library access, and age rating. If this option is disabled,"
" users will not have access to any content after account creation. Refer to "
"the documentation for more details."
msgstr ""
"OIDC மூலம் உருவாக்கப்பட்ட பயனர்கள், பாத்திரங்கள், நூலக அணுகல் மற்றும் அகவை "
"மதிப்பீடு உள்ளிட்ட அடையாள வழங்குநரால் முழுமையாக நிர்வகிக்கப்படுவார்கள். இந்த"
" விருப்பம் முடக்கப்பட்டால், கணக்கை உருவாக்கிய பிறகு பயனர்கள் எந்த "
"உள்ளடக்கத்தையும் அணுக முடியாது. மேலும் விவரங்களுக்கு ஆவணங்களைப் பார்க்கவும்."

msgctxt "manage-oidc-connect.auto-login-label"
msgid "Auto login"
msgstr "தானியங்கு உள்நுழைவு"

msgctxt "manage-oidc-connect.auto-login-tooltip"
msgid "Auto redirect to OIDC provider when opening the login screen"
msgstr ""
"உள்நுழைவுத் திரையைத் திறக்கும்போது OIDC வழங்குநருக்குத் தானாகத் "
"திருப்பிவிடப்படும்"

msgctxt "manage-oidc-connect.disable-password-authentication-label"
msgid "Disable password authentication"
msgstr "கடவுச்சொல் அங்கீகாரத்தை முடக்கு"

msgctxt "manage-oidc-connect.disable-password-authentication-tooltip"
msgid "Users with the admin role can bypass this restriction"
msgstr ""
"நிர்வாகப் பொறுப்பைக் கொண்ட பயனர்கள் இந்தக் கட்டுப்பாட்டைத் தவிர்க்கலாம்"

msgctxt "manage-oidc-connect.provider-name-label"
msgid "Provider name"
msgstr "வழங்குநர் பெயர்"

msgctxt "manage-oidc-connect.provider-name-tooltip"
msgid "Name shown on the login screen"
msgstr "உள்நுழைவுத் திரையில் பெயர் காட்டப்பட்டுள்ளது"

msgctxt "manage-oidc-connect.defaults-title"
msgid "Defaults"
msgstr "இயல்புநிலைகள்"

msgctxt "manage-oidc-connect.defaults-requirement"
msgid ""
"The following settings are used when a user is registered via OIDC while "
"Sync User Settings is turned off"
msgstr ""
"பயனர் OIDC வழியாகப் பதிவு செய்யும் போது, ​​ஒத்திசைவு பயனர் அமைப்புகள் "
"முடக்கப்பட்டிருக்கும் போது பின்வரும் அமைப்புகள் பயன்படுத்தப்படும்"

msgctxt "manage-oidc-connect.default-include-unknowns-label"
msgid "Include unknowns"
msgstr "தெரியாதவற்றைச் சேர்க்கவும்"

msgctxt "manage-oidc-connect.default-include-unknowns-tooltip"
msgid "Include unknown age ratings"
msgstr "அறியப்படாத அகவை மதிப்பீடுகளைச் சேர்க்கவும்"

msgctxt "manage-oidc-connect.default-age-restriction-label"
msgid "Age rating"
msgstr "அகவை மதிப்பீடு"

msgctxt "manage-oidc-connect.default-age-restriction-tooltip"
msgid "Maximum age rating shown to new users"
msgstr "புதிய பயனர்களுக்குக் காட்டப்படும் அதிகபட்ச அகவை மதிப்பீடு"

msgctxt "manage-oidc-connect.no-restriction"
msgid "{{restriction-selector.no-restriction}}"
msgstr "{{restriction-selector.no-restriction}}"

msgctxt "manage-oidc-connect.default-roles-label"
msgid "{{common.roles}}"
msgstr "{{common.roles}}"

msgctxt "manage-oidc-connect.default-libraries-label"
msgid "{{common.libraries}}"
msgstr "{{common.libraries}}"

msgctxt "manage-oidc-connect.advanced-title"
msgid "Advanced settings"
msgstr "மேம்பட்ட அமைப்புகள்"

msgctxt "manage-oidc-connect.advanced-tooltip"
msgid "Only modify these options if you understand their impact."
msgstr ""
"இந்த விருப்பங்களின் தாக்கத்தை நீங்கள் புரிந்து கொண்டால் மட்டுமே மாற்றவும்."

msgctxt "manage-oidc-connect.roles-prefix-label"
msgid "Roles prefix"
msgstr "பாத்திரங்களின் முன்னொட்டு"

msgctxt "manage-oidc-connect.roles-prefix-tooltip"
msgid "Kavita will only consider roles that start with this prefix."
msgstr ""
"இந்த முன்னொட்டுடன் தொடங்கும் பாத்திரங்களை மட்டுமே கவிதா கருத்தில் கொள்வார்."

msgctxt "manage-oidc-connect.roles-claim-label"
msgid "Roles claim"
msgstr "பாத்திரங்கள் கோருகின்றன"

msgctxt "manage-oidc-connect.roles-claim-tooltip"
msgid ""
"The claim Kavita will use to extract roles. Leave blank to use the default."
msgstr ""
"பாத்திரங்களைப் பிரித்தெடுக்க கவிதா பயன்படுத்தும் உரிமைகோரல். இயல்புநிலையைப் "
"பயன்படுத்த, காலியாக விடவும்."

msgctxt "manage-oidc-connect.custom-scopes-label"
msgid "Custom scopes"
msgstr "தனிப்பயன் நோக்கங்கள்"

msgctxt "manage-oidc-connect.custom-scopes-tooltip"
msgid ""
"Additional scopes to request from your OIDC provider during login. Separate "
"multiple scopes with commas. Incorrect values may prevent login."
msgstr ""
"உள்நுழைவின் போது உங்கள் OIDC வழங்குநரிடமிருந்து கோருவதற்கான கூடுதல் "
"நோக்கங்கள். பல நோக்கங்களை காற்புள்ளிகளால் பிரிக்கவும். தவறான மதிப்புகள் "
"உள்நுழைவைத் தடுக்கலாம்."

msgctxt "manage-auth-keys.auth-keys-title"
msgid "Manage Authorization Keys"
msgstr "அங்கீகார விசைகளை நிர்வகிக்கவும்"

