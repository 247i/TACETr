msgctxt "reread-modal.title"
msgid "Re-Read"
msgstr "மீண்டும் படிக்கவும்"

msgctxt "reread-modal.description-full-read"
msgid "You've already finished {{name}}! Would you like to start over?"
msgstr ""
"நீங்கள் ஏற்கனவே {{name}} முடித்துவிட்டீர்கள்! நீங்கள் மீண்டும் தொடங்க "
"விரும்புகிறீர்களா?"

msgctxt "reread-modal.description-time-passed"
msgid ""
"It has been {{days}} days since you've last read {{name}}, need a refresher?"
msgstr ""
"நீங்கள் கடைசியாக {{days}} ஐப் படித்து {{name}} நாட்கள் ஆகின்றன, "
"புதுப்பித்தல் வேண்டுமா?"

msgctxt "reread-modal.continue"
msgid "Pick up where you left off"
msgstr "நீங்கள் விட்ட இடத்திலிருந்து எடுங்கள்"

msgctxt "reread-modal.reread"
msgid "Start Over"
msgstr "மீண்டும் தொடங்குங்கள்"

msgctxt "reread-modal.cancel"
msgid "{{common.cancel}}"
msgstr "{{common.cancel}}"

msgctxt "reread-modal.read-incognito"
msgid "Read incognito"
msgstr "மறைநிலையில் படிக்கவும்"

msgctxt "multi-check-box-form.select-all"
msgid "Select all"
msgstr "அனைத்தையும் தெரிவுசெய்"

msgctxt "multi-check-box-form.deselect-all"
msgid "Deselect all"
msgstr "அனைத்தையும் தேர்வுநீக்கவும்"

msgctxt "multi-check-box-form.no-data"
msgid "{{typeahead.no-data}}"
msgstr "{{typeahead.no-data}}"

msgctxt "user-holds.title"
msgid "Scrobble Holds"
msgstr "ச்க்ரோபில் வைத்திருக்கிறது"

msgctxt "user-holds.description"
msgid ""
"This is a user-managed list of Series that will not be scrobbled to upstream"
" providers. You can remove a series at any time and the next scrobble-able "
"event (reading progress, rating, want to read status) will trigger "
"scrobbling."
msgstr ""
"இது பயனர்களால் நிர்வகிக்கப்படும் தொடர்களின் பட்டியல் ஆகும், இது மேலோடை "
"வழங்குநர்களுக்கு ச்க்ரோபிள் செய்யப்படாது. நீங்கள் எந்த நேரத்திலும் ஒரு தொடரை"
" அகற்றலாம் மற்றும் அடுத்த ச்க்ரோபிள் செய்யக்கூடிய நிகழ்வு (படிக்கும் "
"முன்னேற்றம், மதிப்பீடு, நிலையைப் படிக்க விரும்புதல்) ச்க்ரோப்பிங்கைத் "
"தூண்டும்."

msgctxt "user-holds.no-data"
msgid "{{typeahead.no-data}}"
msgstr "{{typeahead.no-data}}}"

msgctxt "user-holds.series-name-header"
msgid "{{manage-matched-metadata.series-name-header}}"
msgstr "{{manage-matched-metadata.series-name-header}}"

msgctxt "user-holds.created-header"
msgid "{{manage-media-issues.created-header}}"
msgstr "{{manage-media-issues.created-header}}"

msgctxt "user-holds.delete-label"
msgid "{{common.remove}}"
msgstr "{{common.remove}}"

msgctxt "theme-manager.description"
msgid ""
"Kavita comes in many colors, find a color scheme that meets your needs or "
"build one yourself and share it. Themes may be applied for your account or "
"applied to all accounts."
msgstr ""
"கவிதா பல வண்ணங்களில் வருகிறது, உங்கள் தேவைகளைப் நிறைவு செய்யும் வண்ணத் "
"திட்டத்தைக் கண்டறியவும் அல்லது அதை நீங்களே உருவாக்கி பகிர்ந்து கொள்ளவும். "
"உங்கள் கணக்கிற்கு தீம்கள் பயன்படுத்தப்படலாம் அல்லது எல்லா கணக்குகளுக்கும் "
"பயன்படுத்தப்படலாம்."

msgctxt "theme-manager.set-default"
msgid "Set Default"
msgstr "இயல்புநிலையை அமைக்கவும்"

msgctxt "theme-manager.default-theme"
msgid "Default"
msgstr "இயல்புநிலை"

msgctxt "theme-manager.download"
msgid "{{changelog.download}}"
msgstr "{{changelog.download}}}"

msgctxt "theme-manager.downloaded"
msgid "Downloaded"
msgstr "பதிவிறக்கம்"

msgctxt "theme-manager.downloadable"
msgid "Downloadable"
msgstr "பதிவிறக்கம் செய்யக்கூடியது"

msgctxt "theme-manager.apply"
msgid "{{common.apply}}"
msgstr "{{common.apply}}}"

msgctxt "theme-manager.applied"
msgid "Applied"
msgstr "பயன்படுத்தப்பட்டது"

msgctxt "theme-manager.active-theme"
msgid "Active"
