#, java-printf-format
msgctxt "microg_installer_desc"
msgid "Helps you bypass App Integrity (installer only) check"
msgstr "ஆப் ஒருமைப்பாடு (நிறுவுபவர் மட்டும்) சரிபார்ப்பைத் தவிர்க்க உதவுகிறது"

