#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.UserId"
msgid "UserId"
msgstr "பயனர்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.UserIdSegmentHelp"
msgid ""
"any non empty unique string identifying the user (such as an email address "
"or a username)."
msgstr ""
"பயனரை அடையாளம் காணும் காலியாக இல்லாத தனிப்பட்ட சரம் (மின்னஞ்சல் முகவரி "
"அல்லது பயனர் பெயர் போன்றவை)."

#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.UserReportTitle"
msgid "User IDs"
msgstr "பாவனையாளர்கள்"

#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.UserReportDocumentation"
msgid "Shows visits and other general metrics for every individual User ID."
msgstr ""
"ஒவ்வொரு தனிப்பட்ட பயனர் ஐடிக்கும் வருகைகள் மற்றும் பிற பொதுவான அளவீடுகளைக் "
"காட்டுகிறது."

#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.PluginDescription"
msgid "Shows user reports"
msgstr "பயனர் அறிக்கைகளைக் காட்டுகிறது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.VisitorsUserSubcategoryHelp"
msgid ""
"The user ID report shows visits associated with all your registered and "
"logged in users. Understand website usage by its specific users and find out"
" who your most and least active users are."
msgstr ""
"பயனர் ஐடி அறிக்கை உங்கள் பதிவுசெய்யப்பட்ட மற்றும் பயனர்கள் பதிவுசெய்யப்பட்ட "
"அனைத்து வருகைகளையும் காட்டுகிறது. வலைத்தள பயன்பாட்டை அதன் குறிப்பிட்ட "
"பயனர்களால் புரிந்துகொண்டு, உங்கள் மிக மற்றும் குறைந்த செயலில் உள்ள பயனர்கள் "
"யார் என்பதைக் கண்டறியவும்."

#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.ThereIsNoDataForThisReportHelp"
msgid ""
"%1$sRead the user guide to learn how to generate data for this report.%2$s"
msgstr ""
"%1$sஇந்த அறிக்கைக்கு தகவல்களை உருவாக்குவது எப்படி என்பதை அறிய பயனர் "
"வழிகாட்டியை வாசிக்கவும்.%2$s"

#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.UserIdDisabledSettingTitle"
msgid "User ID disabled"
msgstr "பயனர் அடையாளம் முடக்கப்பட்டுள்ளது"

#, ignore-optional-plural, php-format, safe-html
msgctxt "UserId.UserIdDisabledSettingRequirementNote"
msgid "Collection of User ID while tracking must be disabled."
msgstr "கண்காணிப்பின் போது பயனர் அடையாளம் சேகரிப்பு முடக்கப்பட வேண்டும்."
