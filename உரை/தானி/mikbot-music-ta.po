msgstr "தற்போதைய பாடல் இனி ரிபீட் ஆகாது!"

#, auto-java-messageformat
msgctxt "commands.loop_queue.enabled"
msgid "The queue is now looped"
msgstr "வரிசை இப்போது வளையப்பட்டுள்ளது"

#, auto-java-messageformat
msgctxt "commands.loop_queue.disabled"
msgid "The queue is no longer looped"
msgstr "வரிசை இனி வளையவில்லை"

#, auto-java-messageformat
msgctxt "commands.shuffle.enabled"
msgid "The songs are now played shuffled"
msgstr "பாடல்கள் இப்போது கலக்கப்பட்டு ஒலிக்கப்படுகின்றன"

#, auto-java-messageformat
msgctxt "commands.shuffle.disabled"
