msgstr "முதலில் குரல் சேனலுடன் இணைக்கவும்"

#, auto-java-messageformat
msgctxt "music.checks.not_in_same_vc"
msgid "You're not in my VC, which makes me feel lonely."
msgstr "நீங்கள் என் விசியில் இல்லை, இது என்னை தனிமையாக உணர்கிறது."

#, auto-java-messageformat
msgctxt "music.checks.already_in_use"
msgid "Other people seem to be using the bot right now."
msgstr "மற்றவர்கள் இப்போது போட்டைப் பயன்படுத்துவதாகத் தெரிகிறது."

#, auto-java-messageformat
msgctxt "music.checks.no_running"
