# Suggested in Weblate: பாதுகாப்பு
#, i18next-interpolation, ignore-inconsistent
msgctxt "header"
msgid "Security"
msgstr "பாதுகாப்பு"

# Suggested in Weblate: பயன்பாட்டு பூட்டு
#, i18next-interpolation, ignore-inconsistent
msgctxt "applock.title"
msgid "App lock"
msgstr "பயன்பாட்டு பூட்டு"

#, i18next-interpolation, ignore-inconsistent
msgctxt "applock.desc"
msgid "Lock the application with a password"
msgstr "கடவுச்சொல் மூலம் பயன்பாட்டைப் பூட்டவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "biometrics.title"
msgid "Use biometrics"
msgstr "பயோமெட்ரிக்சைப் பயன்படுத்தவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "biometrics.desc"
msgid "Unlock via your fingerprint or face"
msgstr "உங்கள் கைரேகை அல்லது முகம் வழியாகத் திறக்கவும்"

#, i18next-interpolation
msgctxt "allowRemoteContent.title"
msgid "Allow remote content"
msgstr "தொலைநிலை உள்ளடக்கத்தை அனுமதிக்கவும்"

#, i18next-interpolation
msgctxt "allowRemoteContent.desc"
msgid ""
"Allow Ampersand to use the Internet to query remote content, such as images "
"in Markdown fields and avatars in third-party imports."
msgstr ""
"மார்க் பேரூர் புலங்களில் உள்ள படங்கள் மற்றும் மூன்றாம் தரப்பு இறக்குமதிகளில்"
" உள்ள அவதாரங்கள் போன்ற தொலைநிலை உள்ளடக்கத்தை வினவுவதற்கு இணையத்தைப் "
"பயன்படுத்த ஆம்பர்சண்டை அனுமதிக்கவும்."

# Suggested in Weblate: எச்சரிக்கை
#, i18next-interpolation
msgctxt "passwordAlert.header"
msgid "Warning"
msgstr "எச்சரிக்கை"

#, i18next-interpolation
msgctxt "passwordAlert.text"
msgid ""
"Are you sure you want to proceed? Before proceeding, please note down your "
"password somewhere outside Ampersand as you won't be able to recover your "
"data or reset your password if you lose it. Be sure to export your data "
"before setting one!"
msgstr ""
"நீங்கள் நிச்சயமாக தொடர விரும்புகிறீர்களா? தொடர்வதற்கு முன், உங்கள் "
"கடவுச்சொல்லை அம்பர்சாண்டுக்கு வெளியே எங்காவது பதிவு செய்யவும், ஏனெனில் "
"உங்கள் தரவை மீட்டெடுக்கவோ அல்லது கடவுச்சொல்லை இழந்தால் அதை மீட்டமைக்கவோ "
"முடியாது. ஒன்றை அமைப்பதற்கு முன் உங்கள் தரவை ஏற்றுமதி செய்ய மறக்காதீர்கள்!"

#, i18next-interpolation, ignore-inconsistent
msgctxt "editPassword"
msgid "Modify password"
msgstr "கடவுச்சொல்லை மாற்றவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "inputPassword.titleAdd"
msgid "Enter your new password"
msgstr "உங்கள் புதிய கடவுச்சொல்லை உள்ளிடவும்"

#, i18next-interpolation
msgctxt "inputPassword.titleReenter"
msgid "Reenter password"
msgstr "கடவுச்சொல்லை மீண்டும் உள்ளிடவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "inputPassword.titleModifyOld"
msgid "Enter your old password"
msgstr "உங்கள் பழைய கடவுச்சொல்லை உள்ளிடவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "inputPassword.titleModifyNew"
msgid "Enter your new password"
msgstr "உங்கள் புதிய கடவுச்சொல்லை உள்ளிடவும்"

# Suggested in Weblate: உங்கள் கடவுச்சொல்லை உள்ளிடவும்
#, i18next-interpolation, ignore-inconsistent
msgctxt "inputPassword.titleDisable"
msgid "Enter your password"
msgstr "உங்கள் கடவுச்சொல்லை உள்ளிடவும்"

# Suggested in Weblate: கடவுச்சொல்
#, i18next-interpolation, ignore-inconsistent
msgctxt "inputPassword.hint"
msgid "Password"
msgstr "கடவுச்சொல்"

#, i18next-interpolation
msgctxt "useIPC"
msgid "Send events to other applications"
msgstr "பிற பயன்பாடுகளுக்கு நிகழ்வுகளை அனுப்பவும்"
