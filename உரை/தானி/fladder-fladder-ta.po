msgstr "டாச்போர்டிலிருந்து மறைக்கப்பட்ட நூலகங்களைச் சேர்க்கவும்"

#, icu-message-format
msgctxt "settingsBlurEffectsTitle"
msgid "Enable blur effects"
msgstr "மங்கலான விளைவுகளை இயக்கு"

#, icu-message-format
msgctxt "settingsBlurEffectsDesc"
msgid ""
"Enable blur effects in the UI. Disabling this can improve performance on "
"lower-end devices."
msgstr ""
"இடைமுகம் இல் மங்கலான விளைவுகளை இயக்கவும். இதை முடக்குவது குறைந்த-இறுதி "
"சாதனங்களில் செயல்திறனை மேம்படுத்தலாம்."

#, icu-message-format
msgctxt "profileSettingsOpenAuthAtLaunch"
msgid "Show auth-method on app lock"
msgstr "பயன்பாட்டு பூட்டில் அங்கீகார முறையைக் காட்டு"

#, icu-message-format
msgctxt "toggleSidebar"
msgid "Toggle sidebar"
msgstr "பக்கப்பட்டியை மாற்றவும்"

#. Message shown when a media item is successfully requested
#, case-insensitive, icu-message-format, placeholders:$ITEMNAME$
msgctxt "requestedSuccessForItem"
msgid "Successfully requested {itemName}"
msgstr "{itemName} வெற்றிகரமாக கோரப்பட்டது"

#, icu-message-format
msgctxt "linkData"
msgid "Link data"
msgstr "இணைப்பு தரவு"

#, icu-message-format
msgctxt "passwordNotRequired"
msgid "Not required, leave empty to not include password in the link"
msgstr "தேவையில்லை, இணைப்பில் கடவுச்சொல்லை சேர்க்காமல் இருக்க காலியாக விடவும்"

#, icu-message-format
msgctxt "authLinkButtonToolTip"
msgid "Open auth link dialog"
msgstr "அங்கீகார இணைப்பு உரையாடலைத் திறக்கவும்"

#, icu-message-format
msgctxt "connectWithAuthLink"
msgid "Connect with auth link"
msgstr "அங்கீகார இணைப்புடன் இணைக்கவும்"

#, icu-message-format
msgctxt "pasteFladderAuthLink"
msgid "Paste fladder auth link fladder:///login?authLink=..."
msgstr "flutter auth இணைப்பை ஒட்டவும் flutter:///login?authLink=..."

#, icu-message-format
msgctxt "connect"
msgid "Connect"
msgstr "இணை"

#, icu-message-format
msgctxt "authLinkDesc"
msgid ""
"Ask the server admin to provide the auth link. The link contains "
"authentication information, so be sure to keep it secure."
msgstr ""
"அங்கீகார இணைப்பை வழங்க சர்வர் நிர்வாகியிடம் கேளுங்கள். இணைப்பில் "
"அங்கீகரிப்புத் செய்தி உள்ளது, எனவே அதைப் பாதுகாப்பாக வைத்திருக்கவும்."

#. Message shown when a item is deleted
#, case-insensitive, icu-message-format, placeholders:$ITEMNAME$
msgctxt "deletedItem"
msgid "Deleted {itemName}"
msgstr "{itemName} நீக்கப்பட்டது"

#, icu-message-format
msgctxt "libraryOrderTitle"
msgid "Home Screen Order"
msgstr "முகப்புத் திரை வரிசை"

#, icu-message-format
msgctxt "libraryOrderDescription"
msgid ""
"Drag to reorder libraries on the home screen. Unchecked libraries won't show"
" recently added items."
msgstr ""
"முகப்புத் திரையில் நூலகங்களை மறுவரிசைப்படுத்த இழுக்கவும். தேர்வு செய்யப்படாத"
" நூலகங்கள் அண்மைக் காலத்தில் சேர்க்கப்பட்ட உருப்படிகளைக் காட்டாது."

#, icu-message-format
msgctxt "hidePlayedInLatestTitle"
msgid "Hide watched content"
msgstr "பார்த்த உள்ளடக்கத்தை மறை"

#, icu-message-format
msgctxt "hidePlayedInLatestDescription"
msgid "Hide watched content from 'Recently Added Media'"
msgstr ""
"'அண்மைக் காலத்தில் சேர்க்கப்பட்ட மீடியா' இலிருந்து பார்த்த உள்ளடக்கத்தை மறை"

#, icu-message-format
msgctxt "groupedFoldersTitle"
msgid "Grouped Libraries"
msgstr "தொகுக்கப்பட்ட நூலகங்கள்"

#, icu-message-format
msgctxt "groupedFoldersDescription"
msgid ""
"Automatically group content from the following libraries into views such as "
"'Movies', 'Music' and 'TV'."
msgstr ""
"பின்வரும் நூலகங்களிலிருந்து உள்ளடக்கத்தை 'திரைப்படங்கள்', 'இசை' மற்றும் "
"'டிவி' போன்ற காட்சிகளாகத் தானாகவே குழுவாக்கவும்."

#, icu-message-format
msgctxt "downloadTranscoded"
msgid "Download transcoded"
msgstr "பதிவிறக்கம் குறியிடப்பட்டது"

#, icu-message-format
msgctxt "downloadOriginal"
msgid "Download original"
msgstr "அசல் பதிவிறக்க"

