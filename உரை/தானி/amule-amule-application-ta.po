#: src/muuli_wdr.cpp:1405
msgid "Kademlia"
msgstr "கடெம்லியா"

#: src/muuli_wdr.cpp:1408 src/muuli_wdr.cpp:2885
msgid "ED2K"
msgstr "ED2K"

#: src/muuli_wdr.cpp:1415
msgid "Autoconnect on startup"
msgstr "தொடக்கத்தில் தானாக இணைக்கவும்"

#: src/muuli_wdr.cpp:1418
msgid "Reconnect on loss"
msgstr "இழப்பில் மீண்டும் இணைக்கவும்"

#: src/muuli_wdr.cpp:1440
msgid "Remove dead server after"
msgstr "இறந்த சர்வரை அகற்றவும்"

#: src/muuli_wdr.cpp:1444
msgid "retries"
msgstr "மீண்டும் முயற்சிக்கிறது"

#: src/muuli_wdr.cpp:1449
msgid "Auto-update server list at startup"
msgstr "தொடக்கத்தில் சேவையகப் பட்டியலைத் தானாகப் புதுப்பிக்கவும்"

#: src/muuli_wdr.cpp:1452
msgid "List"
msgstr "பட்டியல்"

#: src/muuli_wdr.cpp:1455
msgid "Update server list when connecting to a server"
msgstr "சேவையகத்துடன் இணைக்கும்போது சர்வர் பட்டியலைப் புதுப்பிக்கவும்"

#: src/muuli_wdr.cpp:1458
msgid "Update server list when a client connects"
msgstr "கிளையன்ட் இணைக்கும்போது சர்வர் பட்டியலைப் புதுப்பிக்கவும்"

#: src/muuli_wdr.cpp:1461
msgid "Use priority system"
msgstr "முன்னுரிமை முறையைப் பயன்படுத்தவும்"

#: src/muuli_wdr.cpp:1465
msgid "Use smart LowID check on connect"
msgstr "இணைப்பில் அறிவுள்ள லோஐடி சோதனையைப் பயன்படுத்தவும்"

#: src/muuli_wdr.cpp:1469
msgid "Safe connect"
msgstr "பாதுகாப்பான இணைப்பு"

#: src/muuli_wdr.cpp:1473
msgid "Autoconnect to servers in static list only"
msgstr "நிலையான பட்டியலில் உள்ள சேவையகங்களுடன் மட்டும் தானாக இணைக்கவும்"

#: src/muuli_wdr.cpp:1476
msgid "Set manually added servers to High Priority"
msgstr "கைமுறையாக சேர்க்கப்பட்ட சேவையகங்களை அதிக முன்னுரிமைக்கு அமைக்கவும்"

#: src/muuli_wdr.cpp:1494
msgid "Intelligent Corruption Handling (I.C.H.)"
msgstr "புத்திசாலித்தனமான ஊழல் கையாளுதல் (I.C.H.)"

#: src/muuli_wdr.cpp:1497
msgid "Enable"
msgstr "இயக்கு"

#: src/muuli_wdr.cpp:1500
msgid "Advanced I.C.H. trusts every hash (not recommended)"
msgstr "மேம்பட்ட I.C.H. ஒவ்வொரு ஆசையும் நம்புகிறது (பரிந்துரைக்கப்படவில்லை)"

#: src/muuli_wdr.cpp:1507
msgid "Add files to download in pause mode"
msgstr "இடைநிறுத்தப் பயன்முறையில் பதிவிறக்க கோப்புகளைச் சேர்க்கவும்"

#: src/muuli_wdr.cpp:1509
msgid "Add files to download with auto priority"
msgstr "தானியங்கு முன்னுரிமையுடன் பதிவிறக்க கோப்புகளைச் சேர்க்கவும்"

#: src/muuli_wdr.cpp:1512
msgid "Try to download first and last chunks first"
msgstr "முதல் மற்றும் கடைசி பகுதிகளை முதலில் பதிவிறக்க முயற்சிக்கவும்"

#: src/muuli_wdr.cpp:1515
msgid "Start next paused file when a file completes"
msgstr "ஒரு கோப்பு முடிந்ததும் அடுத்த இடைநிறுத்தப்பட்ட கோப்பைத் தொடங்கவும்"

#: src/muuli_wdr.cpp:1518
msgid "From the same category"
msgstr "அதே வகையைச் சேர்ந்தவர்"

#: src/muuli_wdr.cpp:1520
msgid "In alphabetic order"
msgstr "அகரவரிசையில்"

#: src/muuli_wdr.cpp:1522
msgid "Preallocate disk space for new files"
msgstr "புதிய கோப்புகளுக்கு வட்டு இடத்தை முன்கூட்டியே ஒதுக்கவும்"

#: src/muuli_wdr.cpp:1523
msgid ""
"For new files preallocates disk space for the whole file, thus reduces "
"fragmentation"
msgstr ""
"புதிய கோப்புகளுக்கு, முழு கோப்பிற்கும் வட்டு இடத்தை முன்கூட்டியே "
"ஒதுக்குகிறது, இதனால் துண்டு துண்டாக குறைக்கப்படுகிறது"

#: src/muuli_wdr.cpp:1528
msgid "Stop downloads when free disk space reaches "
msgstr "இலவச வட்டு இடத்தை அடையும் போது பதிவிறக்கங்களை நிறுத்தவும்"

#: src/muuli_wdr.cpp:1529
msgid "Select this if you want aMule to check your disk space"
msgstr ""
"உங்கள் வட்டு இடத்தை aMule சரிபார்க்க விரும்பினால் இதைத் தேர்ந்தெடுக்கவும்"

#: src/muuli_wdr.cpp:1533
msgid "Enter here the min disk space desired."
msgstr "இங்கு தேவையான நிமிட வட்டு இடத்தை உள்ளிடவும்."

#: src/muuli_wdr.cpp:1539
msgid "Save 10 sources on rare files (< 20 sources)"
msgstr "அரிதான கோப்புகளில் 10 ஆதாரங்களைச் சேமிக்கவும் (< 20 ஆதாரங்கள்)"

#: src/muuli_wdr.cpp:1543 src/Statistics.cpp:796
msgid "Uploads"
msgstr "பதிவேற்றங்கள்"

#: src/muuli_wdr.cpp:1546
msgid "Add new shared files with auto priority"
msgstr "தானியங்கு முன்னுரிமையுடன் புதிய பகிரப்பட்ட கோப்புகளைச் சேர்க்கவும்"

#: src/muuli_wdr.cpp:1563
msgid "Destination folder for downloads"
msgstr "பதிவிறக்கங்களுக்கான இலக்கு கோப்புறை"

#: src/muuli_wdr.cpp:1567
msgid ""
"Completed downloads are stored here. All files in this folder are automatically shared with other peers.\n"
"If this folder also holds files you don't want to share, point it at an aMule-only sub-folder."
msgstr ""
"முடிக்கப்பட்ட பதிவிறக்கங்கள் இங்கே சேமிக்கப்படும். இந்தக் கோப்புறையில் உள்ள எல்லா கோப்புகளும் மற்ற நண்பர்களுடன் தானாகவே பகிரப்படும். \n"
"இந்த கோப்புறையில் நீங்கள் பகிர விரும்பாத கோப்புகள் இருந்தால், அதை aMule-மட்டும் துணை கோப்புறையில் சுட்டிக்காட்டவும்."

#: src/muuli_wdr.cpp:1570
msgid ""
"Pick the folder where completed downloads will be stored. All files in that "
"folder will be shared with other peers."
msgstr ""
"நிறைவு செய்யப்பட்ட பதிவிறக்கங்கள் சேமிக்கப்படும் கோப்புறையைத் "
"தேர்ந்தெடுக்கவும். அந்த கோப்புறையில் உள்ள அனைத்து கோப்புகளும் மற்ற "
"நண்பர்களுடன் பகிரப்படும்."

#: src/muuli_wdr.cpp:1574
msgid "(All files in this folder are shared with other peers)"
msgstr ""
"(இந்தக் கோப்புறையில் உள்ள எல்லா கோப்புகளும் மற்ற நண்பர்களுடன் பகிரப்படும்)"

#: src/muuli_wdr.cpp:1576
msgid "Folder for temporary download files"
msgstr "தற்காலிக பதிவிறக்க கோப்புகளுக்கான கோப்புறை"

#: src/muuli_wdr.cpp:1584
msgid "Shared folders"
msgstr "பகிரப்பட்ட கோப்புறைகள்"

#: src/muuli_wdr.cpp:1587
msgid "(Right click on folder icon for recursive share)"
msgstr "(சுழற்சி பகிர்வுக்கு கோப்புறை ஐகானில் வலது சொடுக்கு செய்யவும்)"

#: src/muuli_wdr.cpp:1593
msgid "Share hidden files"
msgstr "மறைக்கப்பட்ட கோப்புகளைப் பகிரவும்"

#: src/muuli_wdr.cpp:1599
msgid "Automatically rescan shared folders for changes"
msgstr "மாற்றங்களுக்காக பகிரப்பட்ட கோப்புறைகளை தானாக மீண்டும் வருடு செய்யவும்"

#: src/muuli_wdr.cpp:1605
msgid "Follow symbolic links in shared folders"
msgstr "பகிரப்பட்ட கோப்புறைகளில் குறியீட்டு இணைப்புகளைப் பின்பற்றவும்"

#: src/muuli_wdr.cpp:1624
msgid "Graphs"
msgstr "வரைபடங்கள்"

#: src/muuli_wdr.cpp:1627 src/muuli_wdr.cpp:1689
msgid "Update delay : 5 secs"
msgstr "புதுப்பித்தல் தாமதம்: 5 வினாடிகள்"

