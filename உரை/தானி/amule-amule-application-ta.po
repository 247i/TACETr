#: src/webserver/src/WebServer.cpp:312
msgid "web client connection accepted\n"
msgstr "இணைய கிளையன்ட் இணைப்பு ஏற்றுக்கொள்ளப்பட்டது\n"

#: src/webserver/src/WebServer.cpp:315
msgid "ERROR: cannot accept web client connection\n"
msgstr "பிழை: இணைய கிளையன்ட் இணைப்பை ஏற்க முடியாது\n"

#: src/webserver/src/WebServer.cpp:361
#, c-format
msgid "Request failed with the following error: %s."
msgstr "பின்வரும் பிழையால் கோரிக்கை தோல்வியடைந்தது: %s."

#: src/webserver/src/WebServer.cpp:1778
msgid "Index file not found: "
msgstr "குறியீட்டு கோப்பு காணப்படவில்லை:"

#: src/webserver/src/WebServer.cpp:1867
msgid "Session expired - requesting login\n"
msgstr "அமர்வு காலாவதியானது - உள்நுழைவைக் கோருகிறது\n"

#: src/webserver/src/WebServer.cpp:1872
msgid "Session ok, logged in\n"
msgstr "அமர்வு சரி, உள்நுழைந்தேன்\n"

#: src/webserver/src/WebServer.cpp:1874
msgid "Session ok, not logged in\n"
msgstr "அமர்வு சரி, உள்நுழையவில்லை\n"

#: src/webserver/src/WebServer.cpp:1879
msgid "No session opened - will request login\n"
msgstr "எந்த அமர்வும் திறக்கப்படவில்லை - உள்நுழைவைக் கோரும்\n"

#: src/webserver/src/WebServer.cpp:1903
msgid "Session created - requesting login\n"
msgstr "அமர்வு உருவாக்கப்பட்டது - உள்நுழைவைக் கோருகிறது\n"

#: src/webserver/src/WebServer.cpp:1918
msgid "Processing request [original]: "
msgstr "செயலாக்க கோரிக்கை [அசல்]:"

#: src/webserver/src/WebServer.cpp:1947
msgid "Refusing to read `pass` from URL query string\n"
msgstr "முகவரி வினவல் சரத்திலிருந்து `பாச்` ஐப் படிக்க மறுக்கிறது\n"

#: src/webserver/src/WebServer.cpp:1953
msgid "No password specified, login will not be allowed."
msgstr "கடவுச்சொல் எதுவும் குறிப்பிடப்படவில்லை, உள்நுழைவு அனுமதிக்கப்படாது."

#: src/webserver/src/WebServer.cpp:1955
msgid "Checking password\n"
msgstr "கடவுச்சொல்லைச் சரிபார்க்கிறது\n"

#: src/webserver/src/WebServer.cpp:1960
msgid "Password hash invalid\n"
msgstr "கடவுச்சொல் ஆச் தவறானது\n"

#: src/webserver/src/WebServer.cpp:1975
msgid "Password ok\n"
msgstr "கடவுச்சொல் சரி\n"

#: src/webserver/src/WebServer.cpp:1977
msgid "Password bad\n"
msgstr "கடவுச்சொல் மோசமாக உள்ளது\n"

#: src/webserver/src/WebServer.cpp:1980
msgid "You did not enter any password. Blank password is not allowed.\n"
msgstr ""
"நீங்கள் எந்த கடவுச்சொல்லையும் உள்ளிடவில்லை. வெற்று கடவுச்சொல் "
"அனுமதிக்கப்படாது.\n"

#: src/webserver/src/WebServer.cpp:1988
msgid "Logout requested\n"
msgstr "வெளியேறுதல் கோரப்பட்டது\n"

#: src/webserver/src/WebServer.cpp:1993
msgid "Processing request [redirected]: "
msgstr "செயலாக்க கோரிக்கை [திசைமாற்றப்பட்டது]:"

#: packaging/windows/installer_strings.c:36
msgid "aMule (required)"
msgstr "aMule (தேவை)"

#: packaging/windows/installer_strings.c:37
msgid "Desktop shortcut"
msgstr "டெச்க்டாப் குறுக்குவழி"

#: packaging/windows/installer_strings.c:38
msgid "Start aMule when I log in"
msgstr "நான் உள்நுழையும்போது aMule ஐத் தொடங்கவும்"

#: packaging/windows/installer_strings.c:39
msgid "Uninstall"
msgstr "நிறுவல் நீக்கவும்"

#: packaging/windows/installer_strings.c:40
msgid "Remove user data (config, ED2K servers, Kad nodes, partfiles)"
msgstr ""
"பயனர் தரவை அகற்று (config, ED2K சேவையகங்கள், Kad முனைகள், பகுதி கோப்புகள்)"

#: packaging/windows/installer_strings.c:43
msgid "aMule application files (required)."
msgstr "aMule பயன்பாட்டுக் கோப்புகள் (தேவை)."

#: packaging/windows/installer_strings.c:44
msgid "Place an aMule shortcut on the desktop."
msgstr "டெச்க்டாப்பில் aMule குறுக்குவழியை வைக்கவும்."

#: packaging/windows/installer_strings.c:45
msgid ""
"Launch aMule automatically when the current user logs in (per-user setting)."
msgstr ""
"தற்போதைய பயனர் உள்நுழையும்போது தானாகவே aMule ஐ இயக்கவும் (ஒரு பயனருக்கு "
"அமைப்பு)."

#: packaging/windows/installer_strings.c:46
msgid ""
"Remove aMule application files, Start Menu / desktop shortcuts, autostart "
"Run-key entry, and Add/Remove Programs entry (required)."
msgstr ""
"aMule பயன்பாட்டுக் கோப்புகளை அகற்றவும், தொடக்க பட்டியல் / டெச்க்டாப் "
"குறுக்குவழிகள், ஆட்டோச்டார்ட் ரன்-விசை உள்ளீடு மற்றும் நிரல்களின் "
"உள்ளீட்டைச் சேர்/நீக்கு (தேவை)."

#: packaging/windows/installer_strings.c:47
msgid ""
"Permanently delete %APPDATA%\\aMule for the current user (aMule.conf, ED2K "
"server list, Kad nodes, partfiles, IP filters, friends list). Leave "
"unchecked to keep your settings."
msgstr ""
"தற்போதைய பயனருக்கான %APPDATA%\\aMule ஐ நிரந்தரமாக நீக்கவும் (aMule.conf, "
"ED2K சர்வர் பட்டியல், Kad nodes, partfiles, IP filters, friends list). "
"உங்கள் அமைப்புகளை வைத்திருக்க தேர்வு செய்யாமல் விடவும்."

#: packaging/windows/installer_strings.c:53
msgid ""
"aMule appears to be running from $INSTDIR.\r\n"
"Please close aMule (and aMuleD / aMuleGUI) and try again."
msgstr ""
"aMule $INSTDIR இலிருந்து இயங்குவதாகத் தெரிகிறது. \r\n"
"aMule (மற்றும் aMuleD / aMuleGUI) ஐ மூடிவிட்டு மீண்டும் முயற்சிக்கவும்."

#: packaging/windows/installer_strings.c:54
msgid ""
"aMule daemon (amuled.exe) appears to be running from $INSTDIR.\r\n"
"Please stop it and try again."
msgstr ""
"aMule deemon (amuled.exe) $INSTDIR இலிருந்து இயங்குவது போல் தெரிகிறது. \r\n"
"தயவுசெய்து நிறுத்திவிட்டு மீண்டும் முயற்சிக்கவும்."

#: packaging/windows/installer_strings.c:55
msgid "Removing previous aMule installation at $0..."
msgstr "$0 இல் முந்தைய aMule நிறுவலை அகற்றுகிறது..."

#: packaging/windows/installer_strings.c:56
msgid ""
"Could not remove the previous aMule installation at $0.\r\n"
"Please close any running aMule processes and try again, or uninstall the previous version manually first."
msgstr ""
"முந்தைய aMule நிறுவலை $0 இல் அகற்ற முடியவில்லை. \r\n"
"இயங்கும் aMule செயல்முறைகளை மூடிவிட்டு, மீண்டும் முயற்சிக்கவும் அல்லது முந்தைய பதிப்பை கைமுறையாக நிறுவல் நீக்கவும்."

#: packaging/windows/installer_strings.c:57
msgid ""
"aMule appears to be running. Please close it and re-run the uninstaller."
msgstr ""
"aMule இயங்குவது போல் தெரிகிறது. தயவுசெய்து அதை மூடிவிட்டு, நிறுவல் நீக்கியை "
"மீண்டும் இயக்கவும்."

#: packaging/windows/installer_strings.c:58
msgid "Removing user data at $APPDATA\\aMule..."
msgstr "$APPDATA\\aMul இல் பயனர் தரவை அகற்றுகிறது..."
