#, i18next-interpolation
msgctxt "notOnPC.header"
msgid "Reminders are not working on PC"
msgstr "நினைவூட்டல்கள் கணினியில் வேலை செய்யவில்லை"

#, i18next-interpolation
msgctxt "notOnPC.content"
msgid ""
"However, since you may export the data off this PC and onto a phone or Mac, "
"you can organize your reminders here."
msgstr ""
"இருப்பினும், இந்த கணினியிலிருந்தும் ஃபோன் அல்லது மேக்கிற்கும் தரவை நீங்கள் "
"ஏற்றுமதி செய்யலாம் என்பதால், உங்கள் நினைவூட்டல்களை இங்கே ஒழுங்கமைக்கலாம்."

#, i18next-interpolation, ignore-inconsistent
msgctxt "header"
msgid "Reminders"
msgstr "நினைவூட்டல்கள்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.header"
msgid "Edit reminder"
msgstr "நினைவூட்டலைத் திருத்து"

#, i18next-interpolation
msgctxt "edit.headerAdd"
msgid "Add reminder"
msgstr "நினைவூட்டலைச் சேர்க்கவும்"

#, i18next-interpolation
msgctxt "edit.active"
msgid "Activate reminder"
msgstr "நினைவூட்டலை இயக்கவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.title"
msgid "Reminder title"
msgstr "நினைவூட்டல் தலைப்பு"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.message"
msgid "Reminder message"
msgstr "நினைவூட்டல் செய்தி"

# Suggested in Weblate: சுணக்கம்
#, i18next-interpolation
msgctxt "edit.delay"
msgid "Delay"
msgstr "சுணக்கம்"

#, i18next-interpolation
msgctxt "edit.triggerOnAllMembers"
msgid "Send for all members"
msgstr "அனைத்து உறுப்பினர்களுக்கும் அனுப்பவும்"

#, i18next-interpolation
msgctxt "edit.members"
msgid "Select members"
msgstr "உறுப்பினர்களைத் தேர்ந்தெடுக்கவும்"

#, i18next-interpolation
msgctxt "edit.triggeringEvent.title"
msgid "Triggering event"
msgstr "தூண்டுதல் நிகழ்வு"

#, i18next-interpolation
msgctxt "edit.triggeringEvent.addedToFront"
msgid "After a member has been added to front"
msgstr "ஒரு உறுப்பினர் முன்னிலையில் சேர்க்கப்பட்ட பிறகு"

#, i18next-interpolation
msgctxt "edit.triggeringEvent.removedFromFront"
msgid "After a member has been removed from front"
msgstr "ஒரு உறுப்பினர் முன்னால் இருந்து நீக்கப்பட்ட பிறகு"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.delete.title"
msgid "Delete reminder"
msgstr "நினைவூட்டலை நீக்கு"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.delete.confirm"
msgid "Are you sure you want to delete this reminder?"
msgstr "இந்த நினைவூட்டலை நிச்சயமாக நீக்க விரும்புகிறீர்களா?"
