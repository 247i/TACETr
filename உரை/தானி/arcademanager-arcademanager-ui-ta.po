msgctxt "CSV_ADD_MAINFILE_DESC"
msgid "The CSV file to add games to"
msgstr "கேம்களைச் சேர்க்க காபிம கோப்பு"

msgctxt "CSV_ADD_SECONDARY"
msgid "Secondary CSV file"
msgstr "இரண்டாம் நிலை காபிம கோப்பு"

msgctxt "CSV_ADD_SECONDARY_DESC"
msgid "The CSV file with the games to add."
msgstr "சேர்க்க வேண்டிய கேம்களுடன் கூடிய காபிம கோப்பு."

msgctxt "CSV_ADD_TARGET"
msgid "Target file"
msgstr "இலக்கு கோப்பு"

msgctxt "CSV_ADD_TARGET_DESC"
msgid "The merged file to be saved"
msgstr "இணைக்கப்பட்ட கோப்பு சேமிக்கப்படும்"

msgctxt "CSV_ADD_ADD"
msgid "Add"
msgstr "கூட்டு"

msgctxt "CSV_LIST_TITLE"
msgid "List the roms in a folder"
msgstr "ஒரு கோப்புறையில் ரோம்களை பட்டியலிடவும்"

msgctxt "CSV_LIST_INTRO"
msgid ""
"<p>Select the folder that contain your roms, and the target CSV file.<br>If "
"you want more informations for each, use the \"<a href=\"/Csv/Keep\" "
"class=\"navmenu\">keep games</a>\" filter, use a \"complete romset\" CSV as "
"main, and your files list as secondary.</p>"
msgstr ""
"<p>உங்கள் ரோம்கள் மற்றும் இலக்கு காபிம கோப்பைக் கொண்ட கோப்புறையைத் "
"தேர்ந்தெடுக்கவும்.<br>ஒவ்வொன்றிற்கும் கூடுதல் தகவல்களை நீங்கள் விரும்பினால்,"
" \"<a href=\"/Csv/Keep\" class=\"navmenu\">கேம்களை வைத்திருங்கள்</a>\" "
"வடிப்பானைப் பயன்படுத்தவும், \"முழுமையான romset\" காபிம ஐ முக்கியமாகப் "
"பயன்படுத்தவும், உங்கள் கோப்புகளின் பட்டியலை இரண்டாம் நிலையாகவும் "
"பயன்படுத்தவும்.</p>"

msgctxt "CSV_LIST_FOLDER"
msgid "Roms folder"
msgstr "ரோம்ச் கோப்புறை"

msgctxt "CSV_LIST_FOLDER_DESC"
msgid "The folder containing the roms to list"
msgstr "பட்டியலிட வேண்டிய ரோம்களைக் கொண்ட கோப்புறை"

msgctxt "CSV_LIST_TARGET"
msgid "Roms list file"
msgstr "ரோம்ச் பட்டியல் கோப்பு"

msgctxt "CSV_LIST_TARGET_DESC"
msgid "The CSV file listing your roms to be saved"
msgstr "காபிம கோப்பு சேமிக்கப்பட வேண்டிய உங்கள் ரோம்களை பட்டியலிடுகிறது"

msgctxt "CSV_LIST_ERROR_NOFOLDER"
msgid "Please choose a folder to list the files from"
msgstr "கோப்புகளை பட்டியலிட ஒரு கோப்புறையைத் தேர்ந்தெடுக்கவும்"

msgctxt "CSV_LIST_LIST"
msgid "List the files"
msgstr "கோப்புகளை பட்டியலிடுங்கள்"

msgctxt "CSV_KEEP_TITLE"
msgid "Keep only listed games"
msgstr "பட்டியலிடப்பட்ட கேம்களை மட்டும் வைத்திருங்கள்"

msgctxt "CSV_KEEP_INTRO"
msgid ""
"<p>Example usages:<br>- removing non-working games from a list: main = your "
"list ; secondary = \"working\" list<br>- create a \"best games with a "
"stick\" list: main = \"best games\" ; secondary = \"playable with an arcade "
"stick\"<br>- create a full CSV from a simple games list: main = full romset "
"; secondary = raw list with only the file names</p>"
msgstr ""
"<p>உதாரண பயன்பாடுகள்:<br>- ஒரு பட்டியலிலிருந்து வேலை செய்யாத கேம்களை "
"நீக்குதல்: முக்கிய = உங்கள் பட்டியல் ; secondary = \"உழைக்கும்\" "
"பட்டியல்<br>- \"ஒரு குச்சியுடன் சிறந்த விளையாட்டுகள்\" பட்டியலை "
"உருவாக்கவும்: முக்கிய = \"சிறந்த விளையாட்டுகள்\" ; secondary = \"ஆர்கேட் "
"ச்டிக் மூலம் விளையாடக்கூடியது\"<br>- ஒரு எளிய கேம்கள் பட்டியலிலிருந்து முழு "
"காபிம ஐ உருவாக்கவும்: முக்கிய = முழு ரோம்செட் ; secondary = raw பட்டியல் "
"with only கோப்பு names</p>"

msgctxt "CSV_KEEP_MAINFILE"
msgid "Main CSV file"
msgstr "முக்கிய காபிம கோப்பு"

msgctxt "CSV_KEEP_MAINFILE_DESC"
msgid "The CSV file to filter"
msgstr "வடிகட்ட வேண்டிய காபிம கோப்பு"

msgctxt "CSV_KEEP_SECONDARY"
msgid "Secondary CSV file"
msgstr "இரண்டாம் நிலை காபிம கோப்பு"

msgctxt "CSV_KEEP_SECONDARY_DESC"
msgid "The CSV file containing the games to keep"
msgstr "வைத்திருக்க வேண்டிய கேம்களைக் கொண்ட காபிம கோப்பு"

msgctxt "CSV_KEEP_TARGET"
msgid "Target file"
msgstr "இலக்கு கோப்பு"

msgctxt "CSV_KEEP_TARGET_DESC"
msgid "The merged file to be saved"
msgstr "இணைக்கப்பட்ட கோப்பு சேமிக்கப்படும்"

msgctxt "CSV_KEEP_KEEP"
msgid "Remove games not listed"
msgstr "பட்டியலிடப்படாத கேம்களை அகற்று"

msgctxt "CSV_DELETE_TITLE"
msgid "Delete games from a CSV file"
msgstr "காபிம கோப்பிலிருந்து கேம்களை நீக்கவும்"

msgctxt "CSV_DELETE_INTRO"
msgid ""
"<p>Select the main CSV file, the file containing the games you want to "
"remove from the first, and the target file.</p>"
msgstr ""
"<p>முதன்மை காபிம கோப்பு, நீங்கள் முதலில் நீக்க விரும்பும் கேம்களைக் கொண்ட "
"கோப்பு மற்றும் இலக்கு கோப்பைத் தேர்ந்தெடுக்கவும்.</p>"

msgctxt "CSV_DELETE_MAINFILE"
msgid "Main CSV file"
msgstr "முக்கிய காபிம கோப்பு"

msgctxt "CSV_DELETE_MAINFILE_DESC"
msgid "The CSV file to remove games from"
msgstr "கேம்களை அகற்ற வேண்டிய காபிம கோப்பு"

msgctxt "CSV_DELETE_SECONDARY"
msgid "Secondary CSV file"
msgstr "இரண்டாம் நிலை காபிம கோப்பு"

msgctxt "CSV_DELETE_SECONDARY_DESC"
msgid "The CSV file containing the games to remove"
msgstr "அகற்ற வேண்டிய கேம்களைக் கொண்ட காபிம கோப்பு"

msgctxt "CSV_DELETE_TARGET"
msgid "Target file"
msgstr "இலக்கு கோப்பு"

msgctxt "CSV_DELETE_TARGET_DESC"
msgid "The merged file to be saved"
msgstr "இணைக்கப்பட்ட கோப்பு சேமிக்கப்படும்"

msgctxt "CSV_DELETE_DELETE"
msgid "Remove games"
msgstr "கேம்களை அகற்று"

msgctxt "CSV_CONVERTINI_TITLE"
msgid "Convert a INI file"
msgstr "இனி கோப்பை மாற்றவும்"

msgctxt "CSV_CONVERTINI_INTRO"
msgid ""
"<p>Select the INI file you want to convert and the target CSV file.<br>This "
"will create one CSV file per INI section/category.<br>The supported INI "
"files are the ones provided by <a href=\"http://progettosnaps.net/\" "
"class=\"blank\">Progetto Snaps</a> or the \"catver.ini\" file provided with "
"MAME.</p>"
msgstr ""
"<p>நீங்கள் மாற்ற விரும்பும் இனி கோப்பு மற்றும் இலக்கு காபிம கோப்பைத் "
"தேர்ந்தெடுக்கவும்.<br>இது ஒரு இனி பிரிவு/வகைக்கு ஒரு காபிம கோப்பை "
"உருவாக்கும்.<br>ஆதரிக்கப்படும் இனி கோப்புகள் <a "
"href=\"http://progettosnaps.net/\" class=\"blank\">Progetto Snaps.</a> "
"வழங்கப்பட்டுள்ள MEca கோப்பு அல்லது \"MA உடன்\"."

msgctxt "CSV_CONVERTINI_MAINFILE"
msgid "INI file"
msgstr "இனி கோப்புகள்"

msgctxt "CSV_CONVERTINI_MAINFILE_DESC"
msgid "The INI file to convert"
msgstr "மாற்ற வேண்டிய இனி கோப்பு"

msgctxt "CSV_CONVERTINI_TARGET"
msgid "Conversion folder"
msgstr "மாற்று கோப்புறை"

msgctxt "CSV_CONVERTINI_TARGET_DESC"
msgid ""
"The folder where the converted files will be saved (one file per INI "
"section)"
msgstr ""
"மாற்றப்பட்ட கோப்புகள் சேமிக்கப்படும் கோப்புறை (INI பிரிவில் ஒரு கோப்பு)"

msgctxt "CSV_CONVERTINI_ERRORNOINI"
msgid "Please choose a INI file to convert"
msgstr "மாற்றுவதற்கு இனி கோப்பைத் தேர்ந்தெடுக்கவும்"

msgctxt "CSV_CONVERTINI_ERRORNOTARGET"
msgid "Please choose a target folder"
msgstr "இலக்கு கோப்புறையைத் தேர்ந்தெடுக்கவும்"

msgctxt "CSV_CONVERTINI_ERRORBADINI"
msgid "The INI file should be a .ini file"
msgstr "இனி கோப்பு .ini கோப்பாக இருக்க வேண்டும்"

msgctxt "CSV_CONVERTINI_CONVERT"
msgid "Convert"
msgstr "மாற்றவும்"

msgctxt "CSV_CONVERTDAT_TITLE"
msgid "Convert a DAT (XML) file"
msgstr "DAT (XML) கோப்பை மாற்றவும்"

msgctxt "CSV_CONVERTDAT_INTRO"
msgid ""
"<p>Select the DAT file you want to convert and the target CSV file.</p>"
msgstr ""
"<p>நீங்கள் மாற்ற விரும்பும் DAT கோப்பையும் இலக்கு காபிம கோப்பையும் "
"தேர்ந்தெடுக்கவும்.</p>"

msgctxt "CSV_CONVERTDAT_MAINFILE"
msgid "DAT file"
msgstr "DAT கோப்பு"

msgctxt "CSV_CONVERTDAT_MAINFILE_DESC"
msgid "The DAT file to convert"
msgstr "மாற்ற வேண்டிய DAT கோப்பு"

msgctxt "CSV_CONVERTDAT_TARGET"
msgid "Converted file"
msgstr "மாற்றப்பட்ட கோப்பு"

msgctxt "CSV_CONVERTDAT_TARGET_DESC"
msgid "The converted file to be saved"
msgstr "மாற்றப்பட்ட கோப்பு சேமிக்கப்படும்"

msgctxt "CSV_CONVERTDAT_ERRORNODAT"
msgid "Please choose a DAT file to convert"
msgstr "மாற்றுவதற்கு DAT கோப்பைத் தேர்ந்தெடுக்கவும்"

msgctxt "CSV_CONVERTDAT_ERRORBADDAT"
msgid "The DAT file should be a .DAT or .XML file."
msgstr "DAT கோப்பு .DAT அல்லது .XML கோப்பாக இருக்க வேண்டும்."

msgctxt "CSV_CONVERTDAT_CONVERT"
msgid "Convert"
msgstr "மாற்றவும்"

msgctxt "ROMS_INDEX_TITLE"
msgid "Manage roms"
msgstr "ரோம்களை நிர்வகிக்கவும்"

msgctxt "ROMS_INDEX_INTRO"
msgid ""
"Easily copy roms you want, or remove roms you don't want, based on a simple "
"CSV file.<br>Copying from a romset assumes it matches your MAME version and "
"is non-merged."
msgstr ""
"எளிமையான காபிம கோப்பின் அடிப்படையில் நீங்கள் விரும்பும் ரோம்களை எளிதாக "
"நகலெடுக்கலாம் அல்லது விரும்பாத ரோம்களை அகற்றலாம்.<br>ரொம்செட்டிலிருந்து "
"நகலெடுப்பது உங்கள் MAME பதிப்போடு பொருந்துகிறது மற்றும் "
"ஒன்றிணைக்கப்படவில்லை."

msgctxt "ROMS_INDEX_COPY"
msgid "Copy listed roms from a full romset to a selection folder"
msgstr ""
"பட்டியலிடப்பட்ட ரோம்களை முழு ரோம்செட்டிலிருந்து தேர்வு கோப்புறைக்கு "
"நகலெடுக்கவும்"

msgctxt "ROMS_INDEX_DELETE"
msgid "Delete listed roms"
msgstr "பட்டியலிடப்பட்ட ரோம்களை நீக்கு"

msgctxt "ROMS_INDEX_KEEP"
msgid "Keep only the roms listed"
msgstr "பட்டியலிடப்பட்ட ரோம்களை மட்டும் வைத்திருங்கள்"

msgctxt "ROMS_INDEX_CHECKDAT"
msgid "Check a romset against a DAT file"
msgstr "DAT கோப்பில் ரோம்செட்டைச் சரிபார்க்கவும்"

msgctxt "ROMS_FILESNOTFOUD"
msgid "Some files have not been found"
msgstr "சில கோப்புகள் கிடைக்கவில்லை"

msgctxt "ROMS_FILESLISTCOPY"
msgid "Copy the files list"
msgstr "கோப்புகளின் பட்டியலை நகலெடுக்கவும்"

msgctxt "ROMS_FILESLISTCOPIED"
msgid "Copied in clipboard"
msgstr "கிளிப்போர்டில் நகலெடுக்கப்பட்டது"

msgctxt "ROMS_LOGCOPY"
msgid "Copy the results in the clipboard"
msgstr "கிளிப்போர்டில் முடிவுகளை நகலெடுக்கவும்"

msgctxt "ROMS_LOGCOPIED"
msgid "Copied in clipboard"
msgstr "கிளிப்போர்டில் நகலெடுக்கப்பட்டது"

msgctxt "ROMS_COPY_TITLE"
msgid "Copy roms"
msgstr "ரோம்களை நகலெடுக்கவும்"

msgctxt "ROMS_COPY_HOWTOACCESS"
msgid "How to access my Retropie/Recalbox shares"
msgstr "எனது Retropie/Recalbox பங்குகளை எவ்வாறு அணுகுவது"

msgctxt "ROMS_COPY_INTRO"
msgid ""
"Select a CSV file listing the roms you want, the path to the full romset, "
"and the path to a rom selection<br>This will copy the roms listed in the CSV"
" from the romset to the selection.<br>For example, using a \"classic games\""
" CSV file will copy only the classics instead of the thousands of games MAME"
" provides."
msgstr ""
"நீங்கள் விரும்பும் roms, முழு romsetக்கான பாதை மற்றும் rom தேர்வுக்கான பாதை "
"ஆகியவற்றைப் பட்டியலிடும் காபிம கோப்பைத் தேர்ந்தெடுக்கவும்<br>இது காபிம இல் "
"பட்டியலிடப்பட்டுள்ள romsகளை romset இலிருந்து தேர்வுக்கு "
"நகலெடுக்கும்.<br>உதாரணமாக, \"கிளாசிக் கேம்ச்\" காபிம கோப்பைப் "
"பயன்படுத்தினால், MAME வழங்கும் ஆயிரக்கணக்கான கேம்களுக்குப் பதிலாக கிளாசிக்சை"
" மட்டுமே நகலெடுக்கும்."

msgctxt "ROMS_COPY_CSVFILE"
msgid "CSV file"
msgstr "CSV கோப்பு"

msgctxt "ROMS_COPY_CSVFILE_DESC"
msgid "The CSV file listing the games to copy"
msgstr "The காபிம கோப்பு listing the games பெறுநர் நகலெடு"

msgctxt "ROMS_COPY_ROMSET"
msgid "Full romset"
msgstr "முழு ரோம்செட்"

msgctxt "ROMS_COPY_ROMSET_DESC"
msgid "The folder containing all the files of the romset"
msgstr "ரோம்செட்டின் அனைத்து கோப்புகளையும் கொண்ட கோப்புறை"

msgctxt "ROMS_COPY_ROMSELECT"
msgid "Rom selection"
msgstr "ரோம் தேர்வு"

msgctxt "ROMS_COPY_ROMSELECT_DESC"
msgid "The folder that will contain the subset of the roms you want"
msgstr "நீங்கள் விரும்பும் ரோம்களின் துணைக்குழுவைக் கொண்டிருக்கும் கோப்புறை"

msgctxt "ROMS_COPY_SAMPLES"
msgid ""
"Some old games, like Space Invaders, need \"samples\" to have sound. Make "
"sure you copy them manually; the installation path vary depending on the "
"system and emulator.<br>You can <a "
"href=\"https://www.progettosnaps.net/samples/\" class=\"blank\">download "
"them at ProgettoSnaps</a>."
msgstr ""
"ச்பேச் இன்வேடர்ச் போன்ற சில பழைய கேம்களுக்கு ஒலியைப் பெற \"மாதிரிகள்\" தேவை."
" அவற்றை கைமுறையாக நகலெடுப்பதை உறுதிசெய்யவும்; கணினி மற்றும் முன்மாதிரியைப் "
"பொறுத்து நிறுவல் பாதை மாறுபடும்.<br>நீங்கள் <a "
"href=\"https://www.progettosnaps.net/samples/\" "
"class=\"blank\">ProgettoSnaps இல் அவற்றைப் பதிவிறக்கலாம்</a>."

msgctxt "ROMS_COPY_COPY"
msgid "Copy listed roms"
msgstr "பட்டியலிடப்பட்ட ரோம்களை நகலெடுக்கவும்"

msgctxt "ROMS_DELETE_TITLE"
msgid "Delete roms"
msgstr "ரோம்களை நீக்கு"

msgctxt "ROMS_DELETE_INTRO"
msgid ""
"Select a CSV file listing the roms you want to remove, and the folder "
"containing your roms<br>This will remove all roms listed in the CSV file "
"from the folder.<br>For example, using a \"bad games\" CSV file will remove "
"all bad games."
msgstr ""
"நீங்கள் அகற்ற விரும்பும் ரோம்களை பட்டியலிடும் காபிம கோப்பைத் "
"தேர்ந்தெடுக்கவும், உங்கள் ரோம்களைக் கொண்ட கோப்புறையைத் "
"தேர்ந்தெடுக்கவும்<br>இது காபிம கோப்பில் பட்டியலிடப்பட்டுள்ள அனைத்து "
"ரோம்களையும் கோப்புறையிலிருந்து அகற்றும்.<br>உதாரணமாக, \"மோசமான கேம்கள்\" "
"காபிம கோப்பைப் பயன்படுத்துவது அனைத்து மோசமான கேம்களையும் அகற்றும்."

msgctxt "ROMS_DELETE_ALERT"
msgid ""
"Take care not to enter the full romset path! The files cannot be restored!"
msgstr ""
"முழு ரோம்செட் பாதையில் நுழையாமல் பார்த்துக்கொள்! கோப்புகளை மீட்டெடுக்க "
"முடியாது!"

#, ignore-reused
msgctxt "ROMS_DELETE_FOLDER"
msgid "Roms folder"
msgstr "ரோம்ச் கோப்புறை"

msgctxt "ROMS_DELETE_FOLDER_DESC"
msgid "The folder containing the roms you want to delete"
msgstr "நீங்கள் நீக்க விரும்பும் ரோம்களைக் கொண்ட கோப்புறை"

msgctxt "ROMS_DELETE_DELETE"
msgid "Delete listed roms"
msgstr "பட்டியலிடப்பட்ட ரோம்களை நீக்கு"

msgctxt "ROMS_KEEP_TITLE"
msgid "Keep only roms listed"
msgstr "ரோம்களை மட்டும் பட்டியலிடவும்"

msgctxt "ROMS_KEEP_INTRO"
msgid ""
"Select a CSV file listing the roms you want to keep, and the folder "
"containing the roms.<br>This will only keep the roms that are listed in the "
"CSV file, and remove all other roms.<br>For example, using a \"working "
"games\" CSV file will remove all games that are not working."
msgstr ""
"நீங்கள் வைத்திருக்க விரும்பும் ரோம்களையும், ரோம்களைக் கொண்ட கோப்புறையையும் "
"பட்டியலிடும் காபிம கோப்பைத் தேர்ந்தெடுக்கவும்.<br>இது காபிம கோப்பில் "
"பட்டியலிடப்பட்டுள்ள ரோம்களை மட்டுமே வைத்திருக்கும், மேலும் மற்ற எல்லா "
"ரோம்களையும் அகற்றும்.<br>உதாரணமாக, \"வேலை செய்யும் கேம்கள்\" காபிம கோப்பைப் "
"பயன்படுத்துவது வேலை செய்யாத அனைத்து கேம்களையும் அகற்றும்."

msgctxt "ROMS_KEEP_FOLDER"
msgid "Rom folder"
msgstr "ரோம் கோப்புறை"

msgctxt "ROMS_KEEP_FOLDER_DESC"
msgid "The folder containing the roms you want to keep"
msgstr "நீங்கள் வைத்திருக்க விரும்பும் ரோம்களைக் கொண்ட கோப்புறை"

msgctxt "ROMS_KEEP_KEEP"
msgid "Remove roms not listed"
msgstr "பட்டியலிடப்படாத ரோம்களை அகற்று"

#, ignore-reused
msgctxt "OVERLAYS_PAGETITLE"
msgid "Overlays"
msgstr "மேலடுக்குகள்"

msgctxt "OVERLAYS_TITLE"
msgid ""
"Download and install an overlays pack <a href=\"/Help/Shares\" "
"class=\"navmenu\">How to access my Retropie/Recabox shares</a>"
msgstr ""
"<a href=\"/Help/Shares\" class=\"navmenu\">எனது Retropie/Recabox பங்குகளை "
"எவ்வாறு அணுகுவது</a> மேலடுக்கு பேக்கைப் பதிவிறக்கி நிறுவவும்"

msgctxt "OVERLAYS_INTRO"
msgid ""
"Select the overlays pack you want, and the arcade roms folder(s) to install "
"overlays in. This will download and install only the files you need.<br> "
"Note that <strong>it will only work with RetroArch/Libretro "
"emulators</strong> (mame-libretro and fba-libretro), not AdvanceMAME, "
"MAME4All, FBA2x, PiFBA, etc."
msgstr ""
"நீங்கள் விரும்பும் மேலடுக்குகள் பேக் மற்றும் மேலடுக்குகளை நிறுவ ஆர்கேட் roms"
" கோப்புறை(களை) தேர்ந்தெடுக்கவும். இது உங்களுக்குத் தேவையான கோப்புகளை மட்டும்"
" பதிவிறக்கி நிறுவும்.<br> <strong>இது RetroArch/Libretro emulators</strong> "
"(mame-libretro மற்றும் fba-libretro) உடன் மட்டுமே வேலை செய்யும் என்பதை "
"நினைவில் கொள்ளவும்."

msgctxt "OVERLAYS_ALERT"
msgid ""
"These overlays are made for a 16:9 resolution (like 1080p or 720p for "
"example). They won't work with another aspect ratio."
msgstr ""
"இந்த மேலடுக்குகள் 16:9 தெளிவுத்திறனுக்காக உருவாக்கப்பட்டுள்ளன (உதாரணமாக "
"1080p அல்லது 720p போன்றவை). அவை வேறொரு விகிதத்துடன் வேலை செய்யாது."

msgctxt "OVERLAYS_PACK_TITLE"
msgid "Overlay pack"
msgstr "மேலடுக்கு பேக்"

msgctxt "OVERLAYS_SETTINGS_TITLE"
msgid "Settings"
msgstr "அமைப்புகள்"

#, ignore-reused
msgctxt "OVERLAYS_SETTINGS_ROMSFOLDER"
msgid "Roms folder"
msgstr "ரோம்ச் கோப்புறை"

msgctxt "OVERLAYS_SETTINGS_ROMSFOLDERS"
msgid "Roms folders"
msgstr "ரோம்ச் கோப்புறைகள்"

msgctxt "OVERLAYS_SETTINGS_ROMSFOLDER_PLACEHOLDER"
msgid "Roms folder (ex: \\\\retropie\\roms\\arcade)"
msgstr "Roms கோப்புறை (எ.கா: \\\\retropie\\roms\\arcade)"

msgctxt "OVERLAYS_SETTINGS_CONFIGFOLDER"
msgid "Config folder"
msgstr "கட்டமைப்பு கோப்புறை"

msgctxt "OVERLAYS_SETTINGS_CONFIGFOLDER_PLACEHOLDER"
msgid "Config folder (ex: \\\\retropie\\configs)"
msgstr "கட்டமைப்பு கோப்புறை (எ.கா: \\\\retropie\\configs)"

msgctxt "OVERLAYS_WIDTH"
msgid "Width"
msgstr "அகலம்"

msgctxt "OVERLAYS_HEIGHT"
msgid "Height"
msgstr "உயரம்"

msgctxt "OVERLAYS_RATIO_ERROR"
msgid ""
"Resolution is not correct. These packs will only work with 16:9 screens."
msgstr ""
"தீர்மானம் சரியாக இல்லை. இந்த பேக்குகள் 16:9 திரைகளில் மட்டுமே வேலை செய்யும்."

msgctxt "OVERLAYS_INSTALL"
msgid "Download and install"
msgstr "பதிவிறக்கி நிறுவவும்"

msgctxt "OVERLAYS_ERROR_NOOVERLAY"
msgid "Please select an overlay pack"
msgstr "மேலடுக்கு தொகுப்பைத் தேர்ந்தெடுக்கவும்"

msgctxt "OVERLAYS_ERROR_NOROMS"
msgid "Please select the roms folder"
msgstr "roms கோப்புறையைத் தேர்ந்தெடுக்கவும்"

msgctxt "OVERLAYS_ERROR_NOCONFIG"
msgid "Please fill the path to the config share"
msgstr "கட்டமைப்பு பகிர்வுக்கான பாதையை நிரப்பவும்"

msgctxt "OVERLAYS_PACK_REALISTIC_NAME"
msgid "Realistic"
msgstr "யதார்த்தமான"

msgctxt "OVERLAYS_PACK_REALISTIC_DESC"
msgid ""
"Realistic-looking overlays, with scratches, reflections, and CRT shader"
msgstr ""
"கீறல்கள், பிரதிபலிப்புகள் மற்றும் CRT சேடர் ஆகியவற்றுடன் யதார்த்தமான "
"தோற்றமுடைய மேலடுக்குகள்"

msgctxt "OVERLAYS_PACK_ARTWORK_NAME"
msgid "Artworks"
msgstr "கலைப்படைப்புகள்"

msgctxt "OVERLAYS_PACK_ARTWORK_DESC"
msgid "Artwork-style overlays, as clean as possible, with a large screen area"
msgstr ""
"கலைப்படைப்பு பாணி மேலடுக்குகள், முடிந்தவரை சுத்தமாக, பெரிய திரைப் பகுதியுடன்"

msgctxt "WIZARD_TITLE"
msgid "Wizard"
msgstr "மந்திரவாதி"

msgctxt "WIZARD_INTRO"
msgid ""
"<p> This wizard will help you to manage your games. Use this if you're not "
"sure what games you want to play exactly, or just want \"the best games\" "
"but don't know what they are. You will still be able to add more games "
"later.</p><p>To install games, you will need a working, full romset of roms."
" Emulators and versions depend on the options you choose in the next "
"step.</p><p>To install overlays, you will need a Retropie or Recalbox "
"installation.</p>"
msgstr ""
"<p> உங்கள் கேம்களை நிர்வகிக்க இந்த வழிகாட்டி உங்களுக்கு உதவும். நீங்கள் எந்த"
" கேம்களை விளையாட விரும்புகிறீர்கள் என்பது உங்களுக்குத் தெரியாவிட்டால் அல்லது"
" \"சிறந்த கேம்களை\" விரும்பினால், ஆனால் அவை என்னவென்று தெரியாவிட்டால் இதைப் "
"பயன்படுத்தவும். நீங்கள் இன்னும் கேம்களை பின்னர் சேர்க்க "
"முடியும்.</p><p>கேம்களை நிறுவ, உங்களுக்கு வேலை செய்யும், முழு ரோம் செட் "
"தேவைப்படும். எமுலேட்டர்கள் மற்றும் பதிப்புகள் அடுத்த கட்டத்தில் நீங்கள் "
"தேர்ந்தெடுக்கும் விருப்பங்களைப் பொறுத்தது.</p><p>மேற்பரப்புகளை நிறுவ, "
"உங்களுக்கு Retropie அல்லது Recalbox நிறுவல் தேவைப்படும்.</p>"

msgctxt "WIZARD_ACTION_ROMS"
msgid "Copy roms"
msgstr "ரோம்களை நகலெடுக்கவும்"

msgctxt "WIZARD_ACTION_ROMS_DESC"
msgid "Copy games from a full romset to your installation folder."
msgstr ""
"கேம்களை முழு ரோம்செட்டிலிருந்து உங்கள் நிறுவல் கோப்புறையில் நகலெடுக்கவும்."

msgctxt "WIZARD_ACTION_OVERLAYS"
msgid "Install overlays"
msgstr "மேலடுக்குகளை நிறுவவும்"

msgctxt "WIZARD_ACTION_OVERLAYS_DESC"
msgid "Add nice borders around the game screen."
msgstr "விளையாட்டுத் திரையைச் சுற்றி நல்ல பார்டர்களைச் சேர்க்கவும்."

msgctxt "WIZARD_START"
msgid "Start - choose emulator"
msgstr "தொடக்கம் - முன்மாதிரியைத் தேர்ந்தெடுக்கவும்"

msgctxt "WIZARD_EMULATOR_TITLE"
msgid "Automatic installation: emulator"
msgstr "தானியங்கி நிறுவல்: முன்மாதிரி"

msgctxt "WIZARD_EMULATOR_INTRO"
msgid ""
"<p>Please choose the emulator you want to use.</p><p>FBNeo is missing 3D "
"games (or 2D games developed on 3D systems), and even MAME isn't great on "
"more recent games (Naomi, Atomiswave, etc).<br />Here is a <a "
"href=\"https://github.com/cosmo0/arcade-manager-"
"data/blob/master/alternatives.md\" class=\"blank\">list of "
"alternatives</a>.</p>"
msgstr ""
"<p>தயவுசெய்து நீங்கள் பயன்படுத்த விரும்பும் எமுலேட்டரைத் "
"தேர்வுசெய்யவும்.</p><p>FBNeo 3D கேம்களை (அல்லது 3D சிச்டங்களில் "
"உருவாக்கப்பட்ட 2D கேம்கள்) காணவில்லை, மேலும் அண்மைக் கால கேம்களில் MAME கூட "
"சிறப்பாக இல்லை (Naomi, Atomiswave போன்றவை).<br />இதோ ஒரு <a உள்ளது. "
"href=\"https://github.com/cosmo0/arcade-manager-"
"data/blob/master/alternatives.md\" class=\"blank\">மாற்றுகளின் "
"பட்டியல்</a>.</p>"

#, ignore-same
msgctxt "WIZARD_EMULATOR_FBNEO_NAME"
msgid "FBNeo (1.0.0.2)"
msgstr "FBNeo (1.0.0.2)"

msgctxt "WIZARD_EMULATOR_FBNEO_DESC"
msgid ""
"Has the best balance between performance and accuracy, but the games list is"
" a bit more limited (1900+, no 3D game).<br /><strong>Prefer this if you "
"play on Raspberry Pi 4 and later, or Anbernic RG XX and similar "
"devices</strong>."
msgstr ""
"செயல்திறன் மற்றும் துல்லியம் ஆகியவற்றுக்கு இடையே சிறந்த சமநிலையைக் "
"கொண்டுள்ளது, ஆனால் கேம்களின் பட்டியல் சற்று குறைவாகவே உள்ளது (1900+, 3D கேம்"
" இல்லை).<br /><strong>Raspberry Pi 4 மற்றும் அதற்குப் பிந்தைய அல்லது "
"Anbernic RG XX மற்றும் அதுபோன்ற சாதனங்களில் விளையாடினால் இதை "
"விரும்பவும்</strong>."

msgctxt "WIZARD_EMULATOR_MAME_NAME"
msgid "MAME - latest version (0.249)"
msgstr "MAME - அண்மைக் கால பதிப்பு (0.249)"

msgctxt "WIZARD_EMULATOR_MAME_DESC"
msgid ""
"Has the largest games list (3500+ games) and highest emulation accuracy, but"
" also requires the most power, even for older games.<br /><strong>Prefer "
"this if you play on PC</strong>."
msgstr ""
"மிகப் பெரிய கேம்கள் பட்டியலையும் (3500+ கேம்கள்) மிக உயர்ந்த எமுலேசன் "
"துல்லியத்தையும் கொண்டுள்ளது, ஆனால் பழைய கேம்களுக்கும் கூட அதிக ஆற்றல் "
"தேவைப்படுகிறது.<br /><strong>PC இல் விளையாடினால் இதை விரும்பவும்</strong>."

msgctxt "WIZARD_EMULATOR_MAME2003_NAME"
msgid "MAME 2003+"
msgstr "MAME 2003+"

msgctxt "WIZARD_EMULATOR_MAME2003_DESC"
msgid ""
"Has the best performance, but has quite a lot of bugs, non-working games, "
"and other problems.<br /><strong>Prefer this if you play on Raspberry Pi 3, "
"or Miyoo Mini and similar devices</strong>."
msgstr ""
"சிறந்த செயல்திறன் உள்ளது, ஆனால் நிறைய பிழைகள், வேலை செய்யாத கேம்கள் மற்றும் "
"பிற சிக்கல்கள் உள்ளன.<br /><strong>நீங்கள் புற்றுப்பழம் Pi 3, அல்லது Miyoo "
"Mini மற்றும் அதுபோன்ற சாதனங்களில் விளையாடினால், இதை விரும்பவும்</strong>."

msgctxt "WIZARD_EMULATOR_NEXT"
msgid "Next - choose lists"
msgstr "அடுத்து - பட்டியல்களைத் தேர்ந்தெடுக்கவும்"

msgctxt "WIZARD_LIST_TITLE"
msgid "Automatic installation: games lists"
msgstr "தானியங்கி நிறுவல்: விளையாட்டு பட்டியல்"

msgctxt "WIZARD_LIST_INTRO"
msgid ""
"<p>Please choose the games selection(s) you want.</p><p>All the games have "
"been tested and work with a retro pad (SNES-like) or an arcade stick. "
"Sometimes gameplay is possible but not ideal without a dedicated control "
"(ex: racing games).</p><p>Note that the various \"tops\" have duplicates: "
"selecting the top200 and the top50 will only result in 200 games, since the "
"top50 is a sub-selection of the top200.<br />Obviously the \"tops\" are "
"highly subjective, and mainly destined to people who don't know much about "
"arcade games. This tool also easily lets you <a href=\"/Csv\">define your "
"own lists</a>.</p>"
msgstr ""
"<p>தயவுசெய்து நீங்கள் விரும்பும் கேம்களின் தேர்வை(களை) தேர்வு "
"செய்யவும்.</p><p>அனைத்து கேம்களும் சோதிக்கப்பட்டு, ரெட்ரோ பேட் (SNES "
"போன்றது) அல்லது ஆர்கேட் ச்டிக் மூலம் வேலை செய்ய வேண்டும். சில சமயங்களில் "
"தனித்தனி கட்டுப்பாடு இல்லாமல் கேம் விளையாடுவது நிகழக்கூடிய ஆனால் சிறந்ததாக "
"இருக்காது (எ.கா: பந்தய விளையாட்டுகள்).</p><p>பல்வேறு \"டாப்ச்\" நகல்களைக் "
"கொண்டிருப்பதைக் கவனிக்கவும்: டாப் 200 மற்றும் டாப்50 ஐத் தேர்ந்தெடுப்பது 200"
" கேம்களை மட்டுமே விளைவிக்கும், ஏனெனில் டாப் 50 என்பது டாப்200 இன் துணைத் "
"தேர்வாகும்.<br />வெளிப்படையாக \"முதலில்\" அதிகம் தெரிந்தவர்கள் ஆர்கேட் "
"விளையாட்டுகள் பற்றி. இந்தக் கருவி <a href=\"/Csv\">உங்கள் சொந்தப் "
"பட்டியல்களை வரையறுக்கவும்</a> எளிதாக உங்களை அனுமதிக்கிறது.</p>"

msgctxt "WIZARD_LIST_TOP200"
msgid ""
"<strong>Top 200</strong>: a balanced selection of all the great games, and a"
" few hidden gems : a great trip down memory lane, finding new things along "
"the ride."
msgstr ""
"<strong>டாப் 200</strong>: அனைத்து சிறந்த கேம்களின் சீரான தேர்வு மற்றும் சில"
" மறைக்கப்பட்ட கற்கள் : நினைவக பாதையில் ஒரு சிறந்த பயணம், சவாரியில் புதிய "
"விசயங்களைக் கண்டறியும்."

msgctxt "WIZARD_LIST_TOP50"
msgid ""
"<strong>Top 50</strong>: only the very best, a tight but balanced selection "
"of all-time classics : the best way to see what the arcades were about."
msgstr ""
"<strong>சிறந்த 50</strong>: மிகச் சிறந்த, இறுக்கமான ஆனால் சமநிலையான அனைத்து "
"கால கிளாசிக் தேர்வுகள் : ஆர்கேடுகள் எதைப் பற்றியது என்பதைப் பார்ப்பதற்கான "
"சிறந்த வழி."

msgctxt "WIZARD_LIST_TOP80S"
msgid ""
"<strong>Top of the 80s</strong>: from Berzerk to Final Fight, the {0} best "
"old-school games."
msgstr ""
"<strong>80களின் டாப்</strong>: பெர்செர்க் முதல் இறுதிச் சண்டை வரை, {0} "
"சிறந்த பழைய பள்ளி விளையாட்டுகள்."

msgctxt "WIZARD_LIST_TOP90S"
msgid ""
"<strong>Top of the 90s and 00s</strong>: from Boulder Dash to Progear, the "
"{0} best modern games."
msgstr ""
"<strong>90கள் மற்றும் 00களின் சிறந்தவை</strong>: Boulder Dash முதல் Progear "
"வரை, {0} சிறந்த நவீன கேம்கள்."

msgctxt "WIZARD_LIST_ICONS"
msgid ""
"<strong>Icons</strong>: {0} groundbreaking, revolutionary, unique, or just "
"very popular games. May not be very good by today's standards, or compared "
"to their follow-ups.<br /><strong>Warning:</strong> some games in this list "
"will not work well with a simple retro pad or arcade stick, and you might "
"need a spinner, double stick, racing wheel, etc. You can sometimes get good "
"results by changing the control settings in the options."
msgstr ""
"<strong>ஐகான்கள்</strong>: {0} அற்புதமான, புரட்சிகரமான, தனித்துவமான அல்லது "
"மிகவும் பிரபலமான கேம்கள். இன்றைய தரநிலைகள் அல்லது அவற்றின் "
"பின்தொடர்தல்களுடன் ஒப்பிடும்போது மிகவும் சிறப்பாக இருக்காது.<br "
"/><strong>எச்சரிக்கை:</strong> இந்தப் பட்டியலில் உள்ள சில கேம்கள் எளிமையான "
"ரெட்ரோ பேட் அல்லது ஆர்கேட் ச்டிக் மூலம் சரியாக வேலை செய்யாது, மேலும் "
"உங்களுக்கு ச்பின்னர், டபுள் ச்டிக், பந்தய சக்கரம் போன்றவை தேவைப்படலாம். சில "
"நேரங்களில் விருப்பங்களில் உள்ள கட்டுப்பாட்டு அமைப்புகளை மாற்றுவதன் மூலம் "
"நல்ல முடிவுகளைப் பெறலாம்."

msgctxt "WIZARD_LIST_MULTIPLAYER"
msgid ""
"<strong>Multiplayer</strong>: {0} great games to play with two players or "
"more, in coop or versus."
msgstr ""
"<strong>மல்டிபிளேயர்</strong>: {0} இரண்டு அல்லது அதற்கு மேற்பட்ட வீரர்களுடன்"
" கூட்டு அல்லது அதற்கு எதிராக விளையாடுவதற்கான சிறந்த கேம்கள்."

msgctxt "WIZARD_LIST_MULTIPLAYER_VS"
msgid ""
"<strong>Multiplayer (versus)</strong>: a very tight selection of {0} games "
"that are easy to pick up, to play against your friends for a few quick "
"rounds - perfect if you have an arcade cabinet to use at parties."
msgstr ""
"<strong>மல்டிபிளேயர் (எதிராக)</strong>: மிகக் கடினமான தேர்வு {0} கேம்களை "
"எளிதாக எடுக்கலாம், சில விரைவான சுற்றுகளுக்கு உங்கள் நண்பர்களுக்கு எதிராக "
"விளையாடலாம் - பார்ட்டிகளில் பயன்படுத்த ஆர்கேட் கேபினெட் இருந்தால் மிகவும் "
"பொருத்தமானது."

msgctxt "WIZARD_LIST_MULTIPLAYER_COOP"
msgid ""
"<strong>Multiplayer (coop)</strong>: a very tight selection of {0} games to "
"play with your family in friendly gaming sessions."
msgstr ""
"<strong>மல்டிபிளேயர் (கூப்)</strong>: நட்பு கேமிங் அமர்வுகளில் உங்கள் "
"குடும்பத்துடன் விளையாட {0} கேம்களின் மிகவும் இறுக்கமான தேர்வு."

msgctxt "WIZARD_LIST_NEOGEO"
msgid ""
"<strong>NeoGeo</strong>: the {0} best games on NeoGeo, the most popular and "
"enduring arcade system."
msgstr ""
"<strong>NeoGeo</strong>: நியோசியோவில் {0} சிறந்த கேம்கள், மிகவும் பிரபலமான "
"மற்றும் நீடித்த ஆர்கேட் அமைப்பு."

msgctxt "WIZARD_LIST_4BUTTONS"
msgid ""
"<strong>4 Buttons</strong>: {0} games to play on a controller limited to 4 "
"buttons."
msgstr ""
"<strong>4 பொத்தான்கள்</strong>: 4 பொத்தான்களுக்கு வரம்பிடப்பட்ட கன்ட்ரோலரில்"
" விளையாடுவதற்கான {0} கேம்கள்."

msgctxt "WIZARD_LIST_VERTICAL"
msgid ""
"<strong>Vertical</strong>: {0} games using a vertical screen, including lots"
" of shooters but also lots of other genres."
msgstr ""
"<strong>செங்குத்து</strong>: செங்குத்துத் திரையைப் பயன்படுத்தும் {0} "
"கேம்கள், இதில் ஏராளமான சூட்டர்கள் மற்றும் பல வகைகளும் அடங்கும்."

msgctxt "WIZARD_LIST_AKNF"
msgid ""
"<strong>\"All Killer, No Filler\"</strong>: great games, still fun to play "
"today, playable with an arcade stick, without too many duplicates, tested "
"and validated by the community.<br />Original lists from <a "
"href=\"http://forum.arcadecontrols.com/index.php/topic,149708.0.html\" "
"class=\"blank\">ArcadeControls forums</a>."
msgstr ""
"<strong>\"ஆல் கில்லர், ஃபில்லர் இல்லை\"</strong>: சிறந்த கேம்கள், இன்றும் "
"விளையாடுவது வேடிக்கையானது, ஆர்கேட் ச்டிக் மூலம் விளையாடலாம், அதிக நகல்கள் "
"இல்லாமல், சமூகத்தால் சோதிக்கப்பட்டு சரிபார்க்கப்பட்டது.<br />அசல் "
"பட்டியல்கள் <a href=\"http://forum.arcadecontrols.com/index.php/topic.08.07."
" class=\"blank\">ArcadeControls forums</a>."

msgctxt "WIZARD_LIST_AKNF_SHOOTING"
msgid "Shooting ({0} games)"
msgstr "படப்பிடிப்பு ({0} கேம்கள்)"

msgctxt "WIZARD_LIST_AKNF_RUNGUN"
msgid "Run and gun ({0} games)"
msgstr "ரன் மற்றும் துப்பாக்கி ({0} கேம்கள்)"

msgctxt "WIZARD_LIST_AKNF_PLATFORM"
msgid "Platform ({0} games)"
msgstr "பிளாட்ஃபார்ம் ({0} கேம்கள்)"

msgctxt "WIZARD_LIST_AKNF_FIGHTING"
msgid "Fighting ({0} games)"
msgstr "சண்டை ({0} கேம்கள்)"

msgctxt "WIZARD_LIST_AKNF_BEATHACK"
msgid "Beat'em up and hack & slash ({0} games)"
msgstr "பீட்அப் மற்றும் ஏக் & ச்லாச் ({0} கேம்கள்)"

msgctxt "WIZARD_LIST_AKNF_PUZZLE"
msgid "Puzzle ({0} games)"
msgstr "புதிர் ({0} கேம்கள்)"

msgctxt "WIZARD_LIST_AKNF_SPORTS"
msgid "Sports ({0} games)"
msgstr "விளையாட்டு ({0} விளையாட்டுகள்)"

msgctxt "WIZARD_LIST_AKNF_RACING"
msgid "Racing ({0} games)"
msgstr "பந்தயம் ({0} கேம்கள்)"

msgctxt "WIZARD_LIST_AKNF_CLASSICS"
msgid "Old school classics ({0} games)"
msgstr "பழைய பள்ளி கிளாசிக்ச் ({0} விளையாட்டுகள்)"

msgctxt "WIZARD_LIST_NOCLONE"
msgid "All the games, excluding duplicates ({0} games)"
msgstr "அனைத்து கேம்களும், நகல்களைத் தவிர்த்து ({0} கேம்கள்)"

msgctxt "WIZARD_LIST_CLEAN"
msgid ""
"All the games, excluding duplicates, console ports (Playchoice 10...), "
"mature/porn games, casino games, mahjong, etc  ({0} games)"
msgstr ""
"நகல்கள், கன்சோல் போர்ட்கள் (Playchoice 10...), முதிர்ந்த/ஆபாச கேம்கள், "
"கேசினோ கேம்கள், மஅ்சோங் போன்றவை ({0} கேம்கள்) தவிர்த்து அனைத்து கேம்களும்"

msgctxt "WIZARD_LIST_NEXT"
msgid "Next - set paths"
msgstr "அடுத்து - பாதைகளை அமைக்கவும்"

msgctxt "WIZARD_PATHS_TITLE"
msgid "Wizard: choose paths"
msgstr "வழிகாட்டி: பாதைகளைத் தேர்ந்தெடுக்கவும்"

msgctxt "WIZARD_PATHS_INTRO"
msgid ""
"Please select the paths of the source romset, and the target selection."
msgstr "மூல ரோம்செட்டின் பாதைகள் மற்றும் இலக்குத் தேர்வைத் தேர்ந்தெடுக்கவும்."

msgctxt "WIZARD_PATHS_START"
msgid "Start copy"
msgstr "நகலைத் தொடங்கவும்"

msgctxt "WIZARD_PATHS_NEXT"
msgid "Next - install overlays"
msgstr "அடுத்து - மேலடுக்குகளை நிறுவவும்"

msgctxt "WIZARD_PATHS_FINISH"
msgid "Finish"
msgstr "முடிக்கவும்"

msgctxt "DOWNLOAD_LIST_AKNF_SHOOTING"
msgid "<strong>All Killer, No Filler</strong> - Shooting ({0} games)"
msgstr ""
"<strong>அனைத்து கில்லர், இல்லை நிரப்பு</strong> - படப்பிடிப்பு ({0} கேம்கள்)"

msgctxt "DOWNLOAD_LIST_AKNF_RUNGUN"
msgid "<strong>All Killer, No Filler</strong> - Run and gun ({0} games)"
msgstr ""
"<strong>ஆல் கில்லர், ஃபில்லர் இல்லை</strong> - ரன் மற்றும் கன் ({0} கேம்கள்)"

msgctxt "DOWNLOAD_LIST_AKNF_PLATFORM"
msgid "<strong>All Killer, No Filler</strong> - Platform ({0} games)"
msgstr ""
"<strong>அனைத்து கில்லர், நிரப்பு இல்லை</strong> - இயங்குதளம் ({0} கேம்கள்)"

msgctxt "DOWNLOAD_LIST_AKNF_FIGHTING"
msgid "<strong>All Killer, No Filler</strong> - Fighting ({0} games)"
msgstr ""
"<strong>அனைத்து கொலையாளி, நிரப்பு இல்லை</strong> - சண்டை ({0} கேம்கள்)"

msgctxt "DOWNLOAD_LIST_AKNF_BEATHACK"
msgid ""
"<strong>All Killer, No Filler</strong> - Beat'em up and hack & slash ({0} "
"games)"
msgstr ""
"<strong>ஆல் கில்லர், ஃபில்லர் இல்லை</strong> - பீட்அப் மற்றும் ஏக் & ச்லாச் "
"({0} கேம்கள்)"

msgctxt "DOWNLOAD_LIST_AKNF_PUZZLE"
msgid "<strong>All Killer, No Filler</strong> - Puzzle ({0} games)"
msgstr "<strong>ஆல் கில்லர், ஃபில்லர் இல்லை</strong> - புதிர் ({0} கேம்கள்)"

msgctxt "DOWNLOAD_LIST_AKNF_SPORTS"
msgid "<strong>All Killer, No Filler</strong> - Sports ({0} games)"
msgstr ""
"<strong>ஆல் கில்லர், ஃபில்லர் இல்லை</strong> - விளையாட்டு ({0} கேம்கள்)"

msgctxt "DOWNLOAD_LIST_AKNF_RACING"
msgid "<strong>All Killer, No Filler</strong> - Racing ({0} games)"
msgstr "<strong>ஆல் கில்லர், ஃபில்லர் இல்லை</strong> - ரேசிங் ({0} கேம்கள்)"

msgctxt "DOWNLOAD_LIST_AKNF_CLASSICS"
msgid ""
"<strong>All Killer, No Filler</strong> - Old school classics ({0} games)"
msgstr ""
"<strong>ஆல் கில்லர், ஃபில்லர் இல்லை</strong> - பழைய பள்ளி கிளாசிக்ச் ({0} "
"கேம்கள்)"

msgctxt "ROMS_CHECKDAT_INTRO"
msgid ""
"Select a romset to check against a MAME/FBNeo DAT file, to make sure all "
"your roms have all the necessary files."
msgstr ""
"MAME/FBNeo DAT கோப்பினைச் சரிபார்க்க ரோம்செட்டைத் தேர்ந்தெடுக்கவும், உங்கள் "
"எல்லா ரோம்களிலும் தேவையான அனைத்து கோப்புகளும் உள்ளன என்பதை "
"உறுதிப்படுத்தவும்."

#, ignore-same
msgctxt "ROMS_CHECKDAT_ROMSET"
msgid "Romset"
msgstr "அறை அமைக்கப்பட்டது"

msgctxt "ROMS_CHECKDAT_ROMSET_DESC"
msgid "The path to the romset to check"
msgstr "சரிபார்க்க ரோம்செட் பாதை"

msgctxt "ROMS_CHECKDAT_DATFILE_HEADER"
msgid ""
"Choose a DAT/XML file containing the necessary informations.<br>The file "
"must contain detailed informations about the roms (names, hashes, etc)."
msgstr ""
"தேவையான தகவல்களைக் கொண்ட DAT/XML கோப்பைத் தேர்வு செய்யவும்.<br>கோப்பில் "
"ரோம்கள் (பெயர்கள், ஆச்கள் போன்றவை) பற்றிய விரிவான தகவல்கள் இருக்க வேண்டும்."

msgctxt "ROMS_CHECKDAT_DATFILE_HELPDECIDE"
msgid "How do I know which file to pick?"
msgstr "எந்த கோப்பை தேர்வு செய்வது என்று எனக்கு எப்படி தெரியும்?"

msgctxt "ROMS_CHECKDAT_DATFILE_CUSTOM"
msgid "Custom DAT file"
msgstr "தனிப்பயன் DAT கோப்பு"

msgctxt "ROMS_CHECKDAT_HELPDECIDE_TITLE"
msgid "How do I know which file to pick?"
msgstr "எந்த கோப்பை தேர்வு செய்வது என்று எனக்கு எப்படி தெரியும்?"

msgctxt "ROMS_CHECKDAT_HELPDECIDE_BODY"
msgid ""
"<h3>MAME - latest version</h3><p>You will need the DAT file corresponding to"
" your MAME version: checking against a DAT file from another version might "
"result in lots of errors.</p><p>If you're using an \"all in one\" "
"distribution like Batocera or Recalbox, you will need to find out which "
"version you're using, as each one contains a specific version of MAME and "
"FBNeo.</p><p><a "
"href=\"https://wiki.batocera.org/arcade#romset_version_per_stable_batocera_release\""
" class=\"blank\">Batocera version table</a><br><a "
"href=\"https://wiki.recalbox.com/fr/emulators/arcade/mame/libretro-mame\" "
"class=\"blank\">Recalbox latest version informations</a></p><p>You can then "
"download the matching zip from <a "
"href=\"https://www.progettosnaps.net/dats/MAME/\" "
"class=\"blank\">ProgettoSnaps</a> and get the DAT file located in "
"<em>DATsROMs</em>.</p><p>If you're simply using MAME on Windows, you can get"
" the XML by running <em class=\"code\">.mame.exe -listxml > mame-"
"roms.xml</em> in a command line.</p><h3>MAME 2003 Plus</h3><p>Mame 2003 "
"Plus, used on most distributions that target low-power devices (Knulli, "
"OnionOS, MuOS, but also Batocera and Recalbox on Raspberry Pi) is not on "
"ProgettoSnaps, and worse, different distributions use different romsets "
"without changing the MAME2003+ version number.<br>You will have to extract "
"the XML from MAME:</p><ul><li>Launch a game in MAME</li><li>Open the "
"RetroArch menu; check the manual to know how to do it, but it's usally a "
"combination of hotkey + some button</li><li>Navigate to Quick menu > Core "
"options > System > Activate MAME menu</li><li>Exit the menu and resume the "
"game (back multiple times > quick menu > resume)</li><li>Go to the bottom of"
" the black menu that appears over the game, and select \"Generate XML "
"DAT\"</li></ul><p>If you do not have these menu entries, it's possible that "
"you are simply using FBNeo.</p><p>The XML is usually created in the \"save\""
" folder (ex: <em>CurrentProfileMAME 2003-Plusmame2003-plus</em> on Miyoo "
"Mini/OnionOS, or <em>savesmame2003-plus</em> on Knulli) and called something"
" like <em>mame2003-plus.xml</em>.<br>If you can't find it at this location, "
"well, good luck.</p><h3>FBNeo</h3><p>If you are using FBNeo, just use the "
"provided file, as romsets usually don't change much between versions, except"
" by adding new games.</p>"
msgstr ""
"<h3>MAME - அண்மைக் கால பதிப்பு</h3><p>உங்கள் MAME பதிப்பிற்குத் தொடர்புடைய "
"DAT கோப்பு உங்களுக்குத் தேவைப்படும்: மற்றொரு பதிப்பிலிருந்து DAT கோப்பைச் "
"சரிபார்ப்பது பல பிழைகளை ஏற்படுத்தலாம்.</p><p>Batocera அல்லது Recalbox போன்ற "
"\"ஆல் இன் ஒன்\" விநியோகத்தைப் பயன்படுத்துகிறீர்கள் என்றால், நீங்கள் எந்தப் "
"பதிப்பைப் பயன்படுத்துகிறீர்கள் என்பதைக் கண்டறிய வேண்டும், <p> <a> ஒவ்வொரு "
"பதிப்பிலும் உள்ளது. "
"href=\"https://wiki.batocera.org/arcade#romset_version_per_stable_batocera_release\""
" class=\"blank\">Batocera பதிப்பு அட்டவணை</a><br><a "
"href=\"https://wiki.recalbox.com/fr/emulators/arcade/mame/libretro-mame\" "
"class=\"a "
"href=\"https://wiki.recalbox.com/fr/emulators/arcade/mame/Recalbox\"> <a "
"href=\"https://www.progettosnaps.net/dats/MAME/\" "
"class=\"blank\">ProgettoSnaps</a> இலிருந்து சிப்பைப் பொருத்தி, "
"<em>DATsROMs</em> இல் உள்ள DAT கோப்பைப் பெறுங்கள்.</p><p>நீங்கள் சாளரங்கள் "
"இல் MAMEஐப் பயன்படுத்தினால், <em.m -stmecode.xml-ஐ இயக்குவதன் மூலம் நீகுமொ "
"ஐப் பெறலாம். கட்டளை வரியில் mame-roms.xml</em> MAME2003+ பதிப்பு "
"எண்.<br>நீங்கள் MAME இலிருந்து நீகுமொ ஐப் பிரித்தெடுக்க "
"வேண்டும்:</p><ul><li>MAME இல் கேமைத் தொடங்கவும்</li><li>RetroArch மெனுவைத் "
"திறக்கவும்; அதை எப்படி செய்வது என்று அறிய கையேட்டைப் பார்க்கவும், ஆனால் இது "
"பொதுவாக ஆட்கி + சில பொத்தான்களின் கலவையாகும்</li><li>விரைவு மெனுவுக்குச் "
"செல்லவும் > கோர் விருப்பங்கள் > சிச்டம் > MAME மெனுவைச் "
"செயல்படுத்தவும்</li><li>மெனுவிலிருந்து வெளியேறி விளையாட்டை மீண்டும் "
"தொடங்கவும் (பல முறை > விரைவு பட்டியல் > ரெச்யூம்)</li><li>கருப்பு மெனுவைத் "
"தேர்ந்தெடுக்கவும், பிளாக் மெனுவைத் தேர்ந்தெடுக்கவும். "
"DAT\"</li></ul><p>உங்களிடம் இந்த பட்டியல் உள்ளீடுகள் இல்லையென்றால், நீங்கள் "
"FBNeo ஐப் பயன்படுத்திக் கொண்டிருக்கலாம்.</p><p>XML பொதுவாக \"சேமி\" "
"கோப்புறையில் உருவாக்கப்படும் (எ.கா: <em>CurrentProfileMAME "
"2003-Plusmame2003-plus</em> Miyoo இல் Knulli இல் "
"<em>savesmame2003-plus</em>) மற்றும் <em>mame2003-plus.xml</em> என "
"அழைக்கப்பட்டது.<br>இந்த இடத்தில் உங்களால் அதைக் கண்டுபிடிக்க முடியவில்லை "
"என்றால், நல்ல அதிர்ச்டம்.</p><h3>FBNeo</h3><p>நீங்கள் FBNeo ஐப் "
"பயன்படுத்துகிறீர்கள் எனில், வழங்கப்பட்ட கோப்பைத் தவிர்த்து, புதிய கோப்புகளை "
"மாற்றியமைக்க வேண்டாம். விளையாட்டுகள்.</p>"

msgctxt "ROMS_CHECKDAT_ACTION_HEADER"
msgid "Choose an action to complete"
msgstr "முடிக்க ஒரு செயலைத் தேர்ந்தெடுக்கவும்"

msgctxt "ROMS_CHECKDAT_ACTION_REPORT"
msgid "Check and report errors"
msgstr "பிழைகளை சரிபார்த்து புகாரளிக்கவும்"

msgctxt "ROMS_CHECKDAT_ACTION_CHANGE"
msgid "Check, fix and change the type of the romset"
msgstr "ரோம்செட்டின் வகையைச் சரிபார்த்து, சரிசெய்து மாற்றவும்"

msgctxt "ROMS_CHECKDAT_ACTION_CHANGE_EXPLANATION"
msgid ""
"A \"non-merged\" romset takes a bit more disk space but is much more modular"
" than other types of romsets.<br>ArcadeManager has only been tested with "
"\"non-merged\" DAT files, like the ones included above. It cannot transform "
"other kinds of DAT files to non-merged."
msgstr ""
"ஒரு \"இணைக்கப்படாத\" ரோம்செட் சற்று அதிக வட்டு இடத்தை எடுக்கும் ஆனால் மற்ற "
"வகை ரோம்செட்களை விட மிகவும் மட்டுப்படுத்தப்பட்டதாக உள்ளது.<br>ArcadeManager "
"மேலே உள்ளவை போன்ற \"இணைக்கப்படாத\" DAT கோப்புகளுடன் மட்டுமே சோதிக்கப்பட்டது."
" இது மற்ற வகையான DAT கோப்புகளை ஒன்றிணைக்காததாக மாற்ற முடியாது."

msgctxt "ROMS_CHECKDAT_OPTIONS"
msgid "Options"
msgstr "விருப்பங்கள்"

msgctxt "ROMS_CHECKDAT_ALLFILES"
msgid ""
"Check all files in the DAT - if unchecked, the tool only checks the files "
"present in the romset."
msgstr ""
"DAT இல் உள்ள அனைத்து கோப்புகளையும் சரிபார்க்கவும் - தேர்வு செய்யப்படவில்லை "
"என்றால், கருவி ரோம்செட்டில் உள்ள கோப்புகளை மட்டுமே சரிபார்க்கும்."

msgctxt "ROMS_CHECKDAT_SPEED_HEADER"
msgid "Make the check faster or slower, and more or less reliable."
msgstr ""
"காசோலையை வேகமாகவோ அல்லது மெதுவாகவோ, அதிகமாகவோ அல்லது குறைவாகவோ நம்பகமானதாக "
"மாற்றவும்."

msgctxt "ROMS_CHECKDAT_SPEED_FAST"
msgid "<strong>Fast:</strong> only check the file names, size and CRC"
msgstr ""
"<strong>வேகமானது:</strong> கோப்பு பெயர்கள், அளவு மற்றும் CRC ஆகியவற்றை "
"மட்டும் சரிபார்க்கவும்"

msgctxt "ROMS_CHECKDAT_SPEED_SLOW"
msgid "<strong>Slow:</strong> also check the file hashes"
msgstr "<strong>மெதுவாக:</strong> கோப்பு ஆச்களையும் சரிபார்க்கவும்"

msgctxt "ROMS_CHECKDAT_CSVFILTER"
msgid "CSV filter"
msgstr "CSV வடிகட்டி"

msgctxt "ROMS_CHECKDAT_CSVFILTER_DESC"
msgid "(Optional) Only check the roms present in the CSV file"
msgstr "(விரும்பினால்) CSV கோப்பில் உள்ள ரோம்களை மட்டும் சரிபார்க்கவும்"

msgctxt "ROMS_CHECKDAT_OTHER_HEADER"
msgid "Other checks"
msgstr "மற்ற காசோலைகள்"

msgctxt "ROMS_CHECKDAT_OTHER_BIOS"
msgid "Checks that the required bioses are present"
msgstr "தேவையான பயோச்கள் உள்ளதா என சரிபார்க்கிறது"

msgctxt "ROMS_CHECKDAT_ADDFOLDER"
msgid "Additional folder"
msgstr "கூடுதல் கோப்புறை"

msgctxt "ROMS_CHECKDAT_ADDFOLDER_DESC"
msgid ""
"(Optional) Another folder to search files inside to repair the romset with "
"(these files will not be modified)"
msgstr ""
"(விரும்பினால்) ரோம்செட்டை சரிசெய்ய, உள்ளே உள்ள கோப்புகளைத் தேட மற்றொரு "
"கோப்புறை (இந்த கோப்புகள் மாற்றப்படாது)"

msgctxt "ROMS_CHECKDAT_FIXFOLDER"
msgid "Target folder"
msgstr "இலக்கு கோப்புறை"

msgctxt "ROMS_CHECKDAT_FIXFOLDER_DESC"
msgid "The folder in which the romset will be recreated"
msgstr "ரோம்செட் மீண்டும் உருவாக்கப்படும் கோப்புறை"

msgctxt "ROMS_CHECKDAT_CHECK"
msgid "Check"
msgstr "சரிபார்"
