#: Libs/DICOM/Widgets/Resources/UI/ctkDICOMObjectListWidget.ui:68
#, qt-format
msgctxt "ctkDICOMObjectListWidget"
msgid ""
"<html><head/><body><p>Filter displayed metadata based on content in Tag, "
"Attribute, and Value columns.</p><p><span style=\" font-weight:600;\">Simple"
" search: </span>enter any text to show only those items that contains the "
"text. Use ? and * wildcards to represent <span style=\" font-"
"style:italic;\">any </span>single character or sequence of "
"characters.</p><p><span style=\" font-weight:600;\">Regular expression "
"search (for advanced users):</span> Enter <span style=\" font-"
"style:italic;\">regexp:</span> followed by a regular expression. For "
"example, show 3 specific tags, enter: <span style=\" font-"
"style:italic;\">regexp:0010,0010|0010,0020|0010,0030</span></p></body></html>"
msgstr ""
"<html><head/><body><p>குறிச்சொல், பண்புக்கூறு மற்றும் மதிப்பு நெடுவரிசைகளில்"
" உள்ள உள்ளடக்கத்தின் அடிப்படையில் மெட்டாடேட்டாவைக் காட்டுகிறது. </p><p><span"
" style=\" font-weight:600;\">எளிய தேடல்: </span>உரையைக் கொண்ட உருப்படிகளை "
"மட்டும் காண்பிக்க எந்த உரையையும் உள்ளிடவும். ? மற்றும் * காட்டுஅட்டைகள் "
"பயன்படுத்தி <span style=\" font-style:italic;\">ஏதேனும் </span> ஒற்றை "
"எழுத்து அல்லது எழுத்துக்களின் வரிசை குறிப்பிடவும்.</p><p><span style=\" "
"font-weight:600;\">வழக்க வெளியிடு தேடல் (திறன் பயனர்களுக்கு):</span> உள்ளிடு"
" <span style=\" font-style:italic;\">வழக்க வெளி:</span>தொடர்ந்து ஒரு வழக்க "
"வெளியிடு. எடுத்துக்காட்டாக, 3 குறிப்பிட்ட குறிச்சொற்களைக் காட்டு, "
"உள்ளிடவும்:<span style=\" font-"
"style:italic;\">regexp:0010,0010|0010,0020|0010,0030</span></p></body></html>"

