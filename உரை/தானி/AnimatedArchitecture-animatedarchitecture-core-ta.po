msgstr ""
"அரட்டையில் \"/AnimatedArchitecture SetOpenDirection <direction>\" என "
"தட்டச்சு செய்யவும். \"<direction>\" ஐ ஒரு திசையால் மாற்றவும்."

# Suggested in Weblate: ஒரு கட்டமைப்பின் திறக்கும் திசையை மாற்றுகிறது.
#, auto-java-messageformat
msgctxt "commands.set_open_direction.description"
msgid "Changes the opening direction of a structure."
msgstr "ஒரு கட்டமைப்பின் திறப்பு திசையை மாற்றுகிறது."

# Suggested in Weblate: {0} {1} {2}-க்கான செல்லுபடியாகும் சுழற்சி திசையல்ல!
#, auto-java-messageformat
msgctxt "commands.set_open_direction.error.invalid_rotation"
msgid "{0} is not a valid rotation direction for {1} {2}!"
msgstr "{0} என்பது {1} {2}க்கான சரியான சுழற்சி திசை அல்ல!"

# Suggested in Weblate: {0} {1} -இன் தொடக்க வழிகாட்டுதல்
# புதுப்பிக்கப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "commands.set_open_direction.success"
msgid "The opening direction of {0} {1} has been updated!"
msgstr "{0} {1} இன் தொடக்கத் திசை புதுப்பிக்கப்பட்டது!"

# Suggested in Weblate: செயலியில் "/AnimatedArchitecture SetOpenStatus
# <status>" என டைப் செய்யவும். "<status>"-ஐ புதிய நிலையாக மாற்றவும்.
#, auto-java-messageformat
msgctxt "commands.set_open_status.delayed.init"
msgid ""
"Type \"/AnimatedArchitecture SetOpenStatus <status>\" in chat. Replace "
"\"<status>\" by the new status."
msgstr ""
"அரட்டையில் \"/AnimatedArchitecture SetOpenStatus <status>\" என தட்டச்சு "
"செய்யவும். \"<status>\" ஐ புதிய நிலை மூலம் மாற்றவும்."

# Suggested in Weblate: ஒரு கட்டமைப்பை உண்மையில் நகர்த்தாமல் அதன் திறந்த
# நிலையை மாற்றுகிறது.
#, auto-java-messageformat
msgctxt "commands.set_open_status.description"
msgid "Changes the open status of a structure without actually moving it."
msgstr "ஒரு கட்டமைப்பை நகர்த்தாமல் அதன் திறந்த நிலையை மாற்றுகிறது."

# Suggested in Weblate: {0} {1} ஏற்கனவே {2}! எதுவும் மாற்றப்படவில்லை!
#, auto-java-messageformat
msgctxt "commands.set_open_status.error.status_not_changed"
msgid "{0} {1} is already {2}! Nothing was changed!"
msgstr "{0} {1} ஏற்கனவே {2}! எதுவும் மாறவில்லை!"

# Suggested in Weblate: {0} {1} திறந்த நிலை பண்பு இல்லை!
#, auto-java-messageformat
msgctxt "commands.set_open_status.error.missing_property"
msgid "{0} {1} does not have the open status property!"
msgstr "{0} {1} க்கு திறந்த நிலை சொத்து இல்லை!"

# Suggested in Weblate: {0} {1} -இன் திறந்த நிலை புதுப்பிக்கப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "commands.set_open_status.success"
msgid "The open status of {0} {1} has been updated!"
msgstr "{0} {1} இன் திறந்த நிலை புதுப்பிக்கப்பட்டது!"

# Suggested in Weblate: '{0}' பண்புக்கான செல்லாத மதிப்பு வகை!
#, auto-java-messageformat
msgctxt "commands.set_property.error.invalid_value_type"
msgid "Invalid value type for property '{0}'!"
msgstr "'{0}' சொத்தின் தவறான மதிப்பு வகை!"

# Suggested in Weblate: இந்த {1}-இல் '{0}' என்ற சொத்தைச் சேர்க்க உங்களுக்கு
# அனுமதி இல்லை!
#, auto-java-messageformat
msgctxt "commands.set_property.error.not_allowed_to_add_property"
msgid "You are not allowed to add property '{0}' to this {1}!"
msgstr "இந்த {1} இல் சொத்தை '{0}' சேர்க்க உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: இந்த {1}-க்கான '{0}' பண்புக்கூற்றை நீங்கள் திருத்த
# அனுமதிக்கப்படவில்லை!
#, auto-java-messageformat
msgctxt "commands.set_property.error.not_allowed_to_edit_property"
msgid "You are not allowed to edit property '{0}' for this {1}!"
msgstr "இந்த {1}க்கான '{0}' சொத்தை திருத்த உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: இந்த {1}-க்கான '{0}' சொத்தை நீக்க உங்களுக்கு அனுமதி
# இல்லை!
#, auto-java-messageformat
msgctxt "commands.set_property.error.not_allowed_to_remove_property"
msgid "You are not allowed to remove property '{0}' for this {1}!"
msgstr "இந்த {1} க்கு '{0}' சொத்தை அகற்ற உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: பண்பு '{0}' மறைக்கப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "commands.set_property.error.property_is_hidden"
msgid "Property '{0}' is hidden!"
msgstr "'{0}' சொத்து மறைக்கப்பட்டுள்ளது!"

# Suggested in Weblate: சொத்து '{0}' படிக்க மட்டுமேயானது!
#, auto-java-messageformat
msgctxt "commands.set_property.error.property_is_read_only"
msgid "Property '{0}' is read-only!"
msgstr "'{0}' சொத்து படிக்க மட்டுமே!"

# Suggested in Weblate: பண்பு '{0}' நீக்க முடியாது!
#, auto-java-messageformat
msgctxt "commands.set_property.error.property_is_unremovable"
msgid "Property '{0}' cannot be removed!"
msgstr "'{0}' சொத்தை அகற்ற முடியாது!"

# Suggested in Weblate: சொத்து '{0}' வெற்றிகரமாகப் புதுப்பிக்கப்பட்டது!
#, auto-java-messageformat
msgctxt "commands.set_property.success"
msgid "Property '{0}' updated successfully!"
msgstr "'{0}' சொத்து வெற்றிகரமாக புதுப்பிக்கப்பட்டது!"

# Suggested in Weblate: சந்தேகத்தைத் தீர்க்கப் பயன்படுகிறது.
#, auto-java-messageformat
msgctxt "commands.specify.description"
msgid "Used to help resolve ambiguity."
msgstr "தெளிவின்மையைத் தீர்க்க உதவும்."

# Suggested in Weblate: சர்வரில் உள்ள அனைத்து செயல்பாட்டு கட்டமைப்புகளையும்
# நிறுத்துகிறது.
#, auto-java-messageformat
msgctxt "commands.stop_structures.description"
msgid "Stops all active structures on the server."
msgstr "சேவையகத்தில் அனைத்து செயலில் உள்ள கட்டமைப்புகளையும் நிறுத்துகிறது."

# Suggested in Weblate: அனைத்து செயல்பாட்டு அமைப்புகளும் நிறுத்தப்பட்டுள்ளன!
#, auto-java-messageformat
msgctxt "commands.stop_structures.success"
msgid "All active structures have been stopped!"
msgstr "அனைத்து செயலில் உள்ள கட்டமைப்புகளும் நிறுத்தப்பட்டுள்ளன!"

# Suggested in Weblate: ஒரு கட்டமைப்பை மாற்றுகிறது.
#, auto-java-messageformat
msgctxt "commands.toggle.description"
msgid "Toggles a structure."
msgstr "ஒரு கட்டமைப்பை மாற்றுகிறது."

# Suggested in Weblate: {0} {1} ஏற்கனவே மூடப்பட்டிருப்பதால் மாற்ற முடியாது!
#, auto-java-messageformat
msgctxt "commands.toggle.error.already_closed"
msgid "{0} {1} cannot be toggled because it is already closed!"
msgstr "{0} {1} ஏற்கனவே மூடப்பட்டிருப்பதால் அதை மாற்ற முடியாது!"

# Suggested in Weblate: {0} {1} ஏற்கனவே திறந்திருப்பதால் திறக்க முடியாது!
#, auto-java-messageformat
msgctxt "commands.toggle.error.already_open"
msgid "{0} {1} cannot be opened because it is already open!"
msgstr "{0} {1} ஏற்கனவே திறந்திருப்பதால் திறக்க முடியாது!"

# Suggested in Weblate: {0} {1} மாற்ற முடியாது!
#, auto-java-messageformat
msgctxt "commands.toggle.error.cannot_toggle"
msgid "{0} {1} cannot be toggled!"
msgstr "{0} {1} ஐ மாற்ற முடியாது!"

# Suggested in Weblate: நீங்கள் {0} {1}-ஐ மாற்றுவதற்கு அனுமதி இல்லை!
#, auto-java-messageformat
msgctxt "commands.toggle.error.no_access"
msgid "You are not allowed to toggle {0} {1}!"
msgstr "{0} {1} ஐ மாற்ற உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: எந்த அமைப்புகளும் குறிப்பிடப்படவில்லை! தயவுசெய்து
# குறைந்தது 1 அமைப்பையாவது குறிப்பிடவும்!
#, auto-java-messageformat
msgctxt "commands.toggle.error.not_enough_structures"
msgid "No structures were specified! Please specify at least 1 structure!"
msgstr ""
"கட்டமைப்புகள் எதுவும் குறிப்பிடப்படவில்லை! குறைந்தது 1 கட்டமைப்பையாவது "
"குறிப்பிடவும்!"

# Suggested in Weblate: செயல்படும் உருவாக்குநர் செயல்முறை இல்லை!
#, auto-java-messageformat
msgctxt "commands.update_creator.error.no_creator_process"
msgid "There is no active creator process!"
msgstr "செயலில் உள்ள படைப்பாளர் செயல்முறை இல்லை!"

# Suggested in Weblate: நீங்கள் பயன்படுத்தும் AnimatedArchitecture-இன் பதிப்பை
# அச்சிடுகிறது.
#, auto-java-messageformat
msgctxt "commands.version.description"
msgid "Prints the version of AnimatedArchitecture you are using."
msgstr "நீங்கள் பயன்படுத்தும் அனிமேட்டட் ஆர்கிடெக்சரின் பதிப்பை அச்சிடுங்கள்."

# Suggested in Weblate: நீங்கள் தற்போது AnimatedArchitecture பதிப்பு {0}-ஐப்
# பயன்படுத்துகிறீர்கள்.
#, auto-java-messageformat
msgctxt "commands.version.success"
msgid "You are currently using AnimatedArchitecture version {0}."
msgstr ""
"நீங்கள் தற்போது AnimatedArchitecture பதிப்பு {0} ஐப் பயன்படுத்துகிறீர்கள்."

# Suggested in Weblate: தேடல் அளவுருக்களுக்கு ஒன்றுக்கு மேற்பட்ட கட்டமைப்புகள்
# பொருந்துகின்றன! நீங்கள் எதைப் பயன்படுத்த விரும்புகிறீர்கள் என்பதைத்
# தயவுசெய்து குறிப்பிடவும்.
#, auto-java-messageformat
msgctxt "input_request.specify_structure.header"
msgid ""
"More than 1 structure fits the search parameters! Please specify which one "
"you want to use."
msgstr ""
"1 க்கும் மேற்பட்ட அமைப்பு தேடல் அளவுருக்களுக்கு பொருந்துகிறது! நீங்கள் எதைப்"
" பயன்படுத்த விரும்புகிறீர்கள் என்பதைக் குறிப்பிடவும்."

# Suggested in Weblate: UID {0}: {1} {2}. தூரம்: {3} பிளாக்குகள்
#, auto-java-messageformat
msgctxt "input_request.specify_structure.structure_option"
msgid "UID {0}: {1} {2}. Distance: {3} blocks"
msgstr "UID {0}: {1} {2}. தூரம்: {3} தொகுதிகள்"

# Suggested in Weblate: இந்த அமைப்பைத் தேர்ந்தெடுக்க கிளிக் செய்யவும்.
#, auto-java-messageformat
msgctxt "input_request.specify_structure.structure_option.info"
msgid "Click to select this structure."
msgstr "இந்த கட்டமைப்பைத் தேர்ந்தெடுக்க சொடுக்கு செய்யவும்."

# Suggested in Weblate: பெரிய கதவு
#, auto-java-messageformat
msgctxt "structure.type.big_door"
msgid "Big Door"
msgstr "பெரிய கதவு"

# Suggested in Weblate: இந்தக் கருவி ஒரு பெரிய கதவை உருவாக்கப் பயன்படுகிறது.
#, auto-java-messageformat
msgctxt "creator.big_door.stick_lore"
msgid "This tool is used to create a big door."
msgstr "இந்த கருவி ஒரு பெரிய கதவை உருவாக்க பயன்படுகிறது."

# Suggested in Weblate: படி 1/3: தயவுசெய்து {0}-இன் முதல் மூலையைத்
# தேர்ந்தெடுக்கவும்.
#, auto-java-messageformat
msgctxt "creator.big_door.step_1"
msgid "Step 1/3: Please select the first corner of the {0}."
msgstr "படி 1/3: {0} இன் முதல் மூலையைத் தேர்ந்தெடுக்கவும்."

# Suggested in Weblate: படி 2/3: முதல் புள்ளி தேர்ந்தெடுக்கப்பட்டது!
# தயவுசெய்து இரண்டாவது புள்ளியைத் தேர்ந்தெடுக்கவும்!
# இரண்டாவது புள்ளி, முதல் புள்ளியிலிருந்து முடிந்தவரை தொலைவில் இருக்க
# வேண்டும், அதே நேரத்தில் அது {0}-இன் ஒரு பகுதியாக இருக்க வேண்டும்.
#, auto-java-messageformat
msgctxt "creator.big_door.step_2"
msgid ""
"Step 2/3: First point selected! Please select a second point!\n"
"The second point should be as far away from the first point while still being part of the {0}."
msgstr ""
"படி 2/3: முதல் புள்ளி தேர்ந்தெடுக்கப்பட்டது! இரண்டாவது புள்ளியைத் தேர்ந்தெடுக்கவும்! \n"
"இரண்டாவது புள்ளியானது {0} இன் பகுதியாக இருக்கும்போது முதல் புள்ளியிலிருந்து வெகு தொலைவில் இருக்க வேண்டும்."

# Suggested in Weblate: படி 3/3: இரண்டாவது புள்ளி தேர்ந்தெடுக்கப்பட்டது!
# தயவுசெய்து சுழற்சிப் புள்ளியை (அதாவது இணைப்பு) தேர்ந்தெடுக்கவும்.
# முழு {0} -ம் சுழலும் இந்தத் தடுக்குகளின் தூணையே சுற்றிவரும்.
#, auto-java-messageformat
msgctxt "creator.big_door.step_3"
msgid ""
"Step 3/3: Second point selected! Please select the rotation point (aka the hinge).\n"
"This is the column of blocks around which the entire {0} will rotate."
msgstr ""
"படி 3/3: இரண்டாவது புள்ளி தேர்ந்தெடுக்கப்பட்டது! தயவுசெய்து சுழற்சி புள்ளியைத் தேர்ந்தெடுக்கவும் (கீல்). \n"
"இது முழு {0} சுழலும் தொகுதிகளின் நெடுவரிசையாகும்."

# Suggested in Weblate: மணி
#, auto-java-messageformat
msgctxt "structure.type.clock"
msgid "Clock"
msgstr "கடிகை"

# Suggested in Weblate: இந்தக் கருவி ஒரு கடிகாரத்தை உருவாக்கப் பயன்படுகிறது.
#, auto-java-messageformat
msgctxt "creator.clock.stick_lore"
msgid "This tool is used to create a clock."
msgstr "இந்த கருவி கடிகாரத்தை உருவாக்க பயன்படுகிறது."

# Suggested in Weblate: படி 1/3: தயவுசெய்து {0}-இன் முதல் மூலையைத்
# தேர்ந்தெடுக்கவும்.
#, auto-java-messageformat
msgctxt "creator.clock.step_1"
msgid "Step 1/3: Please select the first corner of the {0}."
msgstr "படி 1/3: {0} இன் முதல் மூலையைத் தேர்ந்தெடுக்கவும்."

# Suggested in Weblate: படி 2/3: முதல் புள்ளி தேர்ந்தெடுக்கப்பட்டது!
# தயவுசெய்து இரண்டாவது புள்ளியைத் தேர்ந்தெடுக்கவும்!
# இரண்டாவது புள்ளி, முதல் புள்ளியிலிருந்து முடிந்தவரை தொலைவில் இருக்க
# வேண்டும், அதே நேரத்தில் அது {0}-இன் ஒரு பகுதியாக இருக்க வேண்டும்.
# கடிகாரங்களுக்கு சில தேவைகள் உள்ளன என்பதைக் கவனியுங்கள்:
# அது 2 பிளாக்குகள் ஆழமாகவும், சதுரமாகவும், ஒற்றைப்படை பிளாக்குகள் உயரமாகவும்
# இருக்க வேண்டும்.
#, auto-java-messageformat
msgctxt "creator.clock.step_2"
msgid ""
"Step 2/3: First point selected! Please select a second point!\n"
"The second point should be as far away from the first point while still being part of the {0}.\n"
"Note that the clocks have a few requirements:\n"
"It must be 2 blocks deep, square, and an odd number of blocks tall."
msgstr ""
"படி 2/3: முதல் புள்ளி தேர்ந்தெடுக்கப்பட்டது! இரண்டாவது புள்ளியைத் தேர்ந்தெடுக்கவும்! \n"
"இரண்டாவது புள்ளியானது {0} இன் பகுதியாக இருக்கும்போது முதல் புள்ளியிலிருந்து வெகு தொலைவில் இருக்க வேண்டும். \n"
"கடிகாரங்களுக்கு சில தேவைகள் உள்ளன என்பதை நினைவில் கொள்ளவும்: \n"
"இது 2 தொகுதிகள் ஆழமாகவும், சதுரமாகவும், ஒற்றைப்படை எண்ணிக்கையிலான தொகுதிகள் உயரமாகவும் இருக்க வேண்டும்."

# Suggested in Weblate: படி 3/3: இரண்டாவது புள்ளி தேர்ந்தெடுக்கப்பட்டது! மணி
# கை எங்கு இருக்க வேண்டும் என்பதைத் தயவுசெய்து குறிப்பிடவும். மணி {0}-இன்
# விரும்பிய பக்கத்தில் உள்ள எந்தவொரு தொகுதியையும் தேர்ந்தெடுக்கவும்.
#, auto-java-messageformat
msgctxt "creator.clock.step_3"
msgid ""
"Step 3/3: Second point selected! Please specify where the hour arm should "
"be. Just select any block on the desired side of the {0}."
msgstr ""
"படி 3/3: இரண்டாவது புள்ளி தேர்ந்தெடுக்கப்பட்டது! மணி கை எங்கே இருக்க "
"வேண்டும் என்பதைக் குறிப்பிடவும். {0} இன் விரும்பிய பக்கத்தில் ஏதேனும் ஒரு "
"தொகுதியைத் தேர்ந்தெடுக்கவும்."

# Suggested in Weblate: தேர்ந்தெடுக்கப்பட்ட பகுதி ({1} ஆல் {2}) மிகவும்
# சிறியது! ஒரு {0} குறைந்தது 3x3 ஆக இருக்க வேண்டும்!
#, auto-java-messageformat
msgctxt "creator.clock.error.too_small"
msgid ""
"The selected area ({1} by {2}) is too small! A {0} must be at least 3x3!"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட பகுதி ({1} by {2}) மிகவும் சிறியது! ஒரு {0} குறைந்தது "
"3x3 ஆக இருக்க வேண்டும்!"

# Suggested in Weblate: கடிகார முகத்தின் தேர்ந்தெடுக்கப்பட்ட பரிமாணங்கள் ({0}
# x {1}) விசித்திரமாக இல்லை!
#, auto-java-messageformat
msgctxt "creator.clock.error.not_odd"
msgid "The selected dimensions of the clock face ({0} by {1}) are not odd!"
msgstr ""
"கடிகார முகத்தின் தேர்ந்தெடுக்கப்பட்ட பரிமாணங்கள் ({0} by {1}) ஒற்றைப்படை "
"அல்ல!"

# Suggested in Weblate: கடிகார முகத்தின் தேர்ந்தெடுக்கப்பட்ட பரிமாணங்கள் ({0}
# x {1}) ஒரு சதுரத்தை உருவாக்குவதில்லை!
#, auto-java-messageformat
msgctxt "creator.clock.error.not_square"
msgid ""
"The selected dimensions of the clock face ({0} by {1}) do not form a square!"
msgstr ""
"கடிகார முகத்தின் தேர்ந்தெடுக்கப்பட்ட பரிமாணங்கள் ({0} by {1}) சதுரத்தை "
"உருவாக்குவதில்லை!"

# Suggested in Weblate: இந்த {0} -இன் ஆழம் 2 ஆக இருக்க வேண்டும், ஆனால் அது:
# {1}!
#, auto-java-messageformat
msgctxt "creator.clock.error.not_2_deep"
msgid "The depth of this {0} should be 2, but it was: {1}!"
msgstr "இந்த {0} இன் ஆழம் 2 ஆக இருக்க வேண்டும், ஆனால் அது: {1}!"

# Suggested in Weblate: தவறான மணி கைப் பக்கம்!
#, auto-java-messageformat
msgctxt "creator.clock.error.invalid_hour_arm_side"
msgid "Invalid hour arm side!"
msgstr "தவறான மணிநேர கைப்பக்கம்!"

# Suggested in Weblate: இழுப்பாலம்
#, auto-java-messageformat
msgctxt "structure.type.drawbridge"
msgid "Drawbridge"
msgstr "டிராப்ரிட்ச்"

# Suggested in Weblate: இந்தக் கருவி ஒரு இறங்குப் பாலத்தை உருவாக்கப்
# பயன்படுகிறது.
#, auto-java-messageformat
msgctxt "creator.draw_bridge.stick_lore"
msgid "This tool is used to create a drawbridge."
msgstr "இந்த கருவி ஒரு டிராபிரிட்சை உருவாக்க பயன்படுகிறது."

# Suggested in Weblate: படி 1/3: தயவுசெய்து {0}-இன் முதல் மூலையைத்
# தேர்ந்தெடுக்கவும்.
#, auto-java-messageformat
msgctxt "creator.draw_bridge.step_1"
msgid "Step 1/3: Please select the first corner of the {0}."
msgstr "படி 1/3: {0} இன் முதல் மூலையைத் தேர்ந்தெடுக்கவும்."

# Suggested in Weblate: படி 2/3: முதல் புள்ளி தேர்ந்தெடுக்கப்பட்டது!
# தயவுசெய்து இரண்டாவது புள்ளியைத் தேர்ந்தெடுக்கவும்!
# இரண்டாவது புள்ளி, முதல் புள்ளியிலிருந்து முடிந்தவரை தொலைவில் இருக்க
# வேண்டும், அதே நேரத்தில் அது {0}-இன் ஒரு பகுதியாக இருக்க வேண்டும்.
#, auto-java-messageformat
msgctxt "creator.draw_bridge.step_2"
msgid ""
"Step 2/3: First point selected! Please select a second point!\n"
"The second point should be as far away from the first point while still being part of the {0}."
msgstr ""
"படி 2/3: முதல் புள்ளி தேர்ந்தெடுக்கப்பட்டது! இரண்டாவது புள்ளியைத் தேர்ந்தெடுக்கவும்! \n"
"இரண்டாவது புள்ளியானது {0} இன் பகுதியாக இருக்கும்போது முதல் புள்ளியிலிருந்து வெகு தொலைவில் இருக்க வேண்டும்."

# Suggested in Weblate: படி 3/3: இரண்டாவது புள்ளி தேர்ந்தெடுக்கப்பட்டது!
# தயவுசெய்து சுழற்சிப் புள்ளியை (அதாவது இணைப்பு) தேர்ந்தெடுக்கவும்.
#, auto-java-messageformat
msgctxt "creator.draw_bridge.step_3"
msgid ""
"Step 3/3: Second point selected! Please select the rotation point (aka the "
"hinge)."
msgstr ""
"படி 3/3: இரண்டாவது புள்ளி தேர்ந்தெடுக்கப்பட்டது! தயவுசெய்து சுழற்சி "
"புள்ளியைத் தேர்ந்தெடுக்கவும் (கீல்)."

# Suggested in Weblate: கொடி
#, auto-java-messageformat
msgctxt "structure.type.flag"
msgid "Flag"
msgstr "கொடி"

# Suggested in Weblate: இந்தக் கருவி ஒரு கொடியை உருவாக்கப் பயன்படுகிறது.
#, auto-java-messageformat
msgctxt "creator.flag.stick_lore"
msgid "This tool is used to create a flag."
msgstr "இந்தக் கருவி கொடியை உருவாக்கப் பயன்படுகிறது."

# Suggested in Weblate: படி 1/3: தயவுசெய்து {0}-இன் முதல் மூலையைத்
# தேர்ந்தெடுக்கவும்.
#, auto-java-messageformat
msgctxt "creator.flag.step_1"
msgid "Step 1/3: Please select the first corner of the {0}."
msgstr "படி 1/3: {0} இன் முதல் மூலையைத் தேர்ந்தெடுக்கவும்."

# Suggested in Weblate: படி 2/3: முதல் புள்ளி தேர்ந்தெடுக்கப்பட்டது!
# தயவுசெய்து இரண்டாவது புள்ளியைத் தேர்ந்தெடுக்கவும்!
# இரண்டாவது புள்ளி, முதல் புள்ளியிலிருந்து முடிந்தவரை தொலைவில் இருக்க
# வேண்டும், அதே நேரத்தில் அது {0}-இன் ஒரு பகுதியாக இருக்க வேண்டும்.
# உருவாகும் பகுதி, x அல்லது z அச்சில் 1 பிளாக் ஆழம் கொண்டிருக்க வேண்டும்
# என்பதைக் கவனத்தில் கொள்ளவும்.
#, auto-java-messageformat
msgctxt "creator.flag.step_2"
msgid ""
"Step 2/3: First point selected! Please select a second point!\n"
"The second point should be as far away from the first point while still being part of the {0}.\n"
"Note that the resulting area has to be 1 block deep in either the x or z axis."
msgstr ""
"படி 2/3: முதல் புள்ளி தேர்ந்தெடுக்கப்பட்டது! இரண்டாவது புள்ளியைத் தேர்ந்தெடுக்கவும்! \n"
"இரண்டாவது புள்ளியானது {0} இன் பகுதியாக இருக்கும்போது முதல் புள்ளியிலிருந்து வெகு தொலைவில் இருக்க வேண்டும். \n"
"இதன் விளைவாக வரும் பகுதி ஃச் அல்லது சட் அச்சில் 1 தொகுதி ஆழமாக இருக்க வேண்டும் என்பதை நினைவில் கொள்ளவும்."

# Suggested in Weblate: படி 3/3: இரண்டாவது புள்ளி தேர்ந்தெடுக்கப்பட்டது!
# மின்சாரக் கம்பத்தில் மின்மாற்றி ( {0} ) இணைக்கப்பட்டுள்ள புள்ளியைத்
# தேர்ந்தெடுக்கவும். இது தேர்ந்தெடுக்கப்பட்ட பகுதியின் ஒரு மூலையாக இருக்க
# வேண்டும்!
#, auto-java-messageformat
msgctxt "creator.flag.step_3"
msgid ""
"Step 3/3: Second point selected! Please select the point where the {0} is "
"attached to the pole. This has to be a corner of the selected area!"
msgstr ""
"படி 3/3: இரண்டாவது புள்ளி தேர்ந்தெடுக்கப்பட்டது! துருவத்தில் {0} "
"இணைக்கப்பட்டுள்ள புள்ளியைத் தேர்ந்தெடுக்கவும். இது தேர்ந்தெடுக்கப்பட்ட "
"பகுதியின் ஒரு மூலையில் இருக்க வேண்டும்!"

# Suggested in Weblate: கார் நிறுத்துமிடம் கதவு
