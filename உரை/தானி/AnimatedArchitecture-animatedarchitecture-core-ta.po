msgstr "படைப்பாளி"

# Suggested in Weblate: நிர்வாகம்
#, auto-java-messageformat
msgctxt "constants.permission_level.admin"
msgid "Admin"
msgstr "நிர்வாகி"

# Suggested in Weblate: பயனர்
#, auto-java-messageformat
msgctxt "constants.permission_level.user"
msgid "User"
msgstr "பயனர்"

# Suggested in Weblate: அனுமதியில்லை
#, auto-java-messageformat
msgctxt "constants.permission_level.no_permission"
msgid "No Permission"
msgstr "இசைவு இல்லை"

# Suggested in Weblate: திற
#, auto-java-messageformat
msgctxt "constants.open_status.open"
msgid "Open"
msgstr "திற"

# Suggested in Weblate: மூடப்பட்டது
#, auto-java-messageformat
msgctxt "constants.open_status.closed"
msgid "Closed"
msgstr "மூடப்பட்டது"

# Suggested in Weblate: பூட்டப்பட்டது
#, auto-java-messageformat
msgctxt "constants.locked_status.locked"
msgid "Locked"
msgstr "பூட்டப்பட்டுள்ளது"

# Suggested in Weblate: திறக்கப்பட்டது
#, auto-java-messageformat
msgctxt "constants.locked_status.unlocked"
msgid "Unlocked"
msgstr "திறக்கப்பட்டது"

# Suggested in Weblate: வெற்றி!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.success"
msgid "Success!"
msgstr "வெற்றி!"

# Suggested in Weblate: கட்டமைப்புகள் எதுவும் காணப்படவில்லை!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.no_structures_found"
msgid "No structures found!"
msgstr "கட்டமைப்புகள் எதுவும் இல்லை!"

# Suggested in Weblate: {0} "{1}" பிஸியாக உள்ளது! பின்னர் மீண்டும்
# முயற்சிக்கவும்.
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.structure_is_busy"
msgid "{0} \"{1}\" is busy! Try again later."
msgstr "{0} \"{1}\" பிசியாக உள்ளது! பிறகு முயற்சிக்கவும்."

# Suggested in Weblate: {0} "{1}" பூட்டப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.structure_is_locked"
msgid "{0} \"{1}\" is locked!"
msgstr "{0} \"{1}\" பூட்டப்பட்டுள்ளது!"

# Suggested in Weblate: {0} "{1}" அதன் அனிமேஷனைத் தவிர்க்க முடியாது!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.cannot_skip"
msgid "{0} \"{1}\" cannot skip its animation!"
msgstr "{0} \"{1}\" அதன் அனிமேசனைத் தவிர்க்க முடியாது!"

# Suggested in Weblate: {0} "{1}" மாற்றியமைக்க முடியவில்லை!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.invalid_state"
msgid "{0} \"{1}\" could not be toggled!"
msgstr "{0} \"{1}\" ஐ மாற்ற முடியவில்லை!"

# Suggested in Weblate: " {0} " "{1}" என்பதை மாற்றுவதற்கான கோரிக்கை ரத்து
# செய்யப்பட்டது!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.cancelled"
msgid "Request to toggle {0} \"{1}\" was cancelled!"
msgstr "{0} \"{1}\" ஐ மாற்றுவதற்கான கோரிக்கை ரத்து செய்யப்பட்டது!"

# Suggested in Weblate: {0} "{1}" என்பது மாற்றுவதற்கு மிகவும் பெரியது!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.too_big"
msgid "{0} \"{1}\" is too big to toggle!"
msgstr "{0} \"{1}\" மாற்ற முடியாத அளவுக்கு பெரியது!"

# Suggested in Weblate: இந்தப் பகுதியில் நீங்கள் " {0} " "{1}" நகர்த்த
# அனுமதிக்கப்படவில்லை!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.no_permission_for_location"
msgid "You are not allowed to move {0} \"{1}\" in this region!"
msgstr "இந்தப் பகுதியில் {0} \"{1}\" ஐ நகர்த்த உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: {0} "{1}" தடுக்கப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.obstructed"
msgid "{0} \"{1}\" is obstructed!"
msgstr "{0} \"{1}\" தடைபட்டுள்ளது!"

# Suggested in Weblate: {0} "{1}"-க்கான திறந்த திசையைக் கண்டுபிடிக்க
# முடியவில்லை!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.no_direction"
msgid "Could not find an open direction for {0} \"{1}\"!"
msgstr "{0} \"{1}\"க்கான திறந்த திசையைக் கண்டுபிடிக்க முடியவில்லை!"

# Suggested in Weblate: {0} "{1}" ஏற்கனவே திறக்கப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.already_open"
msgid "{0} \"{1}\" is already open!"
msgstr "{0} \"{1}\" ஏற்கனவே திறக்கப்பட்டுள்ளது!"

# Suggested in Weblate: {0} "{1}" ஏற்கனவே மூடப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.already_closed"
msgid "{0} \"{1}\" is already closed!"
msgstr "{0} \"{1}\" ஏற்கனவே மூடப்பட்டுள்ளது!"

# Suggested in Weblate: {0} "{1}"-ஐ மாற்றுவதில் தோல்வி!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.generic_toggle_failure"
msgid "Failed to toggle {0} \"{1}\"!"
msgstr "{0} \"{1}\" ஐ மாற்றுவதில் தோல்வி!"

# Suggested in Weblate: கட்டமைப்பு வகை "{0}" முடக்கப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "constants.structure_toggle_result.type_disabled"
msgid "The structure type \"{0}\" is disabled!"
msgstr "கட்டமைப்பு வகை \"{0}\" முடக்கப்பட்டுள்ளது!"

# Suggested in Weblate: {0} "{1}" திறக்கத் தவறியது! இந்த அமைப்பு வகையை மட்டும்
# மாற்ற முடியும்!
#, auto-java-messageformat
msgctxt "structure_action.open.error.type_has_no_open_status"
msgid "Failing to open {0} \"{1}\"! This structure type can only be toggled!"
msgstr ""
"{0} \"{1}\" திறக்க முடியவில்லை! இந்த கட்டமைப்பு வகையை மட்டுமே மாற்ற "
"முடியும்!"

# Suggested in Weblate: {0} "{1}" ஐ மூடத் தவறியது! இந்த அமைப்பு வகையை மட்டும்
# மாற்றியமைக்க முடியும்!
#, auto-java-messageformat
msgctxt "structure_action.close.error.type_has_no_open_status"
msgid "Failing to close {0} \"{1}\"! This structure type can only be toggled!"
msgstr ""
"{0} \"{1}\" ஐ மூட முடியவில்லை! இந்த கட்டமைப்பு வகையை மட்டுமே மாற்ற முடியும்!"

# Suggested in Weblate: அனிமேட்டட் ஆர்க்கிடெக்சர் கருவி
#, auto-java-messageformat
msgctxt "tool_user.base.stick_name"
msgid "AnimatedArchitecture Tool"
msgstr "அனிமேசன் கட்டிடக்கலை கருவி"

# Suggested in Weblate: இந்தப் பகுதியில் நீங்கள் கட்டமைப்புகளை உருவாக்க
# அனுமதிக்கப்படவில்லை!
#, auto-java-messageformat
msgctxt "tool_user.base.error.no_permission_for_location"
msgid "You are not allowed to create structures in this region!"
msgstr "இந்த பகுதியில் கட்டமைப்புகளை உருவாக்க உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: இந்தக் கருவி ஒரு பவர் பிளாக்கின் இருப்பிடத்தை மாற்றப்
# பயன்படுகிறது.
#, auto-java-messageformat
msgctxt "tool_user.powerblock_relocator.stick_lore"
msgid "This tool is used to change the location of a power block."
msgstr "பவர் பிளாக்கின் இடத்தை மாற்ற இந்த கருவி பயன்படுகிறது."

# Suggested in Weblate: உங்களுக்கு ஒரு AnimatedArchitecture Relocator குச்சி
# வழங்கப்பட்டுள்ளது! ஒரு பவர் பிளாக்கின் இருப்பிடத்தை மாற்ற இந்தக் கருவியைப்
# பயன்படுத்தலாம். ஒரு புதிய பிளாக்கை அடிக்கவும்!
#, auto-java-messageformat
msgctxt "tool_user.powerblock_relocator.init"
msgid ""
"You have been given an AnimatedArchitecture Relocator stick! You can use "
"this tool to change the location of a powerblock. Just hit a new block!"
msgstr ""
"உங்களுக்கு அனிமேசன் ஆர்கிடெக்சர் ரீலோகேட்டர் ச்டிக் கொடுக்கப்பட்டுள்ளது! "
"பவர் பிளாக்கின் இருப்பிடத்தை மாற்ற இந்தக் கருவியைப் பயன்படுத்தலாம். ஒரு "
"புதிய தொகுதியைத் தாக்குங்கள்!"

# Suggested in Weblate: மின்சக்தித் தொகுதி இடமாற்றம் வெற்றிகரமாக முடிந்தது!
# இங்கு ஒரு மின்சக்தித் தொகுதியை (பூர்வநிலை: தங்கத் தொகுதி) வைக்க
# மறக்காதீர்கள்! இல்லையெனில், இது வேலை செய்யாது!
#, auto-java-messageformat
msgctxt "tool_user.powerblock_relocator.success"
msgid ""
"Power Block Relocation successful! Don't forget to put a powerblock "
"(default: Gold block) here! Otherwise, it won't work!"
msgstr ""
"பவர் பிளாக் இடமாற்றம் வெற்றி! இங்கே ஒரு பவர் பிளாக்கை (இயல்புநிலை: தங்கத் "
"தொகுதி) வைக்க மறக்காதீர்கள்! இல்லையெனில், அது வேலை செய்யாது!"

# Suggested in Weblate: தவறான பவர் பிளாக் இருப்பிடம் தேர்ந்தெடுக்கப்பட்டது!
# இருப்பிடம், {0}-இன் அதே உலகில் இருக்க வேண்டும்!
#, auto-java-messageformat
msgctxt "tool_user.powerblock_relocator.error.world_mismatch"
msgid ""
"Invalid Power Block Location selected! The location must be in the same "
"world as the {0}!"
msgstr ""
"தவறான பவர் பிளாக் இடம் தேர்ந்தெடுக்கப்பட்டது! இருப்பிடம் {0} உள்ள அதே உலகில்"
" இருக்க வேண்டும்!"

# Suggested in Weblate: புதிய இடம் பழைய இடத்தைப் போன்றதுதான்! எதுவும்
# மாறவில்லை!
#, auto-java-messageformat
msgctxt "tool_user.powerblock_relocator.error.location_unchanged"
msgid "New location is the same as the old position! Nothing changed!"
msgstr "புதிய இடம் பழைய நிலையே! எதுவும் மாறவில்லை!"

# Suggested in Weblate: இந்தக் கருவி ஒரு பவர் பிளாக்கை ஆய்வு செய்யப்
# பயன்படுகிறது.
#, auto-java-messageformat
msgctxt "tool_user.powerblock_inspector.stick_lore"
msgid "This tool is used to inspect a power block."
msgstr "இந்த கருவி பவர் பிளாக்கை ஆய்வு செய்ய பயன்படுகிறது."

# Suggested in Weblate: உங்களுக்கு AnimatedArchitecture பவர் பிளாக்
# இன்ஸ்பெக்டர் ஸ்டிக் வழங்கப்பட்டுள்ளது! ஒரு பவர் பிளாக்கை ஆய்வு செய்ய இந்த
# கருவியைப் பயன்படுத்தலாம். ஒரு பிளாக்கைத் தட்டினால் போதும்!
#, auto-java-messageformat
msgctxt "tool_user.powerblock_inspector.init"
msgid ""
"You have been given an AnimatedArchitecture Power Block Inspector Stick! You"
" can use this tool to inspect a powerblock. Just hit a block!"
msgstr ""
"உங்களுக்கு அனிமேசன் ஆர்கிடெக்சர் பவர்பிளாக் இன்ச்பெக்டர் ச்டிக் "
"கொடுக்கப்பட்டுள்ளது! பவர் பிளாக்கை ஆய்வு செய்ய இந்தக் கருவியைப் "
"பயன்படுத்தலாம். ஒரு பிளாக் அடிக்க!"

# Suggested in Weblate: தேர்ந்தெடுக்கப்பட்ட இடத்தில் கட்டமைப்புகள் எதுவும்
# காணப்படவில்லை!
#, auto-java-messageformat
msgctxt "tool_user.power_block_inspected.error.no_structures_found"
msgid "No structures found at the selected location!"
msgstr "தேர்ந்தெடுக்கப்பட்ட இடத்தில் கட்டமைப்புகள் எதுவும் இல்லை!"

# Suggested in Weblate: தேர்ந்தெடுக்கப்பட்ட இடத்தில் இந்தக் கட்டமைப்புகளுக்கான
# மின்சாரப் பெட்டகங்கள் உள்ளன:
#, auto-java-messageformat
msgctxt "tool_user.power_block_inspected.result.header"
msgid "The selected location contains the power blocks for these structures:"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட இடத்தில் இந்த கட்டமைப்புகளுக்கான பவர் பிளாக்குகள் உள்ளன:"

# Suggested in Weblate: இவ்வளவு பெரிய {0} -ஐ உருவாக்க உங்களுக்கு அனுமதி இல்லை.
# நீங்கள் {1} பிளாக்குகளைத் தேர்ந்தெடுத்தீர்கள், ஆனால் நீங்கள் {2,number,#.#}
# பிளாக்குகளுக்கு மட்டுமே வரையறுக்கப்பட்டுள்ளீர்கள்!
#, auto-java-messageformat
msgctxt "creator.base.error.area_too_big"
msgid ""
"You are not allowed to create a {0} this big. You selected {1} blocks, but "
"you are limited to {2,number,#.#} blocks!"
msgstr ""
"இவ்வளவு பெரிய {0} ஐ உருவாக்க உங்களுக்கு இசைவு இல்லை. நீங்கள் {1} தொகுதிகளைத்"
" தேர்ந்தெடுத்துள்ளீர்கள், ஆனால் நீங்கள் {2,எண்,#.#} தொகுதிகளுக்கு மட்டுமே "
"உள்ளீர்கள்!"

# Suggested in Weblate: உருவாக்கும் செயல்முறை ரத்து செய்யப்பட்டுள்ளது.
#, auto-java-messageformat
msgctxt "creator.base.error.creation_cancelled"
msgid "The creation process has been cancelled."
msgstr "உருவாக்கும் செயல்முறை ரத்துசெய்யப்பட்டது."

# Suggested in Weblate: இந்த {0}-ஐ உருவாக்க உங்களிடம் போதுமான நிதி இல்லை!
# உங்களுக்கு ${1,number,#.##} தேவைப்படும்.
#, auto-java-messageformat
msgctxt "creator.base.error.insufficient_funds"
msgid ""
"You have insufficient funds to create this {0}! You'd need ${1,number,#.##}."
msgstr ""
"இந்த {0}ஐ உருவாக்க உங்களிடம் போதுமான பொருள் இல்லை! உங்களுக்கு "
"${1,number,#.##} தேவைப்படும்."

# Suggested in Weblate: நீங்கள் பவர்பிளாக்குகளை அவற்றின் சொந்த {0}-களுக்குள்
# வைக்க முடியாது!
#, auto-java-messageformat
msgctxt "creator.base.error.powerblock_inside_structure"
msgid "You cannot place powerblocks inside their own {0}!"
msgstr "பவர் பிளாக்குகளை அவற்றின் சொந்த {0} க்குள் வைக்க முடியாது!"

# Suggested in Weblate: பவர்பிளாக் {0}-இலிருந்து மிகவும் தொலைவில் உள்ளது! இது
# {0}-இலிருந்து {1} பிளாக் தொலைவில் உள்ளது, ஆனால் உங்கள் வரம்பு {2} பிளாக்
# மட்டுமே!
#, auto-java-messageformat
msgctxt "creator.base.error.powerblock_too_far"
msgid ""
"The powerblock is too far from the {0}!\n"
"It is {1} blocks from the {0}, while your limit is only {2} blocks!"
msgstr ""
"பவர்பிளாக் {0} இலிருந்து வெகு தொலைவில் உள்ளது! \n"
"இது {0} இலிருந்து {1} தொகுதிகள், உங்கள் வரம்பு {2} தொகுதிகள் மட்டுமே!"

# Suggested in Weblate: இந்த {0} நகர்த்த நீங்கள் விரும்பும் பிளாக்குகளின்
# எண்ணிக்கை வரம்பை மீறுகிறது!
# நீங்கள் {1} பிளாக்குகளைத் தேர்ந்தெடுத்துள்ளீர்கள், ஆனால் உங்கள் வரம்பு {2}
# பிளாக்குகள் மட்டுமே!
#, auto-java-messageformat
msgctxt "creator.base.error.blocks_to_move_too_far"
msgid ""
"The number of blocks you want this {0} to move exceeds the limit!\n"
"You selected {1} blocks, while your limit is only {2} blocks!"
msgstr ""
"இந்த {0}ஐ நகர்த்த நீங்கள் விரும்பும் தொகுதிகளின் எண்ணிக்கை வரம்பை மீறுகிறது! \n"
"நீங்கள் {1} தொகுதிகளைத் தேர்ந்தெடுத்தீர்கள், உங்கள் வரம்பு {2} தொகுதிகள் மட்டுமே!"

# Suggested in Weblate: தவறான சுழற்சிப் புள்ளி தேர்ந்தெடுக்கப்பட்டது! மீண்டும்
# முயற்சிக்கவும்!
#, auto-java-messageformat
msgctxt "creator.base.error.invalid_rotation_point"
msgid "Invalid rotation point selected! Try again!"
msgstr "தவறான சுழற்சி புள்ளி தேர்ந்தெடுக்கப்பட்டது! மீண்டும் முயற்சிக்கவும்!"

# Suggested in Weblate: "{0}" என்பது ஒரு {1}-க்கு செல்லுபடியாகும் பெயர் அல்ல!
# தயவுசெய்து மீண்டும் முயற்சிக்கவும்.
#, auto-java-messageformat
msgctxt "creator.base.error.invalid_name"
msgid "''{0}'' is not a valid name for a {1}! Please try again."
msgstr "''{0}'' என்பது {1}க்கான சரியான பெயர் அல்ல! மீண்டும் முயற்சிக்கவும்."

# Suggested in Weblate: "{0}" என்பது செல்லுபடியாகும் விருப்பம் அல்ல!
# தயவுசெய்து மீண்டும் முயற்சிக்கவும்.
#, auto-java-messageformat
msgctxt "creator.base.error.invalid_option"
msgid "''{0}'' is not a valid option! Please try again."
msgstr "''{0}'' சரியான விருப்பம் அல்ல! மீண்டும் முயற்சிக்கவும்."

# Suggested in Weblate: நேரம் முடிந்துவிட்டது! உருவாக்கம் நிறுத்தப்பட்டது,
# தயவுசெய்து மீண்டும் முயற்சிக்கவும்.
#, auto-java-messageformat
msgctxt "creator.base.error.timed_out"
msgid "Time's up! Creation was aborted, please try again."
msgstr "நேரம் முடிந்தது! உருவாக்கம் நிறுத்தப்பட்டது, மீண்டும் முயற்சிக்கவும்."

# Suggested in Weblate: தவறான உலகம் தேர்ந்தெடுக்கப்பட்டது!
#, auto-java-messageformat
msgctxt "creator.base.error.world_mismatch"
msgid "Invalid world selected!"
msgstr "தவறான உலகம் தேர்ந்தெடுக்கப்பட்டது!"

# Suggested in Weblate: {0} உங்கள் கணக்கிலிருந்து திரும்பப் பெறப்பட்டுள்ளது.
#, auto-java-messageformat
msgctxt "creator.base.money_withdrawn"
msgid "{0} has been withdrawn from your account."
msgstr "உங்கள் கணக்கிலிருந்து {0} திரும்பப் பெறப்பட்டது."

# Suggested in Weblate: இந்த {0} -க்கு {1,number,#.##} செலவாகும். {2} / {3}.
#, auto-java-messageformat
msgctxt "creator.base.confirm_structure_price"
msgid "This {0} will cost {1,number,#.##}. {2} / {3}."
msgstr "இந்த {0}க்கு {1,எண்,#.##} செலவாகும். {2} / {3}."

# Suggested in Weblate: இந்தக் கட்டமைப்பை வாங்க கிளிக் செய்யவும்!
#, auto-java-messageformat
msgctxt "creator.base.confirm_structure_price.arg2.hint"
msgid "Click to buy this structure!"
msgstr "இந்த கட்டமைப்பை வாங்க சொடுக்கு செய்யவும்!"

# Suggested in Weblate: ஏற்றுக்கொள்
#, auto-java-messageformat
msgctxt "creator.base.confirm_structure_price.arg2.message"
msgid "Accept"
msgstr "ஏற்றுக்கொள்"

# Suggested in Weblate: உருவாக்கும் செயல்முறையை நிறுத்த கிளிக் செய்யவும்!
#, auto-java-messageformat
msgctxt "creator.base.confirm_structure_price.arg3.hint"
msgid "Click to abort the creation process!"
msgstr "உருவாக்கும் செயல்முறையை நிறுத்த சொடுக்கு செய்யவும்!"

# Suggested in Weblate: கழிவு
#, auto-java-messageformat
msgctxt "creator.base.confirm_structure_price.arg3.message"
msgid "Refuse"
msgstr "மறுக்கவும்"

# Suggested in Weblate: தயவுசெய்து, "/AnimatedArchitecture SetName <message>"
# என்ற கட்டளையைப் பயன்படுத்தி {0} -க்கு ஒரு செய்தியை வழங்குவதன் மூலம்
# தொடங்குங்கள்.
#, auto-java-messageformat
msgctxt "creator.base.give_name"
msgid ""
"Please start by giving the {0} a message using the command: "
"\"/AnimatedArchitecture SetName <message>\""
msgstr ""
"\"/AnimatedArchitecture SetName <message>\" என்ற கட்டளையைப் பயன்படுத்தி {0} "
"க்கு ஒரு செய்தியைக் கொடுப்பதன் மூலம் தொடங்கவும்."

# Suggested in Weblate: உங்களுக்கு ஒரு {0} கிரியேட்டர் ஸ்டிக்
# வழங்கப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "creator.base.received_tool"
msgid "You have been given a {0} Creator Stick!"
msgstr "உங்களுக்கு {0} கிரியேட்டர் ச்டிக் கொடுக்கப்பட்டுள்ளது!"

# Suggested in Weblate: செயல்முறை தொடங்கப்பட்டது! இந்தச் செயல்முறையை முடிக்க
# உங்களுக்கு 15 நிமிடங்கள் உள்ளன!
# நீங்கள் இந்தச் செயல்முறையை முன்கூட்டியே ரத்து செய்ய விரும்பினால், ` {0} `
# என்ற கட்டளையை இயக்கவும்.
#, auto-java-messageformat
msgctxt "creator.base.init"
msgid ""
"Process initiated! You have 15 minutes to complete this process!\n"
"If you wish to cancel the process sooner, run the {0} command."
msgstr ""
"செயல்முறை தொடங்கப்பட்டது! இந்த செயல்முறையை முடிக்க உங்களுக்கு 15 நிமிடங்கள் உள்ளன! \n"
"செயல்முறையை விரைவில் ரத்து செய்ய விரும்பினால், {0} கட்டளையை இயக்கவும்."

# Suggested in Weblate: இதை மாற்ற இங்கே கிளிக் செய்யவும்!
#, auto-java-messageformat
msgctxt "creator.base.property.info.clickable_message"
msgid "Click here to change this!"
msgstr "இதை மாற்ற இங்கே சொடுக்கு செய்யவும்!"

# Suggested in Weblate: கட்டமைப்பு வகை: {0}
#, auto-java-messageformat
msgctxt "creator.base.property.type"
msgid "Structure Type: {0}"
msgstr "Structure தட்டச்சு: {0}"

# Suggested in Weblate: இருப்பிடங்கள்: {0}
#, auto-java-messageformat
msgctxt "creator.base.property.cuboid"
msgid "Coordinates: {0}"
msgstr "ஒருங்கிணைப்புகள்: {0}"

# Suggested in Weblate: சுழற்சிப் புள்ளி: {0}
#, auto-java-messageformat
msgctxt "creator.base.property.rotation_point"
msgid "Rotation Point: {0}"
msgstr "சுழற்சி புள்ளி: {0}"

# Suggested in Weblate: பவர்பிளாக்: {0}
#, auto-java-messageformat
msgctxt "creator.base.property.power_block_position"
msgid "Powerblock: {0}"
msgstr "பவர்பிளாக்: {0}"

# Suggested in Weblate: திறந்த நிலை: {0}
#, auto-java-messageformat
msgctxt "creator.base.property.open_status"
msgid "Open status: {0}"
msgstr "திறந்த நிலை: {0}"

# Suggested in Weblate: திறந்த திசை: {0}
#, auto-java-messageformat
msgctxt "creator.base.property.open_direction"
msgid "Open direction: {0}"
msgstr "திறந்த திசை: {0}"

# Suggested in Weblate: இயக்க வேண்டிய தடைகள்: {0}
#, auto-java-messageformat
msgctxt "creator.base.property.blocks_to_move"
msgid "Blocks to move: {0}"
msgstr "நகர்த்துவதற்கான தொகுதிகள்: {0}"

# Suggested in Weblate: பவர் பிளாக்கிற்கான இடத்தைத் தயவுசெய்து
# தேர்ந்தெடுக்கவும்.
#, auto-java-messageformat
msgctxt "creator.base.set_power_block"
msgid "Please select a location for the powerblock."
msgstr "பவர் பிளாக்கிற்கான இடத்தைத் தேர்ந்தெடுக்கவும்."

# Suggested in Weblate: {0} எந்த வழியில் திறக்கப்பட வேண்டும் என்பதைத்
# தயவுசெய்து குறிப்பிடவும். உங்கள் விருப்பங்கள் இதோ:
#, auto-java-messageformat
msgctxt "creator.base.set_open_direction"
msgid ""
"Please specify which way you want the {0} to open. These are your options:"
msgstr ""
"எந்த வழியில் {0} திறக்க வேண்டும் என்பதைக் குறிப்பிடவும். இவை உங்கள் "
"விருப்பங்கள்:"

# Suggested in Weblate: இந்த வழியைப் பயன்படுத்த கிளிக் செய்யவும்!
#, auto-java-messageformat
msgctxt "creator.base.set_open_direction.arg0.hint"
msgid "Click to use this direction!"
msgstr "இந்த திசையைப் பயன்படுத்த சொடுக்கு செய்யவும்!"

# Suggested in Weblate: தயவுசெய்து இந்த {0} தற்போது {1} அல்லது {2} என உள்ளதா
