#, auto-java-messageformat
msgctxt "creator.base.set_open_status"
msgid "Please specify if this {0} is currently {1} or {2}."
msgstr "இந்த {0} தற்போது {1} அல்லது {2} என்பதை குறிப்பிடவும்."

# Suggested in Weblate: 'திறந்திருக்கும்' என அமைக்க கிளிக் செய்யவும்.
#, auto-java-messageformat
msgctxt "creator.base.set_open_status.arg2.open.hint"
msgid "Click to set to ''open''."
msgstr "\"திற\" என்பதை அமைக்க சொடுக்கு செய்யவும்."

# Suggested in Weblate: 'மூடப்பட்டது' என அமைக்க கிளிக் செய்யவும்.
#, auto-java-messageformat
msgctxt "creator.base.set_open_status.arg2.closed.hint"
msgid "Click to set to ''closed''."
msgstr "''மூடப்பட்டது'' என அமைக்க சொடுக்கு செய்யவும்."

# Suggested in Weblate: இந்த வகைக்கு '2d' பகுதி தேவை, ஆனால்
# தேர்ந்தெடுக்கப்பட்ட பகுதி இந்த நிபந்தனையைப் பூர்த்தி செய்யவில்லை!
# தேர்ந்தெடுக்கப்பட்ட பகுதி 1 பரிமாணத்தில் 1 பிளாக் ஆழம் கொண்டிருப்பதை
# உறுதிசெய்யவும்.
#, auto-java-messageformat
msgctxt "creator.base.second_pos_not_2d"
msgid ""
"This type requires a '2d' area, but the selected area does not meet this constraint!\n"
"Please make sure that the selected area has a depth of 1 block in 1 dimension."
msgstr ""
"இந்த வகைக்கு '2d' பகுதி தேவை, ஆனால் தேர்ந்தெடுக்கப்பட்ட பகுதி இந்த தடையை சந்திக்கவில்லை! \n"
"தேர்ந்தெடுக்கப்பட்ட பகுதியில் 1 பரிமாணத்தில் 1 தொகுதி ஆழம் உள்ளதா என்பதை உறுதிப்படுத்தவும்."

# Suggested in Weblate: {0} உருவாக்கம் வெற்றிகரமானது!
#, auto-java-messageformat
msgctxt "creator.base.success"
msgid "{0} creation successful!"
msgstr "{0} உருவாக்கம் வெற்றி!"

# Suggested in Weblate: தேர்ந்தெடுக்கப்பட்ட நிலை மூலையில் இல்லை!
#, auto-java-messageformat
msgctxt "creator.base.position_not_in_corner"
msgid "The selected position is not in a corner!"
msgstr "தேர்ந்தெடுக்கப்பட்ட நிலை ஒரு மூலையில் இல்லை!"

# Suggested in Weblate: ஏறக்குறைய முடிந்தது! தயவுசெய்து இந்த அமைப்புகளை
# மதிப்பாய்வு செய்யவும்:
#, auto-java-messageformat
msgctxt "creator.base.review_result.header"
msgid "Almost done! Please review these settings:"
msgstr "கிட்டத்தட்ட முடிந்தது! இந்த அமைப்புகளை மதிப்பாய்வு செய்யவும்:"

# Suggested in Weblate: {0} / {1}
#, auto-java-messageformat
msgctxt "creator.base.review_result.footer"
msgid "{0} / {1}"
msgstr "{0} / {1}"

# Suggested in Weblate: உருவாக்கும் செயல்முறையை முடிக்க கிளிக் செய்யவும்!
#, auto-java-messageformat
msgctxt "creator.base.review_result.footer.arg0.hint"
msgid "Click to finish the creation process!"
msgstr "உருவாக்கும் செயல்முறையை முடிக்க சொடுக்கு செய்க!"

# Suggested in Weblate: உறுதிப்படுத்து
#, auto-java-messageformat
msgctxt "creator.base.review_result.footer.arg0.message"
msgid "Confirm"
msgstr "உறுதிப்படுத்தவும்"

# Suggested in Weblate: உருவாக்கும் செயல்முறையை ரத்து செய்ய கிளிக் செய்யவும்!
#, auto-java-messageformat
msgctxt "creator.base.review_result.footer.arg1.hint"
msgid "Click to cancel the creation process!"
msgstr "உருவாக்கும் செயல்முறையை ரத்து செய்ய சொடுக்கு செய்யவும்!"

# Suggested in Weblate: ரத்து செய்
#, auto-java-messageformat
msgctxt "creator.base.review_result.footer.arg1.message"
msgid "Cancel"
msgstr "ரத்துசெய்"

# Suggested in Weblate: நீங்கள் இப்போது {1} {2}-இன் ஒரு {0}!
#, auto-java-messageformat
msgctxt "commands.add_owner.added_player_notification"
msgid "You are now a(n) {0} of {1} {2}!"
msgstr "நீங்கள் இப்போது {2} {1} இல் (n) {0} ஆக உள்ளீர்கள்!"

# Suggested in Weblate: செயலியில் "/AnimatedArchitecture AddOwner <playerName>
# [permission]" என டைப் செய்யவும். "<playerName>" என்பதை நீங்கள் உரிமையாளராகச்
# சேர்க்க விரும்பும் வீரரின் பெயரால் மாற்றவும்.
#, auto-java-messageformat
msgctxt "commands.add_owner.delayed.init"
msgid ""
"Type \"/AnimatedArchitecture AddOwner <playerName> [permission]\" in chat. "
"Replace \"<playerName>\" by the name of the player you want to add as owner."
msgstr ""
"அரட்டையில் \"/AnimatedArchitecture AddOwner <playerName> [permission]\" என "
"டைப் செய்யவும். நீங்கள் உரிமையாளராக சேர்க்க விரும்பும் பிளேயரின் பெயரால் "
"\"<playerName>\" ஐ மாற்றவும்."

# Suggested in Weblate: ஒரு கட்டமைப்புக்கு மற்றொரு உரிமையாளரைச் சேர்க்கவும்.
#, auto-java-messageformat
msgctxt "commands.add_owner.description"
msgid "Add another owner to a structure."
msgstr "ஒரு கட்டமைப்பிற்கு மற்றொரு உரிமையாளரைச் சேர்க்கவும்."

# Suggested in Weblate: இந்த பிளேயரின் அனுமதி நிலையை மாற்ற முடியாது!
#, auto-java-messageformat
msgctxt "commands.add_owner.error.targeting_prime_owner"
msgid "You cannot change the permission level of this player!"
msgstr "இந்த பிளேயரின் இசைவு அளவை உங்களால் மாற்ற முடியாது!"

# Suggested in Weblate: நீங்கள் இந்த {0}-ன் உரிமையாளர் அல்ல!
#, auto-java-messageformat
msgctxt "commands.add_owner.error.not_an_owner"
msgid "You are not an owner of this {0}!"
msgstr "நீங்கள் இந்த {0} இன் உரிமையாளர் அல்ல!"

# Suggested in Weblate: இந்த {0}-இல் இணை உரிமையாளர்களைச் சேர்க்க உங்களுக்கு
# அனுமதி இல்லை!
#, auto-java-messageformat
msgctxt "commands.add_owner.error.not_allowed"
msgid "You are not allowed to add co-owners to this {0}!"
msgstr "இந்த {0} இல் இணை உரிமையாளர்களைச் சேர்க்க உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: உங்களால் உயர் அனுமதி நிலை கொண்ட இணை உரிமையாளர்களை
# மட்டுமே சேர்க்க முடியாது!
#, auto-java-messageformat
msgctxt "commands.add_owner.error.cannot_assign_below_self"
msgid "You cannot only add co-owners with a higher permission level!"
msgstr "அதிக இசைவு நிலை கொண்ட இணை உரிமையாளர்களை மட்டும் சேர்க்க முடியாது!"

# Suggested in Weblate: "{0}" ஏற்கனவே இந்த {1}-இன் (இணை) உரிமையாளர் ஆவார்!
#, auto-java-messageformat
msgctxt "commands.add_owner.error.target_already_owner"
msgid "''{0}'' is already a (co-)owner of this {1}!"
msgstr "''{0}'' ஏற்கனவே இந்த {1} இன் (இணை) உரிமையாளர்!"

# Suggested in Weblate: இலக்கு அனுமதி நிலை {0} செல்லாதது!
#, auto-java-messageformat
msgctxt "commands.add_owner.error.invalid_target_permission"
msgid "Target permission level {0} is invalid!"
msgstr "இலக்கு இசைவு நிலை {0} தவறானது!"

# Suggested in Weblate: புதிய உரிமையாளரின் அனுமதி நிலை.
#, auto-java-messageformat
msgctxt "commands.add_owner.param.permission_level.description"
msgid "The permission level of the new owner."
msgstr "புதிய உரிமையாளரின் இசைவு நிலை."

# Suggested in Weblate: {0} இப்போது {2}-இன் ஒரு {1} ஆகும்!
#, auto-java-messageformat
msgctxt "commands.add_owner.success"
msgid "{0} is now a(n) {1} of the {2}!"
msgstr "{0} இப்போது {2} இல் ஒரு(n) {1}!"

# Suggested in Weblate: குறிப்பிடப்பட்ட செயல் ரத்து செய்யப்பட்டது!
#, auto-java-messageformat
msgctxt "commands.base.error.action_cancelled"
msgid "The intended action was cancelled!"
msgstr "திட்டமிட்ட செயல் ரத்து செய்யப்பட்டது!"

# Suggested in Weblate: கட்டளைக்காகக் காத்திருக்கும் நிலையில் ரத்து
# செய்யப்பட்டது: {0}
#, auto-java-messageformat
msgctxt "commands.base.error.cancelled"
msgid "Cancelled waiting for command: {0}"
msgstr "கட்டளைக்கான காத்திருப்பு ரத்துசெய்யப்பட்டது: {0}"

# Suggested in Weblate: வழங்கப்பட்ட கட்டமைப்பைக் காண முடியவில்லை!
#, auto-java-messageformat
msgctxt "commands.base.error.cannot_find_target_structure"
msgid "Could not find the provided structure!"
msgstr "வழங்கப்பட்ட கட்டமைப்பைக் கண்டுபிடிக்க முடியவில்லை!"

# Suggested in Weblate: கட்டளையைச் செயல்படுத்தத் தவறிவிட்டது! தயவுசெய்து ஒரு
# நிர்வாகியைத் தொடர்பு கொள்ளவும்!
#, auto-java-messageformat
msgctxt "commands.base.error.generic"
msgid "Failed to execute command! Please contact an administrator!"
msgstr "கட்டளையை செயல்படுத்துவதில் தோல்வி! நிர்வாகியைத் தொடர்பு கொள்ளவும்!"

# Suggested in Weblate: உள்ளீட்டைச் செயலாக்கத் தவறியது: நாங்கள் எந்த
# உள்ளீட்டையும் எதிர்பார்க்கவில்லை!
#, auto-java-messageformat
msgctxt "commands.base.error.no_pending_process"
msgid "Failed to process input: We are not waiting for any input!"
msgstr ""
"உள்ளீட்டைச் செயல்படுத்துவதில் தோல்வி: எந்த உள்ளீட்டிற்காகவும் நாங்கள் "
"காத்திருக்கவில்லை!"

# Suggested in Weblate: இந்தக் கட்டளையைப் பயன்படுத்த உங்களுக்கு அனுமதி இல்லை!
#, auto-java-messageformat
msgctxt "commands.base.error.no_permission_for_command"
msgid "You do not have permission to use this command!"
msgstr "இந்தக் கட்டளையைப் பயன்படுத்த உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: நாங்கள் தற்போது கட்டளை உள்ளீட்டிற்காகக்
# காத்திருக்கவில்லை! உங்கள் உள்ளீடு புறக்கணிக்கப்படும்!
#, auto-java-messageformat
msgctxt "commands.base.error.not_waiting"
msgid ""
"We are not currently waiting for command input! Your input will be ignored!"
msgstr ""
"நாங்கள் தற்போது கட்டளை உள்ளீட்டிற்காக காத்திருக்கவில்லை! உங்கள் உள்ளீடு "
"புறக்கணிக்கப்படும்!"

# Suggested in Weblate: விளையாட்டாளர்களால் மட்டுமே இந்தக் கட்டளையைப்
# பயன்படுத்த முடியும்!
#, auto-java-messageformat
msgctxt "commands.base.error.only_available_for_players"
msgid "Only players can use this command!"
msgstr "இந்த கட்டளையை வீரர்கள் மட்டுமே பயன்படுத்த முடியும்!"

# Suggested in Weblate: கட்டளைக்கான உள்ளீட்டை எதிர்பார்த்து காலாவதியானது: {0}
#, auto-java-messageformat
msgctxt "commands.base.error.timed_out"
msgid "Timed out waiting for input for command: {0}"
msgstr "கட்டளைக்கான உள்ளீட்டிற்காக காத்திருக்கும் நேரம் முடிந்தது: {0}"

# Suggested in Weblate: வழங்கிய உள்ளீடு '{0}' எதிர்பாராதது! மீண்டும்
# முயற்சிக்கவும்.
#, auto-java-messageformat
msgctxt "commands.base.error.unexpected_input_type"
msgid "Provided input '{0}' is unexpected! Please try again."
msgstr "'{0}' உள்ளீடு எதிர்பாராதது! மீண்டும் முயற்சிக்கவும்."

# Suggested in Weblate: உங்கள் உள்ளீட்டிற்காகக் காத்திருக்கும் எந்தவொரு
# செயல்முறையையும் ரத்து செய்கிறது.
#, auto-java-messageformat
msgctxt "commands.cancel.description"
msgid "Cancels any process waiting for your input."
msgstr ""
"உங்கள் உள்ளீட்டிற்காக காத்திருக்கும் எந்த செயல்முறையையும் ரத்துசெய்கிறது."

# Suggested in Weblate: நாங்கள் எதற்காகவும் காத்திருக்கவில்லை! எதுவும் ரத்து
# செய்யப்படவில்லை.
#, auto-java-messageformat
msgctxt "commands.cancel.no_process"
msgid "We are not waiting for anything! Nothing was cancelled."
msgstr "நாங்கள் எதற்கும் காத்திருக்கவில்லை! எதுவும் ரத்து செய்யப்படவில்லை."

# Suggested in Weblate: செயல்முறை ரத்து செய்யப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "commands.cancel.success"
msgid "The process has been cancelled!"
msgstr "செயல்முறை ரத்து செய்யப்பட்டது!"

# Suggested in Weblate: மூடக்கூடியதாக இருந்தால், ஒரு கட்டமைப்பை மூடுகிறது.
#, auto-java-messageformat
msgctxt "commands.close.description"
msgid "Closes a structure if it can be closed."
msgstr "ஒரு கட்டமைப்பை மூட முடியுமானால் அதை மூடுகிறது."

# Suggested in Weblate: AnimatedArchitecture செய்ய விரும்பும் ஒரு செயலை
# உறுதிப்படுத்துகிறது.
#, auto-java-messageformat
msgctxt "commands.confirm.description"
msgid "Confirms an action AnimatedArchitecture wants to perform."
msgstr "AnimatedArchitecture செய்ய விரும்பும் செயலை உறுதிப்படுத்துகிறது."

# Suggested in Weblate: உறுதிப்படுத்த ஒன்றுமில்லை!
#, auto-java-messageformat
msgctxt "commands.confirm.error.no_confirmation_request"
msgid "There is nothing to confirm!"
msgstr "உறுதிப்படுத்த எதுவும் இல்லை!"

# Suggested in Weblate: கன்சோலில் பிழைதிருத்தத் தகவலை எழுதுகிறது.
#, auto-java-messageformat
msgctxt "commands.debug.description"
msgid "Writes debug information to the console."
msgstr "கன்சோலில் பிழைத்திருத்தத் தகவலை எழுதுகிறது."

# Suggested in Weblate: பிழைதிருத்தத் தகவல் கன்சோலில் எழுதப்பட்டுள்ளது!
#, auto-java-messageformat
msgctxt "commands.debug.success"
msgid "The debug information has been written to the console!"
msgstr "பிழைத்திருத்தத் செய்தி கன்சோலில் எழுதப்பட்டது!"

# Suggested in Weblate: ஒரு கட்டமைப்பை நீக்குகிறது.
#, auto-java-messageformat
msgctxt "commands.delete.description"
msgid "Deletes a structure."
msgstr "ஒரு கட்டமைப்பை நீக்குகிறது."

# Suggested in Weblate: இந்த {0}-ஐ நீக்க உங்களுடைய அனுமதியில்லை!
#, auto-java-messageformat
msgctxt "commands.delete.error.not_allowed"
msgid "You are not allowed to delete this {0}!"
msgstr "இந்த {0}ஐ நீக்க உங்களுக்கு இசைவு இல்லை!"

# Suggested in Weblate: {0} {1} நீக்கப்பட்டுள்ளது.
#, auto-java-messageformat
msgctxt "commands.delete.success"
msgid "{0} {1} has been deleted."
msgstr "{0} {1} நீக்கப்பட்டது."

# Suggested in Weblate: ஒரு கட்டமைப்பின் தகவல்களை அச்சிடுகிறது.
#, auto-java-messageformat
msgctxt "commands.info.description"
msgid "Prints the information of a structure."
msgstr "ஒரு கட்டமைப்பின் தகவலை அச்சிடுகிறது."

# Suggested in Weblate: முதன்மை உரிமையாளர்: {0}
#, auto-java-messageformat
msgctxt "commands.info.output.prime_owner"
