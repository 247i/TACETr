#, java-printf-format
msgctxt "certificate_notification_connection_security"
msgid "Connection security"
msgstr "இணைப்பு பாதுகாப்பு"

#, java-printf-format
msgctxt "certificate_notification_user_interaction"
msgid "Please review the certificate"
msgstr "சான்றிதழை மதிப்பாய்வு செய்யவும்"

#, java-printf-format
msgctxt "service_rejected_temporarily"
msgid "Certificate temporarily rejected"
msgstr "சான்றிதழ் தற்காலிகமாக நிராகரிக்கப்பட்டது"

#.  TrustCertificateActivity
#, java-printf-format
msgctxt "trust_certificate_unknown_certificate_found"
msgid ""
"cert4android has encountered an unknown certificate. Do you want to trust "
"it?"
msgstr ""
"cert4android அறியப்படாத சான்றிதழை எதிர்கொண்டது. நீங்கள் அதை நம்ப வேண்டுமா?"

#, java-printf-format
msgctxt "trust_certificate_x509_certificate_details"
msgid "X509 certificate details"
msgstr "X509 சான்றிதழ் விவரங்கள்"

#, java-printf-format
msgctxt "trust_certificate_issued_for"
msgid "Issued for"
msgstr "க்காக வழங்கப்பட்டது"

#, java-printf-format
msgctxt "trust_certificate_issued_by"
msgid "Issued by"
msgstr "வழங்கியது"

#, java-printf-format
msgctxt "trust_certificate_validity_period"
msgid "Validity period"
msgstr "செல்லுபடியாகும் காலம்"

#, java-printf-format
msgctxt "trust_certificate_validity_period_value"
msgid "%1$s – %2$s (will not be enforced)"
msgstr "%1$s – %2$s (செயல்படுத்தப்படாது)"

#, java-printf-format
msgctxt "trust_certificate_fingerprints"
msgid "Fingerprints"
msgstr "கைரேகைகள்"

#, java-printf-format
msgctxt "trust_certificate_fingerprint_verified"
msgid "I have manually verified the whole fingerprint."
msgstr "கைரேகை முழுவதையும் கைமுறையாக சரிபார்த்துள்ளேன்."

#, java-printf-format
msgctxt "trust_certificate_accept"
msgid "Accept"
msgstr "ஏற்றுக்கொள்"

#, java-printf-format
msgctxt "trust_certificate_reject"
msgid "Reject"
msgstr "நிராகரிக்கவும்"

#, java-printf-format
msgctxt "trust_certificate_reset_info"
msgid "You can reset all custom certificates in the app settings."
msgstr "ஆப்ச் அமைப்புகளில் அனைத்து தனிப்பயன் சான்றிதழ்களையும் மீட்டமைக்கலாம்."

#, java-printf-format
msgctxt "trust_certificate_press_back_to_reject"
msgid "Press Back again to reject certificate"
msgstr "சான்றிதழை நிராகரிக்க மறுநிகழ்வு அழுத்தவும்"
