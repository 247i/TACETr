msgstr "ஒருங்கிணைப்பு% 2 இன்% 1"

#: ../src/desktop/consolidatedialog.cpp:8455
msgctxt "ConsolidateDialog"
msgid ""
"Select the destination lot (from %1 source lots) and adjust the options if "
