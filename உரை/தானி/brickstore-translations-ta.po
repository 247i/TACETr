msgid "Lot with highest index"
msgstr "அதிக குறியீட்டுடன் நிறைய"

#: ../src/desktop/consolidatedialog.cpp:8230
msgctxt "ConsolidateDialog"
msgid ""
"%1 of %2 consolidations will not be done, because no destination lot has "
