#, i18next-interpolation, ignore-inconsistent
msgctxt "header"
msgid "Custom fields"
msgstr "தனிப்பயன் புலங்கள்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "select"
msgid "Select custom fields"
msgstr "தனிப்பயன் புலங்களைத் தேர்ந்தெடுக்கவும்"

#, i18next-interpolation, ignore-ellipsis, ignore-inconsistent
msgctxt "searchPlaceholder"
msgid "Search custom fields..."
msgstr "தனிப்பயன் புலங்களைத் தேடு..."

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.header"
msgid "Edit custom field"
msgstr "தனிப்பயன் புலத்தைத் திருத்து"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.headerAdd"
msgid "Add custom field"
msgstr "தனிப்பயன் புலத்தைச் சேர்க்கவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.name"
msgid "Custom field name"
msgstr "தனிப்பயன் புலத்தின் பெயர்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.default.title"
msgid "Toggle default"
msgstr "இயல்புநிலையை மாற்றவும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.default.desc"
msgid "Default custom fields will always appear on the member edit screen"
msgstr ""
"இயல்புநிலை தனிப்பயன் புலங்கள் எப்போதும் உறுப்பினர் திருத்த திரையில் தோன்றும்"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.delete.title"
msgid "Delete custom field"
msgstr "தனிப்பயன் புலத்தை நீக்கு"

#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.delete.confirm"
msgid "Are you sure you want to delete this custom field?"
msgstr "இந்த தனிப்பயன் புலத்தை நிச்சயமாக நீக்க விரும்புகிறீர்களா?"
