msgid "Use only letters, digits, _ or -"
msgstr "எழுத்துக்கள், இலக்கங்கள், _ அல்லது - ஆகியவற்றை மட்டும் பயன்படுத்தவும்"

#, java-printf-format
msgctxt "error_iface_too_long"
