#, java-printf-format
msgctxt "server_repository_error_get_well_known_node_info"
msgid "fetching /.well-known/nodeinfo failed: %1$s"
msgstr "பெறுதல் /.well-known/nodeinfo failed: %1$s"

#, java-printf-format
msgctxt "server_repository_error_unsupported_schema"
msgid "/.well-known/nodeinfo did not contain understandable schemas"
msgstr "/"

#, java-printf-format
msgctxt "server_repository_error_get_node_info"
msgid "fetching nodeinfo %1$s failed: %2$s"
msgstr "நோடின்ஃபோ %1$s தோல்வியுற்றன: %2$s"

#, java-printf-format
msgctxt "server_repository_error_validate_node_info"
msgid "validating nodeinfo %1$s failed: %2$s"
msgstr "Nodeinfo %1$s ஐ சரிபார்க்கவும் தோல்வியுற்றது: %2$s"

#, java-printf-format
msgctxt "server_repository_error_get_instance_info"
msgid "fetching /api/v1/instance failed: %1$s"
msgstr "பெறுதல்/API/V1/நிகழ்வு தோல்வியுற்றது: %1$s"

#, java-printf-format
msgctxt "server_repository_error_capabilities"
msgid "parsing server capabilities failed: %1$s"
msgstr "பாகுபடுத்தும் சேவையக திறன்கள் தோல்வியடைந்தன: %1$s"

#, java-printf-format
msgctxt "error_filter_server_does_not_filter"
msgid "Server does not support filters"
msgstr "சேவையகம் வடிப்பான்களை ஆதரிக்காது"

#, java-printf-format
msgctxt "account_manager_error_account_does_not_exist"
msgid ""
"Account does not exist in local database. This should never happen. If you "
"see this message please report this to team@pachli.app."
msgstr ""
"உள்ளக தரவுத்தளத்தில் கணக்கு இல்லை. இது ஒருபோதும் நடக்கக்கூடாது. இந்தச் "
"செய்தியைப் பார்த்தால், team@pachli.app க்கு புகாரளிக்கவும்."

#, java-printf-format
msgctxt "account_manager_error_no_active_account"
msgid "no account is marked active"
msgstr "எந்த கணக்கும் செயலில் குறிக்கப்படவில்லை"

#, java-printf-format
msgctxt "account_manager_error_dao"
msgid "Database error, please report this to team@pachli.app: %1$s"
msgstr ""
"தரவுத்தளப் பிழை, தயவுசெய்து இதைப் புகாரளிக்கவும் team@pachli.app: %1$s"

#, java-printf-format
msgctxt "account_manager_error_unexpected"
msgid "unexpected error: %1$s"
msgstr "எதிர்பாராத பிழை: %1$s"

#, java-printf-format
msgctxt "error_preference_importer_null_on_import"
msgid "importing file returned null"
msgstr "இறக்குமதி கோப்பு பூச்யமாக திரும்பியது"

#, java-printf-format
msgctxt "error_preference_importer_missing_schema_version"
msgid "file does not contain a schema version"
msgstr "கோப்பில் ச்கீமா பதிப்பு இல்லை"

#, java-printf-format
msgctxt "error_preference_importer_wrong_version_fmt"
msgid "file is an unknown version: %1$s"
msgstr "கோப்பு அறியப்படாத பதிப்பு: %1$s"
