#, java-printf-format, safe-html
msgctxt "pref_title_license_message"
msgid ""
"BikeSharingHub \n"
"Copyright © 2020-2026 François FERREIRA DE SOUSA and contributors \n"
"This program incorporates a modified version of OpenBikeSharing \n"
"Copyright © 2014-2015 Bruno Parmentier\n"
