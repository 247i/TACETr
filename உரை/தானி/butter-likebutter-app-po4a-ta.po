msgstr "Local Chat & Content Abuse"

#. type: Plain text
#: docs/security.mdx:147
#, md-text, safe-mdx
msgid "Risks:"
msgstr "அபாயங்கள்:"

#. type: Bullet: '* '
#: docs/security.mdx:151
#, md-text, safe-mdx
msgid "Harassment or hate speech"
msgstr "துன்புறுத்தல் அல்லது வெறுப்பு பேச்சு"

#. type: Bullet: '* '
#: docs/security.mdx:151
#, md-text, safe-mdx
