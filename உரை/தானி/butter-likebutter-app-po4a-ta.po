#, md-text, safe-mdx
msgid "Bluetooth"
msgstr "ஊடலை"

#. type: Bullet: '* '
#: docs/security.mdx:126
#, md-text, safe-mdx
msgid "USB ports"
msgstr "USB போர்ட்கள்"

#. type: Title ####
#: docs/security.mdx:127
#, md-text, no-wrap, safe-mdx
msgid "Content Integrity & Authenticity"
msgstr "உள்ளடக்க ஒருமைப்பாடு மற்றும் நம்பகத்தன்மை"

#. type: Bullet: '* '
#: docs/security.mdx:134
#, md-text, safe-mdx
msgid "Keep firmware immutable during normal operation"
msgstr "சாதாரண செயல்பாட்டின் போது ஃபார்ம்வேரை மாறாமல் வைத்திருங்கள்"

#. type: Bullet: '* '
#: docs/security.mdx:134
#, md-text, safe-mdx
msgid "Maintain a known-good baseline image"
msgstr "அறியப்பட்ட-நல்ல அடிப்படை படத்தை பராமரிக்கவும்"

#. type: Bullet: '* '
#: docs/security.mdx:134
#, md-text, safe-mdx
msgid "Re-flash devices periodically in long deployments"
msgstr ""
"நீண்ட வரிசைப்படுத்தல்களில் அவ்வப்போது சாதனங்களை மீண்டும் ஃபிளாச் செய்யவும்"

#. type: Plain text
#: docs/security.mdx:136
#, md-text, safe-mdx
msgid "Operational control:"
msgstr "செயல்பாட்டுக் கட்டுப்பாடு:"

#. type: Bullet: '* '
#: docs/security.mdx:139
#, md-text, safe-mdx
msgid "Only trusted operators should install or update content"
msgstr ""
"நம்பகமான ஆபரேட்டர்கள் மட்டுமே உள்ளடக்கத்தை நிறுவ வேண்டும் அல்லது புதுப்பிக்க"
" வேண்டும்"

#. type: Bullet: '* '
#: docs/security.mdx:139
#, md-text, safe-mdx
msgid "Document update sources and dates"
msgstr "ஆவண புதுப்பிப்பு ஆதாரங்கள் மற்றும் தேதிகள்"

#. type: Title ###
#: docs/security.mdx:142
#, md-text, no-wrap, safe-mdx
msgid "Section 3: Misuse & Abuse Mitigation"
msgstr "பிரிவு 3: தீய பயன்பாடு & தீய பயன்பாடு குறைத்தல்"

#. type: Title ####
#: docs/security.mdx:144
#, md-text, no-wrap, safe-mdx
