# Suggested in Weblate: வளங்கள்
#, i18next-interpolation
msgctxt "header"
msgid "Resources"
msgstr "வளங்கள்"

#, i18next-interpolation
msgctxt "ampersand"
msgid "On Ampersand"
msgstr "ஆம்பர்சண்ட் மீது"

# Suggested in Weblate: வளைதளம்
#, i18next-interpolation
msgctxt "website.title"
msgid "Website"
msgstr "இணையதளம்"

#, i18next-interpolation
msgctxt "website.desc"
msgid "Download the latest app version, and follow our updates."
msgstr ""
"பயன்பாட்டின் அண்மைக் கால பதிப்பைப் பதிவிறக்கி, எங்கள் புதுப்பிப்புகளைப் "
"பின்பற்றவும்."

# Suggested in Weblate: வலைப்பதிவு
#, i18next-interpolation
msgctxt "blog.title"
msgid "Blog"
msgstr "வலைப்பதிவு"

#, i18next-interpolation
msgctxt "blog.desc"
msgid "Get the latest news and follow our development rambles."
msgstr ""
"அண்மைக் கால செய்திகளைப் பெற்று, எங்கள் வளர்ச்சிப் பயணங்களைப் பின்பற்றவும்."

# Suggested in Weblate: விக்கி
#, i18next-interpolation
msgctxt "wiki.title"
msgid "Wiki"
msgstr "விக்கி"

#, i18next-interpolation
msgctxt "wiki.desc"
msgid "Get help on using the application."
msgstr "பயன்பாட்டைப் பயன்படுத்துவதில் உதவி பெறவும்."

#, i18next-interpolation
msgctxt "repository.title"
msgid "Code repository"
msgstr "குறியீடு களஞ்சியம்"

#, i18next-interpolation
msgctxt "repository.desc"
msgid "Contribute to our application and report issues."
msgstr ""
"எங்கள் விண்ணப்பத்தில் பங்களிக்கவும் மற்றும் சிக்கல்களைப் புகாரளிக்கவும்."
