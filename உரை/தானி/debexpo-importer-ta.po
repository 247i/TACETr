#: importer/models.py
#, python-brace-format
msgid "{error}: REJECTED"
msgstr "{error}: நிராகரிக்கப்பட்டது"

#: importer/models.py
#, python-brace-format
msgid "{package}_{version}: ACCEPTED on {site} ({distribution})"
msgstr "{package}_{version}: {site} இல் ஏற்றுக்கொள்ளப்பட்டது ({distribution})"

#: importer/models.py
msgid "Changes is invalid"
msgstr "மாற்றங்கள் செல்லாது"

#: importer/models.py
msgid "Dsc failed to parse"
msgstr "Dsc பாகுபடுத்துவதில் தோல்வி"

#: importer/models.py
msgid "Dsc is invalid"
msgstr "Dsc தவறானது"

#: importer/models.py
msgid "Failed to extract source package"
msgstr "மூலத் தொகுப்பைப் பிரித்தெடுப்பதில் தோல்வி"

#: importer/models.py
msgid "Source package is invalid"
msgstr "மூல தொகுப்பு தவறானது"

#: importer/models.py
msgid "Invalid distribution"
msgstr "தவறான வழங்கல்"

#: importer/models.py
#, python-brace-format
msgid ""
"Distribution {distribution} is not supported on mentors\n"
"\n"
"List of supported distributions:\n"
"\n"
"{allowed}"
msgstr ""
"வழிகாட்டிகளில் வழங்கல் {distribution} ஆதரிக்கப்படவில்லை \n"
"\n"
"List of supported distributions:\n"
"\n"
" {allowed}"

#: importer/templates/email-importer-accept.html
#, python-format
msgid ""
"Hi.\n"
"\n"
"Your upload of the package '%(name)s' to %(site)s was\n"
"successful. Others can now see it. The URL of your package is:\n"
msgstr ""
"வணக்கம். \n"
"\n"
"நீங்கள் '%(name)s' தொகுப்பை %(site)s இல் பதிவேற்றம் செய்தீர்கள் \n"
"வெற்றிகரமான. மற்றவர்கள் இப்போது பார்க்க முடியும். உங்கள் தொகுப்பின் URL:\n"

#: importer/templates/email-importer-accept.html
msgid ""
"\n"
"The respective dsc file can be found at:\n"
msgstr ""
"\n"
"தொடர்புடைய dsc கோப்பை இங்கே காணலாம்:\n"

#: importer/templates/email-importer-accept.html
msgid ""
"\n"
"If you do not yet have a sponsor for your package you may want to go to:\n"
msgstr ""
"\n"
"உங்கள் பேக்கேசுக்கான ஒப்புரவாளர் உங்களிடம் இல்லை என்றால், நீங்கள் இதற்குச் செல்ல விரும்பலாம்:\n"

#: importer/templates/email-importer-accept.html
msgid ""
"\n"
"and set the \"Seeking a sponsor\" option to highlight your package on the\n"
"welcome page.\n"
"\n"
"You can also send an RFS (request for sponsorship) to the debian-mentors\n"
"mailing list. Your package page will give you suggestions on how to\n"
"send that mail.\n"
"\n"
"Good luck in finding a sponsor!\n"
"\n"
"Thanks,"
msgstr ""
"\n"
"and கணம் the \"Seeking a sponsor\" option பெறுநர் highlight your தொகுப்பு on the\n"
"welcome page.\n"
"\n"
"You can also send an RFS (request க்கு sponsorship) பெறுநர் the debian-mentors\n"
"mailing list. Your தொகுப்பு page will give you suggestions on how to\n"
"send that mail.\n"
"\n"
"Good luck in finding a sponsor!\n"
"\n"
"Thanks,"

#: importer/templates/email-importer-reject.html
#, python-format
msgid ""
"Hello,\n"
"\n"
"Unfortunately your package \"%(source)s\" was rejected\n"
"because of the following reason:\n"
"\n"
"%(error)s\n"
"\n"
"%(details)s\n"
"\n"
"Please try to fix it and re-upload. Thanks,"
msgstr ""
"வணக்கம், \n"
"\n"
"துரதிருச்டவசமாக உங்கள் தொகுப்பு \"%(source)s\" நிராகரிக்கப்பட்டது \n"
"பின்வரும் காரணத்தினால்: \n"
"\n"
"%(error)s \n"
"\n"
"%(details)s \n"
"\n"
"அதைச் சரிசெய்து மீண்டும் பதிவேற்ற முயற்சிக்கவும். நன்றி,"
