msgstr "பத்திரிகையைத் தேடு..."

#, i18next-interpolation
msgctxt "contentWarning"
msgid "This post has sensitive content inside"
msgstr "இந்த இடுகையில் முக்கியமான உள்ளடக்கம் உள்ளது"

