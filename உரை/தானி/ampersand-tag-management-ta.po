#, i18next-interpolation, ignore-inconsistent
msgctxt "edit.showJournal.desc"
msgid "{{count}} journal post has this tag"
msgid_plural "{{count}} journal posts have this tag"
msgstr[0] "{{count}} சர்னல் இடுகையில் இந்தக் குறிச்சொல் உள்ளது"
msgstr[1] "{{count}} இதழ் இடுகைகளில் இந்தக் குறிச்சொல் உள்ளது"

#, i18next-interpolation
msgctxt "edit.showAssets.title"
msgid "Show assets having this tag"
msgstr "இந்தக் குறியைக் கொண்ட சொத்துகளைக் காட்டு"

#, i18next-interpolation
msgctxt "edit.showAssets.desc"
msgid "{{count}} asset has this tag"
msgid_plural "{{count}} assets have this tag"
msgstr[0] "{{count}} சொத்தில் இந்தக் குறிச்சொல் உள்ளது"
msgstr[1] "{{count}} சொத்துக்கள் இந்தக் குறிச்சொல்லைக் கொண்டுள்ளன"

