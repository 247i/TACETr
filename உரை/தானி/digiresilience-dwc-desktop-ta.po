msgstr "அகற்று"

msgctxt "priority"
msgid "Priority"
msgstr "முன்னுரிமை"

msgctxt "timeframe"
msgid "Implement Within"
msgstr "உள்ளே செயல்படுத்தவும்"

msgctxt "owner"
