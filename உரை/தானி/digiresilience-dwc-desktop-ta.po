msgstr "இடர் நிலை சுருக்கம்"

msgctxt "levelRisk"
msgid "Level of Risk"
msgstr "இடர் நிலை"

msgctxt "requirementsExplainer"
msgid "You'll need a few things to get started."
msgstr "தொடங்குவதற்கு உங்களுக்கு சில விசயங்கள் தேவைப்படும்."

msgctxt "current"
msgid "Current"
msgstr "மின்னோட்ட்ம், ஓட்டம்"

msgctxt "previous"
msgid "Previous"
msgstr "முந்தைய"

msgctxt "notes"
