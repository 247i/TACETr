msgctxt "risk"
msgid "Risk"
msgstr "இடர்"

msgctxt "riskExplainer"
msgid "Ratings are influenced by the "
msgstr "மதிப்பீடுகள் பாதிக்கப்படுகின்றன"

msgctxt "grade"
msgid "Grade"
msgstr "தகுதி"

msgctxt "followup"
msgid "Follow-up"
msgstr "பின்தொடர்தல்"

msgctxt "nextFollowup"
