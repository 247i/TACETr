# Suggested in Weblate: பரிந்துரைக்கப்பட்ட கணக்குகள்
#, java-printf-format
msgctxt "title_suggestions"
msgid "Suggested accounts"
msgstr "பரிந்துரைக்கப்பட்ட கணக்குகள்"

#, java-printf-format
msgctxt "source_unknown"
msgid "(server returned unrecognized source)"
msgstr "(சேவையகம் அங்கீகரிக்கப்படாத மூலத்தைத் திருப்பி அனுப்பியது)"

#, java-printf-format
msgctxt "sources_featured"
msgid "Hand-picked by your server team"
msgstr "உங்கள் சர்வர் குழுவால் தேர்ந்தெடுக்கப்பட்டது"

#, java-printf-format
msgctxt "sources_most_followed"
msgid "One of the most followed on your server"
msgstr "உங்கள் சர்வரில் அதிகம் பின்தொடரும் ஒன்று"

#, java-printf-format
msgctxt "sources_most_interactions"
msgid "Getting a lot of attention on your server"
msgstr "உங்கள் சர்வரில் அதிக கவனத்தை ஈர்க்கிறது"

#, java-printf-format
msgctxt "sources_similar_to_recently_followed"
msgid "Similar to accounts you have recently followed"
msgstr "நீங்கள் அண்மைக் காலத்தில் பின்தொடர்ந்த கணக்குகளைப் போன்றது"

#, java-printf-format
msgctxt "sources_friends_of_friends"
msgid "Popular among people you follow"
msgstr "நீங்கள் பின்தொடரும் நபர்களிடையே பிரபலமானது"

#, java-printf-format
msgctxt "sources_unknown"
msgid "(server returned unrecognized sources)"
msgstr "(சேவையகம் அங்கீகரிக்கப்படாத ஆதாரங்களைத் திருப்பி அனுப்பியது)"

# Suggested in Weblate: பின்பற்று
#, java-printf-format
msgctxt "action_follow_account"
msgid "Follow"
msgstr "பின்பற்றவும்"

# Suggested in Weblate: தள்ளுபடி
#, java-printf-format
msgctxt "action_dismiss_follow_suggestion"
msgid "Dismiss"
msgstr "நிராகரி"

#, java-printf-format
msgctxt "ui_error_delete_suggestion_fmt"
msgid "Dismissing suggestion for %1$s failed: %2$s"
msgstr "%1$sக்கான பரிந்துரையை நிராகரிக்க முடியவில்லை: %2$s"

#, java-printf-format
msgctxt "ui_error_follow_account_fmt"
msgid "Following %1$s failed: %2$s"
msgstr "பின்வரும் %1$s தோல்வியடைந்தது: %2$s"

#, java-printf-format
msgctxt "follower_count_fmt"
msgid "<b>%1$s</b> followers"
msgstr "<b>%1$s</b> பின்தொடர்பவர்கள்"

#, java-printf-format
msgctxt "follows_count_fmt"
msgid "<b>%1$s</b> following"
msgstr "<b>%1$s</b> பின்தொடர்கிறது"

#, java-printf-format
msgctxt "statuses_count_fmt"
msgid "<b>%1$s</b> posts"
msgstr "<b>%1$s</b> இடுகைகள்"

#, java-printf-format
msgctxt "statuses_count_per_week_fmt"
msgid "<b>%1$s</b> posts (<b>%2$d</b> per week)"
msgstr "<b>%1$s</b> இடுகைகள் (வாரத்திற்கு <b>%2$d</b>)"

#, java-printf-format
msgctxt "statuses_count_per_week_last_fmt"
msgid "<b>%1$s</b> posts (<b>%2$d</b> per week, last <b>%3$s</b>)"
msgstr "<b>%1$s</b> இடுகைகள் (வாரத்திற்கு <b>%2$d</b>, கடந்த <b>%3$s</b>)"

#, java-printf-format
msgctxt "account_content_description_fmt"
msgid ""
"<!-- Display name, follower count, follows count, statuses count, note --> "
"%1$s; %2$s; %3$s; %4$s. %5$s"
msgstr ""
"<!-- காட்சி பெயர், பின்தொடர்பவர்களின் எண்ணிக்கை, பின்தொடர்பவர்களின் "
"எண்ணிக்கை, நிலைகளின் எண்ணிக்கை, குறிப்பு --> %1$s; %2$s; %3$s; %4$s. %5$s"
