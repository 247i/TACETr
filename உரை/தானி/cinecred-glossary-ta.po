#. Row in a table
#, terminology
msgid "Row"
msgstr "நிரை"

#. This is one of the body layout options
#, terminology
msgid "Flow"
msgstr "பாய்வு"

#. Look here for an explanation on what the spine is:
#. https://cinecred.com/guide/credits-spreadsheet/#spine-position
#, terminology
msgid "Spine"
msgstr "வளைமுள்"

#, terminology
msgid "Tail"
msgstr "வால்"

#, terminology
msgid "Content Style"
msgstr "உள்ளடக்க நடை"

#. A directory in the file browser
#, terminology
msgid "Folder"
msgstr "கோப்புறை"

#. This is one of the page behavior options
#, terminology
msgid "Scroll"
msgstr "சுருள்"

#. The width and height of an image, e.g., 1920x1080
#, terminology
msgid "Resolution"
msgstr "பகுத்தல்"

#, terminology
msgid "Body"
msgstr "உடல்"

#, terminology
msgid "Frame Rate"
msgstr "பிரேம் வீதம்"

#, terminology
msgid "Head"
msgstr "தலை"

#, terminology
msgid "Keyword"
msgstr "முக்கிய சொல்"

#. This is what we call the process of rendering the credits for the final
#. delivery
#, terminology
msgid "Delivery"
msgstr "வழங்கு"

#, terminology
msgid "Style"
msgstr "சூல் தண்டு"

#. Column in a table
#, terminology
msgid "Column"
msgstr "நெடுவரிசை"

#. Used in letter styles to compose the look of the text
#, terminology
msgid "Layer"
msgstr "அடுக்கு"

#. Short form of "head-body-tail block"
#, terminology
msgid "Block"
msgstr "தொகுதி"

#, terminology
msgid "Letter Style"
msgstr "கடிதம் நடை"

#, terminology
msgid "Project"
msgstr "திட்டம்"

#. This term refers to both (A) a cell in a spreadsheet and (B) a grid or flow
#. cell in the drawn credits, marked by an orange rectangle around it
#, terminology
msgid "Cell"
msgstr "கலன்"

#, terminology
msgid "Aspect Ratio"
msgstr "அம்ச விகிதம்"

#. A file in the file browser
#, terminology
msgid "File"
msgstr "கோப்பு"

#. This is one of the body layout options
#, terminology
msgid "Grid"
msgstr "வலைவாய்"

#, terminology
msgid "Vertical Gap"
msgstr "செங்குத்து இடைவெளி"

#. This is an individual frame from a video
#, terminology
msgid "Frame"
msgstr "சட்டகம்"

#. An online service, e.g., Google Sheets
#, terminology
msgid "Service"
msgstr "பணி"

#. Name of the program-wide preferences
#, terminology
msgid "Preferences"
msgstr "விருப்பத்தேர்வுகள்"

#, terminology
msgid "Spreadsheet"
msgstr "விரிவுத்தாள்"

#. Can be used in the body and sometimes also the head and tail; e.g., {{Pic
#. …}}
#, terminology
msgid "Tag"
msgstr "குறிச்சொல்"

#, terminology
msgid "Runtime"
msgstr "இயக்க நேரம்"

#, terminology
msgid "Page Style"
msgstr "பக்க நடை"

#. This is one of the page behavior options
#, terminology
msgid "Card"
msgstr "அட்டை"

#. This is the name of the dummy page style/content style that is used as a
#. fallback when the user writes blocks into the spreadsheet at a point where
#. no page style/content style has been specified yet.
#, terminology
msgid "Placeholder"
msgstr "இடம் வைத்திருப்பவர்"

#. In interlaced video, each frame is split into two fields: the so-called top
#. field contains the odd lines while the so-called bottom field contains the
#. even lines. Here's a visualization of how a frame is split into these two
#. fields:
#. ```
#. TTTTT
#. BBBBB
#. TTTTT
#. BBBBB
#.   …
#. ```
#. For more information on interlaced video, see:
#. https://en.wikipedia.org/wiki/Interlaced_scan
#, terminology
msgid "Field"
msgstr "புலம்"

#. Used mainly to describe the value of a cell in the spreadsheet
#, terminology
msgid "Value"
msgstr "மதிப்பு"

#, terminology
msgid "Grounding"
msgstr "நிலமிடுதல்"

#. This is a folder with a numbered sequence of images; when played back to
#. back, they form a video clip
#, terminology
msgid "Image Sequence"
msgstr "பட வரிசை"

#. This is one of the body layout options
#, terminology
msgid "Paragraphs"
msgstr "பத்திகள்"

#. This is the effect that happens when the credits scroll a fractional number
#. of pixels each frame
#, terminology
msgid "Shimmering"
msgstr "பளபளக்கும்"

#. Usually dots inserted between the role title and the person's name; see
#. [this Wikipedia entry](https://en.wikipedia.org/wiki/Leader_(typography))
#, terminology
msgid "Leader"
msgstr "தலைவர்"

#, terminology
msgid "Page"
msgstr "பக்கம்"

#. This refers to an account at an online service, like Google
#, terminology
msgid "Account"
msgstr "கணக்கு"

#, terminology
msgid "Timecode"
msgstr "நேரக் குறியீடு"

#, terminology
msgid "Styling"
msgstr "ச்டைலிங்"

#, terminology
msgid "Render Job"
msgstr "வேலைகளை வழங்கவும்"

#. When exporting the credits, the destination filename is usually generated
#. via a so-called delivery destination template, which assembles the filename
#. from properties like the project name or the exported FPS.
#, terminology
msgid "Delivery Destination Template"
msgstr "விநியோக இலக்கு வார்ப்புரு"

#. A smooth transition between transparent and opaque, or scrolling and
#. stillstand.
#, terminology
msgid "Transition"
msgstr "மாற்றம்"

#, terminology
msgid "Transition Style"
msgstr "மாற்றம் நடை"

#. A graphic that is drawn on top of the credits as a layout help. Could be
#. safe areas, an aspect ratio crop, or even a custom image. Examples:
#. https://cinecred.com/guide/user-interface/overlays-standard.gif
#, terminology
msgid "Overlay"
msgstr "மேலடுக்கு"

#, terminology
msgid "Email"
msgstr "மின்னஞ்சல்"

#, terminology
msgid "Email Address"
msgstr "மின்னஞ்சல் முகவரி"

#, terminology
msgid "Safe Areas"
msgstr "பாதுகாப்பான பகுதிகள்"

#. The spacing between two lines of text. See also:
#. https://en.wikipedia.org/wiki/Leading
#, terminology
msgid "Leading"
msgstr "முன்னணி"

#. An arrangement of the dockable panels into one or more windows. The window
#. layout can be changed by dragging panels around, and thereafter saved and
#. loaded.
#, terminology
msgid "Window Layout"
msgstr "சாளர அமைப்பு"

#. A dockable UI panel with a certain function, like the preview panel,
#. styling panel, delivery panel, and so on.
#, terminology
msgid "Panel"
msgstr "குழு"

#, terminology
msgid "Toolbar"
msgstr "கருவிப்பட்டி"

#, terminology
msgid "Gap"
msgstr "இடைவெளி"

#. A typographic term for automatically shrinking the gap between two letters
#. in order to prevent it from appearing too large. See also:
#. https://en.wikipedia.org/wiki/Kerning
#, terminology
msgid "Kerning"
msgstr "கெர்னிங்"

#. This is the horizontal spacing in-between letters. For example, if you were
#. to heavily increase tracking, text could look like this:
#. C i n e c r e d
#. See also: https://en.wikipedia.org/wiki/Letter-spacing
#, terminology
msgid "Tracking"
msgstr "கண்காணிப்பு"

#. A file path, e.g., `C:\Users\Tom` or `/home/tom/My Project/Styling.toml`.
#, terminology
msgid "Path"
msgstr "பாதை"

#. In interlaced video, every video frame is made up of two interleaved
#. fields, which are shown at different times. This format is mostly legacy
#. and superseded by progressive video, where the entirety of a video frame is
#. displayed at the same time.
#. For more information on interlaced video, see:
#. https://en.wikipedia.org/wiki/Interlaced_scan
#, terminology
msgid "Interlaced"
msgstr "ஒன்றோடொன்று இணைக்கப்பட்டது"

#. Nowadays, progressive scan is the most common way of storing video. It
#. means that the entirety of a video frame is displayed at the same time.
#. Contrast that to the legacy interlaced scan, where every video frame is
#. made up of two interleaved fields, which are shown at different times.
#. For more information on progressive video, see:
#. https://en.wikipedia.org/wiki/Progressive_scan
#, terminology
msgid "Progressive"
msgstr "முற்போக்கானது"

#. This is about cropping an image, i.e., cutting off parts of it on the
#. sides. This is not about wheat crops.
#, terminology
msgid "Crop"
msgstr "பயிர்"

#. A color gamut like BT.709, DCI-P3, or BT.2020. Not to be confused with
#. gamma, which is an entirely different thing!
#. See also: https://en.wikipedia.org/wiki/Gamut
#, terminology
msgid "Gamut"
msgstr "வரம்பு"
