msgstr "கோப்பு {path} இல் சேமிக்கப்பட்டது"

#, icu-message-format
msgctxt "jumpToLastReadMessage"
msgid "Jump to last read message"
msgstr "கடைசி வாசிப்பு செய்திக்கு செல்லவும்"

#, icu-message-format
