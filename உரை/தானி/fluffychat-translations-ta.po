msgstr "சாதன அடையாள விசை"

#, icu-message-format
msgctxt "restoreBootstrapEmptyDevicesDescription"
msgid ""
"Please enter your passphrase or recovery key to verify this device and get "
"access to your encrypted message backup."
msgstr ""
"இந்தச் சாதனத்தைச் சரிபார்க்க உங்கள் கடவுச்சொற்றொடரை அல்லது மீட்பு விசையை "
"உள்ளிடவும் மற்றும் உங்கள் மறைகுறியாக்கப்பட்ட செய்தி காப்புப்பிரதிக்கான "
"அணுகலைப் பெறவும்."

#, icu-message-format
msgctxt "restoreBootstrapDevicesDescription"
msgid "Please pick one of your other devices, to verify this session:"
msgstr ""
"இந்த அமர்வைச் சரிபார்க்க, உங்கள் மற்ற சாதனங்களில் ஒன்றைத் தேர்ந்தெடுக்கவும்:"

#, icu-message-format
msgctxt "resetAccount"
msgid "Reset account"
msgstr "கணக்கை மீட்டமைக்கவும்"

#, icu-message-format
msgctxt "restoreCryptoIdentity"
msgid "Restore Crypto Identity"
msgstr "மறையீட்டு அடையாளத்தை மீட்டெடுக்கவும்"

#, icu-message-format
msgctxt "resetCryptoIdentity"
msgid "Reset Crypto Identity"
msgstr "மறையீட்டு அடையாளத்தை மீட்டமைக்கவும்"

#, icu-message-format
msgctxt "setUpCryptoIdentity"
msgid "Set Up Crypto Identity"
msgstr "மறையீட்டு அடையாளத்தை அமைக்கவும்"

#, icu-message-format
msgctxt "waitingForKeys"
msgid "Waiting for keys... Please keep the other device active."
msgstr ""
"விசைகளுக்காகக் காத்திருக்கிறது... மற்ற சாதனத்தை செயலில் வைத்திருக்கவும்."

#, icu-message-format
msgctxt "noKeysTransmitted"
msgid "No keys transmitted. Please try again."
msgstr "விசைகள் எதுவும் அனுப்பப்படவில்லை. மீண்டும் முயற்சிக்கவும்."

#, icu-message-format
msgctxt "unlock"
msgid "Unlock"
msgstr "திறக்கவும்"

#, icu-message-format
msgctxt "openFile"
msgid "Open file"
msgstr "கோப்பை திற"

#, icu-message-format
msgctxt "resetAccountWarning"
msgid ""
"When you reset your account you will lose the access to your old messages "
"forever. All your current devices need to be verified again. Please only "
"perform this action when you have no other devices left to verify your "
"session and you have lost your recovery key and passphrase!"
msgstr ""
"உங்கள் கணக்கை மீட்டமைக்கும்போது, ​​உங்கள் பழைய செய்திகளுக்கான அணுகலை "
"நிரந்தரமாக இழப்பீர்கள். உங்களின் தற்போதைய சாதனங்கள் அனைத்தும் மீண்டும் "
"சரிபார்க்கப்பட வேண்டும். உங்கள் அமர்வைச் சரிபார்க்க வேறு எந்தச் சாதனங்களும் "
"உங்களிடம் இல்லாதபோதும், உங்கள் மீட்பு விசையையும் கடவுச்சொற்றொடரையும் நீங்கள்"
" இழந்திருக்கும்போது மட்டுமே இந்தச் செயலைச் செய்யவும்!"

#, icu-message-format
msgctxt "newPassphraseDescription"
msgid ""
"FluffyChat uses end to end encryption. To not lose your messages, please "
"choose a strong passphrase to secure your crypto identity and your encrypted"
" message backup."
msgstr ""
"FluffyChat என்ட் டு என்ட் என்க்ரிப்சனைப் பயன்படுத்துகிறது. உங்கள் செய்திகளை "
"இழக்காமல் இருக்க, உங்கள் மறையீட்டு அடையாளத்தையும் மறைகுறியாக்கப்பட்ட செய்தி "
"காப்புப்பிரதியையும் பாதுகாக்க வலுவான கடவுச்சொற்றொடரைத் தேர்வு செய்யவும்."

#, icu-message-format
msgctxt "newPassphrase"
msgid "New passphrase"
msgstr "புதிய கடவுச்சொற்றொடர்"

#, icu-message-format
msgctxt "repeatPassphrase"
msgid "Repeat passphrase"
msgstr "கடவுச்சொற்றொடரை மீண்டும் செய்யவும்"

#, icu-message-format
msgctxt "passphrasesMatch"
msgid "Passphrases match"
msgstr "கடவுச்சொற்கள் பொருந்தும்"

#, icu-message-format
msgctxt "passphraseLengthRequirement"
msgid "At least 12 characters long."
msgstr "குறைந்தது 12 எழுத்துகள் நீளம்."

#, icu-message-format
msgctxt "passphraseUpperAndLowerCaseRequirement"
msgid "Contains uppercase and lowercase characters."
msgstr "பெரிய எழுத்து மற்றும் சிறிய எழுத்துகளைக் கொண்டுள்ளது."

#, icu-message-format
msgctxt "passphraseSpecialCharactersRequirement"
msgid "Contains special characters."
msgstr "சிறப்பு எழுத்துக்களைக் கொண்டுள்ளது."

#, icu-message-format
msgctxt "passphraseNumberRequirement"
msgid "Contains one numbers."
msgstr "ஒரு எண்களைக் கொண்டுள்ளது."

#, icu-message-format
msgctxt "storeRecoveryKeyDescription"
msgid ""
"Please note down your recovery key to be able to restore your encrypted "
