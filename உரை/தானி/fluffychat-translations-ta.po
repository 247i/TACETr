msgid "Advanced configurations"
msgstr "மேம்பட்ட கட்டமைப்புகள்"

#, icu-message-format
msgctxt "signIn"
msgid "Sign in"
msgstr "விடுபதிகை"

#, icu-message-format
msgctxt "createNewAccount"
msgid "Create new account"
msgstr "புதிய கணக்கை உருவாக்கவும்"

#, icu-message-format
msgctxt "signUpGreeting"
msgid ""
"FluffyChat is decentralized! Select a server where you want to create your "
"account and let's go!"
msgstr ""
"FluffyChat பரவலாக்கப்பட்டது! உங்கள் கணக்கை உருவாக்க விரும்பும் சேவையகத்தைத் "
"தேர்ந்தெடுத்து, செல்லலாம்!"

#, icu-message-format
msgctxt "signInGreeting"
msgid ""
"You already have an account in Matrix? Welcome back! Select your homeserver "
"and sign in."
msgstr ""
"உங்களிடம் ஏற்கனவே அணி இல் கணக்கு உள்ளதா? மீண்டும் வருக! உங்கள் ஓம் சர்வரைத் "
"தேர்ந்தெடுத்து உள்நுழையவும்."

#, icu-message-format
msgctxt "appIntro"
msgid ""
"With FluffyChat you can chat with your friends. It's a secure decentralized "
"[matrix] messenger! Learn more on https://matrix.org if you like or just "
"sign up."
msgstr ""
"FluffyChat மூலம் நீங்கள் உங்கள் நண்பர்களுடன் அரட்டையடிக்கலாம். இது ஒரு "
"பாதுகாப்பான பரவலாக்கப்பட்ட [மேட்ரிக்ச்] தூதுவர்! நீங்கள் விரும்பினால் "
"https://matrix.org இல் மேலும் அறியவும் அல்லது பதிவு செய்யவும்."

#, icu-message-format
msgctxt "theProcessWasCanceled"
msgid "The process was canceled."
msgstr "செயல்முறை ரத்து செய்யப்பட்டது."

#, icu-message-format
msgctxt "join"
msgid "Join"
msgstr "சேருங்கள்"

#, icu-message-format
msgctxt "searchOrEnterHomeserverAddress"
msgid "Search or enter homeserver address"
msgstr "ஓம்சர்வர் முகவரியைத் தேடவும் அல்லது உள்ளிடவும்"

#, icu-message-format
msgctxt "matrixId"
msgid "Matrix ID"
msgstr "மேட்ரிக்ச் அடையாளம்"

#, icu-message-format
msgctxt "setPowerLevel"
msgid "Set power level"
msgstr "ஆற்றல் அளவை அமைக்கவும்"

#, icu-message-format
msgctxt "makeModerator"
msgid "Make moderator"
msgstr "மதிப்பீட்டாளராக ஆக்குங்கள்"

#, icu-message-format
msgctxt "makeAdmin"
msgid "Make admin"
msgstr "நிர்வாகியாக்கு"

#, icu-message-format
msgctxt "removeModeratorRights"
msgid "Remove moderator rights"
msgstr "மதிப்பீட்டாளர் உரிமைகளை அகற்று"

#, icu-message-format
msgctxt "removeAdminRights"
msgid "Remove admin rights"
msgstr "நிர்வாகி உரிமைகளை அகற்று"

#, icu-message-format
msgctxt "powerLevel"
msgid "Power level"
msgstr "ஆற்றல் நிலை"

#, icu-message-format
msgctxt "setPowerLevelDescription"
msgid ""
"Power levels define what a member is allowed to do in this room and usually "
"range between 0 and 100."
msgstr ""
"இந்த அறையில் ஒரு உறுப்பினர் என்ன செய்ய அனுமதிக்கப்படுகிறார் என்பதை அதிகார "
"நிலைகள் வரையறுக்கின்றன மற்றும் பொதுவாக 0 முதல் 100 வரை இருக்கும்."

#, icu-message-format
msgctxt "owner"
msgid "Owner"
msgstr "உரிமையாளர்"
