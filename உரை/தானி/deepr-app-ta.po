msgstr "துறைமுகம் மாற்றப்பட்டது. சர்வர் மறுதொடக்கம்..."

#, java-printf-format
msgctxt "change_port"
msgid "Change Port"
msgstr "துறைமுகத்தை மாற்றவும்"

#.  Transfer Link Server
#, java-printf-format
msgctxt "transfer_link_server"
msgid "Transfer Link Server"
msgstr "இணைப்பு சேவையகத்தை மாற்றவும்"

#, java-printf-format
msgctxt "transfer_link_to_another_device"
msgid "Transfer Link to another Device (Beta)"
msgstr "மற்றொரு சாதனத்திற்கு இணைப்பை மாற்றவும் (பீட்டா)"

#, java-printf-format
msgctxt "transfer_link_server_instructions"
msgid ""
"1. Toggle the switch above to start the server\n"
"2. Make sure both devices are on the same Wi-Fi network\n"
"3. Scan the QR code from import links option in another device"
msgstr ""
"1. சேவையகத்தைத் தொடங்க, மேலே உள்ள சுவிட்சை மாற்றவும் \n"
"2. இரண்டு சாதனங்களும் ஒரே வைஃபை நெட்வொர்க்கில் இருப்பதை உறுதிசெய்யவும் \n"
"3. மற்றொரு சாதனத்தில் இறக்குமதி இணைப்புகள் விருப்பத்திலிருந்து QR குறியீட்டை வருடு செய்யவும்"

#, java-printf-format
msgctxt "scan_qr_to_get_data"
msgid "Scan to get links from another device"
msgstr "மற்றொரு சாதனத்திலிருந்து இணைப்புகளைப் பெற வருடு செய்யவும்"

