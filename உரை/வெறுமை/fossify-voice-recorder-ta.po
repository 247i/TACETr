#, java-printf-format
msgctxt "app_launcher_name"
msgid "Voice Recorder"
msgstr "குரல் ரெக்கார்டர்"

#, java-printf-format
msgctxt "confirm_recording_folder"
msgid ""
"You must confirm the folder where you want to save your recordings. Please "
"press OK to continue."
msgstr ""
"உங்கள் பதிவுகளைச் சேமிக்க விரும்பும் கோப்புறையை உறுதிப்படுத்த வேண்டும். "
"தொடர, சரி என்பதை அழுத்தவும்."

#, java-printf-format
msgctxt "move_recordings"
msgid "Move recordings"
msgstr "பதிவுகளை நகர்த்தவும்"

#, java-printf-format
msgctxt "move_recordings_to_new_folder_desc"
msgid ""
"You have existing recordings. Do you want to move them to your new folder?"
msgstr ""
"உங்களிடம் ஏற்கனவே பதிவுகள் உள்ளன. அவற்றை உங்கள் புதிய கோப்புறைக்கு நகர்த்த "
"விரும்புகிறீர்களா?"

#, java-printf-format
msgctxt "recording_saved_successfully"
msgid "Recording saved successfully"
msgstr "பதிவு வெற்றிகரமாக சேமிக்கப்பட்டது"

#, java-printf-format
msgctxt "recording_too_short"
msgid "Recording was too short to record!"
msgstr "ரெக்கார்டிங் மிகவும் குறுகியதாக இருந்தது!"

#, java-printf-format
msgctxt "recording"
msgid "Recording"
msgstr "பதிவு செய்தல்"

#, java-printf-format
msgctxt "no_recordings_found"
msgid ""
"No recordings created by this app\n"
"have been found"
msgstr ""
"இந்த ஆப்ச் மூலம் பதிவுகள் எதுவும் உருவாக்கப்படவில்லை \n"
"கண்டுபிடிக்கப்பட்டுள்ளன"

#, java-printf-format
msgctxt "no_recordings_in_folder_found"
msgid ""
"No recordings have been found\n"
"in the selected folder"
msgstr ""
"பதிவுகள் எதுவும் கிடைக்கவில்லை \n"
"தேர்ந்தெடுக்கப்பட்ட கோப்புறையில்"

#, java-printf-format
msgctxt "paused"
msgid "Paused"
msgstr "இடைநிறுத்தப்பட்டது"

#, java-printf-format
msgctxt "recorder"
msgid "Recorder"
msgstr "ரெக்கார்டர்"

#, java-printf-format
msgctxt "player"
msgid "Player"
msgstr "வீரர்"

#.  Confirmation dialog
#, java-printf-format
msgctxt "discard_recording"
msgid "Discard recording"
msgstr "பதிவை நிராகரிக்கவும்"

#, java-printf-format
msgctxt "discard_recording_confirmation"
msgid ""
"Are you sure you want to discard the current recording? This cannot be "
"undone."
msgstr ""
"தற்போதைய பதிவை நிச்சயமாக நிராகரிக்க விரும்புகிறீர்களா? இதை செயல்தவிர்க்க "
"முடியாது."

#, java-printf-format
msgctxt "change_microphone_mode_confirmation"
msgid ""
"This changes how your device routes and processes audio. Results vary by "
"device and can impact volume, noise, and other factors."
msgstr ""
"இது உங்கள் சாதனத்தின் வழிகள் மற்றும் ஆடியோவை எவ்வாறு செயலாக்குகிறது என்பதை "
"மாற்றுகிறது. முடிவுகள் சாதனத்தைப் பொறுத்து மாறுபடும் மற்றும் ஒலி அளவு, ஒலி "
"மற்றும் பிற காரணிகளைப் பாதிக்கலாம்."

#.  Are you sure you want to delete 5 recordings?
#, java-printf-format
msgctxt "delete_recordings_confirmation"
msgid "Delete %s?"
msgstr "%s ஐ நீக்கவா?"

#, java-printf-format
msgctxt "delete_recordings"
msgid "%d recording"
msgid_plural "%d recordings"
msgstr[0] "%d பதிவு"
msgstr[1] "%d பதிவுகள்"

#.  Settings
#, java-printf-format
msgctxt "save_recordings_in"
msgid "Save recordings in"
msgstr "பதிவுகளைச் சேமிக்கவும்"

#, java-printf-format
msgctxt "filename_pattern"
msgid "Filename pattern"
msgstr "கோப்பு பெயர் முறை"

#, java-printf-format
msgctxt "filename_pattern_must_contain_all"
msgid ""
"Must include all placeholders for unique filenames (%Y, %M, %D, %h, %m, %s)"
msgstr ""
"தனிப்பட்ட கோப்புப் பெயர்களுக்கான அனைத்து ஒதுக்கிடங்களையும் சேர்க்க வேண்டும் "
"(%Y, %M, %D, %h, %m, %s)"

#, java-printf-format
msgctxt "audio_source"
msgid "Audio source"
msgstr "ஆடியோ சான்று"

#, java-printf-format
msgctxt "microphone_mode"
msgid "Microphone mode"
msgstr "மைக்ரோஃபோன் பயன்முறை"

#, java-printf-format
msgctxt "bitrate"
msgid "Bitrate"
msgstr "பிட்ரேட்"

#, java-printf-format
msgctxt "record_after_launch"
msgid "Start recording automatically after launching the app"
msgstr "பயன்பாட்டைத் தொடங்கிய பிறகு தானாகவே பதிவுசெய்யத் தொடங்கவும்"

#, java-printf-format
msgctxt "keep_screen_on"
msgid "Keep the screen on during recording"
msgstr "பதிவு செய்யும் போது திரையை இயக்கவும்"

#, java-printf-format
msgctxt "sample_rate"
msgid "Sample rate"
msgstr "மாதிரி விகிதம்"

#.  Settings Microphone mode selection
#, java-printf-format
msgctxt "microphone_mode_camcorder"
msgid "Camera (video)"
msgstr "கேமரா (வீடியோ)"

#, java-printf-format
msgctxt "microphone_mode_voice_communication"
msgid "Voice communication (auto gain)"
msgstr "குரல் தொடர்பு (தானியங்கு ஆதாயம்)"

#, java-printf-format
msgctxt "microphone_mode_voice_performance"
msgid "Voice performance (low-latency)"
msgstr "குரல் செயல்திறன் (குறைந்த தாமதம்)"

#, java-printf-format
msgctxt "microphone_mode_voice_recognition"
msgid "Voice recognition"
msgstr "குரல் ஏற்பு"

#, java-printf-format
msgctxt "microphone_mode_unprocessed"
msgid "Unprocessed (raw)"
msgstr "பதப்படுத்தப்படாத (பச்சையாக)"

#.  FAQ
#, java-printf-format
msgctxt "faq_1_title"
msgid "Can I hide the notification icon during recording?"
msgstr "பதிவு செய்யும் போது அறிவிப்பு ஐகானை மறைக்க முடியுமா?"

#, java-printf-format
msgctxt "faq_1_text"
msgid ""
"Well, it depends. While you use your device it is no longer possible to "
"fully hide the notifications of apps like this. If you check the proper "
"setting item, the app will do its best to hide it. You can hide it on the "
"lockscreen though, if you disable the displaying of sensitive notifications "
"in your device settings."
msgstr ""
