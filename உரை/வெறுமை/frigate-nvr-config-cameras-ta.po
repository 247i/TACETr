msgctxt "label"
msgid "CameraConfig"
msgstr "கேமரா கட்டமைப்பு"

msgctxt "name.label"
msgid "Camera name"
msgstr "கேமரா பெயர்"

msgctxt "name.description"
msgid "Camera name is required"
msgstr "கேமரா பெயர் தேவை"

msgctxt "friendly_name.label"
msgid "Friendly name"
msgstr "நட்புப் பெயர்"

msgctxt "friendly_name.description"
msgid "Camera friendly name used in the Frigate UI"
msgstr "Frigate இடைமுகம் இல் கேமரா நட்புப் பெயர் பயன்படுத்தப்பட்டது"

msgctxt "enabled.label"
msgid "Enabled"
msgstr "இயக்கப்பட்டது"

msgctxt "enabled.description"
msgid "Enabled"
msgstr "இயக்கப்பட்டது"

msgctxt "audio.label"
msgid "Audio detection"
msgstr "ஆடியோ கண்டறிதல்"

msgctxt "audio.description"
msgid "Settings for audio-based event detection for this camera."
msgstr ""
"இந்த கேமராவிற்கான ஆடியோ அடிப்படையிலான நிகழ்வு கண்டறிதலுக்கான அமைப்புகள்."

msgctxt "audio.enabled.label"
msgid "Enable audio detection"
msgstr "ஆடியோ கண்டறிதலை இயக்கு"

msgctxt "audio.enabled.description"
msgid "Enable or disable audio event detection for this camera."
msgstr "இந்த கேமராவிற்கு ஆடியோ நிகழ்வு கண்டறிதலை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "audio.max_not_heard.label"
msgid "End timeout"
msgstr "முடிவடையும் நேரம்"

msgctxt "audio.max_not_heard.description"
msgid ""
"Amount of seconds without the configured audio type before the audio event "
"is ended."
msgstr ""
"ஆடியோ நிகழ்வு முடிவதற்கு முன் உள்ளமைக்கப்பட்ட ஆடியோ வகை இல்லாத வினாடிகளின் "
"அளவு."

msgctxt "audio.min_volume.label"
msgid "Minimum volume"
msgstr "குறைந்தபட்ச அளவு"

msgctxt "audio.min_volume.description"
msgid ""
"Minimum RMS volume threshold required to run audio detection; lower values "
"increase sensitivity (e.g., 200 high, 500 medium, 1000 low)."
msgstr ""
"ஆடியோ கண்டறிதலை இயக்க குறைந்தபட்ச RMS தொகுதி வரம்பு தேவை; குறைந்த மதிப்புகள்"
" உணர்திறனை அதிகரிக்கின்றன (எ.கா., 200 உயர், 500 நடுத்தர, 1000 குறைந்த)."

msgctxt "audio.listen.label"
msgid "Listen types"
msgstr "கேட்கும் வகைகள்"

msgctxt "audio.listen.description"
msgid ""
"List of audio event types to detect (for example: bark, fire_alarm, speech, "
"yell)."
msgstr ""
"கண்டறிய வேண்டிய ஆடியோ நிகழ்வு வகைகளின் பட்டியல் (உதாரணமாக: பட்டை, தீ "
"முன்னறிவிப்பு, பேச்சு, அலறல்)."

msgctxt "audio.filters.label"
msgid "Audio filters"
msgstr "ஆடியோ வடிப்பான்கள்"

msgctxt "audio.filters.description"
msgid ""
"Per-audio-type filter settings such as confidence thresholds used to reduce "
"false positives."
msgstr ""
"தவறான நேர்மறைகளைக் குறைக்கப் பயன்படுத்தப்படும் நம்பிக்கை வரம்புகள் போன்ற "
"ஒவ்வொரு ஆடியோ வகை வடிகட்டி அமைப்புகள்."

msgctxt "audio.filters.threshold.label"
msgid "Minimum audio confidence"
msgstr "குறைந்தபட்ச ஆடியோ நம்பிக்கை"

msgctxt "audio.filters.threshold.description"
msgid "Minimum confidence threshold for the audio event to be counted."
msgstr "கணக்கிடப்பட வேண்டிய ஆடியோ நிகழ்விற்கான குறைந்தபட்ச நம்பிக்கை வரம்பு."

msgctxt "audio.enabled_in_config.label"
msgid "Original audio state"
msgstr "அசல் ஆடியோ நிலை"

msgctxt "audio.enabled_in_config.description"
msgid ""
"Indicates whether audio detection was originally enabled in the static "
"config file."
msgstr ""
"நிலையான கட்டமைப்பு கோப்பில் ஆடியோ கண்டறிதல் முதலில் இயக்கப்பட்டதா என்பதைக் "
"குறிக்கிறது."

msgctxt "audio.num_threads.label"
msgid "Detection threads"
msgstr "கண்டறிதல் நூல்கள்"

msgctxt "audio.num_threads.description"
msgid "Number of threads to use for audio detection processing."
msgstr ""
"ஆடியோ கண்டறிதல் செயலாக்கத்திற்கு பயன்படுத்த வேண்டிய நூல்களின் எண்ணிக்கை."

msgctxt "audio_transcription.label"
msgid "Audio transcription"
msgstr "ஆடியோ டிரான்ச்கிரிப்சன்"

msgctxt "audio_transcription.description"
msgid ""
"Settings for live and speech audio transcription used for events and live "
"captions."
msgstr ""
"நிகழ்வுகள் மற்றும் நேரடி வசனங்களுக்குப் பயன்படுத்தப்படும் நேரலை மற்றும் "
"பேச்சு ஆடியோ டிரான்ச்கிரிப்சனுக்கான அமைப்புகள்."

msgctxt "audio_transcription.enabled.label"
msgid "Enable transcription"
msgstr "டிரான்ச்கிரிப்சனை இயக்கு"

msgctxt "audio_transcription.enabled.description"
msgid "Enable or disable manually triggered audio event transcription."
msgstr ""
"கைமுறையாகத் தூண்டப்பட்ட ஆடியோ நிகழ்வு டிரான்ச்கிரிப்சனை இயக்கவும் அல்லது "
"முடக்கவும்."

msgctxt "audio_transcription.enabled_in_config.label"
msgid "Original transcription state"
msgstr "அசல் டிரான்ச்கிரிப்சன் நிலை"

msgctxt "audio_transcription.live_enabled.label"
msgid "Live transcription"
msgstr "நேரடி டிரான்ச்கிரிப்சன்"

msgctxt "audio_transcription.live_enabled.description"
msgid "Enable streaming live transcription for audio as it is received."
msgstr ""
"ஆடியோ பெறப்பட்டவுடன், நேரடி டிரான்ச்கிரிப்சனை ச்ட்ரீமிங் செய்ய இயக்கவும்."

msgctxt "birdseye.label"
msgid "Birdseye"
msgstr "பறவைக்கண்"

msgctxt "birdseye.description"
msgid ""
"Settings for the Birdseye composite view that composes multiple camera feeds"
" into a single layout."
msgstr ""
"ஒரே தளவமைப்பில் பல கேமரா ஊட்டங்களை உருவாக்கும் Birdseye கூட்டுக் காட்சிக்கான"
" அமைப்புகள்."

msgctxt "birdseye.enabled.label"
msgid "Enable Birdseye"
msgstr "Birdsey ஐ இயக்கு"

msgctxt "birdseye.enabled.description"
msgid "Enable or disable the Birdseye view feature."
msgstr "Birdseye காட்சி அம்சத்தை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "birdseye.mode.label"
msgid "Tracking mode"
msgstr "கண்காணிப்பு முறை"

msgctxt "birdseye.mode.description"
msgid ""
"Mode for including cameras in Birdseye: 'objects', 'motion', or "
"'continuous'."
msgstr ""
"பேர்ட்சேயில் கேமராக்களைச் சேர்ப்பதற்கான பயன்முறை: 'பொருள்கள்', 'இயக்கம்' "
"அல்லது 'தொடர்ந்து'."

msgctxt "birdseye.order.label"
msgid "Position"
msgstr "பதவி"

msgctxt "birdseye.order.description"
msgid ""
"Numeric position controlling the camera's ordering in the Birdseye layout."
msgstr "பேர்ட்சே அமைப்பில் கேமராவின் வரிசையைக் கட்டுப்படுத்தும் எண் நிலை."

msgctxt "detect.label"
msgid "Object Detection"
msgstr "பொருள் கண்டறிதல்"

msgctxt "detect.description"
msgid ""
"Settings for the detection/detect role used to run object detection and "
"initialize trackers."
msgstr ""
"கண்டறிதல்/கண்டறிதல் பங்குக்கான அமைப்புகள் ஆப்செக்ட் கண்டறிதலை இயக்க மற்றும் "
"டிராக்கர்களை துவக்க பயன்படுகிறது."

msgctxt "detect.enabled.label"
msgid "Enable object detection"
msgstr "பொருள் கண்டறிதலை இயக்கு"

msgctxt "detect.enabled.description"
msgid "Enable or disable object detection for this camera."
msgstr "இந்த கேமராவிற்கு பொருள் கண்டறிதலை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "detect.height.label"
msgid "Detect height"
msgstr "உயரத்தைக் கண்டறியவும்"

msgctxt "detect.height.description"
msgid ""
"Height (pixels) of frames used for the detect stream; leave empty to use the"
" native stream resolution."
msgstr ""
"கண்டறிதல் ச்ட்ரீமுக்குப் பயன்படுத்தப்படும் பிரேம்களின் உயரம் (பிக்சல்கள்); "
"சொந்த ச்ட்ரீம் தெளிவுத்திறனைப் பயன்படுத்த காலியாக விடவும்."

msgctxt "detect.width.label"
msgid "Detect width"
msgstr "அகலத்தைக் கண்டறியவும்"

msgctxt "detect.width.description"
msgid ""
"Width (pixels) of frames used for the detect stream; leave empty to use the "
"native stream resolution."
msgstr ""
"ச்ட்ரீம் கண்டறிவதற்குப் பயன்படுத்தப்படும் பிரேம்களின் அகலம் (பிக்சல்கள்); "
"சொந்த ச்ட்ரீம் தெளிவுத்திறனைப் பயன்படுத்த காலியாக விடவும்."

msgctxt "detect.fps.label"
msgid "Detect FPS"
msgstr "FPS ஐக் கண்டறியவும்"

msgctxt "detect.fps.description"
msgid ""
"Desired frames per second to run detection on; lower values reduce CPU usage"
" (recommended value is 5, only set higher - at most 10 - if tracking "
"extremely fast moving objects)."
msgstr ""
"கண்டறிதலை இயக்க நொடிக்கு தேவையான பிரேம்கள்; குறைந்த மதிப்புகள் சிபியு "
"பயன்பாட்டைக் குறைக்கின்றன (பரிந்துரைக்கப்படும் மதிப்பு 5, அதிக பட்சம் 10 - "
"மிக வேகமாக நகரும் பொருட்களைக் கண்காணித்தால் மட்டுமே அதிகமாக அமைக்கப்படும்)."

msgctxt "detect.min_initialized.label"
msgid "Minimum initialization frames"
msgstr "குறைந்தபட்ச துவக்க சட்டங்கள்"

msgctxt "detect.min_initialized.description"
msgid ""
"Number of consecutive detection hits required before creating a tracked "
"object. Increase to reduce false initializations. Default value is fps "
"divided by 2."
msgstr ""
"டிராக் செய்யப்பட்ட பொருளை உருவாக்கும் முன் தேவைப்படும் தொடர்ச்சியான "
"கண்டறிதல் வெற்றிகளின் எண்ணிக்கை. தவறான துவக்கங்களைக் குறைக்க அதிகரிக்கவும். "
"இயல்புநிலை மதிப்பு fps 2 ஆல் வகுக்கப்படும்."

msgctxt "detect.max_disappeared.label"
msgid "Maximum disappeared frames"
msgstr "அதிகபட்சமாக காணாமல் போன பிரேம்கள்"

msgctxt "detect.max_disappeared.description"
msgid ""
"Number of frames without a detection before a tracked object is considered "
"gone."
msgstr ""
"ட்ராக் செய்யப்பட்ட பொருள் மறைந்ததாகக் கருதப்படுவதற்கு முன், கண்டறிதல் இல்லாத"
" ஃப்ரேம்களின் எண்ணிக்கை."

msgctxt "detect.stationary.label"
msgid "Stationary objects config"
msgstr "நிலையான பொருள்களின் கட்டமைப்பு"

msgctxt "detect.stationary.description"
msgid ""
"Settings to detect and manage objects that remain stationary for a period of"
" time."
msgstr ""
"குறிப்பிட்ட காலத்திற்கு நிலையாக இருக்கும் பொருட்களைக் கண்டறிந்து "
"நிர்வகிப்பதற்கான அமைப்புகள்."

msgctxt "detect.stationary.interval.label"
msgid "Stationary interval"
msgstr "நிலையான இடைவெளி"

msgctxt "detect.stationary.interval.description"
msgid ""
"How often (in frames) to run a detection check to confirm a stationary "
"object."
msgstr ""
"நிலையான பொருளை உறுதிப்படுத்த எத்தனை முறை (பிரேம்களில்) கண்டறிதல் சோதனையை "
"இயக்க வேண்டும்."

msgctxt "detect.stationary.threshold.label"
msgid "Stationary threshold"
msgstr "நிலையான வாசல்"

msgctxt "detect.stationary.threshold.description"
msgid ""
"Number of frames with no position change required to mark an object as "
"stationary."
msgstr ""
"ஒரு பொருளை நிலையானதாகக் குறிக்க, நிலை மாற்றம் இல்லாத பிரேம்களின் எண்ணிக்கை."

msgctxt "detect.stationary.max_frames.label"
msgid "Max frames"
msgstr "அதிகபட்ச பிரேம்கள்"

msgctxt "detect.stationary.max_frames.description"
msgid "Limits how long stationary objects are tracked before being discarded."
msgstr ""
"நிராகரிப்பதற்கு முன் நிலையான பொருள்கள் எவ்வளவு நேரம் கண்காணிக்கப்படும் "
"என்பதைக் கட்டுப்படுத்துகிறது."

msgctxt "detect.stationary.max_frames.default.label"
msgid "Default max frames"
msgstr "இயல்புநிலை அதிகபட்ச பிரேம்கள்"

msgctxt "detect.stationary.max_frames.default.description"
msgid "Default maximum frames to track a stationary object before stopping."
msgstr ""
"ஒரு நிலையான பொருளை நிறுத்தும் முன் கண்காணிக்க இயல்புநிலை அதிகபட்ச பிரேம்கள்."

msgctxt "detect.stationary.max_frames.objects.label"
msgid "Object max frames"
msgstr "பொருள் அதிகபட்ச சட்டங்கள்"

msgctxt "detect.stationary.max_frames.objects.description"
msgid "Per-object overrides for maximum frames to track stationary objects."
msgstr ""
"நிலையான பொருட்களைக் கண்காணிக்க அதிகபட்ச பிரேம்களுக்கு ஒவ்வொரு பொருளுக்கும் "
"மேலெழுகிறது."

msgctxt "detect.stationary.classifier.label"
msgid "Enable visual classifier"
msgstr "காட்சி வகைப்படுத்தியை இயக்கு"

msgctxt "detect.stationary.classifier.description"
msgid ""
"Use a visual classifier to detect truly stationary objects even when "
"bounding boxes jitter."
msgstr ""
"கட்டுப்பெட்டிகள் நடுங்கும்போது கூட உண்மையான நிலையான பொருட்களைக் கண்டறிய "
"காட்சி வகைப்படுத்தியைப் பயன்படுத்தவும்."

msgctxt "detect.annotation_offset.label"
msgid "Annotation offset"
msgstr "சிறுகுறிப்பு ஆஃப்செட்"

msgctxt "detect.annotation_offset.description"
msgid ""
"Milliseconds to shift detect annotations to better align timeline bounding "
"boxes with recordings; can be positive or negative."
msgstr ""
"பதிவுகளுடன் கூடிய காலவரிசை எல்லைப் பெட்டிகளை சிறப்பாகச் சீரமைக்க, சிறு "
"விநாடிகளைக் கண்டறிதல்களை மாற்றுவதற்கு மில்லி விநாடிகள்; நேர்மறை அல்லது "
"எதிர்மறையாக இருக்கலாம்."

msgctxt "face_recognition.label"
msgid "Face recognition"
msgstr "முக ஏற்பு"

msgctxt "face_recognition.description"
msgid "Settings for face detection and recognition for this camera."
msgstr ""
"இந்தக் கேமராவிற்கான முகம் கண்டறிதல் மற்றும் அங்கீகாரத்திற்கான அமைப்புகள்."

msgctxt "face_recognition.enabled.label"
msgid "Enable face recognition"
msgstr "முக அங்கீகாரத்தை இயக்கு"

msgctxt "face_recognition.enabled.description"
msgid "Enable or disable face recognition."
msgstr "முக அங்கீகாரத்தை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "face_recognition.min_area.label"
msgid "Minimum face area"
msgstr "முகத்தின் குறைந்தபட்ச பகுதி"

msgctxt "face_recognition.min_area.description"
msgid ""
"Minimum area (pixels) of a detected face box required to attempt "
"recognition."
msgstr ""
"கண்டறியப்பட்ட முகப் பெட்டியின் குறைந்தபட்ச பரப்பளவு (பிக்சல்கள்) அடையாளம் "
"காண முயற்சிக்க வேண்டும்."

msgctxt "ffmpeg.label"
msgid "Streams (FFmpeg)"
msgstr "ச்ட்ரீம்கள் (FFmpeg)"

msgctxt "ffmpeg.description"
msgid ""
"Camera stream inputs and FFmpeg options, including binary path, args, "
"hwaccel, and per-role output args."
msgstr ""
"கேமரா ச்ட்ரீம் உள்ளீடுகள் மற்றும் FFmpeg விருப்பங்கள், பைனரி பாதை, args, "
"hwaccel மற்றும் per-role output args உட்பட."

msgctxt "ffmpeg.path.label"
msgid "FFmpeg path"
msgstr "FFmpeg பாதை"

msgctxt "ffmpeg.path.description"
msgid "Path to the FFmpeg binary to use or a version alias (\"7.0\" or \"8.0\")."
msgstr ""
"பயன்படுத்த FFmpeg பைனரிக்கான பாதை அல்லது பதிப்பு மாற்றுப்பெயர் (\"7.0\" "
"அல்லது \"8.0\")."

msgctxt "ffmpeg.global_args.label"
msgid "FFmpeg global arguments"
msgstr "FFmpeg உலகளாவிய வாதங்கள்"

msgctxt "ffmpeg.global_args.description"
msgid "Global arguments passed to FFmpeg processes."
msgstr "உலகளாவிய வாதங்கள் FFmpeg செயல்முறைகளுக்கு அனுப்பப்பட்டன."

msgctxt "ffmpeg.hwaccel_args.label"
msgid "Hardware acceleration arguments"
msgstr "வன்பொருள் முடுக்கம் வாதங்கள்"

msgctxt "ffmpeg.hwaccel_args.description"
msgid ""
"Hardware acceleration arguments for FFmpeg. Provider-specific presets are "
"recommended."
msgstr ""
"FFmpeg க்கான வன்பொருள் முடுக்கம் வாதங்கள். வழங்குநர்-குறிப்பிட்ட "
"முன்னமைவுகள் பரிந்துரைக்கப்படுகின்றன."

msgctxt "ffmpeg.input_args.label"
msgid "Input arguments"
msgstr "உள்ளீட்டு வாதங்கள்"

msgctxt "ffmpeg.input_args.description"
msgid "Input arguments applied to FFmpeg input streams."
msgstr ""
"உள்ளீட்டு வாதங்கள் FFmpeg உள்ளீட்டு ச்ட்ரீம்களுக்குப் பயன்படுத்தப்பட்டன."

msgctxt "ffmpeg.output_args.label"
msgid "Output arguments"
msgstr "வெளியீட்டு வாதங்கள்"

msgctxt "ffmpeg.output_args.description"
msgid ""
"Default output arguments used for different FFmpeg roles such as detect and "
"record."
msgstr ""
"கண்டறிதல் மற்றும் பதிவு போன்ற பல்வேறு FFmpeg பாத்திரங்களுக்கு இயல்புநிலை "
"வெளியீட்டு வாதங்கள் பயன்படுத்தப்படுகின்றன."

msgctxt "ffmpeg.output_args.detect.label"
msgid "Detect output arguments"
msgstr "வெளியீட்டு வாதங்களைக் கண்டறிக"

msgctxt "ffmpeg.output_args.detect.description"
msgid "Default output arguments for detect role streams."
msgstr "பங்கு ச்ட்ரீம்களைக் கண்டறிவதற்கான இயல்புநிலை வெளியீட்டு வாதங்கள்."

msgctxt "ffmpeg.output_args.record.label"
msgid "Record output arguments"
msgstr "வெளியீட்டு வாதங்களை பதிவு செய்யவும்"

msgctxt "ffmpeg.output_args.record.description"
msgid "Default output arguments for record role streams."
msgstr "பதிவு ரோல் ச்ட்ரீம்களுக்கான இயல்புநிலை வெளியீட்டு வாதங்கள்."

msgctxt "ffmpeg.retry_interval.label"
msgid "FFmpeg retry time"
msgstr "FFmpeg மறுமுயற்சி நேரம்"

msgctxt "ffmpeg.retry_interval.description"
msgid ""
"Seconds to wait before attempting to reconnect a camera stream after "
"failure. Default is 10."
msgstr ""
"தோல்விக்குப் பிறகு கேமரா ச்ட்ரீமை மீண்டும் இணைக்க முயற்சிக்கும் முன் "
"வினாடிகள் காத்திருக்க வேண்டும். இயல்புநிலை 10 ஆகும்."

msgctxt "ffmpeg.apple_compatibility.label"
msgid "Apple compatibility"
msgstr "ஆப்பிள் இணக்கத்தன்மை"

msgctxt "ffmpeg.apple_compatibility.description"
msgid ""
"Enable HEVC tagging for better Apple player compatibility when recording "
"H.265."
msgstr ""
"H.265 ஐ பதிவு செய்யும் போது சிறந்த அரத்திப்பழம், குமளிப்பழம் Player "
"இணக்கத்தன்மைக்கு HEVC டேக்கிங்கை இயக்கவும்."

msgctxt "ffmpeg.gpu.label"
msgid "GPU index"
msgstr "GPU இன்டெக்ச்"

msgctxt "ffmpeg.gpu.description"
msgid "Default GPU index used for hardware acceleration if available."
msgstr ""
"வன்பொருள் முடுக்கம் இருந்தால் இயல்புநிலை GPU இன்டெக்ச் பயன்படுத்தப்படும்."

msgctxt "ffmpeg.inputs.label"
msgid "Camera inputs"
msgstr "கேமரா உள்ளீடுகள்"

msgctxt "ffmpeg.inputs.description"
msgid "List of input stream definitions (paths and roles) for this camera."
msgstr ""
"இந்த கேமராவிற்கான உள்ளீட்டு ச்ட்ரீம் வரையறைகளின் (பாதைகள் மற்றும் "
"பாத்திரங்கள்) பட்டியல்."

msgctxt "ffmpeg.inputs.path.label"
msgid "Input path"
msgstr "உள்ளீட்டு பாதை"

msgctxt "ffmpeg.inputs.path.description"
msgid "Camera input stream URL or path."
msgstr "கேமரா உள்ளீடு ச்ட்ரீம் முகவரி அல்லது பாதை."

msgctxt "ffmpeg.inputs.roles.label"
msgid "Input roles"
msgstr "உள்ளீட்டு பாத்திரங்கள்"

msgctxt "ffmpeg.inputs.roles.description"
msgid "Roles for this input stream."
msgstr "இந்த உள்ளீட்டு ச்ட்ரீமிற்கான பாத்திரங்கள்."

msgctxt "ffmpeg.inputs.global_args.label"
msgid "FFmpeg global arguments"
msgstr "FFmpeg உலகளாவிய வாதங்கள்"

msgctxt "ffmpeg.inputs.global_args.description"
msgid "FFmpeg global arguments for this input stream."
msgstr "இந்த உள்ளீட்டு ச்ட்ரீமிற்கான FFmpeg உலகளாவிய வாதங்கள்."

msgctxt "ffmpeg.inputs.hwaccel_args.label"
msgid "Hardware acceleration arguments"
msgstr "வன்பொருள் முடுக்கம் வாதங்கள்"

msgctxt "ffmpeg.inputs.hwaccel_args.description"
msgid "Hardware acceleration arguments for this input stream."
msgstr "இந்த உள்ளீட்டு ச்ட்ரீமிற்கான வன்பொருள் முடுக்கம் வாதங்கள்."

msgctxt "ffmpeg.inputs.input_args.label"
msgid "Input arguments"
msgstr "உள்ளீட்டு வாதங்கள்"

msgctxt "ffmpeg.inputs.input_args.description"
msgid "Input arguments specific to this stream."
msgstr "இந்த ச்ட்ரீமுக்கு குறிப்பிட்ட உள்ளீடு வாதங்கள்."

msgctxt "live.label"
msgid "Live playback"
msgstr "நேரடி பின்னணி"

msgctxt "live.description"
msgid ""
"Settings used by the Web UI to control live stream selection, resolution and"
" quality."
msgstr ""
"லைவ் ச்ட்ரீம் தேர்வு, தெளிவுத்திறன் மற்றும் தகுதி ஆகியவற்றைக் கட்டுப்படுத்த,"
" வலை இடைமுகம் ஆல் பயன்படுத்தப்படும் அமைப்புகள்."

msgctxt "live.streams.label"
msgid "Live stream names"
msgstr "நேரடி ச்ட்ரீம் பெயர்கள்"

msgctxt "live.streams.description"
msgid ""
"Mapping of configured stream names to restream/go2rtc names used for live "
"playback."
msgstr ""
"லைவ் பிளேபேக்கிற்குப் பயன்படுத்தப்படும் ரீச்ட்ரீம்/go2rtc பெயர்களுக்கு "
"உள்ளமைக்கப்பட்ட ச்ட்ரீம் பெயர்களின் மேப்பிங்."

msgctxt "live.height.label"
msgid "Live height"
msgstr "நேரடி உயரம்"

msgctxt "live.height.description"
msgid ""
"Height (pixels) to render the jsmpeg live stream in the Web UI; must be <= "
"detect stream height."
msgstr ""
"வலை இடைமுகம் இல் jsmpeg லைவ் ச்ட்ரீமை வழங்க உயரம் (பிக்சல்கள்); ச்ட்ரீம் "
"உயரத்தைக் கண்டறிய <= இருக்க வேண்டும்."

msgctxt "live.quality.label"
msgid "Live quality"
msgstr "நேரடி தகுதி"

msgctxt "live.quality.description"
msgid "Encoding quality for the jsmpeg stream (1 highest, 31 lowest)."
msgstr "jsmpeg ச்ட்ரீமிற்கான குறியாக்கத் தகுதி (1 உயர்ந்தது, 31 குறைந்தது)."

msgctxt "lpr.label"
msgid "License Plate Recognition"
msgstr "உரிமத் தட்டு ஏற்பு"

msgctxt "lpr.description"
msgid ""
"License plate recognition settings including detection thresholds, "
"formatting, and known plates."
msgstr ""
"கண்டறிதல் வரம்புகள், வடிவமைத்தல் மற்றும் அறியப்பட்ட தட்டுகள் உள்ளிட்ட உரிமத்"
" தட்டு அங்கீகார அமைப்புகள்."

msgctxt "lpr.enabled.label"
msgid "Enable LPR"
msgstr "LPRஐ இயக்கு"

msgctxt "lpr.enabled.description"
msgid "Enable or disable LPR on this camera."
msgstr "இந்தக் கேமராவில் LPRஐ இயக்கவும் அல்லது முடக்கவும்."

msgctxt "lpr.expire_time.label"
msgid "Expire seconds"
msgstr "காலாவதி வினாடிகள்"

msgctxt "lpr.expire_time.description"
msgid ""
"Time in seconds after which an unseen plate is expired from the tracker (for"
" dedicated LPR cameras only)."
msgstr ""
"சில வினாடிகளில் டிராக்கரிலிருந்து ஒரு காணப்படாத தட்டு காலாவதியாகும் "
"(பிரத்யேக LPR கேமராக்களுக்கு மட்டும்)."

msgctxt "lpr.min_area.label"
msgid "Minimum plate area"
msgstr "குறைந்தபட்ச தட்டு பகுதி"

msgctxt "lpr.min_area.description"
msgid "Minimum plate area (pixels) required to attempt recognition."
msgstr "அறிதல் முயற்சிக்கு குறைந்தபட்ச தட்டு பகுதி (பிக்சல்கள்) தேவை."

msgctxt "lpr.enhancement.label"
msgid "Enhancement level"
msgstr "மேம்படுத்தல் நிலை"

msgctxt "lpr.enhancement.description"
msgid ""
"Enhancement level (0-10) to apply to plate crops prior to OCR; higher values"
" may not always improve results, levels above 5 may only work with night "
"time plates and should be used with caution."
msgstr ""
"OCRக்கு முன் தட்டுப் பயிர்களுக்குப் பயன்படுத்துவதற்கான மேம்படுத்தல் நிலை "
"(0-10); அதிக மதிப்புகள் எப்போதும் முடிவுகளை மேம்படுத்தாது, 5 க்கு மேல் உள்ள "
"நிலைகள் இரவு நேர தட்டுகளுடன் மட்டுமே வேலை செய்யலாம் மற்றும் எச்சரிக்கையுடன் "
"பயன்படுத்தப்பட வேண்டும்."

msgctxt "motion.label"
msgid "Motion detection"
msgstr "இயக்கம் கண்டறிதல்"

msgctxt "motion.description"
msgid "Default motion detection settings for this camera."
msgstr "இந்த கேமராவிற்கான இயல்புநிலை இயக்கம் கண்டறிதல் அமைப்புகள்."

msgctxt "motion.enabled.label"
msgid "Enable motion detection"
msgstr "இயக்கம் கண்டறிதலை இயக்கு"

msgctxt "motion.enabled.description"
msgid "Enable or disable motion detection for this camera."
msgstr "இந்த கேமராவில் மோசன் கண்டறிதலை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "motion.threshold.label"
msgid "Motion threshold"
msgstr "இயக்க வாசல்"

msgctxt "motion.threshold.description"
msgid ""
"Pixel difference threshold used by the motion detector; higher values reduce"
" sensitivity (range 1-255)."
msgstr ""
"மோசன் டிடெக்டரால் பயன்படுத்தப்படும் படப்புள்ளி வேறுபாடு வரம்பு; அதிக "
"மதிப்புகள் உணர்திறனைக் குறைக்கின்றன (வரம்பு 1-255)."

msgctxt "motion.lightning_threshold.label"
msgid "Lightning threshold"
msgstr "மின்னல் வாசல்"

msgctxt "motion.lightning_threshold.description"
msgid ""
"Threshold to detect and ignore brief lighting spikes (lower is more "
"sensitive, values between 0.3 and 1.0). This does not prevent motion "
"detection entirely; it merely causes the detector to stop analyzing "
"additional frames once the threshold is exceeded. Motion-based recordings "
"are still created during these events."
msgstr ""
"சுருக்கமான லைட்டிங் ச்பைக்குகளைக் கண்டறிந்து புறக்கணிப்பதற்கான நுழைவாயில் "
"(குறைவானது அதிக உணர்திறன், 0.3 மற்றும் 1.0 இடையே மதிப்புகள்). இது இயக்கம் "
"கண்டறிவதை முற்றிலும் தடுக்காது; வாசலைத் தாண்டியவுடன், டிடெக்டர் கூடுதல் "
"பிரேம்களை பகுப்பாய்வு செய்வதை நிறுத்துகிறது. இந்த நிகழ்வுகளின் போது இயக்கம் "
"சார்ந்த பதிவுகள் இன்னும் உருவாக்கப்படுகின்றன."

msgctxt "motion.skip_motion_threshold.label"
msgid "Skip motion threshold"
msgstr "இயக்க வாசலைத் தவிர்க்கவும்"

msgctxt "motion.skip_motion_threshold.description"
msgid ""
"If set to a value between 0.0 and 1.0, and more than this fraction of the "
"image changes in a single frame, the detector will return no motion boxes "
"and immediately recalibrate. This can save CPU and reduce false positives "
"during lightning, storms, etc., but may miss real events such as a PTZ "
"camera auto‑tracking an object. The trade‑off is between dropping a few "
"megabytes of recordings versus reviewing a couple short clips. Leave unset "
"(None) to disable this feature."
msgstr ""
"0.0 மற்றும் 1.0 க்கு இடையில் ஒரு மதிப்பிற்கு அமைக்கப்பட்டால், மற்றும் "
"படத்தின் இந்த பகுதியை விட அதிகமாக ஒரு சட்டத்தில் மாறினால், கண்டறிதல் எந்த "
"இயக்கப் பெட்டிகளையும் திருப்பி உடனடியாக மறுசீரமைக்கும். இது சிபியு ஐச் "
"சேமிக்கலாம் மற்றும் மின்னல், புயல்கள் போன்றவற்றின் போது தவறான நேர்மறைகளைக் "
"குறைக்கலாம், ஆனால் PTZ கேமரா ஒரு பொருளைத் தானாகக் கண்காணிப்பது போன்ற "
"உண்மையான நிகழ்வுகளைத் தவறவிடலாம். ஒரு சில மெகாபைட் ரெக்கார்டிங்குகளை "
"கைவிடுவதற்கும் இரண்டு சிறிய கிளிப்களை மதிப்பாய்வு செய்வதற்கும் இடையே வணிகம் "
"நடைபெறுகிறது. இந்த அம்சத்தை முடக்க அமைக்காமல் (எதுவுமில்லை) விடவும்."

msgctxt "motion.improve_contrast.label"
msgid "Improve contrast"
msgstr "மாறுபாட்டை மேம்படுத்தவும்"

msgctxt "motion.improve_contrast.description"
msgid ""
"Apply contrast improvement to frames before motion analysis to help "
"detection."
msgstr ""
"கண்டறிதலுக்கு உதவ, மோசன் பகுப்பாய்விற்கு முன் பிரேம்களுக்கு மாறுபாடு "
"மேம்பாட்டைப் பயன்படுத்தவும்."

msgctxt "motion.contour_area.label"
msgid "Contour area"
msgstr "விளிம்பு பகுதி"

msgctxt "motion.contour_area.description"
msgid ""
"Minimum contour area in pixels required for a motion contour to be counted."
msgstr "பிக்சல்களில் குறைந்தபட்ச விளிம்பு பகுதி கணக்கிடப்பட வேண்டும்."

msgctxt "motion.delta_alpha.label"
msgid "Delta alpha"
msgstr "டெல்டா ஆல்பா"

msgctxt "motion.delta_alpha.description"
msgid ""
"Alpha blending factor used in frame differencing for motion calculation."
msgstr ""
"ஆல்ஃபா கலப்பு காரணி இயக்கம் கணக்கீடு செய்ய சட்ட வேறுபாடு "
"பயன்படுத்தப்படுகிறது."

msgctxt "motion.frame_alpha.label"
msgid "Frame alpha"
msgstr "சட்ட ஆல்பா"

msgctxt "motion.frame_alpha.description"
msgid "Alpha value used when blending frames for motion preprocessing."
msgstr ""
"மோசன் ப்ரீபிராசசிங்கிற்கு ஃப்ரேம்களை கலக்கும் போது ஆல்பா மதிப்பு "
"பயன்படுத்தப்படுகிறது."

msgctxt "motion.frame_height.label"
msgid "Frame height"
msgstr "சட்ட உயரம்"

msgctxt "motion.frame_height.description"
msgid "Height in pixels to scale frames to when computing motion."
msgstr "இயக்கத்தை கணக்கிடும் போது சட்டகங்களை அளவிட பிக்சல்களில் உயரம்."

msgctxt "motion.mask.label"
msgid "Mask coordinates"
msgstr "முகமூடி ஒருங்கிணைப்புகள்"

msgctxt "motion.mask.description"
msgid ""
"Ordered x,y coordinates defining the motion mask polygon used to "
"include/exclude areas."
msgstr ""
"வரிசைப்படுத்தப்பட்ட x,y ஆயத்தொலைவுகள், பகுதிகளைச் சேர்க்க/விலக்கப் பயன்படும்"
" மோசன் மாச்க் பலகோணத்தை வரையறுக்கிறது."

msgctxt "motion.mqtt_off_delay.label"
msgid "MQTT off delay"
msgstr "MQTT நேரந்தவறுகை"

msgctxt "motion.mqtt_off_delay.description"
msgid ""
"Seconds to wait after last motion before publishing an MQTT 'off' state."
msgstr ""
"MQTT 'ஆஃப்' நிலையை வெளியிடுவதற்கு முன் கடைசி இயக்கத்திற்குப் பிறகு "
"காத்திருக்க வேண்டிய வினாடிகள்."

msgctxt "motion.enabled_in_config.label"
msgid "Original motion state"
msgstr "அசல் இயக்க நிலை"

msgctxt "motion.enabled_in_config.description"
msgid ""
"Indicates whether motion detection was enabled in the original static "
"configuration."
msgstr ""
"அசல் நிலையான உள்ளமைவில் இயக்கம் கண்டறிதல் இயக்கப்பட்டதா என்பதைக் "
"குறிக்கிறது."

msgctxt "motion.raw_mask.label"
msgid "Raw Mask"
msgstr "மூல முகமூடி"

msgctxt "objects.label"
msgid "Objects"
msgstr "பொருள்கள்"

msgctxt "objects.description"
msgid ""
"Object tracking defaults including which labels to track and per-object "
"filters."
msgstr ""
"எந்த லேபிள்களைக் கண்காணிக்க வேண்டும் மற்றும் ஒவ்வொரு பொருளுக்கும் "
"வடிப்பான்கள் உட்பட ஆப்செக்ட் டிராக்கிங் இயல்புநிலைகள்."

msgctxt "objects.track.label"
msgid "Objects to track"
msgstr "கண்காணிக்க வேண்டிய பொருள்கள்"

msgctxt "objects.track.description"
msgid "List of object labels to track for this camera."
msgstr "இந்தக் கேமராவைக் கண்காணிக்க வேண்டிய பொருள் லேபிள்களின் பட்டியல்."

msgctxt "objects.filters.label"
msgid "Object filters"
msgstr "பொருள் வடிப்பான்கள்"

msgctxt "objects.filters.description"
msgid ""
"Filters applied to detected objects to reduce false positives (area, ratio, "
"confidence)."
msgstr ""
"தவறான நேர்மறைகளை (பகுதி, விகிதம், நம்பிக்கை) குறைக்க கண்டறியப்பட்ட "
"பொருட்களுக்கு வடிப்பான்கள் பயன்படுத்தப்படுகின்றன."

msgctxt "objects.filters.min_area.label"
msgid "Minimum object area"
msgstr "குறைந்தபட்ச பொருள் பரப்பளவு"

msgctxt "objects.filters.min_area.description"
msgid ""
"Minimum bounding box area (pixels or percentage) required for this object "
"type. Can be pixels (int) or percentage (float between 0.000001 and 0.99)."
msgstr ""
"இந்த ஆப்செக்ட் வகைக்குத் தேவையான குறைந்தபட்ச எல்லைப் பெட்டிப் பகுதி "
"(பிக்சல்கள் அல்லது சதவீதம்). படப்புள்ளிகள் (int) அல்லது விழுக்காடு (0.000001"
" மற்றும் 0.99 இடையே மிதவை) இருக்கலாம்."

msgctxt "objects.filters.max_area.label"
msgid "Maximum object area"
msgstr "பொருளின் அதிகபட்ச பரப்பளவு"

msgctxt "objects.filters.max_area.description"
msgid ""
"Maximum bounding box area (pixels or percentage) allowed for this object "
"type. Can be pixels (int) or percentage (float between 0.000001 and 0.99)."
msgstr ""
"இந்த ஆப்செக்ட் வகைக்கு அனுமதிக்கப்படும் அதிகபட்ச எல்லைப் பெட்டிப் பகுதி "
"(பிக்சல்கள் அல்லது சதவீதம்). படப்புள்ளிகள் (int) அல்லது விழுக்காடு (0.000001"
" மற்றும் 0.99 இடையே மிதவை) இருக்கலாம்."

msgctxt "objects.filters.min_ratio.label"
msgid "Minimum aspect ratio"
msgstr "குறைந்தபட்ச தோற்ற விகிதம்"

msgctxt "objects.filters.min_ratio.description"
msgid "Minimum width/height ratio required for the bounding box to qualify."
msgstr "எல்லைப் பெட்டி தகுதிபெற குறைந்தபட்ச அகலம்/உயரம் விகிதம் தேவை."

msgctxt "objects.filters.max_ratio.label"
msgid "Maximum aspect ratio"
msgstr "அதிகபட்ச தோற்ற விகிதம்"

msgctxt "objects.filters.max_ratio.description"
msgid "Maximum width/height ratio allowed for the bounding box to qualify."
msgstr ""
"வரம்புப் பெட்டி தகுதிபெற அதிகபட்ச அகலம்/உயரம் விகிதம் அனுமதிக்கப்படுகிறது."

msgctxt "objects.filters.threshold.label"
msgid "Confidence threshold"
msgstr "நம்பிக்கை வாசல்"

msgctxt "objects.filters.threshold.description"
msgid ""
"Average detection confidence threshold required for the object to be "
"considered a true positive."
msgstr ""
"பொருள் உண்மையான நேர்மறையாகக் கருதப்படுவதற்கு சராசரி கண்டறிதல் நம்பிக்கை "
"வரம்பு தேவை."

msgctxt "objects.filters.min_score.label"
msgid "Minimum confidence"
msgstr "குறைந்தபட்ச நம்பிக்கை"

msgctxt "objects.filters.min_score.description"
msgid ""
"Minimum single-frame detection confidence required for the object to be "
"counted."
msgstr ""
"கணக்கிடப்படும் பொருளுக்கு குறைந்தபட்ச ஒற்றை-சட்ட கண்டறிதல் நம்பிக்கை தேவை."

msgctxt "objects.filters.mask.label"
msgid "Filter mask"
msgstr "வடிகட்டி முகமூடி"

msgctxt "objects.filters.mask.description"
msgid ""
"Polygon coordinates defining where this filter applies within the frame."
msgstr ""
"இந்த வடிப்பான் சட்டகத்திற்குள் எங்கு பொருந்தும் என்பதை வரையறுக்கும் பலகோண "
"ஒருங்கிணைப்புகள்."

msgctxt "objects.filters.raw_mask.label"
msgid "Raw Mask"
msgstr "மூல முகமூடி"

msgctxt "objects.mask.label"
msgid "Object mask"
msgstr "பொருள் முகமூடி"

msgctxt "objects.mask.description"
msgid "Mask polygon used to prevent object detection in specified areas."
msgstr ""
"முகமூடி பலகோணம் குறிப்பிட்ட பகுதிகளில் பொருள் கண்டறிதலைத் தடுக்கப் "
"பயன்படுகிறது."

msgctxt "objects.raw_mask.label"
msgid "Raw Mask"
msgstr "மூல முகமூடி"

msgctxt "objects.genai.label"
msgid "GenAI object config"
msgstr "GenAI பொருள் கட்டமைப்பு"

msgctxt "objects.genai.description"
msgid ""
"GenAI options for describing tracked objects and sending frames for "
"generation."
msgstr ""
"கண்காணிக்கப்பட்ட பொருள்களை விவரிப்பதற்கும், தலைமுறைக்கு பிரேம்களை "
"அனுப்புவதற்கும் GenAI விருப்பங்கள்."

msgctxt "objects.genai.enabled.label"
msgid "Enable GenAI"
msgstr "GenAI ஐ இயக்கவும்"

msgctxt "objects.genai.enabled.description"
msgid ""
"Enable GenAI generation of descriptions for tracked objects by default."
msgstr ""
"டிராக் செய்யப்பட்ட பொருள்களுக்கான GenAI உருவாக்க விளக்கங்களை இயல்பாக "
"இயக்கவும்."

msgctxt "objects.genai.use_snapshot.label"
msgid "Use snapshots"
msgstr "ச்னாப்சாட்களைப் பயன்படுத்தவும்"

msgctxt "objects.genai.use_snapshot.description"
msgid ""
"Use object snapshots instead of thumbnails for GenAI description generation."
msgstr ""
"GenAI விளக்கத்தை உருவாக்க சிறுபடங்களுக்குப் பதிலாக பொருள் ச்னாப்சாட்களைப் "
"பயன்படுத்தவும்."

msgctxt "objects.genai.prompt.label"
msgid "Caption prompt"
msgstr "தலைப்பு உடனடி"

msgctxt "objects.genai.prompt.description"
msgid "Default prompt template used when generating descriptions with GenAI."
msgstr ""
"GenAI உடன் விளக்கங்களை உருவாக்கும் போது இயல்புநிலை ப்ராம்ட் டெம்ப்ளேட் "
"பயன்படுத்தப்படுகிறது."

msgctxt "objects.genai.object_prompts.label"
msgid "Object prompts"
msgstr "பொருள் தூண்டுகிறது"

msgctxt "objects.genai.object_prompts.description"
msgid "Per-object prompts to customize GenAI outputs for specific labels."
msgstr ""
"குறிப்பிட்ட லேபிள்களுக்கு GenAI வெளியீடுகளைத் தனிப்பயனாக்க ஒவ்வொரு பொருளும் "
"தூண்டுகிறது."

msgctxt "objects.genai.objects.label"
msgid "GenAI objects"
msgstr "GenAI பொருள்கள்"

msgctxt "objects.genai.objects.description"
msgid "List of object labels to send to GenAI by default."
msgstr "இயல்புநிலையாக GenAIக்கு அனுப்ப வேண்டிய பொருள் லேபிள்களின் பட்டியல்."

msgctxt "objects.genai.required_zones.label"
msgid "Required zones"
msgstr "தேவையான மண்டலங்கள்"

msgctxt "objects.genai.required_zones.description"
msgid ""
"Zones that must be entered for objects to qualify for GenAI description "
"generation."
msgstr ""
"GenAI விளக்க உருவாக்கத்திற்குத் தகுதிபெற பொருள்களுக்கு உள்ளிட வேண்டிய "
"மண்டலங்கள்."

msgctxt "objects.genai.debug_save_thumbnails.label"
msgid "Save thumbnails"
msgstr "சிறுபடங்களைச் சேமிக்கவும்"

msgctxt "objects.genai.debug_save_thumbnails.description"
msgid "Save thumbnails sent to GenAI for debugging and review."
msgstr ""
"பிழைத்திருத்தம் மற்றும் மதிப்பாய்வுக்காக GenAI க்கு அனுப்பப்பட்ட "
"சிறுபடங்களைச் சேமிக்கவும்."

msgctxt "objects.genai.send_triggers.label"
msgid "GenAI triggers"
msgstr "GenAI தூண்டுதல்கள்"

msgctxt "objects.genai.send_triggers.description"
msgid ""
"Defines when frames should be sent to GenAI (on end, after updates, etc.)."
msgstr ""
"பிரேம்கள் எப்போது GenAI க்கு அனுப்பப்பட வேண்டும் என்பதை வரையறுக்கிறது "
"(இறுதியில், புதுப்பிப்புகளுக்குப் பிறகு, முதலியன)."

msgctxt "objects.genai.send_triggers.tracked_object_end.label"
msgid "Send on end"
msgstr "இறுதியில் அனுப்பவும்"

msgctxt "objects.genai.send_triggers.tracked_object_end.description"
msgid "Send a request to GenAI when the tracked object ends."
msgstr "கண்காணிக்கப்பட்ட பொருள் முடிந்ததும் GenAI க்கு கோரிக்கையை அனுப்பவும்."

msgctxt "objects.genai.send_triggers.after_significant_updates.label"
msgid "Early GenAI trigger"
msgstr "ஆரம்பகால GenAI தூண்டுதல்"

msgctxt "objects.genai.send_triggers.after_significant_updates.description"
msgid ""
"Send a request to GenAI after a specified number of significant updates for "
"the tracked object."
msgstr ""
"கண்காணிக்கப்பட்ட பொருளுக்கு குறிப்பிட்ட எண்ணிக்கையிலான குறிப்பிடத்தக்க "
"புதுப்பிப்புகளுக்குப் பிறகு GenAI க்கு கோரிக்கையை அனுப்பவும்."

msgctxt "objects.genai.enabled_in_config.label"
msgid "Original GenAI state"
msgstr "அசல் GenAI நிலை"

msgctxt "objects.genai.enabled_in_config.description"
msgid "Indicates whether GenAI was enabled in the original static config."
msgstr "அசல் நிலையான கட்டமைப்பில் GenAI இயக்கப்பட்டதா என்பதைக் குறிக்கிறது."

msgctxt "record.label"
msgid "Recording"
msgstr "பதிவு செய்தல்"

msgctxt "record.description"
msgid "Recording and retention settings for this camera."
msgstr "இந்த கேமராவிற்கான பதிவு மற்றும் தக்கவைப்பு அமைப்புகள்."

msgctxt "record.enabled.label"
msgid "Enable recording"
msgstr "பதிவை இயக்கு"

msgctxt "record.enabled.description"
msgid "Enable or disable recording for this camera."
msgstr "இந்த கேமராவிற்கான பதிவை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "record.expire_interval.label"
msgid "Record cleanup interval"
msgstr "பதிவு தூய்மை இடைவெளி"

msgctxt "record.expire_interval.description"
msgid "Minutes between cleanup passes that remove expired recording segments."
msgstr ""
"காலாவதியான ரெக்கார்டிங் பிரிவுகளை அகற்றும் க்ளீனப் பாச்களுக்கு இடையே உள்ள "
"நிமிடங்கள்."

msgctxt "record.continuous.label"
msgid "Continuous retention"
msgstr "தொடர்ந்து வைத்திருத்தல்"

msgctxt "record.continuous.description"
msgid ""
"Number of days to retain recordings regardless of tracked objects or motion."
" Set to 0 if you only want to retain recordings of alerts and detections."
msgstr ""
"கண்காணிக்கப்பட்ட பொருள்கள் அல்லது இயக்கத்தைப் பொருட்படுத்தாமல் பதிவுகளைத் "
"தக்கவைப்பதற்கான நாட்களின் எண்ணிக்கை. விழிப்பூட்டல்கள் மற்றும் கண்டறிதல்களின்"
" பதிவுகளை மட்டுமே நீங்கள் தக்கவைக்க விரும்பினால் 0 என அமைக்கவும்."

msgctxt "record.continuous.days.label"
msgid "Retention days"
msgstr "தக்கவைக்கும் நாட்கள்"

msgctxt "record.continuous.days.description"
msgid "Days to retain recordings."
msgstr "பதிவுகளைத் தக்கவைக்க நாட்கள்."

msgctxt "record.motion.label"
msgid "Motion retention"
msgstr "இயக்கம் தக்கவைத்தல்"

msgctxt "record.motion.description"
msgid ""
"Number of days to retain recordings triggered by motion regardless of "
"tracked objects. Set to 0 if you only want to retain recordings of alerts "
"and detections."
msgstr ""
"கண்காணிக்கப்பட்ட பொருட்களைப் பொருட்படுத்தாமல் இயக்கத்தால் தூண்டப்பட்ட "
"பதிவுகளைத் தக்கவைத்துக்கொள்வதற்கான நாட்களின் எண்ணிக்கை. விழிப்பூட்டல்கள் "
"மற்றும் கண்டறிதல்களின் பதிவுகளை மட்டுமே நீங்கள் தக்கவைக்க விரும்பினால் 0 என "
"அமைக்கவும்."

msgctxt "record.motion.days.label"
msgid "Retention days"
msgstr "தக்கவைக்கும் நாட்கள்"

msgctxt "record.motion.days.description"
msgid "Days to retain recordings."
msgstr "பதிவுகளைத் தக்கவைக்க நாட்கள்."

msgctxt "record.detections.label"
msgid "Detection retention"
msgstr "கண்டறிதல் தக்கவைத்தல்"

msgctxt "record.detections.description"
msgid ""
"Recording retention settings for detection events including pre/post capture"
" durations."
msgstr ""
"முன்/பிந்தைய பிடிப்பு காலங்கள் உட்பட கண்டறிதல் நிகழ்வுகளுக்கான தக்கவைப்பு "
"அமைப்புகளைப் பதிவுசெய்தல்."

msgctxt "record.detections.pre_capture.label"
msgid "Pre-capture seconds"
msgstr "முன்-பிடிப்பு வினாடிகள்"

msgctxt "record.detections.pre_capture.description"
msgid ""
"Number of seconds before the detection event to include in the recording."
msgstr ""
"கண்டறிதல் நிகழ்வுக்கு முன் பதிவில் சேர்க்க வேண்டிய வினாடிகளின் எண்ணிக்கை."

msgctxt "record.detections.post_capture.label"
msgid "Post-capture seconds"
msgstr "பிந்தைய பிடிப்பு வினாடிகள்"

msgctxt "record.detections.post_capture.description"
msgid ""
"Number of seconds after the detection event to include in the recording."
msgstr ""
"கண்டறிதல் நிகழ்வுக்குப் பிறகு பதிவில் சேர்க்க வேண்டிய வினாடிகளின் எண்ணிக்கை."

msgctxt "record.detections.retain.label"
msgid "Event retention"
msgstr "நிகழ்வு தக்கவைப்பு"

msgctxt "record.detections.retain.description"
msgid "Retention settings for recordings of detection events."
msgstr "கண்டறிதல் நிகழ்வுகளின் பதிவுகளுக்கான தக்கவைப்பு அமைப்புகள்."

msgctxt "record.detections.retain.days.label"
msgid "Retention days"
msgstr "தக்கவைக்கும் நாட்கள்"

msgctxt "record.detections.retain.days.description"
msgid "Number of days to retain recordings of detection events."
msgstr ""
"கண்டறிதல் நிகழ்வுகளின் பதிவுகளைத் தக்கவைக்க வேண்டிய நாட்களின் எண்ணிக்கை."

msgctxt "record.detections.retain.mode.label"
msgid "Retention mode"
msgstr "தக்கவைப்பு முறை"

msgctxt "record.detections.retain.mode.description"
msgid ""
"Mode for retention: all (save all segments), motion (save segments with "
"motion), or active_objects (save segments with active objects)."
msgstr ""
"தக்கவைப்பதற்கான பயன்முறை: அனைத்தும் (அனைத்து பிரிவுகளையும் சேமி), இயக்கம் "
"(இயக்கத்துடன் பிரிவுகளைச் சேமி), அல்லது ஆக்டிவ்_ஆப்செக்ட்கள் (செயலில் உள்ள "
"பொருள்களுடன் பிரிவுகளைச் சேமிக்கவும்)."

msgctxt "record.alerts.label"
msgid "Alert retention"
msgstr "முன்னறிவிப்பு வைத்திருத்தல்"

msgctxt "record.alerts.description"
msgid ""
"Recording retention settings for alert events including pre/post capture "
"durations."
msgstr ""
"முன்/பிந்தைய பிடிப்பு காலங்கள் உட்பட முன்னறிவிப்பு நிகழ்வுகளுக்கான பதிவுத் "
"தக்கவைப்பு அமைப்புகள்."

msgctxt "record.alerts.pre_capture.label"
msgid "Pre-capture seconds"
msgstr "முன்-பிடிப்பு வினாடிகள்"

msgctxt "record.alerts.pre_capture.description"
msgid ""
"Number of seconds before the detection event to include in the recording."
msgstr ""
"கண்டறிதல் நிகழ்வுக்கு முன் பதிவில் சேர்க்க வேண்டிய வினாடிகளின் எண்ணிக்கை."

msgctxt "record.alerts.post_capture.label"
msgid "Post-capture seconds"
msgstr "பிந்தைய பிடிப்பு வினாடிகள்"

msgctxt "record.alerts.post_capture.description"
msgid ""
"Number of seconds after the detection event to include in the recording."
msgstr ""
"கண்டறிதல் நிகழ்வுக்குப் பிறகு பதிவில் சேர்க்க வேண்டிய வினாடிகளின் எண்ணிக்கை."

msgctxt "record.alerts.retain.label"
msgid "Event retention"
msgstr "நிகழ்வு தக்கவைப்பு"

msgctxt "record.alerts.retain.description"
msgid "Retention settings for recordings of detection events."
msgstr "கண்டறிதல் நிகழ்வுகளின் பதிவுகளுக்கான தக்கவைப்பு அமைப்புகள்."

msgctxt "record.alerts.retain.days.label"
msgid "Retention days"
msgstr "தக்கவைக்கும் நாட்கள்"

msgctxt "record.alerts.retain.days.description"
msgid "Number of days to retain recordings of detection events."
msgstr ""
"கண்டறிதல் நிகழ்வுகளின் பதிவுகளைத் தக்கவைக்க வேண்டிய நாட்களின் எண்ணிக்கை."

msgctxt "record.alerts.retain.mode.label"
msgid "Retention mode"
msgstr "தக்கவைப்பு முறை"

msgctxt "record.alerts.retain.mode.description"
msgid ""
"Mode for retention: all (save all segments), motion (save segments with "
"motion), or active_objects (save segments with active objects)."
msgstr ""
"தக்கவைப்பதற்கான பயன்முறை: அனைத்தும் (அனைத்து பிரிவுகளையும் சேமி), இயக்கம் "
"(இயக்கத்துடன் பிரிவுகளைச் சேமி), அல்லது ஆக்டிவ்_ஆப்செக்ட்கள் (செயலில் உள்ள "
"பொருள்களுடன் பிரிவுகளைச் சேமிக்கவும்)."

msgctxt "record.export.label"
msgid "Export config"
msgstr "ஏற்றுமதி கட்டமைப்பு"

msgctxt "record.export.description"
msgid ""
"Settings used when exporting recordings such as timelapse and hardware "
"acceleration."
msgstr ""
"டைம்லாப்ச் மற்றும் வன்பொருள் முடுக்கம் போன்ற பதிவுகளை ஏற்றுமதி செய்யும் போது"
" பயன்படுத்தப்படும் அமைப்புகள்."

msgctxt "record.export.hwaccel_args.label"
msgid "Export hwaccel args"
msgstr "hwaccel args ஐ ஏற்றுமதி செய்யவும்"

msgctxt "record.export.hwaccel_args.description"
msgid "Hardware acceleration args to use for export/transcode operations."
msgstr ""
"வன்பொருள் முடுக்கம் ஏற்றுமதி/டிரான்ச்கோட் செயல்பாடுகளுக்குப் "
"பயன்படுத்தப்படுகிறது."

msgctxt "record.export.max_concurrent.label"
msgid "Maximum concurrent exports"
msgstr "அதிகபட்ச ஒரே நேரத்தில் ஏற்றுமதி"

msgctxt "record.export.max_concurrent.description"
msgid "Maximum number of export jobs to process at the same time."
msgstr "ஒரே நேரத்தில் செயல்படுத்த வேண்டிய அதிகபட்ச ஏற்றுமதி வேலைகள்."

msgctxt "record.export.chapters.label"
msgid "Chapter metadata to embed in exported recordings"
msgstr ""
"ஏற்றுமதி செய்யப்பட்ட பதிவுகளில் உட்பொதிக்க வேண்டிய அத்தியாய மேனிலை தரவு"

msgctxt "record.preview.label"
msgid "Preview config"
msgstr "முன்னோட்ட கட்டமைப்பு"

msgctxt "record.preview.description"
msgid ""
"Settings controlling the quality of recording previews shown in the UI."
msgstr ""
"இடைமுகம் இல் காட்டப்படும் ரெக்கார்டிங் மாதிரிக்காட்சிகளின் தரத்தைக் "
"கட்டுப்படுத்தும் அமைப்புகள்."

msgctxt "record.preview.quality.label"
msgid "Preview quality"
msgstr "முன்னோட்ட தகுதி"

msgctxt "record.preview.quality.description"
msgid "Preview quality level (very_low, low, medium, high, very_high)."
msgstr ""
"தரநிலையை முன்னோட்டமிடவும் (மிகக் குறைந்த, குறைந்த, நடுத்தர, உயர், மிக_உயர்)."

msgctxt "record.enabled_in_config.label"
msgid "Original recording state"
msgstr "அசல் பதிவு நிலை"

msgctxt "record.enabled_in_config.description"
msgid ""
"Indicates whether recording was enabled in the original static "
"configuration."
msgstr "அசல் நிலையான உள்ளமைவில் பதிவு இயக்கப்பட்டதா என்பதைக் குறிக்கிறது."

msgctxt "review.label"
msgid "Review"
msgstr "சீராய்வு"

msgctxt "review.description"
msgid ""
"Settings that control alerts, detections, and GenAI review summaries used by"
" the UI and storage for this camera."
msgstr ""
"இந்த கேமராவிற்கான இடைமுகம் மற்றும் சேமிப்பகத்தால் பயன்படுத்தப்படும் "
"விழிப்பூட்டல்கள், கண்டறிதல்கள் மற்றும் GenAI மதிப்பாய்வு சுருக்கங்கள் "
"ஆகியவற்றைக் கட்டுப்படுத்தும் அமைப்புகள்."

msgctxt "review.alerts.label"
msgid "Alerts config"
msgstr "முன்னறிவிப்பு கட்டமைப்பு"

msgctxt "review.alerts.description"
msgid ""
"Settings for which tracked objects generate alerts and how alerts are "
"retained."
msgstr ""
"கண்காணிக்கப்பட்ட பொருள்கள் விழிப்பூட்டல்களை உருவாக்கும் மற்றும் "
"விழிப்பூட்டல்கள் எவ்வாறு தக்கவைக்கப்படுகின்றன என்பதற்கான அமைப்புகள்."

msgctxt "review.alerts.enabled.label"
msgid "Enable alerts"
msgstr "விழிப்பூட்டல்களை இயக்கு"

msgctxt "review.alerts.enabled.description"
msgid "Enable or disable alert generation for this camera."
msgstr ""
"இந்த கேமராவிற்கான முன்னறிவிப்பு உருவாக்கத்தை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "review.alerts.labels.label"
msgid "Alert labels"
msgstr "முன்னறிவிப்பு லேபிள்கள்"

msgctxt "review.alerts.labels.description"
msgid ""
"List of object labels that qualify as alerts (for example: car, person)."
msgstr ""
"விழிப்பூட்டல்களாகத் தகுதிபெறும் பொருள் லேபிள்களின் பட்டியல் "
"(எடுத்துக்காட்டாக: கார், நபர்)."

msgctxt "review.alerts.required_zones.label"
msgid "Required zones"
msgstr "தேவையான மண்டலங்கள்"

msgctxt "review.alerts.required_zones.description"
msgid ""
"Zones that an object must enter to be considered an alert; leave empty to "
"allow any zone."
msgstr ""
"ஒரு பொருள் எச்சரிக்கையாகக் கருதப்பட வேண்டிய மண்டலங்கள்; எந்த மண்டலத்தையும் "
"அனுமதிக்க காலியாக விடவும்."

msgctxt "review.alerts.enabled_in_config.label"
msgid "Original alerts state"
msgstr "அசல் விழிப்பூட்டல்கள் நிலை"

msgctxt "review.alerts.enabled_in_config.description"
msgid ""
"Tracks whether alerts were originally enabled in the static configuration."
msgstr ""
"நிலையான உள்ளமைவில் விழிப்பூட்டல்கள் முதலில் இயக்கப்பட்டதா என்பதைக் "
"கண்காணிக்கும்."

msgctxt "review.alerts.cutoff_time.label"
msgid "Alerts cutoff time"
msgstr "முன்னறிவிப்பு வெட்டு நேரம்"

msgctxt "review.alerts.cutoff_time.description"
msgid ""
"Seconds to wait after no alert-causing activity before cutting off an alert."
msgstr ""
"விழிப்பூட்டலைத் துண்டிக்கும் முன், எந்த விழிப்பூட்டல் செயல்பாட்டிற்குப் "
"பிறகும் காத்திருக்க வேண்டிய வினாடிகள்."

msgctxt "review.detections.label"
msgid "Detections config"
msgstr "கண்டறிதல் கட்டமைப்பு"

msgctxt "review.detections.description"
msgid ""
"Settings for which tracked objects generate detections (non-alert) and how "
"detections are retained."
msgstr ""
"கண்காணிக்கப்பட்ட பொருள்கள் கண்டறிதல்களை உருவாக்கும் (எச்சரிக்கையற்றவை) "
"மற்றும் கண்டறிதல்கள் எவ்வாறு தக்கவைக்கப்படுகின்றன என்பதற்கான அமைப்புகள்."

msgctxt "review.detections.enabled.label"
msgid "Enable detections"
msgstr "கண்டறிதலை இயக்கு"

msgctxt "review.detections.enabled.description"
msgid "Enable or disable detection events for this camera."
msgstr "இந்தக் கேமராவில் கண்டறிதல் நிகழ்வுகளை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "review.detections.labels.label"
msgid "Detection labels"
msgstr "கண்டறிதல் லேபிள்கள்"

msgctxt "review.detections.labels.description"
msgid "List of object labels that qualify as detection events."
msgstr "கண்டறிதல் நிகழ்வுகளாகத் தகுதிபெறும் பொருள் லேபிள்களின் பட்டியல்."

msgctxt "review.detections.required_zones.label"
msgid "Required zones"
msgstr "தேவையான மண்டலங்கள்"

msgctxt "review.detections.required_zones.description"
msgid ""
"Zones that an object must enter to be considered a detection; leave empty to"
" allow any zone."
msgstr ""
"கண்டறிதலாகக் கருதப்படும் ஒரு பொருள் உள்ளிட வேண்டிய மண்டலங்கள்; எந்த "
"மண்டலத்தையும் அனுமதிக்க காலியாக விடவும்."

msgctxt "review.detections.cutoff_time.label"
msgid "Detections cutoff time"
msgstr "கண்டறிதல் வெட்டு நேரம்"

msgctxt "review.detections.cutoff_time.description"
msgid ""
"Seconds to wait after no detection-causing activity before cutting off a "
"detection."
msgstr ""
"கண்டறிதலைத் துண்டிக்கும் முன், கண்டறிதல்-விளைவிக்காத செயல்பாட்டிற்குப் பிறகு"
" காத்திருக்க வேண்டிய வினாடிகள்."

msgctxt "review.detections.enabled_in_config.label"
msgid "Original detections state"
msgstr "அசல் கண்டறிதல் நிலை"

msgctxt "review.detections.enabled_in_config.description"
msgid ""
"Tracks whether detections were originally enabled in the static "
"configuration."
msgstr ""
"நிலையான உள்ளமைவில் கண்டறிதல்கள் முதலில் இயக்கப்பட்டதா என்பதைக் "
"கண்காணிக்கும்."

msgctxt "review.genai.label"
msgid "GenAI config"
msgstr "GenAI கட்டமைப்பு"

msgctxt "review.genai.description"
msgid ""
"Controls use of generative AI for producing descriptions and summaries of "
"review items."
msgstr ""
"மறுஆய்வு உருப்படிகளின் விளக்கங்கள் மற்றும் சுருக்கங்களை உருவாக்குவதற்கு "
"உருவாக்கக்கூடிய AI இன் பயன்பாட்டைக் கட்டுப்படுத்துகிறது."

msgctxt "review.genai.enabled.label"
msgid "Enable GenAI descriptions"
msgstr "GenAI விளக்கங்களை இயக்கு"

msgctxt "review.genai.enabled.description"
msgid ""
"Enable or disable GenAI-generated descriptions and summaries for review "
"items."
msgstr ""
"மதிப்பாய்வு உருப்படிகளுக்கான GenAI-உருவாக்கிய விளக்கங்கள் மற்றும் "
"சுருக்கங்களை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "review.genai.alerts.label"
msgid "Enable GenAI for alerts"
msgstr "விழிப்பூட்டல்களுக்கு GenAIஐ இயக்கவும்"

msgctxt "review.genai.alerts.description"
msgid "Use GenAI to generate descriptions for alert items."
msgstr ""
"முன்னறிவிப்பு உருப்படிகளுக்கான விளக்கங்களை உருவாக்க GenAI ஐப் "
"பயன்படுத்தவும்."

msgctxt "review.genai.detections.label"
msgid "Enable GenAI for detections"
msgstr "கண்டறிவதற்கு கென் AI ஐ இயக்கவும்"

msgctxt "review.genai.detections.description"
msgid "Use GenAI to generate descriptions for detection items."
msgstr ""
"கண்டறிதல் உருப்படிகளுக்கான விளக்கங்களை உருவாக்க GenAI ஐப் பயன்படுத்தவும்."

msgctxt "review.genai.image_source.label"
msgid "Review image source"
msgstr "படத்தின் மூலத்தை மதிப்பாய்வு செய்யவும்"

msgctxt "review.genai.image_source.description"
msgid ""
"Source of images sent to GenAI ('preview' or 'recordings'); 'recordings' "
"uses higher quality frames but more tokens."
msgstr ""
"GenAI க்கு அனுப்பப்பட்ட படங்களின் சான்று ('முன்னோட்டம்' அல்லது 'பதிவுகள்'); "
"'பதிவுகள்' உயர்தர பிரேம்களைப் பயன்படுத்துகின்றன, ஆனால் அதிக டோக்கன்களைப் "
"பயன்படுத்துகின்றன."

msgctxt "review.genai.additional_concerns.label"
msgid "Additional concerns"
msgstr "கூடுதல் கவலைகள்"

msgctxt "review.genai.additional_concerns.description"
msgid ""
"A list of additional concerns or notes the GenAI should consider when "
"evaluating activity on this camera."
msgstr ""
"இந்த கேமராவின் செயல்பாட்டை மதிப்பிடும்போது GenAI கருத்தில் கொள்ள வேண்டிய "
"கூடுதல் கவலைகள் அல்லது குறிப்புகளின் பட்டியல்."

msgctxt "review.genai.debug_save_thumbnails.label"
msgid "Save thumbnails"
msgstr "சிறுபடங்களைச் சேமிக்கவும்"

msgctxt "review.genai.debug_save_thumbnails.description"
msgid ""
"Save thumbnails that are sent to the GenAI provider for debugging and "
"review."
msgstr ""
"பிழைத்திருத்தம் மற்றும் மதிப்பாய்வுக்காக GenAI வழங்குநருக்கு அனுப்பப்படும் "
"சிறுபடங்களைச் சேமிக்கவும்."

msgctxt "review.genai.enabled_in_config.label"
msgid "Original GenAI state"
msgstr "அசல் GenAI நிலை"

msgctxt "review.genai.enabled_in_config.description"
msgid ""
"Tracks whether GenAI review was originally enabled in the static "
"configuration."
msgstr ""
"GenAI மதிப்பாய்வு முதலில் நிலையான உள்ளமைவில் செயல்படுத்தப்பட்டதா என்பதைக் "
"கண்காணிக்கும்."

msgctxt "review.genai.preferred_language.label"
msgid "Preferred language"
msgstr "விருப்பமான மொழி"

msgctxt "review.genai.preferred_language.description"
msgid ""
"Preferred language to request from the GenAI provider for generated "
"responses."
msgstr ""
"உருவாக்கப்பட்ட பதில்களுக்கு GenAI வழங்குநரிடமிருந்து கோருவதற்கு விருப்பமான "
"மொழி."

msgctxt "review.genai.activity_context_prompt.label"
msgid "Activity context prompt"
msgstr "செயல்பாட்டு சூழல் ப்ராம்ட்"

msgctxt "review.genai.activity_context_prompt.description"
msgid ""
"Custom prompt describing what is and is not suspicious activity to provide "
"context for GenAI summaries."
msgstr ""
"GenAI சுருக்கங்களுக்கான சூழலை வழங்க, சந்தேகத்திற்கிடமான செயல்பாடு எது "
"மற்றும் இல்லை என்பதை விவரிக்கும் தனிப்பயன் வரியில்."

msgctxt "semantic_search.label"
msgid "Semantic Search"
msgstr "சொற்பொருள் தேடல்"

msgctxt "semantic_search.description"
msgid ""
"Settings for semantic search which builds and queries object embeddings to "
"find similar items."
msgstr ""
"ஒத்த உருப்படிகளைக் கண்டறிய பொருள் உட்பொதிவுகளை உருவாக்கி வினவுகின்ற "
"சொற்பொருள் தேடலுக்கான அமைப்புகள்."

msgctxt "semantic_search.triggers.label"
msgid "Triggers"
msgstr "தூண்டுதல்கள்"

msgctxt "semantic_search.triggers.description"
msgid ""
"Actions and matching criteria for camera-specific semantic search triggers."
msgstr ""
"கேமரா சார்ந்த சொற்பொருள் தேடல் தூண்டுதல்களுக்கான செயல்கள் மற்றும் "
"பொருந்தக்கூடிய அளவுகோல்கள்."

msgctxt "semantic_search.triggers.friendly_name.label"
msgid "Friendly name"
msgstr "நட்புப் பெயர்"

msgctxt "semantic_search.triggers.friendly_name.description"
msgid "Optional friendly name displayed in the UI for this trigger."
msgstr "இந்த தூண்டுதலுக்கான விருப்பமான நட்பு பெயர் இடைமுகம் இல் காட்டப்படும்."

msgctxt "semantic_search.triggers.enabled.label"
msgid "Enable this trigger"
msgstr "இந்த தூண்டுதலை இயக்கவும்"

msgctxt "semantic_search.triggers.enabled.description"
msgid "Enable or disable this semantic search trigger."
msgstr "இந்த சொற்பொருள் தேடல் தூண்டுதலை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "semantic_search.triggers.type.label"
msgid "Trigger type"
msgstr "தூண்டுதல் வகை"

msgctxt "semantic_search.triggers.type.description"
msgid ""
"Type of trigger: 'thumbnail' (match against image) or 'description' (match "
"against text)."
msgstr ""
"தூண்டுதலின் வகை: 'சிறுபடம்' (படத்திற்கு எதிரான பொருத்தம்) அல்லது 'விளக்கம்' "
"(உரைக்கு எதிரான பொருத்தம்)."

msgctxt "semantic_search.triggers.data.label"
msgid "Trigger content"
msgstr "உள்ளடக்கத்தைத் தூண்டு"

msgctxt "semantic_search.triggers.data.description"
msgid "Text phrase or thumbnail ID to match against tracked objects."
msgstr ""
"டிராக் செய்யப்பட்ட பொருட்களுடன் பொருந்தக்கூடிய உரை சொற்றொடர் அல்லது சிறுபட "
"அடையாளம்."

msgctxt "semantic_search.triggers.threshold.label"
msgid "Trigger threshold"
msgstr "தூண்டுதல் வாசல்"

msgctxt "semantic_search.triggers.threshold.description"
msgid "Minimum similarity score (0-1) required to activate this trigger."
msgstr "இந்த தூண்டுதலை செயல்படுத்த குறைந்தபட்ச ஒற்றுமை மதிப்பெண் (0-1) தேவை."

msgctxt "semantic_search.triggers.actions.label"
msgid "Trigger actions"
msgstr "தூண்டுதல் செயல்கள்"

msgctxt "semantic_search.triggers.actions.description"
msgid ""
"List of actions to execute when trigger matches (notification, sub_label, "
"attribute)."
msgstr ""
"தூண்டுதல் பொருத்தங்களின் போது செயல்படுத்த வேண்டிய செயல்களின் பட்டியல் "
"(அறிவிப்பு, துணை_லேபிள், பண்புக்கூறு)."

msgctxt "snapshots.label"
msgid "Snapshots"
msgstr "ச்னாப்சாட்கள்"

msgctxt "snapshots.description"
msgid ""
"Settings for API-generated snapshots of tracked objects for this camera."
msgstr ""
"இந்த கேமராவிற்கான டிராக் செய்யப்பட்ட பொருட்களின் API-உருவாக்கிய "
"ச்னாப்சாட்களுக்கான அமைப்புகள்."

msgctxt "snapshots.enabled.label"
msgid "Enable snapshots"
msgstr "ச்னாப்சாட்களை இயக்கு"

msgctxt "snapshots.enabled.description"
msgid "Enable or disable saving snapshots for this camera."
msgstr ""
"இந்தக் கேமராவிற்கான ச்னாப்சாட்களைச் சேமிப்பதை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "snapshots.timestamp.label"
msgid "Timestamp overlay"
msgstr "நேர முத்திரை மேலடுக்கு"

msgctxt "snapshots.timestamp.description"
msgid "Overlay a timestamp on snapshots from API."
msgstr "பநிஇ இலிருந்து ச்னாப்சாட்களில் நேர முத்திரையை மேலடுக்கு."

msgctxt "snapshots.bounding_box.label"
msgid "Bounding box overlay"
msgstr "எல்லைப் பெட்டி மேலடுக்கு"

msgctxt "snapshots.bounding_box.description"
msgid "Draw bounding boxes for tracked objects on snapshots from API."
msgstr ""
"பநிஇ இலிருந்து ச்னாப்சாட்களில் கண்காணிக்கப்படும் பொருட்களுக்கான எல்லைப் "
"பெட்டிகளை வரையவும்."

msgctxt "snapshots.crop.label"
msgid "Crop snapshot"
msgstr "செதுக்கும் ச்னாப்சாட்"

msgctxt "snapshots.crop.description"
msgid "Crop snapshots from API to the detected object's bounding box."
msgstr ""
"கண்டறியப்பட்ட பொருளின் எல்லைப் பெட்டியில் பநிஇ இலிருந்து ச்னாப்சாட்களை "
"செதுக்குங்கள்."

msgctxt "snapshots.required_zones.label"
msgid "Required zones"
msgstr "தேவையான மண்டலங்கள்"

msgctxt "snapshots.required_zones.description"
msgid "Zones an object must enter for a snapshot to be saved."
msgstr "ச்னாப்சாட்டைச் சேமிக்க ஒரு பொருள் உள்ளிட வேண்டிய மண்டலங்கள்."

msgctxt "snapshots.height.label"
msgid "Snapshot height"
msgstr "ச்னாப்சாட் உயரம்"

msgctxt "snapshots.height.description"
msgid ""
"Height (pixels) to resize snapshots from API to; leave empty to preserve "
"original size."
msgstr ""
"பநிஇ இலிருந்து ச்னாப்சாட்களின் அளவை மாற்ற உயரம் (பிக்சல்கள்); அசல் அளவைப் "
"பாதுகாக்க காலியாக விடவும்."

msgctxt "snapshots.retain.label"
msgid "Snapshot retention"
msgstr "ச்னாப்சாட் வைத்திருத்தல்"

msgctxt "snapshots.retain.description"
msgid ""
"Retention settings for snapshots including default days and per-object "
"overrides."
msgstr ""
"இயல்புநிலை நாட்கள் மற்றும் ஒவ்வொரு பொருளின் மேலெழுதல்கள் உட்பட "
"ச்னாப்சாட்களுக்கான தக்கவைப்பு அமைப்புகள்."

msgctxt "snapshots.retain.default.label"
msgid "Default retention"
msgstr "இயல்புநிலை தக்கவைப்பு"

msgctxt "snapshots.retain.default.description"
msgid "Default number of days to retain snapshots."
msgstr "ச்னாப்சாட்களைத் தக்கவைக்க இயல்புநிலை நாட்களின் எண்ணிக்கை."

msgctxt "snapshots.retain.objects.label"
msgid "Object retention"
msgstr "பொருள் வைத்திருத்தல்"

msgctxt "snapshots.retain.objects.description"
msgid "Per-object overrides for snapshot retention days."
msgstr "ச்னாப்சாட் தக்கவைப்பு நாட்களுக்கு ஒவ்வொரு பொருளுக்கும் மேலெழுகிறது."

msgctxt "snapshots.quality.label"
msgid "Snapshot quality"
msgstr "ச்னாப்சாட் தகுதி"

msgctxt "snapshots.quality.description"
msgid "Encode quality for saved snapshots (0-100)."
msgstr "சேமித்த ச்னாப்சாட்களுக்கான தரத்தை குறியாக்குதல் (0-100)."

msgctxt "timestamp_style.label"
msgid "Timestamp style"
msgstr "நேர முத்திரை பாணி"

msgctxt "timestamp_style.description"
msgid "Styling options for timestamps applied to snapshots and Debug view."
msgstr ""
"நேர முத்திரைகளுக்கான ச்டைலிங் விருப்பங்கள் ச்னாப்சாட்கள் மற்றும் "
"பிழைத்திருத்தக் காட்சிக்கு பயன்படுத்தப்படும்."

msgctxt "timestamp_style.position.label"
msgid "Timestamp position"
msgstr "நேர முத்திரை நிலை"

msgctxt "timestamp_style.position.description"
msgid "Position of the timestamp on the image (tl/tr/bl/br)."
msgstr "படத்தின் நேர முத்திரையின் நிலை (tl/tr/bl/br)."

msgctxt "timestamp_style.format.label"
msgid "Timestamp format"
msgstr "நேர முத்திரை வடிவம்"

msgctxt "timestamp_style.format.description"
msgid ""
"Datetime format string used for timestamps (Python datetime format codes)."
msgstr ""
"நேர முத்திரைகளுக்கு பயன்படுத்தப்படும் தேதிநேர வடிவமைப்பு சரம் (பைதான் "
"தேதிநேர வடிவமைப்பு குறியீடுகள்)."

msgctxt "timestamp_style.color.label"
msgid "Timestamp color"
msgstr "நேர முத்திரை நிறம்"

msgctxt "timestamp_style.color.description"
msgid "RGB color values for the timestamp text (all values 0-255)."
msgstr ""
"நேர முத்திரை உரைக்கான RGB வண்ண மதிப்புகள் (அனைத்து மதிப்புகளும் 0-255)."

msgctxt "timestamp_style.color.red.label"
msgid "Red"
msgstr "சிவப்பு"

msgctxt "timestamp_style.color.red.description"
msgid "Red component (0-255) for timestamp color."
msgstr "நேர முத்திரை நிறத்திற்கான சிவப்பு கூறு (0-255)."

msgctxt "timestamp_style.color.green.label"
msgid "Green"
msgstr "பச்சை"

msgctxt "timestamp_style.color.green.description"
msgid "Green component (0-255) for timestamp color."
msgstr "நேர முத்திரை நிறத்திற்கான பச்சை கூறு (0-255)."

msgctxt "timestamp_style.color.blue.label"
msgid "Blue"
msgstr "நீலம்"

msgctxt "timestamp_style.color.blue.description"
msgid "Blue component (0-255) for timestamp color."
msgstr "நேர முத்திரை நிறத்திற்கான நீல கூறு (0-255)."

msgctxt "timestamp_style.thickness.label"
msgid "Timestamp thickness"
msgstr "நேர முத்திரை தடிமன்"

msgctxt "timestamp_style.thickness.description"
msgid "Line thickness of the timestamp text."
msgstr "நேர முத்திரை உரையின் வரி தடிமன்."

msgctxt "timestamp_style.effect.label"
msgid "Timestamp effect"
msgstr "நேர முத்திரை விளைவு"

msgctxt "timestamp_style.effect.description"
msgid "Visual effect for the timestamp text (none, solid, shadow)."
msgstr "நேரமுத்திரை உரைக்கான காட்சி விளைவு (எதுவும் இல்லை, திடமான, நிழல்)."

msgctxt "best_image_timeout.label"
msgid "Best image timeout"
msgstr "சிறந்த பட நேரம் முடிந்தது"

msgctxt "best_image_timeout.description"
msgid "How long to wait for the image with the highest confidence score."
msgstr ""
"அதிக நம்பிக்கை மதிப்பெண் கொண்ட படத்திற்காக எவ்வளவு நேரம் காத்திருக்க "
"வேண்டும்."

msgctxt "mqtt.label"
msgid "MQTT"
msgstr "MQTT"

msgctxt "mqtt.description"
msgid "MQTT image publishing settings."
msgstr "MQTT பட வெளியீட்டு அமைப்புகள்."

msgctxt "mqtt.enabled.label"
msgid "Send image"
msgstr "படத்தை அனுப்பு"

msgctxt "mqtt.enabled.description"
msgid ""
"Enable publishing image snapshots for objects to MQTT topics for this "
"camera."
msgstr ""
"இந்த கேமராவிற்கான MQTT தலைப்புகளில் பொருள்களுக்கான பட ச்னாப்சாட்களை "
"வெளியிடுவதை இயக்கவும்."

msgctxt "mqtt.timestamp.label"
msgid "Add timestamp"
msgstr "நேர முத்திரையைச் சேர்க்கவும்"

msgctxt "mqtt.timestamp.description"
msgid "Overlay a timestamp on images published to MQTT."
msgstr "MQTT இல் வெளியிடப்பட்ட படங்களில் நேர முத்திரையை மேலடுக்கு."

msgctxt "mqtt.bounding_box.label"
msgid "Add bounding box"
msgstr "எல்லைப் பெட்டியைச் சேர்க்கவும்"

msgctxt "mqtt.bounding_box.description"
msgid "Draw bounding boxes on images published over MQTT."
msgstr "MQTT இல் வெளியிடப்பட்ட படங்களில் எல்லைப் பெட்டிகளை வரையவும்."

msgctxt "mqtt.crop.label"
msgid "Crop image"
msgstr "படத்தை செதுக்கு"

msgctxt "mqtt.crop.description"
msgid "Crop images published to MQTT to the detected object's bounding box."
msgstr ""
"MQTT க்கு வெளியிடப்பட்ட படங்கள் கண்டறியப்பட்ட பொருளின் எல்லைப் பெட்டியில் "
"செதுக்கப்படும்."

msgctxt "mqtt.height.label"
msgid "Image height"
msgstr "படத்தின் உயரம்"

msgctxt "mqtt.height.description"
msgid "Height (pixels) to resize images published over MQTT."
msgstr "MQTT மூலம் வெளியிடப்பட்ட படங்களின் அளவை மாற்ற உயரம் (பிக்சல்கள்)."

msgctxt "mqtt.required_zones.label"
msgid "Required zones"
msgstr "தேவையான மண்டலங்கள்"

msgctxt "mqtt.required_zones.description"
msgid "Zones that an object must enter for an MQTT image to be published."
msgstr "MQTT படத்தை வெளியிட ஒரு பொருள் உள்ளிட வேண்டிய மண்டலங்கள்."

msgctxt "mqtt.quality.label"
msgid "JPEG quality"
msgstr "JPEG தகுதி"

msgctxt "mqtt.quality.description"
msgid "JPEG quality for images published to MQTT (0-100)."
msgstr "MQTT (0-100) இல் வெளியிடப்பட்ட படங்களுக்கான JPEG தகுதி."

msgctxt "notifications.label"
msgid "Notifications"
msgstr "அறிவிப்புகள்"

msgctxt "notifications.description"
msgid "Settings to enable and control notifications for this camera."
msgstr ""
"இந்த கேமராவிற்கான அறிவிப்புகளை இயக்க மற்றும் கட்டுப்படுத்துவதற்கான "
"அமைப்புகள்."

msgctxt "notifications.enabled.label"
msgid "Enable notifications"
msgstr "அறிவிப்புகளை இயக்கு"

msgctxt "notifications.enabled.description"
msgid "Enable or disable notifications for this camera."
msgstr "இந்த கேமராவிற்கான அறிவிப்புகளை இயக்கவும் அல்லது முடக்கவும்."

msgctxt "notifications.email.label"
msgid "Notification email"
msgstr "அறிவிப்பு மின்னஞ்சல்"

msgctxt "notifications.email.description"
msgid ""
"Email address used for push notifications or required by certain "
"notification providers."
msgstr ""
"புச் அறிவிப்புகளுக்குப் பயன்படுத்தப்படும் மின்னஞ்சல் முகவரி அல்லது சில "
"அறிவிப்பு வழங்குநர்கள் தேவை."

msgctxt "notifications.cooldown.label"
msgid "Cooldown period"
msgstr "கூல்டவுன் காலம்"

msgctxt "notifications.cooldown.description"
msgid "Cooldown (seconds) between notifications to avoid spamming recipients."
msgstr ""
"ச்பேமிங் பெறுநர்களைத் தவிர்க்க, அறிவிப்புகளுக்கு இடையே கூல்டவுன் "
"(வினாடிகள்)."

msgctxt "notifications.enabled_in_config.label"
msgid "Original notifications state"
msgstr "அசல் அறிவிப்புகள் நிலை"

msgctxt "notifications.enabled_in_config.description"
msgid ""
"Indicates whether notifications were enabled in the original static "
"configuration."
msgstr ""
"அசல் நிலையான உள்ளமைவில் அறிவிப்புகள் இயக்கப்பட்டதா என்பதைக் குறிக்கிறது."

msgctxt "onvif.label"
msgid "ONVIF"
msgstr "ONVIF"

msgctxt "onvif.description"
msgid "ONVIF connection and PTZ autotracking settings for this camera."
msgstr ""
"இந்தக் கேமராவிற்கான ONVIF இணைப்பு மற்றும் PTZ ஆட்டோட்ராக்கிங் அமைப்புகள்."

msgctxt "onvif.host.label"
msgid "ONVIF host"
msgstr "ONVIF புரவலன்"

msgctxt "onvif.host.description"
msgid "Host (and optional scheme) for the ONVIF service for this camera."
msgstr ""
"இந்தக் கேமராவிற்கான ONVIF சேவைக்கான புரவலன் (மற்றும் விருப்பத் திட்டம்)."

msgctxt "onvif.port.label"
msgid "ONVIF port"
msgstr "ONVIF துறைமுகம்"

msgctxt "onvif.port.description"
msgid "Port number for the ONVIF service."
msgstr "ONVIF சேவைக்கான துறைமுகம் எண்."

msgctxt "onvif.user.label"
msgid "ONVIF username"
msgstr "ONVIF பயனர்பெயர்"

msgctxt "onvif.user.description"
msgid ""
"Username for ONVIF authentication; some devices require admin user for "
"ONVIF."
msgstr ""
"ONVIF அங்கீகாரத்திற்கான பயனர்பெயர்; சில சாதனங்களுக்கு ONVIFக்கு நிர்வாகி "
"பயனர் தேவை."

msgctxt "onvif.password.label"
msgid "ONVIF password"
msgstr "ONVIF கடவுச்சொல்"

msgctxt "onvif.password.description"
msgid "Password for ONVIF authentication."
msgstr "ONVIF அங்கீகாரத்திற்கான கடவுச்சொல்."

msgctxt "onvif.tls_insecure.label"
msgid "Disable TLS verify"
msgstr "TLS சரிபார்ப்பை முடக்கு"

msgctxt "onvif.tls_insecure.description"
msgid ""
"Skip TLS verification and disable digest auth for ONVIF (unsafe; use in safe"
" networks only)."
msgstr ""
"TLS சரிபார்ப்பைத் தவிர்த்து, ONVIFக்கான டைசச்ட் அங்கீகாரத்தை முடக்கவும் "
"(பாதுகாப்பானது; பாதுகாப்பான நெட்வொர்க்குகளில் மட்டும் பயன்படுத்தவும்)."

msgctxt "onvif.profile.label"
msgid "ONVIF profile"
msgstr "ONVIF சுயவிவரம்"

msgctxt "onvif.profile.description"
msgid ""
"Specific ONVIF media profile to use for PTZ control, matched by token or "
"name. If not set, the first profile with valid PTZ configuration is selected"
" automatically."
msgstr ""
"கிள்ளாக்கு அல்லது பெயரால் பொருத்தப்பட்ட PTZ கட்டுப்பாட்டிற்குப் பயன்படுத்த "
"குறிப்பிட்ட ONVIF மீடியா சுயவிவரம். அமைக்கப்படவில்லை எனில், சரியான PTZ "
"உள்ளமைவுடன் கூடிய முதல் சுயவிவரம் தானாகவே தேர்ந்தெடுக்கப்படும்."

msgctxt "onvif.autotracking.label"
msgid "Autotracking"
msgstr "ஆட்டோட்ராக்கிங்"

msgctxt "onvif.autotracking.description"
msgid ""
"Automatically track moving objects and keep them centered in the frame using"
" PTZ camera movements."
msgstr ""
"நகரும் பொருட்களைத் தானாகக் கண்காணித்து, PTZ கேமரா இயக்கங்களைப் பயன்படுத்தி "
"அவற்றை சட்டகத்தில் மையமாக வைக்கவும்."

msgctxt "onvif.autotracking.enabled.label"
msgid "Enable Autotracking"
msgstr "ஆட்டோட்ராக்கிங்கை இயக்கு"

msgctxt "onvif.autotracking.enabled.description"
msgid "Enable or disable automatic PTZ camera tracking of detected objects."
msgstr ""
"கண்டறியப்பட்ட பொருட்களின் தானியங்கி PTZ கேமரா கண்காணிப்பை இயக்கவும் அல்லது "
"முடக்கவும்."

msgctxt "onvif.autotracking.calibrate_on_startup.label"
msgid "Calibrate on start"
msgstr "தொடக்கத்தில் அளவீடு செய்யவும்"

msgctxt "onvif.autotracking.calibrate_on_startup.description"
msgid ""
"Measure PTZ motor speeds on startup to improve tracking accuracy. Frigate "
"will update config with movement_weights after calibration."
msgstr ""
"கண்காணிப்பு துல்லியத்தை மேம்படுத்த தொடக்கத்தில் PTZ மின்னோடி வேகத்தை "
"அளவிடவும். ஃப்ரிகேட் அளவுத்திருத்தத்திற்குப் பிறகு மூவ்மென்ட்_வெயிட்களுடன் "
"கட்டமைப்பைப் புதுப்பிக்கும்."

msgctxt "onvif.autotracking.zooming.label"
msgid "Zoom mode"
msgstr "பெரிதாக்கு பயன்முறை"

msgctxt "onvif.autotracking.zooming.description"
msgid ""
"Control zoom behavior: disabled (pan/tilt only), absolute (most compatible),"
" or relative (concurrent pan/tilt/zoom)."
msgstr ""
"கட்டுப்பாட்டு சூம் நடத்தை: முடக்கப்பட்டது (பான்/டில்ட் மட்டும்), முழுமையானது"
" (மிகவும் இணக்கமானது) அல்லது உறவினர் (ஒரே நேரத்தில் பான்/டில்ட்/சூம்)."

msgctxt "onvif.autotracking.zoom_factor.label"
msgid "Zoom factor"
msgstr "பெரிதாக்கு காரணி"

msgctxt "onvif.autotracking.zoom_factor.description"
msgid ""
"Control zoom level on tracked objects. Lower values keep more scene in view;"
" higher values zoom in closer but may lose tracking. Values between 0.1 and "
"0.75."
msgstr ""
"கண்காணிக்கப்படும் பொருள்களில் சூம் அளவைக் கட்டுப்படுத்தவும். குறைந்த "
"மதிப்புகள் அதிக காட்சியை பார்வையில் வைத்திருக்கின்றன; அதிக மதிப்புகள் "
"நெருக்கமாக பெரிதாக்கப்படுகின்றன, ஆனால் கண்காணிப்பை இழக்கலாம். 0.1 மற்றும் "
"0.75 இடையே மதிப்புகள்."

msgctxt "onvif.autotracking.track.label"
msgid "Tracked objects"
msgstr "கண்காணிக்கப்பட்ட பொருள்கள்"

msgctxt "onvif.autotracking.track.description"
msgid "List of object types that should trigger autotracking."
msgstr "ஆட்டோட்ராக்கிங்கைத் தூண்டும் பொருள் வகைகளின் பட்டியல்."

msgctxt "onvif.autotracking.required_zones.label"
msgid "Required zones"
msgstr "தேவையான மண்டலங்கள்"

msgctxt "onvif.autotracking.required_zones.description"
msgid "Objects must enter one of these zones before autotracking begins."
msgstr ""
"ஆட்டோட்ராக்கிங் தொடங்கும் முன், பொருள்கள் இந்த மண்டலங்களில் ஒன்றை உள்ளிட "
"வேண்டும்."

msgctxt "onvif.autotracking.return_preset.label"
msgid "Return preset"
msgstr "திரும்ப முன்னமைவு"

msgctxt "onvif.autotracking.return_preset.description"
msgid ""
"ONVIF preset name configured in camera firmware to return to after tracking "
"ends."
msgstr ""
"ONVIF முன்னமைக்கப்பட்ட பெயர் கண்காணிப்பு முடிந்ததும் திரும்ப கேமரா "
"ஃபார்ம்வேரில் உள்ளமைக்கப்பட்டது."

msgctxt "onvif.autotracking.timeout.label"
msgid "Return timeout"
msgstr "திரும்பும் நேரம் முடிந்தது"

msgctxt "onvif.autotracking.timeout.description"
msgid ""
"Wait this many seconds after losing tracking before returning camera to "
"preset position."
msgstr ""
"கண்காணிப்பை இழந்த பிறகு, கேமராவை முன்னமைக்கப்பட்ட நிலைக்குத் திரும்புவதற்கு "
"முன், இத்தனை வினாடிகள் காத்திருக்கவும்."

msgctxt "onvif.autotracking.movement_weights.label"
msgid "Movement weights"
msgstr "இயக்க எடைகள்"

msgctxt "onvif.autotracking.movement_weights.description"
msgid ""
"Calibration values automatically generated by camera calibration. Do not "
"modify manually."
msgstr ""
"அளவுத்திருத்த மதிப்புகள் கேமரா அளவுத்திருத்தத்தால் தானாகவே உருவாக்கப்படும். "
"கைமுறையாக மாற்ற வேண்டாம்."

msgctxt "onvif.autotracking.enabled_in_config.label"
msgid "Original autotrack state"
msgstr "அசல் ஆட்டோட்ராக் நிலை"

msgctxt "onvif.autotracking.enabled_in_config.description"
msgid ""
"Internal field to track whether autotracking was enabled in configuration."
msgstr ""
"உள்ளமைவில் ஆட்டோட்ராக்கிங் இயக்கப்பட்டுள்ளதா என்பதைக் கண்காணிப்பதற்கான உள் "
"புலம்."

msgctxt "onvif.ignore_time_mismatch.label"
msgid "Ignore time mismatch"
msgstr "நேர பொருத்தமின்மையை புறக்கணிக்கவும்"

msgctxt "onvif.ignore_time_mismatch.description"
msgid ""
"Ignore time synchronization differences between camera and Frigate server "
"for ONVIF communication."
msgstr ""
"ONVIF தகவல்தொடர்புக்காக கேமரா மற்றும் ஃப்ரிகேட் சர்வர் இடையே நேர ஒத்திசைவு "
"வேறுபாடுகளை புறக்கணிக்கவும்."

msgctxt "type.label"
msgid "Camera type"
msgstr "கேமரா வகை"

msgctxt "type.description"
msgid "Camera Type"
msgstr "கேமரா வகை"

msgctxt "ui.label"
msgid "Camera UI"
msgstr "இடைமுகம் கேமரா"

msgctxt "ui.description"
msgid ""
"Display ordering and visibility for this camera in the UI. Ordering affects "
"the default dashboard. For more granular control, use camera groups."
msgstr ""
"இடைமுகம் இல் இந்தக் கேமராவிற்கான வரிசைப்படுத்தல் மற்றும் தெரிவுநிலையைக் "
"காட்டவும். ஆர்டர் செய்வது இயல்புநிலை டாச்போர்டை பாதிக்கிறது. மேலும் "
"சிறுமணிக் கட்டுப்பாட்டிற்கு, கேமரா குழுக்களைப் பயன்படுத்தவும்."

msgctxt "ui.order.label"
msgid "UI order"
msgstr "இடைமுகம் ஆர்டர்"

msgctxt "ui.order.description"
msgid ""
"Numeric order used to sort the camera in the UI (default dashboard and "
"lists); larger numbers appear later."
msgstr ""
"இடைமுகம் இல் கேமராவை வரிசைப்படுத்தப் பயன்படுத்தப்படும் எண் வரிசை (இயல்புநிலை"
" டாச்போர்டு மற்றும் பட்டியல்கள்); பெரிய எண்கள் பின்னர் தோன்றும்."

msgctxt "ui.dashboard.label"
msgid "Show on Live dashboard"
msgstr "நேரடி டாச்போர்டில் காட்டு"

msgctxt "ui.dashboard.description"
msgid ""
"Toggle whether this camera is visible on the default All Cameras live "
"dashboard. The camera remains available everywhere else in the UI, including"
" camera groups and settings."
msgstr ""
"இயல்புநிலை அனைத்து கேமராக்களின் லைவ் டாச்போர்டில் இந்தக் கேமரா தெரிகிறதா "
"என்பதை மாற்றவும். கேமரா குழுக்கள் மற்றும் அமைப்புகள் உட்பட இடைமுகம் இல் மற்ற"
" எல்லா இடங்களிலும் கேமரா உள்ளது."

msgctxt "ui.review.label"
msgid "Show in review"
msgstr "மதிப்பாய்வில் காட்டு"

msgctxt "ui.review.description"
msgid ""
"Toggle whether this camera is visible in review (the review page and its "
"camera filter, motion review, and the history view)."
msgstr ""
"இந்த கேமரா மதிப்பாய்வில் தெரிகிறதா என்பதை மாற்றவும் (மதிப்பாய்வுப் பக்கம் "
"மற்றும் அதன் கேமரா வடிப்பான், இயக்க மதிப்பாய்வு மற்றும் வரலாற்றுக் காட்சி)."

msgctxt "webui_url.label"
msgid "Camera URL"
msgstr "கேமரா முகவரி"

msgctxt "webui_url.description"
msgid "URL to visit the camera directly from system page"
msgstr "சிச்டம் பக்கத்திலிருந்து நேரடியாக கேமராவைப் பார்ப்பதற்கான முகவரி"

msgctxt "profiles.label"
msgid "Profiles"
msgstr "சுயவிவரங்கள்"

msgctxt "profiles.description"
msgid ""
"Named config profiles with partial overrides that can be activated at "
"runtime."
msgstr ""
"இயக்க நேரத்தில் செயல்படுத்தக்கூடிய பகுதி மேலெழுதல்களுடன் பெயரிடப்பட்ட "
"கட்டமைப்பு சுயவிவரங்கள்."

msgctxt "zones.label"
msgid "Zones"
msgstr "மண்டலங்கள்"

msgctxt "zones.description"
msgid ""
"Zones allow you to define a specific area of the frame so you can determine "
"whether or not an object is within a particular area."
msgstr ""
"சட்டத்தின் ஒரு குறிப்பிட்ட பகுதியை வரையறுக்க மண்டலங்கள் உங்களை "
"அனுமதிக்கின்றன, இதனால் ஒரு பொருள் ஒரு குறிப்பிட்ட பகுதிக்குள் உள்ளதா இல்லையா"
" என்பதை நீங்கள் தீர்மானிக்க முடியும்."

msgctxt "zones.friendly_name.label"
msgid "Zone name"
msgstr "மண்டலத்தின் பெயர்"

msgctxt "zones.friendly_name.description"
msgid ""
"A user-friendly name for the zone, displayed in the Frigate UI. If not set, "
"a formatted version of the zone name will be used."
msgstr ""
"ஃபிரிகேட் இடைமுகம் இல் காட்டப்படும் மண்டலத்திற்கான பயனர் நட்புப் பெயர். "
"அமைக்கப்படவில்லை எனில், மண்டலப் பெயரின் வடிவமைக்கப்பட்ட பதிப்பு "
"பயன்படுத்தப்படும்."

msgctxt "zones.enabled.label"
msgid "Enabled"
msgstr "இயக்கப்பட்டது"

msgctxt "zones.enabled.description"
msgid "Enable or disable this zone. Disabled zones are ignored at runtime."
msgstr ""
"இந்த மண்டலத்தை இயக்கவும் அல்லது முடக்கவும். இயக்க நேரத்தில் முடக்கப்பட்ட "
"மண்டலங்கள் புறக்கணிக்கப்படும்."

msgctxt "zones.enabled_in_config.label"
msgid "Keep track of original state of zone."
msgstr "மண்டலத்தின் அசல் நிலையைக் கண்காணிக்கவும்."

msgctxt "zones.filters.label"
msgid "Zone filters"
msgstr "மண்டல வடிப்பான்கள்"

msgctxt "zones.filters.description"
msgid ""
"Filters to apply to objects within this zone. Used to reduce false positives"
" or restrict which objects are considered present in the zone."
msgstr ""
"இந்த மண்டலத்தில் உள்ள பொருட்களுக்குப் பயன்படுத்துவதற்கான வடிப்பான்கள். தவறான"
" நேர்மறைகளைக் குறைக்க அல்லது மண்டலத்தில் இருக்கும் பொருள்களைக் "
"கட்டுப்படுத்தப் பயன்படுகிறது."

msgctxt "zones.filters.min_area.label"
msgid "Minimum object area"
msgstr "குறைந்தபட்ச பொருள் பரப்பளவு"

msgctxt "zones.filters.min_area.description"
msgid ""
"Minimum bounding box area (pixels or percentage) required for this object "
"type. Can be pixels (int) or percentage (float between 0.000001 and 0.99)."
msgstr ""
"இந்த ஆப்செக்ட் வகைக்குத் தேவையான குறைந்தபட்ச எல்லைப் பெட்டிப் பகுதி "
"(பிக்சல்கள் அல்லது சதவீதம்). படப்புள்ளிகள் (int) அல்லது விழுக்காடு (0.000001"
" மற்றும் 0.99 இடையே மிதவை) இருக்கலாம்."

msgctxt "zones.filters.max_area.label"
msgid "Maximum object area"
msgstr "பொருளின் அதிகபட்ச பரப்பளவு"

msgctxt "zones.filters.max_area.description"
msgid ""
"Maximum bounding box area (pixels or percentage) allowed for this object "
"type. Can be pixels (int) or percentage (float between 0.000001 and 0.99)."
msgstr ""
"இந்த ஆப்செக்ட் வகைக்கு அனுமதிக்கப்படும் அதிகபட்ச எல்லைப் பெட்டிப் பகுதி "
"(பிக்சல்கள் அல்லது சதவீதம்). படப்புள்ளிகள் (int) அல்லது விழுக்காடு (0.000001"
" மற்றும் 0.99 இடையே மிதவை) இருக்கலாம்."

msgctxt "zones.filters.min_ratio.label"
msgid "Minimum aspect ratio"
msgstr "குறைந்தபட்ச தோற்ற விகிதம்"

msgctxt "zones.filters.min_ratio.description"
msgid "Minimum width/height ratio required for the bounding box to qualify."
msgstr "எல்லைப் பெட்டி தகுதிபெற குறைந்தபட்ச அகலம்/உயரம் விகிதம் தேவை."

msgctxt "zones.filters.max_ratio.label"
msgid "Maximum aspect ratio"
msgstr "அதிகபட்ச தோற்ற விகிதம்"

msgctxt "zones.filters.max_ratio.description"
msgid "Maximum width/height ratio allowed for the bounding box to qualify."
msgstr ""
"வரம்புப் பெட்டி தகுதிபெற அதிகபட்ச அகலம்/உயரம் விகிதம் அனுமதிக்கப்படுகிறது."

msgctxt "zones.filters.threshold.label"
msgid "Confidence threshold"
msgstr "நம்பிக்கை வாசல்"

msgctxt "zones.filters.threshold.description"
msgid ""
"Average detection confidence threshold required for the object to be "
"considered a true positive."
msgstr ""
"பொருள் உண்மையான நேர்மறையாகக் கருதப்படுவதற்கு சராசரி கண்டறிதல் நம்பிக்கை "
"வரம்பு தேவை."

msgctxt "zones.filters.min_score.label"
msgid "Minimum confidence"
msgstr "குறைந்தபட்ச நம்பிக்கை"

msgctxt "zones.filters.min_score.description"
msgid ""
"Minimum single-frame detection confidence required for the object to be "
"counted."
msgstr ""
"கணக்கிடப்படும் பொருளுக்கு குறைந்தபட்ச ஒற்றை-சட்ட கண்டறிதல் நம்பிக்கை தேவை."

msgctxt "zones.filters.mask.label"
msgid "Filter mask"
msgstr "வடிகட்டி முகமூடி"

msgctxt "zones.filters.mask.description"
msgid ""
"Polygon coordinates defining where this filter applies within the frame."
msgstr ""
"இந்த வடிப்பான் சட்டகத்திற்குள் எங்கு பொருந்தும் என்பதை வரையறுக்கும் பலகோண "
"ஒருங்கிணைப்புகள்."

msgctxt "zones.filters.raw_mask.label"
msgid "Raw Mask"
msgstr "மூல முகமூடி"

msgctxt "zones.coordinates.label"
msgid "Coordinates"
msgstr "ஒருங்கிணைப்புகள்"

msgctxt "zones.coordinates.description"
msgid ""
"Polygon coordinates that define the zone area. Can be a comma-separated "
"string or a list of coordinate strings. Coordinates should be relative (0-1)"
" or absolute (legacy)."
msgstr ""
"மண்டலப் பகுதியை வரையறுக்கும் பலகோண ஒருங்கிணைப்புகள். கமாவால் பிரிக்கப்பட்ட "
"சரம் அல்லது ஒருங்கிணைப்பு சரங்களின் பட்டியலாக இருக்கலாம். ஒருங்கிணைப்புகள் "
"தொடர்புடையதாக (0-1) அல்லது முழுமையானதாக (மரபு) இருக்க வேண்டும்."

msgctxt "zones.distances.label"
msgid "Real-world distances"
msgstr "நிச உலக தூரங்கள்"

msgctxt "zones.distances.description"
msgid ""
"Optional real-world distances for each side of the zone quadrilateral, used "
"for speed or distance calculations. Must have exactly 4 values if set."
msgstr ""
"நாற்கர மண்டலத்தின் ஒவ்வொரு பக்கத்திற்கும் விருப்பமான நிச உலக தூரங்கள், "
"விரைவு அல்லது தூரக் கணக்கீடுகளுக்குப் பயன்படுத்தப்படுகின்றன. அமைத்தால் "
"சரியாக 4 மதிப்புகள் இருக்க வேண்டும்."

msgctxt "zones.inertia.label"
msgid "Inertia frames"
msgstr "மந்தநிலை சட்டங்கள்"

msgctxt "zones.inertia.description"
msgid ""
"Number of consecutive frames an object must be detected in the zone before "
"it is considered present. Helps filter out transient detections."
msgstr ""
"ஒரு பொருள் தற்போது இருப்பதாகக் கருதப்படுவதற்கு முன்பு மண்டலத்தில் "
"கண்டறியப்பட வேண்டிய தொடர்ச்சியான பிரேம்களின் எண்ணிக்கை. நிலையற்ற "
"கண்டறிதல்களை வடிகட்ட உதவுகிறது."

msgctxt "zones.loitering_time.label"
msgid "Loitering seconds"
msgstr "அலையும் நொடிகள்"

msgctxt "zones.loitering_time.description"
msgid ""
"Number of seconds an object must remain in the zone to be considered as "
"loitering. Set to 0 to disable loitering detection."
msgstr ""
"அலைந்து திரிந்ததாகக் கருதப்படுவதற்கு, ஒரு பொருள் மண்டலத்தில் இருக்க வேண்டிய "
"வினாடிகளின் எண்ணிக்கை. அலைந்து திரிவதைக் கண்டறிவதை முடக்க 0 என அமைக்கவும்."

msgctxt "zones.speed_threshold.label"
msgid "Minimum speed"
msgstr "குறைந்தபட்ச விரைவு"

msgctxt "zones.speed_threshold.description"
msgid ""
"Minimum speed (in real-world units if distances are set) required for an "
"object to be considered present in the zone. Used for speed-based zone "
"triggers."
msgstr ""
"மண்டலத்தில் உள்ளதாகக் கருதப்படும் பொருளுக்கு குறைந்தபட்ச விரைவு (தூரங்கள் "
"அமைக்கப்பட்டால் நிச உலக அலகுகளில்) தேவை. வேக அடிப்படையிலான மண்டல "
"தூண்டுதல்களுக்குப் பயன்படுத்தப்படுகிறது."

msgctxt "zones.objects.label"
msgid "Trigger objects"
msgstr "பொருட்களைத் தூண்டு"

msgctxt "zones.objects.description"
msgid ""
"List of object types (from labelmap) that can trigger this zone. Can be a "
"string or a list of strings. If empty, all objects are considered."
msgstr ""
"இந்த மண்டலத்தைத் தூண்டக்கூடிய பொருள் வகைகளின் பட்டியல் (லேபிள்மேப்பில் "
"இருந்து). சரம் அல்லது சரங்களின் பட்டியலாக இருக்கலாம். காலியாக இருந்தால், "
"அனைத்து பொருட்களும் கருதப்படும்."

msgctxt "enabled_in_config.label"
msgid "Original camera state"
msgstr "அசல் கேமரா நிலை"

msgctxt "enabled_in_config.description"
msgid "Keep track of original state of camera."
msgstr "கேமராவின் அசல் நிலையைக் கண்காணிக்கவும்."
