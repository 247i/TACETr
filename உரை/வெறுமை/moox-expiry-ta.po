#. // Expiry refers to the expiration date of a record and the package name
#. Moox Expiry
msgctxt "return[]->'expiry'"
msgid "Expiry"
msgstr "காலாவதியாகும்"

#. // Expiries refers to the expiration date of a record and the package name
#. Moox Expiry
msgctxt "return[]->'expiries'"
msgid "Expiries"
msgstr "காலாவதியாகும்"

#. // No assignee refers to the absence of an assignee for an expired record
msgctxt "return[]->'no_assignee'"
msgid "No assignee"
msgstr "ஒதுக்கப்பட்டவர் இல்லை"

#. // No expiry date refers to the absence of an expiry date for a record
msgctxt "return[]->'no_expiry_date'"
msgid "No expiry date"
msgstr "காலாவதி தேதி இல்லை"

msgctxt "return[]->'update_expiries'"
msgid "Update Expiries"
msgstr "புதுப்பித்தல் காலாவதியாகும்"

msgctxt "return[]->'updating_started'"
msgid "Updating started"
msgstr "புதுப்பித்தல் தொடங்கியது"

msgctxt "return[]->'expired_at'"
msgid "Due"
msgstr "காரணமாக"

msgctxt "return[]->'processing_deadline'"
msgid "Processing deadline"
msgstr "செயலாக்க காலக்கெடு"

msgctxt "return[]->'escalated_at'"
msgid "Reminder"
msgstr "நினைவூட்டல்கள்"

msgctxt "return[]->'escalated_to'"
msgid "Reminder to"
msgstr "நினைவூட்டல்"

msgctxt "return[]->'cycle'"
msgid "Cycle"
msgstr "சுழற்சி"

msgctxt "return[]->'notifyUser'"
msgid "Assignee"
msgstr "ஒதுக்கப்பட்டவர்"

msgctxt "return[]->'expiry_job'"
msgid "Type"
msgstr "வகை"

msgctxt "return[]->'escalated_entries_in_expiry_dashboard'"
msgid "Escalated entries in expiry dashboard"
msgstr "காலாவதியான டாச்போர்டில் அதிகரித்த உள்ளீடுகள்"

msgctxt "return[]->'following_escalated_entries'"
msgid "Following entries are escalated"
msgstr "பின்வரும் உள்ளீடுகள் அதிகரிக்கப்பட்டுள்ளன"

msgctxt "return[]->'review_entries'"
msgid "Please review these entries as soon as possible in the "
msgstr "இந்த உள்ளீடுகளை முடிந்தவரை விரைவில் மதிப்பாய்வு செய்யவும்"

msgctxt "return[]->'expiry_dashboard'"
msgid "Expiry Dashboard"
msgstr "காலாவதியான டாச்போர்டு"

msgctxt "return[]->'set_date_based_on_cycle'"
msgid "Set date based on cycle"
msgstr "சுழற்சியின் அடிப்படையில் தேதியை அமைக்கவும்"

msgctxt "return[]->'date_updated'"
msgid "Expiry date successfully updated"
msgstr "காலாவதி தேதி வெற்றிகரமாக புதுப்பிக்கப்பட்டது"

msgctxt "return[]->'set_new_expiry_date'"
msgid "Set New Expiry Date"
msgstr "புதிய காலாவதி தேதியை அமைக்கவும்"

msgctxt "return[]->'previous_expiry_date'"
msgid "Previous Expiry Date"
msgstr "முந்தைய காலாவதி தேதி"

msgctxt "return[]->'save'"
msgid "Save"
msgstr "சேமி"

msgctxt "return[]->'update_expiry_date'"
msgid "Update Expiry Date"
msgstr "காலாவதி தேதியைப் புதுப்பிக்கவும்"

msgctxt "return[]->'yearly'"
msgid "yearly"
msgstr "ஆண்டு"

msgctxt "return[]->'half_yearly'"
msgid "half-yearly"
msgstr "அரையாண்டு"

msgctxt "return[]->'quarterly'"
msgid "quarterly"
msgstr "காலாண்டு"

msgctxt "return[]->'monthly'"
msgid "monthly"
msgstr "மாதாந்திர"

msgctxt "return[]->'weekly'"
msgid "weekly"
msgstr "வாரந்தோறும்"

msgctxt "return[]->'no_fixed_cycle'"
msgid "no fixed cycle"
msgstr "நிலையான சுழற்சி இல்லை"

msgctxt "return[]->'no_expiry_set'"
msgid "If no expiry date is set, the expiry date has to be set manually."
msgstr ""
"காலாவதி தேதி அமைக்கப்படவில்லை என்றால், காலாவதி தேதியை கைமுறையாக அமைக்க "
"வேண்டும்."

msgctxt "return[]->'expiry_in_future'"
msgid "The expiry date must be in the future."
msgstr "காலாவதி தேதி எதிர்காலத்தில் இருக்க வேண்டும்."
