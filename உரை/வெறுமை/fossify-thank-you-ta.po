msgctxt "version"
msgid "Version: %1$s"
msgstr "பதிப்பு: %1$s"

#, java-printf-format
msgctxt "package_id"
msgid "Package: %1$s"
msgstr "தொகுப்பு: %1$s"

#, java-printf-format
msgctxt "installed_by"
msgid "Installed by: %1$s"
msgstr "நிறுவியவர்: %1$s"

#, java-printf-format
msgctxt "signed_by"
msgid "Signed by: %1$s"
msgstr "கையொப்பமிட்டவர்: %1$s"

