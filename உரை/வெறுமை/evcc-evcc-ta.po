msgctxt "authProviders.authCode"
msgid "Authentication Code"
msgstr "அங்கீகார குறியீடு"

msgctxt "authProviders.authCodeHelp"
msgid "Copy this code and use it in the next step. Valid for {duration}."
msgstr ""
"இந்தக் குறியீட்டை நகலெடுத்து அடுத்த கட்டத்தில் பயன்படுத்தவும். {duration} "
"வரை செல்லுபடியாகும்."

msgctxt "authProviders.authorizationFailed"
msgid "Authorization Failed"
msgstr "ஏற்பு தோல்வியடைந்தது"

msgctxt "authProviders.authorizationRequired"
msgid "Authorization Required"
msgstr "ஏற்பு தேவை"

msgctxt "authProviders.authorizationSuccessful"
msgid "Authorization Successful"
msgstr "ஏற்பு செய்"

msgctxt "authProviders.buttonConnect"
msgid "Connect to {provider}"
msgstr "{provider} உடன் இணைக்கவும்"

msgctxt "authProviders.buttonDisconnect"
msgid "Disconnect"
msgstr "துண்டிக்கவும்"

msgctxt "authProviders.confirmLogout"
msgid "Are you sure you want to disconnect {title}?"
msgstr "நிச்சயமாக {title} இணைப்பை துண்டிக்க விரும்புகிறீர்களா?"

msgctxt "authProviders.connect"
msgid "connect"
msgstr "இணை"

msgctxt "authProviders.disconnect"
msgid "disconnect"
msgstr "துண்டிக்கவும்"

msgctxt "authProviders.loggedOut"
msgid "Successfully logged out"
msgstr "வெற்றிகரமாக வெளியேறியது"

msgctxt "authProviders.logoutFailed"
msgid "Failed to logout"
msgstr "வெளியேறுவதில் தோல்வி"

msgctxt "authProviders.modalDescriptionLogin"
msgid ""
"Complete the authorization process to establish connection with {provider}."
msgstr "{provider} உடன் இணைப்பை ஏற்படுத்த அங்கீகார செயல்முறையை முடிக்கவும்."

msgctxt "authProviders.modalDescriptionLogout"
msgid ""
"This will disconnect your {provider} account and remove access to its data."
msgstr ""
"இது உங்கள் {provider} கணக்கைத் துண்டித்து அதன் தரவிற்கான அணுகலை அகற்றும்."

msgctxt "authProviders.success"
msgid "{title} is now connected and ready to use."
msgstr "{title} இப்போது இணைக்கப்பட்டு பயன்படுத்த தயாராக உள்ளது."

msgctxt "authProviders.successCloseModal"
msgid "You can now close this dialog."
msgstr "நீங்கள் இப்போது இந்த உரையாடலை மூடலாம்."

msgctxt "authProviders.successCloseTab"
msgid "You can now close this tab."
msgstr "நீங்கள் இப்போது இந்த தாவலை மூடலாம்."

msgctxt "authProviders.title"
msgid "Authorization Status"
msgstr "அங்கீகார நிலை"

msgctxt "battery.card.charging"
msgid "charging"
msgstr "சார்ச்"

msgctxt "battery.card.discharging"
msgid "discharging"
msgstr "வெளியேற்றும்"

msgctxt "battery.card.energy"
msgid "Energy"
msgstr "ஆற்றல்"

msgctxt "battery.card.gridCharge"
msgid "grid charging"
msgstr "கட்டம் சார்சிங்"

msgctxt "battery.card.hold"
msgid "discharge locked"
msgstr "வெளியேற்றம் பூட்டப்பட்டது"

msgctxt "battery.card.holdCharge"
msgid "charge locked"
msgstr "கட்டணம் பூட்டப்பட்டது"

msgctxt "battery.card.ofTotal"
msgid "of {total}"
msgstr "{total}"

msgctxt "battery.card.power"
msgid "Power"
msgstr "விசை"

msgctxt "battery.card.soc"
msgid "Battery level"
msgstr "பேட்டரி நிலை"

msgctxt "battery.combined"
msgid "Combined"
msgstr "இணைந்தது"

msgctxt "battery.config.buffer"
msgid ""
"Home battery energy above {soc} may be used to support the charging points "
"and delays switching off in solar mode. Start solar charging automatically "
"{start}."
msgstr ""
"{soc}க்கு மேலே உள்ள ஓம் பேட்டரி சக்தியானது சார்சிங் பாயிண்ட்டுகளை "
"ஆதரிக்கவும், சோலார் பயன்முறையில் ச்விட்ச் ஆஃப் செய்வதை தாமதப்படுத்தவும் "
"பயன்படுத்தப்படலாம். சோலார் சார்சிங்கைத் தானாகத் தொடங்கு {start}."

msgctxt "battery.config.bufferNone"
msgid ""
"Home battery energy is not used for the charging points. Set a value below "
"{soc} to enable support."
msgstr ""
"சார்சிங் பாயிண்ட்களுக்கு வீட்டு பேட்டரி ஆற்றல் பயன்படுத்தப்படாது. ஆதரவை "
"இயக்க, கீழே {soc} மதிப்பை அமைக்கவும்."

msgctxt "battery.config.bufferStart.above"
msgid "once the battery is above {soc}"
msgstr "பேட்டரி {soc}க்கு மேல் இருந்தால்"

msgctxt "battery.config.bufferStart.full"
msgid "once the battery is full"
msgstr "பேட்டரி நிரம்பியவுடன்"

msgctxt "battery.config.bufferStart.never"
msgid "only with enough surplus"
msgstr "போதுமான உபரியுடன் மட்டுமே"

msgctxt "battery.config.bufferTitle"
msgid "Battery as charging buffer"
msgstr "சார்சிங் பஃபராக பேட்டரி"

msgctxt "battery.config.discharge"
msgid ""
"Prevent home battery discharge in fast mode and during planned charging."
msgstr ""
"வேகமான பயன்முறையில் மற்றும் திட்டமிடப்பட்ட சார்சிங்கின் போது வீட்டு பேட்டரி "
"வெளியேற்றத்தைத் தடுக்கவும்."

msgctxt "battery.config.gridDischarge"
msgid "Allow home battery to discharge to the grid."
msgstr "வீட்டு பேட்டரியை கட்டத்திற்கு வெளியேற்ற அனுமதிக்கவும்."

msgctxt "battery.config.priority"
msgid ""
"Home battery has priority while it is below {soc}. Then the charging points "
"receive the surplus."
msgstr ""
"{soc}க்குக் கீழே இருக்கும் போது ஓம் பேட்டரிக்கு முன்னுரிமை உண்டு. பின்னர் "
"சார்சிங் புள்ளிகள் உபரியைப் பெறுகின்றன."

msgctxt "battery.config.priorityNone"
msgid ""
"Solar surplus goes straight to the charging points. Set a value above {soc} "
"to prioritize the home battery."
msgstr ""
"சூரிய உபரி நேராக சார்சிங் புள்ளிகளுக்கு செல்கிறது. ஓம் பேட்டரிக்கு "
"முன்னுரிமை அளிக்க {soc}க்கு மேலே மதிப்பை அமைக்கவும்."

msgctxt "battery.config.priorityTitle"
msgid "Where does the surplus go first?"
msgstr "உபரி முதலில் எங்கே செல்கிறது?"

msgctxt "battery.optimizer.action.charge"
msgid "Charge from grid"
msgstr "கட்டத்திலிருந்து கட்டணம்"

msgctxt "battery.optimizer.action.discharge"
msgid "Discharge to grid"
msgstr "கட்டத்திற்கு வெளியேற்றவும்"

msgctxt "battery.optimizer.action.hold"
msgid "Prevent discharging"
msgstr "வெளியேற்றத்தைத் தடுக்கவும்"

msgctxt "battery.optimizer.action.holdcharge"
msgid "Prevent charging"
msgstr "சார்ச் செய்வதைத் தடுக்கவும்"

msgctxt "battery.optimizer.action.normal"
msgid "Normal operation"
msgstr "இயல்பான செயல்பாடு"

msgctxt "battery.optimizer.empty"
msgid "empty"
msgstr "காலி"

msgctxt "battery.optimizer.full"
msgid "full"
msgstr "முழு"

msgctxt "battery.optimizer.highest"
msgid "Highest ({value})"
msgstr "அதிகபட்சம் ({value})"

msgctxt "battery.optimizer.lowest"
msgid "Lowest ({value})"
msgstr "குறைந்த ({value})"

msgctxt "battery.optimizer.suggestion"
msgid "Suggestion"
msgstr "பரிந்துரை"

msgctxt "batterySettings.batteryLevel"
msgid "Battery level"
msgstr "பேட்டரி நிலை"

msgctxt "batterySettings.bufferStart.above"
msgid "when above {soc}."
msgstr "மேலே {soc}."

msgctxt "batterySettings.bufferStart.full"
msgid "when at {soc}."
msgstr "{soc} இல் இருக்கும்போது."

msgctxt "batterySettings.bufferStart.never"
msgid "only with enough surplus."
msgstr "போதுமான உபரி மட்டுமே."

msgctxt "batterySettings.capacity"
msgid "{energy} of {total}"
msgstr "{energy} இன் {total} \""

msgctxt "batterySettings.control"
msgid "Battery control"
msgstr "பேட்டரி கட்டுப்பாடு"

msgctxt "batterySettings.discharge"
msgid "Prevent discharge in fast mode and planned charging."
msgstr ""
"வேகமான பயன்முறையில் வெளியேற்றத்தைத் தடுக்கவும் மற்றும் திட்டமிடப்பட்ட "
"சார்சிங்."

msgctxt "batterySettings.disclaimerHint"
msgid "Note:"
msgstr "குறிப்பு:"

msgctxt "batterySettings.disclaimerText"
msgid ""
"These settings only affect solar mode. Charging behaviour is adjusted "
"accordingly."
msgstr ""
"இந்த அமைப்புகள் சூரிய பயன்முறையை மட்டுமே பாதிக்கின்றன. சார்சிங் நடத்தை "
"அதற்கேற்ப சரிசெய்யப்படுகிறது."

msgctxt "batterySettings.gridChargeTab"
msgid "Grid charging"
msgstr "கட்டம் சார்சிங்"

msgctxt "batterySettings.legendBottomName"
msgid "Prioritize home battery charging"
msgstr "வீட்டு பேட்டரி சார்சிங்கிற்கு முன்னுரிமை அளிக்கவும்"

msgctxt "batterySettings.legendBottomSubline"
msgid "until it reaches {soc}."
msgstr "அது அடையும் வரை {soc}."

msgctxt "batterySettings.legendMiddleName"
msgid "Prioritize vehicle charging"
msgstr "வாகன கட்டணம் வசூலிப்பதற்கு முன்னுரிமை அளிக்கவும்"

msgctxt "batterySettings.legendMiddleSubline"
msgid "when home battery is above {soc}."
msgstr "வீட்டு பேட்டரி மேலே இருக்கும்போது {soc}."

msgctxt "batterySettings.legendTopAutostart"
msgid "Start automatically"
msgstr "தானாகவே தொடங்குங்கள்"

msgctxt "batterySettings.legendTopName"
msgid "Battery-supported vehicle charging"
msgstr "பேட்டரி உதவி வாகன சார்சிங்"

msgctxt "batterySettings.legendTopSubline"
msgid "when home battery is above {soc}."
msgstr "வீட்டு பேட்டரி மேலே இருக்கும்போது {soc}."

msgctxt "batterySettings.legendTopSublineAbove"
msgid "when above {soc}"
msgstr "{soc}க்கு மேல் இருக்கும் போது"

msgctxt "batterySettings.legendTopSublineDisabled"
msgid "is {soc}."
msgstr "என்பது {soc}."

msgctxt "batterySettings.legendTopSublineDisabledState"
msgid "disabled"
msgstr "முடக்கப்பட்டது"

msgctxt "batterySettings.modalTitle"
msgid "Home Battery"
msgstr "வீட்டு பேட்டரி"

msgctxt "batterySettings.noBattery"
msgid "No batteries configured."
msgstr "பேட்டரிகள் எதுவும் கட்டமைக்கப்படவில்லை."

msgctxt "batterySettings.usageTab"
msgid "Battery usage"
msgstr "பேட்டரி பயன்பாடு"

msgctxt "colors.auto"
msgid "Auto"
msgstr "தானி"

msgctxt "colors.hex"
msgid "Hex color"
msgstr "ஃச் நிறம்"

msgctxt "config.adminPassword.description"
msgid ""
"The script plugin executes a system-level command that runs with the "
"permissions of the evcc process. Re-enter your admin password to continue."
msgstr ""
"ஸ்கிரிப்ட் சொருகி evcc செயல்முறையின் அனுமதிகளுடன் இயங்கும் கணினி நிலை "
"கட்டளையை செயல்படுத்துகிறது. தொடர உங்கள் நிர்வாகக் கடவுச்சொல்லை மீண்டும் "
"உள்ளிடவும்."

msgctxt "config.adminPassword.invalid"
msgid "Invalid password. Please try again."
msgstr "செல்லுபடியாகாத கடவுச்சொல். தயவுசெய்து மீண்டும் முயலுங்கள்."

msgctxt "config.adminPassword.title"
msgid "Potentially dangerous operation"
msgstr "ஆபத்தான செயல்பாடு"

msgctxt "config.apiKey.description"
msgid ""
"Give scripts and automation tasks like scheduled backups secure access "
"without sharing your admin password."
msgstr ""
"உங்கள் நிர்வாகி கடவுச்சொல்லைப் பகிராமல், திட்டமிடப்பட்ட காப்புப்பிரதிகள் "
"போன்ற ச்கிரிப்ட்கள் மற்றும் ஆட்டோமேசன் பணிகளை பாதுகாப்பான அணுகலை வழங்கவும்."

msgctxt "config.apiKey.exampleLabel"
msgid "Try it: download a backup with curl"
msgstr "இதை முயற்சிக்கவும்: கர்ல் மூலம் காப்புப்பிரதியைப் பதிவிறக்கவும்"

msgctxt "config.apiKey.generate"
msgid "Generate API Key"
msgstr "பநிஇ விசையை உருவாக்கவும்"

msgctxt "config.apiKey.generateConfirm"
msgid "Enter your admin password to generate a new API key."
msgstr "புதிய பநிஇ விசையை உருவாக்க உங்கள் நிர்வாகி கடவுச்சொல்லை உள்ளிடவும்."

msgctxt "config.apiKey.keyLabel"
msgid "API Key"
msgstr "பநிஇ விசை"

msgctxt "config.apiKey.regenerate"
msgid "Regenerate API Key"
msgstr "பநிஇ விசையை மீண்டும் உருவாக்கு"

msgctxt "config.apiKey.regenerateConfirm"
msgid "Enter your admin password to regenerate the API key."
msgstr ""
"பநிஇ விசையை மீண்டும் உருவாக்க உங்கள் நிர்வாகி கடவுச்சொல்லை உள்ளிடவும்."

msgctxt "config.apiKey.regenerateLink"
msgid "Regenerate"
msgstr "மீண்டும் உருவாக்கு"

msgctxt "config.apiKey.regenerateWarning"
msgid ""
"Regenerating will invalidate the existing key and any automation using it "
"will stop working. Continue?"
msgstr ""
"மீளுருவாக்கம் செய்வது ஏற்கனவே உள்ள விசையை செல்லாததாக்கும் மற்றும் அதைப் "
"பயன்படுத்தும் எந்த ஆட்டோமேசனும் வேலை செய்வதை நிறுத்தும். தொடரவா?"

msgctxt "config.apiKey.revealSuccess"
msgid "Your new API key is ready to use."
msgstr "உங்கள் புதிய பநிஇ விசை பயன்படுத்த தயாராக உள்ளது."

msgctxt "config.apiKey.revealTitle"
msgid "API Key Created"
msgstr "பநிஇ விசை உருவாக்கப்பட்டது"

msgctxt "config.apiKey.shownOnce"
msgid ""
"This key is shown only once. Store it somewhere safe. You cannot retrieve it"
" later."
msgstr ""
"இந்த விசை ஒரு முறை மட்டுமே காட்டப்படும். பாதுகாப்பான இடத்தில் வைக்கவும். "
"நீங்கள் அதை பின்னர் மீட்டெடுக்க முடியாது."

msgctxt "config.apiKey.title"
msgid "API Key"
msgstr "பநிஇ விசை"

msgctxt "config.aux.description"
msgid ""
"Device that adjusts its consumption based on available surplus (like smart "
"water heaters). evcc expects that this device reduces its power consumption "
"if needed."
msgstr ""
"கிடைக்கக்கூடிய உபரி (ச்மார்ட் வாட்டர் ஈட்டர்கள் போன்றவை) அடிப்படையில் அதன் "
"நுகர்வு சரிசெய்யும் சாதனம். தேவைப்பட்டால் இந்த சாதனம் அதன் மின் நுகர்வு "
"குறைக்கிறது என்று ஈ.வி.சி.சி எதிர்பார்க்கிறது."

msgctxt "config.aux.titleAdd"
msgid "Add Self-Regulating Consumer"
