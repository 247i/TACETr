msgstr "பாட் வீதம்"

msgctxt "config.modbus.comset"
msgid "ComSet"
msgstr "காம்செட்"

msgctxt "config.modbus.connection"
msgid "Modbus connection"
msgstr "மோட்பச் இணைப்பு"

msgctxt "config.modbus.connectionHintSerial"
msgid "The device is directly connected via RS485 (or USB-to-RS485 adapter)."
msgstr ""
"சாதனம் நேரடியாக RS485 (அல்லது USB-to-RS485 அடாப்டர்) வழியாக "
"இணைக்கப்பட்டுள்ளது."

msgctxt "config.modbus.connectionHintTcpip"
msgid "The device is reachable via network (LAN/WiFi)."
msgstr "பிணையம் (LAN/WiFi) வழியாக சாதனத்தை அணுகலாம்."

msgctxt "config.modbus.connectionValueSerial"
msgid "RS485"
msgstr "RS485"

msgctxt "config.modbus.connectionValueTcpip"
msgid "Network"
msgstr "பிணையம்"

msgctxt "config.modbus.delay"
msgid "Delay"
msgstr "சுணக்கம்"

msgctxt "config.modbus.delayHint"
msgid ""
"Optional wait time before each register access. Only needed for slow "
"devices."
msgstr ""
"ஒவ்வொரு பதிவு அணுகலுக்கு முன்பும் விருப்ப காத்திருப்பு நேரம். மெதுவான "
"சாதனங்களுக்கு மட்டுமே தேவை."

msgctxt "config.modbus.device"
msgid "Device name"
msgstr "சாதன பெயர்"

msgctxt "config.modbus.deviceHint"
msgid "Example: /dev/ttyUSB0"
msgstr "எடுத்துக்காட்டு: /dev /ttyusb0"

msgctxt "config.modbus.host"
msgid "IP address or hostname"
msgstr "ஐபி முகவரி அல்லது ஓச்ட்பெயர்"

msgctxt "config.modbus.hostHint"
msgid "Example: 192.0.2.2"
msgstr "எடுத்துக்காட்டு: 192.0.2.2"

msgctxt "config.modbus.id"
msgid "Modbus ID"
msgstr "மோட்பச் அடையாளம்"

msgctxt "config.modbus.port"
msgid "Port"
msgstr "துறைமுகம்"

msgctxt "config.modbus.protocol"
msgid "Modbus protocol"
msgstr "மோட்பச் நெறிமுறை"

msgctxt "config.modbus.protocolHintRtu"
msgid ""
"Connection through a RS485 to Ethernet adapter without protocol translation."
msgstr ""
"நெறிமுறை மொழிபெயர்ப்பு இல்லாமல் ஈதர்நெட் அடாப்டருக்கு RS485 மூலம் இணைப்பு."

msgctxt "config.modbus.protocolHintTcp"
msgid ""
"Device has native LAN/Wifi support or is connected through a RS485 to "
"Ethernet adapter with protocol translation."
msgstr ""
"சாதனம் சொந்த LAN/WIFI ஆதரவைக் கொண்டுள்ளது அல்லது நெறிமுறை மொழிபெயர்ப்புடன் "
"RS485 மூலம் ஈத்தர்நெட் அடாப்டர் மூலம் இணைக்கப்பட்டுள்ளது."

msgctxt "config.modbus.protocolValueRtu"
msgid "RTU"
msgstr "Rtu"

msgctxt "config.modbus.protocolValueTcp"
msgid "TCP"
msgstr "டி.சி.பி."

msgctxt "config.modbus.timeout"
msgid "Timeout"
msgstr "நேரம் முடிந்தது"

msgctxt "config.modbus.timeoutHint"
msgid "Optional maximum time to wait for a device response."
msgstr "சாதனத்தின் பதிலுக்காக காத்திருக்க வேண்டிய அதிகபட்ச நேரம்."

msgctxt "config.modbusproxy.add"
msgid "Add proxy connection"
msgstr "பதிலாள் இணைப்பைச் சேர்க்கவும்"

msgctxt "config.modbusproxy.connection"
msgid "Connection #{number}"
msgstr "இணைப்பு #{number}"

msgctxt "config.modbusproxy.description"
msgid ""
"Some Modbus devices only support a single or very few connections. evcc can "
"act as a proxy, enabling simultaneous access for multiple clients (home "
"automation, scripts, etc.)."
msgstr ""
"சில மோட்பச் சாதனங்கள் ஒற்றை அல்லது மிகக் குறைவான இணைப்புகளை மட்டுமே "
"ஆதரிக்கின்றன. evcc ஆனது ப்ராக்சியாக செயல்படும், பல கிளையண்டுகளுக்கு (ஓம் "
"ஆட்டோமேசன், ச்கிரிப்டுகள் போன்றவை) ஒரே நேரத்தில் அணுகலை செயல்படுத்துகிறது."

msgctxt "config.modbusproxy.device"
msgid "Device"
msgstr "சாதனம்"

msgctxt "config.modbusproxy.option.deny"
msgid "error"
msgstr "பிழை"

msgctxt "config.modbusproxy.option.false"
msgid "no"
msgstr "இல்லை"

msgctxt "config.modbusproxy.option.true"
msgid "silent"
msgstr "அமைதி"

msgctxt "config.modbusproxy.readonly.help.deny"
msgid "Write access is blocked with a Modbus error."
msgstr "மோட்பச் பிழையால் எழுதும் அணுகல் தடுக்கப்பட்டது."

msgctxt "config.modbusproxy.readonly.help.false"
msgid "Write access is forwarded."
msgstr "எழுத்து அணுகல் அனுப்பப்பட்டது."

msgctxt "config.modbusproxy.readonly.help.true"
msgid "Write access is blocked without response."
msgstr "பதில் இல்லாமல் எழுதும் அணுகல் தடுக்கப்பட்டது."

msgctxt "config.modbusproxy.readonly.label"
msgid "Readonly"
msgstr "படிக்கமட்டும்"

msgctxt "config.modbusproxy.sourcePortHelp"
msgid "Port for incoming client connections. Must be available."
msgstr "உள்வரும் கிளையன்ட் இணைப்புகளுக்கான துறைமுகம். கிடைக்க வேண்டும்."

msgctxt "config.modbusproxy.title"
msgid "Modbus Proxy"
msgstr "மோட்பச் பதிலாள்"

msgctxt "config.mqtt.authentication"
msgid "Authentication"
msgstr "ஏற்பு"

msgctxt "config.mqtt.description"
msgid ""
"Connect to an MQTT broker to exchange data with other systems on your "
"network."
msgstr ""
"உங்கள் நெட்வொர்க்கில் உள்ள பிற அமைப்புகளுடன் தரவைப் பரிமாறிக் கொள்ள MQTT "
"தரகருடன் இணைக்கவும்."

msgctxt "config.mqtt.descriptionClientId"
msgid "Author of the messages. If empty `evcc-[rand]` is used."
msgstr ""
"செய்திகளின் ஆசிரியர். காலியாக இருந்தால்` evcc- [rand] `பயன்படுத்தப்பட்டால்."

msgctxt "config.mqtt.descriptionTopic"
msgid "Leave empty to disable publishing."
msgstr "வெளியீட்டை முடக்க காலியாக விடவும்."

