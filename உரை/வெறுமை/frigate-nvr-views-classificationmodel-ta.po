#, i18next-interpolation
msgctxt "wizard.step1.description"
msgid ""
"State models monitor fixed camera areas for changes (e.g., door "
"open/closed). Object models add classifications to detected objects (e.g., "
"known animals, delivery persons, etc.)."
msgstr ""
"மாநில மாதிரிகள் நிலையான கேமரா பகுதிகளை மாற்றங்களை கண்காணிக்கின்றன (எ.கா., "
"கதவு திறந்த/மூடப்பட்டது). பொருள் மாதிரிகள் கண்டறியப்பட்ட பொருட்களுக்கு "
"வகைப்பாடுகளைச் சேர்க்கின்றன (எ.கா. அறியப்பட்ட விலங்குகள், விநியோக நபர்கள் "
"போன்றவை)."

#, i18next-interpolation
msgctxt "wizard.step1.name"
msgid "Name"
msgstr "பெயர்"

#, i18next-interpolation
msgctxt "wizard.step1.namePlaceholder"
msgid "Enter model name..."
msgstr "மாதிரி பெயரை உள்ளிடவும்..."

#, i18next-interpolation
msgctxt "wizard.step1.type"
msgid "Type"
msgstr "வகை"

#, i18next-interpolation
msgctxt "wizard.step1.typeState"
msgid "State"
msgstr "மாநிலம்"

#, i18next-interpolation
msgctxt "wizard.step1.typeObject"
msgid "Object"
msgstr "பொருள்"

#, i18next-interpolation
msgctxt "wizard.step1.objectLabel"
msgid "Object Label"
msgstr "பொருள் சிட்டை"

#, i18next-interpolation
msgctxt "wizard.step1.objectLabelPlaceholder"
msgid "Select object type..."
msgstr "பொருள் வகையைத் தேர்ந்தெடுக்கவும்..."

#, i18next-interpolation
msgctxt "wizard.step1.classificationType"
msgid "Classification Type"
msgstr "வகைப்பாடு வகை"

#, i18next-interpolation
msgctxt "wizard.step1.classificationTypeTip"
msgid "Learn about classification types"
msgstr "வகைப்பாடு வகைகளைப் பற்றி அறிக"

#, i18next-interpolation
msgctxt "wizard.step1.classificationTypeDesc"
msgid ""
"Sub Labels add additional text to the object label (e.g., 'Person: UPS'). "
"Attributes are searchable metadata stored separately in the object metadata."
msgstr ""
"துணை லேபிள்கள் பொருள் லேபிளில் கூடுதல் உரையைச் சேர்க்கின்றன (எ.கா., 'நபர்: "
"யுபிஎச்'). பண்புக்கூறுகள் என்பது பொருள் மெட்டாடேட்டாவில் தனித்தனியாக "
"சேமிக்கப்படும் தேடக்கூடிய மேனிலை தரவு ஆகும்."

#, i18next-interpolation
msgctxt "wizard.step1.classificationSubLabel"
msgid "Sub Label"
msgstr "துணை சிட்டை"

#, i18next-interpolation
msgctxt "wizard.step1.classificationAttribute"
msgid "Attribute"
msgstr "பண்புக்கூறு"

#, i18next-interpolation
msgctxt "wizard.step1.classes"
msgid "Classes"
msgstr "வகுப்புகள்"

#, i18next-interpolation
msgctxt "wizard.step1.states"
msgid "States"
msgstr "மாநிலங்கள்"

#, i18next-interpolation
msgctxt "wizard.step1.classesTip"
msgid "Learn about classes"
msgstr "வகுப்புகளைப் பற்றி அறிக"

#, i18next-interpolation
msgctxt "wizard.step1.classesStateDesc"
msgid ""
"Define the different states your camera area can be in. For example: 'open' "
"and 'closed' for a garage door."
msgstr ""
"உங்கள் கேமரா பகுதி இருக்கக்கூடிய வெவ்வேறு நிலைகளை வரையறுக்கவும். "
"எடுத்துக்காட்டாக: கேரேச் கதவுக்கான 'திறந்த' மற்றும் 'மூடப்பட்ட'."

#, i18next-interpolation
msgctxt "wizard.step1.classesObjectDesc"
msgid ""
"Define the different categories to classify detected objects into. For "
"example: 'delivery_person', 'resident', 'stranger' for person "
"classification."
msgstr ""
"கண்டறியப்பட்ட பொருட்களை வகைப்படுத்த பல்வேறு வகைகளை வரையறுக்கவும். "
"எடுத்துக்காட்டாக: நபர் வகைப்படுத்தலுக்கு 'டெலிவரி_பர்சன்', 'குடியிருப்பு', "
"'அந்நியன்'."

#, i18next-interpolation
msgctxt "wizard.step1.classPlaceholder"
msgid "Enter class name..."
msgstr "வகுப்பின் பெயரை உள்ளிடவும்..."

#, i18next-interpolation
msgctxt "wizard.step1.errors.nameRequired"
msgid "Model name is required"
msgstr "மாதிரியின் பெயர் தேவை"

#, i18next-interpolation
msgctxt "wizard.step1.errors.nameLength"
msgid "Model name must be 64 characters or less"
msgstr ""
"மாதிரியின் பெயர் 64 எழுத்துகள் அல்லது அதற்கும் குறைவாக இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "wizard.step1.errors.nameOnlyNumbers"
msgid "Model name cannot contain only numbers"
msgstr "மாதிரியின் பெயரில் எண்கள் மட்டும் இருக்கக்கூடாது"

#, i18next-interpolation
msgctxt "wizard.step1.errors.classRequired"
msgid "At least 1 class is required"
msgstr "குறைந்தபட்சம் 1 வகுப்பு தேவை"

#, i18next-interpolation
msgctxt "wizard.step1.errors.classesUnique"
msgid "Class names must be unique"
msgstr "வகுப்புப் பெயர்கள் தனிப்பட்டதாக இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "wizard.step1.errors.noneNotAllowed"
msgid "The class 'none' is not allowed"
msgstr "'இல்லை' வகுப்பு அனுமதிக்கப்படவில்லை"

#, i18next-interpolation
msgctxt "wizard.step1.errors.stateRequiresTwoClasses"
msgid "State models require at least 2 classes"
msgstr "மாநில மாதிரிகளுக்கு குறைந்தது 2 வகுப்புகள் தேவை"

#, i18next-interpolation
msgctxt "wizard.step1.errors.objectLabelRequired"
msgid "Please select an object label"
msgstr "பொருள் லேபிளைத் தேர்ந்தெடுக்கவும்"

#, i18next-interpolation
msgctxt "wizard.step1.errors.objectTypeRequired"
msgid "Please select a classification type"
msgstr "வகைப்பாடு வகையைத் தேர்ந்தெடுக்கவும்"

#, i18next-interpolation
msgctxt "wizard.step2.description"
msgid ""
"Select cameras and define the area to monitor for each camera. The model "
"will classify the state of these areas."
msgstr ""
"கேமராக்களைத் தேர்ந்தெடுத்து, ஒவ்வொரு கேமராவையும் கண்காணிக்க வேண்டிய பகுதியை "
"வரையறுக்கவும். மாதிரி இந்த பகுதிகளின் நிலையை வகைப்படுத்தும்."

#, i18next-interpolation
msgctxt "wizard.step2.cameras"
msgid "Cameras"
msgstr "கேமராக்கள்"

#, i18next-interpolation
msgctxt "wizard.step2.selectCamera"
msgid "Select Camera"
msgstr "கேமராவைத் தேர்ந்தெடுக்கவும்"

#, i18next-interpolation
msgctxt "wizard.step2.noCameras"
msgid "Click + to add cameras"
msgstr "கேமராக்களை சேர்க்க + சொடுக்கு செய்யவும்"

#, i18next-interpolation
msgctxt "wizard.step2.selectCameraPrompt"
msgid "Select a camera from the list to define its monitoring area"
msgstr ""
"பட்டியலிலிருந்து கேமராவை அதன் கண்காணிப்பு பகுதியை வரையறுக்க "
"தேர்ந்தெடுக்கவும்"

#, i18next-interpolation
msgctxt "wizard.step3.selectImagesPrompt"
msgid "Select all images with: {{className}}"
msgstr "அனைத்து படங்களையும் தேர்ந்தெடுக்கவும்: {{className}}"

#, i18next-interpolation
msgctxt "wizard.step3.selectImagesDescription"
msgid ""
"Click on images to select them. Click Continue when you're done with this "
"class."
msgstr ""
"படங்களைத் தேர்ந்தெடுக்க அவற்றைக் சொடுக்கு செய்யவும். இந்த வகுப்பை "
"முடித்ததும் தொடரவும் என்பதைக் சொடுக்கு செய்யவும்."

#, i18next-interpolation
msgctxt "wizard.step3.allImagesRequired"
msgid "Please classify all images. {{count}} image remaining."
msgid_plural "Please classify all images. {{count}} images remaining."
msgstr[0] "அனைத்து படங்களையும் வகைப்படுத்தவும். {{count}} படம் மீதமுள்ளது."
msgstr[1] "அனைத்து படங்களையும் வகைப்படுத்தவும். {{count}} படங்கள் மீதமுள்ளன."

#, i18next-interpolation
msgctxt "wizard.step3.generating.title"
msgid "Generating Sample Images"
msgstr "மாதிரி படங்களை உருவாக்குகிறது"

#, i18next-interpolation
msgctxt "wizard.step3.generating.description"
msgid ""
"Frigate is pulling representative images from your recordings. This may take"
" a moment..."
msgstr ""
"Frigate உங்கள் பதிவுகளிலிருந்து பிரதிநிதித்துவப் படங்களை இழுக்கிறது. இதற்கு "
"சிறிது நேரம் ஆகலாம்..."

#, i18next-interpolation
msgctxt "wizard.step3.training.title"
msgid "Training Model"
msgstr "பயிற்சி மாதிரி"

#, i18next-interpolation
msgctxt "wizard.step3.training.description"
msgid ""
"Your model is being trained in the background. Close this dialog, and your "
"model will start running as soon as training is complete."
msgstr ""
"உங்கள் மாதிரி பின்னணியில் பயிற்சியளிக்கப்படுகிறது. இந்த உரையாடலை மூடு, "
"பயிற்சி முடிந்தவுடன் உங்கள் மாதிரி இயங்கத் தொடங்கும்."

#, i18next-interpolation
msgctxt "wizard.step3.retryGenerate"
msgid "Retry Generation"
msgstr "தலைமுறையை மீண்டும் முயற்சிக்கவும்"

#, i18next-interpolation
msgctxt "wizard.step3.noImages"
msgid "No sample images generated"
msgstr "மாதிரி படங்கள் எதுவும் உருவாக்கப்படவில்லை"

#, i18next-interpolation
msgctxt "wizard.step3.classifying"
msgid "Classifying & Training..."
msgstr "வகைப்படுத்துதல் & பயிற்சி..."

#, i18next-interpolation
msgctxt "wizard.step3.trainingStarted"
msgid "Training started successfully"
msgstr "பயிற்சி வெற்றிகரமாக தொடங்கியது"

#, i18next-interpolation
msgctxt "wizard.step3.modelCreated"
msgid ""
"Model created successfully. Use the Recent Classifications view to add "
"images for missing states, then train the model."
msgstr ""
"மாதிரி வெற்றிகரமாக உருவாக்கப்பட்டது. விடுபட்ட நிலைகளுக்கான படங்களைச் சேர்க்க"
" அண்மைக் கால வகைப்படுத்தல் காட்சியைப் பயன்படுத்தவும், பின்னர் மாதிரியைப் "
"பயிற்றுவிக்கவும்."

#, i18next-interpolation
msgctxt "wizard.step3.errors.noCameras"
msgid "No cameras configured"
msgstr "கேமராக்கள் எதுவும் கட்டமைக்கப்படவில்லை"

#, i18next-interpolation
msgctxt "wizard.step3.errors.noObjectLabel"
msgid "No object label selected"
msgstr "பொருள் சிட்டை எதுவும் தேர்ந்தெடுக்கப்படவில்லை"

#, i18next-interpolation
msgctxt "wizard.step3.errors.generateFailed"
msgid "Failed to generate examples: {{error}}"
msgstr "எடுத்துக்காட்டுகளை உருவாக்க முடியவில்லை: {{error}}"

#, i18next-interpolation
msgctxt "wizard.step3.errors.generationFailed"
msgid "Generation failed. Please try again."
msgstr "தலைமுறை தோல்வியடைந்தது. மீண்டும் முயற்சிக்கவும்."

#, i18next-interpolation
msgctxt "wizard.step3.errors.classifyFailed"
msgid "Failed to classify images: {{error}}"
msgstr "படங்களை வகைப்படுத்த முடியவில்லை: {{error}}"

#, i18next-interpolation
msgctxt "wizard.step3.generateSuccess"
msgid "Successfully generated sample images"
msgstr "மாதிரி படங்கள் வெற்றிகரமாக உருவாக்கப்பட்டன"

#, i18next-interpolation
msgctxt "wizard.step3.refreshExamples"
msgid "Generate new examples"
msgstr "புதிய உதாரணங்களை உருவாக்குங்கள்"

#, i18next-interpolation
msgctxt "wizard.step3.refreshConfirm.title"
msgid "Generate New Examples?"
msgstr "புதிய எடுத்துக்காட்டுகளை உருவாக்கவா?"

#, i18next-interpolation
msgctxt "wizard.step3.refreshConfirm.description"
msgid ""
"This will generate a new set of images and clear all selections, including "
"any previous classes. You will need to re-select examples for all classes."
msgstr ""
"இது புதிய படங்களின் தொகுப்பை உருவாக்கும் மற்றும் முந்தைய வகுப்புகள் உட்பட "
"அனைத்து தேர்வுகளையும் அழிக்கும். எல்லா வகுப்புகளுக்கும் உதாரணங்களை நீங்கள் "
"மீண்டும் தேர்ந்தெடுக்க வேண்டும்."

#, i18next-interpolation
msgctxt "wizard.step3.missingStatesWarning.title"
msgid "Missing Class Examples"
msgstr "விடுபட்ட வகுப்பு எடுத்துக்காட்டுகள்"

#, i18next-interpolation
msgctxt "wizard.step3.missingStatesWarning.description"
msgid ""
"Not all classes have examples. Try generating new examples to find the "
"missing class, or continue and use the Recent Classifications view to add "
"images later."
msgstr ""
"எல்லா வகுப்புகளுக்கும் உதாரணங்கள் இல்லை. விடுபட்ட வகுப்பைக் கண்டறிய புதிய "
"எடுத்துக்காட்டுகளை உருவாக்க முயற்சிக்கவும் அல்லது தொடர்ந்து படங்களைச் "
"சேர்க்க அண்மைக் கால வகைப்படுத்தல் காட்சியைப் பயன்படுத்தவும்."
