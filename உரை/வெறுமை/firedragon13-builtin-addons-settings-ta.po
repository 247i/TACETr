msgctxt "pages.home.title"
msgid "FireDragon Settings"
msgstr ""

msgctxt "pages.home.description"
msgid ""
"We carefully choose default settings to focus on privacy and security. When "
"changing these settings, read the description to understand the implications "
"of those changes."
msgstr ""

msgctxt "pages.home.browserBehaviour.title"
msgid "Browser behaviour"
msgstr ""

msgctxt "pages.home.browserBehaviour.autoUpdateExtensions.title"
msgid "Update add-ons automatically"
msgstr ""

msgctxt "pages.home.browserBehaviour.autoUpdateExtensions.description"
msgid ""
"Keep extensions up to date without manual intervention. A good choice for "
"your security. If you don't review the code of your extensions before every "
"update, you should enable this option."
msgstr ""

msgctxt "pages.home.browserBehaviour.enableSync.title"
msgid "Enable FireDragon Sync"
msgstr ""

msgctxt "pages.home.browserBehaviour.enableSync.description"
msgid ""
"Sync your data with other browsers. Requires restart. FireDragon Sync "
"encrypts data locally before transmitting it to the server."
msgstr ""

msgctxt "pages.home.browserBehaviour.enableSync.restartDialog.title"
msgid "Restart required"
msgstr ""

msgctxt "pages.home.browserBehaviour.enableSync.restartDialog.message"
msgid ""
"FireDragon's restart is required to completely enable or disable FireDragon "
"Sync."
msgstr ""

msgctxt "pages.home.browserBehaviour.enableMiddleClickPaste.title"
msgid "Enable middle click paste"
msgstr ""

msgctxt "pages.home.browserBehaviour.enableMiddleClickPaste.description"
msgid "Select some text to copy it, then paste it with a middle-mouse click."
msgstr ""

msgctxt "pages.home.browserBehaviour.hidePasswdmgr.title"
msgid "Hide password manager"
msgstr ""

msgctxt "pages.home.browserBehaviour.hidePasswdmgr.description"
msgid "Hide password manager menu item and settings."
msgstr ""

msgctxt "pages.home.browserBehaviour.hidePasswdmgr.restartDialog.title"
msgid "Restart required"
msgstr ""

msgctxt "pages.home.browserBehaviour.hidePasswdmgr.restartDialog.message"
msgid ""
"FireDragon's restart is required to completely show or hide the password "
"manager."
msgstr ""

msgctxt "pages.home.browserBehaviour.enableTranslations.title"
msgid "Enable Translations"
msgstr ""

msgctxt "pages.home.browserBehaviour.enableTranslations.description"
msgid "Enable offline translations."
msgstr ""

msgctxt "pages.home.browserBehaviour.closeWindowWithLastTab.title"
msgid "Close window with last tab"
msgstr ""

msgctxt "pages.home.browserBehaviour.closeWindowWithLastTab.description"
msgid "Close the browser window when the last tab is closed."
msgstr ""

msgctxt "pages.home.networking.title"
msgid "Networking"
msgstr ""

msgctxt "pages.home.networking.enableIPv6.title"
msgid "Enable IPv6"
msgstr ""

msgctxt "pages.home.networking.enableIPv6.description"
msgid ""
"Allow FireDragon to connect using IPv6. Instead of blocking IPv6 in the "
"browser, we suggest enabling the IPv6 privacy extension in your OS."
msgstr ""

msgctxt "pages.home.privacy.title"
msgid "Privacy"
msgstr ""

msgctxt "pages.home.privacy.enablePrefetchConfig.title"
msgid "Enable prefetching"
msgstr ""

msgctxt "pages.home.privacy.enablePrefetchConfig.description"
msgid ""
"Prefetching is a browser feature that allows the browser to download "
"resources in the background while the user is browsing. This can improve "
"performance and reduce bandwidth usage."
msgstr ""

msgctxt "pages.home.privacy.enablePrefetchConfig.restartDialog.title"
msgid "Restart required"
msgstr ""

msgctxt "pages.home.privacy.enablePrefetchConfig.restartDialog.message"
msgid ""
"FireDragon's restart is required to completely enable or disable prefetching."
msgstr ""

msgctxt "pages.home.privacy.limitCrossOriginReferrers.title"
msgid "Limit cross-origin referrers"
msgstr ""

msgctxt "pages.home.privacy.limitCrossOriginReferrers.description"
msgid ""
"Send a referrer only on same-origin. This may cause breakage. Additionally, "
"even when sent referrers will still be trimmed."
msgstr ""

msgctxt "pages.home.privacy.autoRefuseCookies.title"
msgid "Automatically refuse cookie banners"
msgstr ""

msgctxt "pages.home.privacy.autoRefuseCookies.description"
msgid ""
"When a site asks if they can use cookies, FireDragon automatically refuses "
"for you. Only on supported sites. Not compatible with blocking all cookies / "
"Strict-Mode."
msgstr ""

msgctxt "pages.home.fingerprinting.title"
msgid "Fingerprinting"
msgstr ""

msgctxt "pages.home.fingerprinting.enableRFP.title"
msgid "Enable ResistFingerprinting"
msgstr ""

msgctxt "pages.home.fingerprinting.enableRFP.description"
msgid ""
"ResistFingerprinting is the best in class anti-fingerprinting tool. If you "
"need to disable it, consider using an extension like Canvas Blocker."
msgstr ""

msgctxt "pages.home.fingerprinting.enableLetterboxing.title"
msgid "Enable letterboxing"
msgstr ""

msgctxt "pages.home.fingerprinting.enableLetterboxing.description"
msgid ""
"Letterboxing applies margins around your windows, in order to return a "
"limited set of rounded resolutions."
msgstr ""

msgctxt "pages.home.fingerprinting.enableWebGL.title"
msgid "Enable WebGL"
msgstr ""

msgctxt "pages.home.fingerprinting.enableWebGL.description"
msgid ""
"WebGL is a strong fingerprinting vector. If you need to enable it, consider "
"using an extension like Canvas Blocker."
msgstr ""

msgctxt "pages.home.fingerprinting.enableWebGLPrompt.title"
msgid "Enable WebGL permission handling"
msgstr ""

msgctxt "pages.home.fingerprinting.enableWebGLPrompt.description"
msgid ""
"This will enable permission handling for WebGL thus prompting you to allow "
"WebGL on sites that require it. When disabled WebGL will be available to all "
"sites."
msgstr ""

msgctxt "pages.home.fingerprinting.hideWebGLPrompt.title"
msgid "Hide WebGL permission prompt"
msgstr ""

msgctxt "pages.home.fingerprinting.hideWebGLPrompt.description"
msgid ""
"Hides the permission prompt for WebGL. It will still be accessible from the "
"URL bar."
msgstr ""

msgctxt "pages.home.security.title"
msgid "Security"
msgstr ""

msgctxt "pages.home.security.enforceOCSP.title"
msgid "Enforce OCSP hard-fail"
msgstr ""

msgctxt "pages.home.security.enforceOCSP.description"
msgid ""
"Prevent connecting to a website if the OCSP check cannot be performed. This "
"increases security, but it will cause breakage when an OCSP server is down."
msgstr ""

msgctxt "pages.home.security.enable0rtt.title"
msgid "Enable TLS 1.3 0-RTT"
msgstr ""

msgctxt "pages.home.security.enable0rtt.description"
msgid ""
"Enable 0-RTT (Zero Round Trip Time) for TLS connections. This can improve "
"performance but may increase security risks."
msgstr ""

msgctxt "pages.home.security.enableSafeBrowsing.title"
msgid "Enable Google Safe Browsing"
msgstr ""

msgctxt "pages.home.security.enableSafeBrowsing.description"
msgid ""
"If you are worried about malware and phishing, consider enabling it. "
"Disabled over censorship concerns but recommended for less advanced users. "
"All the checks happen locally."
msgstr ""

msgctxt "pages.home.security.scanDownloads.title"
msgid "Scan Downloads"
msgstr ""

msgctxt "pages.home.security.scanDownloads.description"
msgid ""
"Allow Safe Browsing to scan your downloads to identify suspicious files. All "
"the checks happen locally."
msgstr ""

