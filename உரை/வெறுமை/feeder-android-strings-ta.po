#, java-printf-format
msgctxt "preparing_offline_translation_model"
msgid "Preparing offline translation model %1$s to %2$s…"
msgstr "இணைப்பில்லாத மொழிபெயர்ப்பு மாதிரி %1$s முதல் %2$s வரை தயாராகிறது…"

#, java-printf-format
msgctxt "downloading_offline_translation_model"
msgid "Downloading offline translation model %1$s to %2$s: %3$d%%"
msgstr ""
"இணைப்பில்லாத மொழிபெயர்ப்பு மாதிரி %1$s முதல் %2$s வரை பதிவிறக்குகிறது: "
"%3$d%%"

#, java-printf-format
msgctxt "offline_translation_model_download_hint"
msgid ""
"First download can be 20–50 MB and may take a few minutes. Translation works"
" offline afterward."
msgstr ""
"முதல் பதிவிறக்கம் 20-50 MB ஆக இருக்கலாம் மற்றும் சில நிமிடங்கள் ஆகலாம். "
"மொழிபெயர்ப்பு பின்னர் ஆஃப்லைனில் வேலை செய்கிறது."

#, java-printf-format
msgctxt "preferred_translation_language"
msgid "Preferred translation language"
msgstr "விருப்பமான மொழிபெயர்ப்பு மொழி"

#, java-printf-format
msgctxt "preferred_translation_language_description"
msgid "Choose the language Feeder should translate into."
msgstr "ஃபீடர் மொழிபெயர்க்கப்பட வேண்டிய மொழியைத் தேர்ந்தெடுக்கவும்."

#, java-printf-format
msgctxt "preferred_translation_language_fallback"
msgid "the preferred language"
msgstr "விருப்பமான மொழி"

#, java-printf-format
msgctxt "local_translation_requires_android_12"
msgid "Local translation requires Android 12 or newer."
msgstr ""
"உள்ளக மொழிபெயர்ப்பிற்கு ஆண்ட்ராய்டு 12 அல்லது அதற்குப் பிந்தைய பதிப்பு தேவை."

#, java-printf-format
msgctxt "local_translation_unavailable"
msgid "Local translation is not available on this device."
msgstr "இந்தச் சாதனத்தில் உள்ளக மொழிபெயர்ப்பு இல்லை."

#, java-printf-format
msgctxt "local_translator_creation_failed"
msgid "Local translator could not be created."
msgstr "உள்ளக மொழிபெயர்ப்பாளரை உருவாக்க முடியவில்லை."

#, java-printf-format
msgctxt "local_translation_timed_out"
msgid "Local translation timed out."
msgstr "உள்ளக மொழிபெயர்ப்பு நேரம் முடிந்தது."

#, java-printf-format
msgctxt "local_translation_failed"
msgid "Local translation failed."
msgstr "உள்ளக மொழிபெயர்ப்பு தோல்வியடைந்தது."

#, java-printf-format
msgctxt "local_translation_empty_result"
msgid "Local translation returned no text."
msgstr "உள்ளக மொழிபெயர்ப்பு எந்த உரையையும் தரவில்லை."

#, java-printf-format
msgctxt "local_translator_not_ready"
msgid ""
"Local translator was not ready. Check device translation settings and retry."
msgstr ""
"உள்ளக மொழிபெயர்ப்பாளர் தயாராக இல்லை. சாதன மொழிபெயர்ப்பு அமைப்புகளைச் "
"சரிபார்த்து மீண்டும் முயற்சிக்கவும்."

#, java-printf-format
msgctxt "no_bergamot_translation_model"
msgid "No Bergamot model for %1$s -> %2$s. Check system translation languages"
msgstr ""
"%1$s -> %2$sக்கு பெர்கமோட் மாதிரி இல்லை. கணினி மொழிபெயர்ப்பு மொழிகளைச் "
"சரிபார்க்கவும்"

#, java-printf-format
msgctxt "bergamot_translation_timed_out"
msgid "Bergamot translation timed out."
msgstr "பெர்கமோட் மொழிபெயர்ப்பு நேரம் முடிந்தது."

#, java-printf-format
msgctxt "bergamot_translation_failed"
msgid "Bergamot translation failed."
msgstr "பெர்கமோட் மொழிபெயர்ப்பு தோல்வியடைந்தது."

#, java-printf-format
msgctxt "bergamot_model_registry_unavailable"
msgid "Connect to download model list."
msgstr "பதிவிறக்க மாதிரி பட்டியலை இணைக்கவும்."

#, java-printf-format
msgctxt "bergamot_model_download_failed"
msgid "Could not download %1$s -> %2$s model."
msgstr "%1$s -> %2$s மாதிரியைப் பதிவிறக்க முடியவில்லை."

#, java-printf-format
msgctxt "bergamot_webview_translation_timed_out"
msgid "Bergamot WebView translation timed out."
msgstr "Bergamot WebView மொழிபெயர்ப்பு நேரம் முடிந்தது."

#, java-printf-format
msgctxt "bergamot_webview_not_initialized"
msgid "Bergamot WebView is not initialized."
msgstr "Bergamot WebView துவக்கப்படவில்லை."

#, java-printf-format
msgctxt "bergamot_response_parse_failed"
msgid "Could not parse Bergamot response."
msgstr "பெர்கமோட் பதிலை அலச முடியவில்லை."

#, java-printf-format
msgctxt "local_translation_setup_system"
msgid ""
"Uses Android system on-device translation first which must be downloaded in "
"the system settings."
msgstr ""
"முதலில் ஆன்ட்ராய்டு சிச்டம் ஆன்-டிவைச் மொழிபெயர்ப்பைப் பயன்படுத்துகிறது, இது"
" கணினி அமைப்புகளில் பதிவிறக்கம் செய்யப்பட வேண்டும்."

#, java-printf-format
msgctxt "local_translation_setup_bergamot"
msgid ""
"If the OS has no on-device translator, Feeder downloads Mozilla/Bergamot "
"models for supported %1$s language pairs."
msgstr ""
"OS இல் சாதனத்தில் மொழிபெயர்ப்பாளர் இல்லை என்றால், Feeder ஆதரிக்கப்படும் %1$s"
" மொழி சோடிகளுக்கு Mozilla/Bergamot மாதிரிகளைப் பதிவிறக்கும்."

#, java-printf-format
msgctxt "translation_language_placeholder"
msgid "Select a language"
msgstr "ஒரு மொழியைத் தேர்ந்தெடு"

#, java-printf-format
msgctxt "show_only_bergamot_languages"
msgid "Show only target languages with any Mozilla/Bergamot model"
msgstr "Mozilla/Bergamot மாதிரியுடன் இலக்கு மொழிகளை மட்டும் காட்டு"

#, java-printf-format
msgctxt "set_translation_language_first"
msgid "Set a preferred translation language in AI settings"
msgstr "AI அமைப்புகளில் விருப்பமான மொழிபெயர்ப்பு மொழியை அமைக்கவும்"

#, java-printf-format
msgctxt "translate_feed_cards_by_default"
msgid "Translate article previews"
msgstr "கட்டுரை முன்னோட்டங்களை மொழிபெயர்க்கவும்"

#, java-printf-format
msgctxt "translate_articles_by_default"
msgid "Translate articles by default"
msgstr "கட்டுரைகளை இயல்பாக மொழிபெயர்க்கவும்"

#, java-printf-format
msgctxt "downloaded_translation_models"
msgid "Downloaded translation models"
msgstr "பதிவிறக்கப்பட்ட மொழிபெயர்ப்பு மாதிரிகள்"

#, java-printf-format
msgctxt "downloaded_translation_models_desc"
msgid ""
"Mozilla/Bergamot models stored on-device for offline translation. Delete "
"unused language pairs to free up space."
msgstr ""
"Mozilla/Bergamot மாதிரிகள் இணைப்பில்லாத மொழிபெயர்ப்புக்காக சாதனத்தில் "
"சேமிக்கப்பட்டுள்ளன. இடத்தைக் காலியாக்க, பயன்படுத்தப்படாத மொழி சோடிகளை "
"நீக்கவும்."

#, java-printf-format
msgctxt "delete_model_pair"
msgid "Delete model"
msgstr "மாதிரியை நீக்கு"

#, java-printf-format
msgctxt "delete_model_pair_desc"
msgid "Delete the %1$s to %2$s translation model (%3$s)?"
msgstr "%1$s முதல் %2$s வரையிலான மொழிபெயர்ப்பு மாதிரியை (%3$s) நீக்கவா?"

#, java-printf-format
msgctxt "delete_all_models"
msgid "Delete all downloaded models"
msgstr "பதிவிறக்கம் செய்யப்பட்ட அனைத்து மாடல்களையும் நீக்கவும்"

#, java-printf-format
msgctxt "delete_all_models_desc"
msgid "Delete all %1$d downloaded translation model(s) (%2$s)?"
msgstr ""
"அனைத்து %1$d பதிவிறக்கம் செய்யப்பட்ட மொழிபெயர்ப்பு மாதிரி(களை) (%2$s) "
"நீக்கவா?"

#, java-printf-format
msgctxt "deleted_model_pair"
msgid "Deleted %1$s to %2$s model"
msgstr "%1$s முதல் %2$s வரையிலான மாதிரி நீக்கப்பட்டது"

#, java-printf-format
msgctxt "deleted_all_models"
msgid "Deleted all downloaded models"
msgstr "பதிவிறக்கம் செய்யப்பட்ட அனைத்து மாடல்களும் நீக்கப்பட்டன"

#, java-printf-format
msgctxt "no_downloaded_models"
msgid ""
"No translation models downloaded yet. Translation will download the needed "
"model automatically."
msgstr ""
"மொழிபெயர்ப்பு மாதிரிகள் எதுவும் இன்னும் பதிவிறக்கப்படவில்லை. மொழிபெயர்ப்பு "
"தானாகவே தேவையான மாதிரியைப் பதிவிறக்கும்."

#, java-printf-format
msgctxt "delete_button_text"
msgid "Delete"
msgstr "நீக்கு"

#, java-printf-format
msgctxt "cancel"
msgid "Cancel"
msgstr "ரத்துசெய்"

#, java-printf-format
msgctxt "widget_title"
msgid "Feeder"
msgstr "ஊட்டி"

#, java-printf-format
msgctxt "widget_refreshing"
msgid "Refreshing"
msgstr "புத்துணர்ச்சி தரும்"
