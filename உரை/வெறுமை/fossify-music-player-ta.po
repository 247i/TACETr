msgstr "பிளேலிச்ட்களை நிர்வகிக்கவும்"

#, java-printf-format
msgctxt "playlists"
msgid "Playlists"
msgstr "பிளேலிச்ட்கள்"

#, java-printf-format
msgctxt "create_new_playlist"
msgid "Create new playlist"
msgstr "புதிய பிளேலிச்ட்டை உருவாக்கவும்"

#, java-printf-format
msgctxt "rename_playlist"
msgid "Rename playlist"
msgstr "பிளேலிச்ட்டை மறுபெயரிடவும்"

#, java-printf-format
msgctxt "playlist_name_exists"
msgid "A playlist with that name already exists"
msgstr "அந்தப் பெயரில் ஒரு பிளேலிச்ட் ஏற்கனவே உள்ளது"

#, java-printf-format
msgctxt "remove_playlist"
msgid "Remove playlist"
msgstr "பிளேலிச்ட்டை அகற்று"

#, java-printf-format
msgctxt "remove_playlist_description"
msgid ""
"This will only remove the selected playlists. The actual files will not be "
"deleted."
msgstr ""
"இது தேர்ந்தெடுக்கப்பட்ட பிளேலிச்ட்களை மட்டுமே அகற்றும். உண்மையான கோப்புகள் "
"நீக்கப்படாது."

#, java-printf-format
msgctxt "remove_playlist_description_placeholder"
msgid ""
"This will only remove playlist \"%s\". The actual files will not be deleted."
msgstr ""
"இது \"%s\" பிளேலிச்ட்டை மட்டுமே அகற்றும். உண்மையான கோப்புகள் நீக்கப்படாது."

#, java-printf-format
msgctxt "remove_from_playlist"
msgid "Remove from playlist"
msgstr "பிளேலிச்ட்டில் இருந்து அகற்று"

#, java-printf-format
msgctxt "remove_from_playlist_description"
msgid ""
"This will only remove the items from playlist \"%s\". The actual files will "
"not be deleted."
msgstr ""
"இது \"%s\" பிளேலிச்ட்டில் இருந்து உருப்படிகளை மட்டுமே அகற்றும். உண்மையான "
"கோப்புகள் நீக்கப்படாது."

#, java-printf-format
msgctxt "delete_the_files_too"
msgid "Delete the files too"
msgstr "கோப்புகளையும் நீக்கவும்"

#, java-printf-format
msgctxt "open_playlist"
msgid "Open playlist"
msgstr "பிளேலிச்ட்டைத் திற"

#, java-printf-format
msgctxt "all_songs_cannot_be_deleted"
msgid "\"All songs\" playlist cannot be deleted"
msgstr "\"எல்லா பாடல்களும்\" பிளேலிச்ட்டை நீக்க முடியாது"

#, java-printf-format
msgctxt "empty_playlist"
msgid "Current playlist is empty"
msgstr "தற்போதைய பிளேலிச்ட் காலியாக உள்ளது"

#, java-printf-format
msgctxt "fetching_songs"
msgid "Fetching songs…"
msgstr "பாடல்களைப் பெறுகிறது…"

#, java-printf-format
msgctxt "all_songs"
msgid "All songs"
msgstr "அனைத்து பாடல்களும்"

#, java-printf-format
msgctxt "create_playlist_from_folder"
msgid "Create new playlist from folder"
msgstr "கோப்புறையிலிருந்து புதிய பிளேலிச்ட்டை உருவாக்கவும்"

#, java-printf-format
msgctxt "folder_contains_no_audio"
msgid "The selected folder contains no audio files"
msgstr "தேர்ந்தெடுக்கப்பட்ட கோப்புறையில் ஆடியோ கோப்புகள் இல்லை"

#, java-printf-format
msgctxt "delete_current_song"
msgid "Delete current song"
msgstr "தற்போதைய பாடலை நீக்கவும்"

#, java-printf-format
msgctxt "delete_song_warning"
msgid ""
"WARNING: This will delete the selected files themselves from the device, all"
" playlists included."
msgstr ""
"எச்சரிக்கை: இது தேர்ந்தெடுக்கப்பட்ட கோப்புகளை சாதனத்திலிருந்து நீக்கிவிடும்,"
" எல்லா பிளேலிச்ட்களும் சேர்க்கப்படும்."

#, java-printf-format
msgctxt "remove_current_song"
msgid "Remove current song from playlist"
msgstr "பிளேலிச்ட்டில் இருந்து தற்போதைய பாடலை அகற்று"

#, java-printf-format
msgctxt "show_filename"
msgid "Show filename as song title"
msgstr "கோப்பின் பெயரை பாடல் தலைப்பாகக் காட்டு"

#, java-printf-format
msgctxt "title_is_not_available"
msgid "If title is not available"
msgstr "தலைப்பு கிடைக்கவில்லை என்றால்"

#, java-printf-format
msgctxt "show_album_cover"
msgid "Show album cover on the main screen"
msgstr "முதன்மைத் திரையில் ஆல்பத்தின் அட்டையைக் காட்டு"

#, java-printf-format
msgctxt "all_tracks"
msgid "All tracks"
msgstr "அனைத்து தடங்கள்"

#, java-printf-format
msgctxt "add_to_playlist"
msgid "Add to playlist"
msgstr "பிளேலிச்ட்டில் சேர்க்கவும்"

#, java-printf-format
msgctxt "create_playlist_label"
msgid ""
"You can create a new playlist by selecting the wanted artists, albums or "
"tracks and using Menu -> Add to playlist."
msgstr ""
"நீங்கள் விரும்பும் கலைஞர்கள், ஆல்பங்கள் அல்லது டிராக்குகளைத் தேர்ந்தெடுத்து,"
" பட்டியல் -> பிளேலிச்ட்டில் சேர் செய்வதன் மூலம் புதிய பிளேலிச்ட்டை "
"உருவாக்கலாம்."

#, java-printf-format
msgctxt "export_playlist"
msgid "Export playlist"
msgstr "பிளேலிச்ட்டை ஏற்றுமதி செய்யவும்"

#, java-printf-format
msgctxt "import_playlist"
msgid "Import playlist"
msgstr "பிளேலிச்ட்டை இறக்குமதி செய்யவும்"

#, java-printf-format
msgctxt "filename_without_m3u"
msgid "Filename (without .m3u)"
msgstr "கோப்பு பெயர் (.m3u இல்லாமல்)"

