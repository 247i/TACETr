msgctxt "alerts"
msgid "Alerts"
msgstr "எச்சரிக்கைகள்"

msgctxt "detections"
msgid "Detections"
msgstr "கண்டறிதல்கள்"

msgctxt "motion.label"
msgid "Motion"
msgstr "இயக்கம்"

msgctxt "motion.only"
msgid "Motion only"
msgstr "இயக்கம் மட்டுமே"

msgctxt "allCameras"
msgid "All Cameras"
msgstr "அனைத்து கேமராக்கள்"

msgctxt "empty.alert"
msgid "There are no alerts to review"
msgstr "மதிப்பாய்வு செய்ய விழிப்பூட்டல்கள் எதுவும் இல்லை"

msgctxt "empty.detection"
msgid "There are no detections to review"
msgstr "மதிப்பாய்வு செய்ய எந்த கண்டறிதலும் இல்லை"

msgctxt "empty.motion"
msgid "No motion data found"
msgstr "இயக்கத் தரவு இல்லை"

msgctxt "empty.recordingsDisabled.title"
msgid "Recordings must be enabled"
msgstr "பதிவுகள் இயக்கப்பட வேண்டும்"

msgctxt "empty.recordingsDisabled.description"
msgid ""
"Review items can only be created for a camera when recordings are enabled "
"for that camera."
msgstr ""
"கேமராவில் ரெக்கார்டிங்குகள் இயக்கப்பட்டிருக்கும் போது மட்டுமே மதிப்பாய்வு "
"உருப்படிகளை உருவாக்க முடியும்."

msgctxt "timeline.label"
msgid "Timeline"
msgstr "காலவரிசை"

msgctxt "timeline.aria"
msgid "Select timeline"
msgstr "காலவரிசையைத் தேர்ந்தெடுக்கவும்"

msgctxt "zoomIn"
msgid "Zoom In"
msgstr "பெரிதாக்கு"

msgctxt "zoomOut"
msgid "Zoom Out"
msgstr "சிறிதாக்கு"

msgctxt "events.label"
msgid "Events"
msgstr "நிகழ்வுகள்"

msgctxt "events.aria"
msgid "Select events"
msgstr "நிகழ்வுகளைத் தேர்ந்தெடுக்கவும்"

msgctxt "events.noFoundForTimePeriod"
msgid "No events found for this time period."
msgstr "இந்தக் காலத்திற்கு நிகழ்வுகள் எதுவும் இல்லை."

msgctxt "detail.label"
msgid "Detail"
msgstr "விவரம்"

msgctxt "detail.noDataFound"
msgid "No detail data to review"
msgstr "மதிப்பாய்வு செய்ய விரிவான தரவு இல்லை"

msgctxt "detail.aria"
msgid "Toggle detail view"
msgstr "விவரக் காட்சியை நிலைமாற்று"

msgctxt "detail.trackedObject_one"
msgid "{{count}} object"
msgstr "{{count}} பொருள்"

msgctxt "detail.trackedObject_other"
msgid "{{count}} objects"
msgstr "{{count}} பொருள்கள்"

msgctxt "detail.noObjectDetailData"
msgid "No object detail data available."
msgstr "பொருள் விவரத் தரவு இல்லை."

msgctxt "detail.settings"
msgid "Detail View Settings"
msgstr "விரிவான பார்வை அமைப்புகள்"

msgctxt "detail.alwaysExpandActive.title"
msgid "Always expand active"
msgstr "எப்போதும் சுறுசுறுப்பாக விரிவாக்குங்கள்"

msgctxt "detail.alwaysExpandActive.desc"
msgid "Always expand the active review item's object details when available."
msgstr ""
"செயலில் உள்ள மதிப்பாய்வு உருப்படியின் பொருள் விவரங்களைக் கிடைக்கும்போது "
"எப்போதும் விரிவாக்கவும்."

msgctxt "objectTrack.trackedPoint"
msgid "Tracked point"
msgstr "கண்காணிக்கப்பட்ட புள்ளி"

msgctxt "objectTrack.clickToSeek"
msgid "Click to seek to this time"
msgstr "இந்த நேரத்தை தேட சொடுக்கு செய்யவும்"

msgctxt "documentTitle"
msgid "Review - Frigate"
msgstr "விமர்சனம் - போர்க்கப்பல்"

msgctxt "recordings.documentTitle"
msgid "Recordings - Frigate"
msgstr "பதிவுகள் - போர்க்கப்பல்"

msgctxt "recordings.invalidSharedLink"
msgid "Unable to open timestamped recording link due to parsing error."
msgstr ""
"பாகுபடுத்தும் பிழையின் காரணமாக நேர முத்திரை பதிக்கும் இணைப்பைத் திறக்க "
"முடியவில்லை."

msgctxt "recordings.invalidSharedCamera"
msgid ""
"Unable to open timestamped recording link due to an unknown or unauthorized "
"camera."
msgstr ""
"அறியப்படாத அல்லது அங்கீகரிக்கப்படாத கேமரா காரணமாக நேர முத்திரை பதிக்கும் "
"இணைப்பைத் திறக்க முடியவில்லை."

msgctxt "calendarFilter.last24Hours"
msgid "Last 24 Hours"
msgstr "கடந்த 24 மணிநேரம்"

msgctxt "markAsReviewed"
msgid "Mark as Reviewed"
msgstr "மதிப்பாய்வு செய்யப்பட்டதாகக் குறிக்கவும்"

msgctxt "markTheseItemsAsReviewed"
msgid "Mark these items as reviewed"
msgstr "இந்த உருப்படிகளை மதிப்பாய்வு செய்ததாகக் குறிக்கவும்"

msgctxt "newReviewItems.label"
msgid "View new review items"
msgstr "புதிய மதிப்பாய்வு உருப்படிகளைக் காண்க"

msgctxt "newReviewItems.button"
msgid "New Items To Review"
msgstr "மதிப்பாய்வு செய்ய புதிய உருப்படிகள்"

msgctxt "selected_one"
msgid "{{count}} selected"
msgstr "{{count}} தேர்ந்தெடுக்கப்பட்டது"

msgctxt "selected_other"
msgid "{{count}} selected"
msgstr "{{count}} தேர்ந்தெடுக்கப்பட்டது"

msgctxt "select_all"
msgid "All"
msgstr "அனைத்தும்"

msgctxt "camera"
msgid "Camera"
msgstr "கேமரா"

msgctxt "detected"
msgid "detected"
msgstr "கண்டறியப்பட்டது"

msgctxt "normalActivity"
msgid "Normal"
msgstr "இயல்பானது"

msgctxt "needsReview"
msgid "Needs review"
msgstr "மதிப்பாய்வு தேவை"

msgctxt "securityConcern"
msgid "Security concern"
msgstr "பாதுகாப்பு கவலை"

msgctxt "motionSearch.menuItem"
msgid "Motion Search"
msgstr "மோசன் தேடல்"

msgctxt "motionSearch.openMenu"
msgid "Camera options"
msgstr "கேமரா விருப்பங்கள்"

msgctxt "motionPreviews.menuItem"
msgid "View motion previews"
msgstr "இயக்க முன்னோட்டங்களைக் காண்க"

msgctxt "motionPreviews.title"
msgid "Motion previews: {{camera}}"
msgstr "இயக்க முன்னோட்டங்கள்: {{camera}}"

msgctxt "motionPreviews.mobileSettingsTitle"
msgid "Motion Preview Settings"
msgstr "மோசன் முன்னோட்ட அமைப்புகள்"

msgctxt "motionPreviews.mobileSettingsDesc"
msgid ""
"Adjust playback speed, dimming, and cropping, and choose a date to review "
"motion-only clips."
msgstr ""
"பிளேபேக் விரைவு, டிம்மிங் மற்றும் க்ராப்பிங் ஆகியவற்றைச் சரிசெய்து, இயக்கம் "
"மட்டும் கிளிப்களை மதிப்பாய்வு செய்ய தேதியைத் தேர்ந்தெடுக்கவும்."

msgctxt "motionPreviews.dim"
msgid "Dim"
msgstr "மங்கலான"

msgctxt "motionPreviews.dimAria"
msgid "Adjust dimming intensity"
msgstr "மங்கலான தீவிரத்தை சரிசெய்யவும்"

msgctxt "motionPreviews.dimDesc"
msgid "Increase dimming to increase motion area visibility."
msgstr "இயக்கப் பகுதியின் தெரிவுநிலையை அதிகரிக்க மங்கலை அதிகரிக்கவும்."

msgctxt "motionPreviews.speed"
msgid "Speed"
msgstr "வேகம்"

msgctxt "motionPreviews.speedAria"
msgid "Select preview playback speed"
msgstr "முன்னோட்ட பின்னணி வேகத்தைத் தேர்ந்தெடுக்கவும்"

msgctxt "motionPreviews.speedDesc"
msgid "Choose how quickly preview clips play."
msgstr "கிளிப்புகள் எவ்வளவு விரைவாக இயங்குகின்றன என்பதைத் தேர்வுசெய்யவும்."

msgctxt "motionPreviews.back"
msgid "Back"
msgstr "பின்"

msgctxt "motionPreviews.empty"
msgid "No previews available"
msgstr "முன்னோட்டங்கள் எதுவும் இல்லை"

msgctxt "motionPreviews.noPreview"
msgid "Preview unavailable"
msgstr "முன்னோட்டம் கிடைக்கவில்லை"

msgctxt "motionPreviews.seekAria"
msgid "Seek {{camera}} player to {{time}}"
msgstr "{{camera}} பிளேயரை {{time}} க்கு தேடவும்"

msgctxt "motionPreviews.filter"
msgid "Filter"
msgstr "வடிப்பி"

msgctxt "motionPreviews.filterDesc"
msgid "Select areas to only show clips with motion in those regions."
msgstr ""
"அந்தப் பகுதிகளில் இயக்கத்துடன் கூடிய கிளிப்களை மட்டும் காட்ட, பகுதிகளைத் "
"தேர்ந்தெடுக்கவும்."

msgctxt "motionPreviews.filterClear"
msgid "Clear"
msgstr "தெளிவு"

msgctxt "motionPreviews.crop"
msgid "Crop to filter"
msgstr "வடிகட்டுவதற்கு செதுக்கவும்"

msgctxt "motionPreviews.cropAria"
msgid "Toggle cropping previews to the filtered areas"
msgstr "வடிகட்டப்பட்ட பகுதிகளுக்கு செதுக்குதல் மாதிரிக்காட்சிகளை மாற்றவும்"

msgctxt "motionPreviews.cropDesc"
msgid ""
"Zoom previews into the selected filter areas instead of showing the full "
"frame."
msgstr ""
"முழு ஃபிரேமைக் காட்டுவதற்குப் பதிலாக, தேர்ந்தெடுக்கப்பட்ட வடிப்பான் "
"பகுதிகளில் மாதிரிக்காட்சிகளைப் பெரிதாக்கவும்."
