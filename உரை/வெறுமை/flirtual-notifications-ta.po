#: lib/flirtual/user/email.ex:391
#, elixir-autogen, elixir-format
msgctxt "deletion_reminder_723.body_html"
msgid ""
"<p><strong>This is your final reminder.</strong> Your Flirtual account will "
"be permanently deleted in 7 days.</p><p>You only need to log in once in the "
"next 7 days to prevent your account from being deleted: no other action is "
"required.</p><p>We've improved our matchmaking system to get better matches "
"for you, and you can make friends in our Homie Mode.</p><p>If you don't log "
"in, your account and data will be permanently deleted in accordance with our "
"privacy policy.</p><p><a href=\"%{action_url}\" class=\"btn\">Log in</a></p>"
msgstr ""

