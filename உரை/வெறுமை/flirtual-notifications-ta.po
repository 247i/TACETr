#: lib/flirtual/user/push.ex:16
#, elixir-autogen, elixir-format
msgctxt "daily_profiles_ready_message"
msgid ""
"We've worked our matchmaking magic on a fresh batch of profiles just for "
"you. Tap to check them out!"
msgstr ""
