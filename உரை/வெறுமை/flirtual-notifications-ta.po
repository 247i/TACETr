#: lib/flirtual/user/email.ex:18
#, elixir-autogen, elixir-format
msgctxt "suspended.body_html"
msgid ""
"<p>Our moderation team has found your Flirtual account in violation of our "
"rules.</p>\n"
"\n"
"<p><strong>Reason</strong>: %{message}</p>\n"
"\n"
"<p>Your account data will be kept for 30 days, and then deleted as described "
"in our Privacy Policy.</p><p>Please reply to this message within 30 days if "
"you would like to appeal this moderation decision to unban your account. We "
"review all appeals, and will notify you if your appeal is accepted. If you "
"do not hear from us within 30 days, our moderation decision has been "
"upheld.</p><p>The Flirtual Team</p>"
msgstr ""

#: lib/flirtual/user/email.ex:17
#, elixir-autogen, elixir-format
msgctxt "suspended.body_text"
msgid ""
"Our moderation team has found your Flirtual account in violation of our "
"rules.\n"
"\n"
"Reason: %{message}\n"
"\n"
"Your account data will be kept for 30 days, and then deleted as described in "
"our Privacy Policy.\n"
"\n"
"Please reply to this message within 30 days if you would like to appeal this "
"moderation decision to unban your account. We review all appeals, and will "
"notify you if your appeal is accepted. If you do not hear from us within 30 "
"days, our moderation decision has been upheld.\n"
"\n"
"The Flirtual Team"
msgstr ""

