msgstr "இந்த மண்டலத்திற்கு பொருந்தும் பொருட்களின் பட்டியல்."

#, i18next-interpolation
msgctxt "masksAndZones.zones.allObjects"
msgid "All Objects"
msgstr "அனைத்து பொருள்களும்"

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedEstimation.title"
msgid "Speed Estimation"
msgstr "வேக மதிப்பீடு"

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedEstimation.desc"
msgid ""
"Enable speed estimation for objects in this zone. The zone must have exactly"
" 4 points."
msgstr ""
"இந்த மண்டலத்தில் உள்ள பொருட்களுக்கான வேக மதிப்பீட்டை இயக்கவும். மண்டலம் "
"சரியாக 4 புள்ளிகளைக் கொண்டிருக்க வேண்டும்."

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedEstimation.lineADistance"
msgid "Line A distance ({{unit}})"
msgstr "வரி A தூரம் ({{unit}})"

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedEstimation.lineBDistance"
msgid "Line B distance ({{unit}})"
msgstr "வரி B தூரம் ({{unit}})"

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedEstimation.lineCDistance"
msgid "Line C distance ({{unit}})"
msgstr "வரி C தூரம் ({{unit}})"

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedEstimation.lineDDistance"
msgid "Line D distance ({{unit}})"
msgstr "வரி டி தூரம் ({{unit}})"

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedThreshold.title"
msgid "Speed Threshold ({{unit}})"
msgstr "வேக வரம்பு ({{unit}})"

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedThreshold.desc"
msgid "Specifies a minimum speed for objects to be considered in this zone."
msgstr ""
"இந்த மண்டலத்தில் கருத்தில் கொள்ள வேண்டிய பொருட்களுக்கான குறைந்தபட்ச "
"வேகத்தைக் குறிப்பிடுகிறது."

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedThreshold.toast.error.pointLengthError"
msgid ""
"Speed estimation has been disabled for this zone. Zones with speed "
"estimation must have exactly 4 points."
msgstr ""
"இந்த மண்டலத்திற்கான வேக மதிப்பீடு முடக்கப்பட்டுள்ளது. வேக மதிப்பீட்டைக் "
"கொண்ட மண்டலங்கள் சரியாக 4 புள்ளிகளைக் கொண்டிருக்க வேண்டும்."

#, i18next-interpolation
msgctxt "masksAndZones.zones.speedThreshold.toast.error.loiteringTimeError"
msgid ""
"Zones with loitering times greater than 0 should not be used with speed "
"estimation."
msgstr ""
"0க்கு மேல் அலையும் நேரங்களைக் கொண்ட மண்டலங்களை வேகக் கணிப்புடன் பயன்படுத்தக்"
" கூடாது."

#, i18next-interpolation
msgctxt "masksAndZones.zones.toast.success"
msgid "Zone ({{zoneName}}) has been saved."
msgstr "மண்டலம் ({{zoneName}}) சேமிக்கப்பட்டது."

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.label"
msgid "Motion Mask"
msgstr "மோசன் மாச்க்"

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.documentTitle"
msgid "Edit Motion Mask - Frigate"
msgstr "மோசன் மாச்க்கைத் திருத்து - ஃப்ரிகேட்"

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.desc.title"
msgid ""
"Motion masks are used to prevent unwanted types of motion from triggering "
"detection. Over masking will make it more difficult for objects to be "
"tracked."
msgstr ""
"கண்டறிதலைத் தூண்டுவதிலிருந்து தேவையற்ற இயக்க வகைகளைத் தடுக்க மோசன் "
"மாச்க்குகள் பயன்படுத்தப்படுகின்றன. அதிகப்படியான முகமூடி பொருட்களைக் "
"கண்காணிப்பதை மிகவும் கடினமாக்கும்."

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.desc.documentation"
msgid "Documentation"
msgstr "ஆவணப்படுத்துதல்"

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.add"
msgid "New Motion Mask"
msgstr "புதிய மோசன் மாச்க்"

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.edit"
msgid "Edit Motion Mask"
msgstr "மோசன் மாச்க்கைத் திருத்து"

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.defaultName"
msgid "Motion Mask {{number}}"
msgstr "மோசன் மாச்க் {{number}}"

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.context.title"
msgid ""
"Motion masks are used to prevent unwanted types of motion from triggering "
"detection (example: tree branches, camera timestamps). Motion masks should "
"be used <em>very sparingly</em>, over-masking will make it more difficult "
"for objects to be tracked."
msgstr ""
"மோசன் மாச்க்குகள் தேவையற்ற இயக்கங்கள் கண்டறிதலைத் தூண்டுவதைத் தடுக்கப் "
"பயன்படுகின்றன (எடுத்துக்காட்டு: மரக்கிளைகள், கேமரா நேர முத்திரைகள்). மோசன் "
"மாச்க்குகளை <em>மிகவும் குறைவாகப் பயன்படுத்த வேண்டும்</em>, அதிகப்படியான "
"முகமூடி பொருட்களைக் கண்காணிப்பதை மிகவும் கடினமாக்கும்."

