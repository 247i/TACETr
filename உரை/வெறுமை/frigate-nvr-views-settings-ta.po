#, i18next-interpolation
msgctxt "enrichments.birdClassification.title"
msgid "Bird Classification"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.birdClassification.desc"
msgid ""
"Bird classification identifies known birds using a quantized Tensorflow "
"model. When a known bird is recognized, its common name will be added as a "
"sub_label. This information is included in the UI, filters, as well as in "
"notifications."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.title"
msgid "Semantic Search"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.desc"
msgid ""
"Semantic Search in Frigate allows you to find tracked objects within your "
"review items using either the image itself, a user-defined text description, "
"or an automatically generated one."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.reindexNow.label"
msgid "Reindex Now"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.reindexNow.desc"
msgid ""
"Reindexing will regenerate embeddings for all tracked objects. This process "
"runs in the background and may max out your CPU and take a fair amount of "
"time depending on the number of tracked objects you have."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.reindexNow.confirmTitle"
msgid "Confirm Reindexing"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.reindexNow.confirmDesc"
msgid ""
"Are you sure you want to reindex all tracked object embeddings? This process "
"will run in the background but it may max out your CPU and take a fair "
"amount of time. You can watch the progress on the Explore page."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.reindexNow.confirmButton"
msgid "Reindex"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.reindexNow.success"
msgid "Reindexing started successfully."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.reindexNow.alreadyInProgress"
msgid "Reindexing is already in progress."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.reindexNow.error"
msgid "Failed to start reindexing: {{errorMessage}}"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.modelSize.label"
msgid "Model Size"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.modelSize.desc"
msgid "The size of the model used for semantic search embeddings."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.modelSize.small.title"
msgid "small"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.modelSize.small.desc"
msgid ""
"Using <em>small</em> employs a quantized version of the model that uses less "
"RAM and runs faster on CPU with a very negligible difference in embedding "
"quality."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.modelSize.large.title"
msgid "large"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.semanticSearch.modelSize.large.desc"
msgid ""
"Using <em>large</em> employs the full Jina model and will automatically run "
"on the GPU if applicable."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.faceRecognition.title"
msgid "Face Recognition"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.faceRecognition.desc"
msgid ""
"Face recognition allows people to be assigned names and when their face is "
"recognized Frigate will assign the person's name as a sub label. This "
"information is included in the UI, filters, as well as in notifications."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.faceRecognition.modelSize.label"
msgid "Model Size"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.faceRecognition.modelSize.desc"
msgid "The size of the model used for face recognition."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.faceRecognition.modelSize.small.title"
msgid "small"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.faceRecognition.modelSize.small.desc"
msgid ""
"Using <em>small</em> employs a FaceNet face embedding model that runs "
"efficiently on most CPUs."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.faceRecognition.modelSize.large.title"
msgid "large"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.faceRecognition.modelSize.large.desc"
msgid ""
"Using <em>large</em> employs an ArcFace face embedding model and will "
"automatically run on the GPU if applicable."
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.licensePlateRecognition.title"
msgid "License Plate Recognition"
msgstr ""

#, i18next-interpolation
msgctxt "enrichments.licensePlateRecognition.desc"
msgid ""
"Frigate can recognize license plates on vehicles and automatically add the "
"detected characters to the recognized_license_plate field or a known name as "
"a sub_label to objects that are of type car. A common use case may be to "
"read the license plates of cars pulling into a driveway or cars passing by "
"on a street."
msgstr ""

