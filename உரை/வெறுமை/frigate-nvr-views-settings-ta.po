msgid "Click to draw a polygon on the image."
msgstr "படத்தில் பலகோணத்தை வரைய சொடுக்கு செய்யவும்."

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.name.title"
msgid "Name"
msgstr "பெயர்"

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.name.description"
msgid "An optional friendly name for this motion mask."
msgstr "இந்த மோசன் மாச்க்கிற்கு விருப்பமான நட்பு பெயர்."

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.name.placeholder"
msgid "Enter a name..."
msgstr "பெயரை உள்ளிடவும்..."

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.polygonAreaTooLarge.title"
msgid ""
"The motion mask is covering {{polygonArea}}% of the camera frame. Large "
"motion masks are not recommended."
msgstr ""
"மோசன் மாச்க் கேமரா ஃப்ரேமின் {{polygonArea}}% ஐ உள்ளடக்கியது. பெரிய இயக்க "
"முகமூடிகள் பரிந்துரைக்கப்படவில்லை."

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.polygonAreaTooLarge.tips"
msgid ""
"Motion masks do not prevent objects from being detected. You should use a "
"required zone instead."
msgstr ""
"மோசன் முகமூடிகள் பொருட்களைக் கண்டறியப்படுவதைத் தடுக்காது. அதற்குப் பதிலாக "
"தேவையான மண்டலத்தைப் பயன்படுத்த வேண்டும்."

#, i18next-interpolation
msgctxt "masksAndZones.motionMasks.toast.success.title"
msgid "{{polygonName}} has been saved."
msgstr "{{polygonName}} சேமிக்கப்பட்டது."

#, i18next-interpolation
