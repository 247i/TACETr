#. The name of the extension.
msgctxt "appName"
msgid "Scrum Helper"
msgstr "Scrum Helper"

#. A brief description of what the extension does.
msgctxt "appDescription"
msgid ""
"Report your development progress by auto-fetching your Git activity for a "
"selected period"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட காலப்பகுதிக்கான உங்கள் Git செயல்பாட்டைத் தானாகவே பெற்று,"
" உங்கள் மேம்பாட்டு முன்னேற்றத்தைப் புகாரளியுங்கள்."

#. Label for the toggle switch to disable the extension.
msgctxt "disableLabel"
msgid "Disable"
msgstr "முடக்கு"

#. Label for the toggle switch to enable the extension.
msgctxt "enableLabel"
msgid "Enable"
msgstr "இயக்கு"

#. Label for the project name input field.
msgctxt "projectNameLabel"
msgid "Project Name (used in email subject)"
msgstr "திட்டப் பெயர் (மின்னஞ்சல் தலைப்பில் பயன்படுத்தப்படும்)"

#. Placeholder text for the project name input.
msgctxt "projectNamePlaceholder"
msgid "Enter your project name"
msgstr "உங்கள் திட்டப் பெயரை உள்ளிடவும்"

#. Label for the GitHub username input field.
msgctxt "githubUsernameLabel"
msgid "Your Github Username"
msgstr "உங்கள் GitHub பயனர்பெயர்"

#. Label for the GitLab username input field.
msgctxt "gitlabUsernameLabel"
msgid "Your GitLab Username"
msgstr "உங்கள் GitLab பயனர்பெயர்"

#. Placeholder text for the GitHub username input.
msgctxt "githubUsernamePlaceholder"
msgid "Required for fetching your contributions"
msgstr "உங்கள் பங்களிப்புகளை பெற தேவையானது"

#. Label for the date range selection.
msgctxt "contributionsLabel"
msgid "Fetch your contributions between:"
msgstr "பங்களிப்புகளை பெற காலகட்டம்:"

#. Radio button option for the last 1 day.
msgctxt "last1DayLabel"
msgid "Previous day"
msgstr "முந்தைய நாள்"

#. Radio button option for the last 7 days.
msgctxt "lastWeekLabel"
msgid "Previous week"
msgstr "முந்தைய வாரம்"

#. Label for the start date picker.
msgctxt "startDateLabel"
msgid "From:"
msgstr "தொடக்கம்:"

#. Label for the end date picker.
#, terminology
msgctxt "endDateLabel"
msgid "To:"
msgstr "முடிவு:"

#. Label for the checkbox to show PR labels.
#, terminology
msgctxt "showOpenClosedLabel"
msgid "Show PRs Labels"
msgstr "PR லேபல்களைக் காட்டு"

#. Label for the input field for blockers.
msgctxt "blockersLabel"
msgid "What is blocking you from making progress?"
msgstr "உங்கள் முன்னேற்றத்தை தடுப்பது என்ன?"

#. Placeholder text for the blockers input field.
msgctxt "blockersPlaceholder"
msgid "Enter your reason"
msgstr "உங்கள் காரணத்தை உள்ளிடவும்"

msgctxt "scrumReportLabel"
msgid "Scrum Report"
msgstr "Scrum அறிக்கை"

#. Text for the 'Generate' button.
msgctxt "generateReportButton"
msgid "Generate"
msgstr "உருவாக்கு"

#. Text for the 'Copy' button.
msgctxt "copyReportButton"
msgid "Copy"
msgstr "நகலெடு"

#. Text for the 'Insert to Email' button.
msgctxt "insertInEmailButton"
msgid "Insert to Email"
msgstr "மின்னஞ்சலில் செருகு"

#. Error message shown when no active email tab can receive insert action or
#. when the mail tab needs reload.
#, fuzzy
msgctxt "insertToEmailFailedError"
msgid ""
"Open an email tab (or reload the existing mail tab) to insert the report"
msgstr "அறிக்கையைச் செருக மின்னஞ்சல் தாவலைத் திறக்கவும்"

#. Label for the organization name input in settings.
msgctxt "settingsOrgNameLabel"
msgid "Organization Name"
msgstr "நிறுவன பெயர்"

#. Placeholder for the organization name input.
msgctxt "settingsOrgNamePlaceholder"
msgid "Enter organization name"
msgstr "நிறுவன பெயரை உள்ளிடவும்"

#. Text for the 'Set' button for the organization.
msgctxt "setButton"
msgid "Set"
msgstr "அமை"

#. Label for the GitHub token input.
msgctxt "githubTokenLabel"
msgid "Your Github Token"
msgstr "உங்கள் GitHub டோக்கன்"

#. Placeholder for the GitHub token input.
msgctxt "githubTokenPlaceholder"
msgid "Required for making authenticated requests"
msgstr "அங்கீகரிக்கப்பட்ட கோரிக்கைகளுக்கு தேவையானது"

#. Tooltip for GitHub token explaining why it's needed.
#, fuzzy
msgctxt "githubTokenTooltip"
msgid ""
"Why is it recommended to add a GitHub token? Scrum Helper works without a "
"GitHub token, but adding a personal access token (classic) is recommended "
"for a better experience."
msgstr ""
"GitHub டோக்கன் சேர்க்க ஏன் பரிந்துரைக்கப்படுகிறது? Scrum Helper GitHub "
"டோக்கன் இல்லாமலும் செயல்படும், ஆனால் சிறந்த அனுபவத்திற்காக தனிப்பட்ட அணுகல் "
"டோக்கன் சேர்க்க பரிந்துரைக்கப்படுகிறது."

#. Label for the GitLab token input.
msgctxt "gitlabTokenLabel"
msgid "Your GitLab Token"
msgstr "உங்கள் GitLab டோக்கன்"

#. Placeholder for the GitLab token input.
msgctxt "gitlabTokenPlaceholder"
msgid "Required for accessing private projects"
msgstr "தனிப்பட்ட திட்டங்களை அணுக தேவையானது"

#. Tooltip for GitLab token explaining why it's needed.
msgctxt "gitlabTokenTooltip"
msgid ""
"Why is it recommended to add a GitLab token? Scrum Helper works without a "
"GitLab token for public projects, but adding a personal access token is "
"recommended for a better experience."
msgstr ""
"GitLab டோக்கன் சேர்க்க ஏன் பரிந்துரைக்கப்படுகிறது? Scrum Helper பொது "
"திட்டங்களுக்கு GitLab டோக்கன் இல்லாமலும் செயல்படும், ஆனால் சிறந்த "
"அனுபவத்திற்காக தனிப்பட்ட அணுகல் டோக்கன் சேர்க்க பரிந்துரைக்கப்படுகிறது."

#. Label for the checkbox to show commits in open PRs.
#, terminology
msgctxt "showCommitsLabel"
msgid "Show commits on open PRs/ draft PRs"
msgstr "திறந்த PR / வரைவு PR களில் commits காட்டு"

msgctxt "showCommitsTooltip"
msgid "Github Token required, add it in the settings."
msgstr "GitHub டோக்கன் தேவை, அமைப்புகளில் சேர்க்கவும்."

#, fuzzy
msgctxt "onlyIssuesLabel"
msgid "Include issues in the report"
msgstr "அறிக்கையில் சிக்கல்களை மட்டும் சேர்"

#, fuzzy
msgctxt "onlyIssuesTooltip"
msgid ""
"If checked, the report will include issues created or assigned to the user."
msgstr ""
"தேர்ந்தெடுக்கப்பட்டால், அறிக்கையில் பயனரால் உருவாக்கப்பட்ட அல்லது "
"ஒதுக்கப்பட்ட சிக்கல்கள் மட்டுமே இருக்கும்."

#, fuzzy
msgctxt "onlyPRsLabel"
msgid "Include PRs in the report"
msgstr "அறிக்கையில் PR களை மட்டும் சேர்"

#, fuzzy
msgctxt "onlyPRsTooltip"
msgid ""
"If checked, the report will include PRs created by the user. Reviewed PRs "
"will be excluded."
msgstr ""
"தேர்ந்தெடுக்கப்பட்டால், அறிக்கையில் பயனரால் உருவாக்கப்பட்ட PR கள் மட்டுமே "
"இருக்கும். மதிப்பாய்வு செய்யப்பட்ட PR கள் விலக்கப்படும்."

#. Label for the cache time-to-live input.
msgctxt "cacheTTLLabel"
msgid "Enter cache TTL"
msgstr "தற்காலிக சேமிப்பு TTL ஐ உள்ளிடவும்"

#. Unit for the cache TTL.
msgctxt "cacheTTLUnit"
msgid "(in minutes)"
msgstr "(நிமிடங்களில்)"

#. Placeholder for the cache TTL input.
msgctxt "cacheTTLPlaceholder"
msgid "Write Cache TTL in minutes (Default 10 minutes)"
msgstr ""
"தற்காலிக சேமிப்பு TTL ஐ நிமிடங்களில் உள்ளிடவும் (இயல்புநிலை: 10 நிமிடங்கள்)"

#. Text for the button to refresh data, ignoring the cache.
msgctxt "refreshDataButton"
msgid "Refresh Data (bypass cache)"
msgstr "தரவை புதுப்பி (தற்காலிக சேமிப்பை புறக்கணி)"

#. Informational text below the refresh button.
msgctxt "refreshDataInfo"
msgid "Use this button to fetch fresh data immediately."
msgstr "புதிய தரவை உடனடியாக பெற இந்த பொத்தானை பயன்படுத்தவும்."

#. Title for the notes section.
msgctxt "noteTitle"
msgid "Note:"
msgstr "குறிப்பு:"

#. Text for the button to view the source code on GitHub.
msgctxt "viewCodeButton"
msgid "View Code"
msgstr "குறியீட்டைக் காண்"

#. Text for the button to report an issue on GitHub.
msgctxt "reportIssueButton"
msgid "Report Issue"
msgstr "சிக்கலை அறிவி"

#. Label for the repository filter section.
msgctxt "repoFilterLabel"
msgid "Filter by repositories"
msgstr "களஞ்சியங்களால் வடிகட்டு"

#. Label for the checkbox to enable repository filtering.
msgctxt "enableFilteringLabel"
msgid "Enable filtering"
msgstr "வடிகட்டலை இயக்கு"

#. Warning message shown when repo filtering is enabled without a token.
msgctxt "tokenRequiredWarning"
msgid ""
"A GitHub token is required for repository filtering. Please add one in the "
"settings."
msgstr ""
"களஞ்சியங்களை வடிகட்ட GitHub டோக்கன் தேவை. அமைப்புகளில் ஒன்றை சேர்க்கவும்."

#. Warning message shown when show commits is enabled without a token.
msgctxt "tokenRequiredShowCommitsWarning"
msgid ""
"A GitHub token is required to show commits on open or draft PRs. Please add "
"one in the settings."
msgstr ""
"திறந்த அல்லது வரைவு PR களில் commits காட்ட GitHub டோக்கன் தேவை. அமைப்புகளில்"
" ஒன்றை சேர்க்கவும்."

#. Placeholder for the repository search input.
msgctxt "repoSearchPlaceholder"
msgid "Search for a repository to add..."
msgstr "சேர்க்க களஞ்சியத்தை தேடவும்..."

#. Placeholder text when no repositories are selected for filtering.
msgctxt "repoPlaceholder"
msgid "No repositories selected (all will be included)"
msgstr "களஞ்சியங்கள் தேர்ந்தெடுக்கப்படவில்லை (அனைத்தும் சேர்க்கப்படும்)"

#. Text showing the count of selected repositories when it's zero.
#, terminology
msgctxt "repoCountNone"
msgid "0 repositories selected"
msgstr "0 களஞ்சியங்கள் தேர்ந்தெடுக்கப்பட்டன"

#. Text showing the count of selected repositories. $1 is a placeholder for
#. the number.
msgctxt "repoCount"
msgid "$1 repositories selected"
msgstr "$1 களஞ்சியங்கள் தேர்ந்தெடுக்கப்பட்டன"

#. Clear all selected repositories.
msgctxt "clearAllBtn"
msgid "Clear All"
msgstr "அனைத்தையும் அழி"

#. Status message when repositories are being loaded.
msgctxt "repoLoading"
msgid "Loading repositories..."
msgstr "களஞ்சியங்கள் ஏற்றப்படுகின்றன..."

#. Status message after repositories have been successfully loaded. $1 is a
#. placeholder for the number.
msgctxt "repoLoaded"
msgid "Loaded $1 repositories."
msgstr "$1 களஞ்சியங்கள் ஏற்றப்பட்டன."

#. Message shown in the dropdown when a search yields no results.
msgctxt "repoNotFound"
msgid "No repositories found"
msgstr "களஞ்சியங்கள் எதுவும் கிடைக்கவில்லை"

#. Status message when repositories are being refetched.
msgctxt "repoRefetching"
msgid "Refetching repositories..."
msgstr "களஞ்சியங்கள் மீண்டும் பெறப்படுகின்றன..."

#. Error message when repository loading fails.
msgctxt "repoLoadFailed"
msgid "Failed to load repositories."
msgstr "களஞ்சியங்களை ஏற்றுவதில் தோல்வி."

#. Error message when the token is invalid or lacks permissions.
msgctxt "repoTokenPrivate"
msgid "Token is invalid or does not have rights for private repos."
msgstr "டோக்கன் தவறானது அல்லது தனிப்பட்ட களஞ்சியங்களுக்கான உரிமைகள் இல்லை."

#. Error message when refetching repositories fails.
msgctxt "repoRefetchFailed"
msgid "Failed to refetch repositories."
msgstr "களஞ்சியங்களை மீண்டும் பெறுவதில் தோல்வி."

#. Success toast message when an organization is set.
msgctxt "orgSetMessage"
msgid "Organization set successfully."
msgstr "நிறுவனம் வெற்றிகரமாக அமைக்கப்பட்டது."

#. Message shown when the organization is cleared.
msgctxt "orgClearedMessage"
msgid "Organization cleared. Click 'Generate' to fetch all activities."
msgstr ""
"நிறுவனம் அழிக்கப்பட்டது. அனைத்து செயல்பாடுகளையும் பெற 'உருவாக்கு' என்பதை "
"கிளிக் செய்யவும்."

#. Error toast message when an organization is not found.
msgctxt "orgNotFoundMessage"
msgid "Organization not found on GitHub."
msgstr "GitHub இல் நிறுவனம் கிடைக்கவில்லை."

#. Error toast message for general organization validation errors.
msgctxt "orgValidationErrorMessage"
msgid "Error validating organization."
msgstr "நிறுவனத்தை சரிபார்க்கும்போது பிழை."

#. Text on the refresh button while it's in a loading state.
msgctxt "refreshingButton"
msgid "Refreshing..."
msgstr "புதுப்பிக்கிறது..."

#. Error message when clearing the cache fails.
msgctxt "cacheClearFailed"
msgid "Cache clear failed."
msgstr "தற்காலிக சேமிப்பை அழிப்பதில் தோல்வி."

#. Footer credit text.
msgctxt "madeWithLoveBy"
msgid "Made with ❤️ by"
msgstr "❤️ உடன் உருவாக்கியவர்"

#. Text shown on the generate button when the report is being created.
msgctxt "generatingButton"
msgid "Generating..."
msgstr "உருவாக்குகிறது..."

#. Text shown on the copy button after a successful copy.
msgctxt "copiedButton"
msgid "Copied!"
msgstr "நகலெடுக்கப்பட்டது!"

#. Message shown in the report area after the organization is changed.
msgctxt "orgChangedMessage"
msgid ""
"Organization changed. Click Generate button to fetch the GitHub activities."
msgstr ""
"நிறுவனம் மாற்றப்பட்டது. GitHub செயல்பாடுகளை பெற 'உருவாக்கு' பொத்தானை கிளிக் "
"செய்யவும்."

#. Message shown in the report area after the cache is cleared.
msgctxt "cacheClearedMessage"
msgid "Cache cleared successfully. Click \"Generate\" to fetch fresh data."
msgstr ""
"தற்காலிக சேமிப்பு வெற்றிகரமாக அழிக்கப்பட்டது. புதிய தரவை பெற «உருவாக்கு» "
"என்பதை கிளிக் செய்யவும்."

#. Message shown when the cached data has expired and user needs to
#. regenerate.
msgctxt "cacheExpiredMessage"
msgid "Cache expired. Click \"Generate\" to fetch fresh data."
msgstr ""
"தற்காலிக சேமிப்பு காலாவதியானது. புதிய தரவை பெற «உருவாக்கு» என்பதை கிளிக் "
"செய்யவும்."

#. Text on the refresh button after the cache is cleared.
msgctxt "cacheClearedButton"
msgid "Cache Cleared!"
msgstr "தற்காலிக சேமிப்பு அழிக்கப்பட்டது!"

#. Message shown when the extension is disabled.
msgctxt "extensionDisabledMessage"
msgid ""
"Extension is disabled. Enable it from the options to generate scrum reports."
msgstr ""
"நீட்டிப்பு முடக்கப்பட்டுள்ளது. Scrum அறிக்கைகளை உருவாக்க விருப்பங்களில் "
"இருந்து இயக்கவும்."

#. First point in the notes section.
msgctxt "notePoint1"
msgid ""
"Pull requests are fetched based on the most recent review activity by any "
"contributor, not just your own. Please review and adjust the generated SCRUM"
" report to ensure it accurately reflects your work before sharing."
msgstr ""
"Pull requests உங்களது மட்டுமல்ல, எந்தவொரு பங்களிப்பாளரின் சமீபத்திய "
"மதிப்பாய்வு செயல்பாட்டின் அடிப்படையில் பெறப்படுகின்றன. பகிர்வதற்கு முன்பு "
"உங்கள் பணியை துல்லியமாக பிரதிபலிக்கிறதா என்பதை உறுதிப்படுத்த உருவாக்கப்பட்ட "
"SCRUM அறிக்கையை மதிப்பாய்வு செய்து சரிசெய்யவும்."

#. Link text for the GitHub issue in the notes.
msgctxt "noteSeeIssue"
msgid "See this issue"
msgstr "இந்த சிக்கலைப் பாருங்கள்"

#. Label for the platform selection header.
msgctxt "platformLabel"
msgid "Platform"
msgstr "தளம்"

#. Label for the username input header.
msgctxt "usernameLabel"
msgid "Your Username"
msgstr "உங்கள் பயனர்பெயர்"

#. Label for the checkbox to include only reviewed PRs.
#, fuzzy
msgctxt "onlyRevPRsLabel"
msgid "Include reviewed PRs in the report"
msgstr "அறிக்கையில் மதிப்பாய்வு செய்யப்பட்ட PR களை மட்டும் சேர்"

#. Tooltip for the reviewed PRs filter checkbox.
#, fuzzy
msgctxt "onlyRevPRsTooltip"
msgid "If checked, the report will include PRs reviewed by you."
msgstr ""
"தேர்ந்தெடுக்கப்பட்டால், அறிக்கையில் நீங்கள் மதிப்பாய்வு செய்த PR கள் மட்டுமே"
" இருக்கும்."

#. Label for the checkbox to include only merged PRs.
#, fuzzy
msgctxt "onlyMergedPRsLabel"
msgid "Include merged PRs in the report"
msgstr "இணைக்கப்பட்ட பிஆர்களை மட்டும் அறிக்கையில் சேர்க்கவும்"

#. Tooltip for the merged PRs filter checkbox.
#, fuzzy
msgctxt "onlyMergedPRsTooltip"
msgid ""
"If checked, the report will include PRs that have been merged. A GitHub "
"token is required."
msgstr ""
"தேர்ந்தெடுக்கப்பட்டால், அறிக்கை இணைக்கப்பட்ட பிஆர்களை மட்டுமே உள்ளடக்கும். "
"ஒரு GitHub டோக்கன் தேவை."

#. Warning shown when merged PRs filter is enabled without a GitHub token.
msgctxt "tokenRequiredMergedPRsWarning"
msgid ""
"A GitHub token is required to filter by merged PRs. Please add one in the "
"settings."
msgstr ""
"இணைக்கப்பட்ட பிஆர்கள் மூலம் வடிகட்ட ஒரு GitHub டோக்கன் தேவை. அமைப்புகளில் "
"ஒன்றைச் சேர்க்கவும்."

#. Error shown when username is missing.
msgctxt "usernameRequiredError"
msgid "Please enter your username to generate a report."
msgstr "அறிக்கையை உருவாக்க உங்கள் பயனர்பெயரை உள்ளிடவும்."

#. Error shown when an unsupported platform is selected.
msgctxt "unknownPlatformError"
msgid "Unknown platform selected."
msgstr "அறியப்படாத தளம் தேர்ந்தெடுக்கப்பட்டது."

#. Error shown when GitLab data fetch fails.
msgctxt "gitlabFetchingError"
msgid "An error occurred while fetching GitLab data."
msgstr "GitLab தரவை எடுக்கும்போது பிழை ஏற்பட்டது."

#. Error when report generation fails.
msgctxt "reportGenerationError"
msgid "An error occurred while generating the report."
msgstr "அறிக்கையை உருவாக்கும்போது பிழை ஏற்பட்டது."

#. Error when GitHub user is not found.
msgctxt "githubUserNotFoundError"
msgid "GitHub user \"$1\" not found."
msgstr "GitHub பயனர் \"$1\" கண்டறியப்படவில்லை."

#. Error when validating GitHub user fails. $1=status, $2=statusText
msgctxt "githubUserValidationError"
msgid "Error validating GitHub user: $1 $2"
msgstr "GitHub பயனரைச் சரிபார்ப்பதில் பிழை: $1 $2"

#. Error when the search query or date range is invalid.
msgctxt "invalidSearchQueryError"
msgid ""
"Invalid search query or date range. Please verify your date range format and"
" try again."
msgstr ""
"தவறான தேடல் அல்லது தேதி வரம்பு. வடிவத்தை சரிபார்த்து மீண்டும் "
"முயற்சிக்கவும்."

#. Error when fetching GitHub issues fails. $1=status, $2=statusText
msgctxt "githubIssuesFetchError"
msgid "Error fetching GitHub issues: $1 $2"
msgstr "GitHub சிக்கல்களை எடுப்பதில் பிழை: $1 $2"

#. Error when fetching GitHub PR review data fails. $1=status, $2=statusText
msgctxt "githubPRReviewFetchError"
msgid "Error fetching GitHub PR review data: $1 $2"
msgstr "GitHub PR மதிப்பாய்வு தரவை எடுப்பதில் பிழை: $1 $2"

#. Error when fetching GitHub user data fails. $1=status, $2=statusText
msgctxt "githubUserFetchError"
msgid "Error fetching GitHub user data: $1 $2"
msgstr "GitHub பயனர் தரவை எடுப்பதில் பிழை: $1 $2"

#. Error for invalid or expired GitHub token.
msgctxt "invalidTokenError"
msgid ""
"Invalid or expired GitHub token. Please check your token in the Scrum Helper"
" settings and try again."
msgstr ""
"தவறான அல்லது காலாவதியான GitHub டோக்கன். Scrum Helper அமைப்புகளில் உங்கள் "
"டோக்கனைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."

#. Notice for display mode change. $1=mode label
msgctxt "displayModeNotice"
msgid "The extension will open in $1 mode on the next launch."
msgstr "அடுத்த துவக்கத்தில் நீட்டிப்பு $1 பயன்முறையில் திறக்கும்."

#. Shown when repo filtering is not available for other platforms.
msgctxt "repoFilteringGithubOnly"
msgid "Repository filtering is only available for GitHub."
msgstr "தொகுப்பு வடிகட்டுதல் GitHubக்கு மட்டுமே கிடைக்கும்."

#. Shown when repo loading is not available for other platforms.
msgctxt "repoLoadingGithubOnly"
msgid "Repository loading is only available for GitHub."
msgstr "தொகுப்பு ஏற்றுதல் GitHubக்கு மட்டுமே கிடைக்கும்."

#. Shown when repo fetching is not available for other platforms.
msgctxt "repoFetchingGithubOnly"
msgid "Repository fetching is only available for GitHub."
msgstr "தொகுப்பு மீட்டெடுப்பு GitHubக்கு மட்டுமே கிடைக்கும்."

#. Status message when repos are loading.
msgctxt "loadingReposAutomatically"
msgid "Loading repos automatically..."
msgstr "தொகுப்புகள் தானாகவே ஏற்றப்படுகின்றன..."

#. Error when fetching GitLab user fails. $1=status, $2=statusText
msgctxt "gitlabUserFetchError"
msgid "Error fetching GitLab user: $1 $2"
msgstr "GitLab பயனரை எடுப்பதில் பிழை: $1 $2"

#. Error when GitLab user is not found. $1=username
msgctxt "gitlabUserNotFoundError"
msgid "GitLab user '$1' not found."
msgstr "GitLab பயனர் '$1' கண்டறியப்படவில்லை."

#. Error when fetching GitLab membership projects fails. $1=status,
#. $2=statusText
msgctxt "gitlabMembershipError"
msgid "Error fetching GitLab membership projects: $1 $2"
msgstr "GitLab உறுப்பினர் திட்டங்களை எடுப்பதில் பிழை: $1 $2"

#. Error when fetching GitLab contributed projects fails. $1=status,
#. $2=statusText
msgctxt "gitlabContributedError"
msgid "Error fetching GitLab contributed projects: $1 $2"
msgstr "GitLab பங்களிப்பு திட்டங்களை எடுப்பதில் பிழை: $1 $2"

#. Error shown when username is missing.
msgctxt "usernameMissingError"
msgid "Username required."
msgstr "பயனர்பெயர் தேவை."

#. Tooltip shortcut for the Generate button. Dynamically replaced with Cmd+G
#. on macOS.
msgctxt "generateReportTooltip"
msgid "Ctrl+G"
msgstr "Ctrl+G"

#. Tooltip shortcut for the Copy button. Dynamically replaced with Cmd+Shift+Y
#. on macOS.
msgctxt "copyReportTooltip"
msgid "Ctrl+Shift+Y"
msgstr "Ctrl+Shift+Y"

#. Notification shown when report generation is triggered via keyboard
#. shortcut.
msgctxt "generatingReportNotification"
msgid "Generating report..."
msgstr "அறிக்கை உருவாக்கப்படுகிறது..."

#. Notification shown when report copy is triggered via keyboard shortcut.
msgctxt "copyingReportNotification"
msgid "Copying report..."
msgstr "அறிக்கை நகலெடுக்கப்படுகிறது..."

#. Notification shown when report is successfully copied via keyboard
#. shortcut.
msgctxt "copiedReportNotification"
msgid "Report copied!"
msgstr "அறிக்கை நகலெடுக்கப்பட்டது!"

#. Tooltip shortcut for the Insert in Email button. Dynamically replaced with
#. Cmd+Shift+M on macOS.
msgctxt "insertInEmailTooltip"
msgid "Ctrl+Shift+M"
msgstr "Ctrl+Shift+M"

#. Notification shown when report insertion into email is triggered via
#. keyboard shortcut.
msgctxt "insertingInEmailNotification"
msgid "Inserting report into email..."
msgstr "அறிக்கையை மின்னஞ்சலில் செருகுகிறது..."

#. Notification shown when report is successfully inserted into email.
msgctxt "insertedInEmailNotification"
msgid "Report inserted into email!"
msgstr "அறிக்கை மின்னஞ்சலில் செருகப்பட்டது!"

#. Error shown when GitHub API rate limit is exceeded.
msgctxt "rateLimitError"
msgid ""
"GitHub API rate limit exceeded. Please try again later or add/check your "
"GitHub token in the Scrum Helper settings."
msgstr ""
"GitHub பநிஇ வீத வரம்பை மீறியது. பிறகு முயற்சிக்கவும் அல்லது ச்க்ரம் உதவி "
"அமைப்புகளில் உங்கள் GitHub டோக்கனைச் சேர்க்கவும்/சரிபார்க்கவும்."

#. Warning message shown below buttons when rate limit is exceeded.
msgctxt "rateLimitWarningMessage"
msgid ""
"Some data may be missing due to GitHub rate limit. Please add or check your "
"GitHub token in settings."
msgstr ""
"GitHub விகித வரம்பு காரணமாக சில தரவு விடுபட்டிருக்கலாம். அமைப்புகளில் உங்கள்"
" GitHub டோக்கனைச் சேர்க்கவும் அல்லது சரிபார்க்கவும்."
