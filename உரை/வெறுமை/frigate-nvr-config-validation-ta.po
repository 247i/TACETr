#, i18next-interpolation
msgctxt "minimum"
msgid "Must be at least {{limit}}"
msgstr "குறைந்தபட்சம் {{limit}} இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "maximum"
msgid "Must be at most {{limit}}"
msgstr "அதிகபட்சம் {{limit}} இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "exclusiveMinimum"
msgid "Must be greater than {{limit}}"
msgstr "{{limit}} ஐ விட அதிகமாக இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "exclusiveMaximum"
msgid "Must be less than {{limit}}"
msgstr "{{limit}} ஐ விட குறைவாக இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "minLength"
msgid "Must be at least {{limit}} character(s)"
msgstr "குறைந்தது {{limit}} எழுத்துக்கள் இருக்க வேண்டும்)"

#, i18next-interpolation
msgctxt "maxLength"
msgid "Must be at most {{limit}} character(s)"
msgstr "அதிகபட்சம் {{limit}} எழுத்துகள் இருக்க வேண்டும்)"

#, i18next-interpolation
msgctxt "minItems"
msgid "Must have at least {{limit}} items"
msgstr "குறைந்தது {{limit}} உருப்படிகள் இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "maxItems"
msgid "Must have at most {{limit}} items"
msgstr "அதிகபட்சம் {{limit}} உருப்படிகள் இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "pattern"
msgid "Invalid format"
msgstr "தவறான வடிவம்"

#, i18next-interpolation
msgctxt "required"
msgid "This field is required"
msgstr "இந்த புலம் தேவை"

#, i18next-interpolation
msgctxt "type"
msgid "Invalid value type"
msgstr "தவறான மதிப்பு வகை"

#, i18next-interpolation
msgctxt "enum"
msgid "Must be one of the allowed values"
msgstr "அனுமதிக்கப்பட்ட மதிப்புகளில் ஒன்றாக இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "const"
msgid "Value does not match expected constant"
msgstr "எதிர்பார்க்கப்படும் மாறிலியுடன் மதிப்பு பொருந்தவில்லை"

#, i18next-interpolation
msgctxt "uniqueItems"
msgid "All items must be unique"
msgstr "அனைத்து பொருட்களும் தனிப்பட்டதாக இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "format"
msgid "Invalid format"
msgstr "தவறான வடிவம்"

#, i18next-interpolation
msgctxt "additionalProperties"
msgid "Unknown property is not allowed"
msgstr "தெரியாத சொத்து அனுமதிக்கப்படாது"

#, i18next-interpolation
msgctxt "oneOf"
msgid "Must match exactly one of the allowed schemas"
msgstr "அனுமதிக்கப்பட்ட திட்டங்களில் ஒன்றோடு சரியாகப் பொருந்த வேண்டும்"

#, i18next-interpolation
msgctxt "anyOf"
msgid "Must match at least one of the allowed schemas"
msgstr "அனுமதிக்கப்பட்ட திட்டங்களில் குறைந்தபட்சம் ஒன்றோடு பொருந்த வேண்டும்"

#, i18next-interpolation
msgctxt "proxy.header_map.roleHeaderRequired"
msgid "Role header is required when role mappings are configured."
msgstr "ரோல் மேப்பிங் கட்டமைக்கப்படும் போது ரோல் எடர் தேவை."

#, i18next-interpolation
msgctxt "ffmpeg.inputs.rolesUnique"
msgid "Each role can only be assigned to one input stream."
msgstr ""
"ஒவ்வொரு பாத்திரத்தையும் ஒரு உள்ளீட்டு ச்ட்ரீமுக்கு மட்டுமே ஒதுக்க முடியும்."

#, i18next-interpolation
msgctxt "ffmpeg.inputs.detectRequired"
msgid "At least one input stream must be assigned the 'detect' role."
msgstr ""
"குறைந்தது ஒரு உள்ளீட்டு ச்ட்ரீமாவது 'கண்டறிதல்' பாத்திரத்தை ஒதுக்க வேண்டும்."

#, i18next-interpolation
msgctxt "ffmpeg.inputs.hwaccelDetectOnly"
msgid ""
"Only the input stream with the detect role can define hardware acceleration "
"arguments."
msgstr ""
"கண்டறிதல் பாத்திரத்துடன் உள்ளீடு ச்ட்ரீம் மட்டுமே வன்பொருள் முடுக்கம் "
"வாதங்களை வரையறுக்க முடியும்."

#, i18next-interpolation
msgctxt "detect.dimensionMustBeEven"
msgid "Must be an even number."
msgstr "இரட்டை எண்ணாக இருக்க வேண்டும்."
