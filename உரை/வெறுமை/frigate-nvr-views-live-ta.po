#, i18next-interpolation
msgctxt "manualRecording.title"
msgid "On-Demand"
msgstr "தேவைக்கேற்ப"

#, i18next-interpolation
msgctxt "manualRecording.tips"
msgid ""
"Download an instant snapshot or start a manual event based on this camera's "
"recording retention settings."
msgstr ""
"இந்த கேமராவின் ரெக்கார்டிங் தக்கவைப்பு அமைப்புகளின் அடிப்படையில் உடனடி "
"ச்னாப்சாட்டைப் பதிவிறக்கவும் அல்லது கைமுறை நிகழ்வைத் தொடங்கவும்."

#, i18next-interpolation
msgctxt "manualRecording.playInBackground.label"
msgid "Play in background"
msgstr "பின்னணியில் விளையாடு"

#, i18next-interpolation
msgctxt "manualRecording.playInBackground.desc"
msgid "Enable this option to continue streaming when the player is hidden."
msgstr ""
"பிளேயர் மறைக்கப்பட்டிருக்கும் போது ச்ட்ரீமிங்கைத் தொடர இந்த விருப்பத்தை "
"இயக்கவும்."

#, i18next-interpolation
msgctxt "manualRecording.showStats.label"
msgid "Show Stats"
msgstr "புள்ளிவிவரங்களைக் காட்டு"

#, i18next-interpolation
msgctxt "manualRecording.showStats.desc"
