msgctxt "noCameras.restricted.title"
msgid "No Cameras Available"
msgstr "கேமராக்கள் எதுவும் இல்லை"

#, i18next-interpolation
msgctxt "noCameras.restricted.description"
msgid "You don't have permission to view any cameras in this group."
msgstr ""
"இந்தக் குழுவில் உள்ள எந்த கேமராக்களையும் பார்க்க உங்களுக்கு இசைவு இல்லை."

#, i18next-interpolation
msgctxt "noCameras.default.title"
msgid "No Cameras Configured"
msgstr "கேமராக்கள் எதுவும் கட்டமைக்கப்படவில்லை"

#, i18next-interpolation
msgctxt "noCameras.default.description"
msgid "Get started by connecting a camera to Frigate."
msgstr "ஃப்ரிகேட்டுடன் கேமராவை இணைப்பதன் மூலம் தொடங்கவும்."

#, i18next-interpolation
msgctxt "noCameras.default.buttonText"
msgid "Add Camera"
msgstr "கேமராவைச் சேர்க்கவும்"

#, i18next-interpolation
msgctxt "noCameras.group.title"
msgid "No Cameras in Group"
msgstr "குழுவில் கேமராக்கள் இல்லை"

#, i18next-interpolation
msgctxt "noCameras.group.description"
msgid "This camera group has no assigned or enabled cameras."
msgstr "இந்த கேமரா குழுவில் ஒதுக்கப்பட்ட அல்லது இயக்கப்பட்ட கேமராக்கள் இல்லை."

#, i18next-interpolation
msgctxt "noCameras.group.buttonText"
msgid "Manage Groups"
msgstr "குழுக்களை நிர்வகிக்கவும்"
