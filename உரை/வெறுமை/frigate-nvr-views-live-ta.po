msgctxt "manualRecording.started"
msgid "Started manual on-demand recording."
msgstr "தேவைக்கேற்ப கைமுறையாகப் பதிவுசெய்யத் தொடங்கப்பட்டது."

#, i18next-interpolation
msgctxt "manualRecording.failedToStart"
msgid "Failed to start manual on-demand recording."
msgstr "தேவைக்கேற்ப கைமுறையாகப் பதிவுசெய்யத் தொடங்க முடியவில்லை."

#, i18next-interpolation
msgctxt "manualRecording.recordDisabledTips"
msgid ""
"Since recording is disabled or restricted in the config for this camera, "
"only a snapshot will be saved."
msgstr ""
"இந்தக் கேமராவிற்கான கட்டமைப்பில் பதிவு முடக்கப்பட்டிருப்பதால் அல்லது "
"கட்டுப்படுத்தப்பட்டிருப்பதால், ஒரு ச்னாப்சாட் மட்டுமே சேமிக்கப்படும்."

#, i18next-interpolation
msgctxt "manualRecording.end"
msgid "End on-demand recording"
msgstr "தேவைக்கேற்ப பதிவை முடிக்கவும்"

#, i18next-interpolation
msgctxt "manualRecording.ended"
