#: title.txt:1
#, max-length:30, read-only
msgctxt "title.txt:1"
msgid "Fediplan"
msgstr "ஃபெடிபிளான்"

#: short_description.txt:1
#, max-length:80
msgctxt "short_description.txt:1"
msgid "Schedule your messages on Mastodon/Pleroma"
msgstr "Mastodon/Pleroma இல் உங்கள் செய்திகளை திட்டமிடுங்கள்"

#: full_description.txt:1
#, max-length:4000
msgctxt "full_description.txt:1"
msgid ""
"Fediplan allows to schedule your messages on Mastodon and Pleroma. It "
"supports multiple accounts."
msgstr ""
"Fediplan உங்கள் செய்திகளை Mastodon மற்றும் Pleroma இல் திட்டமிட "
"அனுமதிக்கிறது. இது பல கணக்குகளை ஆதரிக்கிறது."
