msgid "Debug Replay"
msgstr ""

#, i18next-interpolation
msgctxt "description"
msgid ""
"Replay camera recordings for debugging. The object list shows a time-delayed "
"summary of detected objects and the Messages tab shows a stream of Frigate's "
"internal messages from the replay footage."
msgstr ""

