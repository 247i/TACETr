msgstr "ONVIF துறைமுகம்"

msgctxt "onvif.port.description"
msgid "Port number for the ONVIF service."
msgstr "துறைமுகம் எண் க்கு the ONVIF service."

msgctxt "onvif.user.label"
msgid "ONVIF username"
msgstr "ONVIF username"

msgctxt "onvif.user.description"
