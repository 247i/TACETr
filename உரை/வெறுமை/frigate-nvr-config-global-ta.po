msgctxt "onvif.label"
msgid "ONVIF"
msgstr "ONVIF"

msgctxt "onvif.description"
msgid "ONVIF connection and PTZ autotracking settings for this camera."
msgstr "ONVIF connection and PTZ autotracking அமைப்புகள் க்கு this camera."

msgctxt "onvif.host.label"
