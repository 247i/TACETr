msgctxt "onvif.password.label"
msgid "ONVIF password"
msgstr "ONVIF password"

msgctxt "onvif.password.description"
msgid "Password for ONVIF authentication."
msgstr "Password க்கு ONVIF authentication."

msgctxt "onvif.tls_insecure.label"
msgid "Disable TLS verify"
msgstr "முடக்கு TLS verify"

msgctxt "onvif.tls_insecure.description"
msgid ""
"Skip TLS verification and disable digest auth for ONVIF (unsafe; use in safe"
" networks only)."
msgstr ""
"தவிர் TLS verification and முடக்கு digest auth க்கு ONVIF (unsafe; use in "
"safe networks only)."

msgctxt "onvif.profile.label"
msgid "ONVIF profile"
msgstr "ONVIF சுயவிவரம்"

msgctxt "onvif.profile.description"
msgid ""
"Specific ONVIF media profile to use for PTZ control, matched by token or "
"name. If not set, the first profile with valid PTZ configuration is selected"
" automatically."
msgstr ""
"Specific ONVIF ஊடகம் சுயவிவரம் பெறுநர் use க்கு PTZ control, matched by "
"கிள்ளாக்கு or name. If not set, the first சுயவிவரம் with valid PTZ உள்ளமைவு "
"is தேர்ந்தெடுக்கப்பட்டது automatically."

msgctxt "onvif.autotracking.label"
msgid "Autotracking"
msgstr "Autotracking"

msgctxt "onvif.autotracking.description"
msgid ""
"Automatically track moving objects and keep them centered in the frame using"
" PTZ camera movements."
msgstr ""
"Automatically மின்தடம் moving objects and keep them centered in the frame "
"using PTZ camera movements."

msgctxt "onvif.autotracking.enabled.label"
msgid "Enable Autotracking"
msgstr "Enable Autotracking"

msgctxt "onvif.autotracking.enabled.description"
msgid "Enable or disable automatic PTZ camera tracking of detected objects."
msgstr "Enable or முடக்கு automatic PTZ camera tracking of detected objects."

msgctxt "onvif.autotracking.calibrate_on_startup.label"
msgid "Calibrate on start"
msgstr "Calibrate on தொடங்கு"

msgctxt "onvif.autotracking.calibrate_on_startup.description"
msgid ""
"Measure PTZ motor speeds on startup to improve tracking accuracy. Frigate "
"will update config with movement_weights after calibration."
msgstr ""
"Measure PTZ மின்னோடி speeds on தொடங்கு பெறுநர் improve tracking accuracy. "
"Frigate will புதுப்பிப்பு கட்டமைப்பு with movement_weights after "
"calibration."

msgctxt "onvif.autotracking.zooming.label"
msgid "Zoom mode"
msgstr "Zoom பயன்முறை"

msgctxt "onvif.autotracking.zooming.description"
msgid ""
"Control zoom behavior: disabled (pan/tilt only), absolute (most compatible),"
" or relative (concurrent pan/tilt/zoom)."
msgstr ""
"Control zoom behavior: முடக்கப்பட்டது (pan/tilt only), தனி, சார்பிலா (most "
"compatible), or relative (concurrent pan/tilt/zoom)."

msgctxt "onvif.autotracking.zoom_factor.label"
msgid "Zoom factor"
msgstr "Zoom factor"

msgctxt "onvif.autotracking.zoom_factor.description"
msgid ""
"Control zoom level on tracked objects. Lower values keep more scene in view;"
" higher values zoom in closer but may lose tracking. Values between 0.1 and "
"0.75."
msgstr ""
"Control zoom நிலை on tracked objects. Lower values keep more scene in view; "
"higher values zoom in closer but சி-வைகாசி lose tracking. Values between 0.1"
" and 0.75."

msgctxt "onvif.autotracking.track.label"
msgid "Tracked objects"
msgstr "Tracked objects"

msgctxt "onvif.autotracking.track.description"
msgid "List of object types that should trigger autotracking."
msgstr "பட்டியல் of பொருள் வகைகள் that should trigger autotracking."

msgctxt "onvif.autotracking.required_zones.label"
msgid "Required zones"
msgstr "Required zones"

msgctxt "onvif.autotracking.required_zones.description"
msgid "Objects must enter one of these zones before autotracking begins."
msgstr "Objects must enter one of these zones before autotracking begins."

msgctxt "onvif.autotracking.return_preset.label"
msgid "Return preset"
msgstr "Return preset"

msgctxt "onvif.autotracking.return_preset.description"
msgid ""
"ONVIF preset name configured in camera firmware to return to after tracking "
"ends."
msgstr ""
"ONVIF preset பெயர் configured in camera firmware பெறுநர் return பெறுநர் "
"after tracking ends."

msgctxt "onvif.autotracking.timeout.label"
msgid "Return timeout"
msgstr "Return timeout"

msgctxt "onvif.autotracking.timeout.description"
msgid ""
"Wait this many seconds after losing tracking before returning camera to "
"preset position."
msgstr ""
"Wait this many நொடிகள் after losing tracking before returning camera பெறுநர்"
" preset position."

msgctxt "onvif.autotracking.movement_weights.label"
msgid "Movement weights"
msgstr "Movement weights"

msgctxt "onvif.autotracking.movement_weights.description"
msgid ""
"Calibration values automatically generated by camera calibration. Do not "
"modify manually."
msgstr ""
"Calibration values automatically generated by camera calibration. Do not "
"modify manually."

msgctxt "onvif.autotracking.enabled_in_config.label"
msgid "Original autotrack state"
msgstr "Original autotrack state"

msgctxt "onvif.autotracking.enabled_in_config.description"
msgid ""
"Internal field to track whether autotracking was enabled in configuration."
msgstr ""
"Internal புலம் பெறுநர் மின்தடம் whether autotracking was இயக்கப்பட்டது in "
"configuration."

msgctxt "onvif.ignore_time_mismatch.label"
msgid "Ignore time mismatch"
msgstr "Ignore time mismatch"

msgctxt "onvif.ignore_time_mismatch.description"
msgid ""
"Ignore time synchronization differences between camera and Frigate server "
"for ONVIF communication."
msgstr ""
"Ignore time ஒத்தியக்கம் differences between camera and Frigate சேவையகம் க்கு"
" ONVIF communication."
