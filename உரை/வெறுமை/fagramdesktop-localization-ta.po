msgid "Show Status Dot on Avatars"
msgstr "காட்டு நிலை Dot on Avatars"

msgctxt "fa_status_dot_online_only"
msgid "Show Only Online Status"
msgstr "காட்டு Only Online நிலை"

msgctxt "fa_status_dot_desc"
msgid "Show online, offline, and blocked status dots on avatars"
msgstr "காட்டு online, offline, and blocked நிலை dots on avatars"

msgctxt "fa_restarting_in_seconds"
msgid "Restarting in 3 seconds..."
msgstr "Restarting in 3 seconds..."

msgctxt "fa_context_menu"
msgid "Context Menu"
msgstr "Context பட்டியல்"

msgctxt "fa_context_menu_settings"
msgid "Use Shortcut Icons"
msgstr "Use குறுக்குவழி Icons"

