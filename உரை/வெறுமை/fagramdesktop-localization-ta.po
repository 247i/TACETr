msgstr "காட்டு quick forward விருப்பங்கள் in context பட்டியல்"

msgctxt "fa_forward_with_author"
msgid "Forward with Author"
msgstr "Forward with நூலாசிரியர்"

msgctxt "fa_forward_as_copy"
msgid "Forward as Copy"
msgstr "Forward அச் நகலெடு"

msgctxt "fa_forward_without_caption"
msgid "Forward without Captions"
msgstr "Forward without Captions"

msgctxt "fa_forward_to_saved"
