msgctxt "fa_pack_owner"
msgid "Pack Owner"
msgstr "Pack உரிமையாளர்"

msgctxt "fa_hide_blocked_user_messages"
msgid "Hide Blocked User Messages"
msgstr "மறை Blocked பயனர் செய்திகள்"

msgctxt "fa_hide_blocked_user_messages_desc"
msgid "Hide messages from blocked users under spoilers"
msgstr "மறை செய்திகள் இருந்து blocked பயனர்கள் under spoilers"

