msgid "Configure quick action shortcuts in context menus"
msgstr "Configure quick செயல் shortcuts in context menus"

msgctxt "fa_context_menu_forward_submenu"
msgid "Forward Menu Options"
msgstr "Forward பட்டியல் விருப்பங்கள்"

msgctxt "fa_context_menu_forward_submenu_desc"
