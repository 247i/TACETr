msgctxt "fa_client_preferences"
msgid "FAgram Preferences"
msgstr "FAgram விருப்பத்தேர்வுகள்"

msgctxt "fa_copy_id"
msgid "Copy ID"
msgstr "அடையாலத்தை நகல்"

msgctxt "fa_id_copied"
msgid "ID copied"
msgstr "அடையாளம் நகலெடுக்கப்பட்டது"

msgctxt "fa_copy_registration_date"
msgid "Copy Registration Date"
msgstr "நகல் பதிவு தேதி"

msgctxt "fa_copy_callback_data"
msgid "Copy Callback Data"
msgstr "திரும்ப அழைக்கும் தரவை நகலெடுக்கவும்"

msgctxt "fa_registration_date"
msgid "Registration Date"
msgstr "பதிவு தேதி"

msgctxt "fa_not_found"
msgid "Not found."
msgstr "காணப்படவில்லை."

msgctxt "fa_categories"
msgid "Categories"
msgstr "வகைகள்"

msgctxt "fa_general"
msgid "General"
msgstr "பொது"

msgctxt "fa_show_seconds_message"
msgid "Show Seconds in Messages"
msgstr "செய்திகளில் நொடிகளைக் காட்டு"

msgctxt "fa_show_seconds_message_desc"
msgid "Show seconds in message timestamps"
msgstr "செய்தி நேர முத்திரைகளில் வினாடிகளைக் காட்டு"

msgctxt "fa_disable_ads"
msgid "Disable Ads"
msgstr "விளம்பரங்களை முடக்கு"

msgctxt "fa_disable_ads_desc"
msgid "Hide sponsored messages and ads"
msgstr "ஒப்புரவாளர் செய்யப்பட்ட செய்திகள் மற்றும் விளம்பரங்களை மறை"

msgctxt "fa_disable_ai"
msgid "Disable AI Features"
msgstr "AI அம்சங்களை முடக்கு"

msgctxt "fa_disable_ai_desc"
msgid "Hide AI text editor and summaries"
msgstr "AI உரை திருத்தி மற்றும் சுருக்கங்களை மறை"

msgctxt "fa_disable_auto_download"
msgid "Disable Auto-Download"
msgstr "தானியங்கு பதிவிறக்கத்தை முடக்கு"

msgctxt "fa_disable_auto_download_desc"
msgid "Turn off auto-download for media and stickers"
msgstr "மீடியா மற்றும் ச்டிக்கர்களுக்கான தானியங்கு பதிவிறக்கத்தை முடக்கவும்"

msgctxt "fa_disable_animated_avatars"
msgid "Disable Animated Avatars"
msgstr "அனிமேசன் அவதாரங்களை முடக்கு"

msgctxt "fa_disable_animated_avatars_desc"
msgid "Disable animated profile pictures"
msgstr "அனிமேசன் செய்யப்பட்ட சுயவிவரப் படங்களை முடக்கு"

msgctxt "fa_disable_premium_animation"
msgid "Disable Premium Animations"
msgstr "காப்பீடு அனிமேசன்களை முடக்கு"

msgctxt "fa_disable_premium_animation_desc"
msgid "Disable animations for Premium users"
msgstr "காப்பீடு பயனர்களுக்கு அனிமேசன்களை முடக்கு"

msgctxt "fa_show_start_token"
msgid "Show Bot Start Token"
msgstr "பாட் ச்டார்ட் டோக்கனைக் காட்டு"

msgctxt "fa_show_start_token_desc"
msgid "Show start parameter tokens in bots"
msgstr "தொடக்க அளவுரு டோக்கன்களை போட்களில் காட்டு"

msgctxt "fa_show_peer_ids"
msgid "Show Peer IDs"
msgstr "பியர் ஐடிகளைக் காட்டு"

msgctxt "fa_show_peer_ids_desc"
msgid "Show IDs in profiles"
msgstr "சுயவிவரங்களில் ஐடிகளைக் காட்டு"

msgctxt "fa_show_dc_ids"
msgid "Show DC IDs"
msgstr "நேர்மின்னழுத்தம் ஐடிகளைக் காட்டு"

msgctxt "fa_show_dc_ids_desc"
msgid "Show datacenter ID next to peer IDs"
msgstr "பியர் ஐடிகளுக்கு அடுத்ததாக டேட்டாசென்டர் ஐடியைக் காட்டு"

msgctxt "fa_id_in_botapi_type"
msgid "Bot API ID Format"
msgstr "பாட் பநிஇ அடையாளம் வடிவம்"

msgctxt "fa_id_in_botapi_type_desc"
msgid "Display IDs in Bot API format"
msgstr "Bot பநிஇ வடிவமைப்பில் ஐடிகளைக் காண்பி"

msgctxt "fa_show_registration_date"
msgid "Show Registration Date"
msgstr "பதிவு தேதியைக் காட்டு"

msgctxt "fa_show_registration_date_desc"
msgid "Show registration date in profiles"
msgstr "சுயவிவரங்களில் பதிவு தேதியைக் காட்டு"

msgctxt "fa_screenshot_mode"
msgid "Screenshot Mode"
msgstr "திரைக்காட்சி பயன்முறை"

msgctxt "fa_screenshot_mode_desc"
msgid "Randomize names, avatars, and text for privacy"
msgstr "தனியுரிமைக்காக பெயர்கள், அவதாரங்கள் மற்றும் உரையை சீரமைக்கவும்"

msgctxt "fa_hide_stories"
msgid "Hide Stories"
msgstr "கதைகளை மறை"

msgctxt "fa_hide_stories_desc"
msgid "Hide stories in the chat list"
msgstr "அரட்டைப் பட்டியலில் கதைகளை மறை"

msgctxt "fa_local_tg_premium"
msgid "Local Telegram Premium"
msgstr "உள்ளக டெலிகிராம் காப்பீடு"

msgctxt "fa_local_tg_premium_desc"
msgid "Enable visual Premium features locally"
msgstr "காட்சி காப்பீடு அம்சங்களை உள்நாட்டில் இயக்கவும்"

#, ignore-reused, ignore-same
msgctxt "fa_chats"
msgid "Chats"
msgstr "அரட்டைகள்"

msgctxt "fa_parse_markdown_hyperlink"
msgid "Parse Markdown Hyperlinks"
msgstr "மார்க் பேரூர் ஐப்பர்லிங்க்களை அலசவும்"

msgctxt "fa_parse_markdown_hyperlink_desc"
msgid "Convert [text](URL) into clickable links"
msgstr "[text](URL)ஐ சொடுக்கு செய்யக்கூடிய இணைப்புகளாக மாற்றவும்"

msgctxt "fa_disable_custom_chat_background"
msgid "β Hide Custom Chat Backgrounds"
msgstr "β தனிப்பயன் அரட்டை பின்னணிகளை மறை"

msgctxt "fa_disable_custom_chat_background_desc"
msgid "Ignore custom backgrounds set by chats"
msgstr "அரட்டைகள் மூலம் அமைக்கப்பட்ட தனிப்பயன் பின்னணியைப் புறக்கணிக்கவும்"

msgctxt "fa_hide_open_webapp_button_chatlist"
msgid "Hide Web App Button"
msgstr "இணைய ஆப் பட்டனை மறை"

msgctxt "fa_hide_open_webapp_button_chatlist_desc"
msgid "Hide Web App buttons in the chat list"
msgstr "அரட்டை பட்டியலில் விரலிடைத் தோல் பயன்பாடு பட்டன்களை மறை"

msgctxt "fa_hide_all_chats_folder"
msgid "Hide \"All Chats\" Folder"
msgstr "\"அனைத்து அரட்டைகள்\" கோப்புறையை மறைக்கவும்"

msgctxt "fa_hide_all_chats_folder_desc"
msgid "Hide the \"All Chats\" tab from folder list"
msgstr "கோப்புறை பட்டியலில் இருந்து \"அனைத்து அரட்டைகள்\" தாவலை மறைக்கவும்"

msgctxt "fa_show_discuss_button"
msgid "Show Discuss Button"
msgstr "கலந்துரையாடல் பொத்தானைக் காட்டு"

msgctxt "fa_show_discuss_button_desc"
msgid "Add a button in channels to jump to discussion"
msgstr "விவாதத்திற்குச் செல்ல சேனல்களில் பட்டனைச் சேர்க்கவும்"

msgctxt "fa_show_message_details"
msgid "Show Message Details"
msgstr "செய்தி விவரங்களைக் காட்டு"

msgctxt "fa_show_message_details_desc"
msgid "Show technical details and metadata for messages"
msgstr "செய்திகளுக்கான தொழில்நுட்ப விவரங்கள் மற்றும் மெட்டாடேட்டாவைக் காட்டு"

msgctxt "fa_add_comma_after_mention"
msgid "Add Comma After Mention"
msgstr "குறிப்பிட்ட பிறகு கமாவைச் சேர்க்கவும்"

msgctxt "fa_add_comma_after_mention_desc"
msgid "Insert a comma after mentioning a user"
msgstr "பயனரைக் குறிப்பிட்ட பிறகு காற்புள்ளியைச் செருகவும்"

msgctxt "fa_delete_for_everyone"
msgid "Delete for Everyone by Default"
msgstr "இயல்பாகவே அனைவருக்கும் நீக்கு"

msgctxt "fa_delete_for_everyone_desc"
msgid "Pre-select \"Delete for everyone\" when deleting messages"
msgstr ""
"செய்திகளை நீக்கும் போது \"அனைவருக்கும் நீக்கு\" என்பதை முன்கூட்டியே "
"தேர்ந்தெடுக்கவும்"

msgctxt "fa_last_seen_timestamp"
msgid "Exact Offline Timestamp"
msgstr "சரியான இணைப்பில்லாத நேர முத்திரை"

msgctxt "fa_last_seen_timestamp_desc"
msgid "Show exact date and time after 1 hour offline"
msgstr ""
"ஆஃப்லைனில் 1 மணிநேரத்திற்குப் பிறகு சரியான தேதி மற்றும் நேரத்தைக் காட்டு"

msgctxt "fa_show_forwarded_date_in_title"
msgid "Show Forwarded Message Date"
msgstr "அனுப்பப்பட்ட செய்தி தேதியைக் காட்டு"

msgctxt "fa_show_forwarded_date_in_title_desc"
msgid "Show original date and time in forwarded headers"
msgstr "முன்னனுப்பப்பட்ட தலைப்புகளில் அசல் தேதி மற்றும் நேரத்தைக் காட்டு"

msgctxt "fa_disable_greeting_sticker"
msgid "Disable Greeting Stickers"
msgstr "வாழ்த்து ச்டிக்கர்களை முடக்கு"

msgctxt "fa_disable_greeting_sticker_desc"
msgid "Hide greeting stickers in new private chats"
msgstr "புதிய தனிப்பட்ட அரட்டைகளில் வாழ்த்து ச்டிக்கர்களை மறைக்கவும்"

msgctxt "fa_appearance"
msgid "Appearance"
msgstr "தோற்றம்"

msgctxt "fa_rounding"
msgid "Rounding: %1"
msgstr "ரவுண்டிங்:% 1"

msgctxt "fa_use_default_rounding"
msgid "Use Default Rounding"
msgstr "இயல்புநிலை ரவுண்டிங்கைப் பயன்படுத்தவும்"

msgctxt "fa_use_default_rounding_desc"
msgid "Reset avatar roundness to default"
msgstr "அவதார் முழுமையை இயல்புநிலைக்கு மீட்டமைக்கவும்"

msgctxt "fa_force_snow"
msgid "Force Snow"
msgstr "படை பனி"

msgctxt "fa_force_snow_desc"
msgid "Enable snow effect year-round"
msgstr "ஆண்டு முழுவதும் பனி விளைவை இயக்கவும்"

msgctxt "fa_restart_client"
msgid "Restart FAgram"
msgstr "FAgram ஐ மறுதொடக்கம் செய்யுங்கள்"

msgctxt "fa_quit_client"
msgid "Quit FAgram"
msgstr "ஃபாகிராமிலிருந்து வெளியேறு"

msgctxt "fa_debug_logs"
