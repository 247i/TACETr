#, i18next-interpolation
msgctxt "noRecordingsFoundForThisTime"
msgid "No recordings found for this time"
msgstr "இந்த நேரத்தில் பதிவுகள் எதுவும் இல்லை"

#, i18next-interpolation
msgctxt "noPreviewFound"
msgid "No Preview Found"
msgstr "முன்னோட்டம் எதுவும் இல்லை"

#, i18next-interpolation
msgctxt "noPreviewFoundFor"
msgid "No Preview Found for {{cameraName}}"
msgstr "{{cameraName}}க்கான முன்னோட்டம் எதுவும் இல்லை"

#, i18next-interpolation
msgctxt "submitFrigatePlus.title"
msgid "Submit this frame to Frigate+?"
msgstr "இந்த சட்டகத்தை Frigate+ க்கு சமர்ப்பிக்கவா?"

#, i18next-interpolation
msgctxt "submitFrigatePlus.submit"
msgid "Submit"
msgstr "சமர்ப்பிக்கவும்"

#, i18next-interpolation
msgctxt "submitFrigatePlus.previewError"
msgid ""
"Could not load snapshot preview. The recording may not be available at this "
"time."
msgstr ""
"ச்னாப்சாட் மாதிரிக்காட்சியை ஏற்ற முடியவில்லை. இந்த நேரத்தில் பதிவு "
"கிடைக்காமல் போகலாம்."

#, i18next-interpolation
msgctxt "livePlayerRequiredIOSVersion"
msgid "iOS 17.1 or greater is required for this live stream type."
msgstr ""
"இந்த லைவ் ச்ட்ரீம் வகைக்கு ஐஇமு 17.1 அல்லது அதற்கு மேற்பட்ட பதிப்புகள் தேவை."

#, i18next-interpolation
msgctxt "streamOffline.title"
msgid "Stream Offline"
msgstr "ஆஃப்லைனில் ச்ட்ரீம் செய்யவும்"

#, i18next-interpolation
msgctxt "streamOffline.desc"
msgid ""
"No frames have been received on the {{cameraName}} <code>detect</code> "
"stream, check error logs"
msgstr ""
"{{cameraName}} <code>dentect</code> ச்ட்ரீமில் ஃப்ரேம்கள் எதுவும் "
"பெறப்படவில்லை, பிழைப் பதிவுகளைச் சரிபார்க்கவும்"

#, i18next-interpolation
msgctxt "cameraOff"
msgid "Camera is off"
msgstr "கேமரா ஆஃப் செய்யப்பட்டுள்ளது"

