msgctxt "form.user"
msgid "Username"
msgstr "பயனர் பெயர்"

msgctxt "form.password"
msgid "Password"
msgstr "கடவுச்சொல்"

msgctxt "form.login"
msgid "Login"
msgstr "புகுபதிவு"

msgctxt "form.firstTimeLogin"
msgid ""
"Trying to log in for the first time? Credentials are printed in the Frigate "
"logs."
msgstr ""
"முதல் முறையாக உள்நுழைய முயற்சிக்கிறீர்களா? நற்சான்றிதழ்கள் ஃப்ரிகேட் "
"பதிவுகளில் அச்சிடப்பட்டுள்ளன."

msgctxt "form.errors.usernameRequired"
msgid "Username is required"
msgstr "பயனர் பெயர் தேவை"

msgctxt "form.errors.passwordRequired"
msgid "Password is required"
msgstr "கடவுச்சொல் தேவை"

msgctxt "form.errors.rateLimit"
msgid "Exceeded rate limit. Try again later."
msgstr "விகித வரம்பை மீறியது. பிறகு முயற்சிக்கவும்."

msgctxt "form.errors.loginFailed"
msgid "Login failed"
msgstr "உள்நுழைவு தோல்வியடைந்தது"

msgctxt "form.errors.unknownError"
msgid "Unknown error. Check logs."
msgstr "அறியப்படாத பிழை. பதிவுகளை சரிபார்க்கவும்."

msgctxt "form.errors.webUnknownError"
msgid "Unknown error. Check console logs."
msgstr "அறியப்படாத பிழை. கன்சோல் பதிவுகளை சரிபார்க்கவும்."
