msgid "Use This Range"
msgstr "இந்த வரம்பை பயன்படுத்தவும்"

#, i18next-interpolation
msgctxt "streaming.label"
msgid "Stream"
msgstr "ச்ட்ரீம்"

#, i18next-interpolation
msgctxt "streaming.restreaming.disabled"
msgid "Restreaming is not enabled for this camera."
msgstr "இந்தக் கேமராவில் ரீச்ட்ரீமிங் இயக்கப்படவில்லை."

#, i18next-interpolation
msgctxt "streaming.restreaming.desc.title"
msgid ""
"Set up go2rtc for additional live view options and audio for this camera."
msgstr ""
"இந்தக் கேமராவிற்கான கூடுதல் நேரலைக் காட்சி விருப்பங்களுக்கும் ஆடியோவிற்கும் "
"go2rtcஐ அமைக்கவும்."

#, i18next-interpolation
msgctxt "streaming.showStats.label"
msgid "Show stream stats"
msgstr "ச்ட்ரீம் புள்ளிவிவரங்களைக் காட்டு"

#, i18next-interpolation
msgctxt "streaming.showStats.desc"
msgid ""
"Enable this option to show stream statistics as an overlay on the camera "
"feed."
msgstr ""
"கேமரா ஊட்டத்தில் ச்ட்ரீம் புள்ளிவிவரங்களை மேலடுக்காகக் காட்ட இந்த "
"விருப்பத்தை இயக்கவும்."

#, i18next-interpolation
msgctxt "streaming.debugView"
msgid "Debug View"
msgstr "பிழைத்திருத்தக் காட்சி"

#, i18next-interpolation
msgctxt "search.saveSearch.label"
msgid "Save Search"
msgstr "தேடலைச் சேமிக்கவும்"

#, i18next-interpolation
msgctxt "search.saveSearch.desc"
msgid "Provide a name for this saved search."
msgstr "இந்த சேமிக்கப்பட்ட தேடலுக்கு ஒரு பெயரை வழங்கவும்."

#, i18next-interpolation
msgctxt "search.saveSearch.placeholder"
msgid "Enter a name for your search"
msgstr "உங்கள் தேடலுக்கு ஒரு பெயரை உள்ளிடவும்"

#, i18next-interpolation
msgctxt "search.saveSearch.overwrite"
msgid ""
"{{searchName}} already exists. Saving will overwrite the existing value."
msgstr ""
"{{searchName}} ஏற்கனவே உள்ளது. சேமிப்பது ஏற்கனவே உள்ள மதிப்பை மேலெழுதும்."

#, i18next-interpolation
msgctxt "search.saveSearch.success"
msgid "Search ({{searchName}}) has been saved."
msgstr "தேடல் ({{searchName}}) சேமிக்கப்பட்டது."

#, i18next-interpolation
msgctxt "search.saveSearch.button.save.label"
msgid "Save this search"
msgstr "இந்தத் தேடலைச் சேமிக்கவும்"

#, i18next-interpolation
msgctxt "recording.shareTimestamp.label"
msgid "Share Timestamp"
msgstr "நேர முத்திரையைப் பகிரவும்"

#, i18next-interpolation
msgctxt "recording.shareTimestamp.title"
msgid "Share Timestamp"
msgstr "நேர முத்திரையைப் பகிரவும்"

#, i18next-interpolation
msgctxt "recording.shareTimestamp.description"
msgid ""
"Share a timestamped URL of current player position or choose a custom "
"timestamp. Note that this is not a public share URL and is only accessible "
"to users with access to Frigate and this camera."
msgstr ""
"தற்போதைய பிளேயர் நிலையின் நேரமுத்திரையிடப்பட்ட URLஐப் பகிரவும் அல்லது "
"தனிப்பயன் நேர முத்திரையைத் தேர்வு செய்யவும். இது பொதுப் பகிர்வு முகவரி அல்ல,"
" Frigate மற்றும் இந்தக் கேமராவை அணுகக்கூடிய பயனர்கள் மட்டுமே அணுக முடியும் "
"என்பதை நினைவில் கொள்ளவும்."

#, i18next-interpolation
msgctxt "recording.shareTimestamp.custom"
msgid "Custom Timestamp"
msgstr "தனிப்பயன் Timestamp"

#, i18next-interpolation
msgctxt "recording.shareTimestamp.button"
msgid "Share Timestamp URL"
msgstr "பங்கு Timestamp முகவரி"

#, i18next-interpolation
msgctxt "recording.shareTimestamp.shareTitle"
msgid "Frigate Review Timestamp: {{camera}}"
msgstr "Frigate சீராய்வு Timestamp: {{camera}}"

#, i18next-interpolation
msgctxt "recording.confirmDelete.title"
msgid "Confirm Delete"
msgstr "உறுதிப்படுத்தவும் நீக்கு"

#, i18next-interpolation
msgctxt "recording.confirmDelete.desc.selected"
msgid ""
"Are you sure you want to delete all recorded video associated with this "
"review item?<br /><br />Hold the <em>Shift</em> key to bypass this dialog in"
" the future."
msgstr ""
"அரே you sure you want பெறுநர் நீக்கு அனைத்தும் recorded ஒளிதோற்றம் "
"associated with this சீராய்வு item?<br /><br />Hold the <em>Shift</em> key "
"பெறுநர் bypass this dialog in the future."

#, i18next-interpolation
msgctxt "recording.confirmDelete.toast.success"
msgid ""
"Video footage associated with the selected review items has been deleted "
"successfully."
msgstr ""
"ஒளிதோற்றம் footage associated with the தேர்ந்தெடுக்கப்பட்டது சீராய்வு items "
"has been deleted successfully."

#, i18next-interpolation
msgctxt "recording.confirmDelete.toast.error"
msgid "Failed to delete: {{error}}"
msgstr "Failed பெறுநர் delete: {{error}}"

