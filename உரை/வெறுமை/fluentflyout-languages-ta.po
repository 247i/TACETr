msgstr "ச்க்ரோலிங் இயக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetScrollingTextDescription"
msgid "Automatically scroll long text that doesn't fit"
msgstr "பொருந்தாத நீண்ட உரையைத் தானாக உருட்டும்"

# Suggested in Weblate: தொடர்ச்சியான ச்க்ரோலிங்
#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetScrollingTextLoopForeverTitle"
msgid "Continuous Scrolling"
msgstr "தொடர்ச்சியான ச்க்ரோலிங்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetScrollingTextLoopForeverDescription"
msgid ""
"Infinitely loop the text in one direction instead of scrolling back and "
"forth."
msgstr ""
"முன்னும் பின்னுமாக ச்க்ரோலிங் செய்வதற்குப் பதிலாக ஒரு திசையில் உரையை "
"எல்லையற்ற முறையில் சுழற்றுங்கள்."

# Suggested in Weblate: உருள் விரைவு
#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetScrollingTextSpeedTitle"
msgid "Scroll Speed"
msgstr "உருள் விரைவு"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetScrollingTextSpeedDescription"
msgid "Speed at which the text scrolls (pixels/second). Default is 20."
msgstr "உரை உருட்டும் விரைவு (பிக்சல்கள்/வினாடி). இயல்புநிலை 20 ஆகும்."

#, c-sharp-format, check-glossary
msgctxt "VolumeFlyoutTitle"
msgid "Volume Flyout"
msgstr "வால்யூம் ஃப்ளைஅவுட்"

#, c-sharp-format, check-glossary
msgctxt "VolumeFlyoutDescription"
msgid ""
"A standalone volume control flyout that expands into a volume mixer, "
"replacing the default Windows volume interface."
msgstr ""
"ஒரு முழுமையான வால்யூம் கண்ட்ரோல் ஃப்ளைஅவுட், இது வால்யூம் மிக்சராக "
"விரிவடைந்து, இயல்புநிலை சாளரங்கள் வால்யூம் இடைமுகத்தை மாற்றுகிறது."

#, c-sharp-format, check-glossary
msgctxt "EnableVolumeFlyoutTitle"
msgid "Enable Volume Flyout"
msgstr "வால்யூம் ஃப்ளைஅவுட்டை இயக்கு"

#, c-sharp-format, check-glossary
msgctxt "EnableVolumeFlyoutDescription"
msgid "Replace the default Windows volume flyout"
msgstr "இயல்புநிலை சாளரங்கள் வால்யூம் ஃப்ளைஅவுட்டை மாற்றவும்"

#, c-sharp-format, check-glossary
msgctxt "VolumeAboveMediaFlyoutTitle"
msgid "Position Volume Flyout above Media Flyout"
msgstr "மீடியா ஃப்ளைஅவுட்டிற்கு மேலே உள்ள வால்யூம் ஃப்ளைஅவுட்"

# Suggested in Weblate: ஃப்ளையவுட் நீடிப்பு நேரம்
#, c-sharp-format, check-glossary
msgctxt "VolumeFlyoutStayDurationTitle"
msgid "Volume Flyout Stay Duration"
msgstr "வால்யூம் ஃப்ளைஅவுட் தங்கும் காலம்"

# Suggested in Weblate: தொகுதி மிக்சர்
