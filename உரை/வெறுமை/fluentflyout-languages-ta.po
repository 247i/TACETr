msgctxt "VolumeMixerSectionTitle"
msgid "Volume Mixer"
msgstr "தொகுதி கலவை"

#, c-sharp-format, check-glossary
msgctxt "EnableVolumeMixerTitle"
msgid "Enable Volume Mixer"
msgstr ""

#, c-sharp-format, check-glossary
msgctxt "EnableVolumeMixerDescription"
msgid "Fine control over individual app volumes"
msgstr "தனிப்பட்ட பயன்பாட்டு தொகுதிகளின் மீது சிறந்த கட்டுப்பாடு"

#, c-sharp-format, check-glossary
msgctxt "VolumeMixerHighlightTitle"
msgid "Highlight apps playing audio"
msgstr "ஆடியோவை இயக்கும் பயன்பாடுகளை முன்னிலைப்படுத்தவும்"

#, c-sharp-format, check-glossary
msgctxt "VolumeMixerHighlightDescription"
msgid "See which apps are currently outputting audio"
msgstr "தற்போது எந்தெந்த ஆப்ச் ஆடியோவை வெளியிடுகிறது என்பதைப் பார்க்கவும்"

#, c-sharp-format, check-glossary
msgctxt "MasterVolumeText"
msgid "Master volume"
msgstr "முதன்மை ஒலி அளவு"
