#, c-sharp-format, check-glossary
msgctxt "TitleText"
msgid "FluentFlyout Settings"
msgstr "FluentFlyout அமைப்புகள்"

# Suggested in Weblate: வீடு
#, c-sharp-format, check-glossary
msgctxt "HomeTitle"
msgid "Home"
msgstr "முகப்பு"

# Suggested in Weblate: இயக்கப்பட்டது
#, c-sharp-format, check-glossary
msgctxt "Enabled"
msgid "Enabled"
msgstr "செயலில் உள்ளது"

# Suggested in Weblate: முடக்கப்பட்டது
#, c-sharp-format, check-glossary
msgctxt "Disabled"
msgid "Disabled"
msgstr "செயலில் இல்லை"

# Suggested in Weblate: பின்
#, c-sharp-format, check-glossary
msgctxt "Back"
msgid "Back"
msgstr "பின்"

# Suggested in Weblate: அடுத்தது
#, c-sharp-format, check-glossary
msgctxt "Next"
msgid "Next"
msgstr "அடுத்தது"

# Suggested in Weblate: முடிக்க
#, c-sharp-format, check-glossary
msgctxt "Finish"
msgid "Finish"
msgstr "முடிக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "OnboardingStepsCounter"
msgid "Step {0} of {1}"
msgstr "படி {0} / {1}"

#, c-sharp-format, check-glossary
msgctxt "MediaFlyoutTitle"
msgid "Media Flyout"
msgstr "மீடியா ஃப்ளையவுட்"

#, c-sharp-format, check-glossary
msgctxt "MediaFlyoutDescription"
msgid ""
"When listening to media, press any media or volume key (play/pause, volume "
"up/down, etc.) on your keyboard to display the flyout. Displays media info, "
"along with playback controls and more."
msgstr ""
"மீடியாவை கேட்கும் போது, உங்கள் விசைப்பலகையில் உள்ள ஏதேனும் மீடியா அல்லது ஒலி"
" அளவு விசையை (Play/Pause, ஒலி உயர்த்து/குறைத்து போன்றவை) அழுத்தினால் "
"ஃப்ளையவுட் காட்டப்படும். இதில் மீடியா தகவல்கள், இயக்க கட்டுப்பாடுகள் மற்றும்"
" மேலும் பல அம்சங்கள் காண்பிக்கப்படும்."

#, c-sharp-format, check-glossary
msgctxt "TextBlockText1"
msgid "Enable Media Flyout"
msgstr "மீடியா ஃப்ளையவுட்டை செயல்படுத்து"

#, c-sharp-format, check-glossary
msgctxt "TextBlockText3"
msgid "Display a flyout when you press a media key"
msgstr "மீடியா விசையை அழுத்தும் போது ஃப்ளையவுட் காட்டவும்"

#, c-sharp-format, check-glossary
msgctxt "MediaFlyoutExcludeVolumeTitle"
msgid "Exclude Volume Keys"
msgstr "ஒலி அளவு விசைகளை தவிர்க்கவும்"

#, c-sharp-format, check-glossary
msgctxt "MediaFlyoutExcludeVolumeDescription"
msgid "Do not display the flyout when pressing volume up/down/mute"
msgstr ""
"ஒலி உயர்த்து/குறைத்து/மௌன விசைகளை அழுத்தும் போது ஃப்ளையவுட் காட்ட வேண்டாம்"

#, c-sharp-format, check-glossary
msgctxt "TextBlockText2"
msgid "Choose from a preset of modern background blur styles"
msgstr "பின்னணி மங்கல் பாணியை தேர்வு செய்யவும்"

# Suggested in Weblate:  🟢 எதுவுமில்லை
#, c-sharp-format, check-glossary
msgctxt "BackgroundBlurOption1"
msgid " None"
msgstr " எதுவுமில்லை"

#, c-sharp-format, check-glossary
msgctxt "BackgroundBlurOption2"
msgid " Style 1 (Cover Glow)"
msgstr " பாணி 1 (கவர் ஒளிர்வு)"

#, c-sharp-format, check-glossary
msgctxt "BackgroundBlurOption3"
msgid " Style 2 (Rising Glow)"
msgstr " பாணி 2 (எழும் ஒளிர்வு)"

#, c-sharp-format, check-glossary
msgctxt "BackgroundBlurOption4"
msgid " Style 3 (Blur)"
msgstr " பாணி 3 (மங்கல்)"

# Suggested in Weblate: பின்னணி தெளிவின்மை
#, c-sharp-format, check-glossary
msgctxt "BackgroundBlurTitle"
msgid "Background Blur"
msgstr "பின்னணி மங்கல்"

#, c-sharp-format, check-glossary, fuzzy
msgctxt "AcrylicWindowTitle"
msgid "Acrylic Flyouts"
msgstr "அக்ரிலிக் விண்டோ"

#, c-sharp-format, check-glossary, fuzzy
msgctxt "AcrylicWindowDescription"
msgid "Apply transparent acrylic blur effect to the flyouts"
msgstr ""
"ஃப்ளையவுட்டில் வெளிப்படையான அக்ரிலிக் மங்கல் விளைவை பயன்படுத்தவும் (ஆஃப் "
"செய்தால் Mica பயன்படுத்தப்படும்)"

# Suggested in Weblate: கச்சிதமான தளவமைப்பு
#, c-sharp-format, check-glossary
msgctxt "CompactLayoutTitle"
msgid "Compact Layout"
msgstr "செருகிய அமைப்பு"

#, c-sharp-format, check-glossary
msgctxt "CompactLayoutDescription"
msgid ""
"Slimmer and less intrusive layout\n"
"hides repeat, shuffle and player info"
msgstr ""
"மெலிதான மற்றும் குறைவாக இடையூறு தரும் அமைப்பு\n"
"ரிபீட், ஷஃபிள் மற்றும் ப்ளேயர் தகவலை மறைக்கும்"

#, c-sharp-format, check-glossary
msgctxt "SelectedMonitorTitle"
msgid "Flyout Target Display"
msgstr "ஃப்ளையவுட் இலக்கு திரை"

#, c-sharp-format, check-glossary
msgctxt "FlyoutPositionTitle"
msgid "Flyout Position"
msgstr "ஃப்ளையவுட் தோன்றும் இடம்"

#, c-sharp-format, check-glossary
msgctxt "PositionBottomLeft"
msgid " Bottom Left"
msgstr " கீழ் இடது"

#, c-sharp-format, check-glossary
msgctxt "PositionBottomCenter"
msgid " Bottom Center"
msgstr " கீழ் நடுப்பு"

#, c-sharp-format, check-glossary
msgctxt "PositionBottomRight"
msgid " Bottom Right"
msgstr " கீழ் வலது"

#, c-sharp-format, check-glossary
msgctxt "PositionTopLeft"
msgid " Top Left"
msgstr " மேல் இடது"

#, c-sharp-format, check-glossary
msgctxt "PositionTopCenter"
msgid " Top Center"
msgstr " மேல் நடுப்பு"

#, c-sharp-format, check-glossary
msgctxt "PositionTopRight"
msgid " Top Right"
msgstr " மேல் வலது"

#, c-sharp-format, check-glossary
msgctxt "FlyoutStayDurationTitle"
msgid "Flyout Stay Duration"
msgstr "ஃப்ளையவுட் நீடிப்பு நேரம்"

#, c-sharp-format, check-glossary
msgctxt "FlyoutStayDurationDescription"
msgid "(default: 3000 ms)"
msgstr "(இயல்புநிலை: 3000 ms)"

#, c-sharp-format, check-glossary
msgctxt "MillisecondsUnit"
msgid "ms"
msgstr "ms"

# Suggested in Weblate: எப்போதும் காட்சிக்கு வைக்கப்பட்டுள்ளது
#, c-sharp-format, check-glossary
msgctxt "MediaFlyoutAlwaysDisplay"
msgid "Always Display"
msgstr "எப்போதும் காட்சி"

#, c-sharp-format, check-glossary
msgctxt "MediaFlyoutAlwaysDisplayDescription"
msgid "The flyout stays open until you click the close button"
msgstr "மூடு பொத்தானைக் சொடுக்கு செய்யும் வரை ஃப்ளைஅவுட் திறந்திருக்கும்"

# Suggested in Weblate: தலைப்பு மற்றும் கலைஞர்
#, c-sharp-format, check-glossary
msgctxt "CenterTitleArtistTitle"
msgid "Center Title and Artist"
msgstr "மையத்தின் தலைப்பு மற்றும் கலைஞர்"

#, c-sharp-format, check-glossary
msgctxt "CenterTitleArtistDescription"
msgid "Align text to the center instead of the left"
msgstr "உரையை இடதுபுறத்திற்கு பதிலாக மையத்தில் சீரமைக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "ShowMediaPlayerNameTitle"
msgid "Show Media Player name"
msgstr "மீடியா பிளேயர் பெயரைக் காட்டு"

#, c-sharp-format, check-glossary
msgctxt "RepeatButtonTitle"
msgid "Repeat Button*"
msgstr "மீண்டும் பட்டன்*"

#, c-sharp-format, check-glossary
msgctxt "RepeatButtonDescription"
msgid "Choose between repeat all or repeat one, increases flyout width"
msgstr ""
"அனைத்தையும் மீண்டும் செய்யவும் அல்லது ஒன்றை மீண்டும் செய்யவும் இடையே தேர்வு "
"செய்யவும், ஃப்ளைஅவுட் அகலத்தை அதிகரிக்கிறது"

# Suggested in Weblate: ஷஃபிள் பட்டனைக் காட்டு
#, c-sharp-format, check-glossary
msgctxt "ShuffleButtonTitle"
msgid "Shuffle Button*"
msgstr "கலக்கு பொத்தான்*"

#, c-sharp-format, check-glossary
msgctxt "ShuffleButtonDescription"
msgid "Increases flyout width"
msgstr "ஃப்ளைஅவுட் அகலத்தை அதிகரிக்கிறது"

#, c-sharp-format, check-glossary
msgctxt "ShowSeekbarTitle"
msgid "Show Seekbar*"
msgstr "சீக்பாரைக் காட்டு*"

#, c-sharp-format, check-glossary
msgctxt "ShowSeekbarDescription"
msgid ""
"An interactable seekbar will automatically display if the player supports it"
msgstr "பிளேயர் அதை ஆதரித்தால், ஊடாடக்கூடிய சீக்பார் தானாகவே காண்பிக்கப்படும்"

#, c-sharp-format, check-glossary
msgctxt "UnsupportedControlsWarning"
msgid ""
"*Some browsers/players do not support repeat, shuffle and seekbar control."
msgstr ""
"*சில உலாவிகள்/பிளேயர்கள் ரிபீட், சஃபிள் மற்றும் சீக்பார் கட்டுப்பாட்டை "
"ஆதரிக்காது."

#, c-sharp-format, check-glossary
msgctxt "PauseOtherMediaTitle"
msgid "Pause Other Media Automatically"
msgstr "மற்ற மீடியாவை தானாக இடைநிறுத்தவும்"

#, c-sharp-format, check-glossary
msgctxt "PauseOtherMediaDescription"
msgid ""
"When you play or focus on new media, other active sessions are automatically"
" paused"
msgstr ""
"நீங்கள் விளையாடும் போது அல்லது புதிய மீடியாவில் கவனம் செலுத்தும் போது, "
"​​மற்ற செயலில் உள்ள அமர்வுகள் தானாகவே இடைநிறுத்தப்படும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetCustomizationTitle"
msgid "Taskbar Widget"
msgstr "பணிப்பட்டி விட்செட்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetDescription"
msgid ""
"A compact, built-in widget that lives right on your Windows Taskbar for "
"instant access to your media. Click the widget to expand the full Media "
"Flyout."
msgstr ""
"உங்கள் மீடியாவை உடனடி அணுகலுக்காக உங்கள் சாளரங்கள் Taskbar இல் இருக்கும் ஒரு"
" சிறிய, உள்ளமைக்கப்பட்ட விட்செட். முழு மீடியா ஃப்ளைஅவுட்டை விரிவாக்க "
"விட்செட்டைக் சொடுக்கு செய்யவும்."

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetEnabledTitle"
msgid "Enable Taskbar Widget"
msgstr "பணிப்பட்டி விட்செட்டை இயக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetEnabledDescription"
msgid "Show a compact media widget on the taskbar"
msgstr "பணிப்பட்டியில் ஒரு சிறிய மீடியா விட்செட்டைக் காட்டு"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetVisualIssuesWarning"
msgid "Configure the options below if you experience visual issues."
msgstr ""
"உங்களுக்கு காட்சி சிக்கல்கள் ஏற்பட்டால் கீழே உள்ள விருப்பங்களை "
"உள்ளமைக்கவும்."

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetSelectedMonitorTitle"
msgid "Widget Target Display"
msgstr "விட்செட் இலக்கு காட்சி"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetPosition"
msgid "Widget Position"
msgstr "விட்செட் நிலை"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetPaddingSettingsTitle"
msgid "Widget Padding Settings"
msgstr "விட்செட் பேடிங் அமைப்புகள்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetPaddingSettingsDescription"
msgid "Adjust the padding around the widget to fit your taskbar style"
msgstr ""
"உங்கள் பணிப்பட்டி பாணிக்கு ஏற்றவாறு விட்செட்டைச் சுற்றியுள்ள திணிப்பைச் "
"சரிசெய்யவும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetPaddingTitle"
msgid "Automatic Padding for Windows Widgets button"
msgstr "சாளரங்கள் விட்செட்டுகளுக்கான தானியங்கி திணிப்பு பொத்தான்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetPaddingDescription"
msgid "Turn this feature on if you have Windows Widgets enabled"
msgstr "சாளரங்கள் விட்செட்கள் இயக்கப்பட்டிருந்தால் இந்த அம்சத்தை இயக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetManualPaddingTitle"
msgid "Custom Padding"
msgstr "விருப்ப திணிப்பு"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetManualPaddingDescription"
msgid "Add extra padding (default: 0px)"
msgstr "கூடுதல் திணிப்பு சேர் (இயல்பு: 0px)"

# Suggested in Weblate: பின்னணி தெளிவின்மை
#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetBackgroundBlurTitle"
msgid "Background Blur"
msgstr "பின்னணி தெளிவின்மை"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetBackgroundBlurDescription"
msgid "Add background blur effect to the taskbar widget"
msgstr "பணிப்பட்டி விட்செட்டில் பின்னணி மங்கலான விளைவைச் சேர்க்கவும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetHideCompletelyTitle"
msgid "Hide Completely When No Media Is Present"
msgstr "எந்த மீடியாவும் இல்லாதபோது முற்றிலும் மறை"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetHideCompletelyDescription"
msgid ""
"Hides the entire widget when no media is available, instead of displaying a "
"media icon"
msgstr ""
"மீடியா ஐகானைக் காட்டுவதற்குப் பதிலாக, மீடியா கிடைக்காதபோது முழு "
"விட்செட்டையும் மறைக்கும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetFixedWidthTitle"
msgid "Fixed Widget Width"
msgstr "நிலையான விட்செட் அகலம்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetFixedWidthDescription"
msgid ""
"Keep the widget at a fixed width instead of resizing to fit the title and "
"artist text"
msgstr ""
"தலைப்பு மற்றும் கலைஞர் உரைக்கு ஏற்ப அளவை மாற்றுவதற்குப் பதிலாக விட்செட்டை "
"நிலையான அகலத்தில் வைத்திருங்கள்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetAutoHideTitle"
msgid "Autohide Widget"
msgstr "தானாக மறை விட்செட்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetAutoHideDescription"
msgid "Hides the widget automatically when media is paused"
msgstr "மீடியா இடைநிறுத்தப்படும் போது தானாகவே விட்செட்டை மறைக்கும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetShowPauseOverlayTitle"
msgid "Show Pause Icon Overlay"
msgstr "இடைநிறுத்த படவுரு மேலடுக்கைக் காட்டு"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetShowPauseOverlayDescription"
msgid "When media is paused, display a pause icon over the album art"
msgstr ""
"மீடியா இடைநிறுத்தப்பட்டால், ஆல்பம் கலையின் மீது இடைநிறுத்த ஐகானைக் "
"காண்பிக்கவும்"

# Suggested in Weblate: மீடியா கட்டுப்பாடுகள்
#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetControlsTitle"
msgid "Widget Media Controls"
msgstr "விட்செட் மீடியா கட்டுப்பாடுகள்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetControlsDescription"
msgid "Show media control buttons on the widget"
msgstr "விட்செட்டில் மீடியா கட்டுப்பாட்டு பொத்தான்களைக் காட்டு"

# Suggested in Weblate: கட்டுப்பாட்டு நிலை
#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetControlsPositionTitle"
msgid "Media Controls Position"
msgstr "மீடியா கட்டுப்பாடுகள் நிலை"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetControlsPositionDescription"
msgid "Choose where to display the media control buttons"
msgstr ""
"மீடியா கட்டுப்பாட்டு பொத்தான்களை எங்கு காண்பிக்க வேண்டும் என்பதை தேர்வு "
"செய்யவும்"

# Suggested in Weblate: இடது
#, c-sharp-format, check-glossary
msgctxt "PositionLeft"
msgid "Left"
msgstr "இடது"

# Suggested in Weblate: வலது
#, c-sharp-format, check-glossary
msgctxt "PositionRight"
msgid "Right"
msgstr "வலது"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetAnimatedTitle"
msgid "Widget Animations"
msgstr "விட்செட் அனிமேசன்கள்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetAnimatedDescription"
msgid "Enable subtle animations for the widget"
msgstr "விட்செட்டுக்கான நுட்பமான அனிமேசன்களை இயக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerTitle"
msgid "Taskbar Visualizer"
msgstr "டாச்க்பார் விசுவலைசர்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerDescription"
msgid ""
"A real-time audio visualizer on your taskbar. Designed to have minimal "
"performance impact on modern systems."
msgstr ""
"உங்கள் பணிப்பட்டியில் நிகழ்நேர ஆடியோ காட்சிப்படுத்தல். நவீன அமைப்புகளில் "
"குறைந்த செயல்திறன் தாக்கத்தை ஏற்படுத்தும் வகையில் வடிவமைக்கப்பட்டுள்ளது."

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerEnabledTitle"
msgid "Enable Taskbar Visualizer (Experimental)"
msgstr "Taskbar Visualizer ஐ இயக்கு (பரிசோதனை)"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerEnabledDescription"
msgid ""
"Experimental: This feature will only work if the Taskbar Widget is enabled"
msgstr ""
"பரிசோதனை: Taskbar Widget இயக்கப்பட்டிருந்தால் மட்டுமே இந்த நற்பொருத்தம் "
"செயல்படும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerPositionTitle"
msgid "Visualizer Position Relative to Taskbar Widget"
msgstr "டாச்க்பார் விட்செட்டுடன் தொடர்புடைய விசுவலைசர் நிலை"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerBarCountTitle"
msgid "Bar Count"
msgstr "பார் எண்ணிக்கை"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerBarCountDescription"
msgid "The amount of visualizer bars"
msgstr "விசுவலைசர் பார்களின் அளவு"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerCenteredBarsTitle"
msgid "Centered Bars"
msgstr "மையப்படுத்தப்பட்ட பார்கள்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerCenteredBarsDescription"
msgid ""
"Bars that expand symmetrically from the center instead of rising from the "
"bottom"
msgstr ""
"கீழே இருந்து எழுவதற்குப் பதிலாக மையத்தில் இருந்து சமச்சீராக விரிவடையும் "
"பார்கள்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerBaselineTitle"
msgid "Show Baseline"
msgstr "அடிப்படையைக் காட்டு"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerBaselineDescription"
msgid "Displays a thin line when audio levels are at zero"
msgstr ""
"ஆடியோ நிலைகள் பூச்சியத்தில் இருக்கும்போது மெல்லிய கோட்டைக் காட்டுகிறது"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerBaselineAutoHideDescription"
msgid "Automatically hides the baseline when no audio is playing"
msgstr "ஆடியோ எதுவும் இயங்காதபோது, ​​தானாகவே அடிப்படையை மறைக்கும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerAudioSensitivityTitle"
msgid "Audio Sensitivity"
msgstr "ஆடியோ உணர்திறன்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerAudioSensitivityDescription"
msgid "How loud audio must be before the bars start moving"
msgstr "பார்கள் நகரத் தொடங்கும் முன் ஆடியோ எவ்வளவு சத்தமாக இருக்க வேண்டும்"

# Suggested in Weblate: உச்ச வாசல்:
#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerAudioPeakLevelTitle"
msgid "Audio Peak Threshold"
msgstr "ஆடியோ உச்ச வரம்பு"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerAudioPeakLevelDescription"
msgid "How loud audio must be for the bars to reach their maximum height"
msgstr ""
"பார்கள் அவற்றின் அதிகபட்ச உயரத்தை அடைய ஆடியோ எவ்வளவு சத்தமாக இருக்க வேண்டும்"

# Suggested in Weblate: வெளியீட்டு சாதனம்
#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerOutputDeviceTitle"
msgid "Output Device"
msgstr "வெளியீட்டு சாதனம்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerOutputDeviceDescription"
msgid ""
"Change what the visualizer listens to by switching FluentFlyout's output "
"device."
msgstr ""
"FluentFlyout வெளியீட்டு சாதனத்தை மாற்றுவதன் மூலம் விசுவலைசர் கேட்பதை "
"மாற்றவும்."

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerClickableTitle"
msgid "Click to open Settings"
msgstr "அமைப்புகளைத் திறக்க சொடுக்கு செய்யவும்"

#, c-sharp-format, check-glossary
msgctxt "TaskbarVisualizerClickableDescription"
msgid "Clicking the visualizer will open its settings page"
msgstr ""
"காட்சிப்படுத்தலைக் சொடுக்கு செய்தால், அதன் அமைப்புகள் பக்கம் திறக்கும்"

# Suggested in Weblate: காப்பீடு நற்பொருத்தங்கள்
#, c-sharp-format, check-glossary
msgctxt "PremiumFeatureTitle"
msgid "Premium Feature"
msgstr "காப்பீடு நற்பொருத்தம்"

#, c-sharp-format, check-glossary
msgctxt "PremiumFeatureDescription"
msgid ""
"Your one-time contribution helps me keep FluentFlyout alive and updated. It instantly unlocks all premium customization features, forever.\n"
"        \n"
"Note: As an open-source project, these features are also available for free via the manual installer on GitHub. The only trade-off is that updates and installation must be done manually."
msgstr ""
"உங்கள் ஒருமுறை பங்களிப்பு FluentFlyout ஐ உயிர்ப்புடனும் புதுப்பிக்கவும் எனக்கு உதவுகிறது. இது உடனடியாக அனைத்து காப்பீடு தனிப்பயனாக்குதல் அம்சங்களையும் எப்போதும் திறக்கும். \n"
"\n"
"குறிப்பு: திறந்த மூல திட்டமாக, இந்த நற்பொருத்தங்கள் GitHub இல் உள்ள கையேடு நிறுவி வழியாகவும் இலவசமாகக் கிடைக்கும். புதுப்பிப்புகள் மற்றும் நிறுவல் கைமுறையாக செய்யப்பட வேண்டும் என்பது மட்டுமே வணிகம்."

#, c-sharp-format, check-glossary
msgctxt "PremiumLockedMessage"
msgid "This feature is part of the premium package"
msgstr "இந்த நற்பொருத்தம் காப்பீடு தொகுப்பின் ஒரு பகுதியாகும்"

#, c-sharp-format, check-glossary
msgctxt "PremiumUnlockedMessage"
msgid "Premium features unlocked. Thank you for your support!"
msgstr "காப்பீடு நற்பொருத்தங்கள் திறக்கப்பட்டன. உங்கள் ஆதரவுக்கு நன்றி!"

#, c-sharp-format, check-glossary
msgctxt "PremiumGitHubMessage"
msgid "Premium features are unlocked for GitHub/self-compiled versions"
msgstr ""
"GitHub/சுய தொகுக்கப்பட்ட பதிப்புகளுக்கு காப்பீடு நற்பொருத்தங்கள் "
"திறக்கப்பட்டுள்ளன"

#, c-sharp-format, check-glossary
msgctxt "UnlockPremiumButton"
msgid "Unlock Premium"
msgstr "பிரீமியத்தைத் திறக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "PremiumPurchaseSuccess"
msgid "Premium unlocked successfully!"
msgstr "காப்பீடு வெற்றிகரமாக திறக்கப்பட்டது!"

# Suggested in Weblate: உள்நுழைவு தோல்வியடைந்தது. மீண்டும் முயற்சிக்கவும்.
#, c-sharp-format, check-glossary
msgctxt "PremiumPurchaseFailed"
msgid "Purchase failed. Please try again."
msgstr "வாங்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."

# Suggested in Weblate: கொள்முதல் ரத்து செய்யப்பட்டது
#, c-sharp-format, check-glossary
msgctxt "PremiumPurchaseCancelled"
msgid "Purchase cancelled."
msgstr "கொள்முதல் ரத்து செய்யப்பட்டது."

#, c-sharp-format, check-glossary
msgctxt "UnlockFullExperienceText"
msgid "Unlock the full FluentFlyout experience:"
msgstr "முழு FluentFlyout அனுபவத்தைத் திறக்கவும்:"

#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetCustomizationPerk"
msgid "Enable the Taskbar Widget and Visualizer"
msgstr "Taskbar Widget மற்றும் Visualizer ஐ இயக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "AcrylicBlurOpacityPerk"
msgid "Adjust the Acrylic blur effect"
msgstr "அக்ரிலிக் மங்கலான விளைவைச் சரிசெய்யவும்"

#, c-sharp-format, check-glossary
msgctxt "HideTrayIconPerk"
msgid "Hide the tray icon"
msgstr "தட்டு ஐகானை மறைக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "VolumeMixerHighlightPerk"
msgid "Highlight active apps in the Volume Mixer"
msgstr "வால்யூம் மிக்சரில் செயலில் உள்ள பயன்பாடுகளை முன்னிலைப்படுத்தவும்"

#, c-sharp-format, check-glossary
msgctxt "AllFuturePremiumFeatures"
msgid "All future Premium features"
msgstr "அனைத்து எதிர்கால காப்பீடு நற்பொருத்தங்கள்"

#, c-sharp-format, check-glossary
msgctxt "NextUpCustomizationTitle"
msgid "Next Up Flyout"
msgstr "அடுத்து ஃப்ளைஅவுட்"

#, c-sharp-format, check-glossary
msgctxt "NextUpDescription"
msgid ""
"A flyout shows what's next when a song/video ends. Only appears if the next "
"item plays automatically, if next/previous is pressed manually, the main "
"flyout appears instead."
msgstr ""
"ஒரு பாடல்/வீடியோ முடிந்ததும் அடுத்து என்ன என்பதை ஃப்ளைஅவுட் காட்டுகிறது. "
"அடுத்த உருப்படி தானாக இயங்கினால் மட்டுமே தோன்றும், அடுத்தது/முந்தையதை "
"கைமுறையாக அழுத்தினால், அதற்குப் பதிலாக முதன்மையான ஃப்ளைஅவுட் தோன்றும்."

#, c-sharp-format, check-glossary
msgctxt "EnableNextUpTitle"
msgid "Enable Next Up Flyout"
msgstr "அடுத்த ஃப்ளைஅவுட்டை இயக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "EnableNextUpDescription"
msgid "Shows what's next when a song/video ends"
msgstr "ஒரு பாடல்/வீடியோ முடிந்ததும் அடுத்து என்ன என்பதைக் காட்டுகிறது"

#, c-sharp-format, check-glossary
msgctxt "NextUpStayDurationTitle"
msgid "Next Up Stay Duration"
msgstr "அடுத்து தங்கும் காலம்"

# Suggested in Weblate: (இயல்புநிலை: 3000 ms)
#, c-sharp-format, check-glossary
msgctxt "NextUpStayDurationDescription"
msgid "(default: 2000 ms)"
msgstr "(இயல்புநிலை: 2000 ms)"

#, c-sharp-format, check-glossary
msgctxt "LockKeysCustomizationTitle"
msgid "Lock Keys Flyout"
msgstr "பூட்டு விசைகள் ஃப்ளைஅவுட்"

#, c-sharp-format, check-glossary
msgctxt "LockKeysDescription"
msgid ""
"Check your lock key status at a glance. Appears after pressing Caps Lock, "
"Num Lock or Scroll Lock. Convenient for laptops/keyboards without lock key "
"indicators."
msgstr ""
"உங்கள் பூட்டு விசையின் நிலையை ஒரே பார்வையில் சரிபார்க்கவும். Caps Lock, Num "
"Lock அல்லது Scroll Lock ஐ அழுத்திய பின் தோன்றும். பூட்டு விசை குறிகாட்டிகள் "
"இல்லாத மடிக்கணினிகள்/விசைப்பலகைகளுக்கு வசதியானது."

#, c-sharp-format, check-glossary
msgctxt "EnableLockKeysTitle"
msgid "Enable Lock Keys Flyout"
msgstr "பூட்டு விசைகள் ஃப்ளைஅவுட்டை இயக்கு"

#, c-sharp-format, check-glossary
msgctxt "EnableLockKeysDescription"
msgid "Displays whether the specified lock key is on or off"
msgstr ""
"குறிப்பிட்ட பூட்டு விசை இயக்கத்தில் உள்ளதா அல்லது முடக்கப்பட்டுள்ளதா "
"என்பதைக் காட்டுகிறது"

#, c-sharp-format, check-glossary
msgctxt "EnableCapsTitle"
msgid "Enable Caps Lock indicator"
msgstr "கேப்ச் லாக் இண்டிகேட்டரை இயக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "EnableCapsDescription"
msgid "Shows when the Caps Lock key is pressed"
msgstr "கேப்ச் லாக் விசையை அழுத்தும் போது காட்டுகிறது"

#, c-sharp-format, check-glossary
msgctxt "EnableNumTitle"
msgid "Enable Num Lock indicator"
msgstr "எண் பூட்டு குறிகாட்டியை இயக்கு"

#, c-sharp-format, check-glossary
msgctxt "EnableNumDescription"
msgid "Shows when the Num Lock key is pressed"
msgstr "Num Lock விசையை அழுத்தும் போது காட்டுகிறது"

#, c-sharp-format, check-glossary
msgctxt "EnableScrollTitle"
msgid "Enable Scroll Lock indicator"
msgstr "ச்க்ரோல் லாக் காட்டி இயக்கவும்"

#, c-sharp-format, check-glossary
msgctxt "EnableScrollDescription"
msgid "Shows when the Scroll Lock key is pressed"
msgstr "ச்க்ரோல் லாக் விசையை அழுத்தும் போது காட்டுகிறது"

#, c-sharp-format, check-glossary
msgctxt "LockKeysStayDurationTitle"
msgid "Lock Keys Stay Duration"
msgstr "பூட்டு விசைகள் தங்கும் காலம்"

# Suggested in Weblate: (இயல்புநிலை: 3000 ms)
#, c-sharp-format, check-glossary
msgctxt "LockKeysStayDurationDescription"
msgid "(default: 2000 ms)"
msgstr "(இயல்புநிலை: 2000 ms)"

#, c-sharp-format, check-glossary
msgctxt "LockKeysBoldUITitle"
msgid "Bold Symbol and Font"
msgstr "தடித்த அடையாளம் மற்றும் எழுத்துரு"

#, c-sharp-format, check-glossary
msgctxt "LockKeysBoldUIDescription"
msgid "Emphasizes the flyout symbol and font"
msgstr "ஃப்ளைஅவுட் அடையாளம் மற்றும் எழுத்துருவை வலியுறுத்துகிறது"

#, c-sharp-format, check-glossary
msgctxt "LockKeysCursorUITitle"
msgid "Preferred Target Display"
msgstr "விருப்பமான இலக்கு காட்சி"

#, c-sharp-format, check-glossary
msgctxt "LockKeysCursorUIDescription"
msgid "Choose which monitor to display the flyout."
msgstr "ஃப்ளைஅவுட்டைக் காண்பிக்க எந்த மானிட்டரைத் தேர்ந்தெடுக்கவும்."

# Suggested in Weblate: ஃப்ளையவுட் இலக்கு திரை
#, c-sharp-format, check-glossary
msgctxt "DefaultLockLayoutPosition"
msgid "Default (Flyout Target Display)"
msgstr "இயல்புநிலை (Flyout Target Display)"

#, c-sharp-format, check-glossary
