msgstr "மரபு பணிப்பட்டி அகல அமைப்பு"

#, c-sharp-format, check-glossary
msgctxt "LegacyTaskbarWidthDescription"
msgid "Use the legacy Taskbar width system for Taskbar Widgets"
msgstr ""
"பணிப்பட்டி விட்செட்டுகளுக்கு மரபு பணிப்பட்டி அகல அமைப்பைப் பயன்படுத்தவும்"

# Suggested in Weblate: ச்க்ரோலிங் உரை
#, c-sharp-format, check-glossary
msgctxt "TaskbarWidgetScrollingTextTitle"
msgid "Scrolling Text"
msgstr "ச்க்ரோலிங் உரை"

