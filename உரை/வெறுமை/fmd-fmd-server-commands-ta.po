msgctxt "locate_all.description"
msgid "Get a location from all location providers"
msgstr "Get a location from அனைத்தும் location providers"

#, i18next-interpolation
msgctxt "locate_fused.title"
msgid "Fused"
msgstr "Fused"

#, i18next-interpolation
msgctxt "locate_fused.description"
msgid "Get a location from network/GPS"
msgstr "Get a location இருந்து network/GPS"

#, i18next-interpolation
msgctxt "locate_gps.title"
msgid "GPS"
msgstr "உலக இடம் காட்டும் அமைப்பு (இடம் காட்டி)"

#, i18next-interpolation
msgctxt "locate_gps.description"
msgid "Get a location from GPS"
msgstr ""
"உலக இடம் காட்டும் அமைப்பு (இடம் காட்டி) இலிருந்து இருப்பிடத்தைப் பெறவும்"

#, i18next-interpolation
msgctxt "locate_cell.title"
msgid "Cell"
msgstr "கலன்"

#, i18next-interpolation
msgctxt "locate_cell.description"
msgid ""
"Get a location from the surrounding cell towers with OpenCelliD and/or "
"BeaconDB"
msgstr ""
"Get a location from the surrounding கலன் towers with OpenCelliD and/or "
"BeaconDB"

#, i18next-interpolation
msgctxt "locate_last.title"
msgid "Last Known"
msgstr "Last Known"

#, i18next-interpolation
msgctxt "locate_last.description"
msgid "Get last known location (fast, but may be outdated)"
msgstr ""
"கடைசியாக அறியப்பட்ட இருப்பிடத்தைப் பெறுங்கள் (வேகமாக, ஆனால் காலாவதியானதாக "
"இருக்கலாம்)"

