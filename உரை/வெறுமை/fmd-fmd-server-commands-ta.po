#, i18next-interpolation
msgctxt "locate_group.title"
msgid "Locate"
msgstr "கண்டறிக"

#, i18next-interpolation
msgctxt "locate_group.description"
msgid "Get a location from a location provider"
msgstr "இருப்பிட வழங்குநரிடமிருந்து இருப்பிடத்தைப் பெறுங்கள்"

