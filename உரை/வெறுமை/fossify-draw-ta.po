#, java-printf-format
msgctxt "use_relative_brush_size"
msgid "Adjust brush size based on zoom level"
msgstr "சூம் அளவின் அடிப்படையில் தூரிகை அளவை சரிசெய்யவும்"

#, java-printf-format
msgctxt "clear"
