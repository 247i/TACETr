#.  Settings
#, java-printf-format
msgctxt "show_brush_size"
msgid "Show brush size tool"
msgstr "தூரிகை அளவு கருவியைக் காட்டு"

#, java-printf-format
msgctxt "allow_zooming_moving_canvas"
