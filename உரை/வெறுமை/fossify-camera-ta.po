#, java-printf-format
msgctxt "setting_resolution_failed"
msgid "Setting proper resolution failed"
msgstr "சரியான தெளிவுத்திறனை அமைப்பதில் தோல்வி"

#, java-printf-format
msgctxt "video_recording_failed"
msgid "Video recording failed, try using a different resolution"
