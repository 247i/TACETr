msgstr "நிர்வாகியால் கேமரா முடக்கப்பட்டுள்ளது"

#, java-printf-format
msgctxt "camera_dnd_error"
msgid "Do Not Disturb mode is enabled. Please disable and try again"
msgstr ""
"தொந்தரவு செய்யாதே பயன்முறை இயக்கப்பட்டது. தயவுசெய்து முடக்கிவிட்டு மீண்டும் "
"முயற்சிக்கவும்"

#, java-printf-format
msgctxt "photo_capture_failed"
msgid "Photo capture failed"
msgstr "புகைப்படம் எடுப்பதில் தோல்வி"

#, java-printf-format
msgctxt "video_capture_insufficient_storage_error"
msgid "Video recording failed due to insufficient storage"
msgstr "போதுமான சேமிப்பிடம் இல்லாததால் வீடியோ பதிவு தோல்வியடைந்தது"

