#, i18next-interpolation
msgctxt "main.description"
msgid "Search your network to find your evcc installation."
msgstr ""
"உங்கள் ஈ.வி.சி.சி நிறுவலைக் கண்டுபிடிக்க உங்கள் பிணையத்தைத் தேடுங்கள்."

#, i18next-interpolation
msgctxt "main.title"
msgid "Setup server"
msgstr "அமைவு சேவையகம்"

#, i18next-interpolation
msgctxt "servers.changeServer"
msgid "Change server"
msgstr "சேவையகத்தை மாற்றவும்"

#, i18next-interpolation
msgctxt "servers.switchServer.title"
msgid "Switch server"
msgstr "சேவையகத்தை மாற்றவும்"

#, i18next-interpolation
msgctxt "servers.switchServer.addServer"
msgid "Add server"
msgstr "சேவையகத்தைச் சேர்க்கவும்"

#, i18next-interpolation
msgctxt "servers.manually.authenticationRequired"
msgid "Authentication required"
msgstr "ஏற்பு தேவை"

#, i18next-interpolation
msgctxt "servers.manually.checkAdress"
msgid ""
"The server does not appear to be an evcc instance. Please check the address."
msgstr ""
"சேவையகம் ஒரு ஈ.வி.சி.சி நிகழ்வாகத் தெரியவில்லை. முகவரியை சரிபார்க்கவும்."

#, i18next-interpolation
msgctxt "servers.manually.checkAndSave"
msgid "Check and save"
msgstr "சரிபார்த்து சேமிக்கவும்"

#, i18next-interpolation
msgctxt "servers.manually.enterUrl"
msgid "Enter URL"
msgstr "முகவரி ஐ உள்ளிடவும்"

#, i18next-interpolation
msgctxt "servers.manually.missingOrWrongAuthentication"
msgid "Missing or incorrect authentication"
msgstr "காணவில்லை அல்லது தவறான ஏற்பு"

#, i18next-interpolation
msgctxt "servers.manually.password"
msgid "Password"
msgstr "கடவுச்சொல்"

#, i18next-interpolation
msgctxt "servers.manually.serverIncompatible"
msgid "The evcc instance is not yet app-compatible. Update your installation."
msgstr ""
"ஈ.வி.சி.சி நிகழ்வு இன்னும் பயன்பாட்டு-இணக்கமாக இல்லை. உங்கள் நிறுவலைப் "
"புதுப்பிக்கவும்."

#, i18next-interpolation
msgctxt "servers.manually.serverNotAvailable"
msgid "Server not available. Please check the address."
msgstr "சேவையகம் கிடைக்கவில்லை. முகவரியை சரிபார்க்கவும்."

#, i18next-interpolation
msgctxt "servers.manually.specify"
msgid "Enter address manually"
