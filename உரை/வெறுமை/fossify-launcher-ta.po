#, java-printf-format
msgctxt "app_launcher_name"
msgid "Launcher"
msgstr "துவக்கி"

#, java-printf-format
msgctxt "launcher_settings"
msgid "Launcher Settings"
msgstr "துவக்கி அமைப்புகள்"

#, java-printf-format
msgctxt "app_info"
msgid "App info"
msgstr "பயன்பாட்டுத் செய்தி"

#, java-printf-format
msgctxt "touch_hold_widget"
msgid "Long press the widget and drag it on your home screen"
msgstr "விட்செட்டை நீண்ட நேரம் அழுத்தி உங்கள் முகப்புத் திரையில் இழுக்கவும்"

#, java-printf-format
msgctxt "uninstall"
msgid "Uninstall"
msgstr "நிறுவல் நீக்கவும்"

#, java-printf-format
msgctxt "hide_icon"
msgid "Hide icon"
msgstr "ஐகானை மறை"

#, java-printf-format
msgctxt "add_hidden_icons"
msgid "Add hidden icons"
msgstr "மறைக்கப்பட்ட சின்னங்களைச் சேர்க்கவும்"

#, java-printf-format
msgctxt "manage_hidden_icons"
msgid "Manage hidden icons"
msgstr "மறைக்கப்பட்ட ஐகான்களை நிர்வகிக்கவும்"

#, java-printf-format
msgctxt "hidden_icons"
msgid "Hidden icons"
msgstr "மறைக்கப்பட்ட சின்னங்கள்"

#, java-printf-format
msgctxt "hidden_icons_placeholder"
msgid ""
"Some apps cannot be uninstalled due to system restrictions, but you can at "
"least hide their icons to avoid seeing them."
msgstr ""
"கணினி கட்டுப்பாடுகள் காரணமாக சில பயன்பாடுகளை நிறுவல் நீக்க முடியாது, ஆனால் "
"அவற்றைப் பார்ப்பதைத் தவிர்க்க அவற்றின் ஐகான்களை மறைக்கலாம்."

#, java-printf-format
msgctxt "app_drawer_settings"
msgid "App drawer"
msgstr "பயன்பாட்டு அலமாரி"

#, java-printf-format
msgctxt "close_app_drawer_on_app_open"
msgid "Close app drawer on opening an app"
msgstr "ஆப்சைத் திறக்கும்போது ஆப் டிராயரை மூடு"

#, java-printf-format
msgctxt "auto_show_keyboard_in_app_drawer"
msgid "Automatically show keyboard in drawer"
msgstr "டிராயரில் கீபோர்டை தானாகக் காட்டு"

#, java-printf-format
msgctxt "show_app_labels"
msgid "Show app labels"
msgstr "பயன்பாட்டு லேபிள்களைக் காட்டு"

#, java-printf-format
msgctxt "home_screen_settings"
msgid "Home screen"
msgstr "முகப்புத் திரை"

#, java-printf-format
msgctxt "widget_too_big"
msgid "Widget is too big for current home screen size"
msgstr "தற்போதைய முகப்புத் திரை அளவுக்கு விட்செட் மிகப் பெரியது"

#, java-printf-format
msgctxt "double_tap_to_lock"
msgid "Double tap to lock screen"
msgstr "திரையைப் பூட்ட இருமுறை தட்டவும்"

#, java-printf-format
msgctxt "lock_device_admin_hint"
msgid ""
"To enable the double tap to lock screen feature, you need to grant admin "
"permission. Note that the app cannot be uninstalled until this permission is"
" removed."
msgstr ""
"திரையைப் பூட்டுவதற்கான அம்சத்தை இருமுறை தட்டுவதை இயக்க, நீங்கள் நிர்வாக "
"அனுமதியை வழங்க வேண்டும். இந்த இசைவு அகற்றப்படும் வரை பயன்பாட்டை நிறுவல் "
"நீக்க முடியாது என்பதை நினைவில் கொள்ளவும்."

#, java-printf-format
msgctxt "lock_device_admin_warning"
msgid ""
"Deactivating admin permission will disable the double tap to lock screen "
"feature."
msgstr ""
"நிர்வாகி அனுமதியை செயலிழக்கச் செய்தால், திரை அம்சத்தைப் பூட்டுவதற்கு இருமுறை"
" தட்டுவது முடக்கப்படும்."
