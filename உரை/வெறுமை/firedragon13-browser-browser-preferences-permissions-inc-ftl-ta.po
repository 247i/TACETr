msgid ""
".title = Settings - WebGL Permissions\n"
".style = { permissions-window2.style }"
msgstr ""

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "permissions-site-webgl-desc"
msgid ""
"The following websites have requested to create a WebGL context. You can "
"specify which websites are allowed to create a WebGL context. You can also "
"block new requests asking to create a WebGL context."
msgstr ""
