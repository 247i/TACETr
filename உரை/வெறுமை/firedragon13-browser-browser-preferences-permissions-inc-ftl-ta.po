msgctxt "permissions-site-eme-window2"
msgid ""
".title = Settings - DRM Permissions\n"
".style = { permissions-window2.style }"
msgstr ""

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "permissions-site-eme-desc"
msgid ""
"The following websites have requested to play DRM-controlled content. You "
"can specify which websites are allowed to play DRM-controlled content. You "
"can also block new requests asking to play DRM-controlled content."
msgstr ""

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "permissions-site-eme-disable-label"
msgid ".label = Block new requests asking to play DRM-controlled content"
msgstr ""

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
msgctxt "permissions-site-eme-disable-desc"
msgid ""
"This will prevent any websites not listed above from requesting permission "
"to play DRM-controlled content."
msgstr ""

#, fluent-parts, fluent-references, fluent-source-inner-html, fluent-source-syntax, fluent-target-inner-html, fluent-target-syntax, fluent-type:Message, ignore-xml-invalid, ignore-xml-tags
