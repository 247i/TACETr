#, i18next-interpolation
msgctxt "documentTitle"
msgid "Motion Search - Frigate"
msgstr "மோசன் தேடல் - போர்க்கப்பல்"

#, i18next-interpolation
msgctxt "title"
msgid "Motion Search"
msgstr "மோசன் தேடல்"

#, i18next-interpolation
msgctxt "description"
msgid ""
"Draw a polygon to define the region of interest, and specify a time range to"
" search for motion changes within that region."
msgstr ""
"ஆர்வமுள்ள பகுதியை வரையறுக்க பலகோணத்தை வரையவும், மேலும் அந்த "
"பிராந்தியத்திற்குள் இயக்க மாற்றங்களைத் தேடுவதற்கான கால வரம்பைக் "
"குறிப்பிடவும்."

#, i18next-interpolation
msgctxt "selectCamera"
msgid "Motion Search is loading"
msgstr "மோசன் தேடல் ஏற்றப்படுகிறது"

#, i18next-interpolation
msgctxt "startSearch"
msgid "Start Search"
msgstr "தேடலைத் தொடங்கு"

#, i18next-interpolation
msgctxt "searchStarted"
msgid "Search started"
msgstr "தேடல் தொடங்கியது"

#, i18next-interpolation
msgctxt "searchCancelled"
msgid "Search cancelled"
msgstr "தேடல் ரத்து செய்யப்பட்டது"

#, i18next-interpolation
msgctxt "cancelSearch"
msgid "Cancel"
msgstr "ரத்துசெய்"

#, i18next-interpolation
msgctxt "searching"
msgid "Search in progress."
msgstr "தேடல் செயலில் உள்ளது."

#, i18next-interpolation
msgctxt "scanning"
msgid "Scanning {{time}}"
msgstr "{{time}} வருடு செய்கிறது"

#, i18next-interpolation
msgctxt "searchComplete"
msgid "Search complete"
msgstr "தேடல் முடிந்தது"

#, i18next-interpolation
msgctxt "noResultsYet"
msgid "Run a search to find motion changes in the selected region"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட பகுதியில் இயக்க மாற்றங்களைக் கண்டறிய தேடலை இயக்கவும்"

#, i18next-interpolation
msgctxt "noChangesFound"
msgid "No pixel changes detected in the selected region"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட பகுதியில் படப்புள்ளி மாற்றங்கள் எதுவும் "
"கண்டறியப்படவில்லை"

#, i18next-interpolation
msgctxt "changesFound"
msgid "Found {{count}} motion change"
msgid_plural "Found {{count}} motion changes"
msgstr[0] "{{count}} இயக்க மாற்றம் கண்டறியப்பட்டது"
msgstr[1] "{{count}} இயக்க மாற்றங்கள் கண்டறியப்பட்டன"

#, i18next-interpolation
msgctxt "framesProcessed"
msgid "{{count}} frames processed"
msgstr "{{count}} பிரேம்கள் செயலாக்கப்பட்டன"

#, i18next-interpolation
msgctxt "jumpToTime"
msgid "Jump to this time"
msgstr "இந்த நேரத்திற்கு செல்லவும்"

#, i18next-interpolation
msgctxt "results"
msgid "Results"
msgstr "முடிவுகள்"

