msgctxt "dialog.title"
msgid "Motion Search"
msgstr "மோசன் தேடல்"

#, i18next-interpolation
msgctxt "dialog.cameraLabel"
msgid "Camera"
msgstr "கேமரா"

#, i18next-interpolation
msgctxt "dialog.previewAlt"
msgid "Camera preview for {{camera}}"
msgstr "{{camera}}க்கான கேமரா முன்னோட்டம்"

#, i18next-interpolation
msgctxt "timeRange.title"
msgid "Search Range"
msgstr "தேடல் வரம்பு"

#, i18next-interpolation
msgctxt "timeRange.start"
msgid "Start time"
msgstr "தொடக்க நேரம்"

#, i18next-interpolation
msgctxt "timeRange.end"
msgid "End time"
msgstr "முடிவு நேரம்"

#, i18next-interpolation
msgctxt "settings.title"
msgid "Search Settings"
msgstr "தேடல் அமைப்புகள்"

#, i18next-interpolation
msgctxt "settings.parallelMode"
msgid "Parallel mode"
msgstr "இணை முறை"

#, i18next-interpolation
msgctxt "settings.parallelModeDesc"
msgid ""
"Scan multiple recording ranges at the same time (faster; uses more decoding "
"resources)"
msgstr ""
"ஒரே நேரத்தில் பல பதிவு வரம்புகளை வருடு செய்யவும் (வேகமாக; அதிக டிகோடிங் "
"ஆதாரங்களைப் பயன்படுத்துகிறது)"

#, i18next-interpolation
msgctxt "settings.threshold"
msgid "Sensitivity Threshold"
msgstr "உணர்திறன் வரம்பு"

#, i18next-interpolation
msgctxt "settings.thresholdDesc"
msgid "Lower values detect smaller changes (1-255)"
msgstr "குறைந்த மதிப்புகள் சிறிய மாற்றங்களைக் கண்டறியும் (1-255)"

#, i18next-interpolation
msgctxt "settings.minArea"
msgid "Minimum Change Area"
msgstr "குறைந்தபட்ச மாற்றம் பகுதி"

#, i18next-interpolation
msgctxt "settings.minAreaDesc"
msgid ""
"Minimum size of a single moving region, as a percentage of the region of "
"interest"
msgstr "ஒரு நகரும் பகுதியின் குறைந்தபட்ச அளவு, ஆர்வமுள்ள பகுதியின் சதவீதமாக"

#, i18next-interpolation
msgctxt "settings.maxResults"
msgid "Maximum Results"
msgstr "அதிகபட்ச முடிவுகள்"

#, i18next-interpolation
msgctxt "settings.maxResultsDesc"
msgid "Stop after this many matching timestamps"
msgstr "பல பொருந்திய நேர முத்திரைகளுக்குப் பிறகு நிறுத்தவும்"

#, i18next-interpolation
msgctxt "errors.noCamera"
msgid "Please select a camera"
msgstr "கேமராவைத் தேர்ந்தெடுக்கவும்"

#, i18next-interpolation
msgctxt "errors.noROI"
