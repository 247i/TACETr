msgstr "கடைசி புள்ளியை செயல்தவிர்க்கவும்"

#, i18next-interpolation
msgctxt "polygonControls.reset"
msgid "Reset polygon"
msgstr "பலகோணத்தை மீட்டமைக்கவும்"

#, i18next-interpolation
msgctxt "polygonControls.drawMode"
msgid "Draw"
msgstr "வரையவும்"

#, i18next-interpolation
msgctxt "polygonControls.moveMode"
msgid "Move"
msgstr "நகர்த்தவும்"

