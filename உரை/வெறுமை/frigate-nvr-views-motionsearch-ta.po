msgstr "ஆர்வமுள்ள பகுதியை வரையவும்"

#, i18next-interpolation
msgctxt "errors.noTimeRange"
msgid "Please select a time range"
msgstr "நேர வரம்பைத் தேர்ந்தெடுக்கவும்"

#, i18next-interpolation
msgctxt "errors.invalidTimeRange"
msgid "End time must be after start time"
msgstr "முடிவு நேரம் தொடக்க நேரத்திற்குப் பிறகு இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "errors.searchFailed"
msgid "Search failed: {{message}}"
msgstr "தேடல் தோல்வி: {{message}}"

#, i18next-interpolation
msgctxt "errors.polygonTooSmall"
msgid "Polygon must have at least 3 points"
msgstr "பலகோணத்தில் குறைந்தது 3 புள்ளிகள் இருக்க வேண்டும்"

#, i18next-interpolation
msgctxt "errors.unknown"
msgid "Unknown error"
msgstr "அறியப்படாத பிழை"

#, i18next-interpolation
msgctxt "changePercentage"
msgid "{{percentage}}% changed"
msgstr "{{percentage}}% மாற்றப்பட்டது"

